{
  "name": "cypress",
  "version": "4.9.0",
  "scripts": {
    "ng": "ng",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "start": "node --max_old_space_size=3000 node_modules/@angular/cli/bin/ng serve",
    "build": "node --max_old_space_size=3000 node_modules/@angular/cli/bin/ng build --show-circular-dependencies=false",
    "start-aot": "node --max_old_space_size=9000 node_modules/@angular/cli/bin/ng serve --prod --aot --optimization=false",
    "buildAOT": "node --max_old_space_size=9000 node_modules/@angular/cli/bin/ng build --prod --aot --optimization=false --show-circular-dependencies=false",
    "do-e2e": "protractor e2e/protractor.conf.js",
    "start-e2e": "node --max_old_space_size=3000 node_modules/@angular/cli/bin/ng e2e",
    "cypressRun": "cypress run",
    "runtests": "npm run cypressRun",
    "cypressopen": "node_modules\\.bin\\cypress open",
    "clean:reports": "rm -R -f cypress/reports && mkdir cypress/reports && mkdir cypress/reports/mochareports",
    "pretest": "npm run clean:reports",
    "scripts": "cypress run",
    "combine-reports": "mochawesome-mergecypress/reports/mocha/*.json > cypress/reports/mochareports/report.json",
    "generate-report": "marge cypress/reports/mochareports/report.json -f report -o cypress/reports/mochareports",
    "posttest": "npm run combine-reports && npm run generate-report",
    "RunE2E": "npm run scripts || npm run posttest",
    "cypress:report": "generate-mochawesome-report",
    "report": "run-s report:*",
    "report:merge": "mochawesome-merge --reportDir cypress/results/json > cypress/results/mochawesome-bundle.json",
    "report:generate": "marge cypress/results/mochawesome-bundle.json -o cypress/reports/html",
    "report:copyScreenshots": "cp -r cypress/screenshots cypress/results/html/screenshots",
    "CypressSupport": "npm install --save-dev cypress-file-upload || npm i --save-dev cypress-localstorage-commands",
    "cypressopenlocal": "cypress open --env Env=local"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~9.1.1",
    "@angular/cdk": "^9.2.3",
    "@angular/cdk-experimental": "^9.2.4",
    "@angular/common": "~9.1.1",
    "@angular/compiler": "~9.1.1",
    "@angular/core": "~9.1.1",
    "@angular/forms": "~9.1.1",
    "@angular/platform-browser": "~9.1.1",
    "@angular/platform-browser-dynamic": "~9.1.1",
    "@angular/router": "~9.1.1",
    "@types/mocha": "^7.0.2",
    "ag-grid-angular": "^20.0.0",
    "ag-grid-community": "^20.0.0",
    "ag-grid-enterprise": "^20.0.0",
    "mochawesome-report-generator": "^5.1.0",
    "rxjs": "~6.5.4",
    "selenium-webdriver": "^4.0.0-alpha.5",
    "tslib": "^1.10.0",
    "webdriver-manager": "^12.1.6",
    "zone.js": "~0.10.2"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^9.1.0",
    "@angular-devkit/build-angular": "~0.901.1",
    "@angular/cli": "~9.1.1",
    "@angular/compiler-cli": "~9.1.1",
    "@angular/language-service": "~9.1.1",
    "@types/jasmine": "~3.5.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^12.11.1",
    "codelyzer": "^5.1.2",
    "cypress": "^4.9.0",
    "cypress-file-upload": "^4.0.7",
    "cypress-localstorage-commands": "^1.2.4",
    "cypress-mochawesome-reporter": "^1.0.1",
    "cypress-multi-reporters": "^1.4.0",
    "jasmine-core": "~3.5.0",
    "jasmine-reporters": "^2.0.0",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "~4.4.1",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~2.1.0",
    "karma-jasmine": "~3.0.1",
    "karma-jasmine-html-reporter": "^1.4.2",
    "mocha": "^8.0.1",
    "mocha-junit-reporter": "^2.0.0",
    "mochawesome": "^6.1.1",
    "mochawesome-merge": "^4.1.0",
    "protractor": "^5.4.4",
    "protractor-beautiful-reporter": "^1.3.6",
    "ts-node": "~8.3.0",
    "tslint": "~6.1.0",
    "typescript": "^3.8.3"
  }
}
