<#+
 
private void SetFileDxml(dynamic entity)
{
    FileDXML=entity.ToString().Replace("\"", "\'").Replace(Environment.NewLine, "\"+"+Environment.NewLine+"\"");
}

#>


<#+
//Create an elastic object
private dynamic FromDXMLFile(string file)
{
   var path= Host.ResolvePath(file);
   return XDocument.Load(path);
}

#>