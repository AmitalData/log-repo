<#@ Assembly Name="System.Xml.Linq.dll" #>
<#@ Assembly Name="System.Core.dll" #>
<#@ Assembly Name="Microsoft.CSharp.dll" #>
<#@ Assembly name="$(SolutionDir)packages\AmazedSaint.ElasticObject.1.2.0\lib\net40\AmazedSaint.Elastic.dll" #>
<#@ Import Namespace="System.Xml" #>
<#@ Import Namespace="System.Xml.Linq" #>
<#@ Import Namespace="AmazedSaint.Elastic" #>
<#@ Import Namespace="AmazedSaint.Elastic.Lib" #>
<#@ output extension=".cs" #>

<#@ import Namespace="System.IO" #>

<#+
dynamic DXMLnamespacestring;
string fileNameWithoutExtension;
string FileDXML = "";

public void GenerateAllCopyDXMLs(string sourceFolder,string destinationFolder)
{
 
 DXMLnamespacestring = GetDXMLNameSpace(destinationFolder);
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string sourceFilePath = Path.Combine(templateDirectory, sourceFolder);

foreach (string file in Directory.EnumerateFiles(sourceFilePath, "*.dxml"))
{

    fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	GenerateDXML(file,destinationFolder+"/"+fileNameWithoutExtension+"Dxml.Generated.cs");
}

 
}
#>

<#+  

public void GenerateDXML(string xmlFilePath,string outputFilePath)
{
	if(string.IsNullOrEmpty(DXMLnamespacestring))
    {
	 DXMLnamespacestring = GetDXMLNameSpace(outputFilePath);
    }
    var entity = FromDXMLFile(xmlFilePath);
  
WriteDXMLMethod(entity);
SaveDXMLOutput(outputFilePath);
}
 
#>


<#+

public dynamic GetDXMLNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }

	spacestring = spacestring.ToString().Trim('.');

	return spacestring;
}

#>

<#+
void SaveDXMLOutput(string outputFileName)
  { 
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
	   
	  var manager = Manager.Create(Host, GenerationEnvironment);
	  manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString());
	  this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
  }
#>


<#+
 private void WriteDXMLMethod(dynamic entity)
{
          SetFileDxml(entity);
         
   #>
