<Script DBType="Main" Module="Shipment"  AOT="true" TargetTableName="Shipments">
  <Sql Version="1">
    <![CDATA[

     Update Shipments Set ShipperNotExporterReference1 = ShipperNotExporterReference 
                      where ShipperNotExporterReference is not null and $LastCounterWhere$
    
    ]]>
