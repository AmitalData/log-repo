<Script DBType="Main" Module="Shipment" >
  <Sql Version="1">
    <![CDATA[

	  If(OBJECT_ID('tempdb..#tempTable') Is Not Null)
				Begin
					Drop Table #tempTable
				End

	  If(OBJECT_ID('tempdb..#temp_Container') Is Not Null)
				Begin
					Drop Table #temp_Container
				End

		CREATE TABLE #temp_Container 
		(Id varchar(15) not null ,
		 ShipmentId varchar(15)  null ,
		 Tenant int not null,
		 ShipmentPreCarriageFromId varchar(15)  null ,
		 ShipmentPreCarriageToId varchar(15)  null ,
		 ShipmentMainCarriageFromId varchar(15)  null ,
		 ShipmentMainCarriageToId varchar(15)  null ,
		 ShipmentTransshipment1FromId varchar(15)  null ,
		 ShipmentTransshipment1ToId varchar(15)  null ,
		 ShipmentTransshipment2FromId varchar(15)  null ,
		 ShipmentTransshipment2ToId varchar(15)  null ,
		 ShipmentTransshipment3FromId varchar(15)  null ,
		 ShipmentTransshipment3ToId varchar(15)  null ,
		 ShipmentOnCarriageFromId varchar(15)  null ,
		 ShipmentOnCarriageToId varchar(15)  null ,
		 ShipmentFirstPickupFrom varchar(200)  null ,
		 ShipmentFirstPickupTo varchar(200)  null ,
		 ShipmentLastDeliveryFrom varchar(200)  null ,
		 ShipmentLastDeliveryTo varchar(200)  null ,
		 PickUpDeliveryFromTypeCode  varchar(4)  null ,
		 PickUpDeliveryToTypeCode  varchar(4)  null ,
		 FromAddressCity  varchar(25)  null ,
		 FromAddressCountryId  varchar(15)  null ,
		 FromPartnerCardId  varchar(15)  null ,
		 FromPortId  varchar(15)  null ,
		 ToAddressCity  varchar(25)  null ,
		 ToAddressCountryId  varchar(15)  null ,
		 ToPartnerCardId  varchar(15)  null ,
		 ToPortId  varchar(15)  null )
	
		 select 
		 Containers.Id as Id, 
		 Containers.Tenant as Tenant,
		 Containers.ShipmentId as ShipmentId,
		 shipmentMasterDatas.PreCarriageFromPortId as ShipmentPreCarriageFromId,
		 shipmentMasterDatas.PreCarriageToPortId as ShipmentPreCarriageToId,
		 shipmentMasterDatas.MainCarriageFromPortId as ShipmentMainCarriageFromId,
		 shipmentMasterDatas.MainCarriageToPortId as ShipmentMainCarriageToId,
	   shipmentMasterDatas.Transshipment1FromPortId as ShipmentTransshipment1FromId,
	   shipmentMasterDatas.Transshipment1ToPortId as ShipmentTransshipment1ToId,
		 shipmentMasterDatas.Transshipment2FromPortId as ShipmentTransshipment2FromId,
		 shipmentMasterDatas.Transshipment2ToPortId as ShipmentTransshipment2ToId,
		 shipmentMasterDatas.Transshipment3FromPortId as ShipmentTransshipment3FromId,
		 shipmentMasterDatas.Transshipment3ToPortId as ShipmentTransshipment3ToId,
		 shipmentMasterDatas.OnCarriageFromPortId as ShipmentOnCarriageFromId,
	     shipmentMasterDatas.OnCarriageToPortId as ShipmentOnCarriageToId,
		 ShipmentPickUpDeliveries.PickUpDeliveryTypeCode as PickUpDeliveryTypeCode,
		 ShipmentPickUpDeliveries.PickUpDeliveryFromTypeCode as PickUpDeliveryFromTypeCode,
		 ShipmentPickUpDeliveries.PickUpDeliveryToTypeCode as PickUpDeliveryToTypeCode,
		 ShipmentPickUpDeliveries.FromAddressCity as FromAddressCity,
		 ShipmentPickUpDeliveries.FromAddressCountryId as FromAddressCountryId,
		 ShipmentPickUpDeliveries.FromPartnerCardId as FromPartnerCardId,
		 ShipmentPickUpDeliveries.FromPortId as FromPortId, 
		 ShipmentPickUpDeliveries.ToAddressCity as ToAddressCity,
		 ShipmentPickUpDeliveries.ToAddressCountryId as ToAddressCountryId,
		 ShipmentPickUpDeliveries.ToPartnerCardId as ToPartnerCardId,
		 ShipmentPickUpDeliveries.ToPortId as ToPortId
		into #tempTable

		FROM  Containers
		left join ShipmentMasterDatas as shipmentMasterDatas on Containers.ShipmentId = shipmentMasterDatas.Id
		left join ShipmentPickUpDeliveryPackages as ShipmentPickUpDeliveryPackage on Containers.Id = ShipmentPickUpDeliveryPackage.ContainerEntityId 
		left join ShipmentPickUpDeliveries as ShipmentPickUpDeliveries on ShipmentPickUpDeliveryPackage.ShipmentPickUpDeliveryId = ShipmentPickUpDeliveries.Id 
		where Containers.Tenant = 2573 

    DECLARE @Id as varchar(15)	
		DECLARE @Tenant as int
		DECLARE @ShipmentId as varchar(15)
		DECLARE @ShipmentPreCarriageFromId as varchar(15)
		DECLARE @ShipmentPreCarriageToId as varchar(15)
		DECLARE @ShipmentMainCarriageFromId as varchar(15)
		DECLARE @ShipmentMainCarriageToId as varchar(15)
		DECLARE @ShipmentTransshipment1FromId as varchar(15)
		DECLARE @ShipmentTransshipment1ToId as varchar(15)
		DECLARE @ShipmentTransshipment2FromId as varchar(15)
		DECLARE @ShipmentTransshipment2ToId as varchar(15)
		DECLARE @ShipmentTransshipment3FromId as varchar(15)
		DECLARE @ShipmentTransshipment3ToId as varchar(15)
		DECLARE @ShipmentOnCarriageFromId as varchar(15)
		DECLARE @ShipmentOnCarriageToId as varchar(15)
		DECLARE @PickUpDeliveryTypeCode as varchar(4)
		DECLARE @PickUpDeliveryFromTypeCode as varchar(4)
		DECLARE @PickUpDeliveryToTypeCode as varchar(4)
		DECLARE @FromAddressCity as varchar(25)
		DECLARE @FromAddressCountryId as varchar(15)
		DECLARE @FromPartnerCardId as varchar(15)
		DECLARE @FromPortId as varchar(15)
		DECLARE @ToAddressCity as varchar(25)
		DECLARE @ToAddressCountryId as varchar(15)
		DECLARE @ToPartnerCardId as varchar(15)
		DECLARE @ToPortId as varchar(15)
		DECLARE	@ShipmentFirstPickupFrom as varchar(200) 
		DECLARE @ShipmentFirstPickupTo as varchar(200)  
		DECLARE @ShipmentLastDeliveryFrom as varchar(200)  
		DECLARE @ShipmentLastDeliveryTo as varchar(200)  
		DECLARE @Count as int 

	    set @Count = 0;

			BEGIN
				 DECLARE DataCursor CURSOR READ_ONLY
				 FOR
				 SELECT Id,Tenant,ShipmentId,ShipmentPreCarriageFromId,ShipmentPreCarriageToId,ShipmentMainCarriageFromId,ShipmentMainCarriageToId,ShipmentTransshipment1FromId
				        ,ShipmentTransshipment1ToId,ShipmentTransshipment2FromId,ShipmentTransshipment2ToId,ShipmentTransshipment3FromId,ShipmentTransshipment3ToId
						,ShipmentOnCarriageFromId,ShipmentOnCarriageToId,PickUpDeliveryFromTypeCode,PickUpDeliveryToTypeCode,FromAddressCity,FromAddressCountryId
						,FromPartnerCardId,FromPortId,ToAddressCity,ToAddressCountryId,ToPartnerCardId,ToPortId,PickUpDeliveryTypeCode
				 FROM #tempTable
				 OPEN DataCursor FETCH NEXT FROM DataCursor INTO @Id, @Tenant, @ShipmentId, @ShipmentPreCarriageFromId, @ShipmentPreCarriageToId, @ShipmentMainCarriageFromId
				        , @ShipmentMainCarriageToId, @ShipmentTransshipment1FromId, @ShipmentTransshipment1ToId, @ShipmentTransshipment2FromId, @ShipmentTransshipment2ToId
						, @ShipmentTransshipment3FromId, @ShipmentTransshipment3ToId, @ShipmentOnCarriageFromId, @ShipmentOnCarriageToId, @PickUpDeliveryFromTypeCode
						, @PickUpDeliveryToTypeCode, @FromAddressCity, @FromAddressCountryId, @FromPartnerCardId, @FromPortId, @ToAddressCity, @ToAddressCountryId
						, @ToPartnerCardId, @ToPortId,@PickUpDeliveryTypeCode
				 WHILE @@FETCH_STATUS = 0
				 BEGIN

--------------------------------------------------------------------------  Delivery  -------------------------------------------------------
				if (@PickUpDeliveryTypeCode = 'DELV')
				begin
				 -------------------- ShipmentLastDeliveryFrom --------------------
					if (@PickUpDeliveryFromTypeCode = 'PART')
					begin
					  set @ShipmentLastDeliveryFrom = (Select CONCAT(EnglishName,', ',CityName,', ',CountryName) from Cards where Id = @FromPartnerCardId and Tenant  = @Tenant)
					end

					else if (@PickUpDeliveryFromTypeCode = 'PORT')
					begin
					  set @ShipmentLastDeliveryFrom = (Select CombinedCode from Ports where Id  = @FromPortId and Tenant  = @Tenant)
					end

					else if (@PickUpDeliveryFromTypeCode = 'CASL')
					begin
					   set @ShipmentLastDeliveryFrom = (CONCAT((Select EnglishName from Countries where Id = @FromAddressCountryId and Tenant  = @Tenant),', ',@FromAddressCity))
					end
			     -------------------- @ShipmentLastDeliveryTo --------------------
				    if (@PickUpDeliveryToTypeCode = 'PART')
					begin
					  set @ShipmentLastDeliveryTo = (Select CONCAT(EnglishName,', ',CityName,', ',CountryName) from Cards where Id = @ToPartnerCardId and Tenant  = @Tenant)
					end

					else if (@PickUpDeliveryToTypeCode = 'PORT')
					begin
					  set @ShipmentLastDeliveryTo = (Select CombinedCode from Ports where Id  = @ToPortId and Tenant  = @Tenant)
					end

					else if (@PickUpDeliveryToTypeCode = 'CASL')
					begin
					   set @ShipmentLastDeliveryTo = (CONCAT((Select EnglishName from Countries where Id = @ToAddressCountryId and Tenant  = @Tenant),', ',@ToAddressCity))
					end
				
				end
--------------------------------------------------------------------------  PickUp  -------------------------------------------------------

				else If (@PickUpDeliveryTypeCode = 'PICK')
				begin
				 -------------------- ShipmentLastPickUpFrom --------------------
					if (@PickUpDeliveryFromTypeCode = 'PART')
					begin
					  set @ShipmentFirstPickupFrom = (Select CONCAT(EnglishName,', ',CityName,', ',CountryName) from Cards where Id = @FromPartnerCardId and Tenant  = @Tenant)
					end

					else if (@PickUpDeliveryFromTypeCode = 'PORT')
					begin
					  set @ShipmentFirstPickupFrom = (Select CombinedCode from Ports where Id  = @FromPortId and Tenant  = @Tenant)
					end

					else if (@PickUpDeliveryFromTypeCode = 'CASL')
					begin
					   set @ShipmentFirstPickupFrom = (CONCAT((Select EnglishName from Countries where Id = @FromAddressCountryId and Tenant  = @Tenant),', ',@FromAddressCity))
					end
			     -------------------- @ShipmenttFirstPickUpTo --------------------
				    if (@PickUpDeliveryFromTypeCode = 'PART')
					begin
					  set @ShipmentFirstPickupTo = (Select CONCAT(EnglishName,', ',CityName,', ',CountryName) from Cards where Id = @ToPartnerCardId and Tenant  = @Tenant)
					end

					else if (@PickUpDeliveryFromTypeCode = 'PORT')
					begin
					  set @ShipmentFirstPickupTo = (Select CombinedCode from Ports where Id  = @ToPortId and Tenant  = @Tenant)
					end

					else if (@PickUpDeliveryFromTypeCode = 'CASL')
					begin
					   set @ShipmentFirstPickupTo = (CONCAT((Select EnglishName from Countries where Id = @ToAddressCountryId and Tenant  = @Tenant),', ',@ToAddressCity))
					end

					else 
					begin 
					  set @ShipmentLastDeliveryFrom = null
					  set @ShipmentLastDeliveryTo = null
					  set @ShipmentFirstPickupFrom = null
					  set @ShipmentFirstPickupTo = null
					end

				end	
				

		  insert into #temp_Container (Id,Tenant,ShipmentId,ShipmentPreCarriageFromId,ShipmentPreCarriageToId,ShipmentMainCarriageFromId,ShipmentMainCarriageToId,ShipmentTransshipment1FromId
				        ,ShipmentTransshipment1ToId,ShipmentTransshipment2FromId,ShipmentTransshipment2ToId,ShipmentTransshipment3FromId,ShipmentTransshipment3ToId
						,ShipmentOnCarriageFromId,ShipmentOnCarriageToId,PickUpDeliveryFromTypeCode,PickUpDeliveryToTypeCode,FromAddressCity,FromAddressCountryId
						,FromPartnerCardId,FromPortId,ToAddressCity,ToAddressCountryId,ToPartnerCardId,ToPortId,ShipmentFirstPickupFrom,ShipmentFirstPickupTo,
						ShipmentLastDeliveryFrom,ShipmentLastDeliveryTo)
		   values(@Id, @Tenant, @ShipmentId, @ShipmentPreCarriageFromId, @ShipmentPreCarriageToId, @ShipmentMainCarriageFromId
				        , @ShipmentMainCarriageToId, @ShipmentTransshipment1FromId, @ShipmentTransshipment1ToId, @ShipmentTransshipment2FromId, @ShipmentTransshipment2ToId
						, @ShipmentTransshipment3FromId, @ShipmentTransshipment3ToId, @ShipmentOnCarriageFromId, @ShipmentOnCarriageToId, @PickUpDeliveryFromTypeCode
						, @PickUpDeliveryToTypeCode, @FromAddressCity, @FromAddressCountryId, @FromPartnerCardId, @FromPortId, @ToAddressCity, @ToAddressCountryId
						, @ToPartnerCardId, @ToPortId,@ShipmentFirstPickupFrom,@ShipmentFirstPickupTo,@ShipmentLastDeliveryFrom,@ShipmentLastDeliveryTo)

--------------------------------------------------------------------------------------------------------------- 

				set @Count = @Count + 1;
				if(@Count = 1000)
				begin 
					update Containers
					set
			    		ShipmentPreCarriageFromId = #temp_Container.ShipmentPreCarriageFromId,
		                ShipmentPreCarriageToId = #temp_Container.ShipmentPreCarriageToId,
		                ShipmentMainCarriageFromId = #temp_Container.ShipmentMainCarriageFromId,
		                ShipmentMainCarriageToId = #temp_Container.ShipmentMainCarriageToId,
		                ShipmentTransshipment1FromId = #temp_Container.ShipmentTransshipment1FromId,
		                ShipmentTransshipment1ToId = #temp_Container.ShipmentTransshipment1ToId,
		                ShipmentTransshipment2FromId = #temp_Container.ShipmentTransshipment2FromId,
		                ShipmentTransshipment2ToId = #temp_Container.ShipmentTransshipment2ToId,
		                ShipmentTransshipment3FromId = #temp_Container.ShipmentTransshipment3FromId,
		                ShipmentTransshipment3ToId = #temp_Container.ShipmentTransshipment3ToId ,
		                ShipmentOnCarriageFromId = #temp_Container.ShipmentOnCarriageFromId,
		                ShipmentOnCarriageToId = #temp_Container.ShipmentOnCarriageToId,
		                ShipmentFirstPickupFrom = #temp_Container.ShipmentFirstPickupFrom,
		                ShipmentFirstPickupTo = #temp_Container.ShipmentFirstPickupTo,
		                ShipmentLastDeliveryFrom = #temp_Container.ShipmentLastDeliveryFrom,
		                ShipmentLastDeliveryTo =#temp_Container.ShipmentLastDeliveryTo
					FROM #temp_Container
					where #temp_Container.Id = Containers.Id and #temp_Container.Tenant = Containers.Tenant
					truncate table #temp_Container
					set @Count = 0
				end
		
				 FETCH NEXT FROM DataCursor INTO @Id, @Tenant, @ShipmentId, @ShipmentPreCarriageFromId, @ShipmentPreCarriageToId, @ShipmentMainCarriageFromId
				        , @ShipmentMainCarriageToId, @ShipmentTransshipment1FromId, @ShipmentTransshipment1ToId, @ShipmentTransshipment2FromId, @ShipmentTransshipment2ToId
						, @ShipmentTransshipment3FromId, @ShipmentTransshipment3ToId, @ShipmentOnCarriageFromId, @ShipmentOnCarriageToId, @PickUpDeliveryFromTypeCode
						, @PickUpDeliveryToTypeCode, @FromAddressCity, @FromAddressCountryId, @FromPartnerCardId, @FromPortId, @ToAddressCity, @ToAddressCountryId
						, @ToPartnerCardId, @ToPortId,@PickUpDeliveryTypeCode
				 END
				 CLOSE DataCursor
				 DEALLOCATE DataCursor
			END

		if (@Count > 0)
		begin
			update Containers
				      set
			    		ShipmentPreCarriageFromId = #temp_Container.ShipmentPreCarriageFromId,
		                ShipmentPreCarriageToId = #temp_Container.ShipmentPreCarriageToId,
		                ShipmentMainCarriageFromId = #temp_Container.ShipmentMainCarriageFromId,
		                ShipmentMainCarriageToId = #temp_Container.ShipmentMainCarriageToId,
		                ShipmentTransshipment1FromId = #temp_Container.ShipmentTransshipment1FromId,
		                ShipmentTransshipment1ToId = #temp_Container.ShipmentTransshipment1ToId,
		                ShipmentTransshipment2FromId = #temp_Container.ShipmentTransshipment2FromId,
		                ShipmentTransshipment2ToId = #temp_Container.ShipmentTransshipment2ToId,
		                ShipmentTransshipment3FromId = #temp_Container.ShipmentTransshipment3FromId,
		                ShipmentTransshipment3ToId = #temp_Container.ShipmentTransshipment3ToId ,
		                ShipmentOnCarriageFromId = #temp_Container.ShipmentOnCarriageFromId,
		                ShipmentOnCarriageToId = #temp_Container.ShipmentOnCarriageToId,
		                ShipmentFirstPickupFrom = #temp_Container.ShipmentFirstPickupFrom,
		                ShipmentFirstPickupTo = #temp_Container.ShipmentFirstPickupTo,
		                ShipmentLastDeliveryFrom = #temp_Container.ShipmentLastDeliveryFrom,
		                ShipmentLastDeliveryTo =#temp_Container.ShipmentLastDeliveryTo
					FROM #temp_Container
					where #temp_Container.Id = Containers.Id and #temp_Container.Tenant = Containers.Tenant
		end

		drop table #tempTable
		drop table #temp_Container

    ]]>
  </Sql>
</Script>