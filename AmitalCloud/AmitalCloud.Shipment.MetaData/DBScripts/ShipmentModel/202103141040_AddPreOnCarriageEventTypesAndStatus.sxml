<Script DBType="Main" Module="Shipment" >
  <Sql Version="1">
    <![CDATA[
    
      



declare @Tenant as int
declare @ShipmentTableId as varchar(15)
set @ShipmentTableId = (select Id from ObjectTables where Name = 'Shipment')

BEGIN -- TenantsCursor
		DECLARE TenantsCursor CURSOR READ_ONLY
		FOR
		SELECT Id
		FROM Tenants
		OPEN TenantsCursor FETCH NEXT FROM TenantsCursor INTO @Tenant		
		WHILE @@FETCH_STATUS = 0
			BEGIN

				declare @StatusId_PreForwardingDeparted as varchar(15)
				declare @StatusId_PreForwardingArrived as varchar(15)
				declare @StatusId_OnForwardingDeparted as varchar(15)
				declare @StatusId_OnForwardingArrived as varchar(15)
				
				set @StatusId_PreForwardingDeparted = (select Id from EntityStatus where Tenant = @Tenant and Code = 'PRFD' and ObjectTableId = @ShipmentTableId)
				set @StatusId_PreForwardingArrived = (select Id from EntityStatus where Tenant = @Tenant and Code = 'PRFA' and ObjectTableId = @ShipmentTableId)
				set @StatusId_OnForwardingDeparted = (select Id from EntityStatus where Tenant = @Tenant and Code = 'ORFD' and ObjectTableId = @ShipmentTableId)
				set @StatusId_OnForwardingArrived = (select Id from EntityStatus where Tenant = @Tenant and Code = 'ORFA' and ObjectTableId = @ShipmentTableId)
				
				if @StatusId_PreForwardingDeparted is null
				begin
					EXECUTE usp_GetNextTableIdValue @StatusId_PreForwardingDeparted OUTPUT,'EntityStatus'
					insert into EntityStatus(Id, Tenant, StatusWeight, Code, Name, ObjectTableId, InActive, SearchFields, DisplayName, AutomaticLastUpdateDate)
					values(@StatusId_PreForwardingDeparted, @Tenant, 55, 'PRFD', 'Departed', @ShipmentTableId, 0, 'PRFD,Departed', 'Departed', GETDATE())
				end

				if @StatusId_PreForwardingArrived is null
				begin
					EXECUTE usp_GetNextTableIdValue @StatusId_PreForwardingArrived OUTPUT,'EntityStatus'
					insert into EntityStatus(Id, Tenant, StatusWeight, Code, Name, ObjectTableId, InActive, SearchFields, DisplayName, AutomaticLastUpdateDate)
					values(@StatusId_PreForwardingArrived, @Tenant, 65, 'PRFA', 'Arrived', @ShipmentTableId, 0,'PRFA,Arrived', 'Arrived', GETDATE())
				end

				if @StatusId_OnForwardingDeparted is null
				begin
					EXECUTE usp_GetNextTableIdValue @StatusId_OnForwardingDeparted OUTPUT,'EntityStatus'
					insert into EntityStatus(Id, Tenant, StatusWeight, Code, Name, ObjectTableId, InActive, SearchFields, DisplayName, AutomaticLastUpdateDate)
					values(@StatusId_OnForwardingDeparted, @Tenant, 165, 'ORFD', 'Departed', @ShipmentTableId, 0,'ORFD,Departed', 'Departed', GETDATE())
				end

				if @StatusId_OnForwardingArrived is null 
				begin
					EXECUTE usp_GetNextTableIdValue @StatusId_OnForwardingArrived OUTPUT,'EntityStatus'
					insert into EntityStatus(Id, Tenant, StatusWeight, Code, Name, ObjectTableId, InActive, SearchFields, DisplayName, AutomaticLastUpdateDate)
					values(@StatusId_OnForwardingArrived, @Tenant, 175, 'ORFA', 'Arrived', @ShipmentTableId, 0,'ORFA,Arrived', 'Arrived', GETDATE())
				end

				declare @EventTypeId_PreForwardingDeparted as varchar(15)
				declare @EventTypeId_PreForwardingArrived as varchar(15)
				declare @EventTypeId_OnForwardingDeparted as varchar(15)
				declare @EventTypeId_OnForwardingArrived as varchar(15)
				
				set @EventTypeId_PreForwardingDeparted = (select Id from EventTypes where Tenant = @Tenant and ObjectTableId = @ShipmentTableId and Code = 'PRFD')
				set @EventTypeId_PreForwardingArrived = (select Id from EventTypes where Tenant = @Tenant and ObjectTableId = @ShipmentTableId and Code = 'PRFA')
				set @EventTypeId_OnForwardingDeparted = (select Id from EventTypes where Tenant = @Tenant and ObjectTableId = @ShipmentTableId and Code = 'ONFD')
				set @EventTypeId_OnForwardingArrived = (select Id from EventTypes where Tenant = @Tenant and ObjectTableId = @ShipmentTableId and Code = 'ORFA')
				
				if @EventTypeId_PreForwardingDeparted is null
				begin
					EXECUTE usp_GetNextTableIdValue @EventTypeId_PreForwardingDeparted OUTPUT,'EventType'
					insert into EventTypes(Id, Tenant, Code, EnglishName, AddedManually, IsManualEntry, LocalName, EntityStatusId, ObjectTableId, IsFollowUp, FollowUpEnglishName, FollowUpLocalName, ShortView, ManualActivatedFollowUp, InActive, CustomerRoleId, AgentRoleId, EventTypeCategoryCode, IsCustomerView, IsAgentView, IsSharedLogisticsEnabled, SearchFields)
					values(@EventTypeId_PreForwardingDeparted, @Tenant, 'PRFD', 'Pre Forwarding Departed', 0, 0,'Pre Forwarding Departed', @StatusId_PreForwardingDeparted, @ShipmentTableId, 0,null, null,1,0,0,null,null,'OPE',0,0,0,'PRFD,Pre Forwarding Departed')
				end

				if @EventTypeId_PreForwardingArrived is null
				begin
					EXECUTE usp_GetNextTableIdValue @EventTypeId_PreForwardingArrived OUTPUT,'EventType'
					insert into EventTypes(Id, Tenant, Code, EnglishName, AddedManually, IsManualEntry, LocalName, EntityStatusId, ObjectTableId, IsFollowUp, FollowUpEnglishName, FollowUpLocalName, ShortView, ManualActivatedFollowUp, InActive, CustomerRoleId, AgentRoleId, EventTypeCategoryCode, IsCustomerView, IsAgentView, IsSharedLogisticsEnabled, SearchFields)
					values(@EventTypeId_PreForwardingArrived, @Tenant, 'PRFA', 'Pre Forwarding Arrived', 0, 0,'Pre Forwarding Arrived', @StatusId_PreForwardingArrived, @ShipmentTableId, 0,null, null,1,0,0,null,null,'OPE',0,0,0,'PRFA,Pre Forwarding Arrived')
				end

				if @EventTypeId_OnForwardingDeparted is null
				begin
					EXECUTE usp_GetNextTableIdValue @EventTypeId_OnForwardingDeparted OUTPUT,'EventType'
					insert into EventTypes(Id, Tenant, Code, EnglishName, AddedManually, IsManualEntry, LocalName, EntityStatusId, ObjectTableId, IsFollowUp, FollowUpEnglishName, FollowUpLocalName, ShortView, ManualActivatedFollowUp, InActive, CustomerRoleId, AgentRoleId, EventTypeCategoryCode, IsCustomerView, IsAgentView, IsSharedLogisticsEnabled, SearchFields)
					values(@EventTypeId_OnForwardingDeparted, @Tenant, 'ONFD', 'On Forwarding Departed', 0, 0,'On Forwarding Departed', @StatusId_OnForwardingDeparted, @ShipmentTableId, 0,null, null,1,0,0,null,null,'OPE',0,0,0,'ONFD,On Forwarding Departed')
				end

				if @EventTypeId_OnForwardingArrived is null
				begin
					EXECUTE usp_GetNextTableIdValue @EventTypeId_OnForwardingArrived OUTPUT,'EventType'
					insert into EventTypes(Id, Tenant, Code, EnglishName, AddedManually, IsManualEntry, LocalName, EntityStatusId, ObjectTableId, IsFollowUp, FollowUpEnglishName, FollowUpLocalName, ShortView, ManualActivatedFollowUp, InActive, CustomerRoleId, AgentRoleId, EventTypeCategoryCode, IsCustomerView, IsAgentView, IsSharedLogisticsEnabled, SearchFields)
					values(@EventTypeId_OnForwardingArrived, @Tenant, 'ORFA', 'On Forwarding Arrived', 0, 0,'On Forwarding Arrived', @StatusId_OnForwardingArrived, @ShipmentTableId, 0,null, null,1,0,0,null,null,'OPE',0,0,0,'ORFA,On Forwarding Arrived')
				end

			FETCH NEXT FROM TenantsCursor INTO @Tenant	
			END
		CLOSE TenantsCursor
		DEALLOCATE TenantsCursor
END
      
    ]]>
  </Sql>
</Script>

