<Script DBType="Main" Module="Shipment" TargetTableName="Shipments">
	<Sql Version="4">
		<![CDATA[
   If(OBJECT_ID('tempdb..#temp ')  Is Not Null)
    Begin
    Drop Table #temp
    End



   If(OBJECT_ID(' tempdb..#temp_ShipmentDigitalFields ') Is Not Null)
    Begin
    Drop Table #temp_ShipmentDigitalFields
    End



   CREATE TABLE #temp_ShipmentDigitalFields
    (
    Id varchar(15) not null,
    Tenant int not null
    )



   select  
    Shipments.Id as Id,
    Shipments.Tenant as Tenant



   into #temp
    from Shipments where Id not in (select Id from ShipmentDigitalFields)



   declare @Id as varchar(15)
    declare @Tenant as int



   declare @Count as int
    set @Count = 0;



   DECLARE DataCursor CURSOR READ_ONLY
    FOR
    SELECT Id,Tenant
    FROM #temp
    OPEN DataCursor FETCH NEXT FROM DataCursor INTO @Id,@Tenant
    WHILE @@FETCH_STATUS = 0
    BEGIN



   insert into #temp_ShipmentDigitalFields (Id,Tenant) values(@Id, @Tenant)



   set @Count = @Count + 1;
    if(@Count = 1000)
    begin
      INSERT INTO ShipmentDigitalFields (Id,Tenant)
      SELECT #temp_ShipmentDigitalFields.Id,#temp_ShipmentDigitalFields.Tenant
      FROM #temp_ShipmentDigitalFields
      truncate table #temp_ShipmentDigitalFields
      set @Count = 0
    end
    FETCH NEXT FROM DataCursor INTO @Id,@Tenant
    END
    CLOSE DataCursor
    DEALLOCATE DataCursor
    if (@Count > 0)
    begin
        INSERT INTO ShipmentDigitalFields (Id,Tenant)
    SELECT #temp_ShipmentDigitalFields.Id,#temp_ShipmentDigitalFields.Tenant
    FROM #temp_ShipmentDigitalFields
    end



   drop table #temp
    drop table #temp_ShipmentDigitalFields





	
        ]]>
	</Sql>
</Script>


