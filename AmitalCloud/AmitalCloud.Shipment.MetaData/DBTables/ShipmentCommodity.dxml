      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsFirstLine"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ShipmentId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DescriptionOfGoods"
    Type="varchar"
    Size="2000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="RateClassCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ChargeableWeight"
    Type="float">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ChargeRate"
    Type="float">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
