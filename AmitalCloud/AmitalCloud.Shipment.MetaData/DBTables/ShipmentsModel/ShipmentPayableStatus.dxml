<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ShipmentPayableStatus"
  Schema="dbo"
  DBType="Main"
  Module="Shipment">
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Name"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Code"
    Type="varchar"
    Size="4">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="AutomaticLastUpdateDate"
    Type="datetime"
    DefaultValue="CurrentDate">
    <Constraints
      Nullable="false" />
  </Column>
  <Index
    Columns="AutomaticLastUpdateDate" />
</Table>