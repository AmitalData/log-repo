<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="OceanInsightsStatusLogs"
  Schema="dbo"
  DBType="Main"
  Module="Shipment">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="OceanInsigntRequestId"
    Type="varchar"
    Size="500">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
   Name="XML"
   Type="nvarchar"
   Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
 

</Table>