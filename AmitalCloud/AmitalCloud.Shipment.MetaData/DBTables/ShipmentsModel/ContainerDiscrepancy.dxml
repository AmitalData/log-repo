<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ContainerDiscrepancies"
  Schema="dbo"
  DBType="Main"
  Module="Shipment">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ContainerID"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ShipmentId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DiscrepancyDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Discrepancy"
    Type="varchar"
    Size="250">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="ContainerID"
    ReferencedTable="Containers"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ShipmentId"
    ReferencedTable="Shipments"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo"
    Ignore="true" />
</Table>