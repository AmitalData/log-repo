<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ContainersExternalDatas"
  Schema="dbo"
  DBType="Main"
  Module="Shipment">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="GateIn"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="GateOut"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="Id"
    ReferencedTable="Containers"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>