<?xml version="1.0" encoding="utf-8"?>
<Trigger
  DBType="Main"
  Name="TriggerOnCreate_AutomaticLastUpdateDatePayableProratedAmounts"
  Schema="dbo"
  Module="Shipment">
  <SqlScript><![CDATA[
CREATE TRIGGER TriggerOnCreate_AutomaticLastUpdateDatePayableProratedAmounts ON PayableProratedAmounts AFTER Insert  AS  BEGIN UPDATE PayableProratedAmounts SET AutomaticLastUpdateDate = GETDATE() WHERE Id IN (SELECT DISTINCT Id FROM Inserted)END;
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Trigger>