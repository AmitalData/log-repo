<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ARPaymentBankTranfers"
  Schema="dbo"
  DBType="Main"
  Module="Invoice">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PaymentId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LineNumber"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="PaymentRef"
    Type="nvarchar"
    Size="30">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ValueDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="BankAccountId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CurrencyId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LocalAmount"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ForeignAmount"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ExchageRate"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="PaymentId"
    ReferencedTable="ARPayments"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="BankAccountId"
    ReferencedTable="BankAccounts"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="CurrencyId"
    ReferencedTable="Currencies"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>