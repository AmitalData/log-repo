<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="Expressions"
  Schema="dbo"
  DBType="Main"
  Module="WorkFlow">
  <Column
    Name="Code"
    Type="varchar"
    Size="3">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="varchar"
    Size="50">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Body"
    Type="varchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Description"
    Type="varchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CategoryCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="CategoryCode"
    ReferencedTable="ExpressionCategories"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo"
    Ignore="true" />
</Table>