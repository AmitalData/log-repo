<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="WorkFlows"
  Schema="dbo"
  DBType="Main"
  Module="Workflow">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreatedByUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UpdateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UpdatedByUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Name"
    Type="nvarchar"
    Size="200">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Description"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="StatusCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="FlowJson"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Entity"
    Type="varchar"
    Size="50">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Trigger"
    Type="varchar"
    Size="50">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="RetriesNumber"
    Type="int"
    DefaultValue="5">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="RetriesDelay"
    Type="varchar"
    Size="500">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="WorkFlowTriggerTypeCode"
    Type="varchar"
    Size="30"
    DefaultValue="'RecordTriggered'">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="WorkFlowNumber"
    Type="nvarchar"
    Size="100"
    InitialValueScript="update [WorkFlows] set [WorkFlowNumber] = [Id]">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="CreatedByUserId"
    ReferencedTable="Users"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="UpdatedByUserId"
    ReferencedTable="Users"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="StatusCode"
    ReferencedTable="WorkFlowStatuses"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="WorkFlowTriggerTypeCode"
    ReferencedTable="WorkFlowTriggerTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo"
    Ignore="true" />
  <UniqueConstraint
    Columns="Tenant,WorkFlowNumber" />
</Table>