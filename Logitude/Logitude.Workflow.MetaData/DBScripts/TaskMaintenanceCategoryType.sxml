<Script DBType="Main" Module="Workflow">
  <Sql Version="1">
    <![CDATA[
    
	
	if not exists (select * from [CategoryTypes] where [Code] = 'TSK')
    begin

        INSERT INTO [CategoryTypes](
            [Code],
            [Name],
            [SearchFields]
		)
        VALUES(
            'TSK', 
            'Tasks', 
            N'tsk,tasks' 
        )
		
    end;

    
    ]]>
  </Sql>
</Script>