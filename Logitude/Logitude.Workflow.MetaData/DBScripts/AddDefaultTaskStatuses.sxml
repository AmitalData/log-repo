<Script DBType="Main" Module="Workflow">
  <Sql Version="1">
    <![CDATA[
    
    declare @NewId as varchar(15);
    declare @UserId as varchar(15);
    declare @CurrentDate as datetime;
    
    set @UserId = (select top 1 [Id] from [Users] where [Tenant] = 0);
    set @CurrentDate = GETDATE();
    
    if not exists (select * from [TaskStatuses] where [Code] = 'PEN' and Tenant = 0)
    begin
    execute [usp_GetNextTableIdValue] @NewId OUTPUT, 'TaskStatus';
    insert into [TaskStatuses] ([Id], [Tenant], [Code], [Name], [Closed], [CreateDate], [CreatedByUserId], [UpdateDate], [UpdatedByUserId], [SearchFields])
    values (@NewId, 0, 'PEN', 'Pending', 0, @CurrentDate, @UserId, @CurrentDate, @UserId, 'PEN,Pending');
    end;
    
    
    if not exists (select * from [TaskStatuses] where [Code] = 'DON' and Tenant = 0)
    begin
    execute [usp_GetNextTableIdValue] @NewId OUTPUT, 'TaskStatus';
    insert into [TaskStatuses] ([Id], [Tenant], [Code], [Name], [Closed], [CreateDate], [CreatedByUserId], [UpdateDate], [UpdatedByUserId], [SearchFields])
    values (@NewId, 0, 'DON', 'Done', 1, @CurrentDate, @UserId, @CurrentDate, @UserId, 'DON,Done');
    end;
    
    
    if not exists (select * from [TaskStatuses] where [Code] = 'INP' and Tenant = 0)
    begin
    execute [usp_GetNextTableIdValue] @NewId OUTPUT, 'TaskStatus';
    insert into [TaskStatuses] ([Id], [Tenant], [Code], [Name], [Closed], [CreateDate], [CreatedByUserId], [UpdateDate], [UpdatedByUserId], [SearchFields])
    values (@NewId, 0, 'INP', 'In Progress', 0, @CurrentDate, @UserId, @CurrentDate, @UserId, 'INP,In Progress');
    end;
    
    
    if not exists (select * from [TaskStatuses] where [Code] = 'TOD' and Tenant = 0)
    begin
    execute [usp_GetNextTableIdValue] @NewId OUTPUT, 'TaskStatus';
    insert into [TaskStatuses] ([Id], [Tenant], [Code], [Name], [Closed], [CreateDate], [CreatedByUserId], [UpdateDate], [UpdatedByUserId], [SearchFields])
    values (@NewId, 0, 'TOD', 'To Do', 0, @CurrentDate, @UserId, @CurrentDate, @UserId, 'TOD,To Do');
    end;
    
    if not exists (select * from [TaskStatuses] where [Code] = 'CAN' and Tenant = 0)
    begin
    execute [usp_GetNextTableIdValue] @NewId OUTPUT, 'TaskStatus';
    insert into [TaskStatuses] ([Id], [Tenant], [Code], [Name], [Closed], [CreateDate], [CreatedByUserId], [UpdateDate], [UpdatedByUserId], [SearchFields])
    values (@NewId, 0, 'CAN', 'Cancelled', 1, @CurrentDate, @UserId, @CurrentDate, @UserId, 'CAN,Cancelled');
    end;
        
    ]]>
  </Sql>
</Script>