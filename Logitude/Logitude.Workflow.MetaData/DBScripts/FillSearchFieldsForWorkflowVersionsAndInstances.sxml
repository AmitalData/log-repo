<Script DBType="Main" Module="Workflow">
  <Sql Version="2">
    <![CDATA[
    
    update [WorkFlowInstances] set [SearchFields] = ([BusinessKey] + ',' + CONVERT(VARCHAR(10), (select [VersionNumber] from [WorkFlowVersions] where [Id] = [WorkFlowVersionId])));
    
    update [WorkFlowVersions] set [SearchFields] = ([Description] + ',' + CONVERT(VARCHAR(10), [VersionNumber]));
    
    ]]>
  </Sql>
</Script>