<Script DBType="Main" Module="Workflow">
  <Sql Version="1">
    <![CDATA[
    
    declare @id varchar(20), @flow_json nvarchar(max);
    declare workflows_cursor cursor
    
    for select [Id], [FlowJson] from [WorkFlows] where [FlowJson] is not null and [FlowJson] <> '';
    
    open workflows_cursor;
    
    fetch next from workflows_cursor into @id, @flow_json;
    
    while @@FETCH_STATUS = 0
    begin
    
    update [WorkFlows] set [Trigger] = JSON_VALUE(@flow_json,'$.nodes[0].data.trigger') where [Id] = @id;
    
    fetch next from workflows_cursor into @id, @flow_json;
    end;
    
    close workflows_cursor;
    deallocate workflows_cursor;
    
    ]]>
  </Sql>
</Script>