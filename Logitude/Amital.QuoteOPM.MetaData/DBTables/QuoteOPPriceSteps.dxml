<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="QuoteOPPriceSteps"
  Schema="dbo"
  DBType="Main"
  Module="QuoteOPM">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="QuoteOPId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="QuoteOPChargeId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Step"
    Type="float">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CostUnitPrice"
    Type="float">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SaleUnitPrice"
    Type="float">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
