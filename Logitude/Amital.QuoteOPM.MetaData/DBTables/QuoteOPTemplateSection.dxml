<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="QuoteOPTemplateSections"
  Schema="dbo"
  DBType="Main"
  Module="QuoteOPM">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="nvarchar"
    Size="60">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Description"
    Type="nvarchar"
    Size="500">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsCancel"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="QuoteTemplateId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SectionDocId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Order"
    ShortName="ColumnOrder"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="QuoteOPTemplateSectionTypeCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="QuoteTemplateId"
    ReferencedTable="QuoteOPTemplates"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="SectionDocId"
    ReferencedTable="Documents"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="QuoteOPTemplateSectionTypeCode"
    ReferencedTable="QuoteOPTemplateSectionTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
</Table>