<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="QuoteOPTemplateTextDesigns"
  Schema="dbo"
  DBType="Main"
  Module="QuoteOPM">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="FontSize"
    Type="float">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="TextColor"
    Type="varchar"
    Size="10">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FontFamily"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="BackgroundColor"
    Type="varchar"
    Size="10">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FontWeight"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Italic"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UnDerLine"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Alignment"
    Type="varchar"
    Size="10">
    <Constraints
      Nullable="true" />
  </Column>
</Table>