<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="Groups"
  Schema="dbo"
  DBType="Main"
  Module="Social">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Description"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsPrivate"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="OwnerId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="OwnerId"
    ReferencedTable="Users"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>