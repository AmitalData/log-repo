<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CRMFilterSettings"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ControlNameSpace"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="FilterName"
    Type="varchar"
    Size="50">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="FilterValue"
    Type="varchar"
    Size="50">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="UserId"
    ReferencedTable="Users"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>