<?xml version="1.0" encoding="utf-8"?>
<Table Name="ActivityEmailRecipients">
  <Column Name="ActivityId" Type="varchar" Size="15">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="ContactId" Type="varchar" Size="15">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Email" Type="varchar" Size="70">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Id" Type="varchar" Size="15">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="RecipientTypeCode" Type="varchar" Size="3">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="SenderContactId" Type="varchar" Size="15">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Tenant" Type="int">
    <Constraints Nullable="false" />
  </Column>
</Table>