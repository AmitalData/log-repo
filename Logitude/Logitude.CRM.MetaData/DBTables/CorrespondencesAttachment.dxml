<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CorrespondencesAttachments"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DocumentFilingId"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
