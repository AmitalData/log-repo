<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="OpportunityAdditionalServices"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="OpportunityId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="AdditionalServiceId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Notes"
    Type="nvarchar"
    Size="500">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="NotesRightToLeft"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="OpportunityId"
    ReferencedTable="Opportunities"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="AdditionalServiceId"
    ReferencedTable="AdditionalServices"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>