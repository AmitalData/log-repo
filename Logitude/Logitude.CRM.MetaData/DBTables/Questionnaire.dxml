<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="Questionnaires"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="nvarchar"
    Size="120">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreatedByUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UpdateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UpdatedByUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="VersionNumber"
    Type="int"
    DefaultValue="0">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="RightToLeft"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="HasTwoColumn"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="InActive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="CreatedByUserId"
    ReferencedTable="Users"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="UpdatedByUserId"
    ReferencedTable="Users"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>