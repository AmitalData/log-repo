<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="OpportunityCompetitorProducts"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="OpportunityId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="CompetitorId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="ProductTypeCode"
    Type="varchar"
    Size="2">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
