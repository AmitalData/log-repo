  <Relation
    ForeignKeyColumn="CompetitorId"
    ReferencedTable="Competitors"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ProductTypeCode"
