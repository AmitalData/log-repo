<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="OpportunityStages"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="OpportunityId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="FromStageId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ToStageId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="StartDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="EndDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="OpportunityId"
    ReferencedTable="Opportunities"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="FromStageId"
    ReferencedTable="Stages"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ToStageId"
    ReferencedTable="Stages"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>