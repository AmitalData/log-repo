<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="OpportunityProductLocations"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="OpportunityId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="OpportunityProductTypeCode"
    Type="varchar"
    Size="2">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LineNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CountryId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TEU"
    Type="decimal"
    Precision="18"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="NumberOfShipments"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ChargeableWeight"
    Type="decimal"
    Precision="18"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Revenue"
    Type="decimal"
    Precision="18"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="OpportunityId"
    ReferencedTable="Opportunities"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="OpportunityProductTypeCode"
    ReferencedTable="ProductTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="CountryId"
    ReferencedTable="Countries"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>