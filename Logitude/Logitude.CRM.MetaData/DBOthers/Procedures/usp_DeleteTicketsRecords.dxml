<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="usp_DeleteTicketsRecords"
  Schema="dbo"
  Module="Unknown">
  <SqlScript>
  <![CDATA[
Create PROCEDURE [dbo].usp_DeleteTicketsRecords
(
	@Tenant int
)
AS

BEGIN

exec [dbo].usp_DoTheTableDeletionSet @Tenant = @Tenant, @TableName = 'InboundEmails'
exec [dbo].usp_DoTheTableDeletionSet @Tenant = @Tenant, @TableName = 'TicketEscalations'
exec [dbo].usp_DoTheTableDeletionSet @Tenant = @Tenant, @TableName = 'Correspondences'
exec [dbo].usp_DoTheTableDeletionSet @Tenant = @Tenant, @TableName = 'Tickets'

END
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Procedure>