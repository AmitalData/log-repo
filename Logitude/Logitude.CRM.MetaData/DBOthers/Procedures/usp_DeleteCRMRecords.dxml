<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="usp_DeleteCRMRecords"
  Schema="dbo"
  Module="CRM">
  <SqlScript>
    <![CDATA[
Create PROCEDURE [dbo].usp_DeleteCRMRecords
(
	@Tenant int
)
AS

BEGIN

exec [dbo].usp_DoTheTableDeletionSet @Tenant = @Tenant, @TableName = 'Activities'
exec [dbo].usp_DoTheTableDeletionSet @Tenant = @Tenant, @TableName = 'Opportunities'

END
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Procedure>