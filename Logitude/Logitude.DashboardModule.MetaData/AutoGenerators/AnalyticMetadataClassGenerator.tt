<#@ template debug="false" hostspecific="true" language="C#"
#><#@ Assembly Name="System.Xml.dll"
#><#@ Assembly Name="System.Xml.Linq.dll"
#><#@ Assembly Name="System.Core.dll"
#><#@ Assembly Name="Microsoft.CSharp.dll"
#><#@ Assembly Name="System.Linq.dll"
#><#@ Assembly name="$(SolutionDir)packages\AmazedSaint.ElasticObject.1.2.0\lib\net40\AmazedSaint.Elastic.dll"
#><#@ Import Namespace="System.Xml"
#><#@ Import Namespace="System.Xml.Linq"
#><#@ Import Namespace="System.Linq"
#><#@ Import Namespace="AmazedSaint.Elastic"
#><#@ Import Namespace="AmazedSaint.Elastic.Lib"
#><#@ output extension=".cs"
#><#@ import Namespace="System.Collections.Generic"
#><#@ import Namespace="System.IO"
#><#@ import Namespace="System.Windows"
#><#@ Assembly Name="Newtonsoft.Json" 
#><#@ Import Namespace="Newtonsoft.Json"
#><#@ Import Namespace="System.Dynamic"
#><#@ Import Namespace="System.IO"
#><#@ include file="$(SolutionDir)Logitude.AutoGeneratedTemplates\AutoGeneratorsMetaData\Manager.ttinclude" #>
<#
	GenerateMetaDataClass("../AnalyticsEntityFiles","../AnalyticsEntityFiles/");
#>

<#+
public void GenerateMetaDataClass(string sourceFolder, string destinationFolder)
{
    string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
    string sourceFilePath = Path.Combine(templateDirectory, sourceFolder);
    var lxmlFiles = Directory.EnumerateFiles(sourceFilePath, "*.ljson",SearchOption.AllDirectories);
    WriteMetaDataClass(lxmlFiles, destinationFolder);
    SaveOutputFile(destinationFolder);
}
#>

<#+
public void WriteMetaDataClass(IEnumerable<string> jsonFiles,string destinationFolder)
{
	 
#>
using System;
using System.Collections.Generic;
using Newtonsoft.Json;

//-----------------------------------------------------------------------
//
// THIS IS AUTO GENERATED FILE. DO NOT MAKE MANUAL CHANGES
//
//-----------------------------------------------------------------------
namespace Logitude.DashboardModule.MetaData.AnalyticsEntityFiles
{   
    public partial class AnalyticsMetadatas<T>
    {

        public List<T> GetAllTables()
        {
            var tables = new List<T>();
                        <#+
            foreach (string jsonString in jsonFiles)
            {
    
               #>  
            tables.Add(JsonConvert.DeserializeObject<T>("<#= GetJsonString(jsonString)#>"));
               <#+  
            }
             #> 
            return tables;
        }
    }
}
<#+
}
#>


<#+
private string GetJsonString(string fileName)
{
   StreamReader r = new StreamReader(fileName);
   var jsoString = JsonConvert.SerializeObject(JsonConvert.DeserializeObject(r.ReadToEnd()));
   return jsoString.Replace("\"", "\\\"");
}
#>

<#+
void SaveOutputFile(string outputFileName)
  {
      outputFileName  = outputFileName +  "AnalyticsMetadatas.cs";
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
	  
	    var manager = Manager.Create(Host, GenerationEnvironment);
	    manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString());
	    this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
     
  }
#>