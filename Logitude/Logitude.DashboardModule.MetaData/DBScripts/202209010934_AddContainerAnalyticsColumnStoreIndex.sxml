<Script DBType="Main" Module="Dashboard" Env="Logitude,local,test">
  <Sql Version="2">
    <![CDATA[
      BEGIN
          IF EXISTS (SELECT *  FROM sys.indexes  WHERE NAME='IX_ContainerAnalytics_ColumnStore' AND object_id = OBJECT_ID('[ContainerAnalytics]'))
          BEGIN
				DROP INDEX IX_ContainerAnalytics_ColumnStore ON ContainerAnalytics;
          END
		  CREATE COLUMNSTORE INDEX IX_ContainerAnalytics_ColumnStore ON ContainerAnalytics (
	        Id,Tenant,CreateDate,UpdateDate,CreatedByUserId,UpdatedByUserId,ContainerNumber,MainCarriageCarrierId,EstimatedEmptyPickupDate,
            ActualEmptyPickupDate,EmptyPickupLocationPortId,HasContainerException,ShipmentPickupFrom,
            ShipmentPickupTo,PreCarriageLocationPortId,PreCarriageETD,PreCarriageATD,POLLocation,
            EstimatedPOLArrival,ActualPOLArrival,EstimatedPOLLoaded,ActualPOLLoaded,EstimatedPOLVesselDeparture,
            ActualPOLVesselDeparture,TransshipmentCount,Transshipment1LocationPortId,
            EstimatedTrans1VesselArrival,ActualTransshipment1VesselArrival,EstimatedTransshipment1Discharge,
            ActualTransshipment1Discharge,EstimatedTransshipment1Loaded,ActualTransshipment1Loaded,
            EstimatedTrans1VesselDeparture,ActualTrans1VesselDeparture,Transshipment2LocationPortId,
            EstimatedTrans2VesselArrival,ActualTransshipment2VesselArrival,EstimatedTransshipment2Discharge,
            ActualTransshipment2Discharge,EstimatedTransshipment2Loaded,ActualTransshipment2Loaded,
            EstimatedTrans2VesselDeparture,ActualTrans2VesselDeparture,Transshipment3LocationPortId,
            EstimatedTrans3VesselArrival,ActualTransshipment3VesselArrival,EstimatedTransshipment3Discharge,
            ActualTransshipment3Discharge,EstimatedTransshipment3Loaded,ActualTransshipment3Loaded,
            EstimatedTrans3VesselDeparture,ActualTrans3VesselDeparture,Leg1VesselId,Leg1Voyage,Leg2VesselId,
            Leg2Voyage,Leg3VesselId,Leg3Voyage,Leg4VesselId,Leg4Voyage,Leg5VesselId,Leg5Voyage,
            EstimatedPODVesselArrival,ActualPODVesselArrival,EstimatedPODDischarge,ActualPODDischarge,
            EstimatedPODDeparture,ActualPODDeparture,OnCarriageLocationPortId,OnCarriageETD,OnCarriageATD,
            GateIn,GateOut,EmptyReturnLocationPortId,EstimatedEmptyReturn,ActualEmptyReturn,LastFreeDayDate,
            FreeDays,ShipmentNumber,ContainersCount,HandlerId,CustomerId,OPClosed,ShipmentTypeId,
            ShipmentCreateDate,IsClosed,StatusId,IsCancelled,ShipmentDeliveryTruckerId,HasException,
            PreCarriageGateIn,OnCarriageGateOut,Volume,GrossWeight,ShipmentStatusId
          );
      END

    ]]>       
  </Sql>
</Script>
