<Script DBType="Main" Module="Dashboard" Env="Logitude,local,test">
  <Sql Version="1">
    <![CDATA[
      BEGIN
          IF EXISTS (SELECT *  FROM sys.indexes  WHERE NAME='IX_ShipmentAnalytics_ColumnStore' AND object_id = OBJECT_ID('[ShipmentAnalytics]'))
          BEGIN
				DROP INDEX IX_ShipmentAnalytics_ColumnStore ON ShipmentAnalytics;
          END
		  CREATE COLUMNSTORE INDEX IX_ShipmentAnalytics_ColumnStore ON ShipmentAnalytics (

				Id, Tenant, CreateDateTime, ShipmentNumber, BranchId, IncotermId,
				SalesmanUserId, AccountManagerUserId, ShipmentTypeId, TransportModeId,
				DirectionId, ShipmentLevelCode, ShipperId, ConsigneeId, AgentId,
				CustomerId, IsOperationalClosed, IsAccountingClosed, GrossWeightInKG,
				ChargeableWeightInKG, VolumeInCBM, TEU, PackagesQuantity, StatusId,
				IsCancelled, OpenReceivablesInLocalCurrency, AccountedReceivablesInLocalCurrency,
				ProfitInLocalCurrency, ProfitInProfitCurrency,OpenReceivablesInProfitCurrency,
				AccountedReceivablesInProfitCurrency,OpenPayablesInLocalCurrency, AccountedPayablesInLocalCurrency,
				OpenPayablesInProfitCurrency,AccountedPayablesInProfitCurrency, ARInvoiceIssued,
				ShipmentSubTypeId,MainCarriageCarrierId, NumberOfPackages, NumberOfContainers, OperationalDate,
				FromCountryId, ToCountryId,
				MainCarriageFromPortId,
				MainCarriageToPortId
                );
      END

    ]]>       
  </Sql>
</Script>
