<Script DBType="Main" Module="Dashboard" AOT="true" TargetTableName="ARInvoices" BatchSize="10000" Env="Logitude,local,test">
  <Sql Version="1">
    <![CDATA[

    

        INSERT INTO ARInvoiceAnalytics 
