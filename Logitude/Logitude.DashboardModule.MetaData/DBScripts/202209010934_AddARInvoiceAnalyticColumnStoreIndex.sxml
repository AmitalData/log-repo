<Script DBType="Main" Module="Dashboard" Env="Logitude,local,test">
  <Sql Version="2">
    <![CDATA[
      BEGIN
          IF EXISTS (SELECT *  FROM sys.indexes  WHERE NAME='IX_ARInvoiceAnalytics_ColumnStore' AND object_id = OBJECT_ID('[ARInvoiceAnalytics]'))
          BEGIN
				DROP INDEX IX_ARInvoiceAnalytics_ColumnStore ON ARInvoiceAnalytics;
          END
		  CREATE COLUMNSTORE INDEX IX_ARInvoiceAnalytics_ColumnStore ON ARInvoiceAnalytics (
      



Id
,Tenant
,IsClosed
,AmountInProfitCurrency
,ProfitCurrencyId
,PrepaidCollectId
,IssuedByUserId
,DraftNumber
,MainEntityReference
,InvoiceNumber
,ARInvoiceTypeCode
,PaymentTermId
,AmountDueInLocalCurrency
,AmountDueInProfitCurrency
,BillToId
,BillToAddressId
,VatNumber
,CreateDate
,InvoiceDate
,CreatedByUserId
,PrintByUserId
,InvoiceCurrencyId
,IsPrinted
,UpdateDate
,UpdatedByUserId
,LocalCurrencyId
,SubTotalInLocalCurrency
,AmountInLocalCurrency
,StatusCode
,IsAutoCredit
,IsCancelled
,DueDate
,PrintDate
,IsInvoiceNumberManuallySet
,Sent
,TransferError
,TransferStatusCode
,BranchId
,IsConstituentInvoice
,IsConsolidationInvoice
,IsTransferStarted
,ApprovedDate
,ApprovedByUserId
,OperationalDate
,IsMultiCurrency
,SalesmanUserId
,Intercompany
,BankAccountLiteId
,RegionalTaxId
,RegionalTaxPercentage
,PaidDate
,PartnerId
                
                );
      END

    ]]>       
  </Sql>
</Script>

