<Script DBType="Main" Module="Dashboard" AOT="true" TargetTableName="Opportunities" BatchSize="10000" Env="Logitude,local,test">
	<Sql Version="1">
		<![CDATA[
        INSERT INTO OpportunityAnalytics 
        (
        Id,
		Tenant,
		OwnerId,
		Subject,
		CustomerId,
		LeadSourceId,
		ContactId,
		EstimatedClosingDate,
		StageId,
		Probability,
		CreateDate,
		CreatedByUserId,
		UpdateDate,
		UpdatedByUserId,
		RatingCode,IsClosed,
		ActualClosingDate,
		ClosingDescription,
		NumberOfShipments,
		ValueField,
		LastStageDate,
		LastStageIdBeforeClosure,
		LastCompletedActivityDate,
		LeadDescription,
		LastCompletedActivityTypeCode,
		LastActivitySubject,
		NextActivityDate,
		NextActivityTypeCode,
		NextActivitySubject,
		Notes,
		StageDueDate,
		BusinessUnitId,
		LeadUserId,
		LeadPartnerId,
		AgentId,
		ForeignClientId,
		ClosingReasonId,
		IsCancelled,
		OpportunityTypeId,
		NumberOfConnectedQuotes
        )

        SELECT
        Opportunities.Id,
		Opportunities.Tenant,
		Opportunities.OwnerId,
		Opportunities.Subject,
		Opportunities.CustomerId,
		Opportunities.LeadSourceId,
		Opportunities.ContactId,
		Opportunities.EstimatedClosingDate,
		Opportunities.StageId,
		Opportunities.Probability,
		Opportunities.CreateDate,
		Opportunities.CreatedByUserId,
		Opportunities.UpdateDate,
		Opportunities.UpdatedByUserId,
		Opportunities.RatingCode,IsClosed,
		Opportunities.ActualClosingDate,
		Opportunities.ClosingDescription,
		Opportunities.NumberOfShipments,
		Opportunities.ValueField,
		Opportunities.LastStageDate,
		Opportunities.LastStageIdBeforeClosure,
		Opportunities.LastCompletedActivityDate,
		Opportunities.LeadDescription,
		Opportunities.LastCompletedActivityTypeCode,
		Opportunities.LastActivitySubject,
		Opportunities.NextActivityDate,
		Opportunities.NextActivityTypeCode,
		Opportunities.NextActivitySubject,
		Opportunities.Notes,
		Opportunities.StageDueDate,
		Opportunities.BusinessUnitId,
		Opportunities.LeadUserId,
		Opportunities.LeadPartnerId,
		Opportunities.AgentId,
		Opportunities.ForeignClientId,
		Opportunities.ClosingReasonId,
		Opportunities.IsCancelled,
		Opportunities.OpportunityTypeId,
		Opportunities.NumberOfConnectedQuotes

        FROM Opportunities	
		WHERE $LastCounterWhere$
    ]]>
	</Sql>
</Script>
