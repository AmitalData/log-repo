<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="Widgets"
  Schema="dbo"
  DBType="Main"
  Module="DashboardModule">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Title"
    Type="nvarchar"
    Size="300">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="GroupById"
    OldNames="GroupBy"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DashboardId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="StartPotistion"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EndPosition"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="TypeCode"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EntityId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Filters"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DateGroupCode"
    Type="varchar"
    Size="17">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="GroupById"
    ReferencedTable="AnalyticsFactsFieldsMetaDatas"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="DashboardId"
    ReferencedTable="Dashboards"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="TypeCode"
    ReferencedTable="WidgetTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="EntityId"
    ReferencedTable="AnalyticsFactsMetaDatas"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>