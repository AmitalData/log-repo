<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="WidgetMeasures"
  Schema="dbo"
  DBType="Main"
  Module="DashboardModule">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="WidgetId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="MeasureCode"
    Type="varchar"
    Size="17">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="MeasureFieldId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="RenderAs"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="YAxisType"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="WidgetId"
    ReferencedTable="Widgets"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="MeasureCode"
    ReferencedTable="MeasureTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="MeasureFieldId"
    ReferencedTable="AnalyticsFactsFieldsMetaDatas"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>