<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="APInvoiceAnalytics"
  Schema="dbo"
  DBType="Main"
  Module="DashboardModule">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="InternalNumber"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="InvoiceNumber"
    Type="varchar"
    Size="25">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="VendorId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="VATNumber"
    Type="varchar"
    Size="30">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="InvoiceDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="PaymentTermId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DueDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>  
  <Column
    Name="InvoiceCurrencyId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LocalCurrencyId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SubTotalInLocalCurrency"
    Type="float">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="AmountInLocalCurrency"
    Type="float">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="StatusCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreatedByUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsClosed"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ProfitCurrencyId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="AmountInProfitCurrency"
    Type="float">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UpdatedByUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UpdateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="MainEntityReference"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AmountDueInLocalCurrency"
    Type="float">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AmountDueInProfitCurrency"
    Type="float">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="BranchId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsTransferStarted"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="TransferStatusCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ApprovedDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ApprovedByUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="OperationalDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FirstApproveDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TotalVATOnly"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="PaidDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
