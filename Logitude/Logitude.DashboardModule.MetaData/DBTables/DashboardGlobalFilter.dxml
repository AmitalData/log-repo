<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="DashboardGlobalFilters"
  Schema="dbo"
  DBType="Main"
  Module="DashboardModule">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DashboardId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsCommonFilter"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CommonFilterField"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DataSetId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DataSetFieldId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FilterOperator"
    OldNames="Operator"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DataTypeCode"
    Type="varchar"
    Size="10">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LineNumber"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="DashboardId"
    ReferencedTable="Dashboards"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="DataSetId"
    ReferencedTable="AnalyticsFactsMetaDatas"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="DataSetFieldId"
    ReferencedTable="AnalyticsFactsFieldsMetaDatas"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>