<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="DashboardSharedUsers"
  Schema="dbo"
  DBType="Main"
  Module="DashboardModule">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DashboardId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="DashboardId"
    ReferencedTable="Dashboards"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="UserId"
    ReferencedTable="Users"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>