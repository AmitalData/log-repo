<!--
please use <Update> tag inside <Updates> tag to add any updates you want to execute,
in the updates you might add {updatetenantzero,customs,tenants,crm,social,accounting,warehouse} to be updated
Please use <BuildZipFiles> tag inside <ZipFiles> tag to add the build zip files,
in the zip files you can add {buildzipfilesgeneral,buildzipfilescustoms} to be built.
Please use <script> tag inside <Scripts> tag to add a script to execute.
if you want to execute a script before the update just assign the attribute order to "before" else assign it to "after"
-->
  
<Root>
  
<Updates>
 <Update>
    updatetenantzero
  </Update>
 
  <Update>
    customs
  </Update>
  <!-- 
 <Update>
    tenants
  </Update>-->
</Updates>
  
<ZipFiles>
   <BuildZipFiles>
      buildzipfilesgeneral
   </BuildZipFiles>
   <BuildZipFiles>
     buildzipfilescustoms
   </BuildZipFiles>
</ZipFiles>
  
<Scripts>
