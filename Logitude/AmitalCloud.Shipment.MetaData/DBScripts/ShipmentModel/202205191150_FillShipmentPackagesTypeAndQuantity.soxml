<Script DBType="Main" Module="Shipment" AOT="true" TargetTableName="ShipmentComputedFields">
	<Sql Version="1">
		<![CDATA[
		    

declare @ShipmentId as varchar(15)
declare @Tenant as int
declare @PackagesQuantityAndType as varchar(2000)
declare @SavedPackagesQuantityAndType as varchar(2000)
declare @PackagesCount as int

BEGIN 
		DECLARE ShipmentsCursor CURSOR READ_ONLY
		FOR
		SELECT ShipmentComputedFields.Id, ShipmentComputedFields.Tenant
		FROM ShipmentComputedFields
		join Shipments
		on ShipmentComputedFields.Id = Shipments.Id
		where $LastCounterWhere$ and (Shipments.NumberOfPackages > 0 or Shipments.NumberOfContainers > 0)
		OPEN ShipmentsCursor FETCH NEXT FROM ShipmentsCursor INTO @ShipmentId, @Tenant
		WHILE @@FETCH_STATUS = 0
			BEGIN

				set @PackagesQuantityAndType = ''
				set @SavedPackagesQuantityAndType = ''
				set @PackagesCount = (select COUNT(*) from ShipmentPackages where ShipmentId = @ShipmentId and Tenant = @Tenant)
				
				if (@PackagesCount > 0)
				begin
					
					declare @PackageTypeId as varchar(15)
					declare @PackageTypeCode as varchar(15)
					declare @QTY as int

					BEGIN 
							DECLARE PackagesCursor CURSOR READ_ONLY
							FOR
							SELECT Quantity, PackageTypeId
							FROM ShipmentPackages							
							where Tenant = @Tenant and ShipmentId = @ShipmentId
							OPEN PackagesCursor FETCH NEXT FROM PackagesCursor INTO @QTY, @PackageTypeId
							WHILE @@FETCH_STATUS = 0
								BEGIN
									declare @QTYString as varchar (20)
									set @QTYString = CONVERT(varchar(20), @QTY)
									set @PackageTypeCode = (select Code from PackageTypes where Id = @PackageTypeId and Tenant = @Tenant)

									if(@QTY is not null and @QTY > 0)
									begin																	
										
										if(@PackageTypeCode is not null)
										begin
											if (@PackagesQuantityAndType = '') set @PackagesQuantityAndType = @QTYString + 'x' + @PackageTypeCode
											else set @PackagesQuantityAndType = @PackagesQuantityAndType + ', ' + @QTYString + 'x' + @PackageTypeCode
										end

										else 
										begin
											if (@PackagesQuantityAndType = '') set @PackagesQuantityAndType = @QTYString
											else set @PackagesQuantityAndType = @PackagesQuantityAndType + ', ' + @QTYString
										end

									end
									
								FETCH NEXT FROM PackagesCursor INTO @QTY, @PackageTypeId
								END
							CLOSE PackagesCursor
							DEALLOCATE PackagesCursor
					END
				end

				if(LEN(@PackagesQuantityAndType) > 2000)				
					set @SavedPackagesQuantityAndType = SUBSTRING(@PackagesQuantityAndType, 1, 2000)				

				else 
					set @SavedPackagesQuantityAndType = @PackagesQuantityAndType

				update ShipmentComputedFields set PackagesQuantityAndType = @SavedPackagesQuantityAndType where Id = @ShipmentId and Tenant = @Tenant

			FETCH NEXT FROM ShipmentsCursor INTO @ShipmentId, @Tenant
			END
		CLOSE ShipmentsCursor
		DEALLOCATE ShipmentsCursor
END



        ]]>
	</Sql>
</Script>