<Script DBType="Main" Module="Shipment" TargetTableName="Shipments">
  <Sql Version="1">
    <![CDATA[
   
	

declare @Tenant as int
declare @Id as varchar(15)
declare @HorseId as nvarchar(15)
declare @HorseName as varchar(200)
declare @SearchFields as nvarchar(max)

BEGIN
		DECLARE DataCursor CURSOR READ_ONLY
		FOR
		SELECT Shipments.Id, Shipments.Tenant, Shipments.SearchFields, ShipmentPackages.HorseId
		FROM Shipments	
		join ShipmentPackages 
		on Shipments.Id = ShipmentPackages.ShipmentId
		where ShipmentPackages.HorseId is not null and Shipments.Tenant in (1, 42, 222, 973, 1255, 2137, 2138)
		OPEN DataCursor FETCH NEXT FROM DataCursor INTO @Id, @Tenant, @SearchFields, @HorseId
		WHILE @@FETCH_STATUS = 0
		BEGIN

			set @HorseName = (select Name from Horses where Id = @HorseId and Tenant = @Tenant)

			if(@HorseName is not null)
			begin
				declare @NewSearchFieldValue nvarchar(max) = (select SearchFields from Shipments where Id = @Id and Tenant = @Tenant)
				set @NewSearchFieldValue = @NewSearchFieldValue + ',' + @HorseName				
				update Shipments set SearchFields = @NewSearchFieldValue where Id = @Id and Tenant = @Tenant
			end

		FETCH NEXT FROM DataCursor INTO @Id, @Tenant, @SearchFields, @HorseId
		END				
		CLOSE DataCursor
		DEALLOCATE DataCursor
END
  
    ]]>
  </Sql>
</Script>