<Script DBType="Main" Module="Shipment" AOT="true" TargetTableName="Containers">
	<Sql Version="1">
		<![CDATA[
    
		  update Containers set HasTransshipments = 1
			where (TransshipmentCount > 0 or ShipmentTransshipment1FromId is not null) and $LastCounterWhere$    
      
        ]]>
	</Sql>
</Script>


