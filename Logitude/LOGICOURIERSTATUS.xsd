  <xs:element name="LastMileStatus" type="xs:string" />
  <xs:element name="LastMileStatusDate" type="xs:string" />
  <xs:element name="LastMileStatusRemarks" type="xs:string" />
  <xs:element name="Param" type="xs:string" />
</xs:schema>