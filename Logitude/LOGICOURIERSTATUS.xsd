<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://tempuri.org/LOGICOURIERSTATUS" elementFormDefault="qualified" targetNamespace="http://tempuri.org/LOGICOURIERSTATUS" xmlns:xs="http://www.w3.org/2001/XMLSchema">
