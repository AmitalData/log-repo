<#+

dynamic domainservicenamespacestring;
bool UpdateClassesRegisterarNameSpace;
bool UseUpdateClassesNameSpace;
string SrcFolder;
public void GenerateAllServices(string sourceFolder,string destinationFolder,string modelname)
{
 SrcFolder = sourceFolder;
 domainservicenamespacestring = GetPMServiceNameSpace(destinationFolder);
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string outputFilePath = Path.Combine(templateDirectory, sourceFolder);
foreach (string file in Directory.EnumerateFiles(outputFilePath, "*.lxml"))
{

    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	GenerateEntityPMService(file,destinationFolder+"/Generated/"+fileNameWithoutExtension.ToLower()+"-pm.service.generated.ts",modelname);
 
}

}
#>

<#+  

public void GenerateEntityPMService(string xmlFilePath,string outputFilePath,string modelname)
{
	if(string.IsNullOrEmpty(domainservicenamespacestring))
    {
		domainservicenamespacestring = GetPMServiceNameSpace(outputFilePath);
    }

        var entity = FromEntityPMServiceFile(xmlFilePath);
        if( entity.IsComposition.GetType() == typeof(string))
      	{
	    	if(entity.IsComposition == "true")
	    	{
	    		return;
	    	}
	    } 
		
          WriteEntityPMServiceMethod(entity,modelname); 
          SaveEntityPMServiceOutput(outputFilePath);
        

 }



#>

<#+

public dynamic GetPMServiceNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }

	spacestring = spacestring.ToString().Replace("JustWebFreight.","").Trim('.');

	return spacestring;
}

#>

<#+
void SaveEntityPMServiceOutput(string outputFileName)
  {
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
     
	    var manager = Manager.Create(Host, GenerationEnvironment);
	  manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString());
	  this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
  }
#>



<#+
 private void WriteEntityPMServiceMethod(dynamic entity,string modelname)
{
    string tableName = entity.ObjectTableName.Trim('"');
	string dBTableName = entity.DBTableName.Trim('"');
	if(tableName.ToString().Trim('"').Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
          
    }

	string parententity = "object";
	string parentKeys = tableName + "Keys";
	if(entity.ParentTableName.GetType() == typeof(string))
    {
		parententity = entity.ParentTableName +"PM";
		parentKeys =entity.ParentTableName + "Keys";
    }

    string listName = tableName + "List";
    string pmName = tableName + "PM";
	string controllerName = dBTableName.ToLower();

   
	   string importentitytring = Environment.NewLine + "import {"+pmName+"} from '../../entity-pms/generated/" + pmName + ".generated';";
	   importentitytring += Environment.NewLine + BuildPMImportEntitesString(entity);
	 
	  Dictionary<string,string> primaryKeys = new Dictionary<string,string>();
	  string keysstring = "";
	   
	  bool hasTenant = false;
		 foreach(var field in entity["field"])
		 {
		  if( field.IsPrimaryKey.GetType() == typeof(string))
			{
				if(field.IsPrimaryKey == "true")
				{ 
					 primaryKeys.Add(field.FieldName.Trim('"'),GetDataType(field));

				}
			}

			if( field.FieldName.ToString().Trim('"') == "Tenant")
			{
				 hasTenant = true;
			 
			}
		 }


		 string tenantParam ="";
		 string tenantonlyParam = "";
		 string tenantCondition = "";
		 string tenantKeyCondition = "";
		 string getalltenantCondition = "";
		 if(hasTenant)
         {
			 tenantParam = ", int tenant";
			 tenantonlyParam = ", tenant";
			 tenantCondition = "&& a.Tenant == tenant";
			 getalltenantCondition = "\n                   where a.Tenant == tenant";

		     tenantKeyCondition = "&& a.Tenant == keys.Tenant";
         }

		 string primarykeyParam="";
		 string primaryonlyparam = "";
		 string primarykeyCondition = "";
		// string keyprimarykeyCondition = "";
		int index = 0;
		 foreach(string key in primaryKeys.Keys)
         {
		   if(index > 0)
           {
			   primaryonlyparam += "+'&'+";
           }
			 primarykeyParam +=  key.ToLower() + ": " + primaryKeys[key]+ ", ";
			 primaryonlyparam +="'" +key.ToLower() + "=' + " + key.ToLower() ;
			 primarykeyCondition += " a." + key +" == "  + key.ToLower() +" &&";
			// keyprimarykeyCondition += " a." + key +" == a."  + key +" &&";



			index++;
         }
		 
		 primarykeyParam = primarykeyParam.TrimEnd(' ').TrimEnd(',');
		 primaryonlyparam = primaryonlyparam.TrimEnd(' ').TrimEnd('&');
		 primarykeyCondition = primarykeyCondition.TrimEnd('&').TrimEnd('&').Trim(' ');
		// keyprimarykeyCondition = keyprimarykeyCondition.TrimEnd('&').TrimEnd('&').Trim(' ');
		  
     
   #>
import {Injectable} from 'angular2/core';
import {Http, Headers} from 'angular2/http';
import 'rxjs/add/operator/map';
import Rx from 'rxjs/Rx';
import {ServiceArgs} from '../../../infrastructure/data-contracts/service-args';
<#= importentitytring #>

@Injectable()
export class <#= pmName #>Service {

 private _apiUrl: string = 'http://localhost:9996/api/<#= controllerName #>';
 private _http: Http;
 private _serviceArgs: ServiceArgs;
 constructor() {
        
    }

    setServiceArgs(serviceArgs: ServiceArgs) {
        this._serviceArgs = serviceArgs;
        this._http = serviceArgs.http;
    }

 get(<#= primarykeyParam #>) {
         
        console.log('--------------------------------------> calling getSingleEntityPM:');
        var authHeader = new Headers();
        authHeader.append('Token', '2acc0a3d-a948-41fe-8a19-51a6d787e4fc');
		
		 return Rx.Observable.defer(() => {
                return this._http.get(this._apiUrl+'?'+<#= primaryonlyparam #>, {
                    headers: authHeader
                }).map(response => {
                    var pm = response.json();
                    
					
                    var entity: <#= pmName #>;
                    entity = this.MapJsonToEntityPM(pm);
                    
					return entity;
                });
            }

            );
       

     
         
    }

	 insert(entityPM: <#= pmName #>) {
        console.log('--------------------------------------> calling updateEntityPM:');
        var authHeader = new Headers();
        authHeader.append('Token', '2acc0a3d-a948-41fe-8a19-51a6d787e4fc');
        authHeader.append('Content-Type', 'application/json');
        console.log('server call ---------');
        return Rx.Observable.defer(() => {
            return this._http.post(this._apiUrl, JSON.stringify(entityPM), {
                headers: authHeader,

            }).map(response => {
                var result = response.json();

                return result;
            });
        }

        );
    }

    update(entityPM: <#= pmName #>) {

        console.log('--------------------------------------> calling updateEntityPM:');
        var authHeader = new Headers();
        authHeader.append('Token', '2acc0a3d-a948-41fe-8a19-51a6d787e4fc');
        authHeader.append('Content-Type', 'application/json');
        console.log('server call ---------');
        return Rx.Observable.defer(() => {
            return this._http.put(this._apiUrl, JSON.stringify(entityPM),{
                headers: authHeader,
                
            }).map(response => {
                var result = response.json();
                
                return result;
            });
        }

        );

    }

   

	    MapJsonToEntityPM(jsonPM: any) {
       
            var entityPM: <#= pmName #>;
            entityPM = new <#= pmName #>();
            var jsonPMKeys = Object.keys(jsonPM);

            for (var key in jsonPMKeys) {
                var property = jsonPMKeys[key];
                entityPM[property] = jsonPM[property];
            }
			
		<#+ 
		 foreach(var field in entity["field"])  //get all classes
	     { 
		   if( field.HasPMField.GetType() == typeof(string))
           {
             if(field.HasPMField == "false")
               {
                  continue;
               }
           }
		   string type = GetDataType(field);
		   if(type == "List" || (field.IsMulti.GetType() == typeof(string) && field.IsMulti == "true"))
           {
			    string fieldName = field.FieldName.ToString().Trim('"');
			    string pmname = field.FieldName.ToString().Trim('"').TrimEnd('s') + "PM";
			   #>
			  
			    entityPM.<#= fieldName #> = new Array<<#= pmname #>>();
		    	for (var item in jsonPM.<#= fieldName #>) {
                var jItem = jsonPM.<#= fieldName #>[item];
                var newPMItem: <#= pmname #>;
                newPMItem = new <#= pmname #>(entityPM);
                var pmKeysArray = Object.keys(jItem);
                for (var pmKey in pmKeysArray) {
                    var pmProperty = pmKeysArray[pmKey];
                    newPMItem[pmProperty] = jItem[pmProperty];
                }
                newPMItem.IsDirty = false;
                entityPM.<#= fieldName #>.push(newPMItem);
            }

			   <#+
			   
		    }
		   
	       }
			 #>
			 
            entityPM.IsDirty = false;

        return entityPM;
    }


}
<#+



}

#>



<#+
public string BuildPMImportEntitesString( dynamic entity)
{
	string importentitystring = "";
	

	foreach(var field in entity["field"])  //get all classes
	 { 
		  if( field.HasPMField.GetType() == typeof(string))
           {
             if(field.HasPMField == "false")
               {
                  continue;
               }
           }
		   string type = GetDataType(field);
		   if(type == "List" || (field.IsMulti.GetType() == typeof(string) && field.IsMulti == "true"))
           {
			    string pmname = field.FieldName.ToString().Trim('"').TrimEnd('s') + "PM";
				importentitystring += Environment.NewLine + "import {"+pmname+"} from '../../entity-pms/generated/" + pmname + ".generated';";

           }
		   
	 }

	 return importentitystring;
}
 #>

<#+
public  string FirstServiceCharacterToLower(string str)
{
    if (String.IsNullOrEmpty(str) || Char.IsLower(str, 0))
        return str;

    return Char.ToLowerInvariant(str[0]).ToString() + str.Substring(1);
}
#>





<#+
//Create an elastic object
private dynamic FromEntityPMServiceFile(string file)
{
   var path= Host.ResolvePath(file);
   return XDocument.Load(path).Root.ToElastic();
}

#>