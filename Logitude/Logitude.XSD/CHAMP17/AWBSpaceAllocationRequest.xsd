<?xml version="1.0"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:GCCSCargoImp="http://www.champ.aero/GCCS/CargoXML"
           targetNamespace="http://www.champ.aero/GCCS/CargoXML" version="2.0">

    <xs:include schemaLocation="common_waybill.xsd"/>

    <xs:complexType name="AWBSpaceAllocationRequest">
        <xs:sequence>
            <xs:element name="StandardMessageIdentification" type="GCCSCargoImp:StandardMessageIdentification"    minOccurs="1"/>
            <xs:element name="ConsignmentDetail"             type="GCCSCargoImp:ConsignmentDetail_FFR"            minOccurs="1"/>
            <xs:element name="FlightDetails"                 type="GCCSCargoImp:FlightDetails_FFR"                minOccurs="1" maxOccurs="999"/>
            <xs:element name="ULDDescription"                type="GCCSCargoImp:ULDDescriptionGroup"              minOccurs="0"/>
            <xs:element name="SpecialServiceRequest"         type="GCCSCargoImp:SpecialServiceRequest_FFR"        minOccurs="0"/>
            <xs:element name="OtherServiceInformation"       type="GCCSCargoImp:OtherServiceInformation_FFR"      minOccurs="0" />
            <xs:element name="BookingReference"              type="GCCSCargoImp:BookingReference_FFR"             minOccurs="1" />
            <xs:element name="DimensionsInformation"         type="GCCSCargoImp:DimensionsInformation"            minOccurs="0" maxOccurs="999"/>
		        <xs:element name="ProductInformation"            type="GCCSCargoImp:ProductInformation_FFR"/>
            <xs:element name="Shipper"                       type="GCCSCargoImp:Account"/>
            <xs:element name="Consignee"                     type="GCCSCargoImp:Account"/>
            <xs:element name="CustomerIdentification"        type="GCCSCargoImp:Agent"/>
            <xs:element name="ShipmentReferenceInformation"  type="GCCSCargoImp:ShipmentReferenceInformation"/>
        </xs:sequence>
    </xs:complexType>

    <!-- consignment detail -->

	<xs:complexType name="ConsignmentDetail_FFR">
        <xs:sequence>
            <xs:element name="AWBIdentification"           type="GCCSCargoImp:AWBIdentification"/>
            <xs:element name="AWBOriginAndDestination"     type="GCCSCargoImp:AWBOriginAndDestination" minOccurs="1"/>
            <xs:element name="QuantityDetail"              type="GCCSCargoImp:QuantityDetail_FFR" minOccurs="1"/>
			<xs:element name="Volume"                      type="GCCSCargoImp:Volume_FFR" minOccurs="0"/>
            <xs:element name="Density"                     type="GCCSCargoImp:Density_FFR" minOccurs="0"/>
            <xs:element name="TotalConsignmentPieces"      type="GCCSCargoImp:TotalConsignmentPieces" minOccurs="0"/>
	        <xs:element name="NatureOfGoods"               type="GCCSCargoImp:ManifestDescriptionOfGoods" minOccurs="1"/>
		    <xs:element name="SpecialHandlingRequirements" type="GCCSCargoImp:SpecialHandlingDetails" minOccurs="0"/>						
        </xs:sequence>
    </xs:complexType>

   <xs:complexType name="QuantityDetail_FFR">
        <xs:attribute name="ShipmentDescriptionCode" type="GCCSCargoImp:ShipmentDescriptionCode" use="required"/>
        <xs:attribute name="NumberOfPieces"          type="GCCSCargoImp:NumberOfPieces" use="required"/>
        <xs:attribute name="WeightCode"              type="GCCSCargoImp:WeightCode" use="required"/>
        <xs:attribute name="Weight"                  type="GCCSCargoImp:Weight" use="required"/>
    </xs:complexType>

    <xs:complexType name="Volume_FFR">
        <xs:attribute name="VolumeCode"   type="GCCSCargoImp:VolumeCode" use="required"/>
        <xs:attribute name="VolumeAmount" type="GCCSCargoImp:VolumeAmount" use="required"/>
    </xs:complexType>

    <xs:complexType name="Density_FFR">
        <xs:attribute name="DensityIndicator" type="GCCSCargoImp:DensityIndicator" use="required"/>
        <xs:attribute name="DensityGroup" type="GCCSCargoImp:DensityGroup" use="required"/>
    </xs:complexType>

    <!-- flight details -->

	<xs:complexType name="FlightDetails_FFR">
        <xs:sequence>
            <xs:element name="FlightIdentification"          type="GCCSCargoImp:FlightIdentification_FFR" minOccurs="1"/>
            <xs:element name="AirportsOfDepartureAndArrival" type="GCCSCargoImp:AWBOriginAndDestination" minOccurs="1"/>
			
        </xs:sequence>
        <xs:attribute name="SpaceAllocationCode"     type="GCCSCargoImp:SpaceAllocationCode" use="required"/>
		<xs:attribute name="AllotmentIdentification" type="GCCSCargoImp:AllotmentIdentification" use="optional"/>	
    </xs:complexType>

    <xs:complexType name="FlightIdentification_FFR">
        <xs:complexContent>
            <xs:extension base="GCCSCargoImp:FlightIdentification">
                <xs:attribute name="DayOfScheduledDeparture"   type="GCCSCargoImp:DayOfMonth" use="required"/>
                <xs:attribute name="MonthOfScheduledDeparture" type="GCCSCargoImp:Month" use="required"/>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- ULD Description -->

	<xs:complexType name="ULDDescriptionGroup">
        <xs:sequence>
            <xs:element name="ULDDescriptionInfo" type="GCCSCargoImp:ULDDescriptionInfo" minOccurs="1" maxOccurs="999"/>
        </xs:sequence>
        <xs:attribute name="NumberOfULDs" type="GCCSCargoImp:NumberOfULDs" use="required"/>
    </xs:complexType>

    
	<xs:complexType name="ULDDescriptionInfo">
        <xs:sequence>
            <xs:element name="ULDIdentification"      type="GCCSCargoImp:ULDIdentification_FFR" minOccurs="1"/>
            <xs:element name="ULDPositionInformation" type="GCCSCargoImp:ULDPositionInformation" minOccurs="0"/>
            <xs:element name="WeightOfULDContents"    type="GCCSCargoImp:WeightOfULDContents" minOccurs="1"/>
        </xs:sequence>
    </xs:complexType>

	<xs:complexType name="ULDIdentification_FFR">
        <xs:attribute name="ULDType"         type="GCCSCargoImp:ULDType" use="required"/>
        <xs:attribute name="ULDSerialNumber" type="GCCSCargoImp:ULDSerialNumber" use="required"/>
        <xs:attribute name="ULDOwnerCode"    type="GCCSCargoImp:ULDOwnerCode" use="required"/>
    </xs:complexType>

    <xs:complexType name="WeightOfULDContents">
        <xs:attribute name="WeightCode" type="GCCSCargoImp:WeightCode" use="required"/>
        <xs:attribute name="Weight"     type="GCCSCargoImp:Weight" use="required"/>
    </xs:complexType>

    <!-- Special Service Request -->

	<xs:complexType name="SpecialServiceRequest_FFR">
        <xs:sequence>
            <xs:element maxOccurs="2" name="SpecialServiceRequestEntry" type="GCCSCargoImp:SpecialServiceRequestEntry"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Other Service Information -->

	<xs:complexType name="OtherServiceInformation_FFR">
        <xs:sequence>
            <xs:element name="OSIDetailsFirstLine"  type="GCCSCargoImp:OtherServiceInformationEntry"/>
            <xs:element name="OSIDetailsSecondLine" type="GCCSCargoImp:OtherServiceInformationEntry" minOccurs="0" />
        </xs:sequence>
    </xs:complexType>

    <!-- Booking Reference -->

    <xs:complexType name="BookingReference_FFR">
        <xs:sequence>
            <xs:element minOccurs="0" name="RequestingOfficeMessageAddress"      type="GCCSCargoImp:OfficeMessageAddress"/>
            <xs:element minOccurs="0" name="RequestingParticipantIdentification" type="GCCSCargoImp:AWBParticipantIdentification"/>
        </xs:sequence>
        <xs:attribute name="RequestingOfficeFileReference" type="GCCSCargoImp:FileReference" use="optional"/>
    </xs:complexType>
    
	<!-- Product Information  -->
    
	<xs:complexType name="ProductInformation_FFR">
        <xs:sequence>
            <xs:element minOccurs="0" name="RateInformation" type="GCCSCargoImp:RateInformation_FFR"/>
        </xs:sequence>
        <xs:attribute name="ServiceCode" type="GCCSCargoImp:ServiceCode" use="required"/>
    </xs:complexType>

	<xs:complexType name="RateInformation_FFR">
        <xs:choice>
            <xs:element minOccurs="0" name="RateInformationDetails" type="GCCSCargoImp:CommodityItemNumberDetails"/>
        </xs:choice>
        <xs:attribute name="RateClassCode" type="GCCSCargoImp:RateClassCode" use="required"/>
    </xs:complexType>

    <!-- CustomerIdentification  -->

</xs:schema>
