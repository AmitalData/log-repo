<#+

public void GenerateMetaDataUpdateClass(string sourceFolder,string destinationFolder,string updateClassName)
{
 
 UpdateClassnamespacestring = GetUpdateClassNameSpace(destinationFolder).Replace("JustWebFreight.", "");;
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string sourceFilePath = Path.Combine(templateDirectory, sourceFolder);
 string updateclassspacestring = UpdateClassnamespacestring.ToString().Substring(0,UpdateClassnamespacestring.ToString().LastIndexOf('.')) + ".EntityUpdateClasses;";
	 
	#>

using System;
using System.Collections.Generic;
using System.Linq;
using Simplog.Data.CommonDataModel;
using Simplog.Data.CommonDataModel.EntityPOCOs;
using Simplog.Data.CommonDataModel.Repositories;
