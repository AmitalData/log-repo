<#+
private void WriteAddFieldMethod(XElement entity,XElement field)
{ 
	bool noObjectField = false;
	if(field.Attribute(XName.Get("NoMetaDataField")) != null)
    {
		noObjectField = (field.Attribute(XName.Get("NoMetaDataField")).Value.ToLower() == "true");
    }

	if(noObjectField)//field.Attribute(XName.Get("FieldName")).Value.Trim('"') == "Id" || field.Attribute(XName.Get("FieldName")).Value.Trim('"') == "Tenant" || 
    {
		return;
    }
	bool objectFieldNotRequired = false;
	if((field.Attribute(XName.Get("ObjectFieldNotRequired")) != null && field.Attribute(XName.Get("ObjectFieldNotRequired")).Value.Trim('"').ToLower() == "true"))
    {
		objectFieldNotRequired = true;
    }
#>

			   AddObjectsAndObjectFields.AddObjectField(new ObjectFieldsDetails() 
			   {
					 <#+
					 #><#=""#>
					 <#+
		   foreach (XAttribute p in field.Attributes())
				{  
					if(p.Name != "Id" && p.Name != "ObjectFieldNotRequired" && p.Name != "IsForeignKey" && p.Name != "ForeignEntity"&& p.Name != "NavigationPropertyName"&& p.Name != "IsPrimaryKey"&& p.Name != "Order" && p.Name != "IsNullable" && p.Name != "HasDataBaseField"&& p.Name != "HasPMField" && p.Name != "AssociationName" && p.Name != "ThisKey" && p.Name != "OtherKey" && p.Name != "IsComposition" && p.Name != "NoMetaDataField" && p.Name != "GenerateInList" && p.Name != "GenerateInList" && p.Name != "DontBuildRelationOnDB" && p.Name != "ShortName" && p.Name != "OldNames")
					{
					if(!string.IsNullOrEmpty(p.Value.Trim('"')))
					{
					   var propValue = p.Value.Replace("\n",@"\n");
						if(p.Name == "IsRequired" ||p.Name == "SystemRequired")
						{
							propValue = objectFieldNotRequired ? "false":propValue;
						}

					  #>
						<#= p.Name #> =  <#= propValue #>,
					  <#+
					}
					}
 
				}
     
			 
		 
	#>		
			   },TextCodeRepository,ObjectFieldsRepository,objectFields,textCodes);
 
<#+
}

#>

<#+
private void WriteAddFeaturesAndTextCodesMethod(XElement entity,XElement QueryAtt,string TblName,int index)
{ 
	   var Code = QueryAtt.Attributes().Where(a => a.Name == "Code").FirstOrDefault().Value;
	   var TextCode = QueryAtt.Attributes().Where(a => a.Name == "TextCode").FirstOrDefault().Value;
	   var temp = QueryAtt.Attributes().Where(a => a.Name == "LocalTextCode").FirstOrDefault();
	   var LocalTextCode = temp != null ? temp.Value : "null";
	   var IndexOrder = QueryAtt.Attributes().Where(a => a.Name == "IndexOrder").FirstOrDefault().Value;
	   var QuerySection = QueryAtt.Attributes().Where(a => a.Name == "QuerySection").FirstOrDefault().Value;
	   var SystemLevel = QueryAtt.Attributes().Where(a => a.Name == "SystemLevel").FirstOrDefault().Value;
	   var IsAddNewEntity = QueryAtt.Attributes().Where(a => a.Name == "IsAddNewEntity").FirstOrDefault().Value;
       var DefaultSortName = QueryAtt.Attributes().Where(a => a.Name == "DefaultSortName").FirstOrDefault().Value;
	   var DefaultSortDirection = QueryAtt.Attributes().Where(a => a.Name == "DefaultSortDirection").FirstOrDefault().Value;
	   var QGCode = QueryAtt.Attributes().Where(a => a.Name == "QueryGroupCode").FirstOrDefault().Value;
	   var IsPackagable = QueryAtt.Attributes().Where(a => a.Name == "IsPackagable").FirstOrDefault();
	string Packagable;
    if (IsPackagable == null)
    {
		 Packagable = "false";
    }
    else
    {
	      Packagable =  IsPackagable.Value;  
    }
	  
#> 

			   TextCode <#= TblName.Trim('"') #>TextCode_<#= index #> = AddTextCodes.AddTextCode(new TextCodeDetails() { Code = "<#= TblName.Trim('"') #>.Q.<#= Code.Trim(new char[]{' ','"'}).Replace(" ","") #>", DefaultText = <#= TextCode #>,LocalDefaultText = <#= LocalTextCode #>, ObjectTableId = <#= TblName.Trim('"') #>ObjectTable.Id, Tenant = 0, TextCodeTypeCode = "Q", }, TextCodeRepository, textCodes);
			   Feature <#= TblName.Trim('"') #>Feature_<#= index #> = AddRolesAndFeaturesClass.AddFeature(new FeatureDetails() { Code = "<#= TblName.Trim('"') #>.Q.<#= Code.Trim(new char[]{' ','"'}).Replace(" ","") #>", ObjectTableId = <#= TblName.Trim('"') #>ObjectTable.Id, Tenant = 0, NameTextCodeCode = "<#= TblName.Trim('"') #>.Features.<#= Code.Trim(new char[]{' ','"'}).Replace(" ","") #>", NameTextCodeDefaultText = <#= Code #>, FeatureTypeCode = "QUER", Packagable = <#= Packagable #> }, FeaturesRepository, TextCodeRepository, TenantFeatures, textCodes);
<#+
}
