		public void CreateAllClosedTables()
        {
   <#+
   foreach (string file in Directory.EnumerateFiles(sourceFilePath, "*.lxml"))
    {
	 
	 var path= Host.ResolvePath(file);
     XElement entity = XDocument.Load(path).Root; 
	 string tableName = entity.Attribute(XName.Get("ObjectTableName")).Value.ToString().Trim('"');
	 string dBTableName = entity.Attribute(XName.Get("DBTableName")).Value.ToString();
	if(tableName.Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
          
    }
	string classname = tableName + "UpdateClass";
	 
	 
		 #><#=""#>
	   <#+
	var CloseTableCode = entity.Attribute(XName.Get("CloseTableCode"));
	var CloseTableName = entity.Attribute(XName.Get("CloseTableName"));
	 string originalTableName = entity.Attribute(XName.Get("ObjectTableName")).Value.ToString().Trim('"');
	string IsCLosed = entity.Attribute(XName.Get("IsClosed")).Value.Trim('"'); 
    if (IsCLosed == "true" && CloseTableCode != null && CloseTableName != null && !originalTableName.Contains("Customs."))
    {
    #>
	   <#=classname #>.Fill<#= tableName.Trim('"') #>();
	<#+
    }
    }
	#>

        }

   <#+

