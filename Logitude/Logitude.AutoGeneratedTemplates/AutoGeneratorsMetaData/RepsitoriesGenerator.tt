<#+
 private void WriteRepositoryMethod(dynamic entity,dynamic contextName)
{
    string tableName = entity.ObjectTableName.Trim('"');
	string dBTableName = entity.DBTableName.Trim('"');
	if(tableName.ToString().Trim('"').Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
          
    }

	 
	string pocosspacestring = repnamespacestring.ToString().Substring(0,repnamespacestring.ToString().LastIndexOf('.')) + ".EntityPOCOs;";
	string keysspacestring = repnamespacestring.ToString().Substring(0,repnamespacestring.ToString().LastIndexOf('.')) + ".EntityKeys;";
	string contextspacestring =   repnamespacestring.ToString().Substring(0,repnamespacestring.ToString().LastIndexOf('.')) + ".Context;";
 
   #>
 
using System;
using System.Collections.Generic;
using System.ComponentModel.DataAnnotations.Schema;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.ComponentModel.DataAnnotations;
using <#= pocosspacestring #>
using <#= keysspacestring #>
using Simplog.Server.Infrastructure;

namespace <#= repnamespacestring #>
{
   public partial class <#=tableName #>Repository:IRepository<<#=tableName #>>
   {
   
        private I<#= contextName #> currentContext;
        public <#=tableName #>Repository(int tenant)
        {
            currentContext = <#= contextName #>.GetContext(tenant);
        }

        public <#=tableName #>Repository(I<#= contextName #> context)
        {
            currentContext = context;
        }

		 <#+
		 dynamic identity ="";
	     Dictionary<string,string> primaryKeys = new Dictionary<string,string>();
		 foreach(var field in entity["field"])
		 {
		  if( field.IsPrimaryKey.GetType() == typeof(string))
			{
				if(field.IsPrimaryKey == "true")
				{ 
					 primaryKeys.Add(field.FieldName.Trim('"'),GetDataType(field));
				}
			}
		 }

		 bool hasTenant  = false;
		 foreach(var field in entity["field"])
		 {
		  if( field.FieldName.ToString().Trim('"') == "Tenant")
			{
				 hasTenant = true;
				 break;
			}
		 }
		
		 #>

		<#+
		 string tenantParam ="";
		 string tenantCondition = "";
		 string tenantKeyCondition = "";
		 string getalltenantCondition = "";
		 if(hasTenant)
         {
			 tenantParam = ", int tenant";
			 tenantCondition = "&& a.Tenant == tenant";
			 getalltenantCondition = "\n                   where a.Tenant == tenant";

		     tenantKeyCondition = "&& a.Tenant == keys.Tenant";
         }

		 string primarykeyParam="";
		 string primarykeyCondition = "";
		 string keyprimarykeyCondition = "";
		 foreach(string key in primaryKeys.Keys)
         {
			 primarykeyParam += primaryKeys[key]+ " " + key.ToLower() + ", ";
			 primarykeyCondition += " a." + key +" == "  + key.ToLower() +" &&";
			 keyprimarykeyCondition += " a." + key +" == keys."  + key +" &&";
         }
		 
		 primarykeyParam = primarykeyParam.TrimEnd(' ').TrimEnd(',');
		 primarykeyCondition = primarykeyCondition.TrimEnd('&').TrimEnd('&').Trim(' ');
		 keyprimarykeyCondition = keyprimarykeyCondition.TrimEnd('&').TrimEnd('&').Trim(' ');
		 
		#>

		public  <#=tableName #> GetSingle(<#= primarykeyParam #><#= tenantParam #>)
        {
            return (from a in context.<#=dBTableName #>
                    where <#= primarykeyCondition #> <#= tenantCondition #>
                    select a).FirstOrDefault();
        }

        public IQueryable<<#=tableName #>> GetAll(<#= tenantParam.Trim(',').Trim(' ') #>)
        {
            return from a in context.<#=dBTableName #>  <#=getalltenantCondition#>
                   select a;
        }
		<#+
		 
		 #>
		 
        public <#=tableName #> GetSingle(EntityKeyFields entityKeys)
        {
            <#=tableName #>Keys keys = entityKeys as <#=tableName #>Keys;
            return (from a in context.<#=dBTableName #>
                    where <#= keyprimarykeyCondition #>
                    select a).FirstOrDefault();
        }
		 <#+
		 
		#>
        
        partial void onAdd();//Partial Methods Definition in Generated
        public void Add(<#=tableName #> entity)
        {
            onAdd();
            context.<#=dBTableName #>.Add(entity);
        }

        public void Remove(<#=tableName #> entity)
        {
            context.<#=dBTableName #>.Attach(entity);
            context.<#=dBTableName #>.Remove(entity);
        }

        partial void onUpdate();//Partial Methods Definition in Generated
        public void Update(<#=tableName #> entity)
        {
            onUpdate();
            context.<#=dBTableName #>.Attach(entity);
            context.SetAsModified(entity);
        }

        public List<<#=tableName #>> All()
        {
            return context.<#=dBTableName #>.ToList();
        }

        private I<#= contextName #> context
        {
            get { return currentContext; }
        }

        public void SubmitChanges()
        {
            context.SaveChanges();
        }
	 
   }
   }
	 <#+
   }

#>


