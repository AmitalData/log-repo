<#+

dynamic repnamespacestring;
public void GenerateAllRepositories(string sourceFolder,string destinationFolder,string contextName)
{
 
 repnamespacestring = GetRepNameSpace(destinationFolder);
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string outputFilePath = Path.Combine(templateDirectory, sourceFolder);
foreach (string file in Directory.EnumerateFiles(outputFilePath, "*.lxml"))
{

    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	GenerateRepository(file,destinationFolder+"/Generated/"+fileNameWithoutExtension+"Repository.Generated.cs",contextName,false);
}


foreach (string file in Directory.EnumerateFiles(outputFilePath, "*.lxml"))
{

    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	GenerateRepository(file,destinationFolder+"/"+fileNameWithoutExtension+"Repository.cs",contextName,true);
}

 
}
#>

<#+  

public void GenerateRepository(string xmlFilePath,string outputFilePath,string contextName,bool isCustom)
{
	if(string.IsNullOrEmpty(repnamespacestring))
    {
		repnamespacestring = GetRepNameSpace(outputFilePath);
    }

var entity = FromRepositoryFile(xmlFilePath);
 if( entity.NoObjectTable.GetType() == typeof(string))
	{
		if(entity.NoObjectTable == "true")
		{
			return;
		}
	}
         if( entity.IsMetadataOnlyTable.GetType() == typeof(string))
      	{
	    	if(entity.IsMetadataOnlyTable == "true")
	    	{
	    		return;
	    	}
	    } 

 if(isCustom)
    {
		 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
         string filepath = Path.Combine(templateDirectory, outputFilePath);
	     bool generate = true;
		 generate = !File.Exists(filepath);
       
		if(generate)
         {
		    WriteCustomRepositoryMethod(entity,contextName);
			SaveRepositoryOutput(outputFilePath);
         }
	}
	else
    {
      WriteRepositoryMethod(entity,contextName);
	  SaveRepositoryOutput(outputFilePath);

    }
    

 }
#>

<#+

public dynamic GetRepNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }

	spacestring = spacestring.ToString().Trim('.');

	return spacestring;
}

#>

<#+
void SaveRepositoryOutput(string outputFileName)
  {
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
    
	   var manager = Manager.Create(Host, GenerationEnvironment);
	  manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString());
	  this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
  }
#>


<#+ 

private void WriteCustomRepositoryMethod(dynamic entity,dynamic contextName)
{
	 string tableName = entity.ObjectTableName.Trim('"');
	string dBTableName = entity.DBTableName.Trim('"');
	if(tableName.ToString().Trim('"').Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
          
    }

	 
	string pocosspacestring = repnamespacestring.ToString().Substring(0,repnamespacestring.ToString().LastIndexOf('.')) + ".EntityPOCOs;";
	string keysspacestring = repnamespacestring.ToString().Substring(0,repnamespacestring.ToString().LastIndexOf('.')) + ".EntityKeys;";
	string contextspacestring =   repnamespacestring.ToString().Substring(0,repnamespacestring.ToString().LastIndexOf('.')) + ".Context;";

	 #>
 
