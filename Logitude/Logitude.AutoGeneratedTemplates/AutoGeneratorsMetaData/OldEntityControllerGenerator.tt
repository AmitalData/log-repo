<#+  

public void GenerateEntityController(string xmlFilePath,string outputFilePath,string contextName,string modelname)
{
	if(string.IsNullOrEmpty(domainservicenamespacestring))
    {
		domainservicenamespacestring = GetControllerNameSpace(outputFilePath);
    }

        var entity = FromEntityControllerFile(xmlFilePath);
	 
        if( entity.IsComposition.GetType() == typeof(string))
      	{
	    	if(entity.IsComposition == "true")
	    	{
	    		return;
	    	}
	    } 
	    if( entity.NoPMController.GetType() == typeof(string))
      	{
	    	if(entity.NoPMController == "true")
	    	{
	    		return;
	    	}
	    } 

		if( entity.IsClosed.GetType() == typeof(string))
      	{
	    	if(entity.IsClosed == "true")
	    	{
	    		return;
	    	}
	    } 

       // if( entity.GenerateDomainService.GetType() == typeof(string))
      	//{
	   // 	if(entity.GenerateDomainService == "false" || entity.GenerateDomainService == null)
	   // 	{
	   // 		return;
	   // 	}
	   // } 
		//else
      //  {
	  //    return;      
       // }
          WriteEntityControllerMethod(entity,modelname,contextName); 
          SaveEntityControllerOutput(outputFilePath);
        

 }

public void GenerateEntityViewController(string xmlFilePath,string outputFilePath,string contextName,string modelname)
{
	if(string.IsNullOrEmpty(domainservicenamespacestring))
    {
		domainservicenamespacestring = GetControllerNameSpace(outputFilePath);
    }

        var entity = FromEntityControllerFile(xmlFilePath);
	  if( entity.IsComposition.GetType() == typeof(string))
      	{
	    	if(entity.IsComposition == "true")
	    	{
	    		return;
	    	}
	    } 

		 if( entity.NoViewController.GetType() == typeof(string))
      	{
	    	if(entity.NoViewController == "true")
	    	{
	    		return;
	    	}
	    } 


		
        //if( entity.GenerateDomainService.GetType() == typeof(string))
      	//{
	    	//if(entity.GenerateDomainService == "false" || entity.GenerateDomainService == null)
	    	//{
	    	//	return;
	    	//}
	   // } 
		//else
       // {
	   //   return;      
       // }
          WriteEntityViewControllerMethod(entity,modelname,contextName); 
          SaveEntityControllerOutput(outputFilePath);
        

 }

