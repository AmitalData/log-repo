<#+

public dynamic GetControllerNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }

	spacestring = spacestring.ToString().Replace("JustWebFreight.","").Trim('.');

	return spacestring;
}

#>

<#+
void SaveEntityControllerOutput(string outputFileName)
  {
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
     
	    var manager = Manager.Create(Host, GenerationEnvironment);
	  manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString());
	  this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
  }
#>



<#+
 private void WriteEntityControllerMethod(dynamic entity,string modelname,dynamic contextName)
{
	string controllerNameSpace = "WebFreight.Web.Controllers." + modelname + ".Generated.PMControllers";
    string tableName = entity.ObjectTableName.Trim('"');
	string dBTableName = entity.DBTableName.Trim('"');
	if(tableName.ToString().Trim('"').Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
          
    }

	string parententity = "object";
	string parentKeys = tableName + "Keys";
	if(entity.ParentTableName.GetType() == typeof(string))
    {
		parententity = entity.ParentTableName +"PM";
		parentKeys =entity.ParentTableName + "Keys";
    }

    string listName = tableName + "List";
    string pmName = tableName + "PM";
	string keysName = tableName+"Keys";

	string dataspacestring ="Simplog.Data."+ modelname+";";
	string pocosspacestring = "Simplog.Data." + modelname + ".EntityPOCOs;";

	string pmsspacestring =  "Logitude.BL." + modelname + ".EntityPMs;";
	string listspacestring  = "Logitude.BL." + modelname + ".EntityLists;";
	string blspacestring =  "Logitude.BL."+ modelname+";";
	string queryeservicespacestring ="Logitude.BL." + modelname + ".EntityQueries;"; 
	string servicenamespacestring = "Logitude.BL."+ modelname+".Tools.EntityService;";
	
 
	if(modelname == "GlobalModel")
    {
		pocosspacestring = "Simplog.Global.Data." + modelname + ".EntityPOCOs;";
		dataspacestring ="Simplog.Global.Data."+ modelname+";";
    }

	string context = FirstServiceCharacterToLower(contextName);
	string queryName = FirstServiceCharacterToLower(tableName)+"Query";

	 string sortbycolumnname="";
	 if(entity.SortingByObjectField.GetType() == typeof(string))
	 {
		 sortbycolumnname = entity.SortingByObjectField.Trim('"');
     }
	   
	 if(entity.LookUp1.GetType() == typeof(string))
	 {
		 sortbycolumnname = entity.LookUp1.Trim('"');
     }
	 if(string.IsNullOrEmpty(sortbycolumnname) &&  entity["field"].Count >= 1)
     {
		 sortbycolumnname = entity["field"][0].FieldName.Trim('"');
     }
	    
	 bool isClosed = false;
	if( entity.IsClosed.GetType() == typeof(string))
	{
	    isClosed = (entity.IsClosed == "true");
				 
    }

	
	 bool isCachedOnClient = false;
	if( entity.CacheOnClient.GetType() == typeof(string))
	{
	    isCachedOnClient = (entity.CacheOnClient == "true");
				 
    }

	 bool enableSecurity = false;
	if( entity.EnableSecurity.GetType() == typeof(string))
	{
	    enableSecurity = (entity.EnableSecurity == "true");
				 
    }

	

	  Dictionary<string,string> primaryKeys = new Dictionary<string,string>();
	  string keysstring = "";
	 
	  bool hasTenant = false;
	bool hasComposition = false;
		 foreach(var field in entity["field"])
		 {
		  if( field.IsPrimaryKey.GetType() == typeof(string))
			{
				if(field.IsPrimaryKey == "true")
				{ 
					 primaryKeys.Add(field.FieldName.Trim('"'),GetDotNetDataType(field));

				}
			}

			if( field.FieldName.ToString().Trim('"') == "Tenant")
			{
				 hasTenant = true;
			 
			}


			 if( field.IsComposition.GetType() == typeof(string))
			{
				if(field.IsComposition == "true")
				{ 
					 
					hasComposition = true;
				}
			}
		 }

		
		 string tenantParam ="";
		 string tenantonlyParam = "";
		 string tenantCondition = "";
		 string tenantKeyCondition = "";
		 string getalltenantCondition = "";
		 if(hasTenant)
         {
			 tenantParam = ", int tenant";
			 tenantonlyParam = ", authToken.Tenant";//", tenant";
			 tenantCondition = "&& a.Tenant == tenant";
			 getalltenantCondition = "\n                   where a.Tenant == tenant";

		     tenantKeyCondition = "&& a.Tenant == keys.Tenant";
         }

		 string tenantStringParam = "entityPM.Tenant";
		 if(tableName == "Tenant" || tableName == "TenantManagement" || tableName == "AccountingSetting")
			 tenantStringParam = "entityPM.Id";

		 string primarykeyParam="";
		 string primaryonlyparam = "";
		 string primarykeyCondition = "";
		// string keyprimarykeyCondition = "";
		 foreach(string key in primaryKeys.Keys)
         {
			 primarykeyParam += primaryKeys[key]+ " " + key.ToLower() + ", ";
			 primaryonlyparam += key.ToLower() + ", ";
			 primarykeyCondition += " a." + key +" == "  + key.ToLower() +" &&";
			  
			// keyprimarykeyCondition += " a." + key +" == a."  + key +" &&";
         }
		 string firstKey = null;
		 if(primaryKeys.Keys.Contains("Id"))
			 firstKey = "Id";
			 else
			 firstKey =  primaryKeys.Keys.FirstOrDefault();
		 
		 primarykeyParam = primarykeyParam.TrimEnd(' ').TrimEnd(',');
		 primaryonlyparam = primaryonlyparam.TrimEnd(' ').TrimEnd(',');
		 primarykeyCondition = primarykeyCondition.TrimEnd('&').TrimEnd('&').Trim(' ');
		// keyprimarykeyCondition = keyprimarykeyCondition.TrimEnd('&').TrimEnd('&').Trim(' ');
		  
	 string databaseConnTenant = "";
     string contextTenantParam = "";
	if(modelname!= "GlobalModel")
    {
		databaseConnTenant = "authToken.Tenant";
		contextTenantParam = "entityPM.Tenant";

		 if(tableName == "Tenant" || tableName == "TenantManagement" || tableName == "AccountingSetting")
			 contextTenantParam = "entityPM.Id";

            if(tableName == "Distributor")
                contextTenantParam = tenantStringParam= "authToken.Tenant";
    }

 
     
