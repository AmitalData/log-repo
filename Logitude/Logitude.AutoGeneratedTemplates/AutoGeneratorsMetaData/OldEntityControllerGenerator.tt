<#+

dynamic domainservicenamespacestring;
bool UpdateClassesRegisterarNameSpace;
bool UseUpdateClassesNameSpace;
string SrcFolder;
public void GenerateAllControllers(string sourceFolder,string destinationFolder,string contextName,string modelname)
{
 SrcFolder = sourceFolder;
 domainservicenamespacestring = GetControllerNameSpace(destinationFolder);
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string outputFilePath = Path.Combine(templateDirectory, sourceFolder);
foreach (string file in Directory.EnumerateFiles(outputFilePath, "*.lxml"))
{

    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	GenerateEntityController(file,destinationFolder+"/"+modelname +"/Generated/PMControllers/"+fileNameWithoutExtension+"Controller.Generated.cs",contextName,modelname);

	GenerateEntityViewController(file,destinationFolder+"/"+modelname +"/Generated/ListControllers/"+fileNameWithoutExtension+"ViewsController.Generated.cs",contextName,modelname);
	
}

}
