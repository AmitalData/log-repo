 private void WriteEntityViewControllerMethod(dynamic entity,string modelname,dynamic contextName)
{
	
	string controllerNameSpace = "WebFreight.Web.Controllers." + modelname + ".Generated.ListControllers";
     string tableName = entity.ObjectTableName.Trim('"');
