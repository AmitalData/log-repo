 private void WriteDetailsClassMethod(XElement entity)
{
    bool HasCode = false;
	//POCOFields = new List<XElement>();
	//PMFields = new List<XElement>();
	    // foreach(var field in entity.Elements("field"))  
		// { 
		//	  if(field.Attribute(XName.Get("HasDataBaseField")) != null)
          //    {
			//	  if(field.Attribute(XName.Get("HasDataBaseField")).Value.ToLower() == "true")
              //    {
				//	  POCOFields.Add(field);
                  //} 
              //}
         //}

		//foreach(var field in entity.Elements("field"))  
		// { 
		//	 if(field.Attribute(XName.Get("HasPMField")) != null)
        //      {
		//		  if(field.Attribute(XName.Get("HasPMField")).Value.ToLower() == "true")
        //          {
		//			  PMFields.Add(field);
        //          } 
        //      } 
        // }

		string IsMetadataOnlyTable = (entity.Attribute(XName.Get("IsMetadataOnlyTable")) != null?entity.Attribute(XName.Get("IsMetadataOnlyTable")).Value.Trim('"'):"false");
   
      	 
	    	if(IsMetadataOnlyTable == "true")
	    	{
	    		return;
	    	}
		
		foreach(var field in entity.Elements("field"))  
		 { 
		 if(field.Attribute(XName.Get("FieldName")) != null)
              {
				 if(field.Attribute(XName.Get("FieldName")).Value.ToLower() == "\"code\"")
                 {
				     HasCode = true;
                 } 
              }  
         }
	string tableName = entity.Attribute(XName.Get("ObjectTableName")).Value.Trim('"');
	string dBTableName = entity.Attribute(XName.Get("DBTableName")).Value.Trim('"');
	string schema ="";
	 
	if(tableName.ToString().Trim('"').Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
        
    }
	string pmName = tableName+ "PM";
	 string pocosspacestring = detailsnamespacestring.ToString().Substring(0,detailsnamespacestring.ToString().LastIndexOf('.')) + ".EntityPOCOs;";
	 
	  string entityPMsPath=detailsnamespacestring.ToString().Substring(0,detailsnamespacestring.ToString().LastIndexOf('.')) + ".EntityPMs;";
	if(pocosspacestring.Contains("Accounting"))
	{
	   entityPMsPath="Logitude.Accounting.Def.EntityPMs;";
	}

		
	if(pocosspacestring.Contains("Customs"))
	{
	   entityPMsPath="Logitude.Customs.Def.EntityPMs;";
	}

	string pmsspacestring =   entityPMsPath;
	 string dataprojectnamespace = "Simplog.Data." + modelFolderName + ";";//detailsnamespacestring.ToString().Substring(0,detailsnamespacestring.ToString().LastIndexOf('.')).Replace("BL","Data;");
	 
	 pocosspacestring = "Simplog.Data." + modelFolderName + ".EntityPOCOs;";//pocosspacestring.Replace("BL","Data");

	 if(modelFolderName == "GlobalModel"){
			pocosspacestring = "Simplog.Global.Data.GlobalModel.EntityPOCOs;";
			dataprojectnamespace =  "Simplog.Global.Data.GlobalModel;";
	 }
   #>


using System;
using System.Collections.Generic;
using System.ComponentModel.DataAnnotations.Schema;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.ComponentModel.DataAnnotations;
using Logitude.Server.Tools;  
using Simplog.Server.Infrastructure;
using Logitude.Server.Tools.CloseTablesClasses;
using <#= pocosspacestring #>
using <#= pmsspacestring #> 
using <#= dataprojectnamespace #>

namespace <#= detailsnamespacestring.Replace(".CloseTable","").TrimEnd('s') #>
{
   public class <#=tableName #>Details : <#=tableName #>, ICloseTable<<#=tableName #>, <#=tableName #>Details>
   {
       public List<<#=tableName #>Details> GetAll()
       {
		    var all = new List<<#=tableName #>Details>(); <#+
	    
        foreach(var Records in entity.Elements("Records")) 
		{ 
           foreach(var Record in Records.Elements("Record")) 
		   { 
			   #> 
            all.Add(new <#=tableName #>Details()
            {    <#+
			   foreach (var Att in Record.Attributes())
		       {  
			   #>

                <#= Att.Name #> = <#= Att.Value #>, <#+
               }
			   #>

			});
			<#+
               }
        }
		#>

            return all;
       }

	    public void MapPoco(<#=tableName #> newPoco)
        {   <#+
		       var OuterRecord = entity.Elements("Records").FirstOrDefault();
               if (OuterRecord != null)
               {
		          var Record = OuterRecord.Elements("Record").FirstOrDefault();
                   if (Record != null)
                   {
		               foreach (var Att in Record.Attributes())
		               {
 
                    if (Att.Name != "SearchFields")
                    {
		        #>

		    newPoco.<#= Att.Name #> = this.<#= Att.Name #>; <#+
                    }
                    else
                    {
     	        #>

			newPoco.<#= Att.Name #> = GetSearchFields(this);  <#+
                    }
				#> <#+
                       }
                   }
               }
		       
			    
			   #> 
        }

		public string GetSearchFields(<#=tableName #> rec)
        {   <#+
			  string Temp = "return string.Empty;";
		       OuterRecord = entity.Elements("Records").FirstOrDefault();
               if (OuterRecord != null)
               {
		          var Record = OuterRecord.Elements("Record").FirstOrDefault();
                   if (Record != null)
                   {
					   Temp = "return String.Concat(";
		               foreach (var Att in Record.Attributes())
		               {
                           if (Att.Name != "SearchFields")
                           {
		                       Temp += "rec." + Att.Name + "," + "\",\"" + ",";
                           } 
                       }
					   Temp = Temp.TrimEnd(',');
					   Temp += ");";
					   
                   }
               }
          #>

           <#=Temp #>
        }<#+ 
		if(HasCode == false){
		#>

		public string Code
        {
            get
            {
                return this.Id;
            }
            set
            {
                this.Id = value;
            }
        }<#+
		}
		#>

   }
}

<#+
}
