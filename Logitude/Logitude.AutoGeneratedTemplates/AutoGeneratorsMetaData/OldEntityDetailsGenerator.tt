using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
 
namespace <#= detailsnamespacestring.Replace(".CLoseTable","") #>
{
    public struct <#=tableName #>Values
    {   <#+
	    
        foreach(var Records in entity.Elements("Records")) 
		{	List<string> AddedNames = new List<string>();
           foreach(var Record in Records.Elements("Record")) 
		   { 
			   string CTName = "";
		       string CTCode = "";
			   foreach (var Att in Record.Attributes())
		       {   
                   if (Att.Name == CloseTableName)
                   {
		              CTName = Att.Value;
                   }
				   else if (Att.Name == CloseTableCode)
                   {
		              CTCode = Att.Value;
                   } 
               }
			   if (!string.IsNullOrEmpty(CTName) && !string.IsNullOrEmpty(CTCode))
                   { 
				   string GCTName = CTName.Replace(" ","").Trim('"').Replace(",","").Replace("'","").Replace("-","").Replace("(","").Replace(")","").Replace("/","").Replace("’","").Replace("“","").Replace("”","").Replace("—","").Replace(".","");
				   GCTName  = GCTName.TrimStart('3');
				   // string GCTName =  Regex.Replace(CTName, @"[^a-zA-Z_]+", "",
                            //   RegexOptions.None, TimeSpan.FromSeconds(1.5));
				   if(AddedNames.Contains(GCTName))
				   {
						GCTName = GCTName + AddedNames.Where(f=>f == GCTName).Count();
						
				   }
				   else
					AddedNames.Add(GCTName);
			   #>

       public const string <#=GCTName #> = <#= CTCode #>;  <#+
					   
                   }
			    CTName = "";
				   CTCode = "";
           }
        }
				#>

    }
}

<#+
}
