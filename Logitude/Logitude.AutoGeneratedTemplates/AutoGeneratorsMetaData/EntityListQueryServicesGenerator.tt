	 {
		 if(entity.SortingByDirection.Trim('"') == "Descending")
		 {
			 sortbydirection = "OrderByDescending";
		 }
     }

	

	  string sortbyDriection="";
	 if(entity.SortingByDirection.GetType() == typeof(string))
	 {
		 sortbyDriection = entity.SortingByDirection.Trim('"');
     }

	 if(string.IsNullOrEmpty(sortbycolumnname))
     {
		 sortbycolumnname = entity["field"][0].FieldName.Trim('"');
     }


	  Dictionary<string,string> primaryKeys = new Dictionary<string,string>();
	  string keysstring = "";
	   
	  bool hasTenant = false;
		 foreach(var field in entity["field"])
		 {
		  if( field.IsPrimaryKey.GetType() == typeof(string))
			{
				if(field.IsPrimaryKey == "true")
				{ 
					 primaryKeys.Add(field.FieldName.Trim('"'),GetDataType(field));

					//keysstring += field.FieldName.Trim('"') + " = "+field.FieldName.Trim('"').ToLower() + ", ";
					//primarykeyParam += GetDataType(field)+ " " + field.FieldName.Trim('"').ToLower() + ", ";
					 
				}
			}

			if( field.FieldName.ToString().Trim('"') == "Tenant")
			{
				 hasTenant = true;
			 
			}
		 }


		 string tenantParamValue="";
		 string tenantParam ="";
		 string tenantCondition = "";
		 string tenantKeyCondition = "";
		 string getalltenantCondition = "";
		 if(hasTenant)
         {
			 tenantParam = ", int tenant";
			 tenantCondition = "&& a.Tenant == tenant";
			 getalltenantCondition = "\n                   where a.Tenant == tenant";

		     tenantKeyCondition = "&& a.Tenant == keys.Tenant";
			 tenantParamValue=",tenant";
         }

		 string primarykeyParam="";
		 string primarykeyCondition = "";
		// string keyprimarykeyCondition = "";
		 foreach(string key in primaryKeys.Keys)
         {
			 primarykeyParam += primaryKeys[key]+ " " + key.ToLower() + ", ";
			 primarykeyCondition += " a." + key +" == "  + key.ToLower() +" &&";
