namespace <#= querylistservicenamespacestring #>
{ 

    public partial class <#= listName #>QueryService
    {
	    private IQueryable<<#= listName #>> GetIqueryableList(IQueryable<<#= tableName #>> iQueryable)
        {
		IQueryable<<#= listName #>> query = (from a in iQueryable
                                            select new <#= listName #>()
											{
                     <#+                                 
		foreach(var field in entity["field"])
		 {
			  bool generateInList = false;
                if( field.GenerateInList.GetType() == typeof(string))
           {
             generateInList = (field.GenerateInList == "true");
                 
                 }

		  /*if( field.DisplayInList.GetType() == typeof(string))
           {
             if(field.DisplayInList == "false" && generateInList == false)
               {
                  
               }
           }*/

		if( field.HasDataBaseField.GetType() == typeof(string))
			{
				if(field.HasDataBaseField == "true" && generateInList == true)
				{ 
					if( field.FieldName.GetType() == typeof(string))
		         	{ 
					#>

					                          <#= field.FieldName.Trim('"')  #> = a.<#= field.FieldName.Trim('"')  #>,
					<#+
                    }
				}
			}
		 }#>

		                    	            });
            return query;
		}

		private IQueryable<<#= tableName #>> ApplyCustomFilters(QueryOperations queryOperations,IQueryable<<#= tableName #>> iQueryable<#=tenantParam#>)
        {
			throw new NotImplementedException();
		}
		<#+
	if(!iscustoms)
    {
	 #>
		private IQueryable<<#= tableName #>> ApplyBusinessUnitFilters(QueryOperations queryOperations,IQueryable<<#= tableName #>> iQueryable<#=tenantParam#>)
        {
			return iQueryable;
		}
		
		<#+
	}#>
	}


}
	<#+
}

