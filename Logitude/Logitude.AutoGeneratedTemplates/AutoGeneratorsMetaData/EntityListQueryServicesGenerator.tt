                List<ObjectField> <#= tableName #>ObjectFields = ObjectFieldRepository.GetObjectFieldsByObjectTableName("<#= entity.ObjectTableName.Trim('"') #>",tenant).ToList();

                ObjectField objectField = (from a in <#= tableName #>ObjectFields
