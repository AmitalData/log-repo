<#+  

public void GenerateApiDataContract(string xmlFilePath,string outputFilePath,string contextName)
{
	
	MyaddedProperties = new	Dictionary<string,string>();
	if(string.IsNullOrEmpty(NSString))
    {
		NSString = GetApiDataContractNameSpace(outputFilePath);
    }
    XElement entity = ReadFromFile(xmlFilePath);
	var DataContracts = entity.Elements("DataContracts").FirstOrDefault();
	
	if (DataContracts != null)
    { 
	    foreach(XElement DC in DataContracts.Elements("DataContract")) 
		{  
		   //WriteAddFeaturesAndTextCodesMethod(entity,Query,ObjectTbl,i);
		   WriteApiDataContractMethod(DC);
		   var Name = ((XElement)DC).Attributes().Where(a => a.Name == "Name").FirstOrDefault(); 
	       string DCName =  Name != null ? Name.Value.Trim('"') : "";
		   SaveApiDataContractOutput(outputFilePath+DCName+".Generated.cs");
        }

		foreach(XElement DC in DataContracts.Elements("DataContract")) 
		{  
		   //WriteAddFeaturesAndTextCodesMethod(entity,Query,ObjectTbl,i);
		   
          
			   WriteApiDataContractQueryServiceMethod(DC,entity,contextName);
			   var Name = ((XElement)DC).Attributes().Where(a => a.Name == "Name").FirstOrDefault(); 
			   string DCName =  Name != null ? Name.Value.Trim('"') : "";
			   SaveApiDataContractOutput(outputFilePath+"/QueryService/"+DCName+"QueryService.Generated.cs");
		   
        }
 
        
		
	} 
}
 
 public dynamic GetApiDataContractNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }

	
	spacestring = spacestring.ToString().Trim('.');
 
	return spacestring;
}

private dynamic ReadFromFile(string file)
{
    var path= Host.ResolvePath(file);
   return XDocument.Load(path).Root;//.Root.ToElastic();
}

void SaveApiDataContractOutput(string outputFileName)
  { 
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
	

	   var manager = Manager.Create(Host, GenerationEnvironment);
	  manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString().Trim('\n'));
	  this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
  }
#>


