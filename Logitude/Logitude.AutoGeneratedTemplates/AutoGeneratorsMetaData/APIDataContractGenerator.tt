dynamic NSString;
dynamic myfileNameWithoutExtension;
Dictionary<string,string> MyaddedProperties = new	Dictionary<string,string>();
public void GenerateAllApiDataContracts(string sourceFolder,string destinationFolder,string contextName)
{
	 

 NSString = GetApiDataContractNameSpace(destinationFolder);
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string sourceFilePath = Path.Combine(templateDirectory, sourceFolder);

foreach (string file in Directory.EnumerateFiles(sourceFilePath, "*.lxml"))
{

    myfileNameWithoutExtension = Path.GetFileNameWithoutExtension(file); 
	GenerateApiDataContract(file,destinationFolder+"/",contextName);
}

 
}
