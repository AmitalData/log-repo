<#+

  private string GetmyDataType(dynamic field)
        {
			
			string typecode = ((XElement)field).Attributes().Where(a => a.Name == "FieldsDataType").FirstOrDefault().Value.Trim('"');
			string IsNullable = ((XElement)field).Attributes().Where(a => a.Name == "IsNullable").FirstOrDefault().Value;
			string IsCustomType = ((XElement)field).Attributes().Where(a => a.Name == "IsCustomType").FirstOrDefault().Value;
			
			string result = "string";
            if (typecode == "Boolean")
            {
                result = "bool";
            }
            if (typecode == "Integer" || typecode == "UnsInteger")
            {
                result = "int";
            }

            if (typecode == "Date" || typecode == "DateTime")
            {
                result = "DateTime";
            }

            if (typecode == "Double" || typecode == "SigDouble")
            {
                result = "double";
            }

			 if (typecode == "Decimal" || typecode == "UnsDecimal")
            {
                result = "decimal";
            }
			if(typecode == "List")
            {
				result = typecode;
            }

			if(typecode == "Byte[]")
            {
				result = "byte[]";
            }
			if(IsCustomType == "true")
            {
				result = typecode;
            }
            //string isNullable = field.IsNullable as string;
		  if(IsNullable == "true" && result != "string" && IsCustomType == "false")
		  {
			  result = result + "?";
          }
		  return result;

        }

		 private string GetmyCustomDataType(dynamic field)
        {
			
			string typecode = ((XElement)field).Attributes().Where(a => a.Name == "FieldsDataType").FirstOrDefault().Value.Trim('"');
			var temp = typecode.Split('<'); 
			return temp[0];
	

        }
#>
