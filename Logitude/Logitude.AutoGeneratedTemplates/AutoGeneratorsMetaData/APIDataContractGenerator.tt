private void WriteApiDataContractQueryServiceMethod(dynamic entity,dynamic Mainentity,string contextName)
{
   var Name = ((XElement)entity).Attributes().Where(a => a.Name == "Name").FirstOrDefault(); 
   var Version = ((XElement)entity).Attributes().Where(a => a.Name == "Version").FirstOrDefault();
   var IsClosed = ((XElement)Mainentity).Attributes().Where(a => a.Name == "IsClosed").FirstOrDefault().Value; 
   var CPName = ((XElement)entity).Attributes().Where(a => a.Name == "ComputingPartnerName").FirstOrDefault(); 
   var TableName = ((XElement)Mainentity).Attributes().Where(a => a.Name == "DBTableName").FirstOrDefault().Value;
    var ObjectTableName = ((XElement)Mainentity).Attributes().Where(a => a.Name == "ObjectTableName").FirstOrDefault().Value.Trim('"'); 
	string DCName =  Name != null ? Name.Value.Trim('"') : "";//entity.Name.Trim('"');
	if(DCName == "PickUp"){
	ObjectTableName = "ShipmentPickUp";
	}
	if(DCName == "Delivery"){
	ObjectTableName = "ShipmentDelivery";
	}
	string DCVersion =  Version != null ? Version.Value.Trim('"') : "";//entity.Name.Trim('"');
	string ComputingPartnerName =  CPName != null ? CPName.Value.Trim('"') : "";//entity.CPName.Trim('"');
	string pocosspacestring = NSString.Substring(0,NSString.LastIndexOf('.')) + ".EntityPOCOs;";
	string pmspacestring = NSString.Substring(0,NSString.LastIndexOf('.')) + ".EntityPMs;";
	string servicespacestring = NSString.Substring(0,NSString.LastIndexOf('.')) + ".Tools.EntityService;";
	string queriesspacestring = NSString.Substring(0,NSString.LastIndexOf('.')) + ".EntityQueries;"; 
	string myspacestring = "Simplog.Data." + NSString.Split('.')[2] + ";"; 
	string ContextName = contextName;//NSString.Split('.')[2].Replace("Model","") +(ObjectTableName == "Quote" ? "sContext":"Context"); 
	string ServiceName = ObjectTableName + "Service";
	string QueryName = ObjectTableName + "Query";
	string MapId = "false";
	 var IsComposition = ((XElement)Mainentity).Attributes().Where(a => a.Name == "IsComposition").FirstOrDefault().Value;
		   
