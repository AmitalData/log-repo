						 <#+if(IsUpdateAllowed == "false" || IsKey == "true"){#> 
						if(!IsUpdate)
						{<#+}#>
								//throw new ApplicationException("<#=DCFieldName#> Can't be update"); 
								temp.<#=FieldName#> = <#+if(IgnoreCustomTypeCheck == "true"){#><#=DCFieldName#><#+}else{#><#=type.Replace("List<","").Replace(">","")#><#+}#>Service<#=i#>.<#+if(IgnoreCustomTypeCheck == "true"){#><#=DCFieldName#><#+}else{#><#=type.Replace("List<","").Replace(">","")#><#+}#><#+if(IsManualMapping == "true"){#>Custom<#+}#>DataMappingAndValidatin(<#+if(IsManualMapping == "true"){if(IsComposition == "true"){#>item<#+}else{#>MyEntity<#+}#>,<#+}#><#+if(IsComposition == "true"){if(customType == "List"){#>item<#+}else{#><#=temp#><#+}}else{#>MyEntity<#+}#>.<#=DCFieldName#>,Tenant,ComputingPartnerName<#+if(IsManualMapping == "false"){#>,IsUpdate<#+}#>);

					<#+if(IsUpdateAllowed == "false" || IsKey == "true"){#> 
						} <#+}#> 

						
					}

								 <#+} else {#>
<#+if(type != "List<CustomField>"){#>

					<#=type#>QueryService <#=DCFieldName#><#=type#>Service = new <#=type#>QueryService(Tenant);
					if(<#+if(IsComposition == "true"){#>item<#+}else{#>MyEntity<#+}#>.<#=DCFieldName#> != null)
					{
						var my<#=DCFieldName#>PM = <#=DCFieldName#><#=type#>Service.<#=type#><#+if(IsManualMapping == "true"){#>Custom<#+}#>DataMappingAndValidatin(<#+if(IsManualMapping == "true" && IsMulti == "true"){if(IsComposition == "true"){#>item<#+}else{#>MyEntity<#+}#>,<#+}#><#+if(IsComposition == "true"){#>item<#+}else{#>MyEntity<#+}#>.<#=DCFieldName#>,Tenant<#+if(IsManualMapping == "false"){#>,ComputingPartnerName<#+}#><#+if(IsManualMapping == "false"){#>,IsUpdate<#+}#>);
						<#+
						if(type != "CustomField")
						{
						#>

						if(my<#=DCFieldName#>PM != null)
