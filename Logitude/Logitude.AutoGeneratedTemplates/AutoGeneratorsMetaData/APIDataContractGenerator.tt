 private void WriteApiDataContractMethod(dynamic entity)
{
    var Name = ((XElement)entity).Attributes().Where(a => a.Name == "Name").FirstOrDefault(); 
	string DCName =  Name != null ? Name.Value.Trim('"') : "";//entity.Name.Trim('"');
	 var Version = ((XElement)entity).Attributes().Where(a => a.Name == "Version").FirstOrDefault();
	 string DCVersion =  Version != null ? Version.Value.Trim('"') : "";//entity.Name.Trim('"');
	  
   #>

using System;
using System.Collections.Generic;
using System.ComponentModel.DataAnnotations.Schema;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
