public void WritemyProperty(dynamic field)
{
 var DCFieldName = ((XElement)field).Attributes().Where(a => a.Name == "DCFieldName").FirstOrDefault().Value.Trim('"'); 
dynamic fieldName = GetmyPropertyName(DCFieldName);
var temp = ((XElement)field).Attributes().Where(a => a.Name == "IsAttribute").FirstOrDefault();
var IsAttribute = "false";
if(temp != null){
IsAttribute = temp.Value;
} 
string type = GetmyDataType(field);
