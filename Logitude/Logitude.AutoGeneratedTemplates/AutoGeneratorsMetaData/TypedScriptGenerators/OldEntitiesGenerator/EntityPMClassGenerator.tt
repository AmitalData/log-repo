<#+
public void WritePMListProperty(CodeProperty property,CodeElement element )
{ 
	string propName = element.Name;
	string privatepropname = FirstCharacterToLower(propName);
	string publicpropname = propName;
	string multitablename = GetPmListPropertyTableName(property);
	bool isComposition = false;
	 if (property.Attributes.OfType<EnvDTE.CodeAttribute>().Any(a => a.Name == "Composition"))
        {
          isComposition = true;
        }

	if(multitablename.ToLower() == "string" || publicpropname.EndsWith("ChangeSet"))
    {
		  
		 #>

    public <#= publicpropname #>: Array<<#= multitablename #>>= [];
		 <#+
    }
	else{
	#>
     
	private <#= privatepropname #>: <#= multitablename #>[];
    get  <#= publicpropname #>() {
        if (this.<#= privatepropname #> == null) {
            this.<#= privatepropname #> = [];
        }

        return this.<#= privatepropname #>;
    }
    set  <#= publicpropname #>(newValue: <#= multitablename #>[]) {
        if (this.<#= privatepropname #> != newValue) {
            this.<#= privatepropname #> = newValue;
        }
    }
<#+ if(isComposition)
{
#>
    public Add<#= multitablename #>(item: <#= multitablename #>) {
        if (item != null) {
            var index = this.<#= publicpropname #>.indexOf(item);
            if (index == -1) {

                item.EntityParentPM = this;

                this. <#= publicpropname #>.push(item);
                this.MarkAsDirty();
            }
        }
    }
    public Remove<#= multitablename #>(item: <#= multitablename #>) {
        if (item != null) {
            var index = this.<#= publicpropname #>.indexOf(item);
            if (index > -1) {
                this. <#= publicpropname #>.splice(index, 1);
                this.MarkAsDirty();
            }
        }
    }
	<#+
}
#>
    //public <#= publicpropname #>: Array<<#= multitablename #>PM>= [];
 <#+ 
    }
}
