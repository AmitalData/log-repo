public void WritePMProperty(CodeProperty property,CodeElement element,string tableName)
{
	string propName = element.Name;
	string type = GetCodePropertyDataType(property); 
    string privatepropname = FirstCharacterToLower(propName);
	string publicpropname = FirstCharacterToUpper(propName);//propName;
if(type=="CustomFieldClass")
{
	#>
    private <#= privatepropname #>: <#= type #>;
    public get <#= publicpropname #>() {if(!this.<#= privatepropname #>){ this.<#= privatepropname #> = new <#= type #>(null, "<#= publicpropname #>", "<#=tableName #>");} return this.<#= privatepropname #>; }
    public set <#= publicpropname #>(newValue: <#= type #>) {  this.<#= privatepropname #> = newValue; this.MarkAsDirty("<#= publicpropname #>");  }
       
	 
<#+ 
}
else
{
	#>
    private <#= privatepropname #>: <#= type #>;
    public get <#= publicpropname #>() { return this.<#= privatepropname #>; }
    public set <#= publicpropname #>(newValue: <#= type #>) { if (this.<#= privatepropname #> != newValue) { this.<#= privatepropname #> = newValue; this.MarkAsDirty("<#= publicpropname #>"); } }
       
	 
<#+ 
}
  
 }
