<#+
private void PrintPMProperties(CodeElements elements, IList<CodeProperty> properties,string tableName)
{

 foreach (CodeElement element in elements)
  {
    CodeProperty property = element as CodeProperty;
    if (property != null)
    {
		
		PrintPMProperty(element,property,tableName);
		properties.Add(property);
    } 
    PrintPMProperties(element.Children, properties,tableName);
  }
}

private void PrintPMProperty(CodeElement element,CodeProperty property,string tableName)
{
	string[] propTypeArr = property.Type.AsString.Split('.');
	string propType = propTypeArr[propTypeArr.Length  - 1];
	string propName = element.Name;


	string type = GetCodePropertyDataType(property); 
    string privatepropname = FirstCharacterToLower(propName);
	string publicpropname = propName;
	 if (property.Attributes.OfType<EnvDTE.CodeAttribute>().Any(a => a.Name == "Key"))
        {
         
        }

		
		if(type == "List" )
        {
		   WritePMListProperty(property,element);
			
        }
		else
        {
	      WritePMProperty(property,element,tableName);
        }
	 
}

