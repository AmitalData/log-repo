<#+

public void GenerateAllPMTS(string xmlFilesSourceFolder,string classFilesSourceFolder,string destinationFolder)
{
	// System.Diagnostics.Debugger.Launch();
//Console.WriteLine(destinationFolder);
 

 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 


	//======================================== classes .cs

	//string pmsourceFolderPath = "../../../../Logitude.BL/CommonDataModel/EntityPMs";
	//string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
    string classSourceFilePath = Path.Combine(templateDirectory, classFilesSourceFolder);
	string classesDirectoryFinalPath = System.IO.Path.GetFullPath(classSourceFilePath);


    string xmlSourceFilePath = Path.Combine(templateDirectory, xmlFilesSourceFolder);
	string xmlDirectoryfinalPath = System.IO.Path.GetFullPath(xmlSourceFilePath);
	List<string> xmlFiles = new List<string>();
	foreach (string xmlfilePath in Directory.EnumerateFiles(xmlDirectoryfinalPath, "*.lxml"))
	{
		var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(xmlfilePath);
		xmlFiles.Add(fileNameWithoutExtension);
	}

foreach (string classfilePath in Directory.EnumerateFiles(classesDirectoryFinalPath, "*.cs"))
{

    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(classfilePath);
	//Console.WriteLine(fileNameWithoutExtension);

	string tableName = fileNameWithoutExtension.Substring(0,fileNameWithoutExtension.Length - 2);
	string xmlFilePath = xmlDirectoryfinalPath + @"\"  +tableName + ".lxml";
	//var entity = GetXmlDocumentFromFile(xmlFilePath);

	 var xpath= Host.ResolvePath(xmlFilePath);
	//List<string> xmlfiles = Directory.EnumerateFiles(xmlDirectoryfinalPath, "*.lxml");
	bool exists = xmlFiles.Contains(tableName);//File.Exists(xmlFilePath);//false;//Directory.EnumerateFiles(xmlDirectoryfinalPath);
	if(exists)
    {
		string entityClassFilePath = classesDirectoryFinalPath + @"\"  +fileNameWithoutExtension + ".cs";
		GeneratePM(entityClassFilePath,xmlFilePath,destinationFolder+"/"+fileNameWithoutExtension+".ts");
	}

}
}
