<#+  

public void GeneratePM(string classFilePath,string xmlFilePath,string outputFilePath)
{
	

    var entity = GetXmlDocumentFromFile(xmlFilePath);

	var properties = new List<CodeProperty>();
	var dte = (DTE)TransformationContext.Current.GetService(typeof(DTE));
    ProjectItem projectItem = dte.Solution.FindProjectItem(classFilePath);
	 var path = projectItem.Properties.Item("FullPath").Value;
	FileCodeModel codeModel = projectItem.FileCodeModel;
	CodeElements elements = codeModel.CodeElements;
	if(entity.NoTS.GetType() == typeof(string))
      	{
	    	if(entity.NoTS == "true")
	    	{
	    		return;
	    	}
	    } 
	 if( entity.IsClosed.GetType() == typeof(string))
      	{
	    	if(entity.IsClosed == "true")
	    	{
	    		return;
	    	}
	    } 

	//PrintPMProperties(elements,properties);
	WritePMMethod(entity,elements);
	SaveFileOutput(outputFilePath);
}



 
