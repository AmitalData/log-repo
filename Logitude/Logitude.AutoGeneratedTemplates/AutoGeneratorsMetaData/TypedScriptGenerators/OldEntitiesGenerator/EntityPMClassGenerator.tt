<#+

private string GetPmListPropertyTableName(CodeProperty property)
{
	string tablename = "";
	string fullTypeName = property.Type.AsString;
			string typecode = "";
			if(fullTypeName.Contains("System.Collections.Generic.List"))
            {
				typecode = "List";

				//string[] propTypeArr = property.Type.AsString.Split('.');
	            //fullTypeName = propTypeArr[propTypeArr.Length  - 1];
				//tablename = fullTypeName.Substring(fullTypeName.IndexOf("<"), (fullTypeName.IndexOf(">") - fullTypeName.IndexOf("<")));
     
 
				 
				string tableNameSpace = fullTypeName.Substring(fullTypeName.IndexOf("<") + 1, (fullTypeName.IndexOf(">") - fullTypeName.IndexOf("<") - 1));
				string[] nameArr = tableNameSpace.Split('.');
				 tablename = nameArr[nameArr.Length - 1];
            }


			return tablename;
}


 private string GetCodePropertyDataType(CodeProperty property)
        {
					//System.Collections.Generic.List<Logitude.BL.CommonDataModel.EntityPMs.AddressPM>
	            //System.DateTime?

			string fullTypeName = property.Type.AsString;
			string typecode = "";
			if(fullTypeName.Contains("System.Collections.Generic.List"))
            {
				typecode = "List";
            }
			else
            {
				string[] propTypeArr = property.Type.AsString.Split('.');
	            typecode = propTypeArr[propTypeArr.Length  - 1];
            }


		   if(fullTypeName.Contains("CustomFieldClass"))
            {
				return "CustomFieldClass";
            }

			typecode = typecode.Replace("?","").ToLower();
 
			string result = "string";
            if (typecode == "bool")
            {
                result = "boolean";
            }
            
        if (typecode == "string")
            {
                result = "string";
            }
            if (typecode == "int")
            {
                result = "number";
            }

            if (typecode == "date" || typecode == "datetime")
            {
                result = "Date";
            }

            if (typecode == "double" || typecode == "decimal")
            {
                result = "number";
            }

			 
			if(typecode == "list")
            {
				result = "List";
            }

			if(typecode == "Byte[]")
            {
				result = "any";
            }
            
        if(result == "string" && fullTypeName.Contains("Logitude.")){
            result = "any";
        }
			
			return result;
        }


#>





