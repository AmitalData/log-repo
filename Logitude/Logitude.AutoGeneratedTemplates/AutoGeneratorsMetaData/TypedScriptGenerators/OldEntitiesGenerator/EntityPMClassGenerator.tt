<#+
public string BuildImportEntitesString(dynamic entity,CodeElements elements)
{
	string entityPmName = entity.ObjectTableName.Trim('"') + "PM";
	string importentitystring = "";
	if(entity.ParentTableName.GetType() == typeof(string))
    {
		string parentname = entity.ParentTableName.ToString().Trim('"') + "PM";
		if( parentname != entityPmName)
        {
			
			importentitystring += Environment.NewLine + "import {"+parentname+"} from './" + parentname + "';";
        }
    }

	 
 
	 var properties = new List<CodeProperty>();
	 List<string> multiImpStrings =  new List<string>();
    BuildImportForMulti(elements,properties,multiImpStrings,entityPmName);
	foreach(var s in multiImpStrings)
    {
		if(!importentitystring.Contains(s))
        {
		  importentitystring += Environment.NewLine + s;
        }
    }
	//foreach(var field in entity["field"])  //get all classes
	// { 
		//  if( field.HasPMField.GetType() == typeof(string))
       //    {
         //    if(field.HasPMField == "false")
         //      {
         //         continue;
         //      }
         //  }
		//   string type = GetDataType(field);
		//   if(type == "List" || (field.IsMulti.GetType() == typeof(string) && field.IsMulti == "true"))
        //   {
		//	    string pmname = field.MultiTableName.ToString().Trim('"') + "PM";
		//		importentitystring += Environment.NewLine + "import {"+pmname+"} from './" + pmname + "';";

         //  }
		   
	 //}

	 return importentitystring;
}

private void BuildImportForMulti(CodeElements elements, IList<CodeProperty> properties, List<string> stringsList,string entityPmName)
{
  
 foreach (CodeElement element in elements)
  {
    CodeProperty property = element as CodeProperty;
    if (property != null)
    {
		
		BuildImportForListProperty(element,property,stringsList,entityPmName);
		properties.Add(property);
    } 
    BuildImportForMulti(element.Children, properties,stringsList,entityPmName);
  }


   

}

private void BuildImportForListProperty(CodeElement element,CodeProperty property,List<string> stringsList,string entityPmName)
{
	 
 
	string type = GetCodePropertyDataType(property); 
	if(type == "List" && entityPmName.ToLower() != "stringpm")
     {
		    string pmname =  GetPmListPropertyTableName(property);
	   	 string importentitystring = Environment.NewLine + "import {"+pmname+"} from './" + pmname + "';";

         string fullTypeName = property.Type.AsString;
         string tableNameSpace = fullTypeName.Substring(fullTypeName.IndexOf("<") + 1, (fullTypeName.IndexOf(">") - fullTypeName.IndexOf("<") - 1));
		 string[] nameArr = tableNameSpace.Split('.');
         string  modelName = nameArr.Length > 1 ? nameArr[1]:null;
            if(!string.IsNullOrEmpty(modelName) && modelName != "BL"){
                importentitystring = Environment.NewLine + "import {"+pmname+"} from './../../" +modelName +"/EntityPMs/" + pmname + "';";
            }

		 if(!stringsList.Contains(importentitystring) && pmname.ToLower() != "string" &&  pmname != entityPmName)
         {
		   stringsList.Add(importentitystring);
         }
	 ////import { LedgerTransactionPM } from './../../Accounting/EntityPMs/LedgerTransactionPM';
// System.Collections.Generic.List<Logitude.Accounting.Def.EntityPMs.LedgerTransactionPM>     
 //System.Collections.Generic.List<Logitude.BL.InvoiceModel.EntityPMs.APPaymentInvoicePM>      
	  }

	  
}

