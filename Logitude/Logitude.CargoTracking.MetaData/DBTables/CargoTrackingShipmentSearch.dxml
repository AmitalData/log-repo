<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CargoTrackingShipmentSearches"
  Schema="dbo"
  DBType="CargoTracking"
  Module="CargoTracking">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ShipmentId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ShipmentDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
</Table>