<Table Name="Users">

  <Column Name="Id" Type="Text" Size="15">
    <Constraints PrimaryKey="true" Nullable="false"/>
  </Column>

  <Column Name="Tenant" Type="Integer">
    <Constraints Nullable="false"/>
  </Column>

  <Column Name="FName" OldName="FirstName" Type="nText" Size="50">
    <Constraints Nullable="false"/>
  </Column>

  <Column Name="LastName" Type="nText" Size="50">
    <Constraints Nullable="false"/>
  </Column>

  <Column Name="Inactive" Type="Boolean">
    <Constraints Nullable="false"/>
  </Column>

  <Column Name="BirthDate" Type="DateTime">
    <Constraints Nullable="true"/>
  </Column>

</Table>