<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1"/>
  </startup>

  <appSettings>
    
    <!--SQL Server
    <add key="DatabseType" value="msql"/>
    <add key="GlobalConnectionString" value="Data Source=.;Initial Catalog=Logitude_Global;Integrated Security=true"/>
    <add key="MainConnectionString" value="Data Source=.;Initial Catalog=Logitude_Main;Integrated Security=true"/>
    <add key="SystemLogsConnectionString" value="Data Source=.;Initial Catalog=Logitude_SystemLogs;Integrated Security=true"/>
    -->

    <!--Oracle Server-->
    <add key="DatabseType" value="oracle"/>
    <add key="GlobalConnectionString" value="User Id=AMINETCST_GLOBAL;Password=AMINETCST_GLOBAL;Data Source=//localhost:1521/amital"/>
    <add key="MainConnectionString" value="User Id=AMINETCST_MAIN;Password=AMINETCST_MAIN;Data Source=//localhost:1521/amital"/>
    <add key="SystemLogsConnectionString" value="User Id=AMINETCST_LOGS;Password=AMINETCST_LOGS;Data Source=//localhost:1521/amital"/>
    
    
    <!--Test SQL Server
    <add key="DatabseType" value="msql"/>
    <add key="GlobalConnectionString" value="Data Source=.;Initial Catalog=Logitude2-5_Global;Integrated Security=true"/>
    <add key="MainConnectionString" value="Data Source=.;Initial Catalog=Logitude2-5_Main_ForTool;Integrated Security=true"/>
    <add key="SystemLogsConnectionString" value="Data Source=.;Initial Catalog=Logitude2-5_SystemLogs;Integrated Security=true"/>
    -->
  </appSettings>

</configuration>