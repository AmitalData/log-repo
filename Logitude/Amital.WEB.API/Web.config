  <!--
    For a description of web.config changes for .NET 4.5 see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>controlRenderingCompatibilityVersion 
        <httpRuntime targetFramework="4.5" />         
      </system.Web> 
  -->
  <system.web>
    <httpRuntime executionTimeout="140" requestValidationMode="2.0" maxRequestLength="26000" maxQueryStringLength="8000" />
    <customErrors mode="Off" />
    <authentication mode="Forms" />
    <!--<forms name=".ASPXFORMSDEMO" loginUrl="logon.aspx"
      protection="All" path="/" timeout="30" />
    </authentication>-->
    <!--<authorization>
      <deny users ="?" />
      <allow users = "*" />
    </authorization>-->
    <httpModules>
      <add name="LogitudeHttpModule" type="WebFreight.Web.Security.LogitudeHttpModule" />
      <!--<add name="TestHttpModule"  type="WebFreight.Web.TestHttpModule, WebFreight.Web"  />-->
      <add name="DomainServiceModule" type="System.ServiceModel.DomainServices.Hosting.DomainServiceHttpModule, System.ServiceModel.DomainServices.Hosting, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
      <!--The base class name and project name is TestSite
      The namespace my class is in is BusinessLogic   
      The class name is PageAuthorization   
      in the Web.config file...
 
      <configuration>
        <system.web>
          <httpModules>
            <add type= "BusinessLogic.PageAuthorization, TestSite" name="PageAuthorization" />
          </httpModules>
        </system.web>
      </configuration>-->
      <!--<add name="RadCompression" type="Telerik.Web.UI.RadCompression" />-->
      <add name="TelemetryCorrelationHttpModule" type="Microsoft.AspNet.TelemetryCorrelation.TelemetryCorrelationHttpModule, Microsoft.AspNet.TelemetryCorrelation" />
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web" />
    </httpModules>
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="System.Data.Entity, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
        <add assembly="System.Web.Entity, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.Net.Http, Version=4.2.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" />
        <add assembly="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
      </assemblies>
    </compilation>
    <machineKey decryption="AES" decryptionKey="0CA3EFAF0F7A5E7A62681C0BF656EE0ECE31ACEE3E1023BA3FAD20EA5F199DE8" validation="SHA1" validationKey="5DB079A93BF63C680F749FC29E3F0B52DF0030909DE62168764FF0DCE537184F0535D5D9AD66DEDC97DC1ABFF7FA540B4DFD82E5BB196B95D15FF81F75AD5328" />
    <pages controlRenderingCompatibilityVersion="4.0" validateRequest="false" />
  </system.web>
  <system.webServer>
    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/Errors/404.aspx" responseMode="ExecuteURL" />
    </httpErrors>
    <defaultDocument>
      <files>
        <clear />
        <add value="login.aspx" />
      </files>
    </defaultDocument>
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="WebDAVModule" />
      <!--<add name="LogitudeHttpModule" type="WebFreight.Web.Security.LogitudeHttpModule" />
      <add name="DomainServiceModule" preCondition="managedHandler" type="System.ServiceModel.DomainServices.Hosting.DomainServiceHttpModule, System.ServiceModel.DomainServices.Hosting, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />-->
      <!--<add name="RadCompression" preCondition="managedHandler" type="Telerik.Web.UI.RadCompression" />-->
      <add name="DomainServiceModule" preCondition="managedHandler" type="System.ServiceModel.DomainServices.Hosting.DomainServiceHttpModule, System.ServiceModel.DomainServices.Hosting, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
      <remove name="TelemetryCorrelationHttpModule" />
      <add name="TelemetryCorrelationHttpModule" type="Microsoft.AspNet.TelemetryCorrelation.TelemetryCorrelationHttpModule, Microsoft.AspNet.TelemetryCorrelation" preCondition="managedHandler" />
      <remove name="ApplicationInsightsWebTracking" />
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web" preCondition="managedHandler" />
    </modules>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <remove name="WebDAV" />
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    <!--
    maxQueryStringLength="32768" maxUrlLength="65536"
    defaults:  maxUrlLength="260" maxQueryStringLength="2048"
    
    See this for maxQueryString | maxUrlLength    
    https://www.asp.net/whitepapers/aspnet4#0.2__Toc253429244
    -->
    <security>
      <requestFiltering>
        <requestLimits maxQueryString="8000" />
      </requestFiltering>
    </security>
  </system.webServer>
  <connectionStrings configSource="JustConfig\Customs.ConnectionStrings.config" />
