  <system.serviceModel>
    <services>
      <!--HTTPS ONLY-->
      <!--<service name="WebFreight.Web.CustomWebServices.SignService">
     <endpoint address="" binding="wsHttpBinding" bindingConfiguration="WSHttpBinding_ISignService" name="SecuredByTransportEndpoint" contract="WebFreight.Web.CustomWebServices.ISignService" />
    </service>-->
      <service name="WebFreight.Web.CustomWebServices.WebForm1">
        <endpoint address="" behaviorConfiguration="WebFreight.Web.CustomWebServices.WebForm1AspNetAjaxBehavior" binding="webHttpBinding" contract="WebFreight.Web.CustomWebServices.WebForm1" />
      </service>
    </services>
    <bindings>
      <!--HTTPS ONLY-->
      <!--<wsHttpBinding>
		<binding name="WSHttpBinding_ISignService">
			<security mode="Transport">
				<transport clientCredentialType="None" />
			</security>
		</binding>
	</wsHttpBinding>-->
      <basicHttpBinding>
        <binding maxBufferSize="67108864" maxReceivedMessageSize="67108864" transferMode="Streamed">
          <readerQuotas maxStringContentLength="67108864" maxArrayLength="67108864" />
        </binding>
        <binding name="Timbrado33Soap" closeTimeout="00:05:00" openTimeout="00:05:00" receiveTimeout="00:10:00" sendTimeout="00:05:00" allowCookies="false" bypassProxyOnLocal="false" hostNameComparisonMode="StrongWildcard" maxBufferPoolSize="524288" maxBufferSize="5242880" maxReceivedMessageSize="5242880" textEncoding="utf-8" transferMode="Buffered" useDefaultWebProxy="true" messageEncoding="Text">
          <readerQuotas maxDepth="32" maxStringContentLength="5242880" maxArrayLength="32768" maxBytesPerRead="4096" maxNameTableCharCount="32768" />
          <security mode="Transport">
            <transport clientCredentialType="None" proxyCredentialType="None" realm="" />
            <message clientCredentialType="UserName" algorithmSuite="Default" />
          </security>
        </binding>
      </basicHttpBinding>
    </bindings>
    <client>
      <!--PRUEBAS 3.3-->
      <endpoint address="https://cfdi33-pruebas.buzoncfdi.mx:1443/Timbrado.asmx" binding="basicHttpBinding" bindingConfiguration="Timbrado33Soap" contract="wsReference33.TimbradoSoap" name="Timbrado33SoapPruebas" />
      <!--PRODUCTIVO 3.3-->
      <endpoint address="https://timbracfdi33.mx:1443/Timbrado.asmx" binding="basicHttpBinding" bindingConfiguration="Timbrado33Soap" contract="wsReference33.TimbradoSoap" name="Timbrado33SoapProductivo" />
    </client>
    <behaviors>
      <endpointBehaviors>
        <behavior name="WebFreight.Web.CustomWebServices.WebForm1AspNetAjaxBehavior">
          <enableWebScript />
        </behavior>
      </endpointBehaviors>
      <serviceBehaviors>
        <behavior name="">
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <diagnostics>
      <endToEndTracing propagateActivity="true" activityTracing="true" messageFlowTracing="true" />
    </diagnostics>
