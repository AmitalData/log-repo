using System.ServiceModel.DomainServices.Server; 
using Logitude.Server.Tools; 
using System.Runtime.Serialization; 
using <#= validatorsnamespace #>
  
namespace <#= pmnamespacestring #>
{
   [CustomValidation(typeof(<#= classlevelname #>), "ValidateClass")]
   [DataContract]
   public partial class <#=tableName #>PM : EntityPM
   {
   <#+
 	foreach(var field in entity["field"])  //get all classes
	 { 
		  if( field.HasPMField.GetType() == typeof(string))
           {
             if(field.HasPMField == "false")
               {
                  continue;
               }
           }
		   string type = GetDataType(field);
		   if(type == "List")
           {
			    WritePMList(field);
           }
		   else
           {
	          WritePMProperty(field);

           }
	 }

	  

	 #>
   }
   
}
	 <#+
    
  }

