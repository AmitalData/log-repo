<#+
//Create an elastic object
private XElement FromFile(string file)
{
   var path= Host.ResolvePath(file);
   return XDocument.Load(path).Root;//.Root.ToElastic();
}

#>

<#+

 
public void GenerateScript(string sourceFolder,string destinationFolder)
{
	 
#>
-- this script is generated
delete from DWObjectFields
delete from DWObjectTables
<#+
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string sourceFilePath = Path.Combine(templateDirectory, sourceFolder);

foreach (string file in Directory.EnumerateFiles(sourceFilePath, "*.dwml"))
{
	GenerateScriptForFile(file);
	 
}

 string filename = "dw_objecttables_fields.generated.sql";
 
 SaveOutputFile(destinationFolder + filename);


 
}


public void GenerateScriptForFile(string xmlFilePath)
{
	
	 
		XElement entity = FromFile(xmlFilePath);
		WriteInsertTableMethod(entity); 
		WriteInsertFieldsMethod(entity);

     
	
    
}
private void WriteInsertTableMethod(XElement entity)
{

string tableName = entity.Attribute(XName.Get("Name")).Value.Trim('"');
string idVarName =  "@"+tableName +"NewId";
#>
------------------------------------------------------------------------------------
declare <#=idVarName#> varchar(15)
execute usp_GetNextTableIdValue <#=idVarName#> OUTPUT,'DWObjectTable' 
<#+

 string insertTableCommand = "insert into DWObjectTables(Id,Tenant";
 string valuesCommand = " Values(" + idVarName + ",0";
	foreach (var Att in entity.Attributes())
		 { 
			if(Att.Name != "Id")
			{
				insertTableCommand += "," + Att.Name;
				if(Att.Value != null && Att.Value.GetType() == typeof(string))
					{
						string strValue = Att.Value.Replace("\"",  "'");
						if(strValue == "true" || strValue == "false")
							strValue = "'" + strValue + "'";

						valuesCommand += "," + strValue;
					}
					else
					{
						valuesCommand+= "," + Att.Value.ToString();
					}
			}
		 }


		 insertTableCommand = insertTableCommand + ')' + valuesCommand + ')';

#>
<#= insertTableCommand #>  
<#+
}
private void WriteInsertFieldsMethod(XElement entity)
{

#>
--Fields --
<#+
string TableCode = entity.Attribute(XName.Get("Code")).Value.Replace("\"",  "'");
string IsClosed = entity.Attribute(XName.Get("IsClosed")).Value;
if(IsClosed == "false")
{

}

	foreach(var Fields in entity.Elements("fields")) 
		{ 
           foreach(var fieldElement in Fields.Elements("field"))
		   { 

string fieldName = fieldElement.Attribute(XName.Get("Code")).Value.Trim('"').Replace(" ", "").Replace("[" , "" ).Replace("]","").Replace("(" , "" ).Replace(")","");

string idVarName =  "@"+TableCode.Replace("'",  "")+fieldName +"NewId";
#>
declare <#=idVarName#> varchar(15)
execute usp_GetNextTableIdValue <#=idVarName#> OUTPUT,'DWObjectField' 
<#+

 string insertTableCommand = "insert into DWObjectFields(Id,Tenant,DWObjectTableCode";
 string valuesCommand = " Values(" + idVarName + ",0," + TableCode;

		   foreach (var Att in fieldElement.Attributes())
		       {  
			if(Att.Name != "Id")
			{
				insertTableCommand += "," + Att.Name;
				if(Att.Value != null && Att.Value.GetType() == typeof(string))
					{
						string strValue = Att.Value.Replace("\"",  "'");
						if(strValue == "true" || strValue == "false")
							strValue = "'" + strValue + "'";
						valuesCommand += "," + strValue;
					}
					else
					{
						valuesCommand+= "," + Att.Value.ToString();
					}
			}
			}

 insertTableCommand = insertTableCommand + ')' + valuesCommand + ')';
#>
<#= insertTableCommand #>  
<#+
		   }
	}
}

 

void SaveOutputFile(string outputFileName)
  {
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
	  
	    var manager = Manager.Create(Host, GenerationEnvironment);
	    manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString());
	    this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
     
  }

 
#>


