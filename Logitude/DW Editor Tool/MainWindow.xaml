<Window x:Class="DW_Editor_Tool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cmd="clr-namespace:GalaSoft.MvvmLight.Command;assembly=GalaSoft.MvvmLight.Extras.WPF45"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"

         xmlns:local="clr-namespace:DW_Editor_Tool.Views"
        mc:Ignorable="d"
        Title="DW File Editor Tool"  Width="1500"
        Height="800"
        
        x:Name="ThisWindow">

    <Window.Resources>
        <LinearGradientBrush x:Key="TitleBackground" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Offset="0" Color="#FFEAEAEB" />
            <GradientStop Offset="0.610443115234375" Color="sc#1, 0.7953632, 0.795877039, 0.804215252" />
            <GradientStop Offset="0.7698894739151001" Color="sc#1, 0.735742569, 0.7373737, 0.746481657" />
            <GradientStop Offset="0.87665826082229614" Color="sc#1, 0.6566499, 0.6597632, 0.6698923" />
            <GradientStop Offset="0.95973926782608032" Color="sc#1, 0.5620594, 0.5669453, 0.5782956" />
            <GradientStop Offset="1" Color="sc#1, 0.5028865, 0.50888133, 0.520995557" />
            <GradientStop Offset="1" Color="#FFBCBDBF" />
        </LinearGradientBrush>
     </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                MaxHeight="200"
                Margin="0 0 0 5"
                Background="#FFF7E3E3"
                BorderBrush="#FFDA6F6F"
                BorderThickness="1"
                Visibility="{Binding ErrorsVisibility}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <TextBlock Margin="10"
                           FontSize="12"
                           Foreground="#FFB02020"
                           Text="{Binding ErrorMessages}" />
            </ScrollViewer>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="DW Table">
                <TabItem.Content>
                    <Border Margin="5"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <Grid Margin="10">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>


                                    <Grid Grid.Row="0">
                                       
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="28" />
                                                <RowDefinition Height="28" />
                                                <RowDefinition Height="28" />
                                                <RowDefinition Height="28" />
                                                <RowDefinition Height="28" />
                                                <RowDefinition Height="28" />
                                                <RowDefinition Height="28" />
                                                <RowDefinition Height="28" />
                                                <RowDefinition Height="28" />
                                               <RowDefinition Height="28" />
                                               <RowDefinition Height="28" />
                                               <RowDefinition Height="28" />
                                               <RowDefinition Height="28" />
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="28" />

                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Code:" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding Code, Mode=TwoWay}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Name:" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding Name, Mode=TwoWay}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Type:" />
                                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding DWTableTypes}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding TypeCode}"></ComboBox>

                                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Is Closed:" />
                                        <CheckBox Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsClosed}" IsThreeState="False"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Default Filter By:" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding DefaultFilterBy, Mode=TwoWay}" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Data View Name" />
                                        <TextBox Grid.Row="5" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding DataViewName, Mode=TwoWay}" />

                                        <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Has Pivot:" Visibility="{Binding IsFactTable}" />
                                        <CheckBox Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding HasPivotColumn}" IsThreeState="False" Visibility="{Binding IsFactTable}" />
                                       
                                        <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Pivot Field:" Visibility="{Binding PivotFieldCodeVisisbilty}" />
                                        <TextBox Grid.Row="7" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding PivotFieldCode, Mode=TwoWay}" Visibility="{Binding PivotFieldCodeVisisbilty}" />


                                        <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Additional Fact:" Visibility="{Binding IsFactTable}" />
                                        <TextBox Grid.Row="8" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding AdditionalFactCode, Mode=TwoWay}" Visibility="{Binding IsFactTable}" />




                                        <TextBlock Grid.Row="9" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Additional Fact Foreign Key:" Visibility="{Binding IsFactTable}" />
                                        <TextBox Grid.Row="9" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding AdditionalFactForeignKey, Mode=TwoWay}" Visibility="{Binding IsFactTable}" />
                                        
                                        <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Additional Fact Relation Type:" Visibility="{Binding IsFactTable}" />
                                        <TextBox Grid.Row="10" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding AdditionalFactRelationType, Mode=TwoWay}" Visibility="{Binding IsFactTable}" />

                                        <TextBlock Grid.Row="11" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Parent Fact:" Visibility="{Binding IsFactTable}" />
                                        <TextBox Grid.Row="11" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding ParentFactCode, Mode=TwoWay}" Visibility="{Binding IsFactTable}" />

                                        <TextBlock Grid.Row="12" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Record Type:" Visibility="{Binding IsFactTable}" />
                                        <TextBox Grid.Row="12" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding RecordType , Mode=TwoWay}" Visibility="{Binding IsFactTable}" />

                                        <TextBlock Grid.Row="13" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Display Name:" Visibility="{Binding IsFactTable}" />
                                        <TextBox Grid.Row="13" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding DisplayName , Mode=TwoWay}" Visibility="{Binding IsFactTable}" />

                                        <TextBlock Grid.Row="14" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Has Custom Fields :" Visibility="{Binding IsFactTable}" />
                                        <CheckBox Grid.Row="14" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding HasCustomFields }" IsThreeState="False" Visibility="{Binding IsFactTable}" />

                                        <TextBlock Grid.Row="15" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Object Table Name:" Visibility="{Binding IsFactTable}" />
                                        <TextBox Grid.Row="15" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding ObjectTableName , Mode=TwoWay}" Visibility="{Binding IsFactTable}" />

                                        <TextBlock Grid.Row="16" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Max Number Of Custom Fields :" Visibility="{Binding IsFactTable}" />
                                        <TextBox Grid.Row="16" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding MaxNumberOfCustomFields  , Mode=TwoWay}" Visibility="{Binding IsFactTable}" />

   
                                    </Grid>


                                </Grid>
                                
                                
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </TabItem.Content>
            </TabItem>

            <TabItem Header="Object Field">
                <TabItem.Content>
                    <Border Margin="5"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0 0 0 5"
                                        Orientation="Horizontal">
                                <Button x:Name="addBtn"
                                        Width="50"
                                        Margin="0 0 5 0"
                                        Command="{Binding AddFieldCommand}"
                                        Content="Add" />
                                <Button x:Name="removeBtn"
                                        Width="50"
                                        Command="{Binding RemoveFieldCommand}"
                                        CommandParameter="{Binding SelectedItem,
                                                                   ElementName=MyListBox}"
                                        Content="Remove" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="270" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="ObjectFieldsFilter"
                                             Grid.Row="0"
                                             Grid.Column="1"
                                             Height="22"
                                             VerticalAlignment="Center"
                                             Text="{Binding ObjectFieldsFilter,
                                                            Mode=TwoWay}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="TextChanged">
                                                <cmd:EventToCommand Command="{Binding ObjectFieldsFilterTextChanged}" CommandParameter="{Binding Text, ElementName=ObjectFieldsFilter}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <ListBox x:Name="MyListBox"
                                             Grid.Row="1"
                                             ItemsSource="{Binding TempDWObjectFieldsList}"
                                             SelectedIndex="0"
                                             SelectedItem="{Binding SelectedObjectField,
                                                                    Mode=TwoWay}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Grid MinWidth="25" Margin="3">
                                                                <VisualStateManager.VisualStateGroups>
                                                                    <VisualStateGroup x:Name="CommonStates">
                                                                        <VisualState x:Name="Normal" />
                                                                        <VisualState x:Name="MouseOver">
                                                                            <Storyboard>
                                                                                <ObjectAnimationUsingKeyFrames Duration="0"
                                                                                                               Storyboard.TargetName="ItemBorder"
                                                                                                               Storyboard.TargetProperty="Background">
                                                                                    <DiscreteObjectKeyFrame KeyTime="0">
                                                                                        <DiscreteObjectKeyFrame.Value>
                                                                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                                                <GradientStop Offset="0" Color="White" />
                                                                                                <GradientStop Offset="1" Color="#FFBACEE3" />
                                                                                            </LinearGradientBrush>
                                                                                        </DiscreteObjectKeyFrame.Value>
                                                                                    </DiscreteObjectKeyFrame>
                                                                                </ObjectAnimationUsingKeyFrames>
                                                                          
                                                                            </Storyboard>
                                                                        </VisualState>
                                                                        <VisualState x:Name="Selected">
                                                                            <Storyboard>
                                                                                <ObjectAnimationUsingKeyFrames Duration="0"
                                                                                                               Storyboard.TargetName="ItemBorder"
                                                                                                               Storyboard.TargetProperty="Background">
                                                                                    <DiscreteObjectKeyFrame KeyTime="0">
                                                                                        <DiscreteObjectKeyFrame.Value>
                                                                                            <LinearGradientBrush StartPoint="0.5,1.619" EndPoint="0.5,-0.19">
                                                                                                <GradientStop Offset="0" Color="#FF1782B8" />
                                                                                                <GradientStop Offset="0.521087646484375" Color="sc#1, 0.07436104, 0.285719752, 0.5282723" />
                                                                                                <GradientStop Offset="0.71199202537536621" Color="sc#1, 0.212689176, 0.417107344, 0.6311929" />
                                                                                                <GradientStop Offset="0.8492809534072876" Color="sc#1, 0.395504266, 0.590749741, 0.767213345" />
                                                                                                <GradientStop Offset="0.960737943649292" Color="sc#1, 0.613748252, 0.7980435, 0.92959404" />
                                                                                                <GradientStop Offset="1" Color="sc#1, 0.708375752, 0.8879231, 1" />
                                                                                                <GradientStop Offset="1" Color="#FFDBF2FF" />
                                                                                            </LinearGradientBrush>
                                                                                        </DiscreteObjectKeyFrame.Value>
                                                                                    </DiscreteObjectKeyFrame>
                                                                                </ObjectAnimationUsingKeyFrames>
                                                                             
                                                                            </Storyboard>
                                                                        </VisualState>
                                                                        <VisualState x:Name="Disabled" />
                                                                    </VisualStateGroup>
                                                                </VisualStateManager.VisualStateGroups>

                                                                <Border x:Name="ItemBorder"
                                                                        BorderThickness="0"
                                                                        CornerRadius="5">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0.5,1.643" EndPoint="0.5,0.067">
                                                                            <GradientStop Offset="0" Color="#FFBCBDBF" />
                                                                            <GradientStop Offset="1" Color="#FFE6E7E8" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        
                                                                        <TextBlock x:Name="ItemContent"
                                                                               Margin="10 5 5 5"
                                                                               VerticalAlignment="Center"
                                                                               FontFamily="Lucida Sans Unicode"
                                                                               FontSize="14"
                                                                               Width="150"
                                                                               Foreground="#FF6E7172"
                                                                               Text="{Binding Name}" />
                                                                    </StackPanel>
                                                                </Border>

                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Grid>

                                <ScrollViewer Grid.Column="1"
                                              Margin="-10 0 0 0"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto">
                                    <Grid Visibility="{Binding FieldsEditControlVisibility}">
                                        <local:DWObjectFieldView DataContext="{Binding SelectedItem, ElementName=MyListBox, Mode=TwoWay}" />
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem.Content>
            </TabItem>
        </TabControl>

        <!--  Buttons  -->
        <Border Grid.Row="2"
                Margin="10"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0,0,8,8">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
             
                <Button x:Name="cancelBtn"
                        Width="57"
                        Height="22"
                        Margin="5,0,0,0"
                        Command="{Binding CancelBtnCommand}" CommandParameter="{Binding ElementName=ThisWindow}"
                        Content="Cancel" />
                <Button x:Name="okBtn"
                        Width="57"
                        Height="22"
                        Margin="5,0,0,0"
                        Command="{Binding SaveBtnCommand}" CommandParameter="{Binding ElementName=ThisWindow}"
                        Content="Save" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
