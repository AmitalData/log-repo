<UserControl x:Class="DW_Editor_Tool.Views.DWObjectFieldView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DW_Editor_Tool.Views"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="800"
             x:Name="ThisWindow">
    <Grid>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                Margin="10"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0,0,8,8">
                
            </Border>
            <ScrollViewer Grid.Row="1"
                      Margin="10 0 0 0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                        Margin="0 0 0 5"
                        Background="#FFF7E3E3"
                        BorderBrush="#FFDA6F6F"
                        BorderThickness="1"
                        
                        Visibility="{Binding ErrorsVisibility}">
                        <TextBlock Margin="10"
                               FontSize="12"
                               Foreground="#FFB02020"
                               Text="{Binding ErrorMessages}" />
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <!--<ColumnDefinition Width="0" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="*" />-->
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Vertical">


                            <StackPanel Orientation="Horizontal" Margin="0 0 0 0">
                                <TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Name:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" Text="{Binding Name, Mode=TwoWay}" />
                            </StackPanel>
                            

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220" Grid.Row="0"  VerticalAlignment="Center" FontWeight="Bold" Text="Code:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding Code, Mode=TwoWay}" />
                            </StackPanel>
                            
                          

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Is Primary Key:" />
                                <CheckBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" IsChecked="{Binding IsPrimaryKey, Mode=TwoWay}" IsThreeState="False"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Is Required:" />
                                <CheckBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" IsChecked="{Binding IsRequired, Mode=TwoWay}" IsThreeState="False"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock  Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Data Type:" />
                                <ComboBox Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" Grid.Row="3" Grid.Column="1" ItemsSource="{Binding DataTypesList}"  SelectedValue="{Binding DataTypeCode}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0" Visibility="{Binding DimensionTabeVisisbilty}">
                                <TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Dimension Table Code:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" Text="{Binding DimensionTableCode, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0" Visibility="{Binding TextTypeVisibility}">
                                <TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Min Length:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" Text="{Binding MinLength, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0"  Visibility="{Binding TextTypeVisibility}">
                                <TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Max Length:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" Text="{Binding MaxLength, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Is Measurement:" />
                                <CheckBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" IsChecked="{Binding IsMeasurement, Mode=TwoWay}" IsThreeState="False"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock  Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Aggregation Type Code:" />
                                <ComboBox Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" Grid.Row="3" Grid.Column="1"   SelectedValue="{Binding AggregationTypeCode}"  ItemsSource="{Binding AggregationTypesList}"/>
                                
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock  Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Display In Query Builder:" />
                                <CheckBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" IsChecked="{Binding DisplayInQueryBuilder, Mode=TwoWay}" IsThreeState="False"/>

                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock  Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Category1:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" Text="{Binding Category1, Mode=TwoWay}" />

                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock  Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Category2:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" Text="{Binding Category2, Mode=TwoWay}" />

                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock  Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="LOV Additional Fields:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" Text="{Binding LOVAdditionalColumns, Mode=TwoWay}" />

                            </StackPanel>

							<StackPanel Orientation="Horizontal" Margin="0 5 0 0">
								<TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Hide Tree:" />
								<CheckBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" IsChecked="{Binding HideTree , Mode=TwoWay}" IsThreeState="False"/>
							</StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Cannot Filter:" />
                                <CheckBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" IsChecked="{Binding CannotFilter , Mode=TwoWay}" IsThreeState="False"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Is Custom:" />
                                <CheckBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" IsChecked="{Binding IsCustom, Mode=TwoWay}" IsThreeState="False"/>
                            </StackPanel>


                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock  Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Help Text:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" Text="{Binding HelpText, Mode=TwoWay}" />

                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock  Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Original Object Field Code:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" Text="{Binding OriginalObjectFieldCode, Mode=TwoWay}" />

                            </StackPanel>

                            
                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock  Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="View Field Display Name:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" Text="{Binding ViewFieldDisplayName, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock  Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Dimension Data View Name:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" Text="{Binding DimensionDataViewName, Mode=TwoWay}" />
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Dont Display In View:" />
                                <CheckBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" IsChecked="{Binding DontDisplayInView , Mode=TwoWay}" IsThreeState="False"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Is Multiple Selection:" />
                                <CheckBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" IsChecked="{Binding IsMultipleSelection , Mode=TwoWay}" IsThreeState="False"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Use Unit Selection:" />
                                <CheckBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" IsChecked="{Binding UseUnitSelection , Mode=TwoWay}" IsThreeState="False"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock  Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Record Type:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" Text="{Binding RecordType, Mode=TwoWay}" />
                            </StackPanel>

                        </StackPanel>

                      

                    </Grid>
                </Grid>
            </ScrollViewer>

            <!--  Buttons  -->
            <Border Grid.Row="2"
                Margin="10"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0,0,8,8" Visibility="{Binding ButtonsVisibility}">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                    <Button x:Name="cancelBtn"
                        Width="57"
                        Height="22"
                        Margin="5,0,0,0"
                        Command="{Binding CancelBtnCommand}" CommandParameter="{Binding ElementName=ThisWindow}"
                        Content="Cancel" />
                    <Button x:Name="okBtn"
                        Width="57"
                        Height="22"
                        Margin="5,0,0,0"
                        Command="{Binding SaveBtnCommand}" CommandParameter="{Binding ElementName=ThisWindow}"
                        Content="Save" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</UserControl>
