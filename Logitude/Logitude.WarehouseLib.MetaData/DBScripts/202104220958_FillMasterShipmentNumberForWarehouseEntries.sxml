<Script DBType="Main" Module="Warehouse" >
  <Sql Version="1">
    <![CDATA[

    declare @Id as varchar(15)
		declare @ShipmentId as varchar(15)
		declare @ShipmentNumber as varchar(20)
		declare @ShipmentLevelCode as varchar(1)
		declare @MasterShipmentDataId as varchar(15)
		declare @MasterShipmentDataNumber as varchar(20)

		DECLARE WarehouseEntries CURSOR READ_ONLY
		FOR
				select Id,ShipmentId,ShipmentNumber from WarehouseEntries 
				where ConnectedToShipment = 1 and ConnectedTo = 'Shipment' and ShipmentId is not null
		OPEN WarehouseEntries FETCH NEXT FROM WarehouseEntries INTO @Id,@ShipmentId,@ShipmentNumber
		WHILE @@FETCH_STATUS = 0
		BEGIN
				set @ShipmentLevelCode = (select ShipmentLevelCode from Shipments where Id = @ShipmentId)
			if(@ShipmentLevelCode = 'H')
				begin
					set @MasterShipmentDataId = (select MasterShipmentDataId from Shipments where Id = @ShipmentId)
					set @MasterShipmentDataNumber = (select MasterShipmentNumber from ShipmentMasterDatas where Id = @MasterShipmentDataId)
					update WarehouseEntries set MasterShipmentNumber = @MasterShipmentDataNumber where Id = @Id
				end
			else
				begin
					update WarehouseEntries set MasterShipmentNumber = @ShipmentNumber where Id = @Id
				end
		FETCH NEXT FROM WarehouseEntries INTO @Id,@ShipmentId,@ShipmentNumber
		END
		CLOSE WarehouseEntries
		DEALLOCATE WarehouseEntries

    ]]>
  </Sql>
</Script>