<Script DBType="Main" Module="Warehouse" >
  <Sql Version="1">
    <![CDATA[

    declare @Id as varchar(15)
		declare @ShipmentId as varchar(15)
		declare @ShipmentNumber as varchar(20)
		declare @ShipmentLevelCode as varchar(1)
		declare @MasterShipmentDataId as varchar(15)
		declare @MasterShipmentDataNumber as varchar(20)

		DECLARE WarehouseReleases CURSOR READ_ONLY
		FOR
				select Id,ShipmentId,ShipmentNumber from WarehouseReleases 
				where ConnectedTo = 'Shipment' and ShipmentId is not null
		OPEN WarehouseReleases FETCH NEXT FROM WarehouseReleases INTO @Id,@ShipmentId,@ShipmentNumber
		WHILE @@FETCH_STATUS = 0
		BEGIN
				set @ShipmentLevelCode = (select ShipmentLevelCode from Shipments where Id = @ShipmentId)
			if(@ShipmentLevelCode = 'H')
				begin
					set @MasterShipmentDataId = (select MasterShipmentDataId from Shipments where Id = @ShipmentId)
					set @MasterShipmentDataNumber = (select MasterShipmentNumber from ShipmentMasterDatas where Id = @MasterShipmentDataId)
					update WarehouseReleases set MasterShipmentNumber = @MasterShipmentDataNumber where Id = @Id
				end
			else
				begin
					update WarehouseReleases set MasterShipmentNumber = @ShipmentNumber where Id = @Id
				end
		FETCH NEXT FROM WarehouseReleases INTO @Id,@ShipmentId,@ShipmentNumber
		END
		CLOSE WarehouseReleases
		DEALLOCATE WarehouseReleases

    ]]>
  </Sql>
</Script>