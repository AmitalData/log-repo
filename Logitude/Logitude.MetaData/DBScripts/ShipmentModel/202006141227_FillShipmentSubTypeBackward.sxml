<Script DBType="Main">
  <Sql Version="3">
    <![CDATA[
    
 If(OBJECT_ID('tempdb..#tempTable') Is Not Null)
Begin
    Drop Table #tempTable
End

If(OBJECT_ID('tempdb..#temp_Shipments') Is Not Null)
Begin
    Drop Table #temp_Shipments
End


CREATE TABLE #temp_Shipments (
	Id varchar(15) not null ,
    ShipmentSubTypeId varchar(15)  null,
	ShipmentTypeId varchar(15)  null
    )
	
	select  Id, Tenant, TransportModeId, ShipmentTypeId
	into #tempTable
	FROM Shipments
	
	  declare @Tenant as int
    declare @EntityId as varchar(15)
	  declare @ShipmentTypeId as varchar(4)
	  declare @TransportModeId as varchar(4)
	  declare @ShipmentSubTypeId as varchar(15)
	  declare @NewShipmentTypeId as varchar(15)

	   declare @Count as int
    set @Count = 0;
    BEGIN
       DECLARE DataCursor CURSOR READ_ONLY
       FOR
       SELECT Id, Tenant, TransportModeId, ShipmentTypeId
       FROM #tempTable
       OPEN DataCursor FETCH NEXT FROM DataCursor INTO @EntityId, @Tenant, @TransportModeId, @ShipmentTypeId
       WHILE @@FETCH_STATUS = 0
       BEGIN
       		set @ShipmentSubTypeId = NULL
			set @NewShipmentTypeId = NULL

			if(@TransportModeId = 'A')
				begin
					set @ShipmentSubTypeId = (select Id from ShipmentSubTypes where Code = 'Air' and Tenant = @Tenant)
					set @NewShipmentTypeId = 'Air'
				end

				else if(@TransportModeId = 'O')
				begin

					set @NewShipmentTypeId = @ShipmentTypeId

					if(@ShipmentTypeId = 'FCLD')
					begin
						set @ShipmentSubTypeId = (select Id from ShipmentSubTypes where Code = 'FCL' and Tenant = @Tenant)
					end

					else if(@ShipmentTypeId = 'LCLD')
					begin
						set @ShipmentSubTypeId = (select Id from ShipmentSubTypes where Code = 'LCL' and Tenant = @Tenant)
					end
					
				end

				else if(@TransportModeId = 'I')
				begin

					set @NewShipmentTypeId = @ShipmentTypeId

					if(@ShipmentTypeId = 'FTL')
					begin
						set @ShipmentSubTypeId = (select Id from ShipmentSubTypes where Code = 'FTL' and Tenant = @Tenant)
					end

					else if(@ShipmentTypeId = 'LTL')
					begin
						set @ShipmentSubTypeId = (select Id from ShipmentSubTypes where Code = 'LTL' and Tenant = @Tenant)
					end

				end

       		insert into #temp_Shipments(Id, ShipmentSubTypeId, ShipmentTypeId) values (@EntityId, @ShipmentSubTypeId, @NewShipmentTypeId)
       			
			set @Count = @Count + 1;
			if(@Count = 1000)
	    	begin print @Count

		    update Shipments
			set
			ShipmentSubTypeId = #temp_Shipments.ShipmentSubTypeId,
			ShipmentTypeId = #temp_Shipments.ShipmentTypeId
			FROM Shipments
			INNER JOIN #temp_Shipments
			on Shipments.Id = #temp_Shipments.Id

			truncate table #temp_Shipments
			set @Count = 0
			end

		
       FETCH NEXT FROM DataCursor INTO @EntityId, @Tenant, @TransportModeId, @ShipmentTypeId
       END
       CLOSE DataCursor
       DEALLOCATE DataCursor
    END
		
	  update Shipments
			set
			ShipmentSubTypeId = #temp_Shipments.ShipmentSubTypeId,
			ShipmentTypeId = #temp_Shipments.ShipmentTypeId
			FROM Shipments
			INNER JOIN #temp_Shipments
			on Shipments.Id = #temp_Shipments.Id
	
	  drop table #tempTable
    drop table #temp_Shipments
      
    ]]>
  </Sql>
</Script>
