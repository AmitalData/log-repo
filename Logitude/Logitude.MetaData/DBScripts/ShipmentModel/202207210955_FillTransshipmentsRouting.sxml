<Script DBType="Main" Module="Shipment" AOT="true" TargetTableName="ShipmentMasterDatas">
	<Sql Version="1">
		<![CDATA[
    


declare @Tenant as int
declare @Id as varchar(15)
declare @Via1_Id as varchar(15)
declare @Via2_Id as varchar(15)
declare @Via3_Id as varchar(15)
declare @Via1_Code as varchar(15)
declare @Via2_Code as varchar(15)
declare @Via3_Code as varchar(15)
declare @Result as varchar(200)

BEGIN
       DECLARE DataCursor CURSOR READ_ONLY
       FOR
       SELECT Id, Tenant, Transshipment1FromPortId, Transshipment2FromPortId, Transshipment3FromPortId
       FROM ShipmentMasterDatas
       where NumberOfTransshipments > 0  and $LastCounterWhere$ 
       OPEN DataCursor FETCH NEXT FROM DataCursor INTO @Id, @Tenant, @Via1_Id, @Via2_Id, @Via3_Id
       WHILE @@FETCH_STATUS = 0
       BEGIN

            set @Result = NULL
            set @Via1_Code = NULL
            set @Via2_Code = NULL
            set @Via3_Code = NULL

              set @Via1_Code = (select Code from Ports where Id = @Via1_Id and Tenant = @Tenant)

              if(@Via2_Id is not null)
                set @Via2_Code = (select Code from Ports where Id = @Via2_Id and Tenant = @Tenant)

              if(@Via3_Id is not null)
                set @Via3_Code = (select Code from Ports where Id = @Via3_Id and Tenant = @Tenant)

            set @Result = @Via1_Code

            if(@Via2_Code is not null)
                set @Result = @Result + ' , ' + @Via2_Code

            if(@Via3_Code is not null)
                set @Result = @Result + ' , ' + @Via3_Code

            update ShipmentComputedFields set Transshipments = @Result where Id = @Id


            if exists (select * from Shipments where ShipmentLevelCode = 'H' and Tenant = @Tenant and MasterShipmentDataId = @Id)
            begin
                declare @NewId as varchar(15)

                BEGIN
                       DECLARE DataCursor1 CURSOR READ_ONLY
                       FOR
                       SELECT Id
                       FROM Shipments
                       where ShipmentLevelCode = 'H' and Tenant = @Tenant and MasterShipmentDataId = @Id
                       OPEN DataCursor1 FETCH NEXT FROM DataCursor1 INTO @NewId
                       WHILE @@FETCH_STATUS = 0
                       BEGIN
			   			 
                         update ShipmentComputedFields set Transshipments = @Result where Id = @NewId

                       FETCH NEXT FROM DataCursor1 INTO @NewId
                       END
                       CLOSE DataCursor1
                       DEALLOCATE DataCursor1
                END
            end
                 			 
       FETCH NEXT FROM DataCursor INTO @Id, @Tenant, @Via1_Id, @Via2_Id, @Via3_Id
       END
       CLOSE DataCursor
       DEALLOCATE DataCursor
END

      
        ]]>
	</Sql>
</Script>


