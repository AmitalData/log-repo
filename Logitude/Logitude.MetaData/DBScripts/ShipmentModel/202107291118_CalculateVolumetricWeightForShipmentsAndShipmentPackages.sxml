
<Script DBType="Main" Module="Shipment" AOT="true" TargetTableName="ShipmentPackages">
  <Sql Version="1">
    <![CDATA[
	  If(OBJECT_ID('tempdb..#tempTable') Is Not Null)
				Begin
					Drop Table #tempTable
				End

	  If(OBJECT_ID('tempdb..#temp_ShipmentPackages') Is Not Null)
				Begin
					Drop Table #temp_ShipmentPackages
				End

		CREATE TABLE #temp_ShipmentPackages 
		(Id varchar(15) not null ,
		 ShipmentId varchar(15) not null ,
		 Tenant int,
		 ShipmentPackageVolumetricWeight float)
	
		 select 
		 ShipmentPackages.Id, 
		 ShipmentPackages.Tenant,
		 ShipmentPackages.Weight,
		 ShipmentPackages.ShipmentId,
		 Shipments.GrossWeightUnitCode,
		 Shipments.ChargeableWeightUnitCode
		 into #tempTable

		FROM ShipmentPackages join Shipments on ShipmentPackages.ShipmentId = Shipments.Id where ShipmentPackages.Tenant = 2086
		And ShipmentPackages.VolumetricWeight is null And Weight is not null And ShipmentPackages.Volume is null and $LastCounterWhere$
  
     	DECLARE @Id as varchar(15)
		  DECLARE @ShipmentId as varchar(15)
			DECLARE @Tenant as int
			DECLARE @Count as int
			DECLARE @Weight as float
			DECLARE @VolumetricWeight as float
			DECLARE @GrossWeightUnitCode as varchar(3)
			DECLARE @ChargeableWeightUnitCode as varchar(3)
	

		  set @Count = 0;

			BEGIN
				 DECLARE DataCursor CURSOR READ_ONLY
				 FOR
				 SELECT Id, Tenant, Weight,ShipmentId,GrossWeightUnitCode, ChargeableWeightUnitCode
				 FROM #tempTable
				 OPEN DataCursor FETCH NEXT FROM DataCursor INTO @Id, @Tenant, @Weight,@ShipmentId, @GrossWeightUnitCode, @ChargeableWeightUnitCode
				 WHILE @@FETCH_STATUS = 0
				 BEGIN

			---------------- Compute VolumetricWeight ----------------
				if (@GrossWeightUnitCode is not NULL)
				begin
					if (@GrossWeightUnitCode = 'KG')
					begin
					set @VolumetricWeight = Round( @Weight*1.0 ,3)
					end

					else if (@GrossWeightUnitCode = 'LB')
					begin
					set @VolumetricWeight = Round( @Weight* 0.45359237 ,3)
					end

					else if (@GrossWeightUnitCode = 'MT')
					begin
					set @VolumetricWeight = Round( @Weight * 1000 ,3)
					end
				end
				else
				begin
					set @VolumetricWeight = @Weight 
				end			

			if (@GrossWeightUnitCode is not NULL)
			begin
				if (@ChargeableWeightUnitCode = 'KG')
				begin
				set @VolumetricWeight = Round( @VolumetricWeight/1 ,3)
				end

				else if (@ChargeableWeightUnitCode = 'LB')
				begin
				set @VolumetricWeight = Round( @VolumetricWeight/0.45359237 ,3)
				end

				else if (@ChargeableWeightUnitCode = 'MT')
				begin
				set @VolumetricWeight = Round(@VolumetricWeight/1000 ,3)
				end
			end

		  ---------------- insert values in temp table ----------------
       	insert into #temp_ShipmentPackages(Id, Tenant, ShipmentPackageVolumetricWeight,ShipmentId) values (@Id, @Tenant, @VolumetricWeight,@ShipmentId)
       			
				set @Count = @Count + 1;
				if(@Count = 1000)
				begin 
					update ShipmentPackages
					set
					VolumetricWeight = #temp_ShipmentPackages.ShipmentPackageVolumetricWeight
					FROM #temp_ShipmentPackages
					where #temp_ShipmentPackages.Id = ShipmentPackages.Id

					update Shipments
					set
					OrderVolumetricWeight = #temp_ShipmentPackages.ShipmentPackageVolumetricWeight
					FROM #temp_ShipmentPackages
					where #temp_ShipmentPackages.ShipmentId = Shipments.Id

					truncate table #temp_ShipmentPackages
					set @Count = 0
				end
		
				 FETCH NEXT FROM DataCursor INTO  @Id, @Tenant, @Weight,@ShipmentId, @GrossWeightUnitCode, @ChargeableWeightUnitCode
				 END
				 CLOSE DataCursor
				 DEALLOCATE DataCursor
			END

		if (@Count > 0)
		begin
		update ShipmentPackages
			set
		    VolumetricWeight = #temp_ShipmentPackages.ShipmentPackageVolumetricWeight
			FROM #temp_ShipmentPackages
			where #temp_ShipmentPackages.Id = ShipmentPackages.Id

		update Shipments
		    set
		    OrderVolumetricWeight = #temp_ShipmentPackages.ShipmentPackageVolumetricWeight
			FROM #temp_ShipmentPackages
			where #temp_ShipmentPackages.ShipmentId = Shipments.Id

		end

		drop table #tempTable
		drop table #temp_ShipmentPackages


    ]]>
  </Sql>
</Script>




