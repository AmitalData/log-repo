<Script DBType="Main" Module="Shipment" AOT="true" TargetTableName="Containers">
  <Sql Version="2">
    <![CDATA[
    

		DECLARE @Id as varchar(15)	
		DECLARE @Tenant as int
		DECLARE @ShipmentId as varchar(15)
		DECLARE @ContainerTypeId as varchar(15)
		DECLARE @Reference1 as varchar(2000)
		DECLARE @Reference2 as varchar(2000)
		DECLARE @Reference3 as varchar(2000)
		DECLARE @Reference4 as varchar(2000)
		DECLARE @Volume as decimal
		DECLARE @GrossWeight as decimal
		DECLARE @VolumeUnitCode as varchar(3)
		DECLARE @GrossWeightUnitCode as varchar(3)

			BEGIN
				 DECLARE DataCursor CURSOR READ_ONLY
				 FOR
				 SELECT Containers.Id,Containers.Tenant, Containers.ShipmentId ,ShipmentPackages.Volume,Shipments.VolumeUnitCode,ShipmentPackages.Weight, Shipments.GrossWeightUnitCode,
				 ShipmentPackages.PackageTypeId, 
				 ShipmentPackages.Reference1, ShipmentPackages.Reference2, ShipmentPackages.Reference3, ShipmentPackages.Reference4
				 FROM  Containers
				 inner join ShipmentPackages as ShipmentPackages on ShipmentPackages.ContainerEntityId = Containers.Id 
				 inner join Shipments as Shipments on ShipmentPackages.ShipmentId = Shipments.Id
				where $LastCounterWhere$
        
				 OPEN DataCursor FETCH NEXT FROM DataCursor INTO @Id, @Tenant, @ShipmentId , @Volume,@VolumeUnitCode,@GrossWeight,@GrossWeightUnitCode,@ContainerTypeId, @Reference1, @Reference2, @Reference3, @Reference4
				 WHILE @@FETCH_STATUS = 0
				 BEGIN

						update Containers
						set
				    		ContainerTypeId = @ContainerTypeId,
			                Volume = @Volume,
			                VolumeUnitCode = @VolumeUnitCode,
			                GrossWeight = @GrossWeight,
			                GrossWeightUnitCode = @GrossWeightUnitCode,
			                AdditionalReference1 = @Reference1,
			                AdditionalReference2 = @Reference2,
							AdditionalReference3 = @Reference3,
							AdditionalReference4 = @Reference4	
							where Id = @Id and Tenant = @Tenant
					FETCH NEXT FROM DataCursor INTO @Id, @Tenant, @ShipmentId , @Volume,@VolumeUnitCode,@GrossWeight,@GrossWeightUnitCode,@ContainerTypeId, @Reference1, @Reference2, @Reference3, @Reference4

				end
				CLOSE DataCursor
				DEALLOCATE DataCursor

			end
	
           ]]>
	</Sql>
</Script>

