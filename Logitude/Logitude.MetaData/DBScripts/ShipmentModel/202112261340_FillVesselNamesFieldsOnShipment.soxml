<Script DBType="Main" Module="Shipment" AOT="true" TargetTableName="Shipments">
  <Sql Version="2">
    <![CDATA[
   
	declare @EntityId as varchar(15)
	declare @Tenant as int

	declare @PreForVesselId as varchar(15)
	declare @OnForVesselId as varchar(15)
	
	declare @PreForVesselName as varchar(15)
	declare @OnForVesselName as varchar(15)

	DECLARE ShipmentsCursor CURSOR READ_ONLY
	FOR
	SELECT Id, Tenant, PreForwardingVesselId, OnForwardingVesselId
	FROM Shipments 
	where ShipmentLevelCode = 'H' and (PreForwardingVesselId is not null or OnForwardingVesselId is not null) and $LastCounterWhere$
	OPEN ShipmentsCursor FETCH NEXT FROM ShipmentsCursor INTO @EntityId, @Tenant, @PreForVesselId, @OnForVesselId
	WHILE @@FETCH_STATUS = 0
	BEGIN
		set @PreForVesselName = (select EnglishName from Vessels where Id = @PreForVesselId and Tenant = @Tenant)
		set @OnForVesselName = (select EnglishName from Vessels where Id = @OnForVesselId and Tenant = @Tenant)

		update Shipments 
		set PreForwardingVesselName = @PreForVesselName, OnForwardingVesselName = @OnForVesselName 
		where Id = @EntityId and Tenant = @Tenant

	FETCH NEXT FROM ShipmentsCursor INTO @EntityId, @Tenant, @PreForVesselId, @OnForVesselId
	END
	CLOSE ShipmentsCursor
	DEALLOCATE ShipmentsCursor
  
    ]]>
  </Sql>
</Script>