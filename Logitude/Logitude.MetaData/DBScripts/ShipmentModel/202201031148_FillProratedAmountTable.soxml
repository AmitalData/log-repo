<Script DBType="Main" Module="Shipment"  AOT="true" TargetTableName="Shipments">
  <Sql Version="6">
    <![CDATA[



declare @Tenant as int
declare @MasterId as varchar(15)
declare @MasterTypeId as varchar(5)
declare @MasterTransportModeId as varchar(1)	

declare @GRWT_Id as varchar(15)
declare @CHWT_Id as varchar(15)
declare @FIXD_Id as varchar(15)
declare @VOLU_Id as varchar(15)
declare @BTEU_Id as varchar(15)
declare @GWTN_Id as varchar(15)
declare @PRVL_Id as varchar(15)
declare @PRFR_Id as varchar(15)	
declare @QTY_Id as varchar(15)	
declare @GWKG_Id as varchar(15)
declare @CWKG_Id as varchar(15)
declare @VCBM_Id as varchar(15)
declare @SCGW_Id as varchar(15)
declare @PFCL_Id as varchar(15)

declare @AllHousesCount as float
declare @AllHousesTotalTEU as float
declare @AllHousesTotalVolume as float
declare @AllHousesTotalGrossWeight as float
declare @AllHousesTotalVolumetrics as float
declare @AllHousesTotalChargeableWeight as float
declare @AllHousesTotalGrossWeightPerTon as float	
declare @AllHousesTotalNumberOfPackages as float
declare @AllHousesTotalNumberOfContainers as float	
declare @AllHousesTotalGrossWeightInKG as float
declare @AllHousesTotalChargeableWeightInKG as float
declare @AllHousesTotalVolumeInCBM as float
declare @AllHousesGrossWeightPerStorageDays as float;
declare @MasterPayableId as varchar(15)
declare @MasterPayableUnitPrice as float
declare @MasterPayableMeasurementId as varchar(15)	
declare @MasterPayableAmountTypeCode as varchar(4)
declare @MasterPayableExpectedAmount_Local as float
declare @MasterPayableExpectedAmount_Profit as float
declare @ExpectedAmountLocal as float
declare @ExpectedAmountInProfitCurrency as float

declare @InvoiceLinesTable table
	(
		Id int,
		PayableId varchar(15),
		InvoiceId varchar(15),
		LocalAmount float,
		ProfitAmount float
	)

BEGIN
DECLARE MastersCursor CURSOR READ_ONLY
FOR
SELECT Id, Tenant, ShipmentTypeId, TransportModeId
FROM Shipments
WHERE ShipmentLevelCode = 'C' and AccountedPayablesInLocalCurrency <> 0  and $LastCounterWhere$
OPEN MastersCursor FETCH NEXT FROM MastersCursor INTO @MasterId, @Tenant, @MasterTypeId, @MasterTransportModeId
WHILE @@FETCH_STATUS = 0
BEGIN
	
	set @GRWT_Id = (select Id from Measurements where Code = 'GRWT' AND Tenant = @Tenant)
	set @CHWT_Id = (select Id from Measurements where Code = 'CHWT' AND Tenant = @Tenant)
	set @FIXD_Id = (select Id from Measurements where Code = 'FIXD' AND Tenant = @Tenant)
	set @VOLU_Id = (select Id from Measurements where Code = 'VOLU' AND Tenant = @Tenant)
	set @BTEU_Id = (select Id from Measurements where Code = 'BTEU' AND Tenant = @Tenant)
	set @GWTN_Id = (select Id from Measurements where Code = 'GWTN' AND Tenant = @Tenant)
	set @PRVL_Id = (select Id from Measurements where Code = 'PRVL' AND Tenant = @Tenant)
	set @PRFR_Id = (select Id from Measurements where Code = 'PRFR' AND Tenant = @Tenant)
	set @QTY_Id = (select Id from Measurements where Code = 'QTY' AND Tenant = @Tenant)
	set @GWKG_Id = (select Id from Measurements where Code = 'GWKG' AND Tenant = @Tenant)
	set @CWKG_Id = (select Id from Measurements where Code = 'CWKG' AND Tenant = @Tenant)
	set @VCBM_Id = (select Id from Measurements where Code = 'VCBM' AND Tenant = @Tenant)
	set @SCGW_Id = (select Id from Measurements where Code = 'SCGW' AND Tenant = @Tenant)
	set @PFCL_Id = (select Id from Measurements where Code = 'PFCL' AND Tenant = @Tenant)

	if exists (select * from Shipments where ShipmentLevelCode = 'H' AND MasterShipmentDataId = @MasterId)
	begin
		select
		@AllHousesCount = count(*),
		@AllHousesTotalTEU = sum(isnull(TEU,0)),
		@AllHousesTotalVolume = sum(isnull(Volume,0)),
		@AllHousesTotalGrossWeight = sum(isnull(GrossWeight,0)),
		@AllHousesTotalVolumetrics = sum(isnull(VolumetricWeight,0)),
		@AllHousesTotalChargeableWeight = sum(isnull(ChargeableWeight,0)),
		@AllHousesTotalGrossWeightPerTon = sum(isnull(GrossWeightPerTon,0)),
		@AllHousesTotalNumberOfPackages = sum(isnull(NumberOfPackages,0)),
		@AllHousesTotalNumberOfContainers = sum(isnull(NumberOfContainers,0)),
		@AllHousesTotalGrossWeightInKG = sum(isnull(GrossWeightInKG,0)),
		@AllHousesTotalChargeableWeightInKG = sum(isnull(ChargeableWeightInKG,0)),
		@AllHousesTotalVolumeInCBM = sum(isnull(VolumeInCBM,0)),
		@AllHousesGrossWeightPerStorageDays = sum(isnull(GrossWeightPerStorageDays,0))
		from Shipments
		where ShipmentLevelCode = 'H' AND MasterShipmentDataId = @MasterId
	end
	else
	begin
		set @AllHousesTotalTEU = 0
		set @AllHousesTotalVolume = 0
		set @AllHousesTotalGrossWeight = 0
		set @AllHousesTotalVolumetrics = 0
		set @AllHousesTotalChargeableWeight = 0
		set @AllHousesTotalGrossWeightPerTon = 0
		set @AllHousesTotalNumberOfPackages = 0
		set @AllHousesTotalNumberOfContainers = 0
		set @AllHousesTotalGrossWeightInKG = 0
		set @AllHousesTotalChargeableWeightInKG = 0
		set @AllHousesTotalVolumeInCBM = 0
		set @AllHousesGrossWeightPerStorageDays = 0
	end


		-- House Payable Variables
		BEGIN
			declare @HouseId as varchar(15)
			declare @HouseTEU as float
			declare @HouseVolume as float
			declare @HouseGrossWeight as float
			declare @HouseChargeableWeight as float
			declare @HouseGrossWeightPerTon as float
			declare @HouseValueOfGoods as float
			declare @HouseGrossWeightInKG as float
			declare @HouseChargeableWeightInKG as float
			declare @HouseVolumeInCBM as float
			declare @HouseGrossWeightPerStorageDays as float
			declare @HousePayableId as varchar(15)
			declare @HousePayableLineStatusCode as varchar(4)
			declare @HouseNumberOfPackages as float
			declare @HouseNumberOfContainers as float
			declare @HouseTypeId as varchar(5)
			declare @HouseTransportModeId as varchar(1)

		END

		-- House Payable Prorate Variables
		BEGIN
			declare @ProrateAmountInLocalCurrency as float
			declare @ProrateAmountInProfitCurrency as float
			declare @NewProrateId as varchar(15)
			declare @ProrateInvoiceId as varchar(15)
			declare @LocalForeignAmount as float
			declare @ProfitForeignAmount as float
			declare @PayableProrateAmountInLocal as float
			declare @PayableProrateAmountInProfit as float
		END
		
	-- Fill Invoice Lines
	insert into @InvoiceLinesTable
	SELECT LineNumber, EntityPayableId, APInvoiceId, LocalCurrencyAmount, ProfitCurrencyAmount
	From APInvoiceLines
	Where Tenant = @Tenant and EntityId = @MasterId

		-- Loop Master Payables (1: Not PRFR)
		BEGIN
			DECLARE MasterPayables1Cursor CURSOR READ_ONLY
			FOR
			SELECT Id, UnitPrice, MeasurementId, ShipmentPayableAmountTypeCode, ExpectedAmountLocal, ExpectedAmountInProfitCurrency
			FROM ShipmentPayables
			WHERE Tenant = @Tenant AND ShipmentId = @MasterId
			OPEN MasterPayables1Cursor FETCH NEXT FROM MasterPayables1Cursor INTO @MasterPayableId, @MasterPayableUnitPrice, @MasterPayableMeasurementId, @MasterPayableAmountTypeCode, @MasterPayableExpectedAmount_Local, @MasterPayableExpectedAmount_Profit
			WHILE @@FETCH_STATUS = 0
			BEGIN
				
				-- Loop Houses
				BEGIN
					DECLARE Houses1Cursor CURSOR READ_ONLY
					FOR
					SELECT Id, TEU, Volume, GrossWeight, ChargeableWeight, GrossWeightPerTon, ValueOfGoods, NumberOfPackages, NumberOfContainers, TransportModeId, ShipmentTypeId, GrossWeightInKG, ChargeableWeightInKG, VolumeInCBM, GrossWeightPerStorageDays
					FROM Shipments
					WHERE ShipmentLevelCode = 'H' AND MasterShipmentDataId = @MasterId and Tenant = @Tenant
					OPEN Houses1Cursor FETCH NEXT FROM Houses1Cursor INTO @HouseId, @HouseTEU, @HouseVolume, @HouseGrossWeight, @HouseChargeableWeight, @HouseGrossWeightPerTon, @HouseValueOfGoods, @HouseNumberOfPackages, @HouseNumberOfContainers, @HouseTransportModeId,@HouseTypeId, @HouseGrossWeightInKG, @HouseChargeableWeightInKG, @HouseVolumeInCBM, @HouseGrossWeightPerStorageDays
					WHILE @@FETCH_STATUS = 0
					BEGIN

					-- Loop House Payables / Amount Calculating & Updating
					BEGIN
						DECLARE HousePayables1Cursor CURSOR READ_ONLY
						FOR
						SELECT Id, ShipmentPayableLineStatusCode, ExpectedAmountLocal, ExpectedAmountInProfitCurrency
						FROM ShipmentPayables
						WHERE ShipmentId = @HouseId AND Tenant = @Tenant AND ShipmentPayableParentId = @MasterPayableId
						OPEN HousePayables1Cursor FETCH NEXT FROM HousePayables1Cursor INTO @HousePayableId, @HousePayableLineStatusCode, @ExpectedAmountLocal, @ExpectedAmountInProfitCurrency
						WHILE @@FETCH_STATUS = 0
						BEGIN
		
								-- Reset Variables
								BEGIN
									set @ProrateAmountInLocalCurrency = 0
									set @ProrateAmountInProfitCurrency = 0
								END

								-- Create Prorate Record
								BEGIN
								DECLARE ProrateCursor CURSOR READ_ONLY
								FOR
								SELECT LocalAmount, ProfitAmount, InvoiceId
								FROM @InvoiceLinesTable		
								WHERE PayableId = @MasterPayableId
								OPEN ProrateCursor FETCH NEXT FROM ProrateCursor INTO @LocalForeignAmount, @ProfitForeignAmount, @ProrateInvoiceId
								WHILE @@FETCH_STATUS = 0
								BEGIN

								if not exists (select Id from PayableProratedAmounts where PayableId = @HousePayableId and InvoiceId = @ProrateInvoiceId)
								begin           
										if (@MasterPayableAmountTypeCode = 'NEXP')
									BEGIN
										set @ProrateAmountInLocalCurrency = @LocalForeignAmount / @AllHousesCount	
										set @ProrateAmountInProfitCurrency = @ProfitForeignAmount / @AllHousesCount	
									END

									-- Fixed
									else if (@MasterPayableMeasurementId = @FIXD_Id)
									BEGIN
										set @ProrateAmountInLocalCurrency = @LocalForeignAmount / @AllHousesCount
										set @ProrateAmountInProfitCurrency = @ProfitForeignAmount / @AllHousesCount
									END

									-- By TEU
									else if (@MasterPayableMeasurementId = @BTEU_Id)
									BEGIN
										if (@HouseTEU <> 0)
										begin
											set @ProrateAmountInLocalCurrency = (@HouseTEU / @AllHousesTotalTEU) * @LocalForeignAmount
											set @ProrateAmountInProfitCurrency = (@HouseTEU / @AllHousesTotalTEU) * @ProfitForeignAmount 
										end
									END

									-- Volume
									else if (@MasterPayableMeasurementId = @VOLU_Id)
									BEGIN
										if (@HouseVolume <> 0)
										begin
											set @ProrateAmountInLocalCurrency = (@HouseVolume / @AllHousesTotalVolume) * @LocalForeignAmount
											set @ProrateAmountInProfitCurrency = (@HouseVolume / @AllHousesTotalVolume) * @ProfitForeignAmount
										end
									END

									-- Gross Weight
									else if (@MasterPayableMeasurementId = @GRWT_Id)
									BEGIN
										if (@HouseGrossWeight <> 0)
										begin
											set @ProrateAmountInLocalCurrency = (@HouseGrossWeight / @AllHousesTotalGrossWeight) * @LocalForeignAmount
											set @ProrateAmountInProfitCurrency = (@HouseGrossWeight / @AllHousesTotalGrossWeight) *  @ProfitForeignAmount
										end
									END

									-- Chargeable Weight
									else if (@MasterPayableMeasurementId = @CHWT_Id)
									BEGIN
										if (@HouseChargeableWeight <> 0)
										begin
											set @ProrateAmountInLocalCurrency = (@HouseChargeableWeight / @AllHousesTotalChargeableWeight) * @LocalForeignAmount
											set @ProrateAmountInProfitCurrency = (@HouseChargeableWeight / @AllHousesTotalChargeableWeight) * @ProfitForeignAmount
										end
									END

									-- Gross Weight Per Ton
									else if (@MasterPayableMeasurementId = @GWTN_Id)
									BEGIN
										if (@HouseGrossWeightPerTon <> 0)
										begin
											set @ProrateAmountInLocalCurrency = (@HouseGrossWeightPerTon / @AllHousesTotalGrossWeightPerTon) * @LocalForeignAmount
											set @ProrateAmountInProfitCurrency = (@HouseGrossWeightPerTon / @AllHousesTotalGrossWeightPerTon) * @ProfitForeignAmount
										end
									END
                
									-- GrossWeightPerStorageDays
									else if (@MasterPayableMeasurementId = @SCGW_Id)
									BEGIN
										if (@HouseGrossWeightPerStorageDays <> 0)
										begin
											set @ProrateAmountInLocalCurrency = (@HouseGrossWeightPerStorageDays / @AllHousesGrossWeightPerStorageDays) * @LocalForeignAmount
											set @ProrateAmountInProfitCurrency = (@HouseGrossWeightPerStorageDays / @AllHousesGrossWeightPerStorageDays) * @ProfitForeignAmount
										end
									END

									-- GWKG: Gross Weight in Kg
									else if (@MasterPayableMeasurementId = @GWKG_Id)
									BEGIN
										if (@HouseGrossWeightInKG <> 0)
										begin
											set @ProrateAmountInLocalCurrency = (@HouseGrossWeightInKG / @AllHousesTotalGrossWeightInKG) * @LocalForeignAmount
											set @ProrateAmountInProfitCurrency = (@HouseGrossWeightInKG / @AllHousesTotalGrossWeightInKG) * @ProfitForeignAmount
										end
									END

									-- CWKG: Chargeable Weight in Kg
									else if (@MasterPayableMeasurementId = @CWKG_Id)
									BEGIN
										if (@HouseChargeableWeightInKG <> 0)
										begin
											set @ProrateAmountInLocalCurrency = (@HouseChargeableWeightInKG / @AllHousesTotalChargeableWeightInKG) * @LocalForeignAmount
											set @ProrateAmountInProfitCurrency = (@HouseChargeableWeightInKG / @AllHousesTotalChargeableWeightInKG) * @ProfitForeignAmount
										end
									END

									-- VCBM: Volume in CBM
									else if (@MasterPayableMeasurementId = @VCBM_Id)
									BEGIN
										if (@HouseVolumeInCBM <> 0)
										begin
											set @ProrateAmountInLocalCurrency = (@HouseVolumeInCBM / @AllHousesTotalVolumeInCBM) * @LocalForeignAmount
											set @ProrateAmountInProfitCurrency = (@HouseVolumeInCBM / @AllHousesTotalVolumeInCBM) * @ProfitForeignAmount
										end
									END

									-- Percent of Value
									else if (@MasterPayableMeasurementId = @PRVL_Id)
									BEGIN
										set @ProrateAmountInLocalCurrency = (@ExpectedAmountLocal / @MasterPayableExpectedAmount_Local) * @LocalForeignAmount
										set @ProrateAmountInProfitCurrency = (@ExpectedAmountInProfitCurrency / @MasterPayableExpectedAmount_Profit) * @ProfitForeignAmount
									END

									-- Percent of Freight
									else if (@MasterPayableMeasurementId = @PRFR_Id)
									BEGIN
										set @ProrateAmountInLocalCurrency = (@ExpectedAmountLocal / @MasterPayableExpectedAmount_Local) * @LocalForeignAmount
										set @ProrateAmountInProfitCurrency = (@ExpectedAmountInProfitCurrency / @MasterPayableExpectedAmount_Profit) * @ProfitForeignAmount
									END

									-- Percent of Foreign Charges
									else if (@MasterPayableMeasurementId = @PFCL_Id)
									BEGIN
										set @ProrateAmountInLocalCurrency = (@ExpectedAmountLocal / @MasterPayableExpectedAmount_Local) * @LocalForeignAmount
										set @ProrateAmountInProfitCurrency = (@ExpectedAmountInProfitCurrency / @MasterPayableExpectedAmount_Profit) * @ProfitForeignAmount
									END

									-- Quantity
									else if (@MasterPayableMeasurementId = @QTY_Id)
									BEGIN
										if(@HouseTransportModeId = 'A' OR (@HouseTransportModeId = 'O' AND @HouseTypeId = 'LCLD') OR (@HouseTransportModeId = 'I' AND @HouseTypeId = 'LTL'))
										begin
											if (@HouseNumberOfPackages <> 0)
											begin
												set @ProrateAmountInLocalCurrency = (@HouseNumberOfPackages / @AllHousesTotalNumberOfPackages) * @LocalForeignAmount
												set @ProrateAmountInProfitCurrency = (@HouseNumberOfPackages / @AllHousesTotalNumberOfPackages) * @ProfitForeignAmount
											end
										end

										else 
										begin
											if (@HouseNumberOfContainers <> 0)
											begin
												set @ProrateAmountInLocalCurrency = (@HouseNumberOfContainers / @AllHousesTotalNumberOfContainers) * @LocalForeignAmount
												set @ProrateAmountInProfitCurrency = (@HouseNumberOfContainers / @AllHousesTotalNumberOfContainers) * @ProfitForeignAmount
											end 
										end											
									END

									else if ((@MasterTransportModeId = 'O' AND @MasterTypeId = 'FCLD') OR (@MasterTransportModeId = 'I' AND @MasterTypeId = 'FTL'))
									BEGIN
										if(@HouseTransportModeId = 'A' OR (@HouseTransportModeId = 'O' AND @HouseTypeId = 'LCLD') OR (@HouseTransportModeId = 'I' AND @HouseTypeId = 'LTL'))
										begin
											if (@HouseNumberOfPackages <> 0)
											begin
												set @ProrateAmountInLocalCurrency = (@HouseNumberOfPackages / @AllHousesTotalNumberOfPackages) * @LocalForeignAmount
												set @ProrateAmountInProfitCurrency = (@HouseNumberOfPackages / @AllHousesTotalNumberOfPackages) * @ProfitForeignAmount
											end
										end

										else 
										begin
											if (@HouseNumberOfContainers <> 0)
											begin
												set @ProrateAmountInLocalCurrency = (@HouseNumberOfContainers / @AllHousesTotalNumberOfContainers) * @LocalForeignAmount
												set @ProrateAmountInProfitCurrency = (@HouseNumberOfContainers / @AllHousesTotalNumberOfContainers) * @ProfitForeignAmount
											end 
										end											
									END

									else if ((@MasterTransportModeId = 'O' AND @MasterTypeId = 'MyGO') OR (@MasterTransportModeId = 'I' AND @MasterTypeId = 'MyGI'))
									BEGIN
										if (@HouseChargeableWeight <> 0)
										begin
											set @ProrateAmountInLocalCurrency = (@HouseChargeableWeight / @AllHousesTotalChargeableWeight) * @LocalForeignAmount
											set @ProrateAmountInProfitCurrency = (@HouseChargeableWeight / @AllHousesTotalChargeableWeight) * @ProfitForeignAmount
										end
									END

									SET TRANSACTION ISOLATION LEVEL READ COMMITTED;
									BEGIN TRAN T1;
									EXECUTE usp_GetNextTableIdValue @NewProrateId OUTPUT,'PayableProratedAmount'
									COMMIT TRAN T1; 

									INSERT INTO PayableProratedAmounts
									(
									Id,
									Tenant,
									ShipmentId,
									PayableId,
									InvoiceId,
									ProratedAmountInLocalCurrency,
									ProratedAmountInProfitCurrency
									)
									VALUES
									(
									@NewProrateId,
									@Tenant,
									@HouseId,
									@HousePayableId,
									@ProrateInvoiceId,
									isnull(Round(@ProrateAmountInLocalCurrency,3),0),
									isnull(Round(@ProrateAmountInProfitCurrency,3),0)
									)                         
								end 
								
								FETCH NEXT FROM ProrateCursor INTO @LocalForeignAmount, @ProfitForeignAmount, @ProrateInvoiceId

								END				
								CLOSE ProrateCursor
								DEALLOCATE ProrateCursor
								END

								-- Update Payable
								BEGIN
									set @PayableProrateAmountInLocal = (select sum(isnull(ProratedAmountInLocalCurrency,0)) from PayableProratedAmounts where PayableId = @HousePayableId and Tenant = @Tenant)			
									set @PayableProrateAmountInProfit = (select sum(isnull(ProratedAmountInProfitCurrency,0)) from PayableProratedAmounts where PayableId = @HousePayableId and Tenant = @Tenant)			

									update ShipmentPayables
									set									
									ProratedAmountInLocalCurrency = isnull(Round(@PayableProrateAmountInLocal,2),0),
									ProratedAmountInProfitCurrency = isnull(Round(@PayableProrateAmountInProfit,2),0)
									where Id = @HousePayableId and Tenant = @Tenant
								END

						FETCH NEXT FROM HousePayables1Cursor INTO @HousePayableId, @HousePayableLineStatusCode, @ExpectedAmountLocal, @ExpectedAmountInProfitCurrency
						END
						CLOSE HousePayables1Cursor
						DEALLOCATE HousePayables1Cursor
					END

					FETCH NEXT FROM Houses1Cursor INTO @HouseId, @HouseTEU, @HouseVolume, @HouseGrossWeight, @HouseChargeableWeight, @HouseGrossWeightPerTon, @HouseValueOfGoods, @HouseNumberOfPackages, @HouseNumberOfContainers, @HouseTransportModeId, @HouseTypeId, @HouseGrossWeightInKG, @HouseChargeableWeightInKG, @HouseVolumeInCBM, @HouseGrossWeightPerStorageDays
					END
					CLOSE Houses1Cursor
					DEALLOCATE Houses1Cursor
				END

			FETCH NEXT FROM MasterPayables1Cursor INTO @MasterPayableId, @MasterPayableUnitPrice, @MasterPayableMeasurementId, @MasterPayableAmountTypeCode, @MasterPayableExpectedAmount_Local, @MasterPayableExpectedAmount_Profit
			END
			CLOSE MasterPayables1Cursor
			DEALLOCATE MasterPayables1Cursor
		END

FETCH NEXT FROM MastersCursor INTO @MasterId, @Tenant, @MasterTypeId, @MasterTransportModeId
END
CLOSE MastersCursor
DEALLOCATE MastersCursor
END


    
    ]]>
  </Sql>
</Script>