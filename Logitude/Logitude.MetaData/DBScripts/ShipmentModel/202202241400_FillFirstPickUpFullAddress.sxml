<Script DBType="Main" Module="Shipment"  AOT="true" TargetTableName="Shipments" BatchSize="10000" >
  <Sql Version="6">
    <![CDATA[

If(OBJECT_ID('tempdb..#temp') Is Not Null)
Begin
    Drop Table #temp
End

If(OBJECT_ID('tempdb..#temp_Shipment') Is Not Null)
Begin
    Drop Table #temp_Shipment
End

CREATE TABLE #temp_Shipment
(
	Id varchar(15) not null,
	AddressValue nvarchar(200) null
)

select
Shipments.Id,
Shipments.Tenant as Tenant,
Shipments.DirectionId as DirectionId,
Shipments.TransportModeId as TransportModeId,
Shipments.ShipmentLevelCode as ShipmentLevelCode,
Shipments.MasterShipmentDataId as MasterShipmentDataId,
Shipments.FromPortId as HousePortId,

ShipmentMasterDatas.MainCarriageFromPortId as MainCarriagePortId,
ShipmentMasterDatas.InlandDomesticFromTypeCode as InlandDomesticTypeCode,
ShipmentMasterDatas.MainCarriageFromAddressId as MainCarriageAddressId,
ShipmentMasterDatas.MainCarriageFromPortAddress as MainCarriagePortAddress,
ShipmentMasterDatas.InlandDomesticFromZipCode as InlandDomesticZipCode,
ShipmentMasterDatas.InlandDomesticFromCity as InlandDomesticCity,
InlandDomesticCountry.EnglishName as InlandDomesticCountryName,

ShipmentPickUpDeliveries.PickUpDeliveryFromTypeCode as TypeCode,
ShipmentPickUpDeliveries.FromAddressId as AddressId,
ShipmentPickUpDeliveries.FromAddress as PortAddress,
ShipmentPickUpDeliveries.FromAddressZipCode as ZipCode,
ShipmentPickUpDeliveries.FromAddressCity as City,
FromCountry.EnglishName as CountryName

into #temp

from Shipments
left outer join ShipmentMasterDatas on Shipments.MasterShipmentDataId = ShipmentMasterDatas.Id
left outer join ShipmentPickUpDeliveries
on ShipmentPickUpDeliveries.Id = 
(
	select top 1 Id from ShipmentPickUpDeliveries
	where ShipmentPickUpDeliveries.ShipmentId = Shipments.Id 
	and PickUpDeliveryTypeCode = 'PICK' 
	order by PickUpDeliveryNumber asc
)
left outer join Countries as FromCountry on FromCountry.Id = ShipmentPickUpDeliveries.FromAddressCountryId
left outer join Countries as InlandDomesticCountry on InlandDomesticCountry.Id = ShipmentMasterDatas.InlandDomesticFromCountryId
where $LastCounterWhere$

	declare @Id as varchar(15)
	declare @Tenant as int
	declare @TypeCode as varchar(4)
	declare @AddressId as varchar(15)
	declare @PortAddress as varchar(200)
	declare @ZipCode as varchar(40)
	declare @City as varchar(25)
	declare @CountryName as varchar(120)
	declare @DirectionId as varchar(2)
	declare @TransportModeId as varchar(2)
	declare @ShipmentLevelCode as varchar(2)
	declare @MasterShipmentDataId as varchar(15)
	declare @HousePortId as varchar(15)
	declare @MainCarriagePortId as varchar(15)
	declare @InlandDomesticTypeCode as varchar(5)
	declare @MainCarriageAddressId as varchar(15)
	declare @MainCarriagePortAddress as varchar(200)
	declare @InlandDomesticZipCode as varchar(40)
	declare @InlandDomesticCity as varchar(25)
	declare @InlandDomesticCountryName as varchar(120)

	declare @ResultAddress as varchar(200)
	
	declare @Count as int
	set @Count = 0;

	DECLARE DataCursor CURSOR READ_ONLY
	FOR
	SELECT Id, Tenant, TypeCode, AddressId, PortAddress, ZipCode, City, CountryName, DirectionId, TransportModeId, ShipmentLevelCode, MasterShipmentDataId, HousePortId, MainCarriagePortId, InlandDomesticTypeCode, MainCarriageAddressId, MainCarriagePortAddress, InlandDomesticZipCode, InlandDomesticCity, InlandDomesticCountryName
	FROM #temp	
	OPEN DataCursor FETCH NEXT FROM DataCursor INTO @Id, @Tenant, @TypeCode, @AddressId, @PortAddress, @ZipCode, @City, @CountryName, @DirectionId, @TransportModeId, @ShipmentLevelCode, @MasterShipmentDataId, @HousePortId, @MainCarriagePortId, @InlandDomesticTypeCode, @MainCarriageAddressId, @MainCarriagePortAddress, @InlandDomesticZipCode, @InlandDomesticCity, @InlandDomesticCountryName
	WHILE @@FETCH_STATUS = 0
	BEGIN

		set @ResultAddress = NULL

		if(@TypeCode is not null)
		begin

			if (@TypeCode = 'PART')
			begin
				set @ResultAddress = dbo.BuildFullAddressTextFunction(@AddressId, @Tenant);
			end

			else if (@TypeCode = 'CASL')
			begin
				set @ResultAddress = isnull(@City, '') + CASE WHEN @ZipCode IS NULL THEN '' ELSE ' ' + @ZipCode END + CASE WHEN @CountryName IS NULL THEN '' ELSE  + CHAR(13) + @CountryName END
			end

			else if (@TypeCode = 'PORT')
			begin
			   set @ResultAddress = @PortAddress
			end
		end

		else 
		begin
			if(@DirectionId = 'D' and @TransportModeId = 'I')
			begin

				if (@InlandDomesticTypeCode = 'PART')
				begin
					set @ResultAddress = dbo.BuildFullAddressTextFunction(@MainCarriageAddressId, @Tenant);

				end

				else if (@InlandDomesticTypeCode = 'CASL')
				begin
					set @ResultAddress = isnull(@InlandDomesticCity, '') + CASE WHEN @InlandDomesticZipCode IS NULL THEN '' ELSE ' ' + @InlandDomesticZipCode END + CASE WHEN @InlandDomesticCountryName IS NULL THEN '' ELSE  + CHAR(13) + @InlandDomesticCountryName END
				end

				else if (@InlandDomesticTypeCode = 'PORT')
				begin
				   set @ResultAddress = @MainCarriagePortAddress
				end

			end

			else
			begin
				
				if(@ShipmentLevelCode = 'H')
				begin
					if(@MasterShipmentDataId is not null)
					begin
						set @ResultAddress = (select EnglishName from Ports where Id = @MainCarriagePortId and Tenant = @Tenant)
					end

					else 
					begin
						set @ResultAddress = (select EnglishName from Ports where Id = @HousePortId and Tenant = @Tenant)						
					end
				end

				else 
				begin
					set @ResultAddress = (select EnglishName from Ports where Id = @MainCarriagePortId and Tenant = @Tenant)
				end

			end

		end

		insert into #temp_Shipment(Id, AddressValue) values(@Id, @ResultAddress)

		set @Count = @Count + 1;
		if(@Count = 1000)
		begin
			update Shipments
			set
			FirstPickupFullAddress = #temp_Shipment.AddressValue
			FROM Shipments
			INNER JOIN #temp_Shipment
			on Shipments.Id = #temp_Shipment.Id

			truncate table #temp_Shipment
			set @Count = 0
		end
	FETCH NEXT FROM DataCursor INTO  @Id, @Tenant, @TypeCode, @AddressId, @PortAddress, @ZipCode, @City, @CountryName, @DirectionId, @TransportModeId, @ShipmentLevelCode, @MasterShipmentDataId, @HousePortId, @MainCarriagePortId, @InlandDomesticTypeCode, @MainCarriageAddressId, @MainCarriagePortAddress, @InlandDomesticZipCode, @InlandDomesticCity, @InlandDomesticCountryName
	END
	CLOSE DataCursor
	DEALLOCATE DataCursor

	if (@Count > 0)
	begin
			update Shipments
			set
			FirstPickupFullAddress= #temp_Shipment.AddressValue
			FROM Shipments
			INNER JOIN #temp_Shipment
			on Shipments.Id = #temp_Shipment.Id
	end

drop table #temp
drop table #temp_Shipment

    ]]>
  </Sql>
</Script>