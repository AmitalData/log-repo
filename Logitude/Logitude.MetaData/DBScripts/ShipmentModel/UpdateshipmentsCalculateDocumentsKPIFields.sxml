<Script DBType="Main" Module="Shipment" AOT="true" TargetTableName="DocumentsFilings">
  <Sql Version="1">
    <![CDATA[
    
If(OBJECT_ID('tempdb..#temp') Is Not Null)
Begin  Drop Table #temp End
declare @ObjectTableId as VARCHAR(15)   set @ObjectTableId = (select id from ObjectTables where Name = 'Shipment')

select DocumentsFilings.EntityId,DocumentsFilings.DocumentTypeId,
  CASE
       WHEN DocumentsFilings.DirectionCode = 'I' THEN DocumentTypes.OnUploadPopulateDateFieldName
       WHEN DocumentsFilings.DirectionCode = 'O' and DocumentsFilings.DocumentId is not null THEN DocumentTypes.OnPrintPopulateDateFieldName
       ELSE DocumentTypes.OnSendPopulateDateFieldName
 END AS FieldName,
 CASE  WHEN DocumentsFilings.UpdateDate is null THEN DocumentsFilings.CreateDate ELSE DocumentsFilings.UpdateDate END AS FieldValue
 into #temp
 from DocumentsFilings
 inner join DocumentTypes on DocumentTypes.Id = DocumentsFilings.DocumentTypeId
where  (
 CASE WHEN DocumentsFilings.DirectionCode = 'I' THEN DocumentTypes.OnUploadPopulateDateFieldName
 WHEN DocumentsFilings.DirectionCode = 'O' and DocumentsFilings.DocumentId is not null THEN DocumentTypes.OnPrintPopulateDateFieldName
 ELSE DocumentTypes.OnSendPopulateDateFieldName
           END) is not null  and (
 CASE WHEN DocumentsFilings.DirectionCode = 'I' THEN DocumentTypes.OnUploadPopulateDateFieldName
 WHEN DocumentsFilings.DirectionCode = 'O' and DocumentsFilings.DocumentId is not null THEN DocumentTypes.OnPrintPopulateDateFieldName
 ELSE DocumentTypes.OnSendPopulateDateFieldName END) !=''
 and   DocumentsFilings.ObjectTableId =@ObjectTableId and DocumentTypes.ObjectTableId =@ObjectTableId
and  $LastCounterWhere$
	  declare @Id as varchar(15)
       declare @FieldName as VARCHAR(200) 
	   declare @FieldValue as datetime 

	DECLARE DataCursor CURSOR READ_ONLY
	FOR
  
  
  
	SELECT #temp.EntityId,  #temp.FieldName, #temp.FieldValue 
	FROM #temp	
	WHERE FieldValue  IN ( SELECT MAX(FieldValue) FROM #temp GROUP BY EntityId, FieldName, DocumentTypeId) 
    OPEN DataCursor FETCH NEXT FROM DataCursor INTO @Id,@FieldName, @FieldValue
	WHILE @@FETCH_STATUS = 0
	BEGIN
		 declare @functionring as varchar(3000)
		 	declare @TableName varchar(100) 

			set @TableName ='Shipments'


		set @FieldName =  REPLACE(@FieldName,'Shipment.', '');

	  IF COL_LENGTH('ShipmentComputedFields',@FieldName) IS  NULL
	  begin 
	   IF COL_LENGTH('ShipmentComputedFields',REPLACE(@FieldName, 'Date', '')) IS not NULL
	   begin  set @FieldName = REPLACE(@FieldName, 'Date', ''); set @TableName = 'ShipmentComputedFields' end
	  end
	  else set @TableName = 'ShipmentComputedFields'
	 set @functionring = 'update ' +@TableName +' set ' + @FieldName +'= ' + ''''+ CONVERT(varchar, @FieldValue,113) +'''' +'  where id = ' + ''''+ @Id +'''' 
	EXEC(@functionring)

	FETCH NEXT FROM DataCursor  INTO @Id,@FieldName, @FieldValue
	END
	CLOSE DataCursor
	DEALLOCATE DataCursor

     drop table #temp

      
    ]]>
  </Sql>
</Script>



