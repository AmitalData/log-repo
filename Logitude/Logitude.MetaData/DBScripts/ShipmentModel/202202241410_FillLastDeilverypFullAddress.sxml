<Script DBType="Main" Module="Shipment"  AOT="true" TargetTableName="Shipments" BatchSize="10000" >
  <Sql Version="1">
    <![CDATA[

If(OBJECT_ID('tempdb..#temp') Is Not Null)
Begin
    Drop Table #temp
End

If(OBJECT_ID('tempdb..#temp_Shipment') Is Not Null)
Begin
    Drop Table #temp_Shipment
End

CREATE TABLE #temp_Shipment
(
	Id varchar(15) not null,
	[From] nvarchar(200) null,
)

select
Shipments.Id,
Shipments.Tenant as Tenant,
ShipmentPickUpDeliveries.PickUpDeliveryToTypeCode as FromTypeCode,
ShipmentPickUpDeliveries.ToAddressZipCode as FromAddressZipCode,
ShipmentPickUpDeliveries.ToAddressCity as FromAddressCity,
FromCountry.EnglishName as FromAddressCountryName,
FromPort.EnglishName as FromPortName,
FromPort.Code as FromPortCode,
ShipmentPickUpDeliveries.ToPartnerCardId as FromPartnerCardId

into #temp

from Shipments

left outer join ShipmentPickUpDeliveries
on ShipmentPickUpDeliveries.Id = 
(
	select top 1 Id from ShipmentPickUpDeliveries
	where ShipmentPickUpDeliveries.ShipmentId = Shipments.Id 
	and PickUpDeliveryTypeCode = 'DELV' 
	order by PickUpDeliveryNumber desc
)
left outer join Addresses as FromAddress on FromAddress.Id = ShipmentPickUpDeliveries.ToAddressId
left outer join Ports as FromPort on FromPort.Id = ShipmentPickUpDeliveries.ToPortId
left outer join Countries as FromCountry on FromCountry.Id = ShipmentPickUpDeliveries.ToAddressCountryId
where  $LastCounterWhere$


	declare @Id as varchar(15)
	declare @Tenant as int
	declare @FromTypeCode as varchar(4)
	declare @FromPortCode as varchar(4)
	declare @FromAddressCity as nvarchar(25)
	declare @FromPortName as varchar(40)
	declare @FromAddressCountryName as varchar(40)
	declare @FromAddressZipCode as varchar(40)
	declare @From as nvarchar(200)
	declare @FromPartnerCardId as varchar(15)

	declare @Count as int
	set @Count = 0;

	DECLARE DataCursor CURSOR READ_ONLY
	FOR
	SELECT Id,Tenant, FromTypeCode, FromAddressCity, FromPortName,FromPartnerCardId,FromPortCode,FromAddressZipCode,FromAddressCountryName
	FROM #temp	
	OPEN DataCursor FETCH NEXT FROM DataCursor INTO @Id,@Tenant, @FromTypeCode, @FromAddressCity, @FromPortName ,@FromPartnerCardId,@FromPortCode,@FromAddressZipCode,@FromAddressCountryName
	WHILE @@FETCH_STATUS = 0
	BEGIN

		-- From
		if (@FromTypeCode = 'PART')
		begin
			set @From = (Select CONCAT_WS(' ,',CountryName ,StateName,CityName) from Cards where Id = @FromPartnerCardId and Tenant  = @Tenant)
		end

		else if (@FromTypeCode = 'CASL')
		begin
		  set @From = isnull(@FromAddressCountryName+' ,','')+ @FromAddressCity + CASE WHEN @FromAddressZipCode IS NULL THEN '' ELSE ' ,'+@FromAddressZipCode END 
		end

		else if (@FromTypeCode = 'PORT')
		begin
		   set @From = @FromPortCode+' ,'+@FromPortName
		end

		insert into #temp_Shipment(Id, [From]) values(@Id, @From)

		set @Count = @Count + 1;
		if(@Count = 1000)
		begin		
			update Shipments
			set
			LastDeliveryFullAddress = #temp_Shipment.[From]
			FROM Shipments
			INNER JOIN #temp_Shipment
			on Shipments.Id = #temp_Shipment.Id

			truncate table #temp_Shipment
			set @Count = 0
		end
	FETCH NEXT FROM DataCursor INTO  @Id,@Tenant, @FromTypeCode, @FromAddressCity, @FromPortName ,@FromPartnerCardId,@FromPortCode,@FromAddressZipCode,@FromAddressCountryName
	END
	CLOSE DataCursor
	DEALLOCATE DataCursor


	if (@Count > 0)
	begin
			update Shipments
			set
			LastDeliveryFullAddress= #temp_Shipment.[From]
			FROM Shipments
			INNER JOIN #temp_Shipment
			on Shipments.Id = #temp_Shipment.Id
	end

drop table #temp
drop table #temp_Shipment


    ]]>
  </Sql>
</Script>