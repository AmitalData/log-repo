<Script DBType="Main" Module="Shipment" >
  <Sql Version="1">
    <![CDATA[

    update EntityStatus set StatusWeight = 75 where DisplayName = 'export custom clearance'
    update ObjectTableLastUpdates set LastUpdateDate = GETDATE() where ObjectTableId = (select id from ObjectTables where Name = 'StatusWeight')

    ]]>
  </Sql>
</Script>