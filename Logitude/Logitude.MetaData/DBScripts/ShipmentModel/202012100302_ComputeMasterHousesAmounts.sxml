<Script DBType="Main" Module="Shipment" >
  <Sql Version="3">
    <![CDATA[
    

	declare @Counter as int
	declare @Tenant as int
	declare @MasterId as varchar(15)
	set @Counter = 0

	DECLARE MastersCursor CURSOR READ_ONLY
	FOR
	SELECT Id, Tenant
	FROM Shipments
	where ShipmentLevelCode = 'C'
	OPEN MastersCursor FETCH NEXT FROM MastersCursor INTO @MasterId, @Tenant
	WHILE @@FETCH_STATUS = 0
	BEGIN

		set @Counter += 1;

		if(@Counter=1000)
		begin		
			set @Counter = 0
			WAITFOR DELAY '00:00:01'
		end

		EXECUTE usp_UpdateShipmentProfitFunction @Tenant, @MasterId, 1

	FETCH NEXT FROM MastersCursor INTO @MasterId, @Tenant
	END
	CLOSE MastersCursor
	DEALLOCATE MastersCursor


    ]]>
  </Sql>
</Script>