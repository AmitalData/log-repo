<Script DBType="Main" Module="Shipment" AOT="true" TargetTableName="Shipments" Env="Logitude">
  <Sql Version="4">
    <![CDATA[
      If(OBJECT_ID('tempdb..#temp') Is Not Null)
      Begin
       Drop Table #temp
      End

      If(OBJECT_ID('tempdb..#temp_Shipments') Is Not Null)
      Begin
        Drop Table #temp_Shipments
      End

      CREATE TABLE #temp_Shipments(ShipmentId varchar(15) not null,SearchFields nvarchar(4000) null)
      
      select Shipments.Id,Shipments.Tenant,Shipments.MasterShipmentDataId,Shipments.SearchFields
      into #temp
      from Shipments 
	  where  Shipments.ShipmentLevelCode = 'H' and Shipments.MasterShipmentDataId is not null and $LastCounterWhere$
	  declare @Tenant as int
	  declare @MasterId as varchar(15)
	  declare @MasterShipmnetNumber as varchar(20)
	  declare @SearchFields as nvarchar(4000)
	  declare @Id as varchar(15)
	  declare @Count as int
      set @Count = 0;

      BEGIN
            DECLARE DataCursor CURSOR READ_ONLY
            FOR
            SELECT Id,Tenant,MasterShipmentDataId,SearchFields
            FROM #temp
            OPEN DataCursor FETCH NEXT FROM DataCursor INTO @Id, @Tenant,@MasterId, @SearchFields
            WHILE @@FETCH_STATUS = 0
            BEGIN

			set @MasterShipmnetNumber =  (select MasterShipmentNumber from ShipmentMasterDatas where id = @MasterId)

			if(@MasterShipmnetNumber is not null)
			begin
				declare @NewSearchFieldValue nvarchar(4000) = @SearchFields
				set @NewSearchFieldValue = @NewSearchFieldValue + ',' + @MasterShipmnetNumber			
				insert into #temp_Shipments(ShipmentId, SearchFields) values (@Id, @NewSearchFieldValue)
                set @Count = @Count + 1;
			end

            if(@Count = 1000)
            begin
                update Shipments
				set SearchFields = #temp_Shipments.SearchFields 
				FROM Shipments
				INNER JOIN #temp_Shipments
				on Shipments.Id = #temp_Shipments.ShipmentId
				truncate table #temp_Shipments
                set @Count = 0
              end

            FETCH NEXT FROM DataCursor INTO @Id, @Tenant,@MasterId, @SearchFields
            END
            CLOSE DataCursor
            DEALLOCATE DataCursor
       END
              
       if (@Count > 0)
       begin
            update Shipments
            set SearchFields = #temp_Shipments.SearchFields 
            FROM Shipments
            INNER JOIN #temp_Shipments
            on Shipments.Id = #temp_Shipments.ShipmentId
            truncate table #temp_Shipments
        end

    drop table #temp
    drop table #temp_Shipments
    ]]>
  </Sql>
</Script>