<Script DBType="Main" Module="Shipment" AOT="true" TargetTableName="Shipments">
	<Sql Version="1">
		<![CDATA[
       If(OBJECT_ID('tempdb..#temp') Is Not Null)
      Begin
       Drop Table #temp
      End

      If(OBJECT_ID('tempdb..#temp_Shipments') Is Not Null)
      Begin
        Drop Table #temp_Shipments
      End

      CREATE TABLE #temp_Shipments(ShipmentId varchar(15) not null,ExpirationDate datetime null)
      
      select Shipments.Id, Shipments.Tenant, Quotes.ExpirationDate
      into #temp
      from Shipments 
	  left join Quotes on Quotes.Id = Shipments.QuoteId 
	  where Shipments.QuoteId is not null and Shipments.Tenant = Quotes.Tenant and $LastCounterWhere$   
      declare @Tenant as int
      declare @ShipmentId as varchar(15)
      declare @ExpirationDate as datetime
	  declare @Count as int
      set @Count = 0;
      BEGIN
            DECLARE DataCursor CURSOR READ_ONLY
            FOR
            SELECT Id, Tenant, ExpirationDate
            FROM #temp
            OPEN DataCursor FETCH NEXT FROM DataCursor INTO @ShipmentId, @Tenant, @ExpirationDate
            WHILE @@FETCH_STATUS = 0
            BEGIN
                insert into #temp_Shipments(ShipmentId, ExpirationDate) values (@ShipmentId, @ExpirationDate)
                set @Count = @Count + 1;
                if(@Count = 1000)
                begin
                            update Shipments
                            set QuoteFreightExpirationDate = #temp_Shipments.ExpirationDate 
                            FROM Shipments
                            INNER JOIN #temp_Shipments
                            on Shipments.Id = #temp_Shipments.ShipmentId
                            truncate table #temp_Shipments
                            set @Count = 0
                 end

            FETCH NEXT FROM DataCursor INTO @ShipmentId, @Tenant, @ExpirationDate
            END
            CLOSE DataCursor
            DEALLOCATE DataCursor
       END
              
       if (@Count > 0)
       begin
            update Shipments
            set QuoteFreightExpirationDate = #temp_Shipments.ExpirationDate 
            FROM Shipments
            INNER JOIN #temp_Shipments
            on Shipments.Id = #temp_Shipments.ShipmentId
            truncate table #temp_Shipments
        end

    drop table #temp
    drop table #temp_Shipments
     
        ]]>
	</Sql>
</Script>


