<Script DBType="Main" Module="Quote">
  <Sql Version="2">
    <![CDATA[
				If(OBJECT_ID('tempdb..#tempTable') Is Not Null)
				Begin
					Drop Table #tempTable
				End

				If(OBJECT_ID('tempdb..#temp_Quotes') Is Not Null)
				Begin
					Drop Table #temp_Quotes
				End

		CREATE TABLE #temp_Quotes (Id varchar(15) not null , PickupDeliveryVolumetricWeight float, PickupDeliveryChargeableWeight float)
	
		select 
		Id, 
		Tenant,
		Volume,
		VolumeUnitCode,
		GrossWeight,
		GrossWeightUnitCode,
		PickupDeliveryCWeightUnitCode, 
		PickupDeliveryRatio,
		TransportModeId,
		DirectionId


		into #tempTable
		FROM Quotes where StageId in (select id from QuoteStages where code in ('QTCR','QTDR'))
			declare @Tenant as int
				declare @EntityId as varchar(15)
			declare @PickupDelivaryRatio as decimal
			declare @Count as int
			DECLARE @Volume as decimal
			DECLARE @Weight as decimal
			DECLARE @VolumeCBM as decimal
			DECLARE @VolumeKG as decimal
			DECLARE @Volumetric as decimal
			DECLARE @PickupDeliveryChargeableWeight as decimal
			DECLARE @VolumeUnitCode as varchar(3)
			DECLARE @GrossWeightUnitCode as varchar(3)
			DECLARE @PickupDeliveryCWeightUnitCode as varchar(3)
			DECLARE @TransportModeId as varchar(1)
			Declare @GrossWeightKG as decimal
			Declare @GrossWeightInVolumeUnitCode as decimal
			declare @DirectionId as varchar(4)
			declare @Decimal as decimal
			declare @Integer as int

				set @Count = 0;

			BEGIN
				 DECLARE DataCursor CURSOR READ_ONLY
				 FOR
				 SELECT Id, Tenant, Volume,VolumeUnitCode, GrossWeight, GrossWeightUnitCode, PickupDeliveryCWeightUnitCode, PickupDeliveryRatio,TransportModeId, DirectionId 
				 FROM #tempTable
				 OPEN DataCursor FETCH NEXT FROM DataCursor INTO @EntityId, @Tenant, @Volume,@VolumeUnitCode, @Weight,@GrossWeightUnitCode, @PickupDeliveryCWeightUnitCode, @PickupDelivaryRatio, @TransportModeId, @DirectionId
				 WHILE @@FETCH_STATUS = 0
				 BEGIN
				-- Compute VolumeKG
				if (@Volume is NULL)
				begin
					if (@GrossWeightUnitCode = 'KG')
					begin
					set @VolumeKG = Round(@Weight,3)
					end

					else if (@GrossWeightUnitCode = 'LB')
					begin
					set @VolumeKG = Round(@Weight / 2.20458,3)
					end

					else if (@GrossWeightUnitCode = 'MT')
					begin
					set @VolumeKG = Round(@Weight * 1000,3)
					end
				end

				else
				begin
					if (@VolumeUnitCode = 'CBM')
					begin
					set @VolumeCBM = Round(@Volume,3)
					end

					else if (@VolumeUnitCode = 'CBF')
					begin
					set @VolumeCBM = Round(@Volume / 35.31466,3)
					end

					else if (@VolumeUnitCode = 'CBI')
					begin
					set @VolumeCBM = Round(@Volume / 61023.74409,3)
					end

					set @VolumeKG = Round(@VolumeCBM * 1000 / @PickupDelivaryRatio,3)
				end			

				-- Compute PickupDeliveryVolumetric
				if (@PickupDeliveryCWeightUnitCode = 'KG')
				begin
				set @Volumetric = Round(@VolumeKG,3)
				end

				else if (@PickupDeliveryCWeightUnitCode = 'LB')
				begin
				set @Volumetric = Round(@VolumeKG * 2.20458,3)
				end

				else if (@PickupDeliveryCWeightUnitCode = 'MT')
				begin
				set @Volumetric = Round(@VolumeKG / 1000,3)
				end

				-- Compute PickupDeliveryVolumetricWeight
				if (@GrossWeightUnitCode = 'KG')
				begin
				set @GrossWeightKG = Round(@Weight,3)
				end

				else if (@GrossWeightUnitCode = 'LB')
				begin
				set @GrossWeightKG = Round(@Weight * 0.45359237,3)
				end

				else if (@GrossWeightUnitCode = 'MT')
				begin
				set @GrossWeightKG = Round(@Weight * 1000,3)
				end

				if (@PickupDeliveryCWeightUnitCode = 'KG')
				begin
				set @GrossWeightInVolumeUnitCode = Round(@GrossWeightKG,3)
				end

				else if (@PickupDeliveryCWeightUnitCode = 'LB')
				begin
				set @GrossWeightInVolumeUnitCode = Round(@GrossWeightKG * 0.45359237,3)
				end

				else if (@PickupDeliveryCWeightUnitCode = 'MT')
				begin
				set @GrossWeightInVolumeUnitCode = Round(@GrossWeightKG / 1000,3)
				end

				if(@GrossWeightInVolumeUnitCode > @Volumetric)
				begin 
					set @PickupDeliveryChargeableWeight  = @GrossWeightInVolumeUnitCode;
				end
				else
					set @PickupDeliveryChargeableWeight  = @Volumetric;

				if(@PickupDeliveryCWeightUnitCode != 'MT' and @DirectionId = 'E' and @TransportModeId = 'A')
				begin 
						set @Decimal =(@PickupDeliveryChargeableWeight%1)
						set @Integer = cast(@PickupDeliveryChargeableWeight AS int)
			
						 if (@Decimal <= 0.5) 
					 begin
											 set @PickupDeliveryChargeableWeight = @Integer + 0.5;
									 end
					 else 
					 begin
											 set @PickupDeliveryChargeableWeight = @Integer + 1;
									 end
				end

				-- insert values in temp table 
       			insert into #temp_Quotes(Id, PickupDeliveryVolumetricWeight, PickupDeliveryChargeableWeight) values (@EntityId, @Volumetric, @PickupDeliveryChargeableWeight)
       			
				set @Count = @Count + 1;
				if(@Count = 4000)
				begin 
					update Quotes
					set
					PickupDeliveryVolumetricWeight = #temp_Quotes.PickupDeliveryVolumetricWeight
					FROM Quotes
					INNER JOIN #temp_Quotes
					on Quotes.Id = #temp_Quotes.Id

					truncate table #temp_Quotes

					WAITFOR DELAY '00:00:01'
					set @Count = 0
				end
		
				 FETCH NEXT FROM DataCursor INTO @EntityId, @Tenant, @Volume,@VolumeUnitCode, @Weight,@GrossWeightUnitCode, @PickupDeliveryCWeightUnitCode, @PickupDelivaryRatio, @TransportModeId, @DirectionId 
				 END
				 CLOSE DataCursor
				 DEALLOCATE DataCursor
			END

		if (@Count > 0)
		begin
			update Quotes
			set
			PickupDeliveryVolumetricWeight = #temp_Quotes.PickupDeliveryVolumetricWeight
			FROM Quotes
			INNER JOIN #temp_Quotes
			on Quotes.Id = #temp_Quotes.Id
		end

		drop table #tempTable
		drop table #temp_Quotes

    ]]>
  </Sql>
</Script>




