
<Script DBType="Main" Module="Quote" AOT="true" TargetTableName="Quotes">
  <Sql Version="1">
    <![CDATA[

    update Quotes set InlandDomesticFromTypeCode = 'PART', InlandDomesticToTypeCode = 'PART'
    where $LastCounterWhere$ and  DirectionId = 'D' and TransportModeId = 'I'

    ]]>
  </Sql>
</Script>
