<Script DBType="Main">
  <Sql Version="2">
    <![CDATA[
    
     if exists (SELECT * FROM sys.tables WHERE name='QuoteClosingReasons')
     begin
      update Quotes 
      set QuoteClosingReasonId = (select Id from QuoteClosingReasons where Code = Quotes.QuoteClosingReasonCode and Tenant = Quotes.Tenant )
     End
      
    ]]>
  </Sql>
</Script>

