<Script DBType="Main" Pre="true">
  <Sql Version="1">
    <![CDATA[
    
     if exists (SELECT * FROM sys.indexes WHERE name='IX_Quotes_QuoteClosingReasonId' AND object_id = OBJECT_ID('Quotes'))
     begin
        drop index IX_Quotes_QuoteClosingReasonId on Quotes;
     end 
     
     If COL_LENGTH('Quotes', 'Drop_QuoteClosingReasonId') IS NOT NULL
     begin
        alter table Quotes drop column Drop_QuoteClosingReasonId;
      end
      
     if exists (SELECT * FROM INFORMATION_SCHEMA.REFERENTIAL_CONSTRAINTS WHERE CONSTRAINT_NAME ='FK_Quotes_QuoteClosingReasons_QuoteClosingReasonId')
     begin
        alter table quotes drop constraint FK_Quotes_QuoteClosingReasons_QuoteClosingReasonId
      end
     
     if exists (SELECT * FROM INFORMATION_SCHEMA.REFERENTIAL_CONSTRAINTS WHERE CONSTRAINT_NAME ='FK_dbo.Quotes_dbo.QuoteClosingReasons_QuoteClosingReasonCode')
     begin
        alter table quotes drop constraint [FK_dbo.Quotes_dbo.QuoteClosingReasons_QuoteClosingReasonCode]
      end
      
      
     if exists (SELECT * FROM sys.tables WHERE name='QuoteClosingReasons')
     begin
        drop table QuoteClosingReasons;
     end            
     
    ]]>
  </Sql>
</Script>