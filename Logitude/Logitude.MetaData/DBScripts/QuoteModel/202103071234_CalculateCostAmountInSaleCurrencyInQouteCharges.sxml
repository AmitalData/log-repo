
<Script DBType="Main" Module="Quote" AOT="true" TargetTableName="QuoteCharges">
  <Sql Version="1">
    <![CDATA[
    Update QuoteCharges  
      set  CostAmountInSaleCurrency = CASE
      WHEN CostCurrencyId = SaleCurrencyId 
      THEN  CostTotalAmount ELSE 
      (CostTotalAmountLocal/SaleExchangeRate) END
      where $LastCounterWhere$
    ]]>
  </Sql>
</Script>




