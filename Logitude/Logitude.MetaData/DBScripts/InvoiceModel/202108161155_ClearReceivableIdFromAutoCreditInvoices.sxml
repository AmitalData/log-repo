<Script DBType="Main" Module="Invoice" AOT="true" TargetTableName="ARInvoices">
  <Sql Version="1">
    <![CDATA[
    
			declare @Tenant as int
	    declare @InvoiceId as varchar(15)

			DECLARE InvoicesCursor CURSOR READ_ONLY
			FOR
			SELECT Id, Tenant
			FROM ARInvoices
			WHERE (StatusCode = 'AC' OR StatusCode = 'AR') and $LastCounterWhere$
			OPEN InvoicesCursor FETCH NEXT FROM InvoicesCursor INTO @InvoiceId, @Tenant
			WHILE @@FETCH_STATUS = 0
			BEGIN

					update ARInvoiceLines set ReceivableId = null where Tenant = @Tenant AND ARInvoiceId = @InvoiceId

			FETCH NEXT FROM InvoicesCursor INTO @InvoiceId, @Tenant
			END
			CLOSE InvoicesCursor
			DEALLOCATE InvoicesCursor

    ]]>
  </Sql>
</Script>

