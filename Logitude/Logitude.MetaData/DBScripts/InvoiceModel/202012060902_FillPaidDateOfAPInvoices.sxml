<Script DBType="Main" Module="Invoice" AOT="true" TargetTableName="APInvoices">
  <Sql Version="2">
    <![CDATA[
		If(OBJECT_ID('tempdb..#temp') Is Not Null)
		Begin
				Drop Table #temp
		End

		If(OBJECT_ID('tempdb..#temp_Invoices') Is Not Null)
		Begin
				Drop Table #temp_Invoices
		End

		CREATE TABLE #temp_Invoices
		(
		APInvoiceId varchar(15) not null,
		PaidDate datetime null
		)
			select
			APInvoices.Id,
			APInvoices.Tenant
			into #temp
			from APInvoices
			where
				PaidDate is null and APInvoices.AmountDue = 0
				and APInvoices.StatusCode = 'PD' and $LastCounterWhere$

			declare @Tenant as int
			declare @APInvoiceId as varchar(15)
			declare @Count as int
			declare @PaidDate as datetime
			declare @Notes as nvarchar(4000)
			declare @PaymentNo as nvarchar(4000)
			set @Count = 0;
			BEGIN
				DECLARE DataCursor CURSOR READ_ONLY
				FOR
				SELECT Id, Tenant
				FROM #temp
				OPEN DataCursor FETCH NEXT FROM DataCursor INTO @APInvoiceId, @Tenant
				WHILE @@FETCH_STATUS = 0
				BEGIN

				set @Notes =  (select top 1 notes from TraceEvents where 
                       ObjectTableId = (select Id from objecttables where name = 'apinvoice')
                       and EntityId = @APInvoiceId
                       and Tenant = @Tenant
                       and EventTypeId = (select id from EventTypes where code = 'COIN' and tenant = @Tenant ) 
                       order by LogDateTime desc)
                       
          IF (@Notes IS NOT NULL)
	        BEGIN
					set @PaymentNo = REPLACE (@Notes, 'Connected with Payment: ','');
					set @PaymentNo = REPLACE(@PaymentNo, ' with Amount Due equals to: 0','')

					set @PaidDate = (select ValueDate from APPayments where PaymentNo = @PaymentNo and  Tenant = @Tenant)
       				insert into #temp_Invoices(APInvoiceId, PaidDate) values (@APInvoiceId, @PaidDate)
       			
					set @Count = @Count + 1;
					if(@Count = 1000)
	    			begin
						update APInvoices
						set PaidDate = #temp_Invoices.PaidDate 
						FROM APInvoices
						INNER JOIN #temp_Invoices
						on APInvoices.Id = #temp_Invoices.APInvoiceId
						truncate table #temp_Invoices
						set @Count = 0
					end

				End

				FETCH NEXT FROM DataCursor INTO @APInvoiceId,  @Tenant
				END
				CLOSE DataCursor
				DEALLOCATE DataCursor
			  END
		
			if (@Count > 0)
			begin
					update APInvoices
					set
					PaidDate = #temp_Invoices.PaidDate 
					FROM APInvoices
					INNER JOIN #temp_Invoices
					on APInvoices.Id = #temp_Invoices.APInvoiceId
			end

		drop table #temp
		drop table #temp_Invoices

    ]]>
  </Sql>
</Script>
