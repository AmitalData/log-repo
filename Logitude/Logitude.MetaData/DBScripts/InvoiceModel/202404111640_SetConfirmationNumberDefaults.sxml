<Script DBType="Main" Module="Invoice" AOT="true" TargetTableName="ConfirmationNumberDefaults">
  <Sql Version="1">
    <![CDATA[
    
declare @myList table (FROMDATE DATETIME,AmountForConfirmationNumber INT)
insert into @myList values ('01-01-2024',999999999), ('05-05-2024',4250), ('01-01-2025',3600), ('01-01-2026',2700),('01-01-2027',1800)
  Declare @AmountForConfirmationNumber Integer  
  Declare @FromDate datetime

    While exists (Select * From @myList)
	BEGIN
	         SELECT TOP 1 @FromDate = FROMDATE, @AmountForConfirmationNumber = AmountForConfirmationNumber
                FROM @myList
                 ORDER BY FROMDATE ASC;

          INSERT INTO ConfirmationNumberDefaults(Tenant,
                                                 FROMDATE,
                                                 AmountForConfirmationNumber,
                                                 SearchFields,
                                                 Id)
          SELECT    
               T.Id,
               @FromDate,
                @AmountForConfirmationNumber,
                NULL,
                ('1-'+CONVERT (VARCHAR,(select  max(CONVERT(int,SUBSTRING(id,3,LEN(ID)))) from CONFIRMATIONNUMBERDEFAULTS ) +ROW_NUMBER() OVER (ORDER BY ID desc) ))
          FROM (
              SELECT ID
              FROM TENANTS
              ) T
          WHERE NOT EXISTS (
               SELECT *
               FROM ConfirmationNumberDefaults
               WHERE cast(FromDate as Date)=@FromDate and  TENANT = T.ID
               );

      Delete from @myList Where AmountForConfirmationNumber = @AmountForConfirmationNumber
	        Delete from @myList Where FROMDATE = @FromDate

	  END
			

    ]]>
  </Sql>
</Script>


