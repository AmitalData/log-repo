<Script DBType="Main" Module="Invoice" AOT="true" TargetTableName="ARPayments">
  <Sql Version="2">
    <![CDATA[  
		  If(OBJECT_ID('tempdb..#temp') Is Not Null)
      Begin
       Drop Table #temp
      End

      If(OBJECT_ID('tempdb..#temp_Payments') Is Not Null)
      Begin
        Drop Table #temp_Payments
      End

      CREATE TABLE #temp_Payments(ARPaymentId varchar(15) not null,SearchFields nvarchar(MAX) not null)
      
      select Id,Tenant,PrintNotes,SearchFields
      into #temp
      from ARPayments where PrintNotes is not null and $LastCounterWhere$
      declare @Tenant as int
      declare @ARPaymentId as varchar(15)
			declare @PrintNotes as nvarchar(250)
      declare @MySearchFields as nvarchar(MAX)
			declare @Count as int
      set @Count = 0;
                BEGIN
                    DECLARE DataCursor CURSOR READ_ONLY
                    FOR
                    SELECT Id, Tenant, PrintNotes, SearchFields
                    FROM #temp
                    OPEN DataCursor FETCH NEXT FROM DataCursor INTO @ARPaymentId, @Tenant, @PrintNotes, @MySearchFields
                    WHILE @@FETCH_STATUS = 0
                    BEGIN
                          set @MySearchFields = @MySearchFields +',' + @PrintNotes;
                          insert into #temp_Payments(ARPaymentId, SearchFields) values (@ARPaymentId, @MySearchFields)
                          set @Count = @Count + 1;
                          if(@Count = 1000)
                    begin
                                  update ARPayments
                                  set SearchFields = #temp_Payments.SearchFields 
                                  FROM ARPayments
                                  INNER JOIN #temp_Payments
                                  on ARPayments.Id = #temp_Payments.ARPaymentId
                                  truncate table #temp_Payments
                                  set @Count = 0
                          end

                    FETCH NEXT FROM DataCursor INTO @ARPaymentId, @Tenant, @PrintNotes, @MySearchFields
                    END
                    CLOSE DataCursor
                    DEALLOCATE DataCursor
              END
              
              if (@Count > 0)
              begin
                    update ARPayments
                    set
                    SearchFields = #temp_Payments.SearchFields 
                    FROM ARPayments
                    INNER JOIN #temp_Payments
                    on ARPayments.Id = #temp_Payments.ARPaymentId
              end

        drop table #temp
        drop table #temp_Payments
    ]]>
  </Sql>
</Script>
