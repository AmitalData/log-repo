<Script DBType="Main" Module="Invoice" AOT="true" TargetTableName="ARInvoices">
	<Sql Version="2">
    <![CDATA[
			If(OBJECT_ID('tempdb..#temp') Is Not Null)
		Begin
		Drop Table #temp
		End

		If(OBJECT_ID('tempdb..#temp_ARInvoices') Is Not Null)
		Begin
		Drop Table #temp_ARInvoices
		End

        CREATE TABLE #temp_ARInvoices(ARInvoiceId varchar(15) not null,PaidStatus nvarchar(40) null)

        SELECT ARInvoices.Id,ARInvoices.Tenant, ARInvoices.StatusCode, ARInvoices.AmountDue, ARInvoicePayments.ARInvoiceId
	    into #temp
		FROM ARInvoices 
		left outer join ARInvoicePayments	
		on ARInvoicePayments.Id = 
		(
			select top 1 Id from ARInvoicePayments
			where Tenant = ARInvoices.Tenant AND ARInvoiceId = ARInvoices.Id
		)
		where  $LastCounterWhere$   
		declare @Tenant as int
		declare @Id as varchar(15)
		declare @ARInvoicePaymentId as varchar(15)
		declare @Count as int
		declare @PaidStatus as nvarchar(40)
		declare @StatusCode as nvarchar(2)
		declare @AmountDue as float
		set @Count = 0;

		BEGIN
		DECLARE InvoicesCursor CURSOR READ_ONLY
		FOR
		SELECT Id,Tenant, StatusCode, AmountDue, ARInvoiceId
		FROM #temp
		OPEN InvoicesCursor FETCH NEXT FROM InvoicesCursor INTO @Id, @Tenant, @StatusCode, @AmountDue, @ARInvoicePaymentId       
		WHILE @@FETCH_STATUS = 0
		BEGIN
			set @PaidStatus = null;
			if(@StatusCode = 'PP')
			begin
			   set @PaidStatus = 'Partially Paid';
			end

			if(@StatusCode = 'PD')
			begin
			   set @PaidStatus = 'Paid';
			end

			if(@StatusCode = 'AD')
			begin
			   set @PaidStatus = 'Unpaid';
			end
	    
			if(@StatusCode = 'AC' Or @StatusCode = 'CN' or @StatusCode = 'NT')
			begin
				if (@ARInvoicePaymentId is null)
				begin
					set @PaidStatus = 'Unpaid';
				end
				else 
				begin 
					if (@AmountDue = 0)
					begin
						 set @PaidStatus = 'Paid';
					end

					else if (@AmountDue > 0)
					begin
						set @PaidStatus = 'Partially Paid'
					end
				end
			end

			insert into #temp_ARInvoices(ARInvoiceId, PaidStatus) values (@Id, @PaidStatus)
			set @Count = @Count + 1;
			if(@Count = 1000)
			begin
				update ARInvoices
				set PaidStatus = #temp_ARInvoices.PaidStatus 
				FROM ARInvoices
				INNER JOIN #temp_ARInvoices
				on ARInvoices.Id = #temp_ARInvoices.ARInvoiceId
				truncate table #temp_ARInvoices
				set @Count = 0
			 end
		FETCH NEXT FROM InvoicesCursor INTO @Id, @Tenant, @StatusCode, @AmountDue, @ARInvoicePaymentId                 
		END
		CLOSE InvoicesCursor
		DEALLOCATE InvoicesCursor
	END
    
    if (@Count > 0)
    begin
        update ARInvoices
        set PaidStatus = #temp_ARInvoices.PaidStatus 
        FROM ARInvoices
        INNER JOIN #temp_ARInvoices
        on ARInvoices.Id = #temp_ARInvoices.ARInvoiceId
        truncate table #temp_ARInvoices
    end

    drop table #temp
    drop table #temp_ARInvoices
		
    ]]>
  </Sql>
</Script>
