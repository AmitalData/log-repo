<Script DBType="Main" Module="Invoice" AOT="true" TargetTableName="ARInvoices">
	<Sql Version="2">
    <![CDATA[
				If(OBJECT_ID('tempdb..#temp') Is Not Null)
		Begin
		Drop Table #temp
		End

		If(OBJECT_ID('tempdb..#temp_ARInvoices') Is Not Null)
		Begin
		Drop Table #temp_ARInvoices
		End

        CREATE TABLE #temp_ARInvoices(ARInvoiceId varchar(15) not null,PaidStatus nvarchar(40) null)

        SELECT ARInvoices.Id,ARInvoices.Tenant, ARInvoices.StatusCode, ARInvoices.AmountDue, ARInvoicePayments.ARInvoiceId, IsConstituentInvoice, ConsolidationInvoiceId
	    into #temp
		FROM ARInvoices
		left outer join ARInvoicePayments	
		on ARInvoicePayments.Id = 
		(
			select top 1 Id from ARInvoicePayments
			where Tenant = ARInvoices.Tenant AND ARInvoiceId = ARInvoices.Id
		) 
	    where $LastCounterWhere$   
		declare @Tenant as int
		declare @Id as varchar(15)
		declare @ARInvoicePaymentId as varchar(15)
		declare @ConstituentARInvoicePaymentId as varchar(15)
		declare @Count as int
		declare @PaidStatus as nvarchar(40)
		declare @StatusCode as nvarchar(2)
		declare @AmountDue as float
		declare @ConstituentAmountDue as float
		declare @IsConstituentInvoice as bit
		declare @ConsolidationInvoiceId as varchar(15)

		set @Count = 0;

		BEGIN
		DECLARE InvoicesCursor CURSOR READ_ONLY
		FOR
		SELECT Id,Tenant, StatusCode, AmountDue, ARInvoiceId, IsConstituentInvoice, ConsolidationInvoiceId
		FROM #temp
		OPEN InvoicesCursor FETCH NEXT FROM InvoicesCursor INTO @Id, @Tenant, @StatusCode, @AmountDue, @ARInvoicePaymentId, @IsConstituentInvoice, @ConsolidationInvoiceId    
		WHILE @@FETCH_STATUS = 0
		BEGIN
			set @PaidStatus = null;


			    if (@IsConstituentInvoice = 1)
				BEGIN 
						DECLARE ConstituentsCursor CURSOR READ_ONLY
						FOR
						SELECT ARInvoicePayments.ARInvoiceId, AmountDue
						FROM ARInvoices
						left outer join ARInvoicePayments	
						on ARInvoicePayments.Id = 
						(
							select top 1 Id from ARInvoicePayments
							where Tenant = ARInvoices.Tenant AND ARInvoiceId = ARInvoices.Id
						) 
						where  ARInvoices.Tenant = @Tenant and ARInvoices.Id = @ConsolidationInvoiceId
						OPEN ConstituentsCursor FETCH NEXT FROM ConstituentsCursor INTO @ConstituentARInvoicePaymentId, @ConstituentAmountDue
						WHILE @@FETCH_STATUS = 0
							BEGIN
							if (@ConstituentARInvoicePaymentId is null)
							begin
								set @PaidStatus = 'Unpaid';
							end
							else 
							begin 
								if (@ConstituentAmountDue = 0)
								begin
									set @PaidStatus = 'Paid';
								end

								else if (@ConstituentAmountDue > 0)
								begin
									set @PaidStatus = 'Partially Paid'
								end
							end
							FETCH NEXT FROM ConstituentsCursor INTO @ConstituentARInvoicePaymentId, @ConstituentAmountDue
							END
						CLOSE ConstituentsCursor
						DEALLOCATE ConstituentsCursor
				END
				
				else 
				BEGIN
				if(@StatusCode = 'PP')
				begin
				   set @PaidStatus = 'Partially Paid';
				end

				if(@StatusCode = 'PD')
				begin
				   set @PaidStatus = 'Paid';
				end

				if(@StatusCode = 'AD')
				begin
				   set @PaidStatus = 'Unpaid';
				end
	    
				if(@StatusCode = 'AC' Or @StatusCode = 'CN' or @StatusCode = 'NT')
				begin
					if (@ARInvoicePaymentId is null)
					begin
						set @PaidStatus = 'Unpaid';
					end
					else 
					begin 
						if (@AmountDue = 0)
						begin
							 set @PaidStatus = 'Paid';
						end

						else if (@AmountDue > 0)
						begin
							set @PaidStatus = 'Partially Paid'
						end
					end
				end
            END

			insert into #temp_ARInvoices(ARInvoiceId, PaidStatus) values (@Id, @PaidStatus)
			set @Count = @Count + 1;
			if(@Count = 1000)
			begin
				update ARInvoices
				set PaidStatus = #temp_ARInvoices.PaidStatus 
				FROM ARInvoices
				INNER JOIN #temp_ARInvoices
				on ARInvoices.Id = #temp_ARInvoices.ARInvoiceId
				truncate table #temp_ARInvoices
				set @Count = 0
			 end
		FETCH NEXT FROM InvoicesCursor INTO @Id, @Tenant, @StatusCode, @AmountDue, @ARInvoicePaymentId, @IsConstituentInvoice, @ConsolidationInvoiceId          
		END
		CLOSE InvoicesCursor
		DEALLOCATE InvoicesCursor
	END
    
    if (@Count > 0)
    begin
        update ARInvoices
        set PaidStatus = #temp_ARInvoices.PaidStatus 
        FROM ARInvoices
        INNER JOIN #temp_ARInvoices
        on ARInvoices.Id = #temp_ARInvoices.ARInvoiceId
        truncate table #temp_ARInvoices
    end

    drop table #temp
    drop table #temp_ARInvoices
		
    ]]>
  </Sql>
</Script>
