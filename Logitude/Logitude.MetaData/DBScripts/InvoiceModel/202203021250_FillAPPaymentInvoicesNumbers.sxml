<Script DBType="Main" Module="Invoice" AOT="true" TargetTableName="APPayments">
  <Sql Version="1">
    <![CDATA[
    
declare @PaymentId as varchar(15)
declare @Tenant as int
declare @ConnectedInvoicesNumbers as varchar(1000)
declare @SavedInvoicesNumbers as varchar(1000)
declare @InvoicesCount as int

BEGIN 
		DECLARE PaymentsCursor CURSOR READ_ONLY
		FOR
		SELECT Id, Tenant
		FROM APPayments
		where  OpenAmount != AmountInPaymentCurrency and $LastCounterWhere$
		OPEN PaymentsCursor FETCH NEXT FROM PaymentsCursor INTO @PaymentId, @Tenant
		WHILE @@FETCH_STATUS = 0
			BEGIN

				set @ConnectedInvoicesNumbers = ''
				set @SavedInvoicesNumbers = ''
				set @InvoicesCount = (select COUNT(*) from APInvoicePayments where APPaymentId = @PaymentId and Tenant = @Tenant)
				
				if (@InvoicesCount > 0)
				begin
					
					declare @InvoiceId as varchar(15)
					declare @InvoiceNumber as varchar(20)

					BEGIN 
							DECLARE APInvoicePaymentsCursor CURSOR READ_ONLY
							FOR
							SELECT APInvoiceId
							FROM APInvoicePayments
							where Tenant = @Tenant and APPaymentId = @PaymentId
							OPEN APInvoicePaymentsCursor FETCH NEXT FROM APInvoicePaymentsCursor INTO @InvoiceId 
							WHILE @@FETCH_STATUS = 0
								BEGIN

									set @InvoiceNumber = (select InvoiceNumber from APInvoices where Id = @InvoiceId and Tenant = @Tenant)									
									
									if (@ConnectedInvoicesNumbers = '') set @ConnectedInvoicesNumbers = @InvoiceNumber
									else set @ConnectedInvoicesNumbers = @ConnectedInvoicesNumbers + ', ' + @InvoiceNumber											

									
								FETCH NEXT FROM APInvoicePaymentsCursor INTO @InvoiceId
								END
							CLOSE APInvoicePaymentsCursor
							DEALLOCATE APInvoicePaymentsCursor
					END
				end

				if(LEN(@ConnectedInvoicesNumbers) > 1000)				
					set @SavedInvoicesNumbers = SUBSTRING(@ConnectedInvoicesNumbers, 1, 1000)				

				else 
					set @SavedInvoicesNumbers = @ConnectedInvoicesNumbers
				
				update APPayments set ConnectedInvoicesNumbers = @SavedInvoicesNumbers where Id = @PaymentId and Tenant = @Tenant

			FETCH NEXT FROM PaymentsCursor INTO @PaymentId, @Tenant
			END
		CLOSE PaymentsCursor
		DEALLOCATE PaymentsCursor
END

    ]]>
  </Sql>
</Script>
