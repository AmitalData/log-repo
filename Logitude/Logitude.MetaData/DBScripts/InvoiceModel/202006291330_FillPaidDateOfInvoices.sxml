<Script DBType="Main" Pre="true">
  <Sql Version="1">
    <![CDATA[
		If(OBJECT_ID('tempdb..#temp') Is Not Null)
		Begin
				Drop Table #temp
		End

		If(OBJECT_ID('tempdb..#temp_Invoices') Is Not Null)
		Begin
				Drop Table #temp_Invoices
		End

		CREATE TABLE #temp_Invoices
		(
		ARInvoiceId varchar(15) not null,
		PaidDate datetime null
		)
			select
			ARInvoices.Id,
			TraceEvents.Notes as Notes,
			ARInvoices.Tenant
			into #temp
			from ARInvoices
			left outer join TraceEvents on TraceEvents.Id =  (
				select top 1 Id from TraceEvents
				where EntityId = ARInvoices.Id 
				and Notes like '%with Amount Due equals to: 0%' 
				order by LogDateTime desc)
			where
				ARInvoices.AmountDue = 0
				and ARInvoices.StatusCode = 'PD'

			declare @Tenant as int
			declare @ARInvoiceId as varchar(15)
			declare @Count as int
			declare @PaidDate as datetime
			declare @Notes as nvarchar(4000)
			declare @PaymentNo as nvarchar(4000)
			set @Count = 0;
			BEGIN
				DECLARE DataCursor CURSOR READ_ONLY
				FOR
				SELECT Id, Notes, Tenant
				FROM #temp
				OPEN DataCursor FETCH NEXT FROM DataCursor INTO @ARInvoiceId, @Notes, @Tenant
				WHILE @@FETCH_STATUS = 0
				BEGIN
					set @PaymentNo = REPLACE (@Notes, 'Connected with Payment: ','');
					set @PaymentNo = REPLACE(@PaymentNo, ' with Amount Due equals to: 0','')

					set @PaidDate = (select ValueDate from ARPayments where PaymentNo = @PaymentNo and  Tenant = @Tenant)
       				insert into #temp_Invoices(ARInvoiceId, PaidDate) values (@ARInvoiceId, @PaidDate)
       			
					set @Count = @Count + 1;
					if(@Count = 1000)
	    			begin print @Count
						update ARInvoices
						set PaidDate = #temp_Invoices.PaidDate 
						FROM ARInvoices
						INNER JOIN #temp_Invoices
						on ARInvoices.Id = #temp_Invoices.ARInvoiceId
						truncate table #temp_Invoices
						set @Count = 0
					end

				FETCH NEXT FROM DataCursor INTO @ARInvoiceId, @Notes,  @Tenant
				END
				CLOSE DataCursor
				DEALLOCATE DataCursor
			END
		
			if (@Count > 0)
			begin
					update ARInvoices
					set
					PaidDate = #temp_Invoices.PaidDate 
					FROM ARInvoices
					INNER JOIN #temp_Invoices
					on ARInvoices.Id = #temp_Invoices.ARInvoiceId
			end

		drop table #temp
		drop table #temp_Invoices
    ]]>
  </Sql>
</Script>
