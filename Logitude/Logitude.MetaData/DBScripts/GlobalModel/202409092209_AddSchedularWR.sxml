<Script DBType="Global" Module="Global">
  <Sql Version="1">
    <![CDATA[

IF NOT EXISTS (SELECT * FROM BatchServicesDefinitions WHERE code = 'SchedularWR')
BEGIN
	insert into BatchServicesDefinitions (code, classname, USERABBITMQ, QueueDefinitionCode)
  values ('SchedularWR', 'SchedularWorkerRole', 0, 'SchedularQueue');
	
  insert into BatchServicesDefinitionMods (code, inactive, numberofthreads)
  values ('SchedularWR', 0 , 1);
END

    ]]>
  </Sql>
</Script>