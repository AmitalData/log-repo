<Script DBType="Global" Module="Global">
  <Sql Version="1">
    <![CDATA[
    
       if not exists (select * from AnalyzeQueueStatus where Code = 'I')
              begin                     
                     
                     insert into AnalyzeQueueStatus(Code, Name)
                     values('I', 'In Progress')
              end  
      
    ]]>
  </Sql>
</Script>

