<Script DBType="Global" Module="Global">
  <Sql Version="1">
    <![CDATA[

IF NOT EXISTS (SELECT * FROM BatchServicesDefinitions WHERE code = 'ReportExecutionLogWR')
BEGIN
	insert into BatchServicesDefinitions (code, classname, USERABBITMQ)
  values ('ReportExecutionLogWR', 'ReportExecutionLogWorkerRole', 0);
	
  insert into BatchServicesDefinitionMods (code, inactive, numberofthreads)
  values ('ReportExecutionLogWR', 0 , 1);
END

    ]]>
  </Sql>
</Script>