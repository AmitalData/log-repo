<Script DBType="Global" Module="Global">
  <Sql Version="1">
    <![CDATA[
     
if((select count(*) from [dbo].[BatchServicesDefinitions] where [Code] = 'Workflow_WorkflowEngineWorker') = 0)
begin

INSERT INTO [dbo].[BatchServicesDefinitions]
           ([Code]
           ,[ClassName]
           ,[Parameter1]
           ,[Parameter2]
           ,[QueueDefinitionCode])
     VALUES
           ('Workflow_WorkflowEngineWorker'
           ,'Workflow_WorkflowEngineWorker'
           ,NULL
           ,NULL
           ,'WorkflowEntity')

end;
else
begin

update [dbo].[BatchServicesDefinitions] set
            [Code] = 'Workflow_WorkflowEngineWorker'
           ,[ClassName] = 'Workflow_WorkflowEngineWorker'
           ,[Parameter1] = NULL
           ,[Parameter2] = NULL
           ,[QueueDefinitionCode] = 'WorkflowEntity'
where [Code] = 'Workflow_WorkflowEngineWorker';

end;


---------------------------------------------------------------------------------------------------------------

if((select count(*) from [dbo].[BatchServicesDefinitionMods] where [Code] = 'Workflow_WorkflowEngineWorker') = 0)
begin

INSERT INTO [dbo].[BatchServicesDefinitionMods]
           ([Code]
           ,[InActive]
           ,[NumberOfThreads])
     VALUES
           ('Workflow_WorkflowEngineWorker'
           ,0
           ,4)

end;
else
begin

update [dbo].[BatchServicesDefinitionMods] set 
			[Code] = 'Workflow_WorkflowEngineWorker'
			,[InActive] = 0
			,[NumberOfThreads] = 4
where [Code] = 'Workflow_WorkflowEngineWorker';

end;

    ]]>
  </Sql>
</Script>