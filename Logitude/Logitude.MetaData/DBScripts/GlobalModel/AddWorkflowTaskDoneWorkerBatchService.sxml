<Script DBType="Global" Module="Global">
  <Sql Version="1">
    <![CDATA[
     
if((select count(*) from [dbo].[BatchServicesDefinitions] where [Code] = 'Workflow_TaskDoneWorker') = 0)
begin

INSERT INTO [dbo].[BatchServicesDefinitions]
           ([Code]
           ,[ClassName]
           ,[Parameter1]
           ,[Parameter2]
           ,[QueueDefinitionCode])
     VALUES
           ('Workflow_TaskDoneWorker'
           ,'Workflow_TaskDoneWorker'
           ,NULL
           ,NULL
           ,'TaskDone')

end;
else
begin

update [dbo].[BatchServicesDefinitions] set
            [Code] = 'Workflow_TaskDoneWorker'
           ,[ClassName] = 'Workflow_TaskDoneWorker'
           ,[Parameter1] = NULL
           ,[Parameter2] = NULL
           ,[QueueDefinitionCode] = 'TaskDone'
where [Code] = 'Workflow_TaskDoneWorker';

end;


---------------------------------------------------------------------------------------------------------------

if((select count(*) from [dbo].[BatchServicesDefinitionMods] where [Code] = 'Workflow_TaskDoneWorker') = 0)
begin

INSERT INTO [dbo].[BatchServicesDefinitionMods]
           ([Code]
           ,[InActive]
           ,[NumberOfThreads])
     VALUES
           ('Workflow_TaskDoneWorker'
           ,0
           ,2)

end;
else
begin

update [dbo].[BatchServicesDefinitionMods] set 
			[Code] = 'Workflow_TaskDoneWorker'
			,[InActive] = 0
			,[NumberOfThreads] = 2
where [Code] = 'Workflow_TaskDoneWorker';

end;
    ]]>
  </Sql>
</Script>