<Script DBType="Main" Module="Infrastructure">
	<Sql Version="1">
		<![CDATA[
		update ObjectFields set NumberOfDigits = 12, DigitsAfterPoint = 3, DataTypeCode = 'Decimal' 
		where IsCustom = 1 and DataTypeCode in ('Double','SigDouble','UnsDecimal','Decimal');
		
		update ObjectFields set NumberOfDigits = 12, DigitsAfterPoint = 0, DataTypeCode = 'Decimal' 
		where IsCustom = 1 and DataTypeCode in ('BigInteger','Integer','UnsInteger');
		
		update ObjectFields set DataTypeCode = 'nText' 
		where IsCustom = 1 and DataTypeCode in ('Text');
		
        update ObjectFields set MaxLength = 2000 
		where IsCustom = 1 and MaxLength=0 and DataTypeCode in ('Text','nText');
    ]]>
	</Sql> 
</Script>