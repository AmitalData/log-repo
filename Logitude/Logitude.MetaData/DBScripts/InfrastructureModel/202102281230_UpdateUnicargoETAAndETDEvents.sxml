<Script DBType="Main" Env="Logitude,local" Module="Infrastructure">
  <Sql Version="1">
    <![CDATA[
    
    
    update EventTypes set EntityStatusId = (select id from EntityStatus where tenant = 570 and Code = 'BKAR'), IsNotModified = '1' 
    where (code  = 'ETD' or code = 'ETA') and tenant = 570
    
    
    ]]>       
  </Sql>
</Script>
