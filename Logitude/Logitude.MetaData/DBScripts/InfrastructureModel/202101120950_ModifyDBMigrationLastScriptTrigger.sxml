<Script DBType="Main" Module="Infrastructure" Pre="true">
  <Sql Version="1">
    <![CDATA[
DECLARE @TriggerName NVARCHAR(1000)
DECLARE @TriggerText NVARCHAR(MAX)
DECLARE @DropTriggerSql NVARCHAR(MAX)
DECLARE @CreateTriggerSql NVARCHAR(MAX)

DECLARE Triggers_Cursor CURSOR FOR
SELECT o.[name], c.[text] FROM sys.objects AS o INNER JOIN  sys.syscomments AS c ON o.object_id = c.id WHERE o.[type] = 'TR' and o.[name] like 'TR_ResetLastScript_%'

OPEN Triggers_Cursor
FETCH NEXT FROM Triggers_Cursor INTO @TriggerName, @TriggerText

WHILE @@FETCH_STATUS = 0
BEGIN

SET @DropTriggerSql = 'DROP TRIGGER [' + @TriggerName + '];';
SET @CreateTriggerSql = REPLACE(@TriggerText, 'SET [DBMigrationsLastScript] = 0', 'SET [DBMigrationsLastScript] = NULL');

EXEC(@DropTriggerSql);
EXEC(@CreateTriggerSql);

FETCH NEXT FROM Triggers_Cursor INTO @TriggerName, @TriggerText
END

CLOSE Triggers_Cursor
DEALLOCATE Triggers_Cursor
    ]]>       
  </Sql>
  <Oracle Version="1"></Oracle>
</Script>
