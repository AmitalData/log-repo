<Script DBType="Main" Pre="true" Module="Infrastructure">
	<Sql Version="1">
		<![CDATA[
IF NOT EXISTS (
    SELECT 1
    FROM dbo.FieldDataTypes
    WHERE Code = 'DateTime2'
)
BEGIN
    INSERT INTO dbo.FieldDataTypes (Code, Name, SearchFields)
    VALUES ('DateTime2', 'DateTime2', NULL)
END     ]]>
	</Sql>
  <Oracle Version="1">
    	<![CDATA[
    INSERT INTO FieldDataTypes (Code, Name, SearchFields)
SELECT 'DateTime2', 'DateTime2', NULL
FROM dual
WHERE NOT EXISTS (
    SELECT 1 FROM FieldDataTypes WHERE Code = 'DateTime2'
);
]]>
  </Oracle>
</Script>