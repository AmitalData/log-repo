<Script DBType="Main" Pre="true">
  <Sql Version="1">
    <![CDATA[
    update InboundEmails set AnalyzeQueueId = SUBSTRING(CONVERT(varchar(40), NEWID()),0,15) where AnalyzeQueueId is null;
    WITH CTE
    AS
    (
        SELECT AnalyzeQueueId, CreateDate, ROW_NUMBER() OVER (PARTITION BY AnalyzeQueueId,Tenant ORDER BY CreateDate) AS rn
        FROM InboundEmails where AnalyzeQueueId is not null
    )
    update CTE set AnalyzeQueueId = AnalyzeQueueId  + '_v2' WHERE rn > 1;
    ]]>
  </Sql>
</Script>