<Script DBType="Main" Module="Infrastructure">
	<Sql Version="1">
		<![CDATA[
    update EntityStatus set name ='On Forwarding Departed', DisplayName='On Forwarding Departed' where id IN (select EntityStatusId from EventTypes where code  ='ONFD')
    update EntityStatus set name ='Pre Forwarding Departed', DisplayName='Pre Forwarding Departed' where id IN (select EntityStatusId from EventTypes where code  ='PRFD')
    update EntityStatus set name ='Pre Forwarding Arrived', DisplayName='Pre Forwarding Arrived' where id IN (select EntityStatusId from EventTypes where code  ='PRFA')
    update EntityStatus set name ='On Forwarding Arrived', DisplayName='On Forwarding Arrived' where id IN (select EntityStatusId from EventTypes where code  ='ORFA')
    ]]>
	</Sql>
</Script>
