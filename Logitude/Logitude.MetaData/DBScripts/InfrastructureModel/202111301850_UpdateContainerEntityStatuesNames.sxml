<Script DBType="Main" Module="Infrastructure">
  <Sql Version="1">
    <![CDATA[

declare @ObjectTableId varchar(15)
set @ObjectTableId = (select Id from ObjectTables where Name = 'Container')
 IF EXISTS (SELECT Code FROM EventTypes where Code = 'EMPS' and ObjectTableId = @ObjectTableId )
   BEGIN 
     update EventTypes set LocalName = 'Empty Pick up' , EnglishName = 'Empty Pick up' , SearchFields = code +',Empty Pick up,Empty Pick up'  where code = 'EMPS' and ObjectTableId = @ObjectTableId 
END

 IF EXISTS (SELECT Code FROM EventTypes where Code = 'PICS' and ObjectTableId = @ObjectTableId )
   BEGIN 
     update EventTypes set LocalName = 'Departed from Shipper' , EnglishName = 'Departed from Shipper' , SearchFields = code +',Departed from Shipper,Departed from Shipper'  where code = 'PICS' and ObjectTableId = @ObjectTableId 
END

 IF EXISTS (SELECT Code FROM EventTypes where Code = 'POLD' and ObjectTableId = @ObjectTableId )
   BEGIN 
     update EventTypes set LocalName = 'Departed POL' , EnglishName = 'Departed POL' , SearchFields = code +',Departed POL,Departed POL'  where code = 'POLD' and ObjectTableId = @ObjectTableId 
END

 IF EXISTS (SELECT Code FROM EventTypes where Code = 'T1AV' and ObjectTableId = @ObjectTableId )
   BEGIN 
     update EventTypes set LocalName = 'TS1 Arrived' , EnglishName = 'TS1 Arrived' , SearchFields = code +',TS1 Arrived,TS1 Arrived'  where code = 'T1AV' and ObjectTableId = @ObjectTableId 
END

 IF EXISTS (SELECT Code FROM EventTypes where Code = 'T1DT' and ObjectTableId = @ObjectTableId )
   BEGIN 
     update EventTypes set LocalName = 'TS1 Departed' , EnglishName = 'TS1 Departed' , SearchFields = code +',TS1 Departed,TS1 Departed'  where code = 'T1DT' and ObjectTableId = @ObjectTableId 
END

