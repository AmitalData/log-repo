   BEGIN 
     update EventTypes set LocalName = 'TS2 Departed' , EnglishName = 'TS2 Departed' , SearchFields = code +',TS2 Departed,TS2 Departed'  where code = 'T2DT' and ObjectTableId = @ObjectTableId 
END

 IF EXISTS (SELECT Code FROM EventTypes where Code = 'T3AV' and ObjectTableId = @ObjectTableId )
   BEGIN 
     update EventTypes set LocalName = 'TS3 Arrived' , EnglishName = 'TS3 Arrived' , SearchFields = code +',TS3 Arrived,TS3 Arrived'  where code = 'T3AV' and ObjectTableId = @ObjectTableId 
END

 IF EXISTS (SELECT Code FROM EventTypes where Code = 'T3DT' and ObjectTableId = @ObjectTableId )
   BEGIN 
     update EventTypes set LocalName = 'TS3 Departed' , EnglishName = 'TS3 Departed' , SearchFields = code +',TS3 Departed,TS3 Departed'  where code = 'T3DT' and ObjectTableId = @ObjectTableId 
END

 IF EXISTS (SELECT Code FROM EventTypes where Code = 'ARPD' and ObjectTableId = @ObjectTableId )
   BEGIN 
     update EventTypes set LocalName = 'Arrived POD' , EnglishName = 'Arrived POD' , SearchFields = code +',Arrived POD,Arrived POD'  where code = 'ARPD' and ObjectTableId = @ObjectTableId 
END

 IF EXISTS (SELECT Code FROM EventTypes where Code = 'ARWH' and ObjectTableId = @ObjectTableId )
   BEGIN 
     update EventTypes set LocalName = 'On Carriage Departed' , EnglishName = 'On Carriage Departed' , SearchFields = code +',On Carriage Departed,On Carriage Departed'  where code = 'ARWH' and ObjectTableId = @ObjectTableId 
END

 IF EXISTS (SELECT Code FROM EventTypes where Code = 'DPWH' and ObjectTableId = @ObjectTableId )
   BEGIN 
     update EventTypes set LocalName = 'On Carriage Arrived' , EnglishName = 'On Carriage Arrived' , SearchFields = code +',On Carriage Arrived,On Carriage Arrived'  where code = 'DPWH' and ObjectTableId = @ObjectTableId 
