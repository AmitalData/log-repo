   BEGIN 
     update EventTypes set LocalName = 'TS2 Arrived' , EnglishName = 'TS2 Arrived' , SearchFields = code +',TS2 Arrived,TS2 Arrived'  where code = 'T2AV' and ObjectTableId = @ObjectTableId 
END

