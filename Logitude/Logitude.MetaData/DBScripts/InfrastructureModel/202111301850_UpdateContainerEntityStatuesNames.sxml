   BEGIN 
     update EventTypes set LocalName = 'On Carriage Discharged' , EnglishName = 'On Carriage Discharged' , SearchFields = code +',On Carriage Discharged,On Carriage Discharged'  where code = 'UNDS' and ObjectTableId = @ObjectTableId 
END

 IF EXISTS (SELECT Code FROM EventTypes where Code = 'AVDL' and ObjectTableId = @ObjectTableId )
   BEGIN 
     update EventTypes set LocalName = 'Available for Pick up' , EnglishName = 'Available for Pick up' , SearchFields = code +',Available for Pick up,Available for Pick up'  where code = 'AVDL' and ObjectTableId = @ObjectTableId 
END

 IF EXISTS (SELECT Code FROM EventTypes where Code = 'APAR' and ObjectTableId = @ObjectTableId )
   BEGIN 
     update EventTypes set LocalName = 'Delivery Appointment Scheduled' , EnglishName = 'Delivery Appointment Scheduled' , SearchFields = code +',Delivery Appointment Scheduled,Delivery Appointment Scheduled'  where code = 'EMPS' and ObjectTableId = @ObjectTableId 
END

 IF EXISTS (SELECT Code FROM EventTypes where Code = 'DLCO' and ObjectTableId = @ObjectTableId )
   BEGIN 
     update EventTypes set LocalName = 'Delivered' , EnglishName = 'Delivered' , SearchFields = code +',Delivered,Delivered'  where code = 'DLCO' and ObjectTableId = @ObjectTableId 
