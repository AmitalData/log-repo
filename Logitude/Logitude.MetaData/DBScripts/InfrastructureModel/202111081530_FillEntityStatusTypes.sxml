<Script DBType="Main" Module="Infrastructure">
  <Sql Version="1">
    <![CDATA[
if exists (SELECT * FROM sys.tables WHERE name='EntityStatusTypes')
  begin 
   IF NOT EXISTS (SELECT Code FROM EntityStatusTypes where Code = 'O')
   BEGIN 
     Insert into EntityStatusTypes(Code,Name,SearchFields) Values 
     ('O','Operational','Operational,O')
   END
    IF NOT EXISTS (SELECT Code FROM EntityStatusTypes where Code = 'B')
   BEGIN 
     Insert into EntityStatusTypes(Code,Name,SearchFields) Values 
     ('B','Billing','Billing,B')
   END
    IF NOT EXISTS (SELECT Code FROM EntityStatusTypes where Code = 'P')
   BEGIN 
     Insert into EntityStatusTypes(Code,Name,SearchFields) Values 
     ('P','Physical','Physical,P')
   END
end
    ]]>
  </Sql>
</Script>