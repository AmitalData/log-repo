<Script DBType="Main" Pre="true" Module="Infrastructure">
	<Oracle Version="1">
		<![CDATA[

EXECUTE IMMEDIATE 'alter table OBJECTTABLES  add  TEMP_SPLITCOMPONENTPATH varchar(500)';
EXECUTE IMMEDIATE 'update  OBJECTTABLES set TEMP_SPLITCOMPONENTPATH = SPLITCOMPONENTPATH' ;
EXECUTE IMMEDIATE 'alter table OBJECTTABLES drop column SPLITCOMPONENTPATH';
EXECUTE IMMEDIATE 'alter table OBJECTTABLES  add  SPLITCOMPONENTPATH NCLOB';
EXECUTE IMMEDIATE 'update  OBJECTTABLES set SPLITCOMPONENTPATH= TEMP_SPLITCOMPONENTPATH';
EXECUTE IMMEDIATE 'alter table OBJECTTABLES drop column TEMP_SPLITCOMPONENTPATH';
    ]]>
	</Oracle>
</Script>