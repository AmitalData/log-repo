<Script DBType="Main" Module="Infrastructure">
  <Sql Version="1">
    <![CDATA[
declare @ShipmentObjectTableId as varchar(15)
set @ShipmentObjectTableId  = (Select Id from ObjectTables where Name = 'Shipment')

Update EventTypes set EventTrigger = 'The ATA of all pickups was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'RCS'
Update EventTypes set EventTrigger = 'The shipment was created' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'ORDR'
Update EventTypes set EventTrigger = 'The ATD of the pickup legs was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'PICD'
Update EventTypes set EventTrigger = 'The ATD of the maincarriage leg was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'DEP'
Update EventTypes set EventTrigger = 'The ATA of the maincarriage leg was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'ARR'
Update EventTypes set EventTrigger = 'The ATD of the first transshipment leg was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'T1DP'
Update EventTypes set EventTrigger = 'The ATA of the first transshipment leg was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'T1AR'
Update EventTypes set EventTrigger = 'The Actual Release of the origin warehouse was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'WRDE'
Update EventTypes set EventTrigger = 'The Actual Entry of the origin warehouse was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'WEDE'
Update EventTypes set EventTrigger = 'The ATD of the second transshipment leg was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'T2DP'
Update EventTypes set EventTrigger = 'The ATA of the delivery was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'DEAR'
Update EventTypes set EventTrigger = 'The ATA of the second transshipment leg was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'T2AR'
Update EventTypes set EventTrigger = 'The ATD of the third transshipment leg was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'T3DP'
Update EventTypes set EventTrigger = 'The ATD of the pre forwarding leg was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'PRFD'
Update EventTypes set EventTrigger = 'The ATA of the pre forwarding leg was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'PRFA'
Update EventTypes set EventTrigger = 'The ATD of the on forwarding leg was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'ONFD'
Update EventTypes set EventTrigger = 'The ATA of the on forwarding leg was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'ORFA'
Update EventTypes set EventTrigger = 'The ATA of the third transshipment leg was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'T3AR'
Update EventTypes set EventTrigger = 'The document was uploaded to the POD document type in the Docs in of the Shipment' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'PIOD'
Update EventTypes set EventTrigger = 'The ATD of the the delivery was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'DELD'
Update EventTypes set EventTrigger = 'The ETD/ETA of the first pickup leg was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'PCAR'
Update EventTypes set EventTrigger = 'The ATD of the pre carriage leg was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'PRCD'
Update EventTypes set EventTrigger = 'The ATA of the pre carriage leg was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'PRCA'
Update EventTypes set EventTrigger = 'The ATD of the on carriage leg was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'ONCD'
Update EventTypes set EventTrigger = 'The ATA of the on carriage leg was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'ONCA'
Update EventTypes set EventTrigger = 'The ETD/ETA of the first delivery leg was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'DLAR'
Update EventTypes set EventTrigger = 'The Actual Entry of the destination warehouse was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'WHED'
Update EventTypes set EventTrigger = 'The Actual Release of the destination warehouse was filled' where tenant = 0 and ObjectTableId = @ShipmentObjectTableId and Code = 'WHRD'

    ]]>
  </Sql>
</Script>