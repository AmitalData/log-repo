<Script DBType="Main" Module="Common">
  <Sql Version="1">
    <![CDATA[

     

declare @Tenant as int
declare @GenderCode as varchar(1)
declare @Gender as varchar(50)
declare @HorseId as varchar(15)

BEGIN
       DECLARE DataCursor CURSOR READ_ONLY
       FOR
       SELECT Id, Tenant, Gender
       FROM Horses
       where Gender is not null
       OPEN DataCursor FETCH NEXT FROM DataCursor INTO @HorseId, @Tenant, @Gender
       WHILE @@FETCH_STATUS = 0
       BEGIN
			  
              set @GenderCode = null

              if(@Gender = 'Male' or @Gender = 'Mare' or @Gender = '')
                set @GenderCode = 'M'

              else if(@Gender = 'Female' or @Gender = '' or @Gender = '')
                set @GenderCode = 'F'

              else if(@Gender = 'Castrated' or @Gender = '' or @Gender = '')
                set @GenderCode = 'C'

              update Horses set GenderCode = @GenderCode where Id = @HorseId
                 			 
       FETCH NEXT FROM DataCursor INTO @HorseId, @Tenant, @Gender
       END
       CLOSE DataCursor
       DEALLOCATE DataCursor
END



    ]]>
  </Sql>
</Script>