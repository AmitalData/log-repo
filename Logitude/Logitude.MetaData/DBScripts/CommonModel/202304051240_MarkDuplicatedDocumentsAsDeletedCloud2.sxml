<Script DBType="Main"  Module="Common" Env="local" AOT="true" TargetTableName="DocumentsFilings">
  <Sql Version="1">
    <![CDATA[

		update DocumentsFilings set DocumentsFilings.ComputedCustomerDocumentId = DocumentsFilings.CustomerDocumentId where DocumentsFilings.CustomerDocumentId is not null And $LastCounterWhere$
		update DocumentsFilings set DocumentsFilings.ComputedCustomerDocumentId = DocumentsFilings.Id where DocumentsFilings.CustomerDocumentId is null And $LastCounterWhere$

		declare @Tenant as int
		declare @CustomerTenantNumber as int
		declare @ComputedCustomerDocumentId as varchar(150)
		declare @KeepedDocumentId as varchar(150)

		BEGIN
			DECLARE ComputedCustomerDocumentsTenantsCursor CURSOR READ_ONLY
			FOR
			SELECT DocumentsFilings.Tenant,DocumentsFilings.CustomerTenantNumber,DocumentsFilings.ComputedCustomerDocumentId
			FROM DocumentsFilings
			WHERE ComputedCustomerDocumentId IS NOT NULL
			And CustomerTenantNumber IS NOT NULL
      And $LastCounterWhere$
			GROUP BY DocumentsFilings.Tenant,DocumentsFilings.CustomerTenantNumber,DocumentsFilings.ComputedCustomerDocumentId
			HAVING COUNT(*) > 1
			OPEN ComputedCustomerDocumentsTenantsCursor FETCH NEXT FROM ComputedCustomerDocumentsTenantsCursor INTO @Tenant,@CustomerTenantNumber,@ComputedCustomerDocumentId
			WHILE @@FETCH_STATUS = 0
				BEGIN
						SET @KeepedDocumentId = (SELECT TOP(1)Id FROM DocumentsFilings WHERE DocumentsFilings.Tenant = @Tenant and DocumentsFilings.CustomerTenantNumber = @CustomerTenantNumber and DocumentsFilings.ComputedCustomerDocumentId=@ComputedCustomerDocumentId and DocumentsFilings.IsDeleted = 0 ORDER BY DocumentsFilings.UpdateDate DESC)
					IF (@KeepedDocumentId IS NOT NULL)
					BEGIN
						UPDATE DocumentsFilings SET IsDeleted = 1, ComputedCustomerDocumentId = 'Del-' + (CAST((IsDeleted) AS varchar)) + '-' + Id WHERE DocumentsFilings.Tenant = @Tenant and DocumentsFilings.CustomerTenantNumber = @CustomerTenantNumber and DocumentsFilings.ComputedCustomerDocumentId=@ComputedCustomerDocumentId and DocumentsFilings.Id <> @KeepedDocumentId
					END
					ELSE IF(@KeepedDocumentId IS NULL)
					BEGIN
						UPDATE DocumentsFilings SET IsDeleted = 1, ComputedCustomerDocumentId = 'Del-' + (CAST((IsDeleted) AS varchar)) + '-' + Id WHERE DocumentsFilings.Tenant = @Tenant and DocumentsFilings.CustomerTenantNumber = @CustomerTenantNumber and DocumentsFilings.ComputedCustomerDocumentId=@ComputedCustomerDocumentId
					END
				FETCH NEXT FROM ComputedCustomerDocumentsTenantsCursor INTO @Tenant,@CustomerTenantNumber,@ComputedCustomerDocumentId
				END
			CLOSE ComputedCustomerDocumentsTenantsCursor
			DEALLOCATE ComputedCustomerDocumentsTenantsCursor
		END

        ]]>
  </Sql>
</Script>