<Script DBType="Main" Module="Common">
  <Sql Version="2">
    <![CDATA[

     

  if not exists (select Code from HorseGenders where Code = 'M')
    insert into HorseGenders(Code, Name, SearchFields) values ('M', 'Male', 'M,Male')
  
  if not exists (select Code from HorseGenders where Code = 'F')
    insert into HorseGenders(Code, Name, SearchFields) values ('F', 'Female', 'F,Female')
    
  if not exists (select Code from HorseGenders where Code = 'C')
    insert into HorseGenders(Code, Name, SearchFields) values ('C', 'Castrated', 'C,Castrated')
    
declare @Tenant as int
declare @GenderCode as varchar(1)
declare @Gender as varchar(50)
declare @HorseId as varchar(15)

BEGIN
       DECLARE DataCursor CURSOR READ_ONLY
       FOR
       SELECT Id, Tenant, GenderCode
       FROM Horses
       where GenderCode is not null
       OPEN DataCursor FETCH NEXT FROM DataCursor INTO @HorseId, @Tenant, @Gender
       WHILE @@FETCH_STATUS = 0
       BEGIN
			  
              set @GenderCode = null

              if(@Gender = 'Male' or @Gender = 'Colt' or @Gender = 'Stallion' or @Gender = 'TB' or @Gender = 'Coly')
                set @GenderCode = 'M'

              else if(@Gender = 'Female' or @Gender = 'Mare' or @Gender = 'Filly')
                set @GenderCode = 'F'

              else if(@Gender = 'Castrated' or @Gender = 'Gelding' or @Gender = 'MALE CASTRATED' or @Gender = 'GRLDING' or @Gender = 'Macho Castrado' or @Gender = 'Gel')
                set @GenderCode = 'C'

              update Horses set GenderCode = @GenderCode where Id = @HorseId
                 			 
       FETCH NEXT FROM DataCursor INTO @HorseId, @Tenant, @Gender
       END
       CLOSE DataCursor
       DEALLOCATE DataCursor
END



    ]]>
  </Sql>
</Script>