<Script DBType="Main" Module="Common" TargetTableName="CustomerGroups">
  <Sql Version="3">
    <![CDATA[
        declare @Tenant as int
		declare @NewId as varchar(15)
		declare @TenantString as varchar(50)
		declare @UserId as varchar(15)
		declare @UserEmail as varchar(150)

		BEGIN
			DECLARE CustomerGroupTablesCursor CURSOR READ_ONLY
			FOR
			SELECT Id
			FROM Tenants
			OPEN CustomerGroupTablesCursor FETCH NEXT FROM CustomerGroupTablesCursor INTO @Tenant
			WHILE @@FETCH_STATUS = 0
			BEGIN

			BEGIN
				if not exists (select * from CustomerGroups where Name = 'General' and Tenant = @Tenant)
				BEGIN
					EXECUTE usp_GetNextTableIdValue @NewId OUTPUT,'CustomerGroup'
					set @TenantString = CONVERT(varchar(50), @Tenant)
					set @UserEmail = 'system@tenant'+ @TenantString + '.com'
					set @UserId = (select top(1) Id from Contacts where Email = @UserEmail and Tenant = @Tenant) 
					set @UserId = (select top(1) Id from Users where Id = @UserId) 
					if (@UserId is not null)
					BEGIN
						insert into CustomerGroups(Id, Tenant, Name,CreateDate,UpdateDate,CreatedByUserId, UpdatedByUserId, Inactive, SearchFields)
						values
						(
						@NewId,
						@Tenant,
						'General',
						GETDATE(),
						GETDATE(),
						@UserId,
						@UserId,
						0,
						'General'
						)
				   END
				END

			END

			FETCH NEXT FROM CustomerGroupTablesCursor INTO  @Tenant
			END
			CLOSE CustomerGroupTablesCursor
			DEALLOCATE CustomerGroupTablesCursor

		END
    ]]>
</Sql>
</Script>


