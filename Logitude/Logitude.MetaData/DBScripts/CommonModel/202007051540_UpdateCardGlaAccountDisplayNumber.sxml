<Script DBType="Main">
  <Sql Version="3">
    <![CDATA[
    
UPDATE c
SET c.GLAccountDisplayNumber = g.DisplayNumber
FROM cards AS c
JOIN glaccounts AS g
ON c.GLAccountId = g.id
AND c.tenant = g.tenant
AND c.GLAccountDisplayNumber <> g.DisplayNumber;

UPDATE c
SET c.GLAccountDisplayNumber = NULL
FROM cards AS c
WHERE c.GLAccountId IS NULL AND C.GLAccountDisplayNumber IS NOT NULL

INSERT INTO CardSearches (Tenant, CardId, RecordDate, PartnerTypeId, InActive, IsCustomer, Keyword, Weight)
SELECT 
    c.Tenant, 
    c.Id, 
    COALESCE(c.UpdateDate, c.CreateDate) AS RecordDate, 
    c.PartnerTypeId, 
    c.InActive, 
    c.IsCustomer, 
    t.Keyword, 
    t.Weight
FROM cards AS c
JOIN glaccounts AS g 
ON c.GLAccountId = g.id 
AND c.Tenant = g.Tenant
and c.GLAccountDisplayNumber is not NULL
LEFT JOIN CardSearches AS cs on
c.Id=cs.CardId
and c.Tenant=cs.Tenant
AND c.GLAccountDisplayNumber = cs.Keyword 
CROSS APPLY dbo.BuildSearchKeywordFunction(c.GLAccountDisplayNumber, 80, 80) t 
WHERE cs.Keyword IS NULL and t.Keyword <> ' '
     
    ]]>
  </Sql>
</Script>