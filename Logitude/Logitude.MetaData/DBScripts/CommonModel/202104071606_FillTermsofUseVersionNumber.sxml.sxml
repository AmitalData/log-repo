<Script DBType="Main" Module="Common"   AOT="true" TargetTableName="TermsofUses">

    <Sql Version="2">
    <![CDATA[
    	if cast(SERVERPROPERTY ('Edition') as varchar(50)) not like '%Standard Edition%'
           update TermsofUses set [VersionNumber] = [Id] where  $LastCounterWhere$
    ]]>
  </Sql>
  <Oracle Version="1"></Oracle>
</Script>

