<Script DBType="Main" Module="Common" AOT="true" TargetTableName="Ports">
  <Sql Version="2">
    <![CDATA[
    
     declare @Id as varchar(15)

       DECLARE PortCursor CURSOR READ_ONLY
       FOR
       SELECT Id
       FROM Ports
       where $LastCounterWhere$
       OPEN PortCursor FETCH NEXT FROM PortCursor INTO @Id
       WHILE @@FETCH_STATUS = 0
       BEGIN
	
	     exec usp_UpdatePortSearchFieldsFunction @Id

             		 
       FETCH NEXT FROM PortCursor INTO @Id
       END
       CLOSE PortCursor
       DEALLOCATE PortCursor

    
    ]]>
  </Sql>
  <Oracle Version="1"></Oracle>
</Script>