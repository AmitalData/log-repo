<Script DBType="Main" Module="Common"  AOT="true" TargetTableName="CardSearches">

    <Sql Version="4">
    <![CDATA[
    
update  CardSearches set IsCustomer = (select IsCustomer From Cards where id =CardSearches.CardId)  where  $LastCounterWhere$

    ]]>
  </Sql>
  <Oracle Version="1"></Oracle>
</Script>

