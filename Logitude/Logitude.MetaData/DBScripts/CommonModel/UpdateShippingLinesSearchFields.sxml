<Script DBType="Main" Module="Common" AOT="true" TargetTableName="ShippingLines">
  <Sql Version="1">
    <![CDATA[
    
     declare @Id as varchar(15)

       DECLARE ShippingLineCursor CURSOR READ_ONLY
       FOR
       SELECT Id
       FROM ShippingLines
       where $LastCounterWhere$
       OPEN ShippingLineCursor FETCH NEXT FROM ShippingLineCursor INTO @Id
       WHILE @@FETCH_STATUS = 0
       BEGIN
	
	     exec usp_UpdateShippingLineSearchFieldsFunction @Id

             		 
       FETCH NEXT FROM ShippingLineCursor INTO @Id
       END
       CLOSE ShippingLineCursor
       DEALLOCATE ShippingLineCursor

    
    ]]>
  </Sql>
</Script>