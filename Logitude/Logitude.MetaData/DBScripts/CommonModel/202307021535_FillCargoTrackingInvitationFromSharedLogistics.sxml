<Script DBType="Main" Module="Common" AOT="true" TargetTableName="Cards">
  <Sql Version="1">
    <![CDATA[ 
    UPDATE Cards 
    SET Cards.CargoTrackingInvitatStatusCode = Cards.SharedLogisticsInvitStatusCode, Cards.CargoTrackingInvitationDate = Cards.InvitationDate
    Where $LastCounterWhere$
    ]]>
</Sql>
</Script>


