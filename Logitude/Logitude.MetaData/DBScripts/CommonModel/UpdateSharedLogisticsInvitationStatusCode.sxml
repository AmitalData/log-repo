<Script DBType="Main" Module="Common"  AOT="true" TargetTableName="Cards">
    <Sql Version="1"> 
    <![CDATA[
update cards set SharedLogisticsInvitStatusCode =1  where  $LastCounterWhere$ and SharedLogisticsInvitStatusCode is null and PartnerTypeId !='CS'

    ]]>
  </Sql>
  <Oracle Version="1"></Oracle>
</Script>

