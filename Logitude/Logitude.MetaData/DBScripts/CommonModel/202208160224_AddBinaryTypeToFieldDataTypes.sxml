<Script DBType="Main" Module="Common">
	<Sql Version="1">
		<![CDATA[
    
      if not exists (select Code from FieldDataTypes where Code = 'Binary')
      begin                
      insert into FieldDataTypes(Code, Name, SearchFields) values('Binary', 'Binary', 'Binary,Binary');
      end
      
    ]]>
	</Sql>
</Script>

