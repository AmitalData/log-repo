<Script DBType="Main" Module="Common">
	<Sql Version="1">
		<![CDATA[
    
      if not exists (select Code from FieldDataTypes where Code = 'Binary')
      begin                
      insert into FieldDataTypes(Code, Name, SearchFields) values('Binary', 'Binary', 'Binary,Binary');
      end
      
    ]]>
	</Sql>
  <Oracle Version="1">
    <![CDATA[
    
 insert into FieldDataTypes(Code, Name, SearchFields)
 SELECT 'Binary', 'Binary', 'Binary,Binary'
FROM dual
WHERE NOT EXISTS (
select Code from FieldDataTypes where Code = 'Binary'
);
    ]]>
  </Oracle>
</Script>

