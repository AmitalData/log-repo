<Script DBType="Main" Module="Common" TargetTableName="Roles">
  <Sql Version="1">
    <![CDATA[

       if not exists (select Id from Roles where Tenant = 0 and Code = 'HRAD')
       begin           
	         declare @Id as varchar(15)
	         EXECUTE usp_GetNextTableIdValue @Id OUTPUT,'Role'
	         insert into Roles(Id, Name, Tenant, Code, RoleTypeCode, Description, ParentRoleId, IsCustomRole, SearchFields)
	         values(@Id, 'HR Administrator', 0, 'HRAD', 'IN', 'Time Management Operations', NULL, 0, 'HR Administrator')			                           
       end 
      
    ]]>
  </Sql>
</Script>
