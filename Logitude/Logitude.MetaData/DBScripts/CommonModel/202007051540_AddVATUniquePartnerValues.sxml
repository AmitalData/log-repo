<Script DBType="Main">
  <Sql Version="3">
    <![CDATA[

if not exists (select Code from VatUniquePartnerTypes where Code = 'ALL')
begin                
	insert into VatUniquePartnerTypes (Code, Name, SearchFields)
	values ('ALL', 'All Customers', 'ALL,All Customers')
end

if not exists (select Code from VatUniquePartnerTypes where Code = 'CUS')
begin                
	insert into VatUniquePartnerTypes (Code, Name, SearchFields)
	values ('CUS', 'Active Customers Only', 'CUS,Active Customers Only')
end

if not exists (select Code from VatUniquePartnerTypes where Code = 'POT')
begin                
	insert into VatUniquePartnerTypes (Code, Name, SearchFields)
	values ('POT', 'Potential Customers Only', 'POT,Potential Customers Only')
end
     
    ]]>
  </Sql>
</Script>