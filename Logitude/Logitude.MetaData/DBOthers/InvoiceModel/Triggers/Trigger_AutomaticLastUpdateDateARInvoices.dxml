<?xml version="1.0" encoding="utf-8"?>
<Trigger
  DBType="Main"
  Name="Trigger_AutomaticLastUpdateDateARInvoices"
  Schema="dbo"
  Module="Invoice">
  <SqlScript><![CDATA[
CREATE TRIGGER Trigger_AutomaticLastUpdateDateARInvoices ON ARInvoices AFTER UPDATE  AS  BEGIN UPDATE ARInvoices SET AutomaticLastUpdateDate = GETDATE() WHERE Id IN (SELECT DISTINCT Id FROM Inserted)END;
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Trigger>