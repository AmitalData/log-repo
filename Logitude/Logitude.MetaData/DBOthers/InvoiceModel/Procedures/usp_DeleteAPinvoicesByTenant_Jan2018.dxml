<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="usp_DeleteAPinvoicesByTenant_Jan2018"
  Schema="dbo"
  Module="Invoice">
  <SqlScript><![CDATA[
create PROCEDURE [dbo].[usp_DeleteAPinvoicesByTenant_Jan2018]
(
	@tenant int
)
AS


BEGIN TRANSACTION


delete from apinvoiceentities
where tenant=@tenant

IF @@ERROR <> 0
 BEGIN
    ROLLBACK
    RAISERROR ('Error in deleting apinvoiceentities', 16, 1)
    RETURN
 END

 delete from apinvoicelines
where tenant=@tenant

IF @@ERROR <> 0
 BEGIN
    ROLLBACK
    RAISERROR ('Error in deleting apinvoicelines', 16, 1)
    RETURN
 END

 delete from apinvoicetotalvats
where tenant=@tenant

IF @@ERROR <> 0
 BEGIN
    ROLLBACK
    RAISERROR ('Error in deleting apinvoicetotalvats', 16, 1)
    RETURN
 END

 delete from apinvoicepayments
where tenant=@tenant

IF @@ERROR <> 0
 BEGIN
    ROLLBACK
    RAISERROR ('Error in deleting apinvoicepayments', 16, 1)
    RETURN
 END

 delete from appayments
where tenant=@tenant

IF @@ERROR <> 0
 BEGIN
    ROLLBACK
    RAISERROR ('Error in deleting appayments', 16, 1)
    RETURN
 END

 delete from apinvoices
where tenant=@tenant

IF @@ERROR <> 0
 BEGIN
    ROLLBACK
    RAISERROR ('Error in deleting apinvoices', 16, 1)
    RETURN
 END





COMMIT 

--exec usp_DeleteShipmentsDataByTenant 1
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Procedure>