<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="usp_GetInvoiceSequenceStatus"
  Schema="dbo"
  Module="Invoice">
  <SqlScript>
    <![CDATA[
CREATE OR ALTER PROCEDURE [dbo].[usp_GetInvoiceSequenceStatus]
    @Tenant INT,
    @FromDate DATETIME,
    @ToDate DATETIME
AS
BEGIN

WITH InvoiceCTE AS (
  SELECT
	Tenant,
    invoiceNumber,
    InvoiceDate,
    LEFT(invoiceNumber, PATINDEX('%[0-9]%', invoiceNumber) - 1) AS Series, -- חלק לא נומרי
    -- חילוץ החלקים הנומריים בלבד
    CASE 
        WHEN PATINDEX('%[0-9]%', invoiceNumber) > 0 
        THEN CAST(REPLACE(REPLACE(REPLACE(REPLACE(SUBSTRING(invoiceNumber, PATINDEX('%[0-9]%', invoiceNumber), LEN(invoiceNumber)), '-', ''), ' ', ''), '.', ''), ':', '') AS bigint)
        ELSE NULL 
    END AS InvoiceNumberPart, -- חלק נומרי (מסיר תווים לא נומריים)
 ROW_NUMBER() OVER (ORDER BY CAST(REPLACE(REPLACE(REPLACE(REPLACE(SUBSTRING(invoiceNumber, PATINDEX('%[0-9]%', invoiceNumber), LEN(invoiceNumber)), '-', ''), ' ', ''), '.', ''), ':', '') AS bigint)) AS rn 

FROM
    ARInvoices
WHERE
    tenant = @Tenant
    AND 
	StatusCode not in ('DR','PR')
	AND
    InvoiceDate BETWEEN @FromDate AND @ToDate
),

SequencedInvoices AS (
    SELECT 
        Series,
        InvoiceNumberPart,
        InvoiceDate,
        invoiceNumber AS OriginalInvoiceNumber,
        LAG(InvoiceNumberPart) OVER (ORDER BY  InvoiceNumberPart) AS PreviousInvoiceNumberPart,
        LAG(Series) OVER (ORDER BY  InvoiceNumberPart) AS PreviousSeries,
		Tenant
    FROM 
        InvoiceCTE
)

SELECT
	Tenant,
    Series,
    CAST(InvoiceNumberPart AS VARCHAR(20)) AS InvoiceNumberPart,
    InvoiceDate, 
    OriginalInvoiceNumber,
    CASE
        WHEN PreviousInvoiceNumberPart IS NULL THEN 'OK' -- חשבונית הראשונה בסדרה
        WHEN Series <> PreviousSeries and InvoiceNumberPart != PreviousInvoiceNumberPart + 1 THEN 'OK' -- סדרה שונה
        WHEN InvoiceNumberPart = PreviousInvoiceNumberPart + 1 THEN 'OK' -- רצף תקין
        ELSE 'Error'
    END AS [SequenceStatus]
FROM 
    SequencedInvoices
ORDER BY
 InvoiceNumberPart; -- ממיון לפי סדרת חשבונית ומספר חשבונית
END;




]]></SqlScript>
  <OracleScript>
</OracleScript>
</Procedure>