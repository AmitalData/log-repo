<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Global"
  Name="DeleteTenantFromGlobalDB"
  Schema="dbo"
  Module="Common">
  <SqlScript><![CDATA[
--delete global records execute this on global database
Create  PROCEDURE dbo.DeleteTenantFromGlobalDB
(

@tenant int                     --Input parameter ,  tenant to delete

)
AS
BEGIN
delete from globalcontacts
where globaltenantid=@tenant

delete from globaltenants
where id=@tenant
END
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Procedure>