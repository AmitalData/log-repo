<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="usp_UpdatePortSearchFieldsFunction"
  Schema="dbo"
  Module="Common">
  <SqlScript>
    <![CDATA[


Create PROCEDURE [dbo].[usp_UpdatePortSearchFieldsFunction]
(
	@PortId varchar(15)
)
AS


declare  @Tenant int
declare  @Code varchar(3)

declare  @EnglishName varchar(40)
declare  @LocalName nvarchar(40)
declare  @CountryId varchar(15)
declare  @CountryName varchar(120)
declare  @CountryCode varchar(2)

if (@PortId is not null)

begin 

select
@Tenant = Tenant,
@EnglishName = EnglishName,
@LocalName = LocalName,
@CountryId = CountryId,
@Code = Code
from Ports
where Id = @PortId


	
  begin 

  if(@CountryId is not null)
  begin 
  select
@CountryName = EnglishName,
@CountryCode = Code
from Countries
where Id = @CountryId
      end 


    declare  @CombinedCode varchar(30)
	set @CombinedCode = ( @CountryCode +@Code )
  declare  @SearchFields nvarchar(1000)
  set @SearchFields = @Code + ',' + @EnglishName +  ',' +@LocalName +  ',' +@CountryCode + ','+@CountryName+ ',' + @CombinedCode
  update ports set SearchFields =  SUBSTRING(@SearchFields,0, 999) , CombinedCode = @CombinedCode  where id = @PortId and Tenant = @Tenant




  end

    end

]]>
  </SqlScript>
  <OracleScript>
  </OracleScript>
</Procedure>