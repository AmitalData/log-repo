<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="DeleteOldAuthenticationTokens"
  Schema="dbo"
  Module="Common">
  <SqlScript>
	  <![CDATA[
CREATE procedure [dbo].[DeleteOldAuthenticationTokens]
as
begin

declare @Rows int
set @Rows = 11

while (@Rows >10)
BEGIN

DELETE
FROM dbo.DBA_View_AuthenticationTokens_ToBeDeleted

set @Rows= @@ROWCOUNT

WAITFOR DELAY '00:00:01'
END
WAITFOR DELAY '00:00:05'
set @Rows = 11

while (@Rows >10)
BEGIN

DELETE
FROM [dbo].[DBA_View_AuthenticationTokens_ToBeDeleted_IsAPIToken]

set @Rows= @@ROWCOUNT

WAITFOR DELAY '00:00:01'
END

WAITFOR DELAY '00:00:05'
set @Rows = 11

while (@Rows >10)
BEGIN

DELETE
FROM [dbo].[DBA_View_AuthenticationTokens_ToBeDeleted_WebIsInActive]

set @Rows= @@ROWCOUNT

WAITFOR DELAY '00:00:01'
END

end
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Procedure>