<Procedure
  DBType="Main"
  Name="usp_DoTheTableDeletionSet"
  Schema="dbo"
  Module="Common">
  <SqlScript>
  <![CDATA[
Create PROCEDURE [dbo].usp_DoTheTableDeletionSet
(
	@Tenant int, 
  @TableName varchar(256),
  @WhereInput varchar(max)=''
)
AS

BEGIN
-- the following is an example to show what code can be generated to do the table deletionset nocount on;
if object_id('tempdb..#tmp') is not null
	drop table #tmp;
create table  #tmp  (id int, tablename varchar(256), lvl int, ParentTable varchar(256));


insert into #tmp 
exec dbo.usp_SearchForeignkeyTree @table=@TableName, @debug=0;

if object_id('tempdb..#NamesAliases') is not null
	drop table #NamesAliases;

CREATE TABLE #NamesAliases(tablename varchar(256), TableAliasName varchar(1000), lvl int, loop int);
declare @childAs varchar(max);
declare @ParentAs varchar(max);
declare @where varchar(max);
declare @curFK cursor, @fk_object_id int;
declare @sqlcmd varchar(max)='', @crlf char(2)=char(0x0d)+char(0x0a);
declare @child varchar(256), @parent varchar(256), @lvl int, @id int, @TableAliasName varchar(1000),@ParentAliaseName varchar(1000);
declare @i int;
declare @t table (tablename varchar(128));
declare @curT cursor;
set @where = ' ';
	declare curT cursor for
	select  lvl, id 
	from #tmp  
	order by lvl desc;
	open curT;
	fetch next from curT into  @lvl, @id; 
	while @@FETCH_STATUS =0
	begin
	    declare @counter int
		set @counter = 0;
		set @i=0;
		if @lvl =0
		begin -- this is the root level
      set @where = '  where  ' + @TableName + '.Tenant = '+ CAST(@Tenant as varchar(10)) + @WhereInput;
      set @sqlcmd = @sqlcmd +' delete from  ' + @TableName +  @where;
		end -- this is the roolt level

		DELETE FROM #NamesAliases

		while @i < @lvl
		begin -- while
		    set @counter = 0;
		    select top 1 @child=TableName, @parent=ParentTable from #tmp where id <= @id-@i and lvl <= @lvl-@i order by lvl desc, id desc;
			
			if Not exists 
			(
			select tablename from #NamesAliases
			where tablename = @child and lvl = @lvl-@i
			)
			begin
				INSERT INTO #NamesAliases (tablename,TableAliasName, lvl, loop) 
				SELECT  top 1 tablename, (replace(tablename, '.','') + CAST( lvl as varchar(10))), lvl, 0
				FROM #tmp where id <= @id-@i and lvl <= @lvl-@i order by lvl desc, id desc;
			end 

			if Not exists 
			(
			select top 1 tablename from #NamesAliases
			where tablename = @parent and lvl = @lvl-@i
			)
			begin
				INSERT INTO #NamesAliases (tablename,TableAliasName, lvl, loop) 
				SELECT  ParentTable, (replace(ParentTable, '.','') + CAST( lvl as varchar(10))), lvl, 0
				FROM #tmp where id <= @id-@i and lvl <= @lvl-@i order by lvl desc, id desc;
			end 

			set @curFK = cursor for
			select object_id from sys.foreign_keys 
			where parent_object_id = object_id(@child)
			and referenced_object_id = object_id(@parent)
			
			open @curFK;
			fetch next from @curFk into @fk_object_id
			while @@fetch_status =0
			begin -- @curFK
				set @childAs = (select top 1 TableAliasName from #NamesAliases where tablename = @child order by lvl desc);
				set @ParentAs = (select top 1 TableAliasName from #NamesAliases where tablename = @parent and loop = @counter order by lvl desc);
				
				if @i=0
					set @sqlcmd = 'delete from ' + @child + @crlf+
					'from ' + @child + @crlf +  ' as ' +  @childAs
				+ ' inner join ' + @parent +  ' as ' + @ParentAs
				else
					set @sqlcmd = @sqlcmd + @crlf + ' inner join ' + @parent+  ' as ' +  @ParentAs;

				if(@counter >= 1)
				begin
					;WITH CTE
					AS
					(
						SELECT tablename,TableAliasName, lvl,loop, ROW_NUMBER() OVER (PARTITION BY tablename,TableAliasName, lvl ORDER BY lvl desc) AS rn
						FROM #NamesAliases where lvl != 1
					)
					update CTE set TableAliasName = TableAliasName  + '_v2', lvl = '', loop = 1  WHERE rn > 1;
				end
				set @counter = @counter + 1;

				;with c as 
				(
					select child = object_schema_name(fc.parent_object_id)+'.' + object_name(fc.parent_object_id)
					     , child_col=c.name
					     , parent = object_schema_name(fc.referenced_object_id)+'.' + object_name(fc.referenced_object_id)
						 , parent_col=c2.name
					     , rnk = row_number() over (order by (select null))				
				    from sys.foreign_key_columns fc
					inner join sys.columns c
					on fc.parent_column_id = c.column_id
					and fc.parent_object_id = c.object_id
					inner join sys.columns c2
					on fc.referenced_column_id = c2.column_id
					and fc.referenced_object_id = c2.object_id
					where fc.constraint_object_id=@fk_object_id
				)
				select 
					@sqlcmd = @sqlcmd +  case rnk when 1 then ' on '  else ' and ' end 
					+ @childAs +'.'+ child_col   + '='  
					+ @ParentAs +'.' + parent_col 
				from c ;
				fetch next from @curFK into @fk_object_id;
				
			end --@curFK
			close @curFK;
			deallocate @curFK;
			set @i = @i +1;
		end --while
		set @where = ' where ' + (select top 1 TableAliasName from #NamesAliases where tablename = @TableName and lvl = 1) + '.Tenant=' +CAST(@Tenant as varchar(10)) + @WhereInput;
		--print @sqlcmd + @crlf + @where + ';';
		--print '';
    if TRIM(@sqlcmd) is not null
		   EXEC (@sqlcmd + @crlf + @where + ';');
	fetch next from curT into  @lvl, @id;
	end
	close curT;
	deallocate curT;

END
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Procedure>