<?xml version="1.0" encoding="utf-8"?>
<Trigger
  DBType="Main"
  Name="Trigger_AutomaticLastUpdateDateDepartments"
  Schema="dbo"
  Module="Common">
  <SqlScript>
  <![CDATA[
CREATE TRIGGER Trigger_AutomaticLastUpdateDateDepartments ON Departments AFTER UPDATE  AS  BEGIN

SET NOCOUNT ON;

IF TRIGGER_NESTLEVEL() > 1 RETURN;

IF SESSION_CONTEXT(N'ZeroDownTimeMode') IS NULL
BEGIN
UPDATE Departments SET AutomaticLastUpdateDate = GETDATE() WHERE Id IN (SELECT DISTINCT Id FROM Inserted);
END;

END;
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Trigger>