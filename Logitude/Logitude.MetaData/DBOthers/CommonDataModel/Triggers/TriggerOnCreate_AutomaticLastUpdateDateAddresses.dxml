<?xml version="1.0" encoding="utf-8"?>
<Trigger
  DBType="Main"
  Name="TriggerOnCreate_AutomaticLastUpdateDateAddresses"
  Schema="dbo"
  Module="Common">
  <SqlScript><![CDATA[
CREATE TRIGGER TriggerOnCreate_AutomaticLastUpdateDateAddresses ON Addresses AFTER Insert  AS  BEGIN UPDATE Addresses SET AutomaticLastUpdateDate = GETDATE() WHERE Id IN (SELECT DISTINCT Id FROM Inserted)END;
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Trigger>