<?xml version="1.0" encoding="utf-8"?>
<Trigger
  DBType="Main"
  Name="Trigger_AutomaticLastUpdateDateIndustries"
  Schema="dbo"
  Module="Common">
  <SqlScript><![CDATA[
CREATE TRIGGER Trigger_AutomaticLastUpdateDateIndustries ON Industries AFTER UPDATE  AS  BEGIN UPDATE Industries SET AutomaticLastUpdateDate = GETDATE() WHERE Id IN (SELECT DISTINCT Id FROM Inserted)END;
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Trigger>