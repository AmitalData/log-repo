<?xml version="1.0" encoding="utf-8"?>
<Trigger
  DBType="Main"
  Name="TriggerOnCreate_AutomaticLastUpdateDateCountries"
  Schema="dbo"
  Module="Common">
  <SqlScript><![CDATA[
CREATE TRIGGER TriggerOnCreate_AutomaticLastUpdateDateCountries ON Countries AFTER Insert  AS  BEGIN UPDATE Countries SET AutomaticLastUpdateDate = GETDATE() WHERE Id IN (SELECT DISTINCT Id FROM Inserted)END;
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Trigger>