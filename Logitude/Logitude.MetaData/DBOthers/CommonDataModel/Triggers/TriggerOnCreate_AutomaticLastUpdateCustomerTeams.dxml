<?xml version="1.0" encoding="utf-8"?>
<Trigger
  DBType="Main"
  Name="TriggerOnCreate_AutomaticLastUpdateCustomerTeams"
  Schema="dbo"
  Module="Common">
  <SqlScript>
    <![CDATA[
CREATE TRIGGER TriggerOnCreate_AutomaticLastUpdateCustomerTeams ON CustomerTeams AFTER Insert  AS  BEGIN UPDATE CustomerTeams SET AutomaticLastUpdateDate = GETDATE() WHERE Id IN (SELECT DISTINCT Id FROM Inserted)END;
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Trigger>