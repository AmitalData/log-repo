<?xml version="1.0" encoding="utf-8"?>
<Trigger
  DBType="Main"
  Name="Trigger_AutomaticLastUpdateDatePackageTypes"
  Schema="dbo"
  Module="Common">
  <SqlScript>
  <![CDATA[
CREATE TRIGGER Trigger_AutomaticLastUpdateDatePackageTypes ON PackageTypes AFTER UPDATE  AS  BEGIN

SET NOCOUNT ON;

IF TRIGGER_NESTLEVEL() > 1 RETURN;

IF (SELECT program_name FROM sys.dm_exec_sessions WHERE session_id = (SELECT @@SPID)) <> 'ZeroDownTimeDBMigrationsTool'
BEGIN
UPDATE PackageTypes SET AutomaticLastUpdateDate = GETDATE() WHERE Id IN (SELECT DISTINCT Id FROM Inserted);
END;

END;
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Trigger>