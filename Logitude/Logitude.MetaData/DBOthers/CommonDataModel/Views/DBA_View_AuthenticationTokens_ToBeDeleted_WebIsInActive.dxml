<View DBType="Main" Name="DBA_View_AuthenticationTokens_ToBeDeleted_WebIsInActive" Schema="dbo" Module="Common">
  <SqlScript>
    <![CDATA[

create VIEW [dbo].[DBA_View_AuthenticationTokens_ToBeDeleted_WebIsInActive] AS  
	SELECT   TOP 1000 *
	FROM [dbo].[AuthenticationTokens]
	WHERE ClientType='Web' and (InActive =1)
	and InActiveDate < DATEADD(DAY, -10, GETDATE())
	order by InActiveDate
    ]]>
  </SqlScript>
  <OracleScript>
  </OracleScript>
</View>