<?xml version="1.0" encoding="utf-8"?>
<Trigger
  DBType="Main"
  Name="TriggerOnCreate_AutomaticLastUpdateDateObjectFields"
  Schema="dbo"
  Module="Infrastructure">
  <SqlScript><![CDATA[
CREATE TRIGGER TriggerOnCreate_AutomaticLastUpdateDateObjectFields ON ObjectFields AFTER Insert  AS  BEGIN UPDATE ObjectFields SET AutomaticLastUpdateDate = GETDATE() WHERE Id IN (SELECT DISTINCT Id FROM Inserted)END;
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Trigger>