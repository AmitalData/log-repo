<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="DeleteOldBIReportsExecutionLogs"
  Schema="dbo"
  Module="Infrastructure">
	<SqlScript>
		<![CDATA[
create procedure [dbo].[DeleteOldBIReportsExecutionLogs] as
IF OBJECT_ID('tempdb..#tblOldBIReportsExecutionLogs') IS NOT NULL
DROP TABLE #tblOldBIReportsExecutionLogs
CREATE TABLE #tblOldBIReportsExecutionLogs
(
Id varchar(15) NOT NULL PRIMARY KEY
)
INSERT #tblOldBIReportsExecutionLogs (Id)
SELECT Id
FROM [dbo].[BIReportsExecutionLogs]
WHERE CreateDate < DATEADD(MONTH,-6,GETDATE())
if(@@ROWCOUNT >0 )
begin
declare @skiprows int
declare @Rows int
set @Rows = 1
set @skiprows = 0
while (@Rows <> 0)
BEGIN
DELETE
FROM [dbo].[BIReportsExecutionLogs]
where [Id] in (
select  Id
from #tblOldBIReportsExecutionLogs
order by Id
OFFSET ( @skiprows * 5000) ROWS FETCH NEXT 5000 ROWS ONLY
)
SET @Rows = @@ROWCOUNT
print @Rows
set @skiprows = @skiprows + 1
print @skiprows
WAITFOR DELAY '00:00:02'
END
end
DROP TABLE #tblOldBIReportsExecutionLogs
]]>
	</SqlScript>
	<OracleScript>
	</OracleScript>
</Procedure>