<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Global"
  Name="DeleteOldAnalyzeQueues"
  Schema="dbo"
  Module="Infrastructure">
	<SqlScript>
		<![CDATA[
CREATE procedure [dbo].[DeleteOldAnalyzeQueues] as
declare @Rows int
set @Rows = 11

while (@Rows >10)
BEGIN

DELETE
FROM [dbo].[DBA_View_AnalyzeQueues_ToBeDeleted]

set @Rows= @@ROWCOUNT

WAITFOR DELAY '00:00:05'
END
]]>
	</SqlScript>
	<OracleScript>
	</OracleScript>
</Procedure>