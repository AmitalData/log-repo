<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Global"
  Name="DeleteOldAnalyzeQueues"
  Schema="dbo"
  Module="Infrastructure">
	<SqlScript>
		<![CDATA[
CREATE procedure [dbo].[DeleteOldAnalyzeQueues] as
IF OBJECT_ID('tempdb..#tblOldAnalyzeQueues') IS NOT NULL
DROP TABLE #tblOldAnalyzeQueues
CREATE TABLE #tblOldAnalyzeQueues
(
Id varchar(15) NOT NULL PRIMARY KEY
)
INSERT #tblOldAnalyzeQueues (Id)
SELECT Id
FROM [dbo].[AnalyzeQueues]
WHERE [CreateDate] < DATEADD(MONTH,-6,GETDATE())
if(@@ROWCOUNT >0 )
begin
declare @skiprows int
declare @Rows int
set @Rows = 1
set @skiprows = 0
while (@Rows <> 0)
BEGIN
DELETE
FROM [dbo].[AnalyzeQueues]
where [Id] in (
select  id
from #tblOldAnalyzeQueues
order by Id
OFFSET ( @skiprows * 5000) ROWS FETCH NEXT 5000 ROWS ONLY
)
SET @Rows = @@ROWCOUNT
print @Rows
set @skiprows = @skiprows + 1
print @skiprows
WAITFOR DELAY '00:00:02'
END
end
DROP TABLE #tblOldAnalyzeQueues
]]>
	</SqlScript>
	<OracleScript>
	</OracleScript>
</Procedure>