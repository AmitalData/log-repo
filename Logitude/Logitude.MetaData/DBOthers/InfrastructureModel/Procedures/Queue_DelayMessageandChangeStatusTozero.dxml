<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="Queue_DelayMessageandChangeStatusTozero"
  Schema="dbo"
  Module="Infrastructure">
  <SqlScript>
  <![CDATA[
Create procedure [dbo].[Queue_DelayMessageandChangeStatusTozero]
(
   @V_MessageId bigint,
   @V_DelaySeconds int
)
 as begin

IF exists (SELECT [Id]
FROM [dbo].[QueueMessages] WITH (UPDLOCK) WHERE  [ID] = @V_MessageId)

BEGIN
UPDATE [dbo].[QueueMessages]
SET  [NextRunDateTime] = dateadd(second,@V_DelaySeconds,getdate()),[Status] = 0
WHERE [Id] = @V_MessageId and [Status] <> 0

UPDATE [dbo].[QueueMessageMoreDetails]
SET  [NextRunDateTime] = dateadd(second,@V_DelaySeconds,getdate()),[Status] = 0
WHERE [Id] = @V_MessageId and [Status] <> 0
END


end
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Procedure>