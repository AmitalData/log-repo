<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="SystemLogs"
  Name="DeleteOldErrorLog"
  Schema="dbo"
  Module="Infrastructure">
  <SqlScript>
	  <![CDATA[
CREATE procedure [dbo].[DeleteOldErrorLog]
as
begin
declare @Rows int
set @Rows = 11

while (@Rows > 10)
BEGIN

DELETE
FROM [dbo].[DBA_View_ErrorLogs_ToBeDeleted]

set @Rows= @@ROWCOUNT

WAITFOR DELAY '00:00:05'
END

end
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Procedure>