<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="usp_GetNextTableCodeValueWithSnapShot"
  Schema="dbo"
  Module="Infrastructure">
  <SqlScript>
    <![CDATA[
CREATE PROCEDURE [dbo].[usp_GetNextTableCodeValueWithSnapShot]
(
@pLastNumber INT OUTPUT,
@pTableName    nvarchar(40),
@pTenant    INT
)
AS
SET TRANSACTION ISOLATION LEVEL SNAPSHOT
DECLARE @COUNTER AS INT
SET @COUNTER = 1000
Declare @Current As Int
IF NOT EXISTS (SELECT TableName
FROM CounterLastNumbers with (rowlock,UPDLOCK) WHERE TableName =@pTableName AND Tenant = @pTenant)
BEGIN;
IF(@pTableName = 'Tenant')
Begin;
SET @COUNTER = 0
INSERT INTO CounterLastNumbers
(
TableName,
Tenant,
LastNumber
)
VALUES
(
@pTableName,
@pTenant,
@COUNTER
)
Set @Current = 0
End
Else
Begin
SET @COUNTER = 1000
IF(@pTableName = 'Agent')
begin
SET @COUNTER = 10000
end
IF(@pTableName = 'CustomAgent')
begin
SET @COUNTER = 20000
end
IF(@pTableName = 'ShippingAgent')
begin
SET @COUNTER = 30000
end
IF(@pTableName = 'Customer')
begin
SET @COUNTER = 70000
end
INSERT INTO CounterLastNumbers
(
TableName,
Tenant,
LastNumber
)
VALUES
(
@pTableName,
@pTenant,
@COUNTER
)
Set @Current = @COUNTER
End
End;
Else
BEGIN;
Set @Current    = (SELECT  LastNumber
FROM CounterLastNumbers with (rowlock,UPDLOCK) WHERE TableName =@pTableName AND Tenant = @pTenant)
Set @Current = @Current + 1
Update CounterLastNumbers
set LastNumber = @Current
Where TableName = @pTableName and Tenant = @pTenant
End;
Set @pLastNumber = @Current

]]></SqlScript>
  <OracleScript>
   
  </OracleScript>
</Procedure>