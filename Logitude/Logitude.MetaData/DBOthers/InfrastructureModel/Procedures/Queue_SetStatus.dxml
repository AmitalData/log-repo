<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="Queue_SetStatus"
  Schema="dbo"
  Module="Infrastructure">
  <SqlScript_><![CDATA[
CREATE procedure [dbo].[Queue_SetStatus]
(
   @MessageId bigint,
   @Statud int
)
 as begin

IF exists (SELECT [Id]
FROM [dbo].[QueueMessages] WITH (UPDLOCK) WHERE  [Id] = @MessageId)

BEGIN
UPDATE [dbo].[QueueMessages]
SET  [Status] = @Statud,[CompleteDateTime] = getdate()
WHERE [Id] = @MessageId

UPDATE [dbo].[QueueMessageMoreDetails]
SET  [Status] = @Statud,[CompleteDateTime] = getdate()
WHERE [Id] = @MessageId

END


end
]]></SqlScript_>
	<SqlScript>
		<![CDATA[
CREATE PROCEDURE dbo.Queue_SetStatus  
--- CustomsBranch- Translate from Oracle!!
  

   @V_MESSAGEID   BigInt,
   

   @V_STATUD Int
AS 
   BEGIN

      /*--INSERT INTO ZQUEUE_SETSTATUS (ID, STATUS, COMPLETEDATETIME) VALUES (v_messageid, v_statud,sysdate  );*/
      DELETE dbo.QUEUEMESSAGES
      WHERE QUEUEMESSAGES.ID = @V_MESSAGEID AND @V_STATUD = 1

      UPDATE dbo.QUEUEMESSAGES
         SET 
            COMPLETEDATETIME = sysdatetime(), 
            STATUS = @V_STATUD
      WHERE QUEUEMESSAGES.ID = @V_MESSAGEID AND @V_STATUD != 1

      UPDATE dbo.QUEUEMESSAGEMOREDETAILS
         SET 
            STATUS = @V_STATUD, 
            COMPLETEDATETIME = sysdatetime()
      WHERE QUEUEMESSAGEMOREDETAILS.ID = @V_MESSAGEID

   END



]]>
	</SqlScript>
  <OracleScript>
    create or replace PROCEDURE queue_setstatus (
    v_messageid   IN   NUMBER,
    v_statud      IN   NUMBER
    ) AS
    BEGIN
    ----INSERT INTO ZQUEUE_SETSTATUS (ID, STATUS, COMPLETEDATETIME) VALUES (v_messageid, v_statud,sysdate  );
    delete  /*+ rule */  from queuemessages where id = v_messageid and v_statud =1;
    Update queuemessages set completedatetime = sysdate, status=v_statud where id = v_messageid and v_statud!=1;

    UPDATE queuemessagemoredetails
    SET          status = v_statud,         completedatetime = SYSDATE
    WHERE      id = v_messageid;

    END;
  </OracleScript>
</Procedure>