<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="usp_ChangeTenantProfitCurrency"
  Schema="dbo"
  Module="Infrastructure">
  <SqlScript>
    <![CDATA[
    
    

CREATE PROCEDURE [dbo].[usp_ChangeTenantProfitCurrency]
(
  @Tenant AS INT,
  @NewCurrencyCode AS VARCHAR(30)
)
AS

declare @NewProfitCurrencyId as varchar(15)
declare @CurrentLocalCurrencyId as varchar(15)

set @NewProfitCurrencyId = (select Id from Currencies where Tenant = @Tenant and Code = @NewCurrencyCode)
set @CurrentLocalCurrencyId = (select CurrencyId from Tenants where Id = @Tenant)

if not exists (select * from Tenants where Id = @Tenant)
begin
       print 'Error 01: This Tenant is not exists!'
end

else if not exists (select * from Currencies where Tenant = @Tenant and Id = @NewProfitCurrencyId)
begin
       print 'Error 02: This Currency is not exists!'
end

else if (@CurrentLocalCurrencyId != @NewProfitCurrencyId) AND not exists (select * from RatesTables where Tenant = @Tenant and BaseCurrencyId = @CurrentLocalCurrencyId and ForeignCurrencyId = @NewProfitCurrencyId)
begin
       print 'Error 03: The new Profit Currency has no rates in this Tenant'
end

else
begin
       SET NOCOUNT ON
       print 'Starting...'       
       update Shipments set ProfitCurrencyId = @NewProfitCurrencyId where Tenant = @Tenant
       update ARInvoices set ProfitCurrencyId = @NewProfitCurrencyId where Tenant = @Tenant
       update APInvoices set ProfitCurrencyId = @NewProfitCurrencyId where Tenant = @Tenant

       -- Update Shipments
       BEGIN
              declare @ShipmentId as varchar(15)
              declare @ShipmentDate as datetime 

              update ShipmentReceivables set UpdateDate = CreateDate where UpdateDate is null and Tenant = @Tenant
              update ShipmentPayables set UpdateDate = CreateDate where UpdateDate is null and Tenant = @Tenant

              DECLARE ShipmentsCursor CURSOR READ_ONLY
              FOR
              SELECT Id, CreateDateTime
              FROM Shipments
              WHERE Tenant = @Tenant
              OPEN ShipmentsCursor FETCH NEXT FROM ShipmentsCursor INTO @ShipmentId,@ShipmentDate
              WHILE @@FETCH_STATUS = 0
                     BEGIN
                           
                           declare @ShipmentRate as float
                           set @ShipmentRate = dbo.GetLastRate(@Tenant,@ShipmentDate,@CurrentLocalCurrencyId,@NewProfitCurrencyId)
                           update Shipments set ProfitExchangeRate = @ShipmentRate where Id = @ShipmentId and Tenant = @Tenant

                           -- Update Receivables
                           BEGIN
                                  declare @ReceivableId as varchar(15)
                                  declare @ReceivableDate as datetime
                                  declare @ReceivableCurrencyId as varchar(15)
                                  declare @ReceivableAmount as float
                                  declare @ReceivableAmountInLocal as float                                   
                                  
                                  DECLARE ReceivablesCursor CURSOR READ_ONLY
                                  FOR
                                  SELECT Id, UpdateDate, CurrencyId, TotalAmount, TotalAmountLocal
                                  FROM ShipmentReceivables
                                  WHERE Tenant = @Tenant and ShipmentId = @ShipmentId
                                  OPEN ReceivablesCursor FETCH NEXT FROM ReceivablesCursor INTO @ReceivableId,@ReceivableDate,@ReceivableCurrencyId,@ReceivableAmount,@ReceivableAmountInLocal
                                  WHILE @@FETCH_STATUS = 0
                                         BEGIN
                                         
                                                declare @ReceivableRate as float
                                                declare @ReceivableAmountInProfit as float

                                                set @ReceivableRate = dbo.GetLastRate(@Tenant,@ReceivableDate,@CurrentLocalCurrencyId,@NewProfitCurrencyId)

                                                if (@ReceivableCurrencyId = @NewProfitCurrencyId)
                                                set @ReceivableAmountInProfit = @ReceivableAmount

                                                else if (@CurrentLocalCurrencyId = @NewProfitCurrencyId)
                                                set @ReceivableAmountInProfit = @ReceivableAmountInLocal

                                                else
                                                set @ReceivableAmountInProfit = ROUND(@ReceivableAmountInLocal / @ReceivableRate,2)

                                                update ShipmentReceivables 
                                                set ProfitCurrencyExchangeRate = @ReceivableRate,
                                                AmountInProfitCurrency = @ReceivableAmountInProfit
                                                where Id = @ReceivableId and ShipmentId = @ShipmentId and Tenant = @Tenant
                                         
                                         FETCH NEXT FROM ReceivablesCursor INTO @ReceivableId,@ReceivableDate,@ReceivableCurrencyId,@ReceivableAmount,@ReceivableAmountInLocal
                                         END
                                  CLOSE ReceivablesCursor
                                  DEALLOCATE ReceivablesCursor
                           END

                           -- Update Payables
                           BEGIN
                                  declare @PayableId as varchar(15)
                                  declare @PayableDate as datetime
                                  declare @PayableCurrencyId as varchar(15)                                   
                                  declare @PayableOpenAmount as float
                                  declare @PayableExpectedAmount as float
                                  declare @PayableAccountedAmount as float
                                  declare @PayableOpenAmountInLocal as float
                                  declare @PayableExpectedAmountInLocal as float
                                  declare @PayableAccountedAmountInLocal as float

                                  DECLARE PayablesCursor CURSOR READ_ONLY
                                  FOR
                                  SELECT Id, UpdateDate, CurrencyId, OpenAmount, ExpectedAmount, AccountedAmount, OpenAmountInLocalCurrency, ExpectedAmountLocal, AccountedAmountInLocalCurrency
                                  FROM ShipmentPayables
                                  WHERE Tenant = @Tenant and ShipmentId = @ShipmentId
                                  OPEN PayablesCursor FETCH NEXT FROM PayablesCursor INTO @PayableId,@PayableDate,@PayableCurrencyId,@PayableOpenAmount,@PayableExpectedAmount,@PayableAccountedAmount,@PayableOpenAmountInLocal,@PayableExpectedAmountInLocal,@PayableAccountedAmountInLocal
                                  WHILE @@FETCH_STATUS = 0
                                         BEGIN

                                                declare @PayableRate as float
                                                declare @PayableOpenAmountInProfit as float
                                                declare @PayableExpectedAmountInProfit as float
                                                declare @PayableAccountedAmountInProfit as float

                                                set @PayableRate = dbo.GetLastRate(@Tenant,@PayableDate,@CurrentLocalCurrencyId,@NewProfitCurrencyId)

                                                if (@PayableCurrencyId = @NewProfitCurrencyId)
                                                begin
                                                set @PayableOpenAmountInProfit = @PayableOpenAmount
                                                set @PayableExpectedAmountInProfit = @PayableExpectedAmount
                                                set @PayableAccountedAmountInProfit = @PayableAccountedAmount
                                                end
                                         
                                                else if (@CurrentLocalCurrencyId = @NewProfitCurrencyId)
                                                begin
                                                set @PayableOpenAmountInProfit = @PayableOpenAmountInLocal
                                                set @PayableExpectedAmountInProfit = @PayableExpectedAmountInLocal
                                                set @PayableAccountedAmountInProfit = @PayableAccountedAmountInLocal
                                                end

                                                else
                                                begin
                                                set @PayableOpenAmountInProfit = ROUND(@PayableOpenAmountInLocal / @PayableRate,2)
                                                set @PayableExpectedAmountInProfit = ROUND(@PayableExpectedAmountInLocal / @PayableRate,2)
                                                set @PayableAccountedAmountInProfit = ROUND(@PayableAccountedAmountInLocal / @PayableRate,2)
                                                end

                                                update ShipmentPayables 
                                                set ProfitCurrencyExchangeRate = @PayableRate,
                                                OpenAmountInProfitCurrency = @PayableOpenAmountInProfit,
                                                ExpectedAmountInProfitCurrency = @PayableExpectedAmountInProfit,
                                                AccountedAmountInProfitCurrency = @PayableAccountedAmountInProfit
                                                where Id = @PayableId and ShipmentId = @ShipmentId and Tenant = @Tenant

                                         FETCH NEXT FROM PayablesCursor INTO @PayableId,@PayableDate,@PayableCurrencyId,@PayableOpenAmount,@PayableExpectedAmount,@PayableAccountedAmount,@PayableOpenAmountInLocal,@PayableExpectedAmountInLocal,@PayableAccountedAmountInLocal
                                         END
                                  CLOSE PayablesCursor
                                  DEALLOCATE PayablesCursor
                           END

                           EXECUTE usp_UpdateShipmentProfit @ShipmentId

                     FETCH NEXT FROM ShipmentsCursor INTO @ShipmentId,@ShipmentDate
                     END
              CLOSE ShipmentsCursor
              DEALLOCATE ShipmentsCursor
       END

       -- Update AR_Invoices
       BEGIN
              declare @ARInvoiceId as varchar(15)
              declare @ARInvoiceDate as datetime       
              declare @ARInvoiceCurrencyId as varchar(15)
              declare @ARInvoiceAmount as float
              declare @ARInvoiceAmountDue as float
              declare @ARInvoiceAmountInLocal as float
              declare @ARInvoiceAmountDueInLocal as float

              update ARInvoices set InvoiceDate = CreateDate where InvoiceDate is null and Tenant = @Tenant

              DECLARE ARInvoicesCursor CURSOR READ_ONLY
              FOR
              SELECT Id, InvoiceDate, InvoiceCurrencyId, AmountInInvoiceCurrency, AmountDue, AmountInLocalCurrency, AmountDueInLocalCurrency
              FROM ARInvoices
              WHERE Tenant = @Tenant
              OPEN ARInvoicesCursor FETCH NEXT FROM ARInvoicesCursor INTO @ARInvoiceId,@ARInvoiceDate,@ARInvoiceCurrencyId,@ARInvoiceAmount,@ARInvoiceAmountDue,@ARInvoiceAmountInLocal,@ARInvoiceAmountDueInLocal
              WHILE @@FETCH_STATUS = 0
                     BEGIN

                           declare @ARInvoiceRate as float
                           declare @ARInvoiceAmountInProfit as float
                           declare @ARInvoiceAmountDueInProfit as float

                           set @ARInvoiceRate = dbo.GetLastRate(@Tenant,@ARInvoiceDate,@CurrentLocalCurrencyId,@NewProfitCurrencyId)                   
                                                       
                           -- Update ARInvoiceLines
                           BEGIN
                                  declare @ARInvoiceLineId as varchar(15)
                                  declare @ARInvoiceLineCurrencyId as varchar(15)
                                  declare @ARInvoiceLineAmount as float
                                  declare @ARInvoiceLineAmountInLocal as float
                                                                                                                                  
                                  DECLARE ARInvoiceLinesCursor CURSOR READ_ONLY
                                  FOR
                                  SELECT Id, ForiegnCurrencyId, ForiegnCurrencyAmount, LocalCurrencyAmount
                                  FROM ARInvoiceLines
                                  WHERE Tenant = @Tenant and ARInvoiceId = @ARInvoiceId
                                  OPEN ARInvoiceLinesCursor FETCH NEXT FROM ARInvoiceLinesCursor INTO @ARInvoiceLineId,@ARInvoiceLineCurrencyId,@ARInvoiceLineAmount,@ARInvoiceLineAmountInLocal
                                  WHILE @@FETCH_STATUS = 0
                                         BEGIN
                                         
                                                declare @ARInvoiceLineAmountInProfit as float

                                                if (@ARInvoiceLineCurrencyId = @NewProfitCurrencyId)
                                                set @ARInvoiceLineAmountInProfit = @ARInvoiceLineAmount

                                                else if (@CurrentLocalCurrencyId = @NewProfitCurrencyId)
                                                set @ARInvoiceLineAmountInProfit = @ARInvoiceLineAmountInLocal

                                                else
                                                set @ARInvoiceLineAmountInProfit = ROUND(@ARInvoiceLineAmountInLocal / @ARInvoiceRate,2)

                                                update ARInvoiceLines
                                                set ProfitCurrencyAmount = @ARInvoiceLineAmountInProfit
                                                where Id = @ARInvoiceLineId and ARInvoiceId = @ARInvoiceId and Tenant = @Tenant
                                         
                                         FETCH NEXT FROM ARInvoiceLinesCursor INTO @ARInvoiceLineId,@ARInvoiceLineCurrencyId,@ARInvoiceLineAmount,@ARInvoiceLineAmountInLocal
                                         END
                                  CLOSE ARInvoiceLinesCursor
                                  DEALLOCATE ARInvoiceLinesCursor
                           END

                           if (@ARInvoiceCurrencyId = @NewProfitCurrencyId)
                           begin
                           set @ARInvoiceAmountInProfit = @ARInvoiceAmount
                           set @ARInvoiceAmountDueInProfit = @ARInvoiceAmountDue
                           end

                           else if (@CurrentLocalCurrencyId = @NewProfitCurrencyId)
                           begin
                           set @ARInvoiceAmountInProfit = @ARInvoiceAmountInLocal
                           set @ARInvoiceAmountDueInProfit = @ARInvoiceAmountDueInLocal
                           end

                           else
                           begin
                           set @ARInvoiceAmountInProfit = ROUND(@ARInvoiceAmountInLocal / @ARInvoiceRate,2)
                           set @ARInvoiceAmountDueInProfit = ROUND(@ARInvoiceAmountDueInLocal / @ARInvoiceRate,2)
                           end

                           update ARInvoices 
                           set ProfitCurrencyExchangeRate = @ARInvoiceRate,
                           AmountInProfitCurrency = @ARInvoiceAmountInProfit,
                           AmountDueInProfitCurrency = @ARInvoiceAmountDueInProfit
                           where Id = @ARInvoiceId and Tenant = @Tenant

                     FETCH NEXT FROM ARInvoicesCursor INTO @ARInvoiceId,@ARInvoiceDate,@ARInvoiceCurrencyId,@ARInvoiceAmount,@ARInvoiceAmountDue,@ARInvoiceAmountInLocal,@ARInvoiceAmountDueInLocal
                     END
              CLOSE ARInvoicesCursor
              DEALLOCATE ARInvoicesCursor
       END

       -- Update AP_Invoices
       BEGIN
              declare @APInvoiceId as varchar(15)
              declare @APInvoiceDate as datetime
              declare @APInvoiceCurrencyId as varchar(15)
              declare @APInvoiceAmount as float
              declare @APInvoiceAmountDue as float
              declare @APInvoiceAmountInLocal as float
              declare @APInvoiceAmountDueInLocal as float            

              update APInvoices set InvoiceDate = CreateDate where InvoiceDate is null and Tenant = @Tenant

              DECLARE APInvoicesCursor CURSOR READ_ONLY
              FOR
              SELECT Id, InvoiceDate, InvoiceCurrencyId, AmountInInvoiceCurrency, AmountDue, AmountInLocalCurrency, AmountDueInLocalCurrency
              FROM APInvoices
              WHERE Tenant = @Tenant
              OPEN APInvoicesCursor FETCH NEXT FROM APInvoicesCursor INTO @APInvoiceId,@APInvoiceDate,@APInvoiceCurrencyId,@APInvoiceAmount,@APInvoiceAmountDue,@APInvoiceAmountInLocal,@APInvoiceAmountDueInLocal
              WHILE @@FETCH_STATUS = 0
                     BEGIN
                           
                           declare @APInvoiceRate as float
                           declare @APInvoiceAmountInProfit as float
                           declare @APInvoiceAmountDueInProfit as float

                           set @APInvoiceRate = dbo.GetLastRate(@Tenant,@APInvoiceDate,@CurrentLocalCurrencyId,@NewProfitCurrencyId)
                                                       
                           -- Update APInvoiceLines
                           BEGIN
                                  declare @APInvoiceLineNumber as varchar(15)
                                  declare @APInvoiceLineCurrencyId as varchar(15)
                                  declare @APInvoiceLineAmount as float
                                  declare @APInvoiceLineAmountInLocal as float
                                                                                                                                  
                                  declare APInvoiceLinesCursor CURSOR READ_ONLY
                                  FOR
                                  SELECT LineNumber, ForiegnCurrencyId , ForiegnCurrencyAmount, LocalCurrencyAmount
                                  FROM APInvoiceLines
                                  WHERE Tenant = @Tenant and APInvoiceId = @APInvoiceId
                                  OPEN APInvoiceLinesCursor FETCH NEXT FROM APInvoiceLinesCursor INTO @APInvoiceLineNumber,@APInvoiceLineCurrencyId,@APInvoiceLineAmount,@APInvoiceLineAmountInLocal
                                  WHILE @@FETCH_STATUS = 0
                                         BEGIN
                                         
                                                declare @APInvoiceLineAmountInProfit as float

                                                if (@APInvoiceLineCurrencyId = @NewProfitCurrencyId)
                                                set @APInvoiceLineAmountInProfit = @APInvoiceLineAmount

                                                else if (@CurrentLocalCurrencyId = @NewProfitCurrencyId)
                                                set @APInvoiceLineAmountInProfit = @APInvoiceLineAmountInLocal

                                                else
                                                set @APInvoiceLineAmountInProfit = ROUND(@APInvoiceLineAmountInLocal / @APInvoiceRate,2)

                                                update APInvoiceLines
                                                set ProfitCurrencyAmount = @APInvoiceLineAmountInProfit
                                                where LineNumber = @APInvoiceLineNumber and APInvoiceId = @APInvoiceId and Tenant = @Tenant
                                         
                                         FETCH NEXT FROM APInvoiceLinesCursor INTO @APInvoiceLineNumber,@APInvoiceLineCurrencyId,@APInvoiceLineAmount,@APInvoiceLineAmountInLocal
                                         END
                                  CLOSE APInvoiceLinesCursor
                                  DEALLOCATE APInvoiceLinesCursor
                           END

                           if (@APInvoiceCurrencyId = @NewProfitCurrencyId)
                           begin
                           set @APInvoiceAmountInProfit = @APInvoiceAmount
                           set @APInvoiceAmountDueInProfit = @APInvoiceAmountDue
                           end

                           else if (@CurrentLocalCurrencyId = @NewProfitCurrencyId)
                           begin
                           set @APInvoiceAmountInProfit = @APInvoiceAmountInLocal
                           set @APInvoiceAmountDueInProfit = @APInvoiceAmountDueInLocal
                           end

                           else
                           begin
                           set @APInvoiceAmountInProfit = ROUND(@APInvoiceAmountInLocal / @APInvoiceRate,2)
                           set @APInvoiceAmountDueInProfit = ROUND(@APInvoiceAmountDueInLocal / @APInvoiceRate,2)
                           end

                           update APInvoices
                           set ProfitCurrencyExchangeRate = @APInvoiceRate,
                           AmountInProfitCurrency = @APInvoiceAmountInProfit,
                           AmountDueInProfitCurrency = @APInvoiceAmountDueInProfit
                           where Id = @APInvoiceId and Tenant = @Tenant

                     FETCH NEXT FROM APInvoicesCursor INTO @APInvoiceId,@APInvoiceDate,@APInvoiceCurrencyId,@APInvoiceAmount,@APInvoiceAmountDue,@APInvoiceAmountInLocal,@APInvoiceAmountDueInLocal
                     END
              CLOSE APInvoicesCursor
              DEALLOCATE APInvoicesCursor
       END

       print 'End Successfully...'
       SET NOCOUNT OFF
end

    
]]>
</SqlScript>
<OracleScript>
</OracleScript>
</Procedure>