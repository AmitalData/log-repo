<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="usp_ChangeTenantLocalCurrency_APInvoices"
  Schema="dbo"
  Module="Infrastructure">
  <SqlScript>
    <![CDATA[
    
CREATE PROCEDURE [dbo].[usp_ChangeTenantLocalCurrency_APInvoices]
(
  @Tenant AS INT,
  @NewCurrencyCode AS VARCHAR(30)
)
AS

SET NOCOUNT ON

declare @IsRunningScript as bit
set @IsRunningScript = 0

declare @LocalCurrencyId as varchar(15)
set @LocalCurrencyId = (select Id from Currencies where Tenant = @Tenant and Code = @NewCurrencyCode)

if not exists (select * from Tenants where Id = @Tenant)
begin
       print 'Error 01: This Tenant is not exists!'
end

else if not exists (select * from Currencies where Tenant = @Tenant and Id = @LocalCurrencyId)
begin
       print 'Error 02: This Currency is not exists!'
end

else
begin
		
	declare @CurrencyId as varchar(15)
	declare @CurrencyName as varchar(40)
	declare @AllCurrenciesRatesExists as bit
	set @AllCurrenciesRatesExists = 1

	DECLARE CurrenciesCursor CURSOR READ_ONLY
	FOR
	SELECT Id, EnglishName
	FROM Currencies
	WHERE Tenant = @Tenant
	OPEN CurrenciesCursor FETCH NEXT FROM CurrenciesCursor INTO @CurrencyId, @CurrencyName
	WHILE @@FETCH_STATUS = 0
	BEGIN

		if (@CurrencyId != @LocalCurrencyId) AND not exists (select * from RatesTables where Tenant = @Tenant and BaseCurrencyId = @LocalCurrencyId and ForeignCurrencyId = @CurrencyId)
		begin
			set @AllCurrenciesRatesExists = 0
			print 'Error 03: ' + @CurrencyName + ' Currency has no rates in this Tenant'
		end		

	FETCH NEXT FROM CurrenciesCursor INTO @CurrencyId, @CurrencyName	
	END
	CLOSE CurrenciesCursor
	DEALLOCATE CurrenciesCursor

	IF (@AllCurrenciesRatesExists = 1)
	set @IsRunningScript = 1
end

IF (@IsRunningScript = 1)
BEGIN

	print 'Start...'	
	update Tenants set CurrencyId = @LocalCurrencyId where Id = @Tenant and CurrencyId <> @LocalCurrencyId

	-- Invoices
	BEGIN

		update APInvoices set LocalCurrencyId = @LocalCurrencyId where Tenant = @Tenant
		update APInvoices set InvoiceDate = UpdateDate where InvoiceDate is null and Tenant = @Tenant
		update APInvoices set InvoiceDate = CreateDate where InvoiceDate is null and Tenant = @Tenant

		declare @InvoiceId as varchar(15)
		declare @InvoiceDate as datetime
		declare @InvoiceCurrencyId as varchar(15)
		declare @ProfitCurrencyId as varchar(15)
		declare @InvoiceCurrencyRate as float
		declare @ProfitCurrencyRate as float

		declare @SubTotal as float
		declare @SubTotalLocal as float
		declare @Amount as float
		declare @AmountLocal as float
		declare @AmountProfit as float
		declare @AmountDue as float
		declare @AmountDueLocal as float
		declare @AmountDueProfit as float

		DECLARE InvoicesCursor CURSOR READ_ONLY
		FOR
		SELECT Id, InvoiceDate, InvoiceCurrencyId, ProfitCurrencyId, SubTotalInInvoiceCurrency, AmountInInvoiceCurrency, AmountDue
		FROM APInvoices
		WHERE Tenant = @Tenant
		OPEN InvoicesCursor FETCH NEXT FROM InvoicesCursor INTO @InvoiceId, @InvoiceDate, @InvoiceCurrencyId, @ProfitCurrencyId, @SubTotal, @Amount, @AmountDue
		WHILE @@FETCH_STATUS = 0
		BEGIN

			-- Rate + AmountLocal
			if (@InvoiceCurrencyId = @LocalCurrencyId)
			begin
				set @InvoiceCurrencyRate = 1
				set @SubTotalLocal = @SubTotal
				set @AmountLocal = @Amount
				set @AmountDueLocal = @AmountDue
			end
			else
			begin
				set @InvoiceCurrencyRate = dbo.GetLastRate(@Tenant, @InvoiceDate, @LocalCurrencyId, @InvoiceCurrencyId)
				set @SubTotalLocal = @SubTotal * @InvoiceCurrencyRate
				set @AmountLocal = @Amount * @InvoiceCurrencyRate
				set @AmountDueLocal = @AmountDue * @InvoiceCurrencyRate
			end

			-- Profit Rate
			if (@ProfitCurrencyId = @InvoiceCurrencyId)
			begin
				set @ProfitCurrencyRate = dbo.GetLastRate(@Tenant, @InvoiceDate, @LocalCurrencyId, @ProfitCurrencyId)
				set @AmountProfit = @Amount
				set @AmountDueProfit = @AmountDue
			end
			else if (@ProfitCurrencyId = @LocalCurrencyId)
			begin
				set @ProfitCurrencyRate = 1
				set @AmountProfit = @AmountLocal
				set @AmountDueProfit = @AmountDueLocal
			end
			else
			begin
				set @ProfitCurrencyRate = dbo.GetLastRate(@Tenant, @InvoiceDate, @LocalCurrencyId, @ProfitCurrencyId)
				set @AmountProfit = @AmountLocal / @ProfitCurrencyRate
				set @AmountDueProfit = @AmountDueLocal / @ProfitCurrencyRate
			end

			-- Lines
			BEGIN

				declare @LineNumber as int
				declare @LineCurrencyId as varchar(15)
				declare @LineCurrencyRate as varchar(15)
				declare @LineAmount as float
				declare @LineAmountLocal as float
				declare @LineAmountProfit as float
				declare @LineAmountInvoice as float

				DECLARE LinesCursor CURSOR READ_ONLY
				FOR
				SELECT LineNumber, ForiegnCurrencyId, ForiegnCurrencyAmount
				FROM APInvoiceLines
				WHERE Tenant = @Tenant and APInvoiceId = @InvoiceId
				OPEN LinesCursor FETCH NEXT FROM LinesCursor INTO @LineNumber, @LineCurrencyId, @LineAmount
				WHILE @@FETCH_STATUS = 0
				BEGIN

					-- Rate + Local Amount
					if (@LineCurrencyId = @LocalCurrencyId)
					begin
						set @LineCurrencyRate = 1
						set @LineAmountLocal = @LineAmount
					end
					else
					begin
						set @LineCurrencyRate = dbo.GetLastRate(@Tenant, @InvoiceDate, @LocalCurrencyId, @LineCurrencyId)
						set @LineAmountLocal = @LineAmount * @LineCurrencyRate
					end

					-- Invoice Amount
					if (@LineCurrencyId = @InvoiceCurrencyId)
					begin
						set @LineAmountInvoice = @LineAmount
					end
					else
					begin
						set @LineAmountInvoice = @LineAmountLocal / @InvoiceCurrencyRate
					end

					-- Profit Amount
					if (@LineCurrencyId = @ProfitCurrencyId)
					begin
						set @LineAmountProfit = @LineAmount
					end
					else if (@ProfitCurrencyId = @LocalCurrencyId)
					begin
						set @LineAmountProfit = @LineAmountLocal
					end
					else
					begin
						set @LineAmountProfit = @LineAmountLocal / @ProfitCurrencyRate
					end

					update APInvoiceLines
					set
					ForiegnExchangeRate = Round(@LineCurrencyRate,5),
					LocalCurrencyAmount = Round(isnull(@LineAmountLocal,0.0),2),
					InvoiceCurrencyAmount = Round(isnull(@LineAmountInvoice,0.0),2),
					ProfitCurrencyAmount = Round(isnull(@LineAmountProfit,0.0),2)
					where LineNumber = @LineNumber and APInvoiceId = @InvoiceId and Tenant = @Tenant
				
				FETCH NEXT FROM LinesCursor INTO @LineNumber, @LineCurrencyId, @LineAmount
				END
				CLOSE LinesCursor
				DEALLOCATE LinesCursor
			END

			-- Total VATs
			BEGIN

				declare @NewId as varchar(15)
				declare @VatTypeId as varchar(15)
				declare @VatPercentage as float
				declare @VatableAmountInvoice as float
				declare @VatableAmountLocal as float
				declare @VatableAmountProfit as float
				declare @ExternalVATCard as varchar(25)
				declare @ExternalTAXItemId as varchar(25)

				declare @MemoryTable as table
				(
					VatTypeId varchar(15) not null,
					VatPercentage decimal(18, 2) null,
					VatableInvoice decimal(18, 2) null,
					VatableLocal decimal(18, 2) null,
					VatableProfit decimal(18, 2) null
				)

				delete from @MemoryTable
				delete from APInvoiceTotalVATs where APInvoiceId = @InvoiceId AND Tenant = @Tenant

				insert into @MemoryTable
				SELECT
				VatTypeId,
				VatPercentage,
				SUM(InvoiceCurrencyAmount),
				SUM(LocalCurrencyAmount),
				SUM(ProfitCurrencyAmount)				
				From APInvoiceLines
				Where APInvoiceId = @InvoiceId AND Tenant = @Tenant
				group by VatTypeId, VatPercentage
				 
				DECLARE VatsCursor CURSOR READ_ONLY
				FOR
				SELECT VatTypeId, VatPercentage, VatableInvoice, VatableLocal, VatableProfit
				FROM @MemoryTable				
				OPEN VatsCursor FETCH NEXT FROM VatsCursor INTO @VatTypeId, @VatPercentage, @VatableAmountInvoice, @VatableAmountLocal, @VatableAmountProfit
				WHILE @@FETCH_STATUS = 0
				BEGIN
				
					set @VatPercentage = Round(isnull(@VatPercentage,0),2)
					set @VatableAmountInvoice = Round(isnull(@VatableAmountInvoice,0),2)
					set @VatableAmountLocal = Round(isnull(@VatableAmountLocal,0),2)
					set @VatableAmountProfit = Round(isnull(@VatableAmountProfit,0),2)
					set @ExternalVATCard = (select ExternalVATCard from VatTypes where Tenant = @Tenant and Id = @VatTypeId)
					set @ExternalTAXItemId = (select ExternalTAXItemId from VatTypes where Tenant = @Tenant and Id = @VatTypeId)

					EXECUTE usp_GetNextTableIdValue @NewId OUTPUT,'APInvoiceTotalVAT'

					insert into APInvoiceTotalVATs
					(
						Id,
						Tenant,
						APInvoiceId,
						VatTypeId,
						VatPercent,
						InvoiceCurrencyVatableAmount,
						LocalVatableAmount,
						ProfitVatableAmount,
						InvoiceCurrencyVATAmount,
						LocalVATAmount,
						ProfitCurrencyVATAmount,
						ExternalVATCard,
						ExternalTAXItemId
					)

					values
					(
						@NewId,
						@Tenant,
						@InvoiceId,
						@VatTypeId,
						@VatPercentage,
						@VatableAmountInvoice,
						@VatableAmountLocal,
						@VatableAmountProfit,
						Round(@VatableAmountInvoice * @VatPercentage / 100,2),
						Round(@VatableAmountLocal * @VatPercentage / 100,2),
						Round(@VatableAmountProfit * @VatPercentage / 100,2),
						@ExternalVATCard,
						@ExternalTAXItemId
					)

				FETCH NEXT FROM VatsCursor INTO @VatTypeId, @VatPercentage, @VatableAmountInvoice, @VatableAmountLocal, @VatableAmountProfit
				END
				CLOSE VatsCursor
				DEALLOCATE VatsCursor								
			END

			-- Invoice Payments
			BEGIN

				declare @InvoicePaymentId as varchar(15)
				declare @InvoicePaymentCurrencyId as varchar(15)
				declare @InvoicePaymentAmount as float
				declare @InvoicePaymentAmountLocal as float

				DECLARE InvoicePaymentsCursor CURSOR READ_ONLY
				FOR
				SELECT Id, ForeignCurrencyId, ForeignAmount
				FROM APInvoicePayments
				Where APInvoiceId = @InvoiceId AND Tenant = @Tenant
				OPEN InvoicePaymentsCursor FETCH NEXT FROM InvoicePaymentsCursor INTO @InvoicePaymentId, @InvoicePaymentCurrencyId, @InvoicePaymentAmount
				WHILE @@FETCH_STATUS = 0
				BEGIN

					-- Local Amount
					if (@InvoicePaymentCurrencyId = @LocalCurrencyId)
					begin
						set @InvoicePaymentAmountLocal = @InvoicePaymentAmount
					end
					else
					begin						
						set @InvoicePaymentAmountLocal = @InvoicePaymentAmount * @InvoiceCurrencyRate
					end

					update APInvoicePayments
					set LocalAmount = Round(@InvoicePaymentAmountLocal,2)
					where Id = @InvoicePaymentId and APInvoiceId = @InvoiceId and Tenant = @Tenant

				FETCH NEXT FROM InvoicePaymentsCursor INTO @InvoicePaymentId, @InvoicePaymentCurrencyId, @InvoicePaymentAmount
				END
				CLOSE InvoicePaymentsCursor
				DEALLOCATE InvoicePaymentsCursor
			END

			update APInvoices
			set
			InvoiceCurrencyExchangeRate = Round(@InvoiceCurrencyRate, 5),
			ProfitCurrencyExchangeRate = Round(@ProfitCurrencyRate, 5),
			SubTotalInLocalCurrency = Round(@SubTotalLocal, 2),
			AmountInLocalCurrency = Round(@AmountLocal, 2),
			AmountInProfitCurrency = Round(@AmountProfit, 2),
			AmountDueInLocalCurrency = Round(@AmountDueLocal, 2),
			AmountDueInProfitCurrency = Round(@AmountDueProfit, 2)
			where Id = @InvoiceId and Tenant = @Tenant

		FETCH NEXT FROM InvoicesCursor INTO @InvoiceId, @InvoiceDate, @InvoiceCurrencyId, @ProfitCurrencyId, @SubTotal, @Amount, @AmountDue
		END
		CLOSE InvoicesCursor
		DEALLOCATE InvoicesCursor
	END

	print 'End Successfully...'
	SET NOCOUNT OFF
END
    
]]>
</SqlScript>
<OracleScript>
</OracleScript>
</Procedure>