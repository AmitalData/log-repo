<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="usp_ChangeTenantLocalCurrency_Shipments"
  Schema="dbo"
  Module="Infrastructure">
  <SqlScript>
    <![CDATA[

CREATE PROCEDURE [dbo].[usp_ChangeTenantLocalCurrency_Shipments]
(
  @Tenant AS INT,
  @NewCurrencyCode AS VARCHAR(30)
)
AS

SET NOCOUNT ON

declare @IsRunningScript as bit
set @IsRunningScript = 0

declare @LocalCurrencyId as varchar(15)
set @LocalCurrencyId = (select Id from Currencies where Tenant = @Tenant and Code = @NewCurrencyCode)

if not exists (select * from Tenants where Id = @Tenant)
begin
       print 'Error 01: This Tenant is not exists!'
end

else if not exists (select * from Currencies where Tenant = @Tenant and Id = @LocalCurrencyId)
begin
       print 'Error 02: This Currency is not exists!'
end

else
begin
		
	declare @CurrencyId as varchar(15)
	declare @CurrencyName as varchar(40)
	declare @AllCurrenciesRatesExists as bit
	set @AllCurrenciesRatesExists = 1

	DECLARE CurrenciesCursor CURSOR READ_ONLY
	FOR
	SELECT Id, EnglishName
	FROM Currencies
	WHERE Tenant = @Tenant
	OPEN CurrenciesCursor FETCH NEXT FROM CurrenciesCursor INTO @CurrencyId, @CurrencyName
	WHILE @@FETCH_STATUS = 0
	BEGIN

		if (@CurrencyId != @LocalCurrencyId) AND not exists (select * from RatesTables where Tenant = @Tenant and BaseCurrencyId = @LocalCurrencyId and ForeignCurrencyId = @CurrencyId)
		begin
			set @AllCurrenciesRatesExists = 0
			print 'Error 03: ' + @CurrencyName + ' Currency has no rates in this Tenant'
		end		

	FETCH NEXT FROM CurrenciesCursor INTO @CurrencyId, @CurrencyName	
	END
	CLOSE CurrenciesCursor
	DEALLOCATE CurrenciesCursor

	IF (@AllCurrenciesRatesExists = 1)
	set @IsRunningScript = 1
end

IF (@IsRunningScript = 1)
BEGIN

	print 'Start...'	
	update Tenants set CurrencyId = @LocalCurrencyId where Id = @Tenant and CurrencyId <> @LocalCurrencyId

	-- Shipments
	BEGIN
		
		update Shipments set LastUpdateDate = CreateDateTime where LastUpdateDate is null and Tenant = @Tenant
		update ShipmentPayables set UpdateDate = CreateDate where UpdateDate is null and Tenant = @Tenant
		update ShipmentReceivables set UpdateDate = CreateDate where UpdateDate is null and Tenant = @Tenant
	
		declare @ShipmentId as varchar(15)
		declare @ShipmentDate as datetime
		declare @ShipmentProfitCurrencyId as varchar(15)
		declare @ShipmentProfitExchangeRate as float

		DECLARE ShipmentsCursor CURSOR READ_ONLY
		FOR
		SELECT Id, LastUpdateDate, ProfitCurrencyId
		FROM Shipments
		WHERE Tenant = @Tenant
		OPEN ShipmentsCursor FETCH NEXT FROM ShipmentsCursor INTO @ShipmentId, @ShipmentDate, @ShipmentProfitCurrencyId
		WHILE @@FETCH_STATUS = 0
		BEGIN

			if (@ShipmentProfitCurrencyId = @LocalCurrencyId)
			begin
				set @ShipmentProfitExchangeRate = 1
			end

			else
			begin
				set @ShipmentProfitExchangeRate = dbo.GetLastRate(@Tenant, @ShipmentDate, @LocalCurrencyId, @ShipmentProfitCurrencyId)
			end

			update Shipments
			set ProfitExchangeRate = Round(@ShipmentProfitExchangeRate, 5)
			where Id = @ShipmentId and Tenant = @Tenant
		                         
			-- Payables
			BEGIN

				declare @PayableId as varchar(15)
				declare @PayableDate as datetime
				declare @PayableCurrencyId as varchar(15)
				declare @PayableCurrencyRate as float
				declare @PayableProfitExchangeRate as float
				declare @OpenAmount as float
				declare @ExpectedAmount as float
				declare @AccountedAmount as float
				declare @OpenAmountLocal as float
				declare @ExpectedAmountLocal as float
				declare @AccountedAmountLocal as float
				declare @OpenAmountProfit as float
				declare @ExpectedAmountProfit as float
				declare @AccountedAmountProfit as float

				DECLARE PayablesCursor CURSOR READ_ONLY
				FOR
				SELECT Id, UpdateDate, CurrencyId, OpenAmount, ExpectedAmount, AccountedAmount
				FROM ShipmentPayables
				WHERE Tenant = @Tenant and ShipmentId = @ShipmentId
				OPEN PayablesCursor FETCH NEXT FROM PayablesCursor INTO @PayableId, @PayableDate, @PayableCurrencyId, @OpenAmount, @ExpectedAmount, @AccountedAmount
				WHILE @@FETCH_STATUS = 0
				BEGIN

					-- Rate
					if (@PayableCurrencyId = @LocalCurrencyId)
					begin
						set @PayableCurrencyRate = 1
						set @OpenAmountLocal = @OpenAmount
						set @ExpectedAmountLocal = @ExpectedAmount
						set @AccountedAmountLocal = @AccountedAmount
					end
					else
					begin
						set @PayableCurrencyRate = dbo.GetLastRate(@Tenant, @PayableDate, @LocalCurrencyId, @PayableCurrencyId)
						set @OpenAmountLocal = @OpenAmount * @PayableCurrencyRate
						set @ExpectedAmountLocal = @ExpectedAmount * @PayableCurrencyRate
						set @AccountedAmountLocal = @AccountedAmount * @PayableCurrencyRate
					end

					-- Profit Rate
					if (@ShipmentProfitCurrencyId = @PayableCurrencyId)
					begin
						set @PayableProfitExchangeRate = dbo.GetLastRate(@Tenant, @PayableDate, @LocalCurrencyId, @ShipmentProfitCurrencyId)
						set @OpenAmountProfit = @OpenAmount
						set @ExpectedAmountProfit = @ExpectedAmount
						set @AccountedAmountProfit = @AccountedAmount
					end	
					else if (@ShipmentProfitCurrencyId = @LocalCurrencyId)
					begin
						set @PayableProfitExchangeRate = 1
						set @OpenAmountProfit = @OpenAmountLocal
						set @ExpectedAmountProfit = @ExpectedAmountLocal
						set @AccountedAmountProfit = @AccountedAmountLocal
					end
					else
					begin
						set @PayableProfitExchangeRate = dbo.GetLastRate(@Tenant, @PayableDate, @LocalCurrencyId, @ShipmentProfitCurrencyId)
						set @OpenAmountProfit = @OpenAmountLocal / @PayableProfitExchangeRate
						set @ExpectedAmountProfit = @ExpectedAmountLocal / @PayableProfitExchangeRate
						set @AccountedAmountProfit = @AccountedAmountLocal / @PayableProfitExchangeRate
					end

                    update ShipmentPayables 
                    set
					Rate = Round(@PayableCurrencyRate, 5),
					ProfitCurrencyExchangeRate = Round(@PayableProfitExchangeRate, 5),
					OpenAmount = Round(@OpenAmount, 2),
					ExpectedAmount = Round(@ExpectedAmount, 2),
					AccountedAmount = Round(@AccountedAmount, 2),
					OpenAmountInLocalCurrency = Round(@OpenAmountLocal, 2),
					ExpectedAmountLocal = Round(@ExpectedAmountLocal, 2),
					AccountedAmountInLocalCurrency = Round(@AccountedAmountLocal, 2),
					OpenAmountInProfitCurrency = Round(@OpenAmountProfit, 2),
					ExpectedAmountInProfitCurrency = Round(@ExpectedAmountProfit, 2),
					AccountedAmountInProfitCurrency = Round(@AccountedAmountProfit, 2)

                    where Id = @PayableId and ShipmentId = @ShipmentId and Tenant = @Tenant

				FETCH NEXT FROM PayablesCursor INTO @PayableId, @PayableDate, @PayableCurrencyId, @OpenAmount, @ExpectedAmount, @AccountedAmount
				END
				CLOSE PayablesCursor
				DEALLOCATE PayablesCursor				
			END
		    
			-- Receivables
			BEGIN

				declare @ReceivableId as varchar(15)
				declare @ReceivableDate as datetime
				declare @ReceivableCurrencyId as varchar(15)
				declare @ReceivableCurrencyRate as float
				declare @ReceivableProfitExchangeRate as float
				declare @ReceivableAmount as float
				declare @ReceivableAmountLocal as float
				declare @ReceivableAmountProfit as float

				DECLARE ReceivablesCursor CURSOR READ_ONLY
				FOR
				SELECT Id, UpdateDate, CurrencyId, TotalAmount
				FROM ShipmentReceivables
				WHERE Tenant = @Tenant and ShipmentId = @ShipmentId
				OPEN ReceivablesCursor FETCH NEXT FROM ReceivablesCursor INTO @ReceivableId, @ReceivableDate, @ReceivableCurrencyId, @ReceivableAmount
				WHILE @@FETCH_STATUS = 0
				BEGIN

					-- Rate
					if (@ReceivableCurrencyId = @LocalCurrencyId)
					begin
						set @ReceivableCurrencyRate = 1
						set @ReceivableAmountLocal = @ReceivableAmount
					end
					else
					begin
						set @ReceivableCurrencyRate = dbo.GetLastRate(@Tenant, @ReceivableDate, @LocalCurrencyId, @ReceivableCurrencyId)
						set @ReceivableAmountLocal = @ReceivableAmount * @ReceivableCurrencyRate
					end

					-- Profit Rate
					if (@ShipmentProfitCurrencyId = @ReceivableCurrencyId)
					begin
						set @ReceivableProfitExchangeRate = dbo.GetLastRate(@Tenant, @ReceivableDate, @LocalCurrencyId, @ShipmentProfitCurrencyId)
						set @ReceivableAmountProfit = @ReceivableAmount
					end
					else if (@ShipmentProfitCurrencyId = @LocalCurrencyId)
					begin
						set @ReceivableProfitExchangeRate = 1
						set @ReceivableAmountProfit = @ReceivableAmountLocal
					end
					else
					begin
						set @ReceivableProfitExchangeRate = dbo.GetLastRate(@Tenant, @ReceivableDate, @LocalCurrencyId, @ShipmentProfitCurrencyId)
						set @ReceivableAmountProfit = @ReceivableAmountLocal / @ReceivableProfitExchangeRate
					end

                    update ShipmentReceivables 
                    set
					Rate = Round(@ReceivableCurrencyRate, 5),
					ProfitCurrencyExchangeRate = Round(@ReceivableProfitExchangeRate, 5),
					TotalAmount = Round(@ReceivableAmount, 2),
					TotalAmountLocal = Round(@ReceivableAmountLocal, 2),
                    AmountInProfitCurrency = Round(@ReceivableAmountProfit,2)
                    where Id = @ReceivableId and ShipmentId = @ShipmentId and Tenant = @Tenant

				FETCH NEXT FROM ReceivablesCursor INTO @ReceivableId, @ReceivableDate, @ReceivableCurrencyId, @ReceivableAmount
				END
				CLOSE ReceivablesCursor
				DEALLOCATE ReceivablesCursor			
			END
				
			EXECUTE usp_UpdateShipmentProfit @ShipmentId					            

		FETCH NEXT FROM ShipmentsCursor INTO @ShipmentId, @ShipmentDate	, @ShipmentProfitCurrencyId
		END
		CLOSE ShipmentsCursor
		DEALLOCATE ShipmentsCursor
	END

	print 'End Successfully...'
	SET NOCOUNT OFF
END
  
]]>
  </SqlScript>
  <OracleScript>
  </OracleScript>
</Procedure>