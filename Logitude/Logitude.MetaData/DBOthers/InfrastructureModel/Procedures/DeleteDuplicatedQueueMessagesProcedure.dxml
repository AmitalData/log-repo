<Procedure DBType="Main" Name="Queue_Enqueue" Schema="dbo" Module="Infrastructure">
  <SqlScript>
    <![CDATA[
 CREATE procedure [dbo].[DeleteDuplicatedQueueMessages]
     
      as begin
     
	 update QueueMessages
set Status = 2
where id in (
SELECT  id
        FROM QueueMessages WITH (UPDLOCK,READPAST) 
        WHERE Status = 0 
              AND HashCode in (select hashcode 
							from QueueMessages
							where HashCode is not null
							group by HashCode
							having count(*) > 1
							)

							and id not in (SELECT  top 1 id
        FROM QueueMessages --WITH (UPDLOCK,READPAST) 
        WHERE Status = 0 
              AND HashCode in (select hashcode 
							from QueueMessages
							where HashCode is not null
							group by HashCode
							having count(*) > 1
							) ORDER BY NextRunDateTime)
--ORDER BY NextRunDateTime
)
      end;



    ]]>
  </SqlScript>
  
  <OracleScript>
    <![CDATA[
                                 
CREATE OR REPLACE PROCEDURE DeleteDuplicatedQueueMessages
AS

BEGIN
   UPDATE QueueMessages
      SET STATUS = 2
    WHERE  id IN ( SELECT QUEUEMESSAGES.id 
                   FROM QueueMessages 
                  
                    WHERE  QUEUEMESSAGES.STATUS = 0
                             AND QUEUEMESSAGES.HashCode IN ( SELECT QUEUEMESSAGES.hashcode 
                                                             FROM QueueMessages 
                                                              WHERE  QUEUEMESSAGES.HashCode IS NOT NULL
                                                               GROUP BY QUEUEMESSAGES.HashCode
                                                             
                                                                HAVING COUNT(*)  > 1 )

                             AND QUEUEMESSAGES.id NOT IN ( SELECT QUEUEMESSAGES.id 
                                                           FROM QueueMessages --WITH (UPDLOCK,READPAST) 
                                                                 
                                                            WHERE  QUEUEMESSAGES.STATUS = 0
                                                                     AND QUEUEMESSAGES.HashCode IN ( SELECT QUEUEMESSAGES.hashcode 
                                                                                                     FROM QueueMessages 
                                                                                                      WHERE  QUEUEMESSAGES.HashCode IS NOT NULL
                                                                                                       GROUP BY QUEUEMESSAGES.HashCode
                                                                                                     
                                                                                                        HAVING COUNT(*)  > 1 )
                                                                                                        

                                                             ORDER BY QUEUEMESSAGES.NextRunDateTime
                                                             FETCH FIRST 1 ROWS ONLY )  --FOR UPDATE SKIP LOCKED
                                                           
                                                        
    ) 
   ;--ORDER BY NextRunDateTime

--EXCEPTION WHEN OTHERS THEN utils.handleerror(SQLCODE,SQLERRM);
END;


       
    ]]>
  </OracleScript>
</Procedure>