<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="Queue_Peek"
  Schema="dbo"
  Module="Infrastructure">
  
	<SqlScript>
		<![CDATA[
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
ALTER PROCEDURE [dbo].[Queue_Peek]

@V_MESSAGEID numeric  OUTPUT,
@V_MESSAGEBODY varchar(max)  OUTPUT,
@V_RETRYNUMBER numeric  OUTPUT,
@V_MESSAGECREATEDSERVERTIME datetime2(7)  OUTPUT,
@V_QUEUEDEFINITIONCODE varchar(max),
@V_NEXTRUNDELAYINSEC numeric,
@V_WATINGSTATUS numeric
AS
BEGIN
SET @V_MESSAGEID = NULL
SET @V_MESSAGEBODY = NULL
SET @V_RETRYNUMBER = NULL
SET @V_MESSAGECREATEDSERVERTIME = NULL
/*DECLARE @NextId INTEGER*/
DECLARE
@V_FREQUENCY numeric,
@V_ROW$ID numeric,
@V_ROW$QUEUEDEFINITIONCODE varchar(265),
@V_ROW$CREATEDATETIME datetime2(7),
@V_ROW$STATUS int,
@V_ROW$MESSAGEBODY varchar(1000),
@V_ROW$NEXTRUNDATETIME datetime2(7),
@V_ROW$PROCESSINGDATETIME datetime2(7),
@V_ROW$COMPLETEDATETIME datetime2(7),
@V_ROW$RETRYNUMBER int,
@V_ROW$TENANT int,
@V_ROW$HASHCODE nvarchar(max),
@V_ROW$TENANTPRIORITY int,
@V_ROW$INTERFACETYPECODE varchar(32),
@V_ROW$QUEUECODERABBIT varchar(256),
@V_ROW$USERABBITMQ bit,
@V_ROW$HAVERABBITMQ bit,
@V_ROW$RABBITMQCREATEDATE datetime2(7),
@V_ROW$RABBITMQRETRYNUMBER int,
@V_ROW$RABBITMQERRMESS varchar(256),
@V_ROW$ENTITYCODE varchar(40),
@V_ROW$ENTITYID varchar(40),
@V_WATINGSTATUS_int int
set @V_WATINGSTATUS_int = @V_WATINGSTATUS
/*-20220127 IM Rabbit*/
SET @V_FREQUENCY = 60
/* Find next available item available where the status is enabled*/
BEGIN
SELECT top (1)
@V_ROW$ID = QT.ID,
@V_ROW$QUEUEDEFINITIONCODE = QT.QUEUEDEFINITIONCODE,
@V_ROW$CREATEDATETIME = QT.CREATEDATETIME,
@V_ROW$STATUS = QT.STATUS,
@V_ROW$MESSAGEBODY = QT.MESSAGEBODY,
@V_ROW$NEXTRUNDATETIME = QT.NEXTRUNDATETIME,
@V_ROW$PROCESSINGDATETIME = QT.PROCESSINGDATETIME,
@V_ROW$COMPLETEDATETIME = QT.COMPLETEDATETIME,
@V_ROW$RETRYNUMBER = QT.RETRYNUMBER,
@V_ROW$TENANT = QT.TENANT,
@V_ROW$HASHCODE = QT.HASHCODE,
@V_ROW$TENANTPRIORITY = QT.TENANTPRIORITY,
@V_ROW$INTERFACETYPECODE = QT.INTERFACETYPECODE,
@V_ROW$QUEUECODERABBIT = QT.QUEUECODERABBIT,
@V_ROW$USERABBITMQ = QT.USERABBITMQ,
@V_ROW$HAVERABBITMQ = QT.HAVERABBITMQ,
@V_ROW$RABBITMQCREATEDATE = QT.RABBITMQCREATEDATE,
@V_ROW$RABBITMQRETRYNUMBER = QT.RABBITMQRETRYNUMBER,
@V_ROW$RABBITMQERRMESS = QT.RABBITMQERRMESS,
@V_ROW$ENTITYCODE = QT.ENTITYCODE,
@V_ROW$ENTITYID = QT.ENTITYID
FROM dbo.QUEUEMESSAGES  AS QT
WITH ( UPDLOCK,  READPAST )
WHERE
QT.NEXTRUNDATETIME <= sysdatetime() AND
QT.STATUS = @V_WATINGSTATUS_int AND
QT.QUEUEDEFINITIONCODE = @V_QUEUEDEFINITIONCODE AND
QT.USERABBITMQ = 0
ORDER BY QT.TENANTPRIORITY ASC, QT.NEXTRUNDATETIME ASC
IF @V_ROW$ID > 0
BEGIN
/*
*   If f
*   If found, flag it to prevent being picked up again
*/
SET @V_MESSAGEID = @V_ROW$ID
/*SELECT RetryNumber       INTO v_RetryNumber        FROM QueueMessages        WHERE Id = v_MessageId;*/
SET @V_RETRYNUMBER = @V_ROW$RETRYNUMBER
/*SELECT MessageBody      INTO v_MessageBody       FROM QueueMessages       WHERE Id = v_MessageId;*/
SET @V_MESSAGEBODY = @V_ROW$MESSAGEBODY
SET @V_MESSAGECREATEDSERVERTIME = @V_ROW$CREATEDATETIME
/*
*   SSMA warning messages:
*   O2SS0425: Dateadd operation may cause bad performance.
*/
--SET @V_NEXTRUNDELAYINSEC=60;
UPDATE dbo.QUEUEMESSAGES
SET
PROCESSINGDATETIME = sysdatetime(),
NEXTRUNDATETIME =DATEADD(MINUTE,@V_NEXTRUNDELAYINSEC,GETDATE()) , --DATEADD(ss,@V_NEXTRUNDELAYINSEC,GETDATE()) , --ssma_oracle.dateadd(@V_NEXTRUNDELAYINSEC / 86400, sysdatetime())/*-(SYSDATE + v_frequency/86400),----utils.dateadd('SECOND', v_frequency, SYSDATE),*/,
RETRYNUMBER = (QUEUEMESSAGES.RETRYNUMBER + 1)
WHERE QUEUEMESSAGES.ID = @V_MESSAGEID/* return queue data*/
/*
*   SSMA warning messages:
*   O2SS0425: Dateadd operation may cause bad performance.
*/
UPDATE dbo.QUEUEMESSAGEMOREDETAILS
SET
PROCESSINGDATETIME = sysdatetime(),
NEXTRUNDATETIME = DATEADD(MINUTE,@V_NEXTRUNDELAYINSEC,GETDATE()) ,--DATEADD(ss,@V_NEXTRUNDELAYINSEC,GETDATE()) , --ssma_oracle.dateadd(@V_NEXTRUNDELAYINSEC / 86400, sysdatetime())/*-(SYSDATE + v_frequency/86400),----utils.dateadd('SECOND', v_frequency, SYSDATE),*/,
RETRYNUMBER = (QUEUEMESSAGEMOREDETAILS.RETRYNUMBER + 1)
WHERE QUEUEMESSAGEMOREDETAILS.ID = @V_MESSAGEID/* return queue data*/
END
End
end

]]>
	</SqlScript>
  <OracleScript>
    <![CDATA[
    create or replace PROCEDURE Queue_Peek(
    v_MessageId OUT NUMBER,
    v_MessageBody OUT VARCHAR2,
    v_RetryNumber OUT NUMBER,
    v_MessageCreatedServerTime OUT QUEUEMESSAGES.CREATEDATETIME%TYPE ,
    v_QueueDefinitionCode IN VARCHAR2 ,
    v_NextRunDelayInSec IN NUMBER,
    v_WatingStatus IN NUMBER)
AS
  --DECLARE @NextId INTEGER
  v_frequency NUMBER(10,0);
  v_row QueueMessages%rowtype;
BEGIN
---20220127 IM Rabbit
  v_frequency := 60 ;
  -- Find next available item available where the status is enabled

 DECLARE
  CURSOR c_1 IS  
    SELECT /*+FIRST_ROWS_1*/  * --qt.Id
    FROM QueueMessages qt
    WHERE qt.NextRunDateTime <= SYSDATE
     --ROWNUM<2  AND  --do not use rownum due  http://stackoverflow.com/questions/6117254/force-oracle-to-return-top-n-rows-with-skip-locked/6649586#6649586
    AND qt.Status             = v_WatingStatus
    AND QueueDefinitionCode = v_QueueDefinitionCode
	AND qt.UseRabbitMQ =0
    ORDER BY qt.tenantpriority ASC ,qt.NextRunDateTime ASC
    FOR UPDATE SKIP LOCKED;
BEGIN
  OPEN c_1;
  FETCH c_1 into v_row; -- v_MessageId;
  IF c_1%FOUND THEN
     --If f
  --If found, flag it to prevent being picked up again
  IF ( v_row.Id IS NOT NULL ) THEN
    BEGIN
    v_MessageId := v_row.id;
      --SELECT RetryNumber       INTO v_RetryNumber        FROM QueueMessages        WHERE Id = v_MessageId;
      v_RetryNumber := v_row.RetryNumber;

      --SELECT MessageBody      INTO v_MessageBody       FROM QueueMessages       WHERE Id = v_MessageId;
      v_MessageBody := v_row.MessageBody;
      v_MessageCreatedServerTime := v_row.CREATEDATETIME;


      UPDATE QueueMessages
      SET ProcessingDateTime = SYSDATE,
        NextRunDateTime      = (SYSDATE + v_NextRunDelayInSec/86400), ---(SYSDATE + v_frequency/86400),----utils.dateadd('SECOND', v_frequency, SYSDATE),
        RetryNumber          = (RetryNumber + 1)
      WHERE Id               = v_MessageId;-- return queue data


      UPDATE queuemessagemoredetails
      SET ProcessingDateTime = SYSDATE,
        NextRunDateTime      = (SYSDATE + v_NextRunDelayInSec/86400), ---(SYSDATE + v_frequency/86400),----utils.dateadd('SECOND', v_frequency, SYSDATE),
        RetryNumber          = (RetryNumber + 1)
      WHERE Id               = v_MessageId;-- return queue data


    END;
   END IF; 
  END IF;
  CLOSE c_1;
END;

END;
    ]]>
</OracleScript>
</Procedure>