<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="usp_ChangeTenantLocalCurrency_Quotes"
  Schema="dbo"
  Module="Infrastructure">
  <SqlScript>
    <![CDATA[

    
CREATE PROCEDURE [dbo].[usp_ChangeTenantLocalCurrency_Quotes]
(
  @Tenant AS INT,
  @NewCurrencyCode AS VARCHAR(30)
)
AS

SET NOCOUNT ON

declare @IsRunningScript as bit
set @IsRunningScript = 0

declare @LocalCurrencyId as varchar(15)
set @LocalCurrencyId = (select Id from Currencies where Tenant = @Tenant and Code = @NewCurrencyCode)

if not exists (select * from Tenants where Id = @Tenant)
begin
       print 'Error 01: This Tenant is not exists!'
end

else if not exists (select * from Currencies where Tenant = @Tenant and Id = @LocalCurrencyId)
begin
       print 'Error 02: This Currency is not exists!'
end

else
begin
		
	declare @CurrencyId as varchar(15)
	declare @CurrencyName as varchar(40)
	declare @AllCurrenciesRatesExists as bit
	set @AllCurrenciesRatesExists = 1

	DECLARE CurrenciesCursor CURSOR READ_ONLY
	FOR
	SELECT Id, EnglishName
	FROM Currencies
	WHERE Tenant = @Tenant
	OPEN CurrenciesCursor FETCH NEXT FROM CurrenciesCursor INTO @CurrencyId, @CurrencyName
	WHILE @@FETCH_STATUS = 0
	BEGIN

		if (@CurrencyId != @LocalCurrencyId) AND not exists (select * from RatesTables where Tenant = @Tenant and BaseCurrencyId = @LocalCurrencyId and ForeignCurrencyId = @CurrencyId)
		begin
			set @AllCurrenciesRatesExists = 0
			print 'Error 03: ' + @CurrencyName + ' Currency has no rates in this Tenant'
		end		

	FETCH NEXT FROM CurrenciesCursor INTO @CurrencyId, @CurrencyName	
	END
	CLOSE CurrenciesCursor
	DEALLOCATE CurrenciesCursor

	IF (@AllCurrenciesRatesExists = 1)
	set @IsRunningScript = 1
end

IF (@IsRunningScript = 1)
BEGIN

	print 'Start...'	
	update Tenants set CurrencyId = @LocalCurrencyId where Id = @Tenant and CurrencyId <> @LocalCurrencyId

	-- Quotes
	BEGIN
		
		update Quotes set UpdateDate = OpenDate where UpdateDate is null and Tenant = @Tenant
	
		declare @QuoteId as varchar(15)
		declare @QuoteDate as datetime
		declare @QuoteSaleCurrencyId as varchar(15)
		declare @QuoteSaleCurrencyRate as float
		
		declare @QuoteTotalCostAmount as float
		declare @QuoteTotalSaleAmount as float				
		declare @QuoteTotalCostAmountLocal as float
		declare @QuoteTotalSaleAmountLocal as float
		declare @QuoteTotalCostAmountInSale as float
		declare @EstimateProfit as float

		DECLARE QuotesCursor CURSOR READ_ONLY
		FOR
		SELECT Id, UpdateDate, SaleCurrencyId
		FROM Quotes
		WHERE Tenant = @Tenant
		OPEN QuotesCursor FETCH NEXT FROM QuotesCursor INTO @QuoteId, @QuoteDate, @QuoteSaleCurrencyId
		WHILE @@FETCH_STATUS = 0
		BEGIN

			set @EstimateProfit = 0
			set @QuoteTotalCostAmount = 0
			set @QuoteTotalSaleAmount = 0
			set @QuoteTotalCostAmountLocal = 0
			set @QuoteTotalSaleAmountLocal = 0
			set @QuoteTotalCostAmountInSale = 0

			if (@QuoteSaleCurrencyId = @LocalCurrencyId)
			begin
				set @QuoteSaleCurrencyRate = 1
			end

			else
			begin
				set @QuoteSaleCurrencyRate = dbo.GetLastRate(@Tenant, @QuoteDate, @LocalCurrencyId, @QuoteSaleCurrencyId)
			end                        				            

			-- Charges
			BEGIN

				declare @ChargeId as varchar(15)
				declare @ChargeDate as datetime
				declare @CostCurrencyId as varchar(15)
				declare @CostCurrencyRate as float
				declare @CostTotalAmount as float
				declare @CostTotalAmountLocal as float
				declare @CostTotalAmountInSale as float
				declare @SaleCurrencyId as varchar(15)				
				declare @SaleCurrencyRate as float				
				declare @SaleTotalAmount as float
				declare @SaleTotalAmountLocal as float
				declare @IsAllIN as bit

				DECLARE ChargesCursor CURSOR READ_ONLY
				FOR
				SELECT Id, UpdateDate, CostCurrencyId, SaleCurrencyId, CostTotalAmount, SaleTotalAmount, IsAllIN
				FROM QuoteCharges
				WHERE Tenant = @Tenant and QuoteId = @QuoteId
				OPEN ChargesCursor FETCH NEXT FROM ChargesCursor INTO @ChargeId, @ChargeDate, @CostCurrencyId, @SaleCurrencyId, @CostTotalAmount, @SaleTotalAmount, @IsAllIN
				WHILE @@FETCH_STATUS = 0
				BEGIN

					-- Cost Rate
					if (@CostCurrencyId = @LocalCurrencyId)
					begin
						set @CostCurrencyRate = 1
						set @CostTotalAmountLocal = @CostTotalAmount
					end
					else
					begin
						set @CostCurrencyRate = dbo.GetLastRate(@Tenant, @ChargeDate, @LocalCurrencyId, @CostCurrencyId)
						set @CostTotalAmountLocal = @CostTotalAmount * @CostCurrencyRate
					end

					-- Sale Rate
					if (@SaleCurrencyId = @LocalCurrencyId)
					begin
						set @SaleCurrencyRate = 1
						set @SaleTotalAmountLocal = @SaleTotalAmount
					end
					else if (@SaleCurrencyId = @QuoteSaleCurrencyId)
					begin
						set @SaleCurrencyRate = @QuoteSaleCurrencyRate
						set @SaleTotalAmountLocal = @SaleTotalAmount * @SaleCurrencyRate
					end
					else
					begin
						set @SaleCurrencyRate = dbo.GetLastRate(@Tenant, @ChargeDate, @LocalCurrencyId, @SaleCurrencyId)
						set @SaleTotalAmountLocal = @SaleTotalAmount * @SaleCurrencyRate
					end

					-- Cost in Sale
					if (@CostCurrencyId = @SaleCurrencyId)
					begin
						set @CostTotalAmountInSale = @CostTotalAmount
					end
					else
					begin
						set @CostTotalAmountInSale = @CostTotalAmountLocal / @SaleCurrencyRate
					end

					set @QuoteTotalCostAmount += isnull(@CostTotalAmount,0)
					set @QuoteTotalCostAmountLocal += isnull(@CostTotalAmountLocal,0)
					set @QuoteTotalCostAmountInSale += isnull(@CostTotalAmountInSale,0)

					if (@IsAllIN = 0)
					begin
						set @QuoteTotalSaleAmount += isnull(@SaleTotalAmount,0)			
						set @QuoteTotalSaleAmountLocal += isnull(@SaleTotalAmountLocal,0)
					end

					update QuoteCharges
					set
					CostExchangeRate = Round(@CostCurrencyRate, 5),
					SaleExchangeRate = Round(@SaleCurrencyRate, 5),
					CostTotalAmount = Round(@CostTotalAmount, 2),
					SaleTotalAmount = Round(@SaleTotalAmount, 2),
					CostTotalAmountLocal = Round(@CostTotalAmountLocal, 2),
					SaleTotalAmountLocal = Round(@SaleTotalAmountLocal, 2)
					where Id = @ChargeId and QuoteId = @QuoteId and Tenant = @Tenant

					 
				FETCH NEXT FROM ChargesCursor INTO @ChargeId, @ChargeDate, @CostCurrencyId, @SaleCurrencyId, @CostTotalAmount, @SaleTotalAmount, @IsAllIN
				END
				CLOSE ChargesCursor
				DEALLOCATE ChargesCursor
			END

			update Quotes
			set
			ExchangeRate = Round(@QuoteSaleCurrencyRate, 5),
			EstimateProfit = Round(@QuoteTotalSaleAmount - @QuoteTotalCostAmountInSale, 2),
      EstimatedProfitInLocal =  (Round(@QuoteSaleCurrencyRate, 5) * Round(@QuoteTotalSaleAmount - @QuoteTotalCostAmountInSale, 2)) 
			where Id = @QuoteId and Tenant = @Tenant

      update QuoteComputedFields
			set
			EstimatedPayablesInLocal = (select Sum(QuoteCharges.CostTotalAmountLocal) from QuoteCharges where QuoteCharges.QuoteId = @QuoteId And CostTotalAmountLocal is not null),
			EstimatedPayablesInSales = (select Sum(QuoteCharges.CostAmountInSaleCurrency)  from QuoteCharges where QuoteCharges.QuoteId = @QuoteId And CostAmountInSaleCurrency is not null),
			EstimatedReceivablesInLocal = (select Sum(QuoteCharges.SaleTotalAmountLocal)  from QuoteCharges where QuoteCharges.QuoteId = @QuoteId AND QuoteCharges.IsAllIN ='0' And SaleTotalAmountLocal is not null ),
			EstimatedReceivablesInSales = (select Sum(QuoteCharges.SaleAmountInSaleCurrency)  from QuoteCharges where QuoteCharges.QuoteId = @QuoteId AND QuoteCharges.IsAllIN ='0'  And SaleAmountInSaleCurrency is not null)
			where Id = @QuoteId and Tenant = @Tenant
			
		FETCH NEXT FROM QuotesCursor INTO @QuoteId, @QuoteDate, @QuoteSaleCurrencyId
		END
		CLOSE QuotesCursor
		DEALLOCATE QuotesCursor
	END

	print 'End Successfully...'
	SET NOCOUNT OFF
END
    
]]>
</SqlScript>
<OracleScript>
</OracleScript>
</Procedure>