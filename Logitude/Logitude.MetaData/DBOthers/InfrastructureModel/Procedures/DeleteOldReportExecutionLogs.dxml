<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="DeleteOldReportExecutionLogs"
  Schema="dbo"
  Module="Common">
	<SqlScript>
		<![CDATA[
CREATE procedure [dbo].[DeleteOldReportExecutionLogs] as
declare @Rows int
set @Rows = 11

while (@Rows >10)
BEGIN

DELETE
FROM [dbo].[DBA_View_ReportsExecutionLogs_ToBeDeleted]

set @Rows= @@ROWCOUNT

WAITFOR DELAY '00:00:01'
END
]]>
	</SqlScript>
	<OracleScript>
	</OracleScript>
</Procedure>