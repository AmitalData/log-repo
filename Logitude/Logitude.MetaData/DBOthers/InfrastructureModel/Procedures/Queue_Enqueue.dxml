<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="Queue_Enqueue"
  Schema="dbo"
  Module="Infrastructure">
  <SqlScript>
    <![CDATA[
      CREATE procedure [dbo].[Queue_Enqueue] 
      (
      @QueueDefinitionCode varchar(255),

      @MessageBody varchar(1000),
      @Tenant int,
      @DelaySeconds int,
      @CustomerId varchar(15),
      @BatchNumber varchar(15),
      @NextRunDTime datetime = null,
      @HashCode nvarchar(1000),
      @WatingStatus int,
      @MessageId bigint out

      )
      as begin
      declare @currentdate  datetime
      declare @nextRunDateTime  datetime
      set @currentdate =getdate()
      if @NextRunDTime is null
      set @nextRunDateTime = dateadd(second,@DelaySeconds,getdate())
      else
      set @nextRunDateTime = @NextRunDTime
      --set @nextRunDateTime = dateadd(second,@DelaySeconds,getdate())

      insert into [dbo].[QueueMessages] ([CreateDateTime],[QueueDefinitionCode],[Status],[MessageBody],[Tenant],[NextRunDateTime],RetryNumber,HashCode)
      values(@currentdate,@QueueDefinitionCode,@WatingStatus,@MessageBody,@Tenant,@nextRunDateTime,0,@HashCode)

      declare @CId as varchar(15);
      declare @BNo as varchar(15);
      if @CustomerId = ''
      set @CId = NULL
      else
      set @CId = @CustomerId
      if @BatchNumber = ''
      set @BNo = NULL
      else
      set @BNo = @BatchNumber

      Set @MessageId = (SELECT SCOPE_IDENTITY());
      insert into [dbo].[QueueMessageMoreDetails] ([Id],[CreateDateTime],[QueueDefinitionCode],[Status],[MessageBody],[Tenant],[NextRunDateTime],RetryNumber,Field1,Field2)
      values((SELECT SCOPE_IDENTITY()),@currentdate,@QueueDefinitionCode,@WatingStatus,@MessageBody,@Tenant,@nextRunDateTime,0,@CId,@BNo)


      end;

    ]]>
  </SqlScript>

  <OracleScript>
    <![CDATA[
        create or replace PROCEDURE Queue_Enqueue(
        v_QueueDefinitionCode IN VARCHAR2,
        v_MessageBody         IN VARCHAR2,
        v_Tenant              IN NUMBER,
        v_DelaySeconds        IN NUMBER,
        v_CustomerId          IN VARCHAR2,
        v_BatchNumber         IN VARCHAR2 ,
        v_HashCode            IN VARCHAR2,
        v_WatingStatus        IN NUMBER,
		v_TenantPriority        IN NUMBER,
        v_QueueMessageId         OUT QUEUEMESSAGES.ID%TYPE
        
        )
		---20211108 IM TenantPriority
    AS
      v_currentdate     DATE;  
      v_nextRunDateTime DATE;
      v_CId             VARCHAR2(15);
      v_BNo             VARCHAR2(15);
    BEGIN
	IF (v_TenantPriority=0) THEN
	    v_TenantPriority=7
	END IF;
      v_currentdate     := SYSDATE ;
      v_nextRunDateTime := (SYSDATE + v_DelaySeconds/86400) ;
      INSERT
      INTO QueueMessages
        (
          CreateDateTime,
          QueueDefinitionCode,
          Status,
          MessageBody,
          Tenant,
          NextRunDateTime,
          RetryNumber,
          HashCode,
		  TenantPriority
        )
        VALUES
        (
          v_currentdate,
          v_QueueDefinitionCode,
          v_WatingStatus,
          v_MessageBody,
          v_Tenant,
          v_nextRunDateTime,
          0,
          v_HashCode,
		  v_TenantPriority
        );
      IF v_CustomerId = ' ' THEN
        v_CId        := NULL ;
      ELSE
        v_CId := v_CustomerId ;
      END IF;
      IF v_BatchNumber = ' ' THEN
        v_BNo         := NULL ;
      ELSE
        v_BNo := v_BatchNumber ;
      END IF;
  
      v_QueueMessageId :=QUEUEMESSAGES_SEQ1.CURRVAL;
  
      INSERT
      INTO QueueMessageMoreDetails
        (
          Id,
          CreateDateTime,
          QueueDefinitionCode,
          Status,
          MessageBody,
          Tenant,
          NextRunDateTime,
          RetryNumber,
          Field1,
          Field2,
          TenantPriority,
		  
        )
        VALUES
        (
          v_QueueMessageId ---QUEUEMESSAGES_SEQ1.CURRVAL
          ,
          v_currentdate,
          v_QueueDefinitionCode,
          v_WatingStatus,
          v_MessageBody,
          v_Tenant,
          v_nextRunDateTime,
          0,
          v_CId,
          v_BNo
		  v_TenantPriority
        );
    END;
    ]]>
  </OracleScript>
</Procedure>