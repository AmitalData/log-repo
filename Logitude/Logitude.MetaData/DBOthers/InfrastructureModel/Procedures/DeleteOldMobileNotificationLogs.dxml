<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Global"
  Name="DeleteOldMobileNotificationLogs"
  Schema="dbo"
  Module="Infrastructure">
  <SqlScript>
    <![CDATA[
create procedure [dbo].[DeleteOldMobileNotificationLogs] as
IF OBJECT_ID('tempdb..#tblOldMobileNotificationLogs') IS NOT NULL
DROP TABLE #tblOldMobileNotificationLogs
CREATE TABLE #tblOldMobileNotificationLogs
(
Id varchar(40) NOT NULL PRIMARY KEY
)
INSERT #tblOldMobileNotificationLogs (Id)
SELECT Id
FROM [dbo].[MobileNotificationLogs]
WHERE [CreateDate] < DATEADD(MONTH,-1,GETDATE())
if(@@ROWCOUNT >0 )
begin
declare @skiprows int
declare @Rows int
set @Rows = 1
set @skiprows = 0
while (@Rows <> 0)
BEGIN
DELETE
FROM [dbo].[MobileNotificationLogs]
where [Id] in (
select  id
from #tblOldMobileNotificationLogs
order by Id
OFFSET ( @skiprows * 5000) ROWS FETCH NEXT 5000 ROWS ONLY
)
SET @Rows = @@ROWCOUNT
print @Rows
set @skiprows = @skiprows + 1
print @skiprows
WAITFOR DELAY '00:00:02'
END
end
DROP TABLE #tblOldMobileNotificationLogs

]]>
  </SqlScript>
  <OracleScript>
  </OracleScript>
</Procedure>