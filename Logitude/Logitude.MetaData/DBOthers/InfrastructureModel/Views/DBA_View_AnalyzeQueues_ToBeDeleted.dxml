<View DBType="Global" Name="DBA_View_AnalyzeQueues_ToBeDeleted" Schema="dbo" Module="Infrastructure">
  <SqlScript>
    <![CDATA[
	create VIEW [dbo].[DBA_View_AnalyzeQueues_ToBeDeleted] AS
    SELECT TOP 1000 *
    FROM [dbo].[AnalyzeQueues]
    where CreateDate < DATEADD(Month, -6, GETDATE())
    ORDER BY CreateDate;
    ]]>
  </SqlScript>
  <OracleScript>
  </OracleScript>
</View>