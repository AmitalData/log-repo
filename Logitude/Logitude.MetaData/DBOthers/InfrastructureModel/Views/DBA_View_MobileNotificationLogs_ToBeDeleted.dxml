<View DBType="Global" Name="DBA_View_MobileNotificationLogs_ToBeDeleted" Schema="dbo" Module="Infrastructure">
  <SqlScript>
    <![CDATA[
	CREATE VIEW [dbo].[DBA_View_MobileNotificationLogs_ToBeDeleted]
AS
SELECT   TOP (1000) *
FROM      dbo.MobileNotificationLogs
WHERE   (CreateDate < DATEADD(Month, -1, GETDATE()))
ORDER BY CreateDate
    ]]>
  </SqlScript>
  <OracleScript>
  </OracleScript>
</View>