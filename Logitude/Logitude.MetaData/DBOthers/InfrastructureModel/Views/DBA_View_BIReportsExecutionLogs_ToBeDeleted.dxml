<View DBType="Main" Name="DBA_View_BIReportsExecutionLogs_ToBeDeleted" Schema="dbo" Module="Infrastructure">
  <SqlScript>
    <![CDATA[
    CREATE VIEW [dbo].[DBA_View_BIReportsExecutionLogs_ToBeDeleted]
AS
SELECT   TOP (1000) Id, Tenant, CreateDate, CreatedByUserId, StatusCode, ExceptionMessage, DoneDate, ReportFilterXML, BIReportId
FROM      dbo.BIReportsExecutionLogs
WHERE   (CreateDate < DATEADD(Month, - 6, GETDATE()))
ORDER BY CreateDate
    ]]>
  </SqlScript>
  <OracleScript>
  </OracleScript>
</View>