<View DBType="Main" Name="DigitalShippmentsView" Schema="dbo" Module="Shipment">
  <SqlScript>
    <![CDATA[
	CREATE VIEW [dbo].[DigitalShippmentsView]  
	AS 
	SELECT
	ship.Id,
    ship.Tenant,
    ShipMasterData.InlandDomesticFromCountryId,
	ShipMasterData.InlandDomesticToCountryId,
    ShipMasterData.InlandDomesticFromTypeCode,
    ShipMasterData.InlandDomesticToTypeCode,
    ShipMasterData.InlandDomesticFromCity,
    ShipMasterData.InlandDomesticToCity,
    ShipMasterData.Transshipment3ETA,
    ShipMasterData.Transshipment3ETD,
    ShipMasterData.Transshipment3ATA,
    ShipMasterData.Transshipment3ATD,
    ShipMasterData.Transshipment3ToPortId,
    ShipMasterData.Transshipment3FromPortId,
    ShipMasterData.Transshipment2CarrierNumber,
    ShipMasterData.Transshipment2ETA,
    ShipMasterData.Transshipment2ETD,
    ShipMasterData.Transshipment2ATA,
    ShipMasterData.Transshipment2ATD,
    ShipMasterData.Transshipment2ToPortId,
    ShipMasterData.Transshipment2FromPortId,
    ShipMasterData.Transshipment1CarrierNumber,
    ShipMasterData.Transshipment1ETA,
    ShipMasterData.Transshipment1ETD,
    ShipMasterData.Transshipment1ATA,
    ShipMasterData.Transshipment1ATD,
    dbo.Incoterms.Code AS IncotermCode,
    ship.ShipmentNumber,
    ship.CustomerReference1,
    ship.CustomerReference2,
    ship.CustomerReference3,
    ship.ShipmentSubTypeId,
	dbo.ShipmentSubTypes.[Name] AS ShipmentSubTypeName,
    dbo.TransportModes.[Name] AS TransportModeName,
    dbo.ShipmentTypes.[Name] AS ShipmentTypeName,
    dbo.Directions.[Name] AS DirectionName,
    ShipMasterData.[Master],
    ship.ConsigneeId,
    ship.ShipperId,
    ShipperCards.CountryCode as ShipperCountryCode,
    ConsigneeCards.CountryCode as ConsigneeCountryCode,
	ship.DescriptionOfGoods,
    ship.DirectionId,
    ship.CreateDateTime,
    ship.FirstPickupETA,
    ship.FirstPickupETD,
    ShipMasterData.MainCarriageATA,
    ShipMasterData.MainCarriageATD,
    ShipMasterData.MainCarriageETD,
    ShipMasterData.MainCarriageETA,
    MainCarriageToPorts.EnglishName AS MainCarriageToPortName,
    MainCarriageFromPorts.EnglishName AS MainCarriageFromPortName,
    MainCarriageFromCountries.Code AS MainCarriageFromPortCountryCode,
    MainCarriageFromCountries.EnglishName AS MainCarriageFromPortCountryName,
    ShipMasterData.InlandDomesticToAddress1,
    ShipMasterData.InlandDomesticToAddress2,
    ShipMasterData.InlandDomesticToPhone,
    ShipMasterData.InlandDomesticToFax,
    ShipMasterData.InlandDomesticToStateId,
    InlandDomesticToState.EnglishName AS InlandDomesticToStateName,
    ShipMasterData.InlandDomesticFromAddress1,
    ShipMasterData.NumberOfTransshipments,
    ShipMasterData.InlandDomesticFromAddress2,
    ShipMasterData.InlandDomesticFromPhone,
    ShipMasterData.InlandDomesticFromFax,
    ShipMasterData.InlandDomesticFromStateId,
    InlandDomesticFromState.EnglishName AS InlandDomesticFromStateName,
    ShipmentComputedFields.Transshipments as Transshipments,
    ship.PreForwardingETD,
    ship.PreForwardingETA,
    ship.PreForwardingATA,
    ship.PreForwardingATD,
    ShipMasterData.PreCarriageETA,
    ShipMasterData.PreCarriageETD,
    ShipMasterData.PreCarriageATA,
    ShipMasterData.PreCarriageATD,

	ShipMasterData.Transshipment1ToPortId, 
	ShipMasterData.Transshipment1FromPortId,
	ship.AccountManagerUserId,
    ship.OnForwardingETA,
    ship.OnForwardingATA,
    ship.OnForwardingATD,
    ship.OnForwardingETD,
    ShipMasterData.OnCarriageETD,
    ShipMasterData.OnCarriageETA,
    ShipMasterData.OnCarriageATD,
    ShipMasterData.OnCarriageATA,
    ship.TransportModeId,
    ship.ShipperName,
	ship.ConsigneeName,
	ship.SalesmanUserId,
	Transshipment1FromCountries.Code AS Transshipment1FromPortCountryCode,
	Transshipment1FromCountries.EnglishName AS Transshipment1FromPortCountryName,
	Transshipment2FromCountries.Code AS Transshipment2FromPortCountryCode,
	Transshipment2FromCountries.EnglishName AS Transshipment2FromPortCountryName,
	Transshipment3FromCountries.Code AS Transshipment3FromPortCountryCode,
	Transshipment3FromCountries.EnglishName AS Transshipment3FromPortCountryName,
	Transshipment1ToCountries.Code AS Transshipment1ToPortCountryCode,
	Transshipment1ToCountries.EnglishName AS Transshipment1ToPortCountryName,
	Transshipment2ToCountries.Code AS Transshipment2ToPortCountryCode,
	Transshipment2ToCountries.EnglishName AS Transshipment2ToPortCountryName,
	Transshipment3ToCountries.Code AS Transshipment3ToPortCountryCode,
	Transshipment3ToCountries.EnglishName AS Transshipment3ToPortCountryName, 
	MainCarriageCarrierCards.EnglishName AS MainCarriageCarrierName,
	MainCarriageCarrierCards.Code AS MainCarriageCarrierCode, 
	Transshipment1CarrierCards.EnglishName AS Transshipment1CarrierName,
	Transshipment1CarrierCards.Code AS Transshipment1CarrierCode,
	Transshipment2CarrierCards.EnglishName AS Transshipment2CarrierName,
	Transshipment2CarrierCards.Code AS Transshipment2CarrierCode, 
	Transshipment3CarrierCards.EnglishName AS Transshipment3CarrierName,
	Transshipment3CarrierCards.Code AS Transshipment3CarrierCode,
	AccountManagerUserContacts.EnglishName as AccountManagerUserName,
	SalesmanUserContact.EnglishName as SalesmanUserName,
	dbo.NextLegs.[Name] AS NextLegName,
	MainCarriageFromAddresses.City AS MainCarriageFromCity,
	MainCarriageToAddresses.City AS MainCarriageToCity,
	ship.ComputedStatusDate as StatusDate,
	ship.[From],
	ship.[To],
	ship.NextETA,
	ship.NextETD,
	ship.IsCancelled,
	ship.ShipmentLevelCode,
	dbo.ShipmentLevels.Name AS ShipmentLevelName,
	ship.ShipmentTypeId,
	ship.IsStandalonePickupDelivery,
    CASE WHEN ( NOT ((dbo.ShipmentTypes.[Name] IS NULL) OR ((LEN(dbo.ShipmentTypes.[Name])) = 0)))
	THEN CASE WHEN (dbo.ShipmentTypes.[Name] IS NULL) 
	THEN N'' 
	ELSE dbo.ShipmentTypes.Name END + N' ' +
	CASE WHEN (dbo.ShipmentLevels.Name IS NULL) 
	THEN N'' 
	ELSE dbo.ShipmentLevels.Name END ELSE dbo.ShipmentLevels.Name END AS ShipmentType,
	CASE WHEN ( NOT ((MainCarriageFromPortId IS NULL) OR ((LEN(MainCarriageFromPortId)) = 0))) THEN MainCarriageFromPortId ELSE ship.FromPortId END AS FromPortId,
	CASE WHEN ( NOT ((MainCarriageToPortId IS NULL) OR ((LEN(MainCarriageToPortId)) = 0))) THEN MainCarriageToPortId ELSE ship.ToPortId END AS ToPortId,
	CASE WHEN ( NOT ((MainCarriageFromPorts.Code IS NULL) OR ((LEN(MainCarriageFromPorts.Code)) = 0))) THEN MainCarriageFromPorts.Code ELSE FromPorts.Code END AS FromPort,
	CASE WHEN ( NOT ((MainCarriageFromPorts.EnglishName IS NULL) OR ((LEN(MainCarriageFromPorts.EnglishName)) = 0))) THEN MainCarriageFromPorts.EnglishName ELSE FromPorts.EnglishName END AS FromPortName,
	CASE WHEN ( NOT ((MainCarriageFinalDestinationPorts.Code IS NULL) OR ((LEN(MainCarriageFinalDestinationPorts.Code)) = 0))) THEN MainCarriageFinalDestinationPorts.Code ELSE ToPorts.Code END AS ToPort,
	CASE WHEN ( NOT ((MainCarriageFinalDestinationPorts.EnglishName IS NULL) OR ((LEN(MainCarriageFinalDestinationPorts.EnglishName)) = 0))) THEN MainCarriageFinalDestinationPorts.EnglishName ELSE ToPorts.EnglishName END AS ToPortName,
	CASE WHEN ('A' = ship.TransportModeId) THEN CASE WHEN (MainCarriageCarrierCards.Code IS NULL) THEN N'' ELSE MainCarriageCarrierCards.Code END + CASE WHEN (MainCarriageCarrierNumber IS NULL) THEN N'' ELSE MainCarriageCarrierNumber 
	END WHEN ('O' = ship.TransportModeId) THEN CASE WHEN (ShipMasterData.MainCarriageVesselName IS NULL) THEN N'' ELSE ShipMasterData.MainCarriageVesselName END + N'/' + CASE WHEN (MainCarriageCarrierNumber IS NULL)
	THEN N'' ELSE MainCarriageCarrierNumber END WHEN ('I' = ship.TransportModeId AND 'D' = ship.DirectionId) THEN TruckNumber ELSE MainCarriageCarrierNumber END AS CarrierNumber,
	CASE WHEN (ShipMasterData.MainCarriageATA IS NOT NULL) THEN ShipMasterData.MainCarriageATA ELSE ShipMasterData.MainCarriageETA END AS MainCarriageExpectedOrActual,
	CASE WHEN (ShipMasterData.MainCarriageATA IS NOT NULL) THEN N'ATA' ELSE N'ETA' END AS MainCarriageETAOrATA,
	CASE WHEN (MasterShipmentDataId IS NOT NULL) THEN CASE WHEN (ShipmentMasterDataEntityStatus.StatusWeight > dbo.EntityStatus.StatusWeight) THEN ShipmentMasterDataEntityStatus.Id ELSE dbo.EntityStatus.Id END ELSE dbo.EntityStatus.Id END AS StatusId,
	CASE WHEN (MasterShipmentDataId IS NOT NULL) THEN CASE WHEN (ShipmentMasterDataEntityStatus.StatusWeight > dbo.EntityStatus.StatusWeight) THEN ShipmentMasterDataEntityStatus.StatusWeight ELSE dbo.EntityStatus.StatusWeight END ELSE dbo.EntityStatus.StatusWeight END AS StatusWeight,
	CASE WHEN (MasterShipmentDataId IS NOT NULL) THEN CASE WHEN (ShipmentMasterDataEntityStatus.StatusWeight > dbo.EntityStatus.StatusWeight) THEN ShipmentMasterDataEntityStatus.Name ELSE dbo.EntityStatus.Name END ELSE dbo.EntityStatus.Name END AS StatusName,
	CASE WHEN (MasterShipmentDataId IS NOT NULL) THEN CASE WHEN (ShipmentMasterDataEntityStatus.StatusWeight > dbo.EntityStatus.StatusWeight) THEN ShipmentMasterDataEntityStatus.Code ELSE dbo.EntityStatus.Code END ELSE dbo.EntityStatus.Code END AS StatusCode,
	CASE WHEN (MasterShipmentDataId IS NOT NULL) THEN CASE WHEN (ShipmentMasterDataEntityStatus.StatusWeight > dbo.EntityStatus.StatusWeight) THEN ShipMasterData.StatusLocation ELSE ship.StatusLocation END ELSE ship.StatusLocation END AS StatusLocation,
	CASE WHEN ('A' = ship.TransportModeId) 
		THEN CASE WHEN (( NOT ((AirlinePrefix IS NULL) OR ((LEN(AirlinePrefix)) = 0))) AND ( NOT ((Master IS NULL) OR ((LEN(Master)) = 0)))) 
		THEN CASE WHEN (AirlinePrefix IS NULL) THEN N'' ELSE AirlinePrefix END + N'-' + CASE WHEN (Master IS NULL) 
		THEN N'' ELSE Master END ELSE N'' END ELSE Master END AS LongMaster,
	CASE WHEN ((ship.ShipmentLevelCode = 'H') AND (MasterShipmentDataId IS NULL)) THEN ship.FromPortId ELSE ShipMasterData.MainCarriageFromPortId END AS MainCarriageFromPortId,
	CASE WHEN ((ship.ShipmentLevelCode = 'H') AND (MasterShipmentDataId IS NULL)) THEN ship.ToPortId ELSE ShipMasterData.MainCarriageToPortId END AS MainCarriageToPortId

    FROM
        dbo.Shipments as ship
    LEFT OUTER JOIN
        dbo.ShipmentMasterDatas as ShipMasterData
            ON ShipMasterData.Id = ship.MasterShipmentDataId 
    LEFT OUTER JOIN
        dbo.Ports AS MainCarriageFromPorts 
            ON ShipMasterData.MainCarriageFromPortId = MainCarriageFromPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS MainCarriageToPorts 
            ON ShipMasterData.MainCarriageToPortId = MainCarriageToPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS Transshipment1FromPorts 
            ON ShipMasterData.Transshipment1FromPortId = Transshipment1FromPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS Transshipment1ToPorts 
            ON ShipMasterData.Transshipment1ToPortId = Transshipment1ToPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS Transshipment2FromPorts 
            ON ShipMasterData.Transshipment2FromPortId = Transshipment2FromPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS Transshipment2ToPorts 
            ON ShipMasterData.Transshipment2ToPortId = Transshipment2ToPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS Transshipment3FromPorts 
            ON ShipMasterData.Transshipment3FromPortId = Transshipment3FromPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS Transshipment3ToPorts 
            ON ShipMasterData.Transshipment3ToPortId = Transshipment3ToPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS MainCarriageFinalDestinationPorts 
            ON ShipMasterData.MainCarriageFinalDestinationPortId = MainCarriageFinalDestinationPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS ToPorts 
            ON ship.ToPortId = ToPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS FromPorts 
            ON ship.FromPortId = FromPorts.Id 
    LEFT OUTER JOIN
        dbo.Cards AS ShipperCards 
            ON ship.ShipperId = ShipperCards.Id 
    LEFT OUTER JOIN
        dbo.Cards AS ConsigneeCards 
            ON ship.ConsigneeId = ConsigneeCards.Id 
	LEFT OUTER JOIN
		dbo.Contacts AS AccountManagerUserContacts 
			ON ship.AccountManagerUserId = AccountManagerUserContacts.Id 
    LEFT OUTER JOIN
        dbo.Countries AS MainCarriageFromCountries 
            ON MainCarriageFromPorts.CountryId = MainCarriageFromCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS MainCarriageToCountries 
            ON MainCarriageToPorts.CountryId = MainCarriageToCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS Transshipment1FromCountries 
            ON Transshipment1FromPorts.CountryId = Transshipment1FromCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS Transshipment2FromCountries 
            ON Transshipment2FromPorts.CountryId = Transshipment2FromCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS Transshipment3FromCountries 
            ON Transshipment3FromPorts.CountryId = Transshipment3FromCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS Transshipment1ToCountries 
            ON Transshipment1ToPorts.CountryId = Transshipment1ToCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS Transshipment2ToCountries 
            ON Transshipment2ToPorts.CountryId = Transshipment2ToCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS Transshipment3ToCountries 
            ON Transshipment3ToPorts.CountryId = Transshipment3ToCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS FromPortCountries 
            ON FromPorts.CountryId = FromPortCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS ToPortCountries 
            ON ToPorts.CountryId = ToPortCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS FinalDestinationCountries 
            ON MainCarriageFinalDestinationPorts.CountryId = FinalDestinationCountries.Id 
    LEFT OUTER JOIN
        dbo.Contacts AS CustomerContacts 
            ON ship.CustomerContactId = CustomerContacts.Id 
    LEFT OUTER JOIN
        dbo.Cards AS MainCarriageCarrierCards 
            ON ShipMasterData.MainCarriageCarrierId = MainCarriageCarrierCards.Id 
    LEFT OUTER JOIN
        dbo.Cards AS Transshipment1CarrierCards 
            ON ShipMasterData.Transshipment1CarrierId = Transshipment1CarrierCards.Id 
    LEFT OUTER JOIN
        dbo.Cards AS Transshipment2CarrierCards 
            ON ShipMasterData.Transshipment2CarrierId = Transshipment2CarrierCards.Id 
    LEFT OUTER JOIN
        dbo.Cards AS Transshipment3CarrierCards 
            ON ShipMasterData.Transshipment3CarrierId = Transshipment3CarrierCards.Id 
    LEFT OUTER JOIN
        dbo.NextLegs 
            ON ship.NextLegCode = dbo.NextLegs.Code 
    LEFT OUTER JOIN
        dbo.Directions 
            ON ship.DirectionId = dbo.Directions.Id 
    LEFT OUTER JOIN
        dbo.TransportModes 
            ON ship.TransportModeId = dbo.TransportModes.Id 
    LEFT OUTER JOIN
        dbo.ShipmentTypes 
            ON ship.ShipmentTypeId = dbo.ShipmentTypes.Id 
    LEFT OUTER JOIN
        dbo.ShipmentReceivableStatus 
            ON ship.ShipmentReceivableStatusCode = dbo.ShipmentReceivableStatus.Code 
    LEFT OUTER JOIN
        dbo.ShipmentPayableStatus 
            ON ship.ShipmentPayableStatusCode = dbo.ShipmentPayableStatus.Code 
    LEFT OUTER JOIN
        dbo.EntityStatus 
            ON ship.StatusId = dbo.EntityStatus.Id 
    LEFT OUTER JOIN
        dbo.Currencies AS AWBCurrencies 
            ON ship.AWBCurrencyId = AWBCurrencies.Id 
    LEFT OUTER JOIN
        dbo.Branches 
            ON ship.BranchId = dbo.Branches.Id 
    LEFT OUTER JOIN
        dbo.ShipmentSubTypes 
            ON ship.ShipmentSubTypeId = dbo.ShipmentSubTypes.Id 
    LEFT OUTER JOIN
        dbo.MoveTypes 
            ON ship.MoveTypeId = dbo.MoveTypes.Id 
    LEFT OUTER JOIN
        dbo.ShipmentLevels 
            ON ship.ShipmentLevelCode = dbo.ShipmentLevels.Code 
    LEFT OUTER JOIN
        dbo.EntityStatus AS ShipmentMasterDataEntityStatus 
            ON ShipMasterData.StatusId = ShipmentMasterDataEntityStatus.Id 
    LEFT OUTER JOIN
        dbo.Airlines AS MainCarriageAirline 
            ON ShipMasterData.MainCarriageCarrierId = MainCarriageAirline.Id 
    LEFT OUTER JOIN
        dbo.Incoterms 
            ON ship.IncotermId = dbo.Incoterms.Id 
    LEFT OUTER JOIN
        dbo.CustomsTransmissionsStatus 
            ON ship.LocalCustomsTransmissionsStatusCode = dbo.CustomsTransmissionsStatus.Code 
    LEFT OUTER JOIN
        dbo.Addresses AS MainCarriageFromAddresses 
            ON ShipMasterData.MainCarriageFromAddressId = MainCarriageFromAddresses.Id 
    LEFT OUTER JOIN
        dbo.Addresses AS MainCarriageToAddresses 
            ON ShipMasterData.MainCarriageToAddressId = MainCarriageToAddresses.Id 
    LEFT OUTER JOIN
        dbo.Cards AS MainCarriageToPartners 
            ON ShipMasterData.MainCarriageToPartnerId = MainCarriageToPartners.Id 
    LEFT OUTER JOIN
        dbo.Cards AS MainCarriageFromPartners 
            ON ShipMasterData.MainCarriageFromPartnerId = MainCarriageFromPartners.Id 
    LEFT OUTER JOIN
        dbo.Countries AS MainCarriageFromAddressCountries 
            ON MainCarriageFromAddresses.CountryId = MainCarriageFromAddressCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS MainCarriageToAddressCountries 
            ON MainCarriageToAddresses.CountryId = MainCarriageToAddressCountries.Id 
    LEFT OUTER JOIN
        dbo.SpecialServicesTypes 
            ON ship.SpecialServicesTypeId = dbo.SpecialServicesTypes.Id 
    LEFT OUTER JOIN
        dbo.Vessels 
            ON ShipMasterData.MainCarriageVesselId = dbo.Vessels.Id 
    LEFT OUTER JOIN
        dbo.Contacts AS SalesmanUserContact 
            ON ship.SalesmanUserId = SalesmanUserContact.Id 
    LEFT OUTER JOIN
        dbo.EntityStatus AS OperationalEntityStatus 
            ON ship.OperationalStatusId = OperationalEntityStatus.Id 
    LEFT OUTER JOIN
        dbo.Contacts AS LastSentByUserContact 
            ON ship.LastSentByUserId = LastSentByUserContact.Id 
    INNER JOIN
        dbo.ShipmentComputedFields AS ShipmentComputedFields 
            ON ship.Id = ShipmentComputedFields.Id 
    LEFT OUTER JOIN
        dbo.States AS InlandDomesticToState 
            ON InlandDomesticToState.Id = ShipMasterData.InlandDomesticToStateId 
    LEFT OUTER JOIN
        dbo.States AS InlandDomesticFromState 
            ON InlandDomesticFromState.Id = ShipMasterData.InlandDomesticFromStateId 
    ]]>
  </SqlScript>
  <OracleScript>
  </OracleScript>
</View>