<View DBType="Main" Name="DigitalShipmentsView" Schema="dbo" Module="Shipment">
  <SqlScript>
    <![CDATA[
	Create VIEW [dbo].[DigitalShipmentsView]  
	AS 
	SELECT
	Shipment.Id,
    Shipment.Tenant,
	Shipment.ChargeableWeight,
	Shipment.Volume,
	Shipment.ValueOfGoods,
	Shipment.NumberOfPackages,
	Shipment.GrossWeight,
	Shipment.CarrierLastStatusDate,
	Shipment.MasterShipmentDataId, 
	Shipment.IsOperationalClosed, 
	Shipment.IsAccountingClosed,
    Shipment.ShipmentNumber,
	Shipment.CustomerId,
    Shipment.CustomerReference1,
    Shipment.CustomerReference2,
    Shipment.CustomerReference3,
	Shipment.ShipperReference1,
	Shipment.ShipperReference2,
	Shipment.ConsigneeReference1,
	Shipment.ConsigneeReference2,
	Shipment.LastUpdateDate,
	Shipment.House,
	Shipment.AgentId,
    Shipment.ShipmentSubTypeId, 
    Shipment.ConsigneeId,
    Shipment.ShipperId, 
	Shipment.DescriptionOfGoods,
    Shipment.DirectionId,
    Shipment.CreateDateTime,
    Shipment.FirstPickupETA,
    Shipment.FirstPickupETD,
	Shipment.PreForwardingETD,
    Shipment.PreForwardingETA,
    Shipment.PreForwardingATA,
    Shipment.PreForwardingATD, 
	Shipment.AccountManagerUserId,
    Shipment.OnForwardingETA,
    Shipment.OnForwardingATA,
    Shipment.OnForwardingATD,
    Shipment.OnForwardingETD, 
    Shipment.TransportModeId,
    Shipment.ShipperName,
	Shipment.ConsigneeName,
	Shipment.SalesmanUserId,
	Shipment.ComputedStatusDate as StatusDate,
	Shipment.[From],
	Shipment.[To],
	Shipment.NextETA,
	Shipment.NextETD,
	Shipment.IsCancelled,
	Shipment.ShipmentLevelCode,
	Shipment.IncotermId,
	Shipment.ShipmentTypeId,
	Shipment.IsStandalonePickupDelivery,
    ShipmentMasterData.MainCarriageATA,
    ShipmentMasterData.MainCarriageATD,
    ShipmentMasterData.MainCarriageETD,
    ShipmentMasterData.MainCarriageETA,
	ShipmentMasterData.InlandDomesticFromCountryId,
	ShipmentMasterData.InlandDomesticToCountryId,
    ShipmentMasterData.InlandDomesticFromTypeCode,
    ShipmentMasterData.InlandDomesticToTypeCode,
    ShipmentMasterData.InlandDomesticFromCity,
    ShipmentMasterData.InlandDomesticToCity,
    ShipmentMasterData.Transshipment3ETA,
    ShipmentMasterData.Transshipment3ETD,
    ShipmentMasterData.Transshipment3ATA,
    ShipmentMasterData.Transshipment3ATD,
    ShipmentMasterData.Transshipment3ToPortId,
    ShipmentMasterData.Transshipment3FromPortId,
    ShipmentMasterData.Transshipment2CarrierNumber,
    ShipmentMasterData.Transshipment2ETA,
    ShipmentMasterData.Transshipment2ETD,
    ShipmentMasterData.Transshipment2ATA,
    ShipmentMasterData.Transshipment2ATD,
    ShipmentMasterData.Transshipment2ToPortId,
    ShipmentMasterData.Transshipment2FromPortId,
    ShipmentMasterData.Transshipment1CarrierNumber,
    ShipmentMasterData.Transshipment1ETA,
    ShipmentMasterData.Transshipment1ETD,
    ShipmentMasterData.Transshipment1ATA,
    ShipmentMasterData.Transshipment1ATD,
	ShipmentMasterData.[Master],
	ShipmentMasterData.InlandDomesticToAddress1,
    ShipmentMasterData.InlandDomesticToAddress2,
    ShipmentMasterData.InlandDomesticToPhone,
    ShipmentMasterData.InlandDomesticToFax,
    ShipmentMasterData.InlandDomesticToStateId,
	ShipmentMasterData.InlandDomesticFromAddress1,
    ShipmentMasterData.NumberOfTransshipments,
    ShipmentMasterData.InlandDomesticFromAddress2,
    ShipmentMasterData.InlandDomesticFromPhone,
    ShipmentMasterData.InlandDomesticFromFax,
	ShipmentMasterData.MainCarriageCarrierNumber,
	ShipmentMasterData.MainCarriageCarrierId,
    ShipmentMasterData.InlandDomesticFromStateId,
	ShipmentMasterData.PreCarriageETA,
    ShipmentMasterData.PreCarriageETD,
    ShipmentMasterData.PreCarriageATA,
    ShipmentMasterData.PreCarriageATD,
	ShipmentMasterData.Transshipment1ToPortId, 
	ShipmentMasterData.Transshipment1FromPortId,
	ShipmentMasterData.OnCarriageETD,
    ShipmentMasterData.OnCarriageETA,
    ShipmentMasterData.OnCarriageATD,
    ShipmentMasterData.OnCarriageATA,
	ShipmentMasterData.TruckNumber,
	ShipmentMasterData.DepartureArrivalFromDate as DepartureArrivalFromDate,
    ShipmentMasterData.DepartureArrivalToDate as DepartureArrivalToDate,
	ShipmentMasterData.MainCarriageFromAddressId, 
	ShipmentMasterData.MainCarriageToAddressId,
	ShipmentMasterData.MainCarriageFinalDestinationETA as MainCarriageFinalDestinationETA,
	ShipmentMasterData.MainCarriageFinalDestinationATA as MainCarriageFinalDestinationATA,
	ShipmentMasterData.MainCarriageFromPartnerId,
	ShipmentMasterData.MainCarriageToPartnerId,
	MainCarriageToCountries.Code AS MainCarriageToPortCountryCode,
	MainCarriageToCountries.EnglishName AS MainCarriageToPortCountryName,
    MainCarriageToPorts.EnglishName AS MainCarriageToPortName,
	MainCarriageToPorts.Code AS MainCarriageToPortCode,
    MainCarriageFromPorts.EnglishName AS MainCarriageFromPortName,
	MainCarriageFromPorts.Code AS MainCarriageFromPortCode,
    MainCarriageFromCountries.Code AS MainCarriageFromPortCountryCode,
    MainCarriageFromCountries.EnglishName AS MainCarriageFromPortCountryName, 
    InlandDomesticToState.EnglishName AS InlandDomesticToStateName, 
    InlandDomesticFromState.EnglishName AS InlandDomesticFromStateName,
    ShipmentComputedFields.Transshipments as Transshipments,
	ShipmentDigitalFields.IsCustomerArchived as IsCustomerArchived,
    dbo.Incoterms.Code AS IncotermCode,
	FinalDestinationCountries.Code AS MainCarriageFinalDestinationCountryCode,
	FinalDestinationCountries.EnglishName AS MainCarriageFinalDestinationCountryName,
	ToPortCountries.Code AS ToPortCountryCode,
    dbo.ShipmentSubTypes.[Name] AS ShipmentSubTypeName,
    dbo.TransportModes.[Name] AS TransportModeName,
    dbo.ShipmentTypes.[Name] AS ShipmentTypeName,
    dbo.Directions.[Name] AS DirectionName,
	ShipperCards.CountryCode as ShipperCountryCode,
    ConsigneeCards.CountryCode as ConsigneeCountryCode,
	AgentComputedCards.EnglishName AS AgentName,
	Transshipment1FromCountries.Code AS Transshipment1FromPortCountryCode,
	Transshipment1FromCountries.EnglishName AS Transshipment1FromPortCountryName,
	Transshipment2FromCountries.Code AS Transshipment2FromPortCountryCode,
	Transshipment2FromCountries.EnglishName AS Transshipment2FromPortCountryName,
	Transshipment3FromCountries.Code AS Transshipment3FromPortCountryCode,
	Transshipment3FromCountries.EnglishName AS Transshipment3FromPortCountryName,
	Transshipment1ToCountries.Code AS Transshipment1ToPortCountryCode,
	Transshipment1ToCountries.EnglishName AS Transshipment1ToPortCountryName,
	Transshipment2ToCountries.Code AS Transshipment2ToPortCountryCode,
	Transshipment2ToCountries.EnglishName AS Transshipment2ToPortCountryName,
	Transshipment3ToCountries.Code AS Transshipment3ToPortCountryCode,
	Transshipment3ToCountries.EnglishName AS Transshipment3ToPortCountryName, 
	MainCarriageCarrierCards.EnglishName AS MainCarriageCarrierName,
	MainCarriageCarrierCards.Code AS MainCarriageCarrierCode, 
	Transshipment1CarrierCards.EnglishName AS Transshipment1CarrierName,
	Transshipment1CarrierCards.Code AS Transshipment1CarrierCode,
	Transshipment2CarrierCards.EnglishName AS Transshipment2CarrierName,
	Transshipment2CarrierCards.Code AS Transshipment2CarrierCode, 
	Transshipment3CarrierCards.EnglishName AS Transshipment3CarrierName,
	Transshipment3CarrierCards.Code AS Transshipment3CarrierCode,
	AccountManagerUserContacts.EnglishName as AccountManagerUserName,
	SalesmanUserContact.EnglishName as SalesmanUserName,
	dbo.NextLegs.[Name] AS NextLegName,
	MainCarriageFromAddresses.City AS MainCarriageFromCity,
	MainCarriageToAddresses.City AS MainCarriageToCity, 
	dbo.ShipmentLevels.Name AS ShipmentLevelName,
	CustomerCards.EnglishName AS CustomerName,
	CreatedByUserContact.EnglishName as CreatedByUserName,
	FromPortCountries.Code AS FromPortCountryCode,
	ToPorts.Code AS ToPortCode,
	FromPorts.Code AS FromPortCode,
	MainCarriageFromAddressCountries.Code AS MainCarriageFromCountryCode,
	MainCarriageToAddressCountries.Code AS MainCarriageToCountryCode,
    ShipmentComputedFields.ContainersNumbersandTypesArray as ContainersNumbersandTypesArray, 
	ToPortCountries.EnglishName AS ToPortCountryName,
	FromPortCountries.EnglishName AS FromPortCountryName,
	CustomAgentImportCards.EnglishName AS CustomAgentImportName,
    CASE WHEN ( NOT ((dbo.ShipmentTypes.[Name] IS NULL) OR ((LEN(dbo.ShipmentTypes.[Name])) = 0)))
	THEN CASE WHEN (dbo.ShipmentTypes.[Name] IS NULL) 
	THEN N'' 
	ELSE dbo.ShipmentTypes.Name END + N' ' +
	CASE WHEN (dbo.ShipmentLevels.Name IS NULL) 
	THEN N'' 
	ELSE dbo.ShipmentLevels.Name END ELSE dbo.ShipmentLevels.Name END AS ShipmentType,
	CASE WHEN ( NOT ((MainCarriageFromPortId IS NULL) OR ((LEN(MainCarriageFromPortId)) = 0))) THEN MainCarriageFromPortId ELSE Shipment.FromPortId END AS FromPortId,
	CASE WHEN ( NOT ((MainCarriageToPortId IS NULL) OR ((LEN(MainCarriageToPortId)) = 0))) THEN MainCarriageToPortId ELSE Shipment.ToPortId END AS ToPortId,
	CASE WHEN ( NOT ((MainCarriageFromPorts.Code IS NULL) OR ((LEN(MainCarriageFromPorts.Code)) = 0))) THEN MainCarriageFromPorts.Code ELSE FromPorts.Code END AS FromPort,
	CASE WHEN ( NOT ((MainCarriageFromPorts.EnglishName IS NULL) OR ((LEN(MainCarriageFromPorts.EnglishName)) = 0))) THEN MainCarriageFromPorts.EnglishName ELSE FromPorts.EnglishName END AS FromPortName,
	CASE WHEN ( NOT ((MainCarriageFinalDestinationPorts.Code IS NULL) OR ((LEN(MainCarriageFinalDestinationPorts.Code)) = 0))) THEN MainCarriageFinalDestinationPorts.Code ELSE ToPorts.Code END AS ToPort,
	CASE WHEN ( NOT ((MainCarriageFinalDestinationPorts.EnglishName IS NULL) OR ((LEN(MainCarriageFinalDestinationPorts.EnglishName)) = 0))) THEN MainCarriageFinalDestinationPorts.EnglishName ELSE ToPorts.EnglishName END AS ToPortName,
	CASE WHEN ('A' = Shipment.TransportModeId) THEN CASE WHEN (MainCarriageCarrierCards.Code IS NULL) THEN N'' ELSE MainCarriageCarrierCards.Code END + CASE WHEN (MainCarriageCarrierNumber IS NULL) THEN N'' ELSE MainCarriageCarrierNumber 
	END WHEN ('O' = Shipment.TransportModeId) THEN CASE WHEN (ShipmentMasterData.MainCarriageVesselName IS NULL) THEN N'' ELSE ShipmentMasterData.MainCarriageVesselName END + N'/' + CASE WHEN (MainCarriageCarrierNumber IS NULL)
	THEN N'' ELSE MainCarriageCarrierNumber END WHEN ('I' = Shipment.TransportModeId AND 'D' = Shipment.DirectionId) THEN TruckNumber ELSE MainCarriageCarrierNumber END AS CarrierNumber,
	CASE WHEN (ShipmentMasterData.MainCarriageATA IS NOT NULL) THEN ShipmentMasterData.MainCarriageATA ELSE ShipmentMasterData.MainCarriageETA END AS MainCarriageExpectedOrActual,
	CASE WHEN (ShipmentMasterData.MainCarriageATA IS NOT NULL) THEN N'ATA' ELSE N'ETA' END AS MainCarriageETAOrATA,
	Shipment.ComputedStatusId AS StatusId,
	ComputedStatus.StatusWeight AS StatusWeight,
	ComputedStatus.Name AS StatusName,
	ComputedStatus.Code AS StatusCode,
	CASE WHEN (MasterShipmentDataId IS NOT NULL) THEN CASE WHEN (ShipmentMasterDataEntityStatus.StatusWeight > dbo.EntityStatus.StatusWeight) THEN ShipmentMasterData.StatusLocation ELSE Shipment.StatusLocation END ELSE Shipment.StatusLocation END AS StatusLocation,
	CASE WHEN ('A' = Shipment.TransportModeId) 
		THEN CASE WHEN (( NOT ((AirlinePrefix IS NULL) OR ((LEN(AirlinePrefix)) = 0))) AND ( NOT ((Master IS NULL) OR ((LEN(Master)) = 0)))) 
		THEN CASE WHEN (AirlinePrefix IS NULL) THEN N'' ELSE AirlinePrefix END + N'-' + CASE WHEN (Master IS NULL) 
		THEN N'' ELSE Master END ELSE N'' END ELSE Master END AS LongMaster,
	CASE WHEN ((Shipment.ShipmentLevelCode = 'H') AND (MasterShipmentDataId IS NULL)) THEN Shipment.FromPortId ELSE ShipmentMasterData.MainCarriageFromPortId END AS MainCarriageFromPortId,
	CASE WHEN ((Shipment.ShipmentLevelCode = 'H') AND (MasterShipmentDataId IS NULL)) THEN Shipment.ToPortId ELSE ShipmentMasterData.MainCarriageToPortId END AS MainCarriageToPortId

    FROM
        dbo.Shipments as Shipment
	LEFT OUTER JOIN
        dbo.ShipmentMasterDatas as ShipmentMasterData
            ON ShipmentMasterData.Id = Shipment.MasterShipmentDataId 
	LEFT OUTER JOIN
        dbo.Contacts AS CreatedByUserContact 
		    ON Shipment.CreatedByUserId = CreatedByUserContact.Id
	LEFT OUTER JOIN
         dbo.Cards AS CustomerCards 
		     ON Shipment.CustomerId = CustomerCards.Id
	LEFT OUTER JOIN
         dbo.Cards AS CustomAgentImportCards 
		     ON Shipment.CustomAgentImportId = CustomAgentImportCards.Id 
    LEFT OUTER JOIN
        dbo.Ports AS MainCarriageFromPorts 
            ON ShipmentMasterData.MainCarriageFromPortId = MainCarriageFromPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS MainCarriageToPorts 
            ON ShipmentMasterData.MainCarriageToPortId = MainCarriageToPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS Transshipment1FromPorts 
            ON ShipmentMasterData.Transshipment1FromPortId = Transshipment1FromPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS Transshipment1ToPorts 
            ON ShipmentMasterData.Transshipment1ToPortId = Transshipment1ToPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS Transshipment2FromPorts 
            ON ShipmentMasterData.Transshipment2FromPortId = Transshipment2FromPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS Transshipment2ToPorts 
            ON ShipmentMasterData.Transshipment2ToPortId = Transshipment2ToPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS Transshipment3FromPorts 
            ON ShipmentMasterData.Transshipment3FromPortId = Transshipment3FromPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS Transshipment3ToPorts 
            ON ShipmentMasterData.Transshipment3ToPortId = Transshipment3ToPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS MainCarriageFinalDestinationPorts 
            ON ShipmentMasterData.MainCarriageFinalDestinationPortId = MainCarriageFinalDestinationPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS ToPorts 
            ON Shipment.ToPortId = ToPorts.Id 
    LEFT OUTER JOIN
        dbo.Ports AS FromPorts 
            ON Shipment.FromPortId = FromPorts.Id 
    LEFT OUTER JOIN
        dbo.Cards AS ShipperCards 
            ON Shipment.ShipperId = ShipperCards.Id 
    LEFT OUTER JOIN
        dbo.Cards AS ConsigneeCards 
            ON Shipment.ConsigneeId = ConsigneeCards.Id 
	LEFT OUTER JOIN
		dbo.Contacts AS AccountManagerUserContacts 
			ON Shipment.AccountManagerUserId = AccountManagerUserContacts.Id 
    LEFT OUTER JOIN
        dbo.Countries AS MainCarriageFromCountries 
            ON MainCarriageFromPorts.CountryId = MainCarriageFromCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS MainCarriageToCountries 
            ON MainCarriageToPorts.CountryId = MainCarriageToCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS Transshipment1FromCountries 
            ON Transshipment1FromPorts.CountryId = Transshipment1FromCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS Transshipment2FromCountries 
            ON Transshipment2FromPorts.CountryId = Transshipment2FromCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS Transshipment3FromCountries 
            ON Transshipment3FromPorts.CountryId = Transshipment3FromCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS Transshipment1ToCountries 
            ON Transshipment1ToPorts.CountryId = Transshipment1ToCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS Transshipment2ToCountries 
            ON Transshipment2ToPorts.CountryId = Transshipment2ToCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS Transshipment3ToCountries 
            ON Transshipment3ToPorts.CountryId = Transshipment3ToCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS FromPortCountries 
            ON FromPorts.CountryId = FromPortCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS ToPortCountries 
            ON ToPorts.CountryId = ToPortCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS FinalDestinationCountries 
            ON MainCarriageFinalDestinationPorts.CountryId = FinalDestinationCountries.Id 
    LEFT OUTER JOIN
        dbo.Contacts AS CustomerContacts 
            ON Shipment.CustomerContactId = CustomerContacts.Id 
    LEFT OUTER JOIN
        dbo.Cards AS MainCarriageCarrierCards 
            ON ShipmentMasterData.MainCarriageCarrierId = MainCarriageCarrierCards.Id 
    LEFT OUTER JOIN
        dbo.Cards AS Transshipment1CarrierCards 
            ON ShipmentMasterData.Transshipment1CarrierId = Transshipment1CarrierCards.Id 
    LEFT OUTER JOIN
        dbo.Cards AS Transshipment2CarrierCards 
            ON ShipmentMasterData.Transshipment2CarrierId = Transshipment2CarrierCards.Id 
    LEFT OUTER JOIN
        dbo.Cards AS Transshipment3CarrierCards 
            ON ShipmentMasterData.Transshipment3CarrierId = Transshipment3CarrierCards.Id 
    LEFT OUTER JOIN
        dbo.NextLegs 
            ON Shipment.NextLegCode = dbo.NextLegs.Code 
    LEFT OUTER JOIN
        dbo.Directions 
            ON Shipment.DirectionId = dbo.Directions.Id 
    LEFT OUTER JOIN
        dbo.TransportModes 
            ON Shipment.TransportModeId = dbo.TransportModes.Id 
    LEFT OUTER JOIN
        dbo.ShipmentTypes 
            ON Shipment.ShipmentTypeId = dbo.ShipmentTypes.Id 
    LEFT OUTER JOIN
        dbo.ShipmentReceivableStatus 
            ON Shipment.ShipmentReceivableStatusCode = dbo.ShipmentReceivableStatus.Code 
    LEFT OUTER JOIN
        dbo.ShipmentPayableStatus 
            ON Shipment.ShipmentPayableStatusCode = dbo.ShipmentPayableStatus.Code 
    LEFT OUTER JOIN
        dbo.EntityStatus 
            ON Shipment.StatusId = dbo.EntityStatus.Id 
	LEFT OUTER JOIN
        dbo.EntityStatus As ComputedStatus
            ON Shipment.ComputedStatusId = ComputedStatus.Id 
    LEFT OUTER JOIN
        dbo.Currencies AS AWBCurrencies 
            ON Shipment.AWBCurrencyId = AWBCurrencies.Id 
    LEFT OUTER JOIN
        dbo.Branches 
            ON Shipment.BranchId = dbo.Branches.Id 
    LEFT OUTER JOIN
        dbo.ShipmentSubTypes 
            ON Shipment.ShipmentSubTypeId = dbo.ShipmentSubTypes.Id 
    LEFT OUTER JOIN
        dbo.MoveTypes 
            ON Shipment.MoveTypeId = dbo.MoveTypes.Id 
    LEFT OUTER JOIN
        dbo.ShipmentLevels 
            ON Shipment.ShipmentLevelCode = dbo.ShipmentLevels.Code 
    LEFT OUTER JOIN
        dbo.EntityStatus AS ShipmentMasterDataEntityStatus 
            ON ShipmentMasterData.StatusId = ShipmentMasterDataEntityStatus.Id 
    LEFT OUTER JOIN
        dbo.Airlines AS MainCarriageAirline 
            ON ShipmentMasterData.MainCarriageCarrierId = MainCarriageAirline.Id 
    LEFT OUTER JOIN
        dbo.Incoterms 
            ON Shipment.IncotermId = dbo.Incoterms.Id 
    LEFT OUTER JOIN
        dbo.CustomsTransmissionsStatus 
            ON Shipment.LocalCustomsTransmissionsStatusCode = dbo.CustomsTransmissionsStatus.Code 
    LEFT OUTER JOIN
        dbo.Addresses AS MainCarriageFromAddresses 
            ON ShipmentMasterData.MainCarriageFromAddressId = MainCarriageFromAddresses.Id 
    LEFT OUTER JOIN
        dbo.Addresses AS MainCarriageToAddresses 
            ON ShipmentMasterData.MainCarriageToAddressId = MainCarriageToAddresses.Id 
    LEFT OUTER JOIN
        dbo.Cards AS MainCarriageToPartners 
            ON ShipmentMasterData.MainCarriageToPartnerId = MainCarriageToPartners.Id 
    LEFT OUTER JOIN
        dbo.Cards AS MainCarriageFromPartners 
            ON ShipmentMasterData.MainCarriageFromPartnerId = MainCarriageFromPartners.Id 
    LEFT OUTER JOIN
        dbo.Countries AS MainCarriageFromAddressCountries 
            ON MainCarriageFromAddresses.CountryId = MainCarriageFromAddressCountries.Id 
    LEFT OUTER JOIN
        dbo.Countries AS MainCarriageToAddressCountries 
            ON MainCarriageToAddresses.CountryId = MainCarriageToAddressCountries.Id 
    LEFT OUTER JOIN
        dbo.SpecialServicesTypes 
            ON Shipment.SpecialServicesTypeId = dbo.SpecialServicesTypes.Id 
    LEFT OUTER JOIN
        dbo.Vessels 
            ON ShipmentMasterData.MainCarriageVesselId = dbo.Vessels.Id 
    LEFT OUTER JOIN
        dbo.Contacts AS SalesmanUserContact 
            ON Shipment.SalesmanUserId = SalesmanUserContact.Id 
    LEFT OUTER JOIN
        dbo.EntityStatus AS OperationalEntityStatus 
            ON Shipment.OperationalStatusId = OperationalEntityStatus.Id 
    LEFT OUTER JOIN
        dbo.Contacts AS LastSentByUserContact 
            ON Shipment.LastSentByUserId = LastSentByUserContact.Id 
    INNER JOIN
        dbo.ShipmentDigitalFields AS ShipmentDigitalFields 
            ON Shipment.Id = ShipmentDigitalFields.Id
	INNER JOIN
       dbo.ShipmentComputedFields AS ShipmentComputedFields 
           ON Shipment.Id = ShipmentComputedFields.Id
    LEFT OUTER JOIN
        dbo.Cards AS AgentComputedCards 
		   ON Shipment.AgentComputed = AgentComputedCards.Id
    LEFT OUTER JOIN
        dbo.States AS InlandDomesticToState 
            ON InlandDomesticToState.Id = ShipmentMasterData.InlandDomesticToStateId 
    LEFT OUTER JOIN
        dbo.States AS InlandDomesticFromState 
            ON InlandDomesticFromState.Id = ShipmentMasterData.InlandDomesticFromStateId 
    ]]>
  </SqlScript>
  <OracleScript>
  </OracleScript>
</View>