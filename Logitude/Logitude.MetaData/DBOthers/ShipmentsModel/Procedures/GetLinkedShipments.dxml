<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="GetLinkedShipments"
  Schema="dbo"
  Module="Shipment">

  <SqlScript>
    <![CDATA[

CREATE PROCEDURE [dbo].[GetLinkedShipments]
    @i_tenant int,
    @i_customerId VARCHAR(15),
    @i_transportModeId VARCHAR(1),
    @i_carrierCode NVARCHAR(15),
    @i_mawb VARCHAR(20),
    @i_house VARCHAR(20),
    @i_iskaNumber VARCHAR(16)
AS
BEGIN
    SELECT ship.ShipmentNumber
    FROM shipments AS ship
    LEFT JOIN customs.DECLARATIONS AS decl ON decl.CustomFileNo = ship.ShipmentNumber
    LEFT JOIN customs.declarationReferantDatas AS drd ON decl.id = drd.DeclarationId
    WHERE ship.tenant = @i_tenant
      AND ship.CustomerId = @i_customerId
      AND ship.TransportModeId = @i_transportModeId
      AND (
            (drd.CarrierCode = @i_carrierCode AND drd.Mawb = @i_mawb AND ship.House = @i_house) 
            OR
            ((ship.TransportModeId = 'O' OR ship.TransportModeId = 'L') AND ship.IskaNumber = @i_iskaNumber)
          );
END;

]]></SqlScript>

  <OracleScript>
  </OracleScript>
</Procedure>