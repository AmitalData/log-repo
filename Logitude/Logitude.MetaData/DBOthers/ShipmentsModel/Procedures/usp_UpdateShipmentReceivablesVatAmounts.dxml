<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="usp_UpdateShipmentReceivablesVatAmounts"
  Schema="dbo"
  Module="Shipment">
  <SqlScript><![CDATA[
Create PROCEDURE [dbo].[usp_UpdateShipmentReceivablesVatAmounts]
(
	@ShipmentId varchar(15)
)
AS

declare @Tenant as int
declare @EntityId as varchar(15)
declare @VatTypeId as varchar(15)
declare @VatPercentage as float
declare @ReceivableVatTypeId as varchar(15)
declare @CreateDate as Datetime
declare @VatAmountLocal as float
declare @VatAmountProfit as float
declare @TotalAmountLocal as float 
declare @AmountInProfitCurrency as float 
declare @IsMultiPercentage as bit
declare @SingleVATTypeId as varchar(15)
declare @ShipmentReceivablesVatTypeId as varchar(15)
declare @CustomerId as varchar(15)
declare @LocalCurrencyAmount as float 
declare @ProfitCurrencyAmount as float
declare @IsRegionalTax as bit
declare @RegionalTaxPercentage  as float
declare @ChargeTypeId as varchar(15)

BEGIN
	-- Loop Houses
	declare @HouseId as varchar(15)
	DECLARE ReceivableHousesCursor CURSOR READ_ONLY
	FOR
	SELECT Id
	FROM Shipments
	WHERE ShipmentLevelCode = 'H' AND MasterShipmentDataId = @ShipmentId
	OPEN ReceivableHousesCursor FETCH NEXT FROM ReceivableHousesCursor INTO @HouseId
	WHILE @@FETCH_STATUS = 0
	BEGIN
  -- Open lines 
      DECLARE DataCursor CURSOR READ_ONLY
         	FOR
         	SELECT ShipmentReceivables.Id, ShipmentReceivables.Tenant, VatTypeId, CreateDate, TotalAmountLocal, AmountInProfitCurrency, Shipments.CustomerId, ChargesTypeId
         	FROM ShipmentReceivables 
         	left join Shipments  on Shipments.Id = ShipmentReceivables.ShipmentId where ShipmentReceivables.ARInvoiceLineId is null and ShipmentId = @HouseId
         	OPEN DataCursor FETCH NEXT FROM DataCursor INTO @EntityId, @Tenant, @ShipmentReceivablesVatTypeId, @CreateDate, @TotalAmountLocal, @AmountInProfitCurrency, @CustomerId, @ChargeTypeId
         	WHILE @@FETCH_STATUS = 0
         	BEGIN
    
         	set @ReceivableVatTypeId = null;
          set @VatAmountLocal = @TotalAmountLocal;
          set @VatAmountProfit = @AmountInProfitCurrency;
            
         	if (@CustomerId is not null)
         	begin
         		set @ReceivableVatTypeId = (select top 1 VatTypeId from cards where id = @CustomerId);
         	end 
         
         	if (@ReceivableVatTypeId is null) 
         	begin
         		set @ReceivableVatTypeId = (select top 1 VatTypeId from ChargesTypes where Id =  @ChargeTypeId);
         	end
    
         	set @IsMultiPercentage = (select IsMultiPercentage from VatTypes where Tenant = @Tenant AND Id = @ReceivableVatTypeId)
         	if(@IsMultiPercentage = '0')
         	begin 
         		set @VatPercentage = (select top 1 Percentage from VatTypePercentages where VatTypeId = @ReceivableVatTypeId AND Tenant = @Tenant and FromDate <= @CreateDate order by FromDate desc)
         		if(@VatPercentage is not null)
            begin
              set @VatAmountLocal = Round(@VatAmountLocal + (@TotalAmountLocal * @VatPercentage / 100), 2);
         		  set @VatAmountProfit = Round(@VatAmountProfit +( @AmountInProfitCurrency * @VatPercentage / 100), 2);
            end
         	end
         
         	else 
         	begin 
         		set @VatAmountLocal = @TotalAmountLocal;
         		set @VatAmountProfit = @AmountInProfitCurrency;
         		DECLARE VatGroups_CURSOR CURSOR 
         		FOR 
         		SELECT SingleVATTypeId
         		FROM VATTypesGroups where GroupVATTypeId =  @ReceivableVatTypeId
         		OPEN VatGroups_CURSOR
         		FETCH NEXT FROM VatGroups_CURSOR INTO @SingleVATTypeId
         		WHILE @@FETCH_STATUS = 0
         		BEGIN 
         			set @VatPercentage = (select top 1 Percentage from VatTypePercentages where VatTypeId = @SingleVATTypeId AND Tenant = @Tenant and FromDate <= @CreateDate order by FromDate desc)
         			if(@VatPercentage is not null)
              begin
                set @VatAmountLocal = @VatAmountLocal + (@TotalAmountLocal * @VatPercentage / 100);
         			  set @VatAmountProfit = @VatAmountProfit + (@AmountInProfitCurrency * @VatPercentage / 100);
              end
         		FETCH NEXT FROM VatGroups_CURSOR INTO @SingleVATTypeId
         		END
         		CLOSE VatGroups_CURSOR
         		DEALLOCATE VatGroups_CURSOR
         	end
         
          update ShipmentReceivables set VatAmountLocal =  Round(@VatAmountLocal, 2),  VatAmountProfit =  Round(@VatAmountProfit,2) where Id = @EntityId and Tenant = @Tenant

         	FETCH NEXT FROM DataCursor INTO @EntityId, @Tenant, @ShipmentReceivablesVatTypeId,@CreateDate, @TotalAmountLocal, @AmountInProfitCurrency, @CustomerId, @ChargeTypeId
         	END
         	CLOSE DataCursor
         	DEALLOCATE DataCursor
        
	
     -- Connected lines 
     DECLARE DataCursor CURSOR READ_ONLY
     	FOR
         SELECT ShipmentReceivables.Id, ShipmentReceivables.Tenant, ARInvoiceLines.VatTypeId, ARInvoices.CreateDate, TotalAmountLocal, ShipmentReceivables.AmountInProfitCurrency, VatPercentage, IsRegionalTax, RegionalTaxPercentage
     	FROM ShipmentReceivables
     	left join ARInvoiceLines  on ARInvoiceLines.Id = ShipmentReceivables.ARInvoiceLineId
     	left join ARInvoices  on ARInvoices.Id = ARInvoiceLines.ARInvoiceId
     	where ShipmentReceivables.ARInvoiceLineId is not null  and ShipmentId = @HouseId
     	OPEN DataCursor FETCH NEXT FROM DataCursor INTO @EntityId, @Tenant, @VatTypeId, @CreateDate, @LocalCurrencyAmount, @ProfitCurrencyAmount, @VatPercentage, @IsRegionalTax,@RegionalTaxPercentage
     	WHILE @@FETCH_STATUS = 0
     	BEGIN
     	
     
     	set @IsMultiPercentage = (select IsMultiPercentage from VatTypes where Tenant = @Tenant AND Id = @VatTypeId)
     	if(@IsMultiPercentage = '0')
     	begin 
     	if(@VatPercentage is not null)
        begin
          set @VatAmountLocal = Round(@LocalCurrencyAmount + (@LocalCurrencyAmount * @VatPercentage / 100), 2);
     	set @VatAmountProfit = Round(@ProfitCurrencyAmount +( @ProfitCurrencyAmount * @VatPercentage / 100), 2);
        end
     
     		if(@IsRegionalTax = '1')
     		begin 
        if(@RegionalTaxPercentage is not null)
        begin
     		   set @VatAmountLocal = Round((@VatAmountLocal + @VatAmountLocal * (@RegionalTaxPercentage / 100)), 2);
           set @VatAmountProfit = Round((@VatAmountProfit + @VatAmountProfit * (@RegionalTaxPercentage / 100)), 2);
        end
     		end
     	end
     
     	else 
     	begin 
     		set @VatAmountLocal = @LocalCurrencyAmount;
     		set @VatAmountProfit = @ProfitCurrencyAmount;
     		DECLARE VatGroups_CURSOR CURSOR 
     		FOR 
     		SELECT SingleVATTypeId
     		FROM VATTypesGroups where GroupVATTypeId = @VatTypeId
     		OPEN VatGroups_CURSOR
     		FETCH NEXT FROM VatGroups_CURSOR INTO @SingleVATTypeId
     		WHILE @@FETCH_STATUS = 0
     		BEGIN 
     			set @VatPercentage = (select top 1 Percentage from VatTypePercentages where VatTypeId = @SingleVATTypeId AND Tenant = @Tenant and FromDate <= @CreateDate order by FromDate desc)
     			if(@VatPercentage is not null)
          begin
            set @VatAmountLocal = @VatAmountLocal + (@LocalCurrencyAmount * @VatPercentage / 100);
     			  set @VatAmountProfit = @VatAmountProfit + (@ProfitCurrencyAmount * @VatPercentage / 100);
          end
     		FETCH NEXT FROM VatGroups_CURSOR INTO @SingleVATTypeId
     		END
     		CLOSE VatGroups_CURSOR
     		DEALLOCATE VatGroups_CURSOR
     	end
     
        update ShipmentReceivables set VatAmountLocal =  Round(@VatAmountLocal, 2),  VatAmountProfit =  Round(@VatAmountProfit,2) where Id = @EntityId and Tenant = @Tenant

     	FETCH NEXT FROM DataCursor INTO @EntityId, @Tenant, @VatTypeId, @CreateDate, @LocalCurrencyAmount,@ProfitCurrencyAmount, @VatPercentage, @IsRegionalTax, @RegionalTaxPercentage
     	END
     	CLOSE DataCursor
     	DEALLOCATE DataCursor

	FETCH NEXT FROM ReceivableHousesCursor INTO @HouseId
	END
	CLOSE ReceivableHousesCursor
	DEALLOCATE ReceivableHousesCursor

END
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Procedure>