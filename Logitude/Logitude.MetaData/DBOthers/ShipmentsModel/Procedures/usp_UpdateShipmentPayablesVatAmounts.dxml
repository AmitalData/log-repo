<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="usp_UpdateShipmentPayablesVatAmounts"
  Schema="dbo"
  Module="Shipment">
  <SqlScript><![CDATA[
Create PROCEDURE [dbo].[usp_UpdateShipmentPayablesVatAmounts]
(
	@ShipmentId varchar(15)
)
AS

declare @Tenant as int 
declare @EntityId as varchar(15)
declare @VatTypeId as varchar(15)
declare @VatPercentage as float
declare @CardId as varchar(15)
declare @PayableVatTypeId as varchar(15)
declare @CreateDate as Datetime
declare @VatAmountLocal as float
declare @VatAmountProfit as float
declare @ExpectedAmountLocal as float 
declare @ExpectedAmountInProfitCurrency as float 
declare @IsMultiPercentage as bit
declare @SingleVATTypeId as varchar(15)
declare @InvoiceLinesVatAmountLocal  as float 
declare @InvoiceLinesVatAmountProfit as float 
declare @OpenAmountInLocalCurrency as float 
declare @OpenAmountInProfitCurrency as float 
declare @LocalCurrencyAmount as float 
declare @ProfitCurrencyAmount as float 
declare @InvoicelineVatPercentage as float 
    
BEGIN
	-- Loop Houses
	declare @HouseId as varchar(15)
	DECLARE HousesCursor CURSOR READ_ONLY
	FOR
	SELECT Id
	FROM Shipments
	WHERE ShipmentLevelCode = 'H' AND MasterShipmentDataId = @ShipmentId
	OPEN HousesCursor FETCH NEXT FROM HousesCursor INTO @HouseId
	WHILE @@FETCH_STATUS = 0
	BEGIN

      DECLARE DataCursor CURSOR READ_ONLY
      FOR
      SELECT Id, Tenant, VendorId, VatTypeId, CreateDate, ExpectedAmountLocal, ExpectedAmountInProfitCurrency
      FROM ShipmentPayables where ShipmentId = @HouseId
      OPEN DataCursor FETCH NEXT FROM DataCursor INTO @EntityId, @Tenant, @CardId, @VatTypeId, @CreateDate, @ExpectedAmountLocal, @ExpectedAmountInProfitCurrency
      WHILE @@FETCH_STATUS = 0
      BEGIN
                
      set @InvoiceLinesVatAmountLocal = 0;
      set @InvoiceLinesVatAmountProfit = 0;
                
      DECLARE APInvoiceLine_CURSOR CURSOR 
      FOR 
      SELECT LocalCurrencyAmount, ProfitCurrencyAmount, VatPercentage
      FROM APInvoiceLines where EntityPayableId = @EntityId
      OPEN APInvoiceLine_CURSOR
      FETCH NEXT FROM APInvoiceLine_CURSOR INTO @LocalCurrencyAmount, @ProfitCurrencyAmount, @InvoicelineVatPercentage
      WHILE @@FETCH_STATUS = 0
      BEGIN 
        set @IsMultiPercentage = (select IsMultiPercentage from VatTypes where Tenant = @Tenant AND Id = @VatTypeId)
        if(@IsMultiPercentage = '0')
        begin 
        if(@InvoicelineVatPercentage is not null)
          begin
            set @InvoiceLinesVatAmountLocal = @InvoiceLinesVatAmountLocal + (@LocalCurrencyAmount + @LocalCurrencyAmount * @InvoicelineVatPercentage / 100);
            set @InvoiceLinesVatAmountProfit = @InvoiceLinesVatAmountProfit + (@ProfitCurrencyAmount + @ProfitCurrencyAmount * @InvoicelineVatPercentage / 100);
          end
        end
                
        else 
        begin 
          set @InvoiceLinesVatAmountLocal = @InvoiceLinesVatAmountLocal + @LocalCurrencyAmount;
          set @InvoiceLinesVatAmountProfit = @InvoiceLinesVatAmountProfit + @ProfitCurrencyAmount;
          DECLARE VatGroups_CURSOR CURSOR 
          FOR 
          SELECT SingleVATTypeId
          FROM VATTypesGroups where GroupVATTypeId = @VatTypeId
          OPEN VatGroups_CURSOR
          FETCH NEXT FROM VatGroups_CURSOR INTO @SingleVATTypeId
          WHILE @@FETCH_STATUS = 0
          BEGIN 
            set @VatPercentage = (select top 1 Percentage from VatTypePercentages where VatTypeId = @SingleVATTypeId AND Tenant = @Tenant and FromDate <= GETDATE() order by FromDate desc)
            if(@VatPercentage is not null)
            begin
              set @InvoiceLinesVatAmountLocal = @InvoiceLinesVatAmountLocal + (@LocalCurrencyAmount * @VatPercentage / 100);
              set @InvoiceLinesVatAmountProfit = @InvoiceLinesVatAmountProfit + (@ProfitCurrencyAmount * @VatPercentage / 100);
            end
          FETCH NEXT FROM VatGroups_CURSOR INTO @SingleVATTypeId
          END
          CLOSE VatGroups_CURSOR
          DEALLOCATE VatGroups_CURSOR
        end
                
      FETCH NEXT FROM APInvoiceLine_CURSOR INTO @LocalCurrencyAmount, @ProfitCurrencyAmount, @InvoicelineVatPercentage
      END
      CLOSE APInvoiceLine_CURSOR
      DEALLOCATE APInvoiceLine_CURSOR
                
      set @OpenAmountInLocalCurrency =  dbo.CalculatePayableVatOpenAmount(@CardId,@VatTypeId, @Tenant, @CreateDate, @ExpectedAmountLocal) ;
      set @OpenAmountInProfitCurrency = dbo.CalculatePayableVatOpenAmount(@CardId,@VatTypeId, @Tenant, @CreateDate, @ExpectedAmountInProfitCurrency);
                	
        if(@OpenAmountInLocalCurrency is null) set @OpenAmountInLocalCurrency = 0;
      if(@OpenAmountInProfitCurrency is null) set @OpenAmountInProfitCurrency = 0;
                	    
      set @VatAmountLocal = Round(@InvoiceLinesVatAmountLocal + @OpenAmountInLocalCurrency, 2);
      set @VatAmountProfit = Round(@InvoiceLinesVatAmountProfit + @OpenAmountInProfitCurrency, 2);
                
      update ShipmentPayables set VatAmountLocal = @VatAmountLocal, VatAmountProfit = @VatAmountProfit where Id = @EntityId and Tenant = @Tenant
                
      FETCH NEXT FROM DataCursor INTO @EntityId, @Tenant, @CardId, @VatTypeId, @CreateDate, @ExpectedAmountLocal, @ExpectedAmountInProfitCurrency
      END
      CLOSE DataCursor
      DEALLOCATE DataCursor

	FETCH NEXT FROM HousesCursor INTO @HouseId
	END
	CLOSE HousesCursor
	DEALLOCATE HousesCursor

END
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Procedure>