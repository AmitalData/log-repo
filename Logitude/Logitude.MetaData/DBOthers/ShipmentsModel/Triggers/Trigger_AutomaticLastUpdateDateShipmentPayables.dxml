<?xml version="1.0" encoding="utf-8"?>
<Trigger
  DBType="Main"
  Name="Trigger_AutomaticLastUpdateDateShipmentPayables"
  Schema="dbo"
  Module="Shipment">
  <SqlScript><![CDATA[
CREATE TRIGGER Trigger_AutomaticLastUpdateDateShipmentPayables ON ShipmentPayables AFTER UPDATE  AS  BEGIN UPDATE ShipmentPayables SET AutomaticLastUpdateDate = GETDATE() WHERE Id IN (SELECT DISTINCT Id FROM Inserted)END;
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Trigger>