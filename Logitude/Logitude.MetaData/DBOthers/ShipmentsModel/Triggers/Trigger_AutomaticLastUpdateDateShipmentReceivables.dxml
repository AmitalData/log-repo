<?xml version="1.0" encoding="utf-8"?>
<Trigger
  DBType="Main"
  Name="Trigger_AutomaticLastUpdateDateShipmentReceivables"
  Schema="dbo"
  Module="Shipment">
  <SqlScript><![CDATA[
CREATE TRIGGER Trigger_AutomaticLastUpdateDateShipmentReceivables ON ShipmentReceivables AFTER UPDATE  AS  BEGIN UPDATE ShipmentReceivables SET AutomaticLastUpdateDate = GETDATE() WHERE Id IN (SELECT DISTINCT Id FROM Inserted)END;
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Trigger>