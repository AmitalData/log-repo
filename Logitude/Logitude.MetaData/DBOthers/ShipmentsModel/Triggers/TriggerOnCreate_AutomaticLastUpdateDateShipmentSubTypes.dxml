<?xml version="1.0" encoding="utf-8"?>
<Trigger
  DBType="Main"
  Name="TriggerOnCreate_AutomaticLastUpdateDateShipmentSubTypes"
  Schema="dbo"
  Module="Shipment">
  <SqlScript><![CDATA[
CREATE TRIGGER TriggerOnCreate_AutomaticLastUpdateDateShipmentSubTypes ON ShipmentSubTypes AFTER Insert  AS  BEGIN UPDATE ShipmentSubTypes SET AutomaticLastUpdateDate = GETDATE() WHERE Id IN (SELECT DISTINCT Id FROM Inserted)END;
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Trigger>