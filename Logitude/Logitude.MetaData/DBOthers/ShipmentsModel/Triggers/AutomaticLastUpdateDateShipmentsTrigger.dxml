<Trigger DBType="Main" Name="Trigger_AutomaticLastUpdateDateShipments" Schema="dbo" Module="Shipment">
  <SqlScript>
    <![CDATA[
CREATE TRIGGER [dbo].[Trigger_AutomaticLastUpdateDateShipments]
ON [dbo].[Shipments]
AFTER UPDATE
AS
BEGIN
UPDATE Shipments SET AutomaticLastUpdateDate = GETDATE() WHERE Id IN (SELECT DISTINCT Id FROM Inserted)
END;
    ]]>
  </SqlScript>
  
  <OracleScript>
  </OracleScript>
</Trigger>