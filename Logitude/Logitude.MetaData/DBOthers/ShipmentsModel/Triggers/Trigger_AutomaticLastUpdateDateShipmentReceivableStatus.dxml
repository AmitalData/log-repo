<?xml version="1.0" encoding="utf-8"?>
<Trigger
  DBType="Main"
  Name="Trigger_AutomaticLastUpdateDateShipmentReceivableStatus"
  Schema="dbo"
  Module="Shipment">
  <SqlScript>
    <![CDATA[
CREATE TRIGGER Trigger_AutomaticLastUpdateDateShipmentReceivableStatus ON ShipmentReceivableStatus AFTER UPDATE  AS  BEGIN UPDATE ShipmentReceivableStatus SET AutomaticLastUpdateDate = GETDATE() WHERE Code IN (SELECT DISTINCT Code FROM Inserted) END;
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Trigger>