<?xml version="1.0" encoding="utf-8"?>
<Trigger
  DBType="Main"
  Name="TriggerOnCreate_AutomaticLastUpdateDateQuotes"
  Schema="dbo"
  Module="Quote">
  <SqlScript>
	  <![CDATA[
CREATE TRIGGER TriggerOnCreate_AutomaticLastUpdateDateQuotes ON Quotes AFTER Insert  AS  BEGIN UPDATE Quotes SET AutomaticLastUpdateDate = GETDATE() WHERE Id IN (SELECT DISTINCT Id FROM Inserted)END;
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Trigger>