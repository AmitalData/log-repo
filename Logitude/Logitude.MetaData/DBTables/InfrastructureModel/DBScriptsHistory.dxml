<?xml version="1.0" encoding="utf-8"?>
<Table Name="DBScriptsHistory" Schema="dbo" Module="Infrastructure">

  <Column Name="SxmlFileName" Type="varchar" Size="500">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  
  <Column Name="ExecutionDate" Type="datetime">
    <Constraints Nullable="false" />
  </Column>
  
  <Column Name="ScriptBody" Type="nvarchar" Size="-1">
    <Constraints Nullable="false" />
  </Column>

  <Column Name="ElapsedTimeInMs" Type="bigint">
    <Constraints Nullable="false" />
  </Column>

  <Column Name="HashValue" Type="nvarchar" Size="-1">
    <Constraints Nullable="false" />
  </Column>

  <Column Name="Version" Type="int">
    <Constraints Nullable="false" />
  </Column>

</Table>