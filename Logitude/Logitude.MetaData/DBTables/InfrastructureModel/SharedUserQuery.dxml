<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SharedUserQueries"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="QueryId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="QueryCode"
    Type="varchar"
    Size="200">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="UserId"
    ReferencedTable="Users"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="QueryId"
    ReferencedTable="Queries"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>