<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="DBIdCounters"
  Schema="dbo"
  DBType="Main"
  Module="Infrastructure">
  <Column
    Name="Id"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="TableName"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LastIdNumber"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <UniqueConstraint
    Columns="TableName" />
</Table>