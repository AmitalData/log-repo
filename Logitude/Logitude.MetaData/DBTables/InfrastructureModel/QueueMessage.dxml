<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="QueueMessages"
  Schema="dbo"
  DBType="Main"
  Module="Infrastructure">
  <Column
    Name="Id"
    Type="bigint">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int"
    DefaultValue="-1">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="QueueDefinitionCode"
    Type="varchar"
    Size="265">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDateTime"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Status"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="MessageBody"
    Type="varchar"
    Size="1000">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="NextRunDateTime"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ProcessingDateTime"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CompleteDateTime"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="RetryNumber"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
   Name="HashCode"
   Type="nvarchar"
   Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
	<Column
  Name="TenantPriority"
  Type="int"
  DefaultValue="7">
		
		<Constraints
		  Nullable="true" />
	</Column>


	<Column
		Name="InterfaceTypeCode"
		Type="varchar"
		Size="32">
		<Constraints
		  Nullable="true" />
	</Column>

	

	<Column
		Name="QueueCodeRabbit"
		Type="varchar"
		Size="256">
		<Constraints
		  Nullable="true" />
	</Column>



	<Column
    Name="UseRabbitMQ"
    Type="bit"
	DefaultValue="0">
		<Constraints
		  Nullable="false" />
	</Column>

	
	<Column
    Name="HaveRabbitMQ"
    Type="bit"
    DefaultValue="0">
		<Constraints
		  Nullable="false" />
	</Column>


	<Column
    Name="RabbitMQCreateDate"
    Type="datetime">
		<Constraints
		  Nullable="true" />
	</Column>
	<Column
   Name="RabbitMQRetryNumber"
   Type="int"
   DefaultValue="0">
		<Constraints
		  Nullable="false" />
	</Column>
	<Column
    Name="RabbitMQErrMess"
    Type="varchar"
    Size="256">
	<Constraints
      Nullable="false" />
	</Column>
	
	
	<Relation
    ForeignKeyColumn="QueueDefinitionCode"
    ReferencedTable="QueueDefinitions"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Index
    Columns="QueueDefinitionCode,Status,NextRunDateTime"
    Include="Id" />

	<Index
  Columns="UseRabbitMQ"
   />


	<Index
  Columns="Status,NextRunDateTime,UseRabbitMQ,HaveRabbitMQ"
   />


</Table>