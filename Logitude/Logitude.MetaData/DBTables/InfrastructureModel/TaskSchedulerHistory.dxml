<?xml version="1.0" encoding="utf-8"?>
<Table Name="TaskSchedulerHistory" Schema="dbo" DBType="Main">
  <Column Name="Id" Type="varchar" Size="15">
    <Constraints PrimaryKey="true" Nullable="false" />
