<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SearchIndexes"
  Schema="dbo"
  DBType="Main"
  Module="Infrastructure">
  <Column
    Name="Index"
    Type="varchar"
    Size="50">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Indexer"
    Type="varchar"
    Size="50">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsView"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ObjectName"
    Type="varchar"
    Size="50">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TtlMonth"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="TtlField"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="BuildIntervalMin"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
</Table>