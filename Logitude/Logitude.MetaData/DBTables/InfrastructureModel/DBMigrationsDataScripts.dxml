<?xml version="1.0" encoding="utf-8"?>
<Table Name="DBMigrationsDataScripts" Schema="dbo" DBType="Main" Module="Infrastructure">

  <Column Name="Id" Type="nvarchar" Size="128">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>

  <Column Name="SxmlFileName" Type="varchar" Size="500">
    <Constraints Nullable="false" />
  </Column>

  <Column Name="DatabaseType" Type="varchar" Size="15">
    <Constraints Nullable="false" />
  </Column>

  <Column Name="SxmlScript" Type="nvarchar" Size="-1">
    <Constraints Nullable="false" />
  </Column>

  <Column Name="IsPreSxml" Type="bit">
    <Constraints Nullable="false" />
  </Column>

  <Column Name="Status" Type="varchar" Size="25">
    <Constraints Nullable="false" />
  </Column>

  <Column Name="ScriptExecutionNumber" Type="int">
    <Constraints Nullable="false" />
  </Column>

  <Column Name="StartDate" Type="datetime">
    <Constraints Nullable="true" />
  </Column>

  <Column Name="EndDate" Type="datetime">
    <Constraints Nullable="true" />
  </Column>

  <Column Name="LastBatchElapsedTime" Type="int">
    <Constraints Nullable="false" />
  </Column>

  <Column Name="ScriptVersion" Type="int">
    <Constraints Nullable="false" />
  </Column>

  <Column Name="ScriptHashValue" Type="nvarchar" Size="-1">
    <Constraints Nullable="false" />
  </Column>

  <Column Name="ScriptHistoryAction" Type="varchar" Size="10">
    <Constraints Nullable="false" />
  </Column>

  <Column Name="TargetTableName" Type="varchar" Size="500">
    <Constraints Nullable="false" />
  </Column>

  <Column Name="BatchSize" Type="int">
    <Constraints Nullable="true" />
  </Column>

</Table>