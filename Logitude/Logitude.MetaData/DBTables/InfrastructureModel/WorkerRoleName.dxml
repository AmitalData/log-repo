<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="WorkerRoleNames"
  Schema="dbo"
  DBType="Main"
  Module="Infrastructure">
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="varchar"
    Size="100">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="WaitingStatus"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
</Table>