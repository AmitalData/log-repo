<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CounterStats"
  Schema="dbo"
  DBType="Main"
  Module="Infrastructure">
  <Column
    Name="Id"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Prefix"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LastValue"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CounterId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
	<Column
		Name="BranchCounterCode"
		Type="varchar"
		Size="5">
		<Constraints
		  Nullable="true" />
	</Column>
  <Relation
    ForeignKeyColumn="CounterId"
    ReferencedTable="Counters"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Index
	Columns="CounterId,Tenant" />
  <Index
	Columns="CounterId,Prefix,Tenant" />
</Table>