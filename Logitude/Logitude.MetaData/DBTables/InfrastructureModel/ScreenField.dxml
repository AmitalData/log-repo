<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ScreenFields"
  Schema="dbo"
  DBType="Main"
  Module="Infrastructure">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Column"
    ShortName="Column_"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Row"
    ShortName="Row_"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ScreenId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ScreenCode"
    Type="varchar"
    Size="200">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ObjectFieldId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ObjectFieldCode"
    Type="varchar"
    Size="200">
    <Constraints
      Nullable="false" />
   </Column> 

  <Column
    Name="SectionNumber"
    ShortName="SectionNumber"
    Type="int" >
  <Constraints
      Nullable="true" />
  </Column>
 
  <Relation
    ForeignKeyColumn="ScreenId"
    ReferencedTable="Screens"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo"
    Ignore="true" />
  <Relation
    ForeignKeyColumn="ObjectFieldId"
    ReferencedTable="ObjectFields"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo"
    Ignore="true" />
  <Index
    Columns="Tenant" />
</Table>