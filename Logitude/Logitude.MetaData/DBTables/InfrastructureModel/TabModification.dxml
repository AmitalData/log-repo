<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="TabsModifications"
  Schema="dbo"
  DBType="Main"
  Module="Infrastructure">
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TabCode"
    OldNames="ScreenCode"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="TabId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Order"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
</Table>