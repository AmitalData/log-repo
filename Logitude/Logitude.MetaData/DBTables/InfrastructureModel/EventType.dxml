<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="EventTypes"
  Schema="dbo"
  DBType="Main"
  Module="Infrastructure">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="ShortView"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CustomerRoleId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AgentRoleId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AllowedInAutomation"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="EventTypeCategoryCode"
    Type="nvarchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsCustomerView"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsAgentView"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsSharedLogisticsEnabled"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Code"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EnglishName"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ObjectTableId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EntityStatusId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsFollowUp"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="FollowUpEnglishName"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FollowUpLocalName"
    Type="nvarchar"
    Size="40">
    <Constraints
      Nullable="true" />
