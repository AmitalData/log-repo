<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="MenusTables"
  Schema="dbo"
  DBType="Main"
  Module="Infrastructure">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="MenuTypeCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CategoryTypeCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IndexOfOrder"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Icon"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TextCode"
    Type="varchar"
    Size="50">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UserControlName"
    Type="varchar"
    Size="120">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ObjectTableId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FeatureId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Code"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="HtmlView"
    Type="varchar"
    Size="120">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FeatureUniqeCode"
    Type="varchar"
    Size="120">
    <Constraints
      Nullable="true" />
  </Column>
   <Column
    Name="QuerySection"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  
  <Relation
    ForeignKeyColumn="MenuTypeCode"
    ReferencedTable="MenuTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="CategoryTypeCode"
    ReferencedTable="CategoryTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ObjectTableId"
    ReferencedTable="ObjectTables"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="FeatureId"
    ReferencedTable="Features"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo"
    Ignore="true" />
  <UniqueConstraint
    Columns="Code,Tenant" />
</Table>