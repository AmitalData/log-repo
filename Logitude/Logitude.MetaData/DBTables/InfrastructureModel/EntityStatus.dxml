<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="EntityStatus"
  Schema="dbo"
  DBType="Main"
  Module="Infrastructure">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ObjectTableId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Code"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="InActive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="StatusWeight"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DisplayName"
    Type="varchar"
    Size="40"
    DefaultValue="''">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="AutomaticLastUpdateDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="EntityStatusTypeCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="StatusLocalWeight"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AllowPartial"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsDigitalPortal"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="ObjectTableId"
    ReferencedTable="ObjectTables"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="EntityStatusTypeCode"
    ReferencedTable="EntityStatusTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Index
    Columns="AutomaticLastUpdateDate" />
