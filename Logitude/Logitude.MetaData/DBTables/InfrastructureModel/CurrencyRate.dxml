<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CurrencyRates"
  Schema="dbo"
  DBType="Main"
  Module="Infrastructure">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ExchangeRateId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="AdditionalCurrencyRateId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Rate"
    Type="float">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="ExchangeRateId"
    ReferencedTable="RatesTables"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="AdditionalCurrencyRateId"
    ReferencedTable="AdditionalCurrencyRates"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>