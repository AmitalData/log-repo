<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SearchIndexTenantHistories"
  Schema="dbo"
  DBType="Main"
  Module="Infrastructure">
  <Column
    Name="Screen"
    OldNames="Index"
    Type="varchar"
    Size="50">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="TtlMonth"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LastUpdate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
</Table>