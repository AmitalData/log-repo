<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ObjectTableTabs"
  Schema="dbo"
  DBType="Main"
  Module="Infrastructure">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ObjectTableId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ControlPath"
    Type="varchar"
    Size="250">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="TabNameTextCodeId"
    Type="varchar"
    Size="30">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IndexOrder"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Code"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="FeatureId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TabNameTextCodeCode"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="FeatureUniqeCode"
    Type="varchar"
    Size="120">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="HtmlComponentName"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
    
  <Column
    Name="HtmlComponentUrl"
    Type="varchar"
    Size="256">
    <Constraints
      Nullable="true" />
  </Column>


    <Column
      Name="CustomOrder"
      Type="int">
        <Constraints
          Nullable="true" />
    </Column>
    <Column
      Name="Type"
      Type="varchar"
      DefaultValue="Predefined"
      Size="50">
        <Constraints
          Nullable="true"
          />
    </Column>
    <Column
      Name="Name"
      Type="varchar"
      Size="300">
        <Constraints
          Nullable="true" />
    </Column>
    <Column
      Name="ScreenId"
      Type="varchar"
      Size="50">
        <Constraints
          Nullable="true" />
    </Column>





    <Relation
    ForeignKeyColumn="ObjectTableId"
    ReferencedTable="ObjectTables"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="TabNameTextCodeId"
    ReferencedTable="TextCodes"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo"
    Ignore="true" />
  <Relation
    ForeignKeyColumn="FeatureId"
    ReferencedTable="Features"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo"
    Ignore="true" />
  <UniqueConstraint
    Columns="Code,Tenant" />
</Table>