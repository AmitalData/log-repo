<?xml version="1.0" encoding="utf-8"?>
<Table Name="Translations">
  <Column Name="Id" Type="varchar" Size="15">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="Tenant" Type="int">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="TextCodeId" Type="varchar" Size="30">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="TranslateDate" Type="datetime">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="TranslatedByUserId" Type="varchar" Size="15">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="TranslatedText" Type="nvarchar" Size="500">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="TranslatedTextPlural" Type="nvarchar" Size="500">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="TranslationHeaderCode" Type="varchar" Size="15">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="UpdateDateGMT" Type="datetime">
    <Constraints Nullable="true" />
  </Column>
</Table>