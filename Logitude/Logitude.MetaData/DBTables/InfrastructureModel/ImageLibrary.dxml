<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ImageLibrarys"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="40">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Description"
    Type="nvarchar"
    Size="200">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DocumentId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="DocumentId"
    ReferencedTable="Documents"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>