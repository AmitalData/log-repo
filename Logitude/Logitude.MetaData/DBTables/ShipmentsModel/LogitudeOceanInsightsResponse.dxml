<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="LogitudeOceanInsightsResponses"
  Schema="dbo"
  DBType="Main"
  Module="Shipment">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ContainerNumber"
    Type="varchar"
    Size="250">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CarrierName"
    Type="nvarchar"
    Size="200">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FirstResponseDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LastResponseDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
   <Column
      Name="SCACCode"
      Type="varchar"
      Size="250">
      <Constraints
        Nullable="false" />
    </Column>
</Table>