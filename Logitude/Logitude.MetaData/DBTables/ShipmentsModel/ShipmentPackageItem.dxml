<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ShipmentPackageItems"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="PackageId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LineNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Description"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Quantity"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="GoodsValue"
    Type="decimal"
    Precision="18"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="PackageId"
    ReferencedTable="ShipmentPackages"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>