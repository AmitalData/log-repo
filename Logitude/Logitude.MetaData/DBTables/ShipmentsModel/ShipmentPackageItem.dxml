<?xml version="1.0" encoding="utf-8"?>
<Table Name="ShipmentPackageItems">
  <Column Name="Description" Type="varchar" Size="100">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="GoodsValue" Type="decimal">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="LineNumber" Type="int">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="PackageId" Type="varchar" Size="15">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="Quantity" Type="int">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Tenant" Type="int">
    <Constraints Nullable="false" />
  </Column>
</Table>