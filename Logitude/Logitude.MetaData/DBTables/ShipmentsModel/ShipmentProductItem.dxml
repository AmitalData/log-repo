<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ShipmentProductItems"
  Schema="dbo"
  DBType="Main"
  Module="Shipment">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ShipmentId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ProductItemId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Description"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="HTSCode"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SKU"
    Type="varchar"
    Size="30">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ApprovedByCustomer"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Brand"
    Type="varchar"
    Size="60">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Name"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="ProductItemId"
    ReferencedTable="ProductItems"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>