<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ExternalLinks"
  Schema="dbo"
  DBType="Main"
  Module="Shipment">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Ref"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Link"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
</Table>