<?xml version="1.0" encoding="utf-8"?>
<Table Name="ShipmentCarrierStatuses">
  <Column Name="AirlineName" Type="varchar" Size="60">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="ArrivalDate" Type="datetime">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="DepartureDate" Type="datetime">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Details" Type="nvarchar" Size="250">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="EventDate" Type="datetime">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="FlightNumber" Type="varchar" Size="15">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="FromPortId" Type="varchar" Size="15">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Id" Type="varchar" Size="15">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="Location" Type="varchar" Size="15">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Partial" Type="bit">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="Pieces" Type="int">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="ReceivingDate" Type="datetime">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="RecordHash" Type="nvarchar" Size="500">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="ShipmentId" Type="varchar" Size="15">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="Status" Type="varchar" Size="4">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="Tenant" Type="int">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="TimeOfArrivalInfo" Type="varchar" Size="1">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="TimeOfDepartureInfo" Type="varchar" Size="1">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="ToPortId" Type="varchar" Size="15">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Weight" Type="float">
    <Constraints Nullable="false" />
  </Column>
</Table>