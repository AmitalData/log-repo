<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="FBLStocks"
  Schema="dbo"
  DBType="Main"
  Module="Shipment">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsUsed"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Number"
    ShortName="Number_"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="InsertionDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Notes"
    Type="nvarchar"
    Size="250">
    <Constraints
      Nullable="true" />
  </Column>
</Table>