<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="FreightForwarderReferences"
  Schema="dbo"
  DBType="Main"
  Module="Shipment">
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="ShipmentId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="ForwarderShipmentNumber"
    OldNames="ShipmentNumber"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ForwarderFileConnect"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LineNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="ShipmentId"
    ReferencedTable="Shipments"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>