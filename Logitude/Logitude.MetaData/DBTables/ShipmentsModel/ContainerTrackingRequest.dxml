<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ContainerTrackingRequests"
  Schema="dbo"
  DBType="Main"
  Module="Shipmant">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Provider"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ContainerNumber"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Master"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="RequestId"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ContainerId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ShipmentId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CarrierCode"
    Type="varchar"
    Size="200">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Status"
    Type="varchar"
    Size="30">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsSimulate"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ScacCode"
    Type="varchar"
    Size="200">
    <Constraints
      Nullable="true" />
  </Column>
  <UniqueConstraint
  Columns="Tenant,ContainerId,ShipmentId,Status"/>
  
</Table>