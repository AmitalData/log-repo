<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ShipmentUnassignedFields"
  Schema="dbo"
  DBType="Main"
  Module="Shipment">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ShipmentId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="FieldName"
    Type="varchar"
    Size="35">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ReceivedCode"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ReceivedData"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ReplacedDataId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="ShipmentId"
    ReferencedTable="Shipments"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>