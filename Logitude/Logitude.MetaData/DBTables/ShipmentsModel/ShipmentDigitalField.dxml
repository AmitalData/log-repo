<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ShipmentDigitalFields"
  Schema="dbo"
  DBType="Main"
  Module="Shipment">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsCustomerArchived"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="Id"
    ReferencedTable="Shipments"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>