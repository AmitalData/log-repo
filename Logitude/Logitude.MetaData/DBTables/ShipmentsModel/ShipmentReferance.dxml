<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ShipmentReferances"
  Schema="dbo"
  DBType="Main"
  Module="Shipment">
  <Column
    Name="ShipmentId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LineNumber"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ReferenceType"
    Type="varchar"
    Size="10">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PartnerId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ReferenceValue"
    Type="varchar"
    Size="30">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="ShipmentId"
    ReferencedTable="Shipments"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ReferenceType"
    ReferencedTable="ReferenceTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="PartnerId"
    ReferencedTable="Cards"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>