<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="AWBOCIs"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ShipmentId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CountryId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AWBCustomsInformationCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AWBInformationCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SupplementaryCustomsInfo"
    Type="varchar"
    Size="35">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="ShipmentId"
    ReferencedTable="Shipments"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="CountryId"
    ReferencedTable="Countries"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="AWBCustomsInformationCode"
    ReferencedTable="AWBCustomsInformations"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="AWBInformationCode"
    ReferencedTable="AWBInformations"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
</Table>