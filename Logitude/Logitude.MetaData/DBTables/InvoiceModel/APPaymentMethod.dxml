<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="APPaymentMethods"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="15"
    DefaultValue="''">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int"
    DefaultValue="0">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Code"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AddedManually"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Inactive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="AccountingExternalId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
</Table>