<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="AccountingPaymentMethods"
  Schema="dbo"
  DBType="Main"
  Module="Invoice">
  <Column
    Name="Id"
    Type="varchar"
    Size="15"
    DefaultValue="''">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int"
    DefaultValue="0">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Code"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="nvarchar"
    Size="80">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AddedManually"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Inactive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsAR"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsAP"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="APExternalId"
    Type="varchar"
    Size="25">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ARExternalId"
    Type="varchar"
    Size="25">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
</Table>