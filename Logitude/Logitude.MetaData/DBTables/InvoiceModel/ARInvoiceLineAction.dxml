<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ARInvoiceLineActions"
  Schema="dbo"
  DBType="Main"
  Module="Invoice">
  <Column
    Name="Code"
    Type="varchar"
    Size="1">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="nvarchar"
    Size="40">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="50">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Inactive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
</Table>