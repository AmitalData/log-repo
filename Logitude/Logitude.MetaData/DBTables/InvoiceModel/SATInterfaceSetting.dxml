<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SATInterfaceSettings"
  Schema="dbo"
  DBType="Main"
  Module="Invoice">
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="SATInterfaceCode"
    Type="varchar"
    Size="10">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Token"
    Type="nvarchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ActivationDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="MetodoPagoCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsARInvoiceTransferEnabled"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsCartaPorteTransferEnabled"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SATCompanyName"
    Type="nvarchar"
    Size="200">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TransferExpenseCharges"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="SATInterfaceCode"
    ReferencedTable="SATInterfaces"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="MetodoPagoCode"
    ReferencedTable="MetodoPagos"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
</Table>