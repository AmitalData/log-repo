<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CreditCardTypes"
  Schema="dbo"
  DBType="Main"
  Module="Invoice">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Code"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="nvarchar"
    Size="80">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="InActive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="BankAccountId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
</Table>