    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Code"
    Type="nvarchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="nvarchar"
    Size="30">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
