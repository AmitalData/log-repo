  <Relation
    ForeignKeyColumn="APInvoiceId"
    ReferencedTable="APInvoices"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ChargesTypeId"
    ReferencedTable="ChargesTypes"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="VatTypeId"
