    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ContainerTypeId"
    ReferencedTable="PackageTypes"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Index
    Columns="EntityId" />
  <Index
    Columns="Tenant,EntityPayableId" />
  <Index
    Columns="AutomaticLastUpdateDate" />
</Table>