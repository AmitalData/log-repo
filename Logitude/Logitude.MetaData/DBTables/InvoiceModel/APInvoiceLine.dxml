<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="APInvoiceLines"
  Schema="dbo"
  DBType="Main"
  Module="Invoice">
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EntityId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="EntityPayableId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="RefundAmount"
    Type="float">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="APInvoiceId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LineNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="InvoiceCurrencyAmount"
    Type="float">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LocalCurrencyAmount"
    Type="float">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ProfitCurrencyAmount"
    Type="float">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Notes"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ChargesTypeId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="VatTypeId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="VatPercentage"
    Type="float">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ForiegnCurrencyId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ForiegnExchangeRate"
    Type="float">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ForiegnCurrencyAmount"
    Type="float">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Description"
    Type="nvarchar"
    Size="250">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LocalDescription"
    Type="nvarchar"
    Size="250">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DebitAccount"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="VatAmount"
    Type="float">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ChargeTypeGLAccountId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AuthorizedSignatory"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="PrepaidCollectId"
    Type="varchar"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ContainerTypeId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Quantity"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
