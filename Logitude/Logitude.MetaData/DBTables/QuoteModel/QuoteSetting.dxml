<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="QuoteSettings"
  Schema="dbo"
  DBType="Main"
  Module="Quote">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CopyExchangeRates"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="AutomaticallyCloseDays"
    Type="int"
    DefaultValue="0">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CopyShipper"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CopyConsignee"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CopyMainCarriage"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CopyPickup"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CopyDelivery"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CopyChargesTypes"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CopyChargesCost"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CopyChargesSale"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EditMainCarriage"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CopyAgent"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CopyNotify"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsSaleAsCostCurrency"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsMultiCurrency"
    Type="bit"
    DefaultValue="0">
    <Constraints
      Nullable="false" />
  </Column>
</Table>