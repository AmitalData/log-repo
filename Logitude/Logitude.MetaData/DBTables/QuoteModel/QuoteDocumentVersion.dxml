<?xml version="1.0" encoding="utf-8"?>
<Table Name="QuoteDocumentVersions">
  <Column Name="CreateDate" Type="datetime">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="CreatedByUserId" Type="varchar" Size="15">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="DocumentId" Type="varchar" Size="15">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="IsSent" Type="bit">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="QuoteId" Type="varchar" Size="15">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="QuoteTemplateId" Type="varchar" Size="15">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="SendDate" Type="datetime">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Tenant" Type="int">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="UpdateDate" Type="datetime">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="UpdatedByUserId" Type="varchar" Size="15">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="VersionNumber" Type="int">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="VersionType" Type="varchar" Size="2">
    <Constraints Nullable="true" />
  </Column>
</Table>