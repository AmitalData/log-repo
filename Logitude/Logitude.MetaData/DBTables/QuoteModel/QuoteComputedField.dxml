<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="QuoteComputedFields"
  Schema="dbo"
  DBType="Main"
  Module="Quote">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="ConnectedToShipment"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ConnectedToTicket"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ToLocation"
    Type="varchar"
    Size="500">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FromLocation"
    Type="varchar"
    Size="500">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DeliveryFrom"
    Type="varchar"
    Size="500">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PickupFrom"
    Type="varchar"
    Size="500">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Tenant"
    OldNames="Tanent"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="Id"
    ReferencedTable="Quotes"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>