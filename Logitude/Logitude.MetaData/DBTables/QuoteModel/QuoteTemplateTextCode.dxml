<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="QuoteTemplateTextCodes"
  Schema="dbo"
  DBType="Main"
  Module="Quote">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="TextCode"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EnglishName"
    Type="nvarchar"
    Size="200">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="QuoteTemplateId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Area"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="OriginalEnglishName"
    Type="nvarchar"
    Size="200"
    DefaultValue="''">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="OriginalLocalName"
    Type="nvarchar"
    Size="100"
    DefaultValue="''">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="QuoteTemplateId"
    ReferencedTable="QuoteTemplates"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>