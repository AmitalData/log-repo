<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="FailedLoginLogs"
  Schema="dbo"
  DBType="SystemLogs"
  Module="Infrastructure">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="IP"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Browser"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Email"
    Type="varchar"
    Size="70">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="GMTDateTime"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="UserAgent"
    Type="nvarchar"
    Size="400">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Reason"
    Type="varchar"
    Size="200">
    <Constraints
      Nullable="true" />
  </Column>
  <Index
    Columns="GMTDateTime" />
</Table>