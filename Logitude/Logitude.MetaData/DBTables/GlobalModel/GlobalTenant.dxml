<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="GlobalTenants"
  Schema="dbo"
  DBType="Global"
  Module="Infrastructure">
  <Column
    Name="Id"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="GlobalDBId"
    Type="nvarchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CompanyName"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Version"
    Type="int"
    DefaultValue="0">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsActive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="TTY"
    Type="varchar"
    Size="33">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PrivateLabelId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="GlobalDBId"
    ReferencedTable="GlobalDBs"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="PrivateLabelId"
    ReferencedTable="TenantManagmentPrivateLabels"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>