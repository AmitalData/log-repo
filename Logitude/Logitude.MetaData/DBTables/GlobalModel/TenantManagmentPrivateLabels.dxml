<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="TenantManagmentPrivateLabels"
  Schema="dbo"
  DBType="Global"
  Module="Infrastructure">
  <Column
    Name="MainLogo"
    Type="varbinary"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SmallLogo"
    Type="varbinary"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="HybridPartnerId"
    Type="nvarchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="PrivateLabelShortName"
    Type="varchar"
    Size="60">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="PrivateLabelName"
    Type="nvarchar"
    Size="60">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="PrivateLabelUrl"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ContactUsEmail"
    Type="nvarchar"
    Size="70">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ReceiveAllStatuses"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="InActive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="500">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Tenant"
    Type="int"
    DefaultValue="0">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="BackgroundImageId"
    OldNames="BackgroundImage"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LoginImageId"
    OldNames="MainImageId,MainImage"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PrivateLabelDomain"
    Type="varchar"
    Size="100"
    DefaultValue="'dsv.co.il'">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="MainColor"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LoginProgressImageId"
    OldNames="LoginProgressImage"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ForgetPasswordImageId"
    OldNames="ForgetPasswordImage"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SecondaryColor"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="HasLogboxAccess"
    OldNames="CustomPrivateLabel"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
</Table>