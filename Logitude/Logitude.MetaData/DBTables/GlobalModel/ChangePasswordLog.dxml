<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ChangePasswordLogs"
  Schema="dbo"
  DBType="Global"
  Module="Infrastructure">
  <Column
    Name="Id"
    Type="varchar"
    Size="40">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Email"
    Type="varchar"
    Size="70">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CurrentPassword"
    Type="varchar"
    Size="60">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="EnteredPassword"
    Type="varchar"
    Size="60">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="log"
    Type="varchar"
    Size="500">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IP"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
</Table>