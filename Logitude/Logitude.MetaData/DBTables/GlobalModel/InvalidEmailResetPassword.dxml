<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="InvalidEmailResetPasswords"
  Schema="dbo"
  DBType="Global"
  Module="Infrastructure">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="IP"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Email"
    Type="varchar"
    Size="70">
    <Constraints
      Nullable="true" />
  </Column>
</Table>