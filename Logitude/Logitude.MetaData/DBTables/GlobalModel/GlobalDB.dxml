<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="GlobalDBs"
  Schema="dbo"
  DBType="Global">
  <Column
    Name="Id"
    Type="nvarchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="DBConnection"
    Type="nvarchar"
    Size="512">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsUpgrading"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsActive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SharedDWConnection"
    Type="nvarchar"
    Size="512"
    DefaultValue="''">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SecondaryAzureDBConnection"
    Type="nvarchar"
    Size="512">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsBlocking"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
</Table>