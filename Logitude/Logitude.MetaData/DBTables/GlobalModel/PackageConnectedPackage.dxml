<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="PackageConnectedPackages"
  Schema="dbo"
  DBType="Global"
  Module="Infrastructure">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="PackageCode"
    Type="varchar"
    Size="5">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ConnectedPackageCode"
    Type="varchar"
    Size="5">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="PackageCode"
    ReferencedTable="Packages"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ConnectedPackageCode"
    ReferencedTable="Packages"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
</Table>