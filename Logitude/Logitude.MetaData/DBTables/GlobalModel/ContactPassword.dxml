<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ContactPasswords"
  Schema="dbo"
  DBType="Global">
  <Column
    Name="Email"
    Type="varchar"
    Size="70">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Password"
    Type="varchar"
    Size="60">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="MustChangePassword"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsLocked"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="NumberOfRetries"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LockDateTime"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SharedMobileAppAlertsforFollowedShipment"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SharedMobileAppAlertonExceptions"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsSendNotificationForMobile"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsBCrypt"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="PasswordExpirationDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CaptchaKey"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
</Table>