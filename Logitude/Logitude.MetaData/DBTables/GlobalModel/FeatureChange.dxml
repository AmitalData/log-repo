<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="FeatureChanges"
  Schema="dbo"
  DBType="Global"
  Module="Common">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="varchar"
    Size="50">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EventDateTime"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="UserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="RoleId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PackageCode"
    Type="varchar"
    Size="5">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Notes"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  -<Relation
    ForeignKeyColumn="UserId"
    ReferencedTable="GlobalContacts"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="RoleId"
    ReferencedTable="Roles"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="PackageCode"
    ReferencedTable="Packages"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
</Table>