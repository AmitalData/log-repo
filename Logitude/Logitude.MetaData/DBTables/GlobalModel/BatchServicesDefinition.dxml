<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="BatchServicesDefinitions"
  Schema="dbo"
  DBType="Global"
  Module="Infrastructure">
  <Column
    Name="Code"
    Type="varchar"
    Size="100">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="ClassName"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Parameter1"
    Type="varchar"
    Size="25">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Parameter2"
    Type="varchar"
    Size="25">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="QueueDefinitionCode"
    Type="varchar"
    Size="200">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="UseRabbitMQ"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="QueueBase"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
</Table>