<?xml version="1.0" encoding="utf-8"?>
<Table Name="PasswordResetRequests">
  <Column Name="CreateDate" Type="datetime">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="DoneDate" Type="datetime">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Email" Type="varchar" Size="70">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="ExpirationDate" Type="datetime">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="IsDone" Type="bit">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="IsMobileOnly" Type="bit">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="RequestNumber" Type="varchar" Size="40">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="Type" Type="varchar" Size="20">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="VerificationCode" Type="varchar" Size="5">
    <Constraints Nullable="true" />
  </Column>
</Table>