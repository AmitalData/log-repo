<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="OneTimePasswords"
  Schema="dbo"
  DBType="Global"
  Module="Infrastructure">
  <Column
    Name="Id"
    Type="varchar"
    Size="50">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UserEmail"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UsageDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ExpirationDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsUsed"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
</Table>