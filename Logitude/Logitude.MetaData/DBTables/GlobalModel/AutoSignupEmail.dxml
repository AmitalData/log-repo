<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="AutoSignupEmails"
  Schema="dbo"
  DBType="Global">
  <Column
    Name="Id"
    Type="varchar"
    Size="40">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="EmailBody"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="EmailSubject"
    Type="varchar"
    Size="200">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Status"
    Type="varchar"
    Size="25">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Retries"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime"
    DefaultValue="'1900-01-01T00:00:00.000'">
    <Constraints
      Nullable="false" />
  </Column>
</Table>