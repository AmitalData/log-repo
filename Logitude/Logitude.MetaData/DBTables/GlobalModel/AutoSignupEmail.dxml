<?xml version="1.0" encoding="utf-8"?>
<Table Name="AutoSignupEmails">
  <Column Name="CreateDate" Type="datetime">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="EmailBody" Type="nvarchar" Size="-1">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="EmailSubject" Type="varchar" Size="200">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Id" Type="varchar" Size="40">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="Retries" Type="int">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="Status" Type="varchar" Size="25">
    <Constraints Nullable="false" />
  </Column>
</Table>