<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SessionPolicies"
  Schema="dbo"
  DBType="Global"
  Module="Infrastructure">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="WebTokenLifeTimeInMinutes"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="WebTokenExpirationWarningInMinutes"
    ShortName="WebTokenExpirationWarningInMin"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
</Table>