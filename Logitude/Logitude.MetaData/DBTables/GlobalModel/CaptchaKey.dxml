<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CaptchaKeys"
  Schema="dbo"
  DBType="Global">
  <Column
    Name="Id"
    Type="varchar"
    Size="40">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Code"
    Type="varchar"
    Size="6">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Email"
    Type="varchar"
    Size="70">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IP"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Activity"
    Type="varchar"
    Size="70">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsUsed"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
</Table>