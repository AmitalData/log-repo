<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="TenantLoginPolicies"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LoginPolicyCode"
    Type="varchar"
    Size="10">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsEnabledForSpecificUsers"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="TwoFactorInternalIPs"
    Type="varchar"
    Size="200">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="KeepUserLoggedIn"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ExcludeInternalIPs"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="AllowedIPs"
    Type="varchar"
    Size="200">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SessionTimeout"
    Type="decimal"
    Precision="18"
    Scale="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="LoginPolicyCode"
    ReferencedTable="LoginPolicies"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
</Table>