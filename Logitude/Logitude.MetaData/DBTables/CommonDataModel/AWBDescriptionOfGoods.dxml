<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="AWBDescriptionOfGoods"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Service"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsTemperatureSensitive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="varchar"
    Size="60">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ShortDescriptionOfGoods"
    Type="nvarchar"
    Size="200">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AirlineCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ProductCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
</Table>