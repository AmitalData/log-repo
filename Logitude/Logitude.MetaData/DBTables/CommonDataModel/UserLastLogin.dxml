<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="UserLastLogins"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="ComputerId"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LoginDateTime"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="WorkEnvironment"
    Type="varchar"
    DefaultValue="'None'"
    Size="40">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
	Name="IP"
	Type="varchar"
	Size="15">
	<Constraints
	  Nullable="true" />
  </Column>
  <Column
	Name="ComputerUserName"
	Type="varchar"
	Size="30">
	<Constraints
	  Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="Id"
    ReferencedTable="Users"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>