<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="Industries"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="nvarchar"
    Size="60">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Code"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="InActive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <UniqueConstraint
    Columns="Code,Tenant" />
</Table>