    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="InternetAccess"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsAirExport"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsAirImport"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
