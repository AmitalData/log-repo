<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CustomerTenantAccessRequests"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="RequestDateTime"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="RequestStatus"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ForwarderId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsCustoms"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsExport"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="RequestStatus"
    ReferencedTable="CustomerTenantAccessStatusTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ForwarderId"
    ReferencedTable="HybridPartners"
