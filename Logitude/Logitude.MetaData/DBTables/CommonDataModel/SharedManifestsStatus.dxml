<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SharedManifestsStatuses"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="StatusCode"
    Type="varchar"
    Size="4">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="StatusName"
    Type="nvarchar"
    Size="200">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
</Table>