<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CargoTrackingMilestones"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Code"
    Type="varchar"
    Size="2">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="30">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="EnglishName"
    Type="varchar"
    Size="30">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
  Name="Inactive"
  Type="bit">
    <Constraints
      Nullable="true" />
  </Column>
</Table>