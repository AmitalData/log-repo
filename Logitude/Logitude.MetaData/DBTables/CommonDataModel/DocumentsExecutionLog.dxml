<?xml version="1.0" encoding="utf-8"?>
<Table Name="DocumentsExecutionLogs">
  <Column Name="CreateDate" Type="datetime">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="CreatedByUserId" Type="varchar" Size="15">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="DocumentTypeId" Type="varchar" Size="15">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="DocumentTypeTemplateId" Type="varchar" Size="15">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="DoneDate" Type="datetime">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="ExceptionMessage" Type="nvarchar" Size="-1">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Id" Type="varchar" Size="40">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="Logs" Type="nvarchar" Size="-1">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="RequestXML" Type="nvarchar" Size="-1">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="RetryNumber" Type="int">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="StartDate" Type="datetime">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="StatusCode" Type="varchar" Size="4">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="Subject" Type="nvarchar" Size="40">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="Tenant" Type="int">
    <Constraints Nullable="false" />
  </Column>
</Table>