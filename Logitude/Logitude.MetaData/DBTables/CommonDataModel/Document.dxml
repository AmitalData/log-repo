<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="Documents"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="FileName"
    Type="nvarchar"
    Size="120">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Extension"
    Type="varchar"
    Size="10">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FileSize"
    Type="float">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="HasFile"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Folder"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SmallDocumentId"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CalculatedFileName"
    Type="nvarchar"
    Size="120">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsEncrypted"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="MarkForDelete"
    Type="bit">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="SmallDocumentId"
    ReferencedTable="SmallDocuments"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Index
    Columns="Tenant" />
  <Index
    Columns="HasFile" />
</Table>