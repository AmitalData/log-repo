<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CargoTrackingShipmentSearchFields"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
  Name="ShipmentId"
  Type="varchar"
  Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchField"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
   Name="ShipmentDate"
   Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Index
   Columns="Tenant,SearchField,ShipmentDate" />
</Table>