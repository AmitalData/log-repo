<?xml version="1.0" encoding="utf-8"?>
<Table Name="EmailProviders" Schema="dbo" DBType="Main">
  <Column Name="Domain" Type="varchar" Size="60">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="LastTestReceivedDate" Type="datetime">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="LastTestSendDate" Type="datetime">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Password" Type="varchar" Size="60">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Port" Type="varchar" Size="10">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="ProviderNumber" Type="varchar" Size="15">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="Status" Type="varchar" Size="15">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="SupportsEmailDelivery" Type="bit">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="UserName" Type="varchar" Size="100">
    <Constraints Nullable="true" />
  </Column>
</Table>