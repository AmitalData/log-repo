<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="Incoterms"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Code"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="nvarchar"
    Size="80">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Freight"
    Type="varchar"
    Size="1">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="OtherCharges"
    Type="varchar"
    Size="1">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="AddedManually"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="InActive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Notes"
    Type="nvarchar"
    Size="250">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AutomaticLastUpdateDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="Freight"
    ReferencedTable="PrepaidCollects"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="OtherCharges"
    ReferencedTable="PrepaidCollects"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Index
    Columns="AutomaticLastUpdateDate" />
  <UniqueConstraint
    Columns="Tenant,Code" />
</Table>