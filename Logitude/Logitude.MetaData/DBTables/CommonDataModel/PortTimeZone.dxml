<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="PortTimeZones"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Code"
    Type="varchar"
    Size="150">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="varchar"
    Size="150">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Notes"
    Type="nvarchar"
    Size="500">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="UTCOffset"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UTCDSTOffset"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Inactive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
</Table>