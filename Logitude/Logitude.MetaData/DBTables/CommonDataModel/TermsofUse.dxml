<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="TermsofUses"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    OldNames="Version"
    Type="int"
	  Identity="true">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Date"
    ShortName="Date_"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>

    <Column
    Name="VersionNumber"
    ShortName="VersionNumber"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>

      <Column
    Name="Tenant"
    ShortName="Tenant"
  DefaultValue="0" 
  Type="int">
    <Constraints
      Nullable="false" />
  </Column>

	<Column
    Name="VersionDocumentId"
    ShortName="VersionDocumentId" 
 Type="varchar"
   Size="15">
		<Constraints
		  Nullable="true" />
	</Column>
	 
</Table>