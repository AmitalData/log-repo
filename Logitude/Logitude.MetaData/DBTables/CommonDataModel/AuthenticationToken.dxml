<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="AuthenticationTokens"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="Token"
    Type="varchar"
    Size="100">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Email"
    Type="varchar"
    Size="70">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Password"
    Type="varchar"
    Size="60">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="APIToken"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="APICredentialID"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ClientType"
    Type="varchar"
    Size="70">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="InActive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="InActiveReason"
    Type="varchar"
    Size="250">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ExpirationDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="InActiveDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
</Table>