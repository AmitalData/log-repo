<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ReportModifications"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="PackageId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="ReportDocumentId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="PackageId"
    ReferencedTable="Reports"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ReportDocumentId"
    ReferencedTable="Documents"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>