<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="DWHBuildStatus"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="40">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LastIncrementalDWUpdateDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DWNextRunTime"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsFullBuildDWRunning"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsIncrementalDWRunning"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
</Table>