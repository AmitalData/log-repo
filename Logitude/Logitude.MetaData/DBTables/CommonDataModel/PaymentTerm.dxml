      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="FromDateTypeCode"
    ReferencedTable="PaymentTermDateTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Index
    Columns="AutomaticLastUpdateDate" />
</Table>