<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="VatTypePercentages"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="VatTypeId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="FromDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Percentage"
    Type="float">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="VatTypeId"
    ReferencedTable="VatTypes"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>