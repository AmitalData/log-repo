<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="DigitalContactLastSettings"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ContactId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
   <Column
    Name="ObjectTableId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FilterName"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="FilterCode"
    Type="varchar"
    Size="50">
    <Constraints
      Nullable="false" />
  </Column>
   <Column
    Name="IsChecked"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="ContactId"
    ReferencedTable="Contacts"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
    <Relation
    ForeignKeyColumn="ObjectTableId"
    ReferencedTable="ObjectTables"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>