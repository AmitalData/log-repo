<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CardCurrenciesAccountings"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CardId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CurrencyId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PayableDebitAccount"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ReceivableCreditAccount"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="CardId"
    ReferencedTable="Cards"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="CurrencyId"
    ReferencedTable="Currencies"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>