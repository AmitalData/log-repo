<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="WarehouseStoragePricings"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="WarehouseId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="StepFrom"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="StepTo"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Days"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SalePrice"
    Type="decimal"
    Precision="18"
    Scale="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LineNumber"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="WarehouseId"
    ReferencedTable="Cards"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>