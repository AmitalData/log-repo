<?xml version="1.0" encoding="utf-8"?>
<Table Name="FeatureChanges">
  <Column Name="EventDateTime" Type="datetime">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Id" Type="varchar" Size="15">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="Name" Type="varchar" Size="50">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="Notes" Type="varchar" Size="8000">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="PackageCode" Type="varchar" Size="5">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="RoleId" Type="varchar" Size="15">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="SearchFields" Type="nvarchar" Size="1000">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Tenant" Type="int">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="UserId" Type="varchar" Size="15">
    <Constraints Nullable="false" />
  </Column>
</Table>