    <Constraints Nullable="false" />
  </Column>
  <Column Name="UserId" Type="varchar" Size="15">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="DeviceDescription" Type="nvarchar" Size="200">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="LastLoginDate" Type="datetime">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="LastLoginIP" Type="varchar" Size="100">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="AuthenticationCode" Type="varchar" Size="10">
    <Constraints Nullable="false" />
  </Column>
