<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CustomsInterfaceSettings"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Tenant"
    Type="int"
    DefaultValue="0">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="ActivateCustomsManagementInShipments"
    ShortName="ActivateCustManagInShipments"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LocalCustomsInterfaceCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ImportToUSAInterfaceCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ExportFromUSAInterfaceCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LocalCompanyId"
    Type="varchar"
    Size="25">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LocalUserId"
    Type="varchar"
    Size="25">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LocalPassword"
    Type="varchar"
    Size="25">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ArtemusOutSettingsId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ArtemusInSettingsId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AMCAirStartDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AMCOceanStartDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="LocalCustomsInterfaceCode"
    ReferencedTable="CustomsInterfaces"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ImportToUSAInterfaceCode"
    ReferencedTable="CustomsInterfaces"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ExportFromUSAInterfaceCode"
    ReferencedTable="CustomsInterfaces"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ArtemusOutSettingsId"
    ReferencedTable="FTPDetails"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ArtemusInSettingsId"
    ReferencedTable="FTPDetails"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>