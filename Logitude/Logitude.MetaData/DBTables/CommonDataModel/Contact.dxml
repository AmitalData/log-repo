  </Column>
  <Column
    Name="AnniversaryReminder"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DoneDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="BirthDayOfYear"
