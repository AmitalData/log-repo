<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="Countries"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="120">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="GlobalZoneId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="AddedManually"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="InActive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EC"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Notes"
    Type="nvarchar"
    Size="250">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="HasStates"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsStateRequired"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="HasCitiesList"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Code"
    Type="char"
    Size="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EnglishName"
    Type="nvarchar"
    Size="240">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsNorthAmerica"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="AutomaticLastUpdateDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsGreaterChina"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="GlobalZoneId"
    ReferencedTable="GlobalZones"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
