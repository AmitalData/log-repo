<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CargoTrackingPorts"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
      Name="Code"
      Type="char"
      Size="3">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
      Name="EnglishName"
      Type="varchar"
      Size="40">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CountryId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="CountryId"
    ReferencedTable="Countries"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>