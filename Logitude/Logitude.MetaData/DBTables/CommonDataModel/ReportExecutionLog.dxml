<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ReportExecutionLogs"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    Type="varchar"
    Size="40">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreatedByUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="StatusCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ExceptionMessage"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DoneDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ReportFilterXML"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ReportId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ReportTemplateId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="RetryNumber"
    Type="int"
    DefaultValue="0">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="StartDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DisablePreview"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ExecutedByServerName"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="NotDisplayInMenu"
    OldNames="DisplayInMenu"
    Type="bit">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="CreatedByUserId"
    ReferencedTable="Users"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="StatusCode"
    ReferencedTable="CommunicationStatusTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ReportId"
    ReferencedTable="Reports"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Index
    Columns="CreateDate" />
</Table>