<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="DocumentsMetaDataTypes"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CODE"
    Type="varchar"
    Size="7">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ENGLISHNAME"
    Type="varchar"
    Size="60">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LOCALNAME"
    Type="nvarchar"
    Size="60">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="INACTIVE"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="FORMAT"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CUSTOMSMETADATACODE"
    Type="nvarchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
</Table>