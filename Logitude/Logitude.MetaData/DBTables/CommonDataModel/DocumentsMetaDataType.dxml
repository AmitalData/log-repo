<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="DocumentsMetaDataTypes"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Code"
    Type="varchar"
    Size="7">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EnglishName"
    Type="varchar"
    Size="60">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="60">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="InActive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CustomsMetaDataCode"
    Type="nvarchar"
    Size="6">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Format"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="false" />
  </Column>
</Table>