    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="StateId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ZipCode"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FaxNumber"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PhoneNumber"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ATTN"
    Type="nvarchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AddressTypeId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Address1"
    Type="nvarchar"
    Size="65">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Address2"
    Type="nvarchar"
    Size="65">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Name"
    Type="nvarchar"
    Size="70">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CountryId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CardId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
