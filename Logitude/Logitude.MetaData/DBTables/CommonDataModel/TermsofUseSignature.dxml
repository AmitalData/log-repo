<?xml version="1.0" encoding="utf-8"?>
<Table
	
  Name="TermsofUseSignatures"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ContactId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SignedDatetime"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="TermsofUseId"
    OldNames="TermsofUseVersion"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="ContactId"
    ReferencedTable="Contacts"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="TermsofUseId"
    ReferencedTable="TermsofUses"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>