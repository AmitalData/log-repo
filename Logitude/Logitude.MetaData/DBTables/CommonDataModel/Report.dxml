<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="Reports"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="ReportGroupId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FeatureId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ReportDocumentId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FilterControlName"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Description"
    Type="nvarchar"
    Size="250">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Code"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="InActive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DefaultTemplateId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DefaultMessageTemplateId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="60">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FilterHtmlComponentUrl"
    Type="varchar"
    Size="256">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FeatureUniqeCode"
    Type="varchar"
    Size="120">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AvailableForScheduling"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DisablePreview"
    OldNames="ExcelOnly"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DefaultExcelTemplateId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsExcelReportAllowed"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DefaultExcelNoStimId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="ReportGroupId"
    ReferencedTable="ReportGroups"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="FeatureId"
    ReferencedTable="Features"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo"
    Ignore="true" />
  <Relation
    ForeignKeyColumn="ReportDocumentId"
    ReferencedTable="Documents"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="DefaultTemplateId"
    ReferencedTable="ReportsTemplates"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="DefaultMessageTemplateId"
    ReferencedTable="ReportsTemplates"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="DefaultExcelTemplateId"
    ReferencedTable="ReportsTemplates"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="DefaultExcelNoStimId"
    ReferencedTable="ReportsTemplates"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>