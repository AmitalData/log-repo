<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SyncRecord"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    Type="nvarchar"
    Size="36"
    DefaultValue="newid()">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Entname"
    Type="nvarchar"
    Size="30">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="KeyVal"
    Type="nvarchar"
    Size="255">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FileNo"
    Type="nvarchar"
    Size="50">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TrigAction"
    Type="nvarchar"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SyncDT"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsSync"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Index
    Columns="CreateDate" />
  <Index
    Columns="Tenant" />
  <Index
    Columns="IsSync" />
  <Index
    Columns="FileNo" />
</Table>