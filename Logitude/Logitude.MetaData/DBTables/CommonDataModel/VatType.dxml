<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="VatTypes"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Code"
    Type="varchar"
    Size="5">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EnglishName"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AddedManually"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="InActive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Description"
    Type="varchar"
    Size="250">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LocalDescription"
    Type="nvarchar"
    Size="250">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ExternalVATCard"
    Type="varchar"
    Size="25">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PayablesExternalId"
    Type="varchar"
    Size="25">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ReceivablesExternalId"
    Type="varchar"
    Size="25">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ExternalTAXItemId"
    Type="varchar"
    Size="25">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsMultiPercentage"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="RecognizedPercentage"
    Type="float">
    <Constraints
      Nullable="true" />
  </Column>
  <UniqueConstraint
    Columns="Tenant,Code" />
</Table>