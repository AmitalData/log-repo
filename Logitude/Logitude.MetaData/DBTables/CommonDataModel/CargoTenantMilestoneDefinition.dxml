<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CargoTenantMilestoneDefinitions"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Code"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsCustomerView"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
</Table>