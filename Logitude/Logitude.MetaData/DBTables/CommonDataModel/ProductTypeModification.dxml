<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ProductTypeModifications"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="ProductTypeCode"
    Type="varchar"
    Size="2">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="InActive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="QuotationDefaultTemplateId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="RoutingRQuoteDefaultTemplateId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
  Name="CostTariffUse"
  Type="varchar"
  Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
  Name="SaleTariffUse"
  Type="varchar"
  Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="ProductTypeCode"
    ReferencedTable="ProductTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
</Table>