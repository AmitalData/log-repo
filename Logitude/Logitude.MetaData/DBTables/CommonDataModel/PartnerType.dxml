<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="PartnerTypes"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    Type="char"
    Size="2">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AutomaticLastUpdateDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Index
    Columns="AutomaticLastUpdateDate" />
</Table>