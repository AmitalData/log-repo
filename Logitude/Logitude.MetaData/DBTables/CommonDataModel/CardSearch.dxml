<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CardSearches"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    Type="int"
    Identity="true">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="RecordDate"
    OldNames="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Keyword"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Weight"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CardId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PartnerTypeId"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="InActive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="CardId"
    ReferencedTable="Cards"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />


  <Index
  Columns="Tenant,InActive,Keyword,PartnerTypeId"
  Include="CardId,Weight" />

  <Index
  Columns="Tenant,Weight" />

  <Index
Columns="Tenant,CardId" />
</Table>