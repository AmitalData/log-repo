<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ExternalLinks"
  Schema="dbo"
  DBType="Main"
  Module="Common">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Ref"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Link"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ExpirationDate"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ActivityLog"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Params"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
</Table>