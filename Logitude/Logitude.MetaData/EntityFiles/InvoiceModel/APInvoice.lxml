    <TextCode Code="&quot;APInvoice.M.CantReceiveFutureDateInvoice&quot;" DefaultText="&quot;Can't receive an invoice with a future date&quot;" LocalDefaultText="&quot;לא ניתן לקלוט חשבונית עם תאריך עתידי&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;APInvoice.M.YouShouldHaveOneLineAtLeast&quot;" DefaultText="&quot;You should have at least 1 invoice line&quot;" LocalDefaultText="&quot;עליך להקליד לפחות שורת חשבונית אחת &quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;APInvoice.M.VatTypePercentageEmpty&quot;" DefaultText="&quot;Some of invoice lines Vat Type Percentage is empty&quot;" LocalDefaultText="&quot;בחלק מהשורות לא הוגדר אחוז מע''מ&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;APInvoice.M.InvoiceAmountNotMatched&quot;" DefaultText="&quot;Invoice Amount field doesnt match the total amount&quot;" LocalDefaultText="&quot;שדה סכום החשבונית אינו תואם לסיכום הסכום בשורות&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;APInvoice.M.InvoiceLineAmountNotZero&quot;" DefaultText="&quot;Invoice line amount field must not be zero&quot;" LocalDefaultText="&quot;שדה השורה של חשבונית אינו יכול להיות אפס&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;APInvoice.M.AccountingSettingsDontAllowVoid&quot;" DefaultText="&quot;Accounting Settings doesn't allow void A/P Invoice&quot;" LocalDefaultText="&quot;הגדרות הנהלת החשבונות לא מאפשרות התעלמות מחשבונית ספק&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;APInvoice.M.DisconnectPayments&quot;" DefaultText="&quot;Please disconnect all payments&quot;" LocalDefaultText="&quot;נא לנתק את כל ההתאמות לתשלומים&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;APInvoice.M.ConfirmVoid&quot;" DefaultText="&quot;Once you void or delete an invoice, the change is permanent. If you void or delete an invoice and want to restore it later, you'll have to create a new invoice.&quot;" LocalDefaultText="&quot;ברגע שמבטלים או מתעלמים מחשבונית, השינוי הוא בלתי הפיך. במידה וביטלת חשבונית או התעלמת ממנה וברצונך לשחזר אותה, עליך ליצור חשבונית חדשה&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;APInvoice.M.ClosedInvoice&quot;" DefaultText="&quot;This invoice is closed&quot;" LocalDefaultText="&quot;חשבונית זאת סגורה&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;APInvoice.M.VendorNoGLAccount&quot;" DefaultText="&quot;The vendor does not have GLAccount&quot;" LocalDefaultText="&quot;לספק לא קושר כרטיס הנהלת חשבונות&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;APInvoice.M.InvoiceCurrNotMatch&quot;" DefaultText="&quot;The Invoice Currency does not match the vendor GLAccount Currency &quot;" LocalDefaultText="&quot;מטבע החשבונית לא תואם את מטבע הכרטיס של הספק&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;APInvoice.M.NoGLAccount&quot;" DefaultText="&quot;The chosen charge type doesn't have GLAccount connected to it&quot;" LocalDefaultText="&quot;סעיף החיוב הנבחר לא מקושר לכרטיס הנה''ח&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;APInvoice.S.ShortTitle&quot;" DefaultText="&quot;A/P Invoice&quot;" LocalDefaultText="&quot;חשבונית ספק&quot;" TextCodeTypeCode="&quot;S&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;APInvoice.S.ShortTitle.MultipleShipments&quot;" DefaultText="&quot;Multiple Shipments&quot;" LocalDefaultText="&quot;מספר משלוחים&quot;" TextCodeTypeCode="&quot;S&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;APInvoice.M.SameInvoiceNumber&quot;" DefaultText="&quot;Please Note that there is already another invoice with the same number by the same vendor&quot;" LocalDefaultText="&quot;שים לב שקיימת חשבונית לספק זה עם מספר זהה&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
