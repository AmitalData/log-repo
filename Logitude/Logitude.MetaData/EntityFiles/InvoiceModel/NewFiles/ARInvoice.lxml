    <TextCode Code="&quot;ARInvoice.M.ChronologicalDate&quot;" DefaultText="&quot;Invoice Date should be bigger or equals to the Last Chronological Date&quot;" LocalDefaultText="&quot;תאריך חשבונית חייב להיות גדול או שווה לתאריך הכרונולוגי&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;ARInvoice.M.CantAddPaymentForDraftInvoice&quot;" DefaultText="&quot;Cant add payment for Draft invoice&quot;" LocalDefaultText="&quot;לא ניתן להוסיף תשלום עבור טיוטת חשבונית&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;ARInvoice.M.AmountPaidBiggerThanInvoiceAmount&quot;" DefaultText="&quot;Amount paid equals or bigger than invoice amount&quot;" LocalDefaultText="&quot;הסכום ששולם שווה או גדול לסכום החשבונית&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;ARInvoice.M.AccountingSettingsDontAllowVoid&quot;" DefaultText="&quot;Accounting Settings doesn't allow void A/R Invoice&quot;" LocalDefaultText="&quot;הגדרות הנה''ח לא מאפשרות ביטול חשבוניות&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;ARInvoice.M.DisconnectPayments&quot;" DefaultText="&quot;Please disconnect all payments&quot;" LocalDefaultText="&quot;נא לנתק את כל ההתאמות לתשלומים&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;ARInvoice.M.ConfirmVoid&quot;" DefaultText="&quot;Once you void or delete an invoice, the change is permanent. If you void or delete an invoice and want to restore it later, you'll have to create a new invoice.&quot;" LocalDefaultText="&quot;ברגע שמבטלים או מתעלמים מחשבונית, השינוי הוא בלתי הפיך. במידה וביטלת חשבונית או התעלמת ממנה וברצונך לשחזר אותה, עליך ליצור חשבונית חדשה&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;ARInvoice.M.DeletingDraft&quot;" DefaultText="&quot;Deleting draft invoice...&quot;" LocalDefaultText="&quot;מוחק טיוטת חשבונית...&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;ARInvoice.M.DeletedSuccessfully&quot;" DefaultText="&quot;Invoice Deleted Successfully&quot;" LocalDefaultText="&quot;החשבונית נמחקה בהצלחה&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;ARInvoice.M.ConfirmAutoCredit&quot;" DefaultText="&quot;This action will create a credit note, it will credit the client with the full amount of the invoice and cancel it&quot;" LocalDefaultText="&quot;פעולה זו תיצור חשבונית זיכוי, תזכה את הלקוח בסכום החשבונית המלא ותסמן את החשבונית כמבטלת אותה&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;ARInvoice.M.CreatingAutoCredit&quot;" DefaultText="&quot;Creating Auto Credit Invoice ...&quot;" LocalDefaultText="&quot;יוצר חשבונית זיכוי חדשה....&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;ARInvoice.M.NoTemplate&quot;" DefaultText="&quot;A/R Invoice document has no template!&quot;" LocalDefaultText="&quot;לא הוגדרה תבנית הדפסה למסמך חשבונית&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;ARInvoice.M.NoPositivePrice&quot;" DefaultText="&quot;Can't set a positive unit price on credit note&quot;" LocalDefaultText="&quot;מחיר יחידה לא יכול להיות גדול מאפס בזיכוי&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
