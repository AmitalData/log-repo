    <TextCode Code="&quot;APInvoice.M.ConnectingMinusAmount&quot;" DefaultText="&quot;Connecting minus amount invoice is only allowed from Payments screen&quot;" LocalDefaultText="&quot;התאמת סכום שלילי לחשבונית אפשרי רק ממסך התשלומים&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
