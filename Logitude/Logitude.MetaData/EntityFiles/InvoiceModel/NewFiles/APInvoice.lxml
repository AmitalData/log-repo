    <TextCode Code="&quot;APInvoice.M.DisconnectPayments&quot;" DefaultText="&quot;Please disconnect all payments&quot;" LocalDefaultText="&quot;נא לנתק את כל ההתאמות לתשלומים&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;APInvoice.M.ConfirmVoid&quot;" DefaultText="&quot;Once you void or delete an invoice, the change is permanent. If you void or delete an invoice and want to restore it later, you'll have to create a new invoice.&quot;" LocalDefaultText="&quot;ברגע שמבטלים או מתעלמים מחשבונית, השינוי הוא בלתי הפיך. במידה וביטלת חשבונית או התעלמת ממנה וברצונך לשחזר אותה, עליך ליצור חשבונית חדשה&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;APInvoice.M.ClosedInvoice&quot;" DefaultText="&quot;This invoice is closed&quot;" LocalDefaultText="&quot;חשבונית זאת סגורה&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;APInvoice.M.NoGLAccount&quot;" DefaultText="&quot;The chosen charge type doesn't have GLAccount connected to it&quot;" LocalDefaultText="&quot;סעיף החיוב הנבחר לא מקושר לכרטיס הנה''ח&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
    <TextCode Code="&quot;APInvoice.M.VendorNoGLAccount&quot;" DefaultText="&quot;The vendor does not have GLAccount&quot;" LocalDefaultText="&quot;לספק לא קושר כרטיס הנהלת חשבונות&quot;" TextCodeTypeCode="&quot;M&quot;" IsSpellChecked="false" />
