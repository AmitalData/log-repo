<Script DBType="Main" Module="Accounting">
  <Sql Version="1">
    <![CDATA[
	Delete from InterestTransactions where Id in (
		Select InterestTransactions.Id	from InterestTransactions 
		left join Journals on InterestTransactions.EntityId = journals.Id
		AND InterestTransactions.AccountingEntityCode = journals.AccountingEntityCode AND InterestTransactions.tenant = journals.tenant
		where journals.IsLedgerCreated = 0 and journals.AccountingEntityCode in ('1', '8', '10', '12') AND InterestTransactions.InterestReportId IS NULL
		Union
		Select InterestTransactions.Id	from InterestTransactions  
		left join Journals on InterestTransactions.EntityId = journals.AccountingEntityId 
		AND InterestTransactions.AccountingEntityCode = journals.AccountingEntityCode AND InterestTransactions.tenant = journals.tenant
		where journals.IsLedgerCreated = 0 and journals.AccountingEntityCode = '2' AND InterestTransactions.InterestReportId IS NULL
	)
	
	INSERT INTO InterestTransactions (Id, Tenant, CreateDateTime, UpdateDateTime, InterestValueDate, SearchFields, GLAccountId, EntityId, OriginalEntityLineNumber, LocalAmount, ForeignAmount, CurrencyId,InterestEntityTypeCode, InterestReportId, IsClosed, IsCancelled, AccountingEntityCode)
	SELECT CONCAT('D1-', ROW_NUMBER() OVER(ORDER BY (SELECT 1))) as Id, InterestTransactions.Tenant, CreateDateTime, UpdateDateTime, InterestValueDate, InterestTransactions.SearchFields, InterestTransactions.GLAccountId, InterestTransactions.EntityId, InterestTransactions.OriginalEntityLineNumber + 2, InterestTransactions.LocalAmount * -1 as LocalAmount, InterestTransactions.ForeignAmount *-1 as ForeignAmount, InterestTransactions.CurrencyId, InterestEntityTypeCode, Null, 0, InterestTransactions.IsCancelled, InterestTransactions.AccountingEntityCode
	from journals 
	inner join InterestTransactions on InterestTransactions.EntityId = journals.Id AND InterestTransactions.AccountingEntityCode = journals.AccountingEntityCode AND InterestTransactions.tenant = journals.tenant
	where journals.IsLedgerCreated = 0 and journals.AccountingEntityCode in ('1', '8', '10', '12') AND InterestTransactions.InterestReportId IS NOT NULL
	Union
	SELECT CONCAT('D2-', ROW_NUMBER() OVER(ORDER BY (SELECT 1))) as Id, InterestTransactions.Tenant, CreateDateTime, UpdateDateTime, InterestValueDate, InterestTransactions.SearchFields, InterestTransactions.GLAccountId, InterestTransactions.EntityId, InterestTransactions.OriginalEntityLineNumber + 2, InterestTransactions.LocalAmount * -1 as LocalAmount, InterestTransactions.ForeignAmount *-1 as ForeignAmount, InterestTransactions.CurrencyId, InterestEntityTypeCode, Null, 0, InterestTransactions.IsCancelled, InterestTransactions.AccountingEntityCode
	from journals 
	inner join InterestTransactions on InterestTransactions.EntityId = journals.AccountingEntityId AND InterestTransactions.AccountingEntityCode = journals.AccountingEntityCode AND InterestTransactions.tenant = journals.tenant
	where journals.IsLedgerCreated = 0 and journals.AccountingEntityCode = '2' AND InterestTransactions.InterestReportId IS NOT NULL
    ]]>       
  </Sql>
</Script>
