
<Script DBType="Main"  Module="Accounting" >
  <Sql Version="1">
    <![CDATA[
declare @recoId varchar(15)
DECLARE db_cursor CURSOR FOR 
    select Line from TaxReportLines

OPEN db_cursor  
FETCH NEXT FROM db_cursor INTO @recoId
WHILE @@FETCH_STATUS = 0  
BEGIN

    UPDATE   TaxReportLines
    set   StatusCode = 9
    where  IIF(SIGN (VatAmount) = SIGN (TotalInvoiceAmount),'same','diff') = 'diff'
    and VatAmount <> 0 and TotalInvoiceAmount <> 0 and VatAmount is not null and TotalInvoiceAmount is not null 

    FETCH NEXT FROM db_cursor INTO @recoId 
END 

CLOSE db_cursor  
DEALLOCATE db_cursor 
    ]]>      
  </Sql>
</Script>
 
