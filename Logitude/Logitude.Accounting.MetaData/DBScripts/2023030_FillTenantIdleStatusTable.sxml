<Script DBType="Main" Module="Accounting" AOT="false" TargetTableName="TenantIdleStatuses" Env="local,test,cloud">
	<Sql Version="1">
		<![CDATA[
    
INSERT INTO [dbo].[TenantIdleStatuses]
           (id,
		   [Tenant],
		   CreateDate,
		   UpdateDate,
           [Idle])
           (select id,id,GETDATE(),GETDATE() , 0 from Tenants)

    ]]>       
  </Sql>
</Script>