<Script DBType="Main" Module="Accounting">
  <Sql Version="1">
    <![CDATA[
        -- WI: 161925
        -- Usage: update interest transactions of type journal/adjustments
        --       <!> T.EntityId will be journal id, no need for accounting entity code
            
        update  T
        set     T.SearchFields = J.JournalNumber + ',' + isnull(J.AccountingEntityReference,'')
        from    InterestTransactions T
        join    Journals J on T.EntityId = J.Id
            --  and T.AccountingEntityCode = J.AccountingEntityCode
        where   T.SearchFields is null
     ]]>
 </Sql>
</Script>