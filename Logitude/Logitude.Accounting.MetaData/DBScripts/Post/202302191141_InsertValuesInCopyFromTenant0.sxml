<Script DBType="Main" Module="Accounting">
  <Sql Version="7">
    <![CDATA[
   INSERT INTO CopyFromTenant0 (Id, Tenant, TableName)
SELECT *
FROM (
    VALUES
    ('9999-10', 0, 'Chart Of Accounts'),
    ('9999-20', 0, 'GLAccounts'),
    ('9999-30', 0, 'Automatic Reconcile Methods'),
    ('9999-40', 0, 'VatTypes'),
    ('9999-50', 0, 'Computing Partners'),
    ('9999-60', 0, 'Vat settings'),
    ('9999-70', 0, 'Tasks Scheduler'),
    ('9999-80', 0, 'CountryCities')
) AS S(Id, Tenant, TableName)
WHERE NOT EXISTS (
    SELECT 1
    FROM CopyFromTenant0
    WHERE CopyFromTenant0.Tenant = S.Tenant
    AND CopyFromTenant0.TableName = S.TableName
	OR CopyFromTenant0.Id = S.Id
);



     ]]>
  </Sql>
</Script>