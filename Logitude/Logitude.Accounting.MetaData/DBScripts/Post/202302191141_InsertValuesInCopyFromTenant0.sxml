<Script DBType="Main" Module="Accounting">
  <Sql Version="9">
    <![CDATA[
   INSERT INTO CopyFromTenant0 (Id, Tenant, TableName, AlwaysEnabled)
SELECT *
FROM (
    VALUES
    ('9999-10', 0, 'Chart Of Accounts', 0),
    ('9999-20', 0, 'GLAccounts', 0),
    ('9999-30', 0, 'Automatic Reconcile Methods', 0),
    ('9999-40', 0, 'VatTypes', 0),
    ('9999-50', 0, 'Computing Partners', 0),
    ('9999-60', 0, 'Vat settings', 0),
    ('9999-70', 0, 'Tasks Scheduler', 0),
    ('9999-80', 0, 'CountryCities', 0),
    ('9999-90', 0, 'Document Types and Templates', 1),
    ('9999-91', 0, 'Report Templates', 1)
) AS S(Id, Tenant, TableName, AlwaysEnabled)
WHERE NOT EXISTS (
    SELECT 1
    FROM CopyFromTenant0
    WHERE CopyFromTenant0.Tenant = S.Tenant
    AND CopyFromTenant0.TableName = S.TableName
	OR CopyFromTenant0.Id = S.Id
);

update CopyFromTenant0 set alwaysEnabled = 1 where id in ('9999-90', '9999-91');


     ]]>
  </Sql>
</Script>