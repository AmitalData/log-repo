<Script DBType="Main" Module="Accounting" AOT="false" TargetTableName="Journals" Env="local,test,cloud">
	<Sql Version="1">
		<![CDATA[

    CREATE UNIQUE NONCLUSTERED INDEX IX_ExternalNoAndExternalSystemConstraintIndex
    ON Journals 
    ( ExternalNo , ExternalSystem , Tenant )
    WHERE ExternalNo IS NOT NULL AND  ExternalSystem IS NOT NULL;

    ]]>       
  </Sql>
</Script>