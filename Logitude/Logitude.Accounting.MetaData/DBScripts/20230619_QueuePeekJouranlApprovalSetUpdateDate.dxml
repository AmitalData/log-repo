<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="Queue_Peek_Jouranl_Approval"
  Schema="dbo"
  Module="Accounting">
  <SqlScript>
  <![CDATA[
  
Create procedure [dbo].[Queue_Peek_Jouranl_Approval]
(
@MessageId  bigint output,
@MessageBody  varchar(2000) output,
@RetryNumber int output,
@QueueDefinitionCode varchar(255),
@Tenant INTEGER output,
@WatingStatus int)
as
begin
BEGIN TRAN
Declare @frequency INTEGER
set @frequency = 60
SET @MessageId = (SELECT TOP 1 [Id]
FROM [dbo].[QueueMessages] WITH (UPDLOCK, READPAST,ROWLOCK)
WHERE [NextRunDateTime] <= getdate()
and [Status] = @WatingStatus
and QueueDefinitionCode = @QueueDefinitionCode
and Tenant in (select Tenant from TenantIdleStatuses with (UPDLOCK, READPAST,ROWLOCK) where Idle = 0)
ORDER BY [NextRunDateTime] ASC)
IF (@MessageId IS NOT NULL)
BEGIN
	Set @Tenant = (Select Tenant from [dbo].[QueueMessages] where [Id] = @MessageId)
	UPDATE [dbo].[TenantIdleStatuses]
	SET [Idle] = 1,
	[UpdateDate] =  GETDATE()
	WHERE [Tenant] = @Tenant
	Set @MessageBody = (Select MessageBody from [dbo].[QueueMessages] where [Id] = @MessageId)
	Set @RetryNumber = (Select RetryNumber from [dbo].[QueueMessages] where [Id] = @MessageId)
	UPDATE [dbo].[QueueMessages]
	SET [ProcessingDateTime] = getdate(),[NextRunDateTime] = dateadd(second,@frequency,getdate()),RetryNumber = (RetryNumber+1)
	WHERE [Id] = @MessageId
	UPDATE [dbo].[QueueMessageMoreDetails]
	SET [ProcessingDateTime] = getdate(),[NextRunDateTime] = dateadd(second,@frequency,getdate()),RetryNumber = (RetryNumber+1)
	WHERE [Id] = @MessageId
END
commit TRAN
end

]]></SqlScript>
  <OracleScript>
</OracleScript>
</Procedure>