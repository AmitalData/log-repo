<Script DBType="Main" Module="Accounting" AOT="false">
	<Sql Version="1">
		<![CDATA[
        IF NOT EXISTS (SELECT * FROM sys.indexes WHERE object_id = OBJECT_ID(N'[dbo].[LedgerTransactions]') 
				      AND name = N'PIX_LedgerTransactions_Tenant_LocalAmountDebit_AccountingDate')
			CREATE NONCLUSTERED INDEX [PIX_LedgerTransactions_Tenant_LocalAmountDebit_AccountingDate] 
			ON [dbo].[LedgerTransactions]
			(
				[Tenant],[LocalAmountDebit],[AccountingDate]
			)
			INCLUDE ([JournalId],[JournalLineNumber],[AccountId],[LocalAmountCredit],[Reference1],[OppositeAccountId]) 
			WITH (STATISTICS_NORECOMPUTE = OFF, DROP_EXISTING = OFF, ONLINE = OFF) ON [PRIMARY]
    ]]>       
  </Sql>
</Script>