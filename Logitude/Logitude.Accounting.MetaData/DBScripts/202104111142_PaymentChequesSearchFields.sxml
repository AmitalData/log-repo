<Script DBType="Main" Module="Accounting">
  <Sql Version="1">
    <![CDATA[
	
Update PaymentCheques
set SearchFields = concat(paymentCheques.ChequeNumber, ',', paymentCheques.PayToName, ',', glaccount.DisplayNumber)
from PaymentCheques paymentCheques
join GLAccounts glaccount on paymentCheques.PayToGLAccountId = glaccount.id

    ]]>       
  </Sql>
</Script>
