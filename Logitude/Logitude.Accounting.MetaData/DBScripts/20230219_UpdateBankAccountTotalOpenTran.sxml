<Script DBType="Main" Module="Accounting" AOT="false" TargetTableName="BankAccounts" Env="local,test,cloud">
	<Sql Version="3">
		<![CDATA[

  ;with q AS (
select bd.GLAccountId,bd.Tenant,count(*) as count
from BankAccounts as  bd
join ledgertransactions ledger on bd.GLAccountId = ledger.AccountId and bd.Tenant = ledger.Tenant
where ledger.IsExternalReconcile=0 
group by bd.GLAccountId,bd.Tenant)
update BankAccounts
set TotalOpenExternalTransactions = (select CAST(q.count as varchar) from q where q.GLAccountId = BankAccounts.GLAccountId and q.Tenant = BankAccounts.Tenant)
from q 
where q.GLAccountId =  BankAccounts.GLAccountId and q.Tenant = BankAccounts.Tenant

    ]]>       
  </Sql>
</Script>
