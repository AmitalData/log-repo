<Script DBType="Main" Module="Accounting" AOT="false">
	<Sql Version="2">
		<![CDATA[
        IF NOT EXISTS (SELECT * FROM sys.indexes WHERE object_id = OBJECT_ID(N'[dbo].[GLAccounts]') AND name = N'PIX_GLAccounts_ChartOfAccountsTypeCode')
			CREATE NONCLUSTERED INDEX [PIX_GLAccounts_ChartOfAccountsTypeCode] ON [dbo].[GLAccounts]
			(
				[ChartOfAccountsTypeCode] ASC
			)
			INCLUDE ( 	[Tenant]) WITH (STATISTICS_NORECOMPUTE = OFF, DROP_EXISTING = OFF, ONLINE = OFF) ON [PRIMARY]
    ]]>       
  </Sql>
</Script>