<Script DBType="Main" Module="Accounting" AOT="true" TargetTableName="BankDeposits" Env="local,test,cloud">
	<Sql Version="1">
		<![CDATA[

		update BankDeposits
set SearchFields = DepositNumber where 
BankDeposits.Id not in (select DepositId from BankDepositLines)
and $LastCounterWhere$

    ]]>       
  </Sql>
</Script>