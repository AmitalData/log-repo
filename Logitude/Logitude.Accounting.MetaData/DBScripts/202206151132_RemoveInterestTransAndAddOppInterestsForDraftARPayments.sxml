<Script DBType="Main" Module="Accounting">
  <Sql Version="1">
    <![CDATA[

	INSERT INTO InterestTransactions (Id, Tenant, CreateDateTime, UpdateDateTime, InterestValueDate, SearchFields, GLAccountId, EntityId, OriginalEntityLineNumber, LocalAmount, ForeignAmount, CurrencyId,InterestEntityTypeCode, InterestReportId, IsClosed, IsCancelled, AccountingEntityCode)
	SELECT CONCAT('8-A', ROW_NUMBER() OVER(ORDER BY (SELECT 1))) as Id, InterestTransactions.Tenant, CreateDateTime, UpdateDateTime, InterestValueDate, InterestTransactions.SearchFields, InterestTransactions.GLAccountId, InterestTransactions.EntityId, InterestTransactions.OriginalEntityLineNumber + 2, InterestTransactions.LocalAmount * -1 as LocalAmount, InterestTransactions.ForeignAmount *-1 as ForeignAmount, InterestTransactions.CurrencyId, InterestEntityTypeCode, Null, 0, InterestTransactions.IsCancelled, InterestTransactions.AccountingEntityCode
	from InterestTransactions 
	where InterestTransactions.AccountingEntityCode = '3' AND InterestTransactions.InterestReportId != '999' AND InterestTransactions.InterestReportId IS NOT NULL AND EntityId not in (
		Select AccountingEntityId from Journals where AccountingEntityCode = '3' 
	)

	delete from InterestTransactions 
	where InterestTransactions.AccountingEntityCode = '3' AND InterestTransactions.InterestReportId IS NULL AND InterestTransactions.Id not like '8-%' AND EntityId not in (
		Select AccountingEntityId from Journals where AccountingEntityCode = '3' 
	)
    ]]>       
  </Sql>
</Script>
