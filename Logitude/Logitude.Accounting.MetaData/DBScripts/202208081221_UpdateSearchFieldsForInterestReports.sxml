<Script DBType="Main" Module="Accounting">
  <Sql Version="1">
    <![CDATA[
        update InterestReports set SearchFields = InterestReports.SearchFields + ',' + GLADisplayNumber + ',' + CardCode from InterestReports
        inner join(
        Select InterestReports.Id, InterestReports.Tenant, Cards.Code as CardCode, GLAccounts.DisplayNumber as GLADisplayNumber
        from InterestReports
        inner join Cards on Cards.Id = InterestReports.CustomerId AND Cards.Tenant = InterestReports.Tenant
        inner join GLAccounts  on InterestReports.GLAccountId = GLAccounts.Id AND InterestReports.Tenant = GLAccounts.Tenant 
	    ) as InterestReportsWithGLAccountsAndCards
        on InterestReports.Id = InterestReportsWithGLAccountsAndCards.Id
        AND InterestReports.Tenant = InterestReportsWithGLAccountsAndCards.Tenant
    ]]>
  </Sql>
</Script>