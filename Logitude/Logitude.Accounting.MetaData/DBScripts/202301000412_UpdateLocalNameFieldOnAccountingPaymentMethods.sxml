<Script DBType="Main" Module="Accounting">
  <Sql Version="1">
    <![CDATA[

UPDATE AccountingPaymentMethods
    SET LocalName = (case when Name ='Offsetting' then N'קיזוז'
                         when Name ='Cheque' then N'המחאה'
                         when Name ='Bank Transfer' then N'העברה בנקאית'
						 when Name ='Cash' then N'מזומן'
						 when Name='Credit Card' then N'כרטיס אשראי'
                    end)
    ]]>       
  </Sql>
</Script>
