<Script DBType="Main" Module="Accounting" AOT="false">
  <Sql Version="1">
    <![CDATA[
	
        update	T
        set		T.SearchFields = J.JournalNumber + ',' + J.AccountingEntityReference
        from	InterestTransactions T
        join	InterestEntityTypes TYP on T.InterestEntityTypeCode = TYP.Code
        join	Journals J on T.EntityId = J.AccountingEntityId 
		        and TYP.AccountingEntityCode = J.AccountingEntityCode
        where	T.SearchFields is null or T.SearchFields = ''
		
     ]]>
 </Sql>
</Script>