<Script DBType="Main" Module="Accounting" AOT="true" TargetTableName="Journals" Env="test,cloud">
  <Sql Version="1">
    <![CDATA[
    
    update Journals
set AccountingEntityReference = er.ReconciliationNumber,
AccountingEntityId = er.Id
from ExternalReconciliations as er
join ExternalReconciliationLines as erl on er.Id = erl.ReconciliationId and er.Tenant = erl.Tenant
join LedgerTransactions as lt on lt.Id = erl.LedgerTransactionId and lt.Tenant = erl.Tenant and lt.JournalLineNumber = 1
join Journals as j on lt.JournalId = j.Id and lt.Tenant = j.Tenant
where $LastCounterWhere$ 
and 
j.AccountingEntityCode = 12
and 
(er.ReconciliationNumber <> j.AccountingEntityReference
or er.Id <> j.AccountingEntityId
or j.AccountingEntityReference is null)


    ]]>
  </Sql>
</Script>