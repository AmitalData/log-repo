<Script DBType="Main" Module="Accounting">
  <Sql Version="1">
    <![CDATA[
	INSERT INTO InterestTransactions (Id, Tenant, CreateDateTime, UpdateDateTime, InterestValueDate, SearchFields, GLAccountId, EntityId, OriginalEntityLineNumber, LocalAmount, ForeignAmount, CurrencyId,InterestEntityTypeCode, InterestReportId, IsClosed, IsCancelled)
    SELECT CONCAT('DA', InterestTransactions.Id) as Id, InterestTransactions.Tenant, CreateDateTime, UpdateDateTime, InterestValueDate, InterestTransactions.SearchFields, GLAccounts.Id as GLAccountId, InterestTransactions.EntityId, InterestTransactions.OriginalEntityLineNumber + 40, InterestTransactions.LocalAmount, InterestTransactions.ForeignAmount, InterestTransactions.CurrencyId, InterestEntityTypeCode, Null, 0, InterestTransactions.IsCancelled
    from InterestTransactions
    inner join ARInvoices on ARInvoices.Id = InterestTransactions.EntityId AND InterestTransactions.InterestEntityTypeCode = '1' AND ARInvoices.Tenant = InterestTransactions.Tenant 
    inner join GLAccounts on ARInvoices.BillToGLAccountId = GLAccounts.Id AND GLAccounts.Tenant = ARInvoices.Tenant
    where ARInvoices.BillToGLAccountId != InterestTransactions.GLAccountId  AND GLAccounts.ChartOfAccountsTypeCode = '6' AND  InterestReportId is not null
    AND ARInvoices.IsCancelled = 1 AND ARInvoices.CancelledByARInvoiceId is not null and ARInvoices.StatusCode = 'AR'


    INSERT INTO InterestTransactions (Id, Tenant, CreateDateTime, UpdateDateTime, InterestValueDate, SearchFields, GLAccountId, EntityId, OriginalEntityLineNumber, LocalAmount, ForeignAmount, CurrencyId,InterestEntityTypeCode, InterestReportId, IsClosed, IsCancelled)
    SELECT CONCAT('AC', InterestTransactions.Id) as Id, InterestTransactions.Tenant, CreateDateTime, UpdateDateTime, InterestValueDate, InterestTransactions.SearchFields, GLAccounts.Id as CorrectGLAccountId, InterestTransactions.EntityId, InterestTransactions.OriginalEntityLineNumber + 80, InterestTransactions.LocalAmount, InterestTransactions.ForeignAmount, InterestTransactions.CurrencyId, InterestEntityTypeCode, Null, 0, InterestTransactions.IsCancelled
    from InterestTransactions
    inner join ARInvoices on ARInvoices.Id = InterestTransactions.EntityId AND InterestTransactions.InterestEntityTypeCode = '1' AND ARInvoices.Tenant = InterestTransactions.Tenant 
    inner join GLAccounts on ARInvoices.BillToGLAccountId = GLAccounts.Id AND GLAccounts.Tenant = ARInvoices.Tenant
    where ARInvoices.BillToGLAccountId != InterestTransactions.GLAccountId  AND GLAccounts.ChartOfAccountsTypeCode = '6' AND  InterestReportId is not null
    ]]>       
  </Sql>
</Script>
