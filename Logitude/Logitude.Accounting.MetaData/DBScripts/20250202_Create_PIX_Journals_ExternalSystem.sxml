<Script DBType="Main" Module="Accounting" AOT="false">
	<Sql Version="2">
		<![CDATA[
    IF NOT EXISTS (SELECT * FROM sys.indexes WHERE object_id = OBJECT_ID(N'[dbo].[Journals]') AND name = N'PIX_Journals_ExternalSystem')
			CREATE NONCLUSTERED INDEX [PIX_Journals_ExternalSystem] ON [dbo].[Journals]
			(
				[ExternalSystem] ASC
			)
			INCLUDE ( 	[Tenant],
				[JournalNumber],
				[AccountingEntityCode],
				[AccountingEntityId],
				[AccountingEntityReference]) WITH (STATISTICS_NORECOMPUTE = OFF, DROP_EXISTING = OFF, ONLINE = OFF) ON [PRIMARY]
    ]]>       
  </Sql>
</Script>