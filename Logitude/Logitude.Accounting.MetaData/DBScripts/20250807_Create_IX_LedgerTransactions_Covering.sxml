<Script DBType = "Main" Module = "Accounting" AOT = "false" >
    <Sql Version = "1" >

        <![CDATA[
        IF NOT EXISTS (SELECT * FROM sys.indexes WHERE object_id = OBJECT_ID(N'[dbo].[LedgerTransactions]') AND name = N'IX_LedgerTransactions_Covering')

            CREATE NONCLUSTERED INDEX IX_LedgerTransactions_Covering
ON dbo.LedgerTransactions (Tenant, AccountingDate, AccountId, JournalId)
INCLUDE (
    JournalLineNumber,
    Id,
    CreateDate,
    ControlAccountId,
    DocumentDate,
    DueDate,
    LocalAmountDebit,
    LocalAmountCredit,
    CurrencyId,
    ForeignAmountDebit,
    ForeignAmountCredit,
    ExchangeRate,
    Reference1,
    Reference2,
    Reference3,
    OpenAmount,
    OppositeAccountId,
    SearchFields,
    OpenAmountCurrencyId,
    Notes,
    AmountToReconcile,
    Mark,
    IsReconciled,
    IsExternalReconcile,
    InReconcileProgress,
    ReconcileRemarks,
    InProgressExternalReconcile,
    UpdateDateTime,
    UpdatedByUserName,
    InternalNote,
    ProcessStartDate
)
    ]]>
  </Sql >
</Script >