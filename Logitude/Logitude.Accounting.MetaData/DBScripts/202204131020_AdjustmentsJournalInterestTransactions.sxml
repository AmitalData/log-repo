<Script DBType="Main" Module="Accounting">
  <Sql Version="1">
    <![CDATA[
	
insert into InterestTransactions (Id, Tenant, CreateDateTime, UpdateDateTime, GLAccountId, InterestEntityTypeCode, EntityId, OriginalEntityLineNumber, LocalAmount, ForeignAmount,CurrencyId, InterestValueDate)
select CONCAT('9-', ROW_NUMBER() OVER(ORDER BY (SELECT 1))) as Id,Tenant, GETDATE() as CreateDateTime, GETDATE() as UpdateDateTime, GLAccountId,'5' as InterestEntityTypeCode, JournalId, Line, LocalAmount, ForeignAmount, CurrencyId, DueDate 
from (
select 
JournalLines.JournalId,
JournalLines.Line, 
JournalLines.LocalAmount * -1 as LocalAmount,
JournalLines.ForeignAmount * -1 as ForeignAmount,
JournalLines.CurrencyId,
JournalLines.DueDate,
JournalLines.Tenant, 
CreditAccountId as GLAccountId
from JournalLines 
inner join Journals on Journals.Id = JournalLines.JournalId
where (JournalLines.ActionCode = '1' OR JournalLines.ActionCode = '3') AND Journals.AccountingEntityCode = '10' 
AND Journals.Id not in (select EntityId from InterestTransactions where InterestEntityTypeCode = 5)
UNION
select 
JournalLines.JournalId,
JournalLines.Line, 
JournalLines.LocalAmount,
JournalLines.ForeignAmount,
JournalLines.CurrencyId,
JournalLines.DueDate,
JournalLines.Tenant, 
DebitAccountId as GLAccountId
from JournalLines 
inner join Journals on Journals.Id = JournalLines.JournalId
where (JournalLines.ActionCode = '2' OR JournalLines.ActionCode = '3') AND Journals.AccountingEntityCode = '10' 
AND Journals.Id not in (select EntityId from InterestTransactions where InterestEntityTypeCode = 5)) as AdjustmentJournalsInterestTransactions

    ]]>       
  </Sql>
</Script>
