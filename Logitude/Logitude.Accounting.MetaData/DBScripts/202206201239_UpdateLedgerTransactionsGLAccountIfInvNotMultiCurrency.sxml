<Script DBType="Main" Module="Accounting">
  <Sql Version="1">
    <![CDATA[
	update LedgerTransactions set OppositeAccountId = JournlaLinesGlAccountCurrencies.MainGLAccountId from LedgerTransactions
    inner join (Select GLAccountCurrencies.MainGLAccountId, journallines.DebitAccountId, BillToGLAccountId ,Journals.Id as JournalId , journallines.Line,Journals.JournalNumber, journallines.CreditAccountId
    , journallines.LocalAmount, journallines.ForeignAmount, journallines.CurrencyId, journallines.ActionCode, journallines.Tenant
    from Journals
    inner join journallines on journallines.JournalId = Journals.Id AND journallines.Tenant = Journals.Tenant 
    inner join ARInvoices on ARInvoices.Id = Journals.AccountingEntityId AND ARInvoices.Tenant = Journals.Tenant
    inner join GLAccounts on ARInvoices.BillToGLAccountId = GLAccounts.Id AND ARInvoices.Tenant = GLAccounts.Tenant 
    inner join GLAccountCurrencies on ARInvoices.BillToGLAccountId = GLAccountCurrencies.MainGLAccountId AND ARInvoices.Tenant = GLAccountCurrencies.Tenant 
    where  ARInvoices.IsMultiCurrency = 0 AND AccountingEntityCode = 2 AND GLAccounts.IsMultiCurrency = 1 and GLAccountCurrencies.CurrencyId = journallines.CurrencyId and ActionCode = '1' 
	AND journallines.DebitAccountId != GLAccountCurrencies.MainGLAccountId) as JournlaLinesGlAccountCurrencies
    on JournlaLinesGlAccountCurrencies.JournalId = LedgerTransactions.JournalId AND JournlaLinesGlAccountCurrencies.Line = LedgerTransactions.JournalLineNumber
    AND JournlaLinesGlAccountCurrencies.Tenant = LedgerTransactions.Tenant
     ]]>
 </Sql>
</Script>