	<View DBType="Main" Name="AllARPaymentChequesViews" Schema="dbo" Module="Accounting">
	<SqlScript>
		<![CDATA[
 CREATE OR ALTER  view [dbo].[AllARPaymentChequesViews] as
 with trns as (select
l.AccountId
,l.Id
,l.JournalLineNumber
,l.LocalAmountCredit
,l.LocalAmountDebit
,l.ForeignAmountCredit
,l.ForeignAmountDebit
,l.reference1,l.reference2,l.reference3
,l.Notes
,l.DueDate
,l.OppositeAccountId
 
,j.ExternalSystem
,j.AccountingEntityId
,j.tenant
,j.AccountingEntityReference
,j.journalnumber
,j.Id as journalId
,j.AccountingEntityCode
from LedgerTransactions l inner join Journals j on l.JournalId = j.Id    and l.Tenant = j.Tenant and l.LocalAmountCredit != 0 and j.AccountingEntityCode = 3 )
,chk as ( select ac.ValueDate,acs.Code,acs.localname,acs.EnglishName,ac.PaymentId,ac.LineNumber,ac.Tenant, ac.Id
from ARPaymentCheques ac inner join ARPaymentChequeStatuses acs on ac.StatusCode = acs.Code
where ac.StatusCode != 5 and ac.StatusCode != 6
)
,coa as (
select  c.Tenant, c.Id
from  GLAccounts g inner join ChartOfAccounts c on g.ChartOfAccountsId = c.Id  and g.Tenant = c.Tenant
where c.TypeCode = '5'
)
select distinct trns.AccountId,trns.Id, trns.tenant, chk.ValueDate,
'C' as [type],
trns.AccountingEntityReference,trns.LocalAmountCredit,trns.LocalAmountDebit,trns.ForeignAmountCredit,trns.ForeignAmountDebit,trns.reference1,trns.reference2,trns.reference3,
trns.journalnumber,trns.journalId as journalId,trns.AccountingEntityCode,trns.AccountingEntityId,chk.Code,chk.localname,chk.EnglishName,trns.Notes,chk.Id as ChequeId
from trns
inner join chk on trns.AccountingEntityId = chk.PaymentId and trns.JournalLineNumber= chk.LineNumber  and chk.Tenant = trns.Tenant
 
union all
 
select distinct  l.AccountId,l.id, l.tenant, l.DueDate,
'J' as [type],
j.AccountingEntityReference,l.LocalAmountCredit,l.LocalAmountDebit,l.ForeignAmountCredit,l.ForeignAmountDebit,l.reference1,l.reference2,l.reference3,
j.journalnumber,j.Id as journalId,j.AccountingEntityCode,j.AccountingEntityId
,'','',''
,l.Notes,
'' as ChequeId
from
LedgerTransactions l inner join
journals j
on l.journalid= j.id  and l.Tenant = j.Tenant
inner join GLAccounts g
 on  l.Tenant = g.Tenant and l.OppositeAccountId = g.Id
 where
j.ExternalSystem is not null and l.DueDate > getdate()
and l.LocalAmountCredit != 0 AND g.ChartOfAccountsTypeCode = '5';
    ]]>
	</SqlScript>
	<OracleScript>
	</OracleScript>
</View>