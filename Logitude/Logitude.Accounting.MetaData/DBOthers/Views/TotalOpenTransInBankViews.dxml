<View DBType="Main" Name="TotalOpenTransInBankViews" Schema="dbo" Module="Accounting">
	<SqlScript>
		<![CDATA[
       CREATE OR ALTER VIEW dbo.TotalOpenTransInBankViews AS
SELECT mergedData.Id, mergedData.Tenant,
       SUM(mergedData.ledgertransactionscount) AS TotalLedgerTransactionsCount,
       SUM(mergedData.ReconcileExternalPageLinesCount) AS TotalReconcileExternalPageLinesCount
FROM
(
    SELECT bd.Id, bd.GLAccountId, bd.Tenant,
           COUNT(*) AS ledgertransactionscount,
           0 AS ReconcileExternalPageLinesCount
    FROM BankAccounts AS bd
    JOIN ledgertransactions ledger ON bd.GLAccountId = ledger.AccountId OR bd.TransferGLAcccountId = ledger.AccountId
    WHERE ledger.IsExternalReconcile = 0
      AND ledger.InReconcileProgress = 0
      AND ledger.InProgressExternalReconcile = 0
      AND ledger.DueDate < GETDATE()
    GROUP BY bd.Id, bd.GLAccountId, bd.Tenant

    UNION ALL

    SELECT bd.Id, ext.EntityId, bd.Tenant,
           0 AS ledgertransactionscount,
           COUNT(*) AS ReconcileExternalPageLinesCount
    FROM BankAccounts AS bd
    JOIN dbo.ReconcileExternalPages AS ext ON bd.GLAccountId = ext.GLAccountId AND bd.Tenant = ext.Tenant
    JOIN dbo.ReconcileExternalPageLines AS extLine ON ext.Id = extLine.ReconcileExternalPageId AND extLine.InProgressExternalReconcile = 0
    WHERE extLine.IsReconciled = 0
      AND ext.StatusCode = 2
    GROUP BY bd.Id, ext.EntityId, bd.Tenant
) AS mergedData
GROUP BY mergedData.Id, mergedData.Tenant;
    ]]>
	</SqlScript>
	<OracleScript>
	</OracleScript>
</View>