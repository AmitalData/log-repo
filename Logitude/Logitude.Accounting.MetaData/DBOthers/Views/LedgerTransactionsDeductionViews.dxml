	<View DBType="Main" Name="LedgerTransactionsDeductionViews" Schema="dbo" Module="Accounting">
	<SqlScript>
		<![CDATA[
CREATE OR ALTER  view  [dbo].[LedgerTransactionsDeductionViews]
AS
    SELECT 
        lt.Id,
        lt.AccountId,         -- whAccount or bank
        lt.OppositeAccountId, -- Supplier
        lt.JournalId,
        lt.JournalLineNumber,
        lt.LocalAmountDebit,
        lt.LocalAmountCredit,
        lt.Reference1,
        lt.AccountingDate,
        lt.Tenant,
		gla.ChartOfAccountsTypeCode
    FROM LedgerTransactions lt
    JOIN GLAccounts gla ON gla.Id = lt.AccountId AND gla.Tenant = lt.Tenant
    JOIN GLAccounts opp ON opp.Id = lt.OppositeAccountId AND opp.Tenant = lt.Tenant
    LEFT JOIN GLAccountCurrencies glacur ON opp.Id = glacur.GLAccountId
    JOIN Cards c ON c.Id = (
        SELECT TOP 1 Id
        FROM Cards
        WHERE GLAccountId = ISNULL(glacur.MainGLAccountId, opp.Id)
              AND InActive = 0
        ORDER BY CreateDate DESC
    ) 
    AND c.Tenant = gla.Tenant
    JOIN Addresses adr ON adr.CardId = c.Id AND adr.Tenant = c.Tenant
    JOIN Countries co ON co.Id = adr.CountryId AND co.Tenant = adr.Tenant
    JOIN Journals j ON j.Id = lt.JournalId AND j.Tenant = lt.Tenant
    WHERE opp.AccountTypeCode = '3'              -- Supplier
      AND opp.ExcludeFromDeductionReport = 0     -- Include
      AND adr.AddressTypeId = 'M'                -- Main
      AND lt.LocalAmountDebit = 0                -- Credit
      AND co.Code = 'IL'                         -- Israel
      AND j.AccountingEntityCode != '5';         -- Exclude APPayment
    ]]>
	</SqlScript>
	<OracleScript>
	</OracleScript>
</View>

