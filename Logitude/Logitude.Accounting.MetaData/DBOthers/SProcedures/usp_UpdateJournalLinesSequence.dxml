<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main" Name="usp_AccountingStreaming" Schema="dbo" Module="Accounting">
  >
  <SqlScript>
    <![CDATA[
    CREATE PROCEDURE [dbo].[usp_UpdateJournalLinesSequence]
@V_JOURANLID varchar(max) = NULL,
  
@V_TENANT float(53) = NULL
   

AS
BEGIN
    SET NOCOUNT ON;

    ;WITH NumberedLines AS (
        SELECT 
            Line,
            JOURNALID,
            ROW_NUMBER() OVER (PARTITION BY JOURNALID ORDER BY LINE) AS NewLineNumber
        FROM 
            JournalLines
			WHERE Tenant=@V_TENANT AND JournalId=@V_JOURANLID
    )
    UPDATE J
    SET J.LINE = NL.NewLineNumber
    FROM 
        JournalLines J
    INNER JOIN 
        NumberedLines NL ON J.LINE = NL.LINE AND J.JOURNALID = NL.JOURNALID;
END

    ]]>
  </SqlScript>
  <OracleScript>
  </OracleScript>
</Procedure>