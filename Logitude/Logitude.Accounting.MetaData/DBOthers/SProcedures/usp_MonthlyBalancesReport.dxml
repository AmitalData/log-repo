<?xml version="1.0" encoding="utf-8"?>
<Procedure  
  DBType="Main" Name="usp_MonthlyBalancesReport" Schema="dbo" Module="Accounting">
  >
  <SqlScript>
    <![CDATA[
 CREATE or ALTER PROCEDURE [dbo].[usp_MonthlyBalancesReport]
@Year INT,
@Tenant INT
AS
BEGIN
;WITH YearlyTransfers AS (
    SELECT
        lt.AccountId,
        SUM(lt.LocalAmountDebit - lt.LocalAmountCredit) AS TransferSum
    FROM
        Journals j
    INNER JOIN
        LedgerTransactions lt ON j.Id = lt.JournalId 
    WHERE
        j.AccountingEntityCode = 11
		AND J.AccountingDate =DATEFROMPARTS(@Year, 1, 1)
		AND J.Tenant =@Tenant
		AND LT.Tenant =@Tenant
    GROUP BY
        lt.AccountId
)
SELECT
MAX(gt.MONTH),
AccountId AS ACCOUNTID,

max(g.ChartOfAccountsId) as chartOfAccount,
max(g.LocalName) as LocalName,
max(g.EnglishName) as EnglishName,
max(g.DisplayNumber) as DisplayNumber,
SUM(CASE WHEN (gt.Month = 1  and gt.Year  = @Year )THEN gt.LocalAmountDebit - gt.LocalAmountCredit ELSE 0 END) 
  - ISNULL(MAX(yt.TransferSum), 0) AS MONTH1,

SUM(CASE WHEN (gt.Month = 2  and gt.Year  = @Year ) THEN gt.LocalAmountDebit - gt.LocalAmountCredit ELSE 0 END) AS MONTH2,
SUM(CASE WHEN (gt.Month = 3  and gt.Year  = @Year ) THEN gt.LocalAmountDebit - gt.LocalAmountCredit ELSE 0 END) AS MONTH3,
SUM(CASE WHEN (gt.Month = 4  and gt.Year  = @Year ) THEN gt.LocalAmountDebit - gt.LocalAmountCredit ELSE 0 END) AS MONTH4,
SUM(CASE WHEN (gt.Month = 5  and gt.Year  = @Year ) THEN gt.LocalAmountDebit - gt.LocalAmountCredit ELSE 0 END) AS MONTH5,
SUM(CASE WHEN (gt.Month = 6  and gt.Year  = @Year ) THEN gt.LocalAmountDebit - gt.LocalAmountCredit ELSE 0 END) AS MONTH6,
SUM(CASE WHEN (gt.Month = 7  and gt.Year  = @Year ) THEN gt.LocalAmountDebit - gt.LocalAmountCredit ELSE 0 END) AS MONTH7,
SUM(CASE WHEN (gt.Month = 8  and gt.Year  = @Year ) THEN gt.LocalAmountDebit - gt.LocalAmountCredit ELSE 0 END) AS MONTH8,
SUM(CASE WHEN (gt.Month = 9  and gt.Year  = @Year ) THEN gt.LocalAmountDebit - gt.LocalAmountCredit ELSE 0 END) AS MONTH9,
SUM(CASE WHEN (gt.Month = 10 and  gt.Year =  @Year ) THEN gt.LocalAmountDebit - gt.LocalAmountCredit ELSE 0 END) AS MONTH10,
SUM(CASE WHEN (gt.Month = 11 and  gt.Year =  @Year ) THEN gt.LocalAmountDebit - gt.LocalAmountCredit ELSE 0 END) AS MONTH11,
SUM(CASE WHEN (gt.Month = 12 and  gt.Year =  @Year ) THEN gt.LocalAmountDebit - gt.LocalAmountCredit ELSE 0 END) AS MONTH12,
SUM(CASE WHEN (GT.Year <= @Year )THEN  gt.LocalAmountDebit - gt.LocalAmountCredit ELSE 0 END) AS TOTAL_MONTHS ,
SUM(CASE WHEN (GT.Year < @Year ) THEN gt.LocalAmountDebit - gt.LocalAmountCredit ELSE 0 END) 
 + ISNULL(MAX(yt.TransferSum), 0)
   AS LocalOpenBalance

FROM
GLAccounts g
INNER JOIN
GLAccountTotalByMonths gt ON g.Id = gt.AccountId
LEFT JOIN
    YearlyTransfers yt ON g.Id = yt.AccountId

WHERE
g.Tenant = @Tenant
AND gt.Year <= @Year
AND g.IsControlAccount = 0
and gt.DateTypeCode = 1
GROUP BY
gt.AccountId
order by chartOfAccount
END

	
    
    ]]>
  </SqlScript>
  <OracleScript>
  </OracleScript>
</Procedure>