<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main" Name="usp_FixFailedReconcileJournals" Schema="dbo" Module="Accounting">
  >
  <SqlScript>
    <![CDATA[
    
CREATE OR ALTER PROCEDURE [dbo].[usp_FixFailedReconcileJournals]
    @Tenant INT
AS
BEGINs
    -- מחיקת הטבלה הזמנית אם קיימת
    IF OBJECT_ID('tempdb..#TempJournalIds') IS NOT NULL
    BEGIN
        DROP TABLE #TempJournalIds;
    END
 
    -- יצירת טבלה זמנית עם שני שדות - JournalId ו-LedgerTransactionId
    CREATE TABLE #TempJournalIds (JournalId VARCHAR(15), LedgerTransactionId VARCHAR(15));
 
    -- הכנסת ה-JournalId ו-LedgerTransactionId העומדים בתנאים לטבלה הזמנית
    INSERT INTO #TempJournalIds (JournalId, LedgerTransactionId)
    SELECT r.JournalId, l.Id
    FROM JournalReconciles r
    INNER JOIN Journals j ON r.JournalId = j.Id
    INNER JOIN LedgerTransactions l ON r.LedgerTransactionId = l.Id
    WHERE l.InReconcileProgress = 1 
      AND l.IsReconciled = 0
      AND j.StatusCode = '4' 
      AND l.Tenant = @Tenant
      AND j.Tenant = @Tenant
      AND r.Tenant = @Tenant 
    UNION ALL
    SELECT r.JournalId, l.Id
    FROM JournalExternalReconciles r
    INNER JOIN Journals j ON r.JournalId = j.Id
    INNER JOIN LedgerTransactions l ON r.LedgerTransactionId = l.Id
    WHERE l.InProgressExternalReconcile = 1 
      AND l.IsExternalReconcile = 0
      AND j.StatusCode = '4' 
      AND l.Tenant = @Tenant 
      AND j.Tenant = @Tenant
      AND r.Tenant = @Tenant;
 
    -- מחיקת רשומות מטבלת JournalReconciles
    DELETE FROM JournalReconciles 
    WHERE JournalId IN (
        SELECT DISTINCT JournalId FROM #TempJournalIds
    );
 
    -- מחיקת רשומות מטבלת JournalExternalReconciles
    DELETE FROM JournalExternalReconciles 
    WHERE JournalId IN (
        SELECT DISTINCT JournalId FROM #TempJournalIds
    );
 
  UPDATE LedgerTransactions
	SET 
    InReconcileProgress = 0,
    InProgressExternalReconcile = 0
	WHERE Id IN (SELECT DISTINCT LedgerTransactionId FROM #TempJournalIds);
 
    -- מחיקת הטבלה הזמנית
    DROP TABLE #TempJournalIds;
END;


    ]]>
  </SqlScript>
  <OracleScript>
  </OracleScript>
</Procedure>