<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="SetTenantIdleProcedure"
  Schema="dbo"
  Module="Accounting">
  <SqlScript>
  <![CDATA[
  
CREATE procedure [dbo].[SetTenantIdleProcedure] 
(
@ObjectTable varchar(25) = 'Journal'
)

as

update [dbo].[TenantIdleStatuses]
set Idle = 0
where DATEDIFF(MINUTE, UpdateDate, GetDate()) > 10
and Idle = 1
and ObjectTable = @ObjectTable

]]></SqlScript>
  <OracleScript>
</OracleScript>
</Procedure>