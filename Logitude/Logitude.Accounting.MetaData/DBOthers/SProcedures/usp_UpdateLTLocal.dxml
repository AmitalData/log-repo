<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main" Name="usp_UpdateLTLocal" Schema="dbo" Module="Accounting">
  <SqlScript>
    <![CDATA[
CREATE OR ALTER PROCEDURE [dbo].[usp_UpdateLTLocal]
(
    @V_Tenant INT,
    @V_AccountId NVARCHAR(50),
    @V_AccountingCurrencyId NVARCHAR(50)
)
AS
BEGIN
    UPDATE LedgerTransactions
    SET 
        IsReconciled = 0,
        OpenAmountCurrencyId = @V_AccountingCurrencyId,
        OpenAmount = LocalAmountDebit - LocalAmountCredit
    WHERE 
        Tenant = @V_Tenant 
        AND AccountId = @V_AccountId 
        AND (
            IsReconciled = 1
            OR OpenAmountCurrencyId <> @V_AccountingCurrencyId
            OR OpenAmount <> LocalAmountDebit - LocalAmountCredit
        )
        AND (
            ForeignAmountDebit != 0 
            OR ForeignAmountCredit != 0
            OR LocalAmountDebit != 0 
            OR LocalAmountCredit != 0
        );
END    

]]>
  </SqlScript>
  <OracleScript>
  </OracleScript>
</Procedure>