<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main"
  Name="usp_Queue_Peek_ThreadPerTenant"
  Schema="dbo"
  Module="Accounting">
  <SqlScript>
  <![CDATA[
  
CREATE OR ALTER procedure [dbo].[usp_Queue_Peek_ThreadPerTenant]
(
@MessageId  bigint output,
@MessageBody  varchar(2000) output,
@RetryNumber int output,
@QueueDefinitionCode varchar(255),
@Tenant INTEGER output,
@WatingStatus int,
@ObjectTable varchar(25) = 'Journal'
)
as
begin
BEGIN TRAN
			Declare @frequency INTEGER
			set @frequency = 60
			SELECT TOP 1
				@MessageId = qm.[Id],
				@Tenant = qm.Tenant,
				@MessageBody = qm.MessageBody,
				@RetryNumber = qm.RetryNumber
				FROM [dbo].[QueueMessages] qm WITH (UPDLOCK, READPAST, ROWLOCK)
				JOIN [dbo].[TenantIdleStatuses] tis WITH (UPDLOCK, READPAST, ROWLOCK)
				ON qm.Tenant = tis.Tenant AND tis.ObjectTable = @ObjectTable AND tis.Idle = 0
				WHERE
				qm.QueueDefinitionCode = @QueueDefinitionCode
				AND qm.Status = @WatingStatus
				AND (
				(@ObjectTable = 'ARInvoice' AND qm.CreateDateTime <= GETDATE())
				OR (@ObjectTable != 'ARInvoice' AND qm.NextRunDateTime <= GETDATE())
				)
				ORDER BY
				CASE WHEN @ObjectTable = 'ARInvoice' THEN qm.CreateDateTime
				ELSE qm.NextRunDateTime END ASC;
												
			IF (@MessageId IS NOT NULL)
			BEGIN
					
					UPDATE [dbo].[TenantIdleStatuses] SET [Idle] = 1,[UpdateDate] =  GETDATE()	
														WHERE [Tenant] = @Tenant and [ObjectTable] = @ObjectTable

					UPDATE [dbo].[QueueMessages] SET [ProcessingDateTime] = getdate(),[NextRunDateTime] = dateadd(second,@frequency,getdate()),RetryNumber = (RetryNumber+1)
														WHERE [Id] = @MessageId

					UPDATE [dbo].[QueueMessageMoreDetails] SET [ProcessingDateTime] = getdate(),[NextRunDateTime] = dateadd(second,@frequency,getdate()),RetryNumber = (RetryNumber+1)
														WHERE [Id] = @MessageId
			END
commit TRAN
end

]]></SqlScript>
  <OracleScript>
</OracleScript>
</Procedure>