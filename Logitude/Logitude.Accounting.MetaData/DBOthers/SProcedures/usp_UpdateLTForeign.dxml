<?xml version="1.0" encoding="utf-8"?>
<Procedure
  DBType="Main" Name="usp_UpdateLTForeign" Schema="dbo" Module="Accounting">
  >
  <SqlScript>
    <![CDATA[
CREATE OR ALTER PROCEDURE [dbo].[usp_UpdateLTForeign]
(
    @V_Tenant INT,
    @V_AccountId NVARCHAR(50)
)
AS
BEGIN
    UPDATE LedgerTransactions
    SET 
        IsReconciled = 0,
        OpenAmountCurrencyId = CurrencyId,
        OpenAmount = ForeignAmountDebit - ForeignAmountCredit
    WHERE 
        Tenant = @V_Tenant
        AND AccountId = @V_AccountId
        AND (
            IsReconciled = 1
            OR OpenAmountCurrencyId <> CurrencyId
            OR OpenAmount <> ForeignAmountDebit - ForeignAmountCredit
        )
        AND (
            ForeignAmountDebit != 0
            OR ForeignAmountCredit != 0
            OR LocalAmountDebit != 0
            OR LocalAmountCredit != 0
        );
END    

]]>
  </SqlScript>
  <OracleScript>
  </OracleScript>
</Procedure>
