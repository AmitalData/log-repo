<?xml version="1.0" encoding="utf-8"?>
<Procedure  
  DBType="Main" Name="QueryReports.usp_OpenTransaction" Schema="dbo" Module="Accounting">
  
  <SqlScript>
    <![CDATA[
create procedure QueryReports.usp_OpenTransaction 
@tenant int
as
begin
;with curr as (select * from  Currencies where Tenant=@tenant  )
,cards_wf as (select c.PaymentTermId,c.GLAccountId,u.LocalName as ULocalName,pt.LocalName as PLocalName, cs_wf.CreditLimitAmount as CreditLimit, c.InActive as Blocked 
from cards c
left join Contacts u on c.CollectorId=u.Id and u.Tenant=@tenant
left join PaymentTerms pt on pt.id=c.PaymentTermId and pt.Tenant=@tenant    
left join Customers cs_wf on cs_wf.id=c.id
where c.Tenant=@tenant)

,multi as (select * from GLAccountCurrencies where Tenant=@tenant )
,more as (select * from GLAccountMoreDatas where Tenant=@tenant )
select
@tenant as 'טננט'
,'שם לקוח'=ga.LocalName

,'מספר לקוח'=ga.DisplayNumber


,'מספר חשבונית'=lg.Reference1

,'סכום זכות בש"ח'=lg.LocalAmountCredit
,'סכום חובה בש"ח'=lg.LocalAmountDebit

,'סכום זכות במט"ח'=lg.ForeignAmountCredit
,'סכום חובה במט"ח'=lg.ForeignAmountDebit

,'מטבע חיוב'=curr.Code

,'תאריך חשבונית'=lg.AccountingDate

,'תאריך פרעון'=lg.DueDate
,'סכום פתוח'=lg.OpenAmount
,'סוג התאמה '=case when ga.ReconcileMethodCode=0 then N'ש"ח' else N'מט"ז' end
,'שער ממוצע'=case when ga.ReconcileMethodCode=0 or more.BalanceInForeignCurrency=0 then 1 else cast(more.BalanceInLocalCurrency/more.BalanceInForeignCurrency as numeric(15,2)) end

,'סכום פתוח בש"ח'=case when ga.ReconcileMethodCode=0 or more.BalanceInForeignCurrency=0 then lg.OpenAmount else cast((more.BalanceInLocalCurrency/more.BalanceInForeignCurrency)*lg.OpenAmount  as numeric(15,2)) end
,'יתרה בש"ח להיום'=more.BalanceInLocalCurrency
,'יתרה במט"ז להיום'=more.BalanceInForeignCurrency
,'תנאי תשלום'=
isnull((select top 1 PLocalName from cards_wf inner join multi on multi.glaccountid=ga.id and cards_wf.GLAccountId=multi.mainglaccountid where PLocalName is not null order by cards_wf.GLAccountId asc),
(select top 1 PLocalName from cards_wf where not exists(select 1 from multi where glaccountid=ga.id) and  GLAccountId=ga.Id and PLocalName is not null order by GLAccountId asc))
,'שם גובה'=isnull((select top 1 ULocalName from cards_wf inner join multi on multi.glaccountid=ga.id and cards_wf.GLAccountId=multi.mainglaccountid where ULocalName is not null order by cards_wf.GLAccountId asc),
(select top 1 ULocalName from cards_wf where not exists(select 1 from multi where glaccountid=ga.id) and  GLAccountId=ga.Id and ULocalName is not null order by GLAccountId asc))


,ga.id
,'קטגוריה 1'=(select englishname from category1 where tenant=@tenant and id=ga.Category1Id)
,'קטגוריה 2'=(select englishname from category2 where tenant=@tenant and id=ga.Category2Id)
,'קטגוריה 3'=(select englishname from category3 where tenant=@tenant and id=ga.Category3Id)
,'קטגוריה 4'=(select englishname from category4 where tenant=@tenant and id=ga.Category4Id)
,'קטגוריה 5'=(select englishname from category5 where tenant=@tenant and id=ga.Category5Id)
,'מסגרת אשראי'=isnull((select top 1 CreditLimit from cards_wf inner join multi on multi.glaccountid=ga.id and cards_wf.GLAccountId=multi.mainglaccountid where CreditLimit is not null and  cards_wf.Blocked=0 order by cards_wf.GLAccountId asc),
(select top 1 CreditLimit from cards_wf where not exists(select 1 from multi where glaccountid=ga.id) and  GLAccountId=ga.Id and ULocalName is not null order by GLAccountId asc))
from ledgertransactions lg inner join glaccounts ga on lg.accountid=ga.id and ga.tenant=@tenant and lg.tenant=@tenant
inner join curr on lg.CurrencyId=curr.id
left join more on lg.AccountId=more.AccountId

where 1=1
and lg.openamount<>0
and ga.ChartOfAccountsTypeCode=3

end

    
    ]]>
  </SqlScript>
  <OracleScript>
  </OracleScript>
</Procedure>