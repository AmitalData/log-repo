    <TextCode
      Code="&quot;ExternalReconciliation.O.CreateBankTransferInfo&quot;"
      DefaultText="&quot;Once you select one or more bank Page lines, this option allows you to create and reconcile a new AR Payment with the selected lines&quot;"
