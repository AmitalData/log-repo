  <AdditionalTextCodes>
    <TextCode
      Code="&quot;Reconciliation.O.CantReconcileCreditInvoiceOnly&quot;"
      DefaultText="&quot;You can't reconcile an AR Payment with a credit-invoice only, The credit invoice can be offset along with AR Invoice. and Then reconciled with the AR Payment&quot;"
      LocalDefaultText="&quot;לא ניתן להתאים קבלה עם חשבונית זיכוי בלבד, חשבונית הזיכוי יכולה להתקזז עם חשבונית חיוב ואז להיות מותאמת לקבלה&quot;"
      TextCodeTypeCode="&quot;O&quot;"
      IsSpellChecked="false" />
    <TextCode
      Code="&quot;Reconciliation.O.CantReconcileMutipleARPayment&quot;"
      DefaultText="&quot;Can’t include more than one AR payment in the same reconciliation&quot;"
      LocalDefaultText="&quot;לא ניתן לכלול יותר מקבלה אחת באותה התאמה&quot;"
      TextCodeTypeCode="&quot;O&quot;"
      IsSpellChecked="false" />
    <TextCode
      Code="&quot;Reconciliation.O.CantReconcileMutipleAPPayment&quot;"
      DefaultText="&quot;Can’t include more than one AP payment in the same reconciliation&quot;"
      LocalDefaultText="&quot;לא ניתן לכלול יותר מתשלום אחד באותה התאמה&quot;"
      TextCodeTypeCode="&quot;O&quot;"
      IsSpellChecked="false" />
    <TextCode
      Code="&quot;Reconciliation.O.AdditionalReconciliationsHasBeenCreated&quot;"
      DefaultText="&quot;Reconcile has been created, additional Reconciliations of the Transfer will be created in the background and can be found on the in the Reconcile Management screen at the end of the process&quot;"
      LocalDefaultText="&quot; התאמות נוצרו, התאמות נוספות לתנועות מחשבון הדחויים יווצרו ברקע וניתן יהיה לראותם במסך ניהול ההתאמות בסיום התהליך &quot;"
      TextCodeTypeCode="&quot;O&quot;"
      IsSpellChecked="false" />
    <TextCode
      Code="&quot;Reconciliation.O.DifferentAccounts&quot;"
      DefaultText="&quot;The reconciliation lines are from different accounts&quot;"
      LocalDefaultText="&quot;השורות בהתאמה מחשבונות שונים&quot;"
      TextCodeTypeCode="&quot;O&quot;"
      IsSpellChecked="false" />
    <TextCode
