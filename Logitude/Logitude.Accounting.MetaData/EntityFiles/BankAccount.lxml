    <TextCode
      Code="&quot;BankAccounts.O.PreventChangingToIsMultiCurrency&quot;"
      DefaultText="&quot;The GLAccount is connected to a Bank Account or CashBook , you can't change the currency to is multi&quot;"
      LocalDefaultTextBack_up="&quot;לא ניתן לשנות כרטיס זה לכרטיס רב מטבעי מכיוון שהוא מחובר לחשבון בנק/קופה&quot;"
      LocalDefaultText="&quot;BS64:Itec15Ag16DXmdeq158g15zXqdeg15XXqiDXm9eo15jXmdehINeW15Qg15zXm9eo15jXmdehINeo15Eg157XmNeR16LXmSDXnteb15nXldeV158g16nXlNeV15Ag157Xl9eV15HXqCDXnNeX16nXkdeV158g15HXoNenL9en15XXpNeUIg==&quot;"
