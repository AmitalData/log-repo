      LocalDefaultText="&quot;BS64:Itec15Ag16DXmdeq158g15zXqdeg15XXqiDXkNeqINee15jXkdeiINeU15vXqNeY15nXoSDXnteb15nXldeV158g16nXlNeV15Ag15vXkdeoINee15fXldeR16gg15zXl9ep15HXldefINeR16DXpyI=&quot;"
