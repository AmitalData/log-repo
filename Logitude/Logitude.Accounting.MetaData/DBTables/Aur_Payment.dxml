<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="Aur_Payments"
  Schema="dbo"
  DBType="Main"
  Module="Accounting">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DraftNumber"
    Type="varchar"
    Size="50">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ForMonth"
    Type="varchar"
    Size="12">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SaleOrder"
    Type="varchar"
    Size="50">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Customer"
    Type="varchar"
    Size="5">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CustomerReference1"
    Type="varchar"
    Size="5">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="InvoiceType"
    Type="nvarchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PaymentRequestStatus"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ErrorMessage"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CustomerReference2"
    Type="varchar"
    Size="5">
    <Constraints
      Nullable="true" />
  </Column>
</Table>