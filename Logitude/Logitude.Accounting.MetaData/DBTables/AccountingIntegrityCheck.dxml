<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="AccountingIntegrityChecks"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDateTimeUTC"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="StatusCode"
    Type="varchar"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ParametersXML"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ResultXML"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="HasException"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DoneDateTimeUTC"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
