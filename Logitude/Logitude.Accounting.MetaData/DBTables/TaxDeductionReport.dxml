<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="TaxDeductionReports"
  Schema="dbo"
  DBType="Main"
  Module="Accounting">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreatedByUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UpdateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UpdatedByUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ReportNumber"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="StatusTypeCode"
    Type="varchar"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsAdditionalReportExist"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="TaxYear"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Email"
    Type="varchar"
    Size="70">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ErrorMessage"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ByMonth"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Month"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="CreatedByUserId"
    ReferencedTable="Users"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="UpdatedByUserId"
    ReferencedTable="Users"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="StatusTypeCode"
    ReferencedTable="TaxDeductionReportStatuses"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
</Table>