<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="GLAccountMoreDatas"
  Schema="dbo"
  DBType="Main"
  Module="Accounting">
  <Column
    Name="AccountId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="BalanceInLocalCurrency"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LocalBalanceInDue"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="NextDueDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TotalOpenChequesInLocalCur"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TotFutureOpenChequesInLocalCur"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="BalanceInForeignCurrency"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ForeignBalanceInDue"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="AccountId"
    ReferencedTable="GLAccounts"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>