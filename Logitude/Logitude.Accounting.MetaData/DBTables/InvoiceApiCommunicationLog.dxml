<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="InvoiceApiCommunicationLogs"
  Schema="dbo"
  DBType="Main"
  Module="Accounting">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DocumentId"
    OldNames="CommunicationId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Step"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="StatusCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Exception"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ExternalID"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ARInvoiceId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="Step"
    ReferencedTable="InvoiceApiSteps"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="StatusCode"
    ReferencedTable="InvoiceApiStatuses"
    ReferencedColumn="StatusCode"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ARInvoiceId"
    ReferencedTable="ARInvoices"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>