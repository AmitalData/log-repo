<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="BankDepositLines"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="DepositId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Line"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ARPaymentChequeId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsOutOfDeposit"
    Type="bit">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="OutOfDepositeDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Notes"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="DepositId"
    ReferencedTable="BankDeposits"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ARPaymentChequeId"
    ReferencedTable="ARPaymentCheques"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>