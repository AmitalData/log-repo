<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="GLAccountCardsDatas"
  Schema="dbo"
  DBType="Main"
  Module="Accounting">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SalesmanUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CreditLimit"
    Type="float">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PaymentTermId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CollectorUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Phone"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="VatNumber"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TotalOpenShipments"
    Type="decimal"
    Precision="18"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="InsuredcreditLimit"
    Type="float">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="SalesmanUserId"
    ReferencedTable="Users"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="PaymentTermId"
    ReferencedTable="PaymentTerms"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="CollectorUserId"
    ReferencedTable="Users"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>