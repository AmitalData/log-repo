<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="MagayaSteps"
  Schema="dbo"
  DBType="Main"
  Module="Accounting">
  <Column
    Name="Code"
    Type="varchar"
    Size="3">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="EnglishName"
    Type="varchar"
    Size="60">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="60">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsAllowResend"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
</Table>