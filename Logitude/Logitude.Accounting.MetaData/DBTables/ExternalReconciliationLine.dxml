<?xml version="1.0" encoding="utf-8"?>
<Table Name="ExternalReconciliationLines" Schema="dbo" DBType="Main">
  <Column Name="ReconciliationId" Type="varchar" Size="15">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="Line" Type="int">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="LedgerTransactionId" Type="varchar" Size="15">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="GroupNumber" Type="int">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="ExternalPageLineId" Type="varchar" Size="15">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Tenant" Type="int">
    <Constraints Nullable="false" />
  </Column>
  <Relation ForeignKeyColumn="ReconciliationId" ReferencedTable="ExternalReconciliations" ReferencedColumn="Id" ReferencedTableSchema="dbo" />
  <Relation ForeignKeyColumn="LedgerTransactionId" ReferencedTable="LedgerTransactions" ReferencedColumn="Id" ReferencedTableSchema="dbo" />
  <Relation ForeignKeyColumn="ExternalPageLineId" ReferencedTable="ReconcileExternalPageLines" ReferencedColumn="Id" ReferencedTableSchema="dbo" />
</Table>