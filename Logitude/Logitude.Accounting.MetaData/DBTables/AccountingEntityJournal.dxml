<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="AccountingEntitiesJournals"
  Schema="dbo"
  DBType="Main"
  Module="Accounting">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="AccountingEntityId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="AccountingEntityCode"
    Type="varchar"
    Size="5">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Action"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ChildEntityId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
<UniqueConstraint
   Columns="Tenant,AccountingEntityId,AccountingEntityCode,ChildEntityId,Action" />
</Table>