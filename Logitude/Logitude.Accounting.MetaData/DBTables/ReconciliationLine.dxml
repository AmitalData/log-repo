<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ReconciliationLines"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="ReconciliationId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Line"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CurrencyId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="TransactionId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ReconciliationAmount"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsPartial"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="GroupNumber"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsAdjustTransaction"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ReconciledWithTransactionId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="ReconciliationId"
    ReferencedTable="Reconciliations"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="CurrencyId"
    ReferencedTable="Currencies"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="TransactionId"
    ReferencedTable="LedgerTransactions"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>