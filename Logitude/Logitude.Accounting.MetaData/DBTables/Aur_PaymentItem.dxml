<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="Aur_PaymentItems"
  Schema="dbo"
  DBType="Main"
  Module="Accounting">
  <Column
    Name="PaymentId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Line"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="PaymentSequence"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="QuoteId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Project"
    Type="nvarchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ProjectNumber"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SectionType"
    Type="nvarchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="BaseAmount"
    Type="decimal"
    Precision="10"
    Scale="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="PaymentId"
    ReferencedTable="Aur_Payments"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>