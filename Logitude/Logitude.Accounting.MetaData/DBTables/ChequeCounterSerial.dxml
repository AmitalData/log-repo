<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ChequeCounterSerials"
  Schema="dbo"
  DBType="Main"
  Module="Accounting">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="BankAccountId"
    OldNames="BankId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SeriesId"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ChequeCounterBegin"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ChequeCounterEnd"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="BankAccountId"
    ReferencedTable="BankAccounts"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>