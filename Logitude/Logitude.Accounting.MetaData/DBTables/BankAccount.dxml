  <Column
    Name="PrintingBranchNumber"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PrintingAccountNumber"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
