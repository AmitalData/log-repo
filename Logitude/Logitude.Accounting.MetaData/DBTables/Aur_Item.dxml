<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="Aur_Items"
  Schema="dbo"
  DBType="Main"
  Module="Accounting">
  <Column
    Name="PaymentId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Line"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="SalesOrderid"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="RelatedContract"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ProductNumber"
    Type="nvarchar"
    Size="30">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ProductName"
    Type="nvarchar"
    Size="256">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PricePerUnit"
    Type="decimal"
    Precision="10"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Quantity"
    Type="decimal"
    Precision="10"
    Scale="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Discount"
    Type="decimal"
    Precision="10"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="BaseAmount"
    Type="decimal"
    Precision="10"
    Scale="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Tax"
    Type="decimal"
    Precision="5"
    Scale="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ExtendedAmount"
    Type="decimal"
    Precision="10"
    Scale="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
</Table>