    ReferencedTableSchema="dbo" />
  <Index
    Columns="Tenant,IsReconciled,AccountId,OpenAmountCurrencyId,OpenAmount,AccountingDate" />
  <Index
    Columns="Tenant,IsReconciled,AccountId,OpenAmountCurrencyId,OpenAmount,DueDate" />
