    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ForeignAmountDebit"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ForeignAmountCredit"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ExchangeRate"
    Type="decimal"
    Precision="16"
    Scale="5">
