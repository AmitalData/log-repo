    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ControlAccountId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AccountId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="AccountingDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
