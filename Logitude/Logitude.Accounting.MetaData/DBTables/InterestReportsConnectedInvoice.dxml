<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="InterestReportsConnectInvoices"
  Schema="dbo"
  DBType="Main"
  Module="Accounting">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ReportId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="InvoiceId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <UniqueConstraint
  Columns="ReportId" />
</Table>