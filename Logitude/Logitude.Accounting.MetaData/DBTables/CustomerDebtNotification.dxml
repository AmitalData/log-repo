<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CustomerDebtNotifications"
  Schema="dbo"
  DBType="Main"
  Module="Accounting">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="InActive"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TypesDebts"
    Type="varchar"
    Size="10">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DebtLevel"
    Type="nvarchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DebtLevelAmount"
    Type="decimal"
    Precision="6"
    Scale="3">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="TasksSchedulerId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PaymentNotes"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AccountId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="TasksSchedulerId"
    ReferencedTable="TasksScheduler"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>