<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ARPaymentsJournals"
  Schema="dbo"
  DBType="Main"
  Module="Accounting">
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="PaymentId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="IsVoided"
    Type="bit">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="PaymentId"
    ReferencedTable="ARPayments"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>