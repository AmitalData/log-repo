<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="AccountingPeriods"
  Schema="dbo"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Year"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="PeriodTypeCode"
    Type="varchar"
    Size="1">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="OpenMonth"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ClosedMonth"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="PeriodTypeCode"
    ReferencedTable="PeriodTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
</Table>