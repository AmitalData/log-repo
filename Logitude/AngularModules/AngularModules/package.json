{
    "name": "angularmodules",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "test": "ng test",
        "lint": "ng lint",
        "e2e": "ng e2e",
        "start2": "node --max_old_space_size=4000 node_modules/@angular/cli/bin/ng serve --port 3000",
        "start": "node --max_old_space_size=8000 node_modules/@angular/cli/bin/ng serve",
        "build": "node --max_old_space_size=4000 node_modules/@angular/cli/bin/ng build --show-circular-dependencies=false",
        "start-aot": "node --max_old_space_size=9000 node_modules/@angular/cli/bin/ng serve --prod --aot --optimization=false",
        "buildAOT": "node --max_old_space_size=15000 node_modules/@angular/cli/bin/ng build --prod --aot --optimization=true --show-circular-dependencies=false",
        "do-e2e": "protractor e2e/protractor.conf.js",
        "start-e2e": "node --max_old_space_size=4000 node_modules/@angular/cli/bin/ng e2e",
        "cypressRun": "cypress run",
        "runtests": "npm run cypressRun",
        "cypressopen": "node_modules\\.bin\\cypress open",
        "clean:reports": "rm -R -f cypress/reports && mkdir cypress/reports && mkdir cypress/reports/mochareports",
        "pretest": "npm run clean:reports",
        "scripts": "cypress run",
        "combine-reports": "mochawesome-mergecypress/reports/mocha/*.json > cypress/reports/mochareports/report.json",
        "generate-report": "marge cypress/reports/mochareports/report.json -f report -o cypress/reports/mochareports",
        "posttest": "npm run combine-reports && npm run generate-report",
        "RunE2E": "npm run scripts || npm run posttest",
        "cypress:report": "generate-mochawesome-report",
        "report": "run-s report:*",
        "report:merge": "mochawesome-merge --reportDir cypress/results/json > cypress/results/mochawesome-bundle.json",
        "report:generate": "marge cypress/results/mochawesome-bundle.json -o cypress/reports/html",
        "report:copyScreenshots": "cp -r cypress/screenshots cypress/results/html/screenshots",
        "test:jest": "jest --runInBand",
        "test:jest:shipment": "jest ShipmentModules/ShipmentSharedManifest/__tests__ --runInBand --coverage --coverageDirectory=coverage-jest/shipment"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^9.1.13",
        "@angular/cdk": "^9.2.4",
        "@angular/common": "~9.1.1",
        "@angular/compiler": "~9.1.1",
        "@angular/core": "~9.1.1",
        "@angular/forms": "~9.1.1",
        "@angular/platform-browser": "~9.1.1",
        "@angular/platform-browser-dynamic": "~9.1.1",
        "@angular/router": "~9.1.1",
        "@azure/msal-angular": "^2.5.4",
        "@azure/msal-browser": "^2.34.0",
        "@microsoft/applicationinsights-angularplugin-js": "^2.6.2",
        "@microsoft/applicationinsights-web": "^2.8.18",
        "@types/mocha": "^7.0.2",
        "ag-grid-angular": "^20.0.0",
        "ag-grid-community": "^20.0.0",
        "ag-grid-enterprise": "^20.0.0",
        "angular-fusioncharts": "3.0.4",
        "angular-mentions": "^1.4.0",
        "collaboration-tool-components": "^1.4.37",
        "collaboration-tool-core": "^11.4.40",
        "collaboration-tool-tasks-list": "^11.2.26",
        "console": "^0.7.2",
        "fast-json-patch": "^3.1.1",
        "file-saver": "^2.0.5",
        "fusioncharts": "^3.19.0",
        "lodash.clonedeep": "^4.5.0",
        "logitude-dashboard-library": "^3.1.121",
        "logitude-workflow": "^3.1.70",
        "mochawesome-report-generator": "^5.1.0",
        "ng-zorro-antd": "^9.3.0",
        "ng2-pdf-viewer": "^7.0.2",
        "ngx-monaco-editor": "^9.0.0",
        "object-path": "^0.11.8",
        "pretty-print-json": "^1.3.1",
        "primeflex": "^3.0.1",
        "primeicons": "^4.1.0",
        "primeng": "10.0.3",
        "primereact": "^8.3.0",
        "quill": "^1.3.7",
        "react": "^17.0.2",
        "react-dom": "^17.0.2",
        "react-draggable": "4.4.5",
        "rxjs": "~6.5.4",
        "safe-clone-deep": "^1.1.5",
        "selenium-webdriver": "^4.0.0-alpha.5",
        "stream": "0.0.2",
        "timers": "^0.1.1",
        "tslib": "^2.8.1",
        "webdriver-manager": "^12.1.6",
        "xlsx": "^0.18.5",
        "xml-js": "^1.6.11",
        "zone.js": "^0.11.1"
    },
    "devDependencies": {
        "@angular-builders/custom-webpack": "^9.1.0",
        "@angular-devkit/build-angular": "^0.901.1",
        "@angular/cli": "~9.1.1",
        "@angular/compiler-cli": "~9.1.1",
        "@angular/language-service": "~9.1.1",
        "@types/jasmine": "~3.5.0",
        "@types/jasminewd2": "~2.0.3",
        "@types/node": "^12.20.55",
        "@types/react": "^17.0.11",
        "@types/react-dom": "^17.0.7",
        "codelyzer": "^5.1.2",
        "cypress": "4.12.1",
        "cypress-file-upload": "^4.1.1",
        "cypress-localstorage-commands": "^1.2.1",
        "cypress-mochawesome-reporter": "^1.0.1",
        "cypress-multi-reporters": "^1.4.0",
        "@types/jest": "^27.5.2",
        "jest": "^27.5.1",
        "jest-preset-angular": "^11.1.2",
        "ts-jest": "^27.1.5",
        "jasmine-core": "~3.5.0",
        "jasmine-reporters": "^2.0.0",
        "jasmine-spec-reporter": "~4.2.1",
        "karma": "~4.4.1",
        "karma-chrome-launcher": "~3.1.0",
        "karma-coverage-istanbul-reporter": "~2.1.0",
        "karma-jasmine": "~3.0.1",
        "karma-jasmine-html-reporter": "^1.4.2",
        "mocha": "^8.0.1",
        "mocha-junit-reporter": "^2.0.0",
        "mochawesome": "^6.1.1",
        "mochawesome-merge": "^4.1.0",
        "protractor": "^5.4.4",
        "protractor-beautiful-reporter": "^1.3.6",
        "ts-node": "~8.3.0",
        "tslint": "~6.1.0",
        "typescript": "3.8.3"
    }
}
