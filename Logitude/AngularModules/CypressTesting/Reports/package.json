{
  "scripts": {
    "clean-reports": "if exist cypress\\Reports rmdir /s /q cypress\\Reports",
    "report:merge": "npx mochawesome-merge --reportDir ./mochawesome-report > cypress/Reports/mochawesome-bundle.json",
    "report:generate": "marge cypress/Reports/mochawesome-bundle.json -o cypress/Reports/html",
    "report:copyReport": "move ./cypress/Reports/html/cypress/Reports/mochawesome-bundle.html ./cypress/Reports/html",
    "report:copyScreenshots": "cp -r cypress/Reports/screenshots cypress/Reports/html/screenshots"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": true,
    "step_definitions": "cypress/tests/"
  },
  "devDependencies": {
    "cucumber": "^7.0.0-rc.0",
    "cypress": "^6.9.1",
    "cypress-cucumber-preprocessor": "^4.0.0",
    "cypress-file-upload": "^5.0.2",
    "cypress-log-to-output": "^1.1.2",
    "cypress-mochawesome-reporter": "^1.0.1",
    "cypress-multi-reporters": "^1.4.0",
    "cypress-terminal-report": "^2.4.0",
    "mocha": "^8.2.1",
    "mochawesome": "^4.1.0",
    "mochawesome-merge": "^4.2.0",
    "mochawesome-report-generator": "4.0.1",
    "node-xlsx": "^0.16.1",
    "typescript": "^4.1.4"
  }
}
