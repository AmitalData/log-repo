<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="BasicHttpBinding_ILoginWcfService"/>
                <binding name="BasicHttpBinding_IDepartmentWcfService"/>
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://localhost:9996/WcfApi/LoginWcfService.svc" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ILoginWcfService" contract="LoginServiceReference.ILoginWcfService" name="BasicHttpBinding_ILoginWcfService"/>
            <endpoint address="http://localhost:9996/WcfApi/DepartmentWcfService.svc" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IDepartmentWcfService" contract="DepartmentServiceReference.IDepartmentWcfService" name="BasicHttpBinding_IDepartmentWcfService"/>
        </client>
    </system.serviceModel>

  <appSettings configSource="Config\test.appSettings.config">
    
  </appSettings>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1"/></startup></configuration>
