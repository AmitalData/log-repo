<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="BasicHttpBinding_IBranchWcfService" />
                <binding name="BasicHttpBinding_IAirlineWcfService" />
                <binding name="BasicHttpBinding_IGlobalZoneWcfService" />
                <binding name="BasicHttpBinding_ICountryWcfService" />
                <binding name="BasicHttpBinding_ICityWcfService" />
                <binding name="BasicHttpBinding_IAgentWcfService" />
                <binding name="BasicHttpBinding_ICustomAgentWcfService" />
                <binding name="BasicHttpBinding_IDepartmentWcfService" />
                <binding name="BasicHttpBinding_ILoginWcfService" />
                <binding name="BasicHttpBinding_ICustomerWcfService" />
                <binding name="BasicHttpBinding_IAccountingPartnerWcfService" />
                <binding name="BasicHttpBinding_IShippingLineWcfService" />
                <binding name="BasicHttpBinding_IVendorWcfService" />
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://localhost:9996/WcfApi/BranchWcfService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IBranchWcfService"
                contract="BranchServiceReference.IBranchWcfService" name="BasicHttpBinding_IBranchWcfService" />
            <endpoint address="http://localhost:9996/WcfApi/AirlineWcfService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IAirlineWcfService"
                contract="AirlineServiceReference.IAirlineWcfService" name="BasicHttpBinding_IAirlineWcfService" />
            <endpoint address="http://localhost:9996/WcfApi/GlobalZoneWcfService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IGlobalZoneWcfService"
                contract="GlobalZoneServiceReference.IGlobalZoneWcfService"
                name="BasicHttpBinding_IGlobalZoneWcfService" />
            <endpoint address="http://localhost:9996/WcfApi/CountryWcfService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ICountryWcfService"
                contract="CountryServiceReference.ICountryWcfService" name="BasicHttpBinding_ICountryWcfService" />
            <endpoint address="http://localhost:9996/WcfApi/CityWcfService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ICityWcfService"
                contract="CityServiceReference.ICityWcfService" name="BasicHttpBinding_ICityWcfService" />
            <endpoint address="http://localhost:9996/WcfApi/AgentWcfService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IAgentWcfService"
                contract="AgentServiceReference.IAgentWcfService" name="BasicHttpBinding_IAgentWcfService" />
            <endpoint address="http://localhost:9996/WcfApi/CustomAgentWcfService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ICustomAgentWcfService"
                contract="CustomAgentServiceReference.ICustomAgentWcfService"
                name="BasicHttpBinding_ICustomAgentWcfService" />
            <endpoint address="http://localhost:9996/WcfApi/DepartmentWcfService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IDepartmentWcfService"
                contract="DepartmentServiceReference.IDepartmentWcfService"
                name="BasicHttpBinding_IDepartmentWcfService" />
            <endpoint address="http://localhost:9996/WcfApi/LoginWcfService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ILoginWcfService"
                contract="LoginServiceReference.ILoginWcfService" name="BasicHttpBinding_ILoginWcfService" />
            <endpoint address="http://localhost:9996/WcfApi/CustomerWcfService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ICustomerWcfService"
                contract="CustomerServiceReference.ICustomerWcfService" name="BasicHttpBinding_ICustomerWcfService" />
            <endpoint address="http://localhost:9996/WcfApi/AccountingPartnerWcfService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IAccountingPartnerWcfService"
                contract="AccountingPartnerServiceReference.IAccountingPartnerWcfService"
                name="BasicHttpBinding_IAccountingPartnerWcfService" />
            <endpoint address="http://localhost:9996/WcfApi/ShippingLineWcfService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IShippingLineWcfService"
                contract="ShippingLineServiceReference.IShippingLineWcfService"
                name="BasicHttpBinding_IShippingLineWcfService" />
            <endpoint address="http://localhost:9996/WcfApi/VendorWcfService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IVendorWcfService"
                contract="VendorServiceReference.IVendorWcfService" name="BasicHttpBinding_IVendorWcfService" />
        </client>
    </system.serviceModel>

  <appSettings configSource="Config\test.appSettings.config">
    
  </appSettings>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1"/></startup></configuration>
