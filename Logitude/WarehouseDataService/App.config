<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <appSettings>
    <add key="UpdateWarehouseSleepTime" value="1" />
    <add key="WarehouseBuildDays" value="3" />
    <add key="WarehouseBuildHoures" value="12:00 AM" />
    <add key="RetryBuildWithinHours" value="5" />
    <add key="RunDataWarehouseImmediately" value="False" />
    <!--<add key="SourceConnection" value="LogitudeGlobal-Test2,sa,Saas256,logitudetestdb.westeurope.cloudapp.azure.com" />
    <add key="DestinationConnection" value="DWShared,sa,Saas256,logitudetestdb.westeurope.cloudapp.azure.com" />-->
    <add key="SourceConnection" value="2022R4_Global,sa,Saas256,." />
    <add key="DestinationConnection" value="2022R4_Global,sa,Saas256,." />
    <!-- <add key="SourceConnection" value="Logitude,logitudemanager,!LO852456,ebup282itq.database.windows.net" />
    <add key="DestinationConnection" value="logitudedw-shared,logitudeep,!LO852456,logitude-ep.database.windows.net" />-->
    <!-- <add key="SourceConnection" value="Logitude2-5_Global,sa,Saas256,." />
    <add key="DestinationConnection" value="Logitude2-5_Global,sa,Saas256,." />-->
    <!--  <add name="Globalstr" connectionString="Logitude2-5_Global,sa,Saas256,." />
    <add name="SystemLogsStr" connectionString="Logitude2-5_SystemLogs,sa,Saas256,." />-->
    <!-- <add key="SourceConnection" value="2019R2_Global,sa,Saas256,." />
    <add key="DestinationConnection" value="2019R2_Global,sa,Saas256,." /> -->
    <!-- <add name="Globalstr" connectionString="LogitudeGlobal,logitudemanager,!LO852456,ebup282itq.database.windows.net" />-->
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="mssqllocaldb" />
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>