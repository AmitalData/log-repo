<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<targets>
		<!--<target name="logfile" xsi:type="File" fileName="log.txt" />
		<target name="customfile" xsi:type="File" fileName="C:\CustomsBook\Logs\customsBookLog.txt" />-->

		<target name="customfile" xsi:type="File" fileName="C:\CustomsBook\Logs\customsBookLog.txt" layout="${longdate} ${message}" />

    <target name="logconsole" xsi:type="ColoredConsole" useDefaultRowHighlightingRules="false"
			 layout="${longdate} | ${level:uppercase=true:padding=5} | ${callsite:padding=5} | ${message} ${onexception: | EX\:${exception:format=tostring,message,method:maxInnerExceptionLevel=5:innerFormat=shortType,message,method}}">
      <highlight-row condition="level == LogLevel.Debug" foregroundColor="DarkGray"/>
      <highlight-row condition="level == LogLevel.Info" foregroundColor="Gray"  />
      <highlight-row condition="level == LogLevel.Warn" foregroundColor="Yellow"/>
      <highlight-row condition="level == LogLevel.Error" foregroundColor="Black"  backgroundColor="Gray"/>
      <highlight-row condition="level == LogLevel.Fatal" foregroundColor="Black" backgroundColor="Yellow" />
    </target>

	</targets>

	<rules>
    <logger name="CustomsBook.*" minlevel="Debug" writeTo="customfile" />
    <logger name="*" minlevel="Debug" writeTo="logconsole" />
		<!--<logger name="*" minlevel="Info" writeTo="logfile" />-->
	</rules>
</nlog>