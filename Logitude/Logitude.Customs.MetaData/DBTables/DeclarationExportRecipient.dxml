<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="DeclarationExportRecipients"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="DeclarationId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LineNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="RecipientName"
    Type="varchar"
    Size="35">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="RecipientAddress"
    Type="varchar"
    Size="35">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="RecipientIssueCountryCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="DeclarationId"
    ReferencedTable="Declarations"
    ReferencedColumn="Id"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="RecipientIssueCountryCode"
    ReferencedTable="CustomsCountries"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>