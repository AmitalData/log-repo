<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="PropertiesDetailsHistorys"
  Schema="Customs"
  DBType="Main">
  <Column
    Name="CustomsItemID"
    Type="varchar"
    Size="9">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ID"
    Type="varchar"
    Size="9">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="StartDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EndDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EntityStatusID"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="MeasurementUnitID"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="CustomsItemID"
    ReferencedTable="CustomsItems"
    ReferencedColumn="ID"
    ReferencedTableSchema="Customs" />
</Table>