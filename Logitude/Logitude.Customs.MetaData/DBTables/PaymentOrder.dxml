<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="PaymentOrders"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="PaymentNumber"
    Type="varchar"
    Size="9">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TotalSumToPay"
    Type="decimal"
    Precision="18"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LastPayDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Reason"
    Type="nvarchar"
    Size="512">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CustomerId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CustomerActivityTypeCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PaymentOrderTypeCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PaymentProcessCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PaymentStatusCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CustomsHouseCode"
    Type="varchar"
    Size="17">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ActualPayDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="InternalNotes"
    Type="nvarchar"
    Size="512">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="UpdateDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="2000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CustomsEntityTypeCode"
    Type="varchar"
    Size="9">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FirstEntityID"
    Type="varchar"
    Size="35">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SecondEntityID"
    Type="varchar"
    Size="35">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ThirdEntityID"
    Type="varchar"
    Size="35">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ImporterId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsClosed"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ConcurrencyGUID"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AccountingCustomFile"
    Type="varchar"
    Size="30">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CustomFiles"
    Type="varchar"
    Size="30">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
