<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SeizureMethodTypes"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Code"
    Type="varchar"
    Size="2">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="50">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="EnglishName"
    Type="varchar"
    Size="50">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Inactive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
</Table>