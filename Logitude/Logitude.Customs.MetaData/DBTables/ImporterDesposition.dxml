<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ImporterDespositions"
  Schema="Customs"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="DepositionNumber"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ImporterDepositionStatusCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ImporterlId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="VendorID"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="StartDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="EndDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="NotesToAgent"
    Type="nvarchar"
    Size="256">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ErrorMessage"
    Type="varchar"
    Size="512">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="ImporterDepositionStatusCode"
    ReferencedTable="ImporterPeriodicDeclarStatuses"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="ImporterlId"
    ReferencedTable="Clients"
    ReferencedColumn="Id"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="VendorID"
    ReferencedTable="CustomsVendors"
    ReferencedColumn="Id"
    ReferencedTableSchema="Customs" />
</Table>