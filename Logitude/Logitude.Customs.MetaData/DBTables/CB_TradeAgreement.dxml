<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CB_TradeAgreements"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="ID"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UpdateDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Title"
    Type="nvarchar"
    Size="255">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AdditionName"
    Type="nvarchar"
    Size="255">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CountryGroupID"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CustomsBookTypeID"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="EntityStatusID"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
