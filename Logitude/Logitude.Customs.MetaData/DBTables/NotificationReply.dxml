<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="NotificationReplies"
  Schema="Customs"
  DBType="Main">
  <Column
    Name="NotificationId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Line"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ResponseToCustoms"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="RepliedByUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ReplyDateTime"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="NotificationId"
    ReferencedTable="Notifications"
    ReferencedColumn="Id"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="RepliedByUserId"
    ReferencedTable="Users"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>