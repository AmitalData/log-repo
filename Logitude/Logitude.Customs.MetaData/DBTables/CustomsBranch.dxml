<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CustomsBranches"
  Schema="Customs"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="6">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Code"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="EnglishName"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Inactive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="BankCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="BankCode"
    ReferencedTable="Banks"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>