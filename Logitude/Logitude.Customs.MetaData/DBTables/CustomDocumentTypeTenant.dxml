<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CustomDocumentTypeTenants"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UpdateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UpdatedByUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PointerLevel"
    Type="varchar"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AutoSetOriginalDocumentTrue"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsCourierManadatory"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsDiamondManadatory"
