<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SubCountries"
  Schema="Customs"
  DBType="Main">
  <Column
    Name="Code"
    Type="varchar"
    Size="6">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LocalName"
    Type="varchar"
    Size="60">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="EnglishName"
    Type="varchar"
    Size="60">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CountryCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Inactive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="CountryCode"
    ReferencedTable="CustomsCountries"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>