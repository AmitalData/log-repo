<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="OcrDocuments"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Id"
    Type="varchar"
    Size="40">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Process"
    Type="varchar"
    Size="5">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="JsonData"
    Type="varchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Score"
    Type="varchar"
    Size="10">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="JsonTif"
    Type="varchar"
    Size="500">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ErrorMsg"
    Type="varchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="StatusCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="Id"
    ReferencedTable="DocumentsFilings"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="StatusCode"
    ReferencedTable="OcrStatuses"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>