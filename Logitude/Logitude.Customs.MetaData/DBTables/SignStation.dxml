<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SignStations"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="CustomsAgentId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="PersonId"
    Type="varchar"
    Size="15"> 
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="SignCertificate"
    Type="varchar"
    Size="512">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UserName"
    OldNames="MachineUser"
    Type="varchar"
    Size="32">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="MachineName"
    Type="varchar"
    Size="32">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsPersonalSignOn"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsCompanySignOn"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Status"
    Type="varchar"
    Size="32">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="VersionByFeatures"
    Type="varchar"
    Size="32">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LastAccessedAt"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
</Table>