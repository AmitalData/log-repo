<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SupplierInvoicePayments"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="DeclarationId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="InvoiceCounterKey"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SequenceNumeric"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="PaymentTypeCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="PaymentAmount"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="DeclarationId,InvoiceCounterKey"
    ReferencedTable="SupplierInvoices"
    ReferencedColumn="DeclarationId,InvoiceCounterKey"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="PaymentTypeCode"
    ReferencedTable="PaymentTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>