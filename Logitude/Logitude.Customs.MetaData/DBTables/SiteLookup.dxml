<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SiteLookups"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Code"
    Type="varchar"
    Size="17">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="SiteTypeCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="EnglishName"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Inactive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="SiteTypeCode"
    ReferencedTable="SiteTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>