<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="InterfaceTenantDefinitions"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Code"
    Type="varchar"
    Size="32">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TenantSendOptionsCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TenantPriority"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Active"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DcaRenameFileEnable"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DcaRenameFilePrefix"
    Type="varchar"
    Size="256">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="QueueType"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="UseRabbitMQ"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="QueueGroupCode"
    Type="varchar"
    Size="24">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SendTime"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsCustomsFile"
    Type="bit">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsUnifreight"
    Type="bit">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="Code"
    ReferencedTable="InterfaceManagements"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="TenantSendOptionsCode"
    ReferencedTable="InterfaceSendOptions"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>