<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ClientDrivingLicenses"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="ClientId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Line"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DrivingLicenseNumber"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DriverLicenseValidityDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DrivingLicenseCountryID"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="ClientId"
    ReferencedTable="Clients"
    ReferencedColumn="Id"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="DrivingLicenseCountryID"
    ReferencedTable="CustomsCountries"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>