<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ClaimsRelatedEntitiesAmounts"
  Schema="Customs"
  DBType="Main">
  <Column
    Name="ClaimId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="CounterKey"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LineNo"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="PaymentTypeCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Amount"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
