<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="GatepassRequests"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="MasterCourierId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="GatepassNumber"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="OriginSiteCode"
    Type="varchar"
    Size="17">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="UpdateCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DesignateSiteCode"
    Type="varchar"
    Size="17">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TransportationTypeCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="GatepassRequestStatus"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CustomsUpdateDateTime"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="DeclarationId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="OriginSiteCode"
    ReferencedTable="SiteLookups"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="UpdateCode"
    ReferencedTable="UpdateCodes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="DesignateSiteCode"
    ReferencedTable="SiteLookups"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="TransportationTypeCode"
    ReferencedTable="TransferCargoMethodTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="DeclarationId"
    ReferencedTable="Declarations"
    ReferencedColumn="Id"
    ReferencedTableSchema="Customs" />
</Table>