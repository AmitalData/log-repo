<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ConsignmentPackages"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="DeclarationId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="ConsignmentNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LineNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="PackageMeasureQualifierCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PackageQuantity"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="GrossMassMeasure"
    Type="decimal"
    Precision="18"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PackageTypeCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="MarksNumbers"
    Type="varchar"
    Size="512">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SequenceNumeric"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PackageQuantityTypeCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="GrossMassMeasureTypeCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="DeclarationId,ConsignmentNumber"
    ReferencedTable="Consignments"
    ReferencedColumn="DeclarationId,ConsignmentNumber"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="PackageMeasureQualifierCode"
    ReferencedTable="PackageMeasureQualifiers"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="PackageTypeCode"
    ReferencedTable="PackingTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="PackageQuantityTypeCode"
    ReferencedTable="MeasurmentUnits"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="GrossMassMeasureTypeCode"
    ReferencedTable="MeasurmentUnits"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>