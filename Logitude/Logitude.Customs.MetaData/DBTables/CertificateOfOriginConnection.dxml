<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CertificateOfOriginConnections"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CooStatus"
    OldNames="CooStatusCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CooReason"
    OldNames="CooReasonCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Active"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="CooStatus"
    ReferencedTable="CertificateOfOriginStatusCodeEnums"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="CooReason"
    ReferencedTable="RequestReasonCodeEnums"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>