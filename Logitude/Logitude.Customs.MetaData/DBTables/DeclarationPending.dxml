<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="DeclarationPendings"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DeclarationID"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="CourierPendingReasonCode"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="PendingRemarks"
    Type="nvarchar"
    Size="1024">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Status"
    Type="nvarchar"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="DeclarationID"
    ReferencedTable="DeclarationCourierStatuses"
    ReferencedColumn="DeclarationId"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="CourierPendingReasonCode"
    ReferencedTable="CourierPendingReasons"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>