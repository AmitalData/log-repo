<?xml version="1.0" encoding="utf-8"?>
<Table Name="DepositConditions" Schema="Customs" DBType="Main">
  <Column Name="DepositId" Type="varchar" Size="15">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="DepositConditionCode" Type="varchar" Size="2">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="Tenant" Type="int">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="DepositAmount" Type="decimal" Precision="16" Scale="2">
    <Constraints Nullable="true" />
  </Column>
  <Relation ForeignKeyColumn="DepositId" ReferencedTable="Deposits" ReferencedColumn="Id" ReferencedTableSchema="Customs" />
  <Relation ForeignKeyColumn="DepositConditionCode" ReferencedTable="ReturnConditions" ReferencedColumn="Code" ReferencedTableSchema="Customs" />
</Table>