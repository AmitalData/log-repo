<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="DeclarationReferantDatas"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="DeclarationId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="OrderNumber"
    Type="varchar"
    Size="30">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="VendorId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ArrivalDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="EstimatedArrivalDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Weight"
    Type="decimal"
    Precision="15"
    Scale="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ClassificationStatus"
    Type="varchar"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ControllerStatus"
    Type="varchar"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CollectionOfMoneyStatus"
    Type="varchar"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FollowUpDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="WithPaper"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsClosedForFollowUp"
    Type="varchar"
    Size="1"
    DefaultValue="'0'">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsClassificationRemarks"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsControllerRemarks"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="PreClassification"
    Type="varchar"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ExceptionReasonsList"
    Type="varchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ClassifiedUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ControllerUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CollectorUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="NewFile"
    Type="bit"
    DefaultValue="'1'">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Favorite"
    Type="bit"
    DefaultValue="'0'">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LastStatusName"
    Type="nvarchar"
    Size="30">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LastStatusDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="OrderMoney"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Team"
    Type="nvarchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ImporterFile"
    Type="varchar"
    Size="30">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FileOpenDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="VendorId"
    ReferencedTable="CustomsVendors"
    ReferencedColumn="Id"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="ClassifiedUserId"
    ReferencedTable="Users"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ControllerUserId"
    ReferencedTable="Users"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="CollectorUserId"
    ReferencedTable="Users"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="Team"
    ReferencedTable="ReferantTeams"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  
  <Index  Columns="IsClosedForFollowUp" />

  
  <Index  Columns="FollowUpDate" />

  <Index
     Columns="NewFile" />
  
<Index
     Columns="Favorite" />
  <Index
    Columns="NewFile,Favorite" />
</Table>