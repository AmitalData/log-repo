<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SupplierInvoiceModifications"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="DeclarationId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="InvoiceCounterKey"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="TypeCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CurrencyTypeCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Amount"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ModificationCounterKey"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="DeclarationId,InvoiceCounterKey"
    ReferencedTable="SupplierInvoices"
    ReferencedColumn="DeclarationId,InvoiceCounterKey"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="TypeCode"
    ReferencedTable="ModificationAndDiscountTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="CurrencyTypeCode"
    ReferencedTable="CurrencyTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>