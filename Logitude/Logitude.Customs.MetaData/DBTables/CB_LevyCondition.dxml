<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CB_LevyConditions"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="ID"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LevyConditionNumber"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LevyGoodsDescription"
    Type="varchar"
    Size="512">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CustomsItemID"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="VendorID"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CountryGroupID"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsCountriesGroup"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CountryID"
    Type="varchar"
    Size="6">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TradeLevyID"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="StartDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EndDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="CustomsItemID"
    ReferencedTable="CB_CustomsItems"
    ReferencedColumn="ID"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="VendorID"
    ReferencedTable="CB_Vendors"
    ReferencedColumn="ID"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="CountryGroupID"
    ReferencedTable="CountryGroups"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="TradeLevyID"
    ReferencedTable="CB_TradeLevys"
    ReferencedColumn="ID"
    ReferencedTableSchema="Customs" />
</Table>