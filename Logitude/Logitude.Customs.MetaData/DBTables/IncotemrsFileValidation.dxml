<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="IncotemrsFileValidations"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Code"
    Type="varchar"
    Size="2">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="EnglishName"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Inactive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="TermsOfSaleTypeID"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsFreightCharge"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsPortIsraelCharge"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsInsurance"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CargoIdentifierTypeID"
    Type="varchar"
    Size="5">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CargoIdentifierTypeName"
    Type="nvarchar"
    Size="50">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LeadDocumentTypeID"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LeadDocumentTypeName"
    Type="nvarchar"
    Size="50">
    <Constraints
      Nullable="true" />
  </Column>
</Table>