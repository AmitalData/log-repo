<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ExportStorages"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DeclarationId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ExportFileNo"
    Type="nvarchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="StorageNo"
    Type="nvarchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="StorageStatus"
    Type="varchar"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CargoTypeCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="OpenDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CargoType"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CustomsStatus"
    Type="nvarchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ExporterID"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ShipCode"
    Type="varchar"
    Size="25">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FirstCargoID"
    OldNames="Manifest"
    Type="varchar"
    Size="35">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SecondCargoID"
    Type="varchar"
    Size="35">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ThirdCargoID"
    Type="varchar"
    Size="35">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ExportDealIdentification"
    Type="nvarchar"
    Size="16">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="StorErrorXML"
    Type="nvarchar"
    Size="512">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="StorageStatus"
    ReferencedTable="StorageStatuses"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="CargoTypeCode"
    ReferencedTable="CargoIdentifireTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="CargoType"
    ReferencedTable="CargoTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="ShipCode"
    ReferencedTable="CustomsShips"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>