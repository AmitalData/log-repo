<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CourierMasters"
  Schema="Customs"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDateTime"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CreatedByUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="UpdateDateTime"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AirlineId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="MAWB"
    Type="nvarchar"
    Size="35">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="HAWB"
    Type="nvarchar"
    Size="35">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="EstimatedArrivalDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="GatewayPortCode"
    Type="varchar"
    Size="17">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="OriginPortCode"
    Type="varchar"
    Size="17">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsOpen"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsCancelled"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UpdatedByUserId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="MAWBTypeCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ManifestNumber"
    Type="varchar"
    Size="35">
    <Constraints
      Nullable="true" />
