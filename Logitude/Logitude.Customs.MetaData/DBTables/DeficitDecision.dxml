<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="DeficitDecisions"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="DeficitId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="DeclarationId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="RequestDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="RequestID"
    Type="varchar"
    Size="9">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="RequestTypeCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ApprovedProfessionCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DecisionCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DecisionNoteForLetter"
    Type="nvarchar"
    Size="512">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TotalComponentAmount"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TotalEstimatedAmount"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TotalFinancialPenaltyAmount"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TotalInterestAmount"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TotalLinkingAmount"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="DeficitId"
    ReferencedTable="Deficits"
    ReferencedColumn="Id"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="DeclarationId"
    ReferencedTable="Declarations"
