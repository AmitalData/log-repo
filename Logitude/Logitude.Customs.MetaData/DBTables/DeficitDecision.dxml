    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="RequestTypeCode"
    ReferencedTable="RequestTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="ApprovedProfessionCode"
    ReferencedTable="ApprovedProfessions"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="DecisionCode"
    ReferencedTable="DecisionTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>