<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CB_Tariffs"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="ID"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UpdateDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TradeAgreementID"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CustomsItemID"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Title"
    Type="nvarchar"
    Size="255">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="TradeAgreementID"
    ReferencedTable="CB_TradeAgreements"
    ReferencedColumn="ID"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="CustomsItemID"
    ReferencedTable="CB_CustomsItems"
    ReferencedColumn="ID"
    ReferencedTableSchema="Customs" />
</Table>