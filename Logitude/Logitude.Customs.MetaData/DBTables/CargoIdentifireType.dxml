<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CargoIdentifireTypes"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Code"
    Type="varchar"
    Size="4">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="EnglishName"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Inactive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsForDeclarationExport"
    OldNames="ValidForExport"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsForDeclarationImport"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsForManifest"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsKey2Mandatory"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsKey3Mandatory"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CargoIdentifierKey1Name"
    Type="nvarchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CargoIdentifierKey2Name"
    Type="nvarchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CargoIdentifierKey3Name"
    OldNames="CargoIdentifierKey2Name"
    Type="nvarchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
</Table>