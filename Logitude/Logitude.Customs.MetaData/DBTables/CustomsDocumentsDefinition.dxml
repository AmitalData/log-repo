<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CustomsDocumentsDefinitions"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DocumentTypeCode"
    Type="varchar"
    Size="7">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TransportationTypeCode"
    Type="char"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ProcessTypeCode"
    Type="varchar"
    Size="7">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CargoTypeCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Mandatory"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Inactive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DeclarationTypeCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="DocumentTypeCode"
    ReferencedTable="CustomDocumentTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="TransportationTypeCode"
    ReferencedTable="TransportModes"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ProcessTypeCode"
    ReferencedTable="GovernmentProcedureTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="CargoTypeCode"
    ReferencedTable="CargoIdentifireTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="DeclarationTypeCode"
    ReferencedTable="LeadDocumentTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>