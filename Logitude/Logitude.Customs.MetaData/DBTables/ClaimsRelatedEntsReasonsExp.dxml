<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ClaimsRelatedEntsReasonsExps"
  Schema="Customs"
  DBType="Main">
  <Column
    Name="ClaimId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="CounterKey"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="ReasonLineNo"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LineNo"
    Type="int"
    DefaultValue="0">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ClaimExplanationTypeCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ExplanationNote"
    Type="nvarchar"
    Size="512">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="ClaimId,CounterKey,ReasonLineNo"
    ReferencedTable="ClaimsRelatedEntitiesReasons"
    ReferencedColumn="ClaimId,CounterKey,LineNo"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="ClaimExplanationTypeCode"
    ReferencedTable="ClaimExplanationCodes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>