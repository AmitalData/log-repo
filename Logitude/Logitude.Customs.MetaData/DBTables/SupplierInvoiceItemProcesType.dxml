<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SupplierInvoiceItemProcesTypes"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="DeclarationId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="InvoiceCounterKey"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="InvoiceItemLineNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LineNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
