<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="PaymentOrderMethods"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="PaymentOrderId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Line"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="TypeCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Amount"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="BankCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="BranchCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AccountNumber"
    Type="varchar"
    Size="11">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PaymentMethodStatusCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="InternalBankId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CustomerActivityTypeCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CustomsBranchId"
    Type="varchar"
    Size="6">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="PaymentOrderId"
    ReferencedTable="PaymentOrders"
    ReferencedColumn="Id"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="TypeCode"
    ReferencedTable="PaymentMethodTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="BankCode"
    ReferencedTable="Banks"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="PaymentMethodStatusCode"
    ReferencedTable="PaymentMethodStatus"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="InternalBankId"
    ReferencedTable="CustomBanks"
    ReferencedColumn="Id"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="CustomerActivityTypeCode"
    ReferencedTable="CustomerActivityTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="CustomsBranchId"
    ReferencedTable="CustomsBranches"
    ReferencedColumn="Id"
    ReferencedTableSchema="Customs" />
</Table>