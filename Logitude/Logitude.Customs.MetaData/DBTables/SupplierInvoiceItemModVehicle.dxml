<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SupplierInvoiceItemModVehicles"
  Schema="Customs"
  DBType="Main">
  <Column
    Name="DeclarationId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="InvoiceCounterKey"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="InvoiceItemLineNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="AdjustmentTypeCode"
    Type="varchar"
    Size="4">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="DeductAmount"
    Type="decimal"
    Precision="16"
    Scale="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="DeclarationId,InvoiceCounterKey,InvoiceItemLineNumber"
    ReferencedTable="SupplierInvoiceItems"
    ReferencedColumn="DeclarationId,CounterKey,LineNumber"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="AdjustmentTypeCode"
    ReferencedTable="VehicleReductionTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>