<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CB_RuleClassifications"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="CB_ID"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="CustomsItemID"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ID"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CustomsBookType"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Rules"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ParentID"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Index"
    Type="nvarchar"
    Size="10">
    <Constraints
      Nullable="true" />
  </Column>
</Table>