<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CustomsItems"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="ID"
    Type="varchar"
    Size="9">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="CustomsBookTypeID"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="FullClassification"
    Type="varchar"
    Size="13">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CustomsItemCategoryID"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CustomsItemHierarchicLocationID"
    ShortName="CustomsItemHierarchicLocationI"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ComputedCheckDigit"
    Type="varchar"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
</Table>