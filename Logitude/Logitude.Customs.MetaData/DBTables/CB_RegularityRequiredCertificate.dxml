<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CB_RegularityRequiredCertificates"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="ID"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="RegularityInceptionID"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ConfirmationTypeID"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Number"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TextualCondition"
    Type="varchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TrNumber"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AuthorityID"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CB_ID"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="ConfirmationTypeID"
    ReferencedTable="ConfirmationTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="AuthorityID"
    ReferencedTable="Authorities"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>