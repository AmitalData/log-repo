<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="Consignments"
  Schema="Customs"
  DBType="Main">
  <Column
    Name="DeclarationId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="ConsignmentNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SequenceNumeric"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CargoTypeCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ManifestDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ManifestNumber"
    Type="varchar"
    Size="35">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SecondCargoID"
    Type="varchar"
    Size="35">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ThirdCargoID"
    Type="varchar"
    Size="35">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="UnloadDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="UnloadPortCode"
    Type="varchar"
    Size="17">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CargoDescription"
    Type="nvarchar"
    Size="256">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsLastReleaseFromWarehous"
    Type="varchar"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LoadingPortCode"
    Type="varchar"
    Size="17">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="OriginCountryCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
