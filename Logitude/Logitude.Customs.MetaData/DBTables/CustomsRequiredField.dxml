<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CustomsRequiredFields"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ObjectTableId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ObjectfieldId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ObjectfieldCode"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsImport"
    Type="bit">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsExport"
    Type="bit">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="ObjectTableId"
    ReferencedTable="ObjectTables"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ObjectfieldId"
    ReferencedTable="ObjectFields"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo"
    Ignore="true" />
</Table>