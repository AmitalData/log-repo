<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="AvailableStatusFields"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="FieldCode"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="IsAvailable"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="StatusFieldType"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="StatusFieldType"
    ReferencedTable="StatusFieldTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>