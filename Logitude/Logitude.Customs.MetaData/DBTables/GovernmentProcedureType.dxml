<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="GovernmentProcedureTypes"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Code"
    Type="varchar"
    Size="7">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="150">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="EnglishName"
    Type="varchar"
    Size="150">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Inactive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsImport"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IndexOrder"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsExport"
    Type="bit">
    <Constraints
      Nullable="true" />
  </Column>
</Table>