<?xml version="1.0" encoding="utf-8"?>
<Table Name="VendorCommunications" Schema="Customs" DBType="Main">
  <Column Name="VendorId" Type="varchar" Size="15">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
