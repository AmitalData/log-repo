    Type="varchar"
    Size="3">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="EnglishName"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Inactive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsRelevantGoodsItem"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsRelevantInvoice"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsRelevantInvoiceExport"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsRelevantGoodsItemExport"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ExtraNumericData"
    Type="nvarchar"
    Size="5">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsCustomsValueComponent"
    Type="bit">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ExportFOBModificationAffectID"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsCustomsValueComponentExport"
    Type="bit">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CurrencyMustSameInvoiceExport"
    Type="bit">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CurrencyMustBeSameAsInvoice"
    Type="bit">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsCustomUseExport"
    Type="bit">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="NetoValuesModificationAffectID"
    Type="varchar"
