<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="LogisticPermits"
    Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Id"
        Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="TransmitDate"
      Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ActionCode"
       Type="nvarchar"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CargoIdentifierType"
        Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CargoIdentifierKey1"
        Type="nvarchar"
    Size="35">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CargoIdentifierKey2"
       Type="nvarchar"
    Size="35">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CargoIdentifierKey3"
        Type="nvarchar"
    Size="35">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="CargoIdentifierType"
    ReferencedTable="CargoIdentifireTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>