<?xml version="1.0" encoding="utf-8"?>
<Table Name="DeclarationConsAcceptances">
  <Column Name="ConsignmentNumber" Type="int">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="DeclarationId" Type="varchar" Size="15">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="EntryDate" Type="datetime">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="GrossWeight" Type="decimal">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="LineNumber" Type="int">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="PackageTypeCode" Type="varchar" Size="4">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Quantity" Type="int">
    <Constraints Nullable="true" />
  </Column>
  <Column Name="Tenant" Type="int">
    <Constraints Nullable="false" />
  </Column>
</Table>