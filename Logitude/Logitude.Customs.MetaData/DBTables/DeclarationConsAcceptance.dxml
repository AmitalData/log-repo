<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="DeclarationConsAcceptances"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="DeclarationId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="ConsignmentNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LineNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EntryDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PackageTypeCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Quantity"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="GrossWeight"
    Type="decimal"
    Precision="11"
    Scale="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="DeclarationId"
    ReferencedTable="Declarations"
    ReferencedColumn="Id"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="PackageTypeCode"
    ReferencedTable="PackingTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>