<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SIIRequests"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DeclarationId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Status"
    Type="varchar"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="WareHouseAddress"
    Type="nvarchar"
    Size="60">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="WareHouseCity"
    Type="nvarchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsClosed"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
</Table>