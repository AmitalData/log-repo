<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CB_Preferences"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="BackgroundColor"
    Type="nvarchar"
    Size="128">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TextColor"
    Type="nvarchar"
    Size="128">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="UserId"
    Type="nvarchar"
    Size="128">
    <Constraints
      Nullable="true" />
  </Column>
</Table>