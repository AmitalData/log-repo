<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="NotificationDefinitions"
  Schema="Customs"
  DBType="Main">
  <Column
    Name="Code"
    Type="varchar"
    Size="5">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="EnglishName"
    Type="varchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="40">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AssigneeNotificationTypeCode"
    Type="varchar"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Inactive"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="AssigneeNotificationTypeCode"
    ReferencedTable="AssigneeNotificationTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>