<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="VehicleSafetyAccessories"
  Schema="Customs"
  DBType="Main">
  <Column
    Name="VehicleId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LineNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="VehicleSafetyAccessoryCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="VehicleSafAccessoryInstlTypCod"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="VehicleId"
    ReferencedTable="Vehicles"
    ReferencedColumn="Id"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="VehicleSafetyAccessoryCode"
    ReferencedTable="VehicleSafetyAccessoryTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="VehicleSafAccessoryInstlTypCod"
    ReferencedTable="VehicleSafeAccessoryInstlTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>