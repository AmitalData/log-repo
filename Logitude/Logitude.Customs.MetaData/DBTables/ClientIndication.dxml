<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ClientIndications"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="IndicationId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ClientId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="CustomerIndicationTypeID"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsActive"
    Type="bit">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="StartDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="EndDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="ClientId"
    ReferencedTable="Clients"
    ReferencedColumn="Id"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="CustomerIndicationTypeID"
    ReferencedTable="CustomerIndicationTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>