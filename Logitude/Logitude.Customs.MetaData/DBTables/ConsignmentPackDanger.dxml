<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ConsignmentPackDangers"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="DeclarationId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="ConsignmentNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LineNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="DangerousLineNo"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UNCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DangerousGoodsPackingReqCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="FlashpointTemperature"
    Type="varchar"
    Size="8">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="StorageTemperature"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ClassificationFourDigit"
    Type="nvarchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="DeclarationId,ConsignmentNumber,LineNumber"
    ReferencedTable="ConsignmentPackages"
    ReferencedColumn="DeclarationId,ConsignmentNumber,LineNumber"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="UNCode"
    ReferencedTable="HazardousSubstances"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="DangerousGoodsPackingReqCode"
    ReferencedTable="DangerousGoodsPackingReqs"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>