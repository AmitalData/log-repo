<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CustomsDocuments"
  Schema="Customs"
  DBType="Main">
  <Column
    Name="DocumentsFilingId"
    Type="varchar"
    Size="40">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CustomsDocId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DocumentStatusCode"
    Type="varchar"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DocumentRemarks"
    Type="varchar"
    Size="512">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DocumentTypeCode"
    Type="varchar"
    Size="7">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsMetaDataReady"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CustomRecievedDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DocumentVersion"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ExternalAttachmentId"
    Type="varchar"
    Size="35">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsPartOfDeclaration"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="DocumentsFilingId"
    ReferencedTable="DocumentsFilings"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="DocumentStatusCode"
    ReferencedTable="CustomsDocumentStatusTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="DocumentTypeCode"
    ReferencedTable="CustomDocumentTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>