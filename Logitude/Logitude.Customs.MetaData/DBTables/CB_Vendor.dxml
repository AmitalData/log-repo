<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CB_Vendors"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="ID"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Title"
    Type="varchar"
    Size="255">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="State"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EnglishCountryName"
    Type="varchar"
    Size="255">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="VendorSingleStringAddress"
    Type="varchar"
    Size="255">
    <Constraints
      Nullable="true" />
  </Column>
</Table>