<?xml version="1.0" encoding="utf-8"?>
<Table Name="PaymentOrderLines" Schema="Customs" DBType="Main">
  <Column Name="PaymentOrderId" Type="varchar" Size="15">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="ParagraphTypeCode" Type="varchar" Size="3">
    <Constraints PrimaryKey="true" Nullable="false" />
  </Column>
  <Column Name="Tenant" Type="int">
    <Constraints Nullable="false" />
  </Column>
  <Column Name="Amount" Type="decimal" Precision="18" Scale="2">
    <Constraints Nullable="true" />
  </Column>
  <Relation ForeignKeyColumn="PaymentOrderId" ReferencedTable="PaymentOrders" ReferencedColumn="Id" ReferencedTableSchema="Customs" />
  <Relation ForeignKeyColumn="ParagraphTypeCode" ReferencedTable="ParagraphTypes" ReferencedColumn="Code" ReferencedTableSchema="Customs" />
</Table>