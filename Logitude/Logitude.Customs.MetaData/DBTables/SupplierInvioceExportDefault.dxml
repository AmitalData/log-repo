<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SupplierInvioceExportDefaults"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="AccountTypeCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="PartyRelationshipCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="BuyerRoleCode"
    Type="varchar"
    Size="2">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ProcessTypeCode"
    Type="varchar"
    Size="7">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TransactionNatureCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ClaimReasonCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="AccountTypeCode"
    ReferencedTable="InvoiceTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="PartyRelationshipCode"
    ReferencedTable="PartyRelationshipTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="BuyerRoleCode"
    ReferencedTable="BuyerRoleTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="ProcessTypeCode"
    ReferencedTable="ItemGovernmentProcedureTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="TransactionNatureCode"
    ReferencedTable="TransactionNatureTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="ClaimReasonCode"
    ReferencedTable="ClaimReasonTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>