<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SIIDocumentTypes"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Code"
    Type="varchar"
    Size="7">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="EnglishName"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LocalName"
    Type="nvarchar"
    Size="120">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Inactive"
