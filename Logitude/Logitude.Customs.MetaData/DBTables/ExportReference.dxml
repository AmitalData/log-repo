<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ExportReferences"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="StorageNo"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="RefType"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="RefValue"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="Id"
    ReferencedTable="ExportStorges"
    ReferencedColumn="Id"
    ReferencedTableSchema="Customs" />
</Table>