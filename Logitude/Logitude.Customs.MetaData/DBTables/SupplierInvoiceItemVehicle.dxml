    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="InvoiceCounterKey"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="InvoiceItemLineNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LineNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="SequenceNumeric"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="VehicleTypeCode"
    Type="varchar"
    Size="4">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="VehicleChassisNumber"
    Type="varchar"
