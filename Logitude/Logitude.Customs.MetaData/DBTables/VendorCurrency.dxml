<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="VendorCurrencies"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="VendorId"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="LineNumber"
    Type="int">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Currency"
    OldNames="CurrencyType"
    Type="varchar"
    Size="3">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="VendorId"
    ReferencedTable="CustomsVendors"
    ReferencedColumn="Id"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="Currency"
    ReferencedTable="CurrencyTypes"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>