<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="RemarksClassifications"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Id"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CB_ID"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="CustomsItemsID"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="RemarkDescription"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
</Table>