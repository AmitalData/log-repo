<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="UIMessageAdditionals"
  Schema="Customs"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Code"
    Type="varchar"
    Size="10">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Sort"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="Code"
    ReferencedTable="UIMessages"
    ReferencedColumn="Code"
    ReferencedTableSchema="Customs" />
</Table>