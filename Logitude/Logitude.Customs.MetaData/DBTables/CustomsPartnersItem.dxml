<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="CustomsPartnersItems"
  Schema="Customs"
  DBType="Main">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ItemCode"
    Type="varchar"
    Size="30">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ClassificationCode"
    Type="varchar"
    Size="18">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Name"
    Type="nvarchar"
    Size="30">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="CustomerId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="VendorId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="CustomerId"
    ReferencedTable="Clients"
    ReferencedColumn="Id"
    ReferencedTableSchema="Customs" />
  <Relation
    ForeignKeyColumn="VendorId"
    ReferencedTable="CustomsVendors"
    ReferencedColumn="Id"
    ReferencedTableSchema="Customs" />
</Table>