<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SchedulerParams"
  Schema="Customs"
  DBType="Main"
  Module="Customs">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SchedulerProcedureCode"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Parameter"
    Type="nvarchar"
    Size="50">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ParameterValue"
    Type="nvarchar"
    Size="50">
    <Constraints
      Nullable="true" />
  </Column>
</Table>