<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
	<Sql Version="1">
	</Sql>

	<Oracle Version="2">
		<![CDATA[
update COURIERMASTERS set SEARCHFIELDS =CONCAT( CONCAT(SEARCHFIELDS , ',' ), (select cards.LOCALNAME from cards where cards.id= COURIERMASTERS.integratorcode));
    ]]>
	</Oracle>
</Script>