<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
	<Sql Version="1">
	</Sql>
	<Oracle Version="3">
		<![CDATA[			
			INSERT INTO 
				SUPPLIERINVOICEFREIGHTAMOUNTS(DECLARATIONID, INVOICECOUNTERKEY, CURRENCYTYPECODE, TENANT, AMOUNT, ID) 
			SELECT 
				SUPPLIERINVOICEFREAM_TEMP.DECLARATIONID, 
				SUPPLIERINVOICEFREAM_TEMP.INVOICECOUNTERKEY, 
				SUPPLIERINVOICEFREAM_TEMP.CURRENCYTYPECODE, 
				SUPPLIERINVOICEFREAM_TEMP.TENANT, 
				SUPPLIERINVOICEFREAM_TEMP.AMOUNT, 
				ROW_NUMBER() OVER (ORDER BY DECLARATIONID) R
			FROM SUPPLIERINVOICEFREAM_TEMP;		

			EXECUTE IMMEDIATE 'DROP TABLE SUPPLIERINVOICEFREAM_TEMP';

			EXECUTE IMMEDIATE 'COMMIT';
    ]]>
	</Oracle>
</Script>

