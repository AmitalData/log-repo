<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
	<Sql Version="1">
	</Sql>
	<Oracle Version="3">
		<![CDATA[			
			INSERT INTO 
				SUPPLIERINVOICEFREIGHTAMOUNTS(DECLARATIONID, INVOICECOUNTERKEY, CURRENCYTYPECODE, TENANT, AMOUNT, ID) 
			SELECT 
				SUPPLIERINVOICEFREIGHTAMO_T.DECLARATIONID, 
				SUPPLIERINVOICEFREIGHTAMO_T.INVOICECOUNTERKEY, 
				SUPPLIERINVOICEFREIGHTAMO_T.CURRENCYTYPECODE, 
				SUPPLIERINVOICEFREIGHTAMO_T.TENANT, 
				SUPPLIERINVOICEFREIGHTAMO_T.AMOUNT, 
				ROW_NUMBER() OVER (ORDER BY DECLARATIONID) R
			FROM SUPPLIERINVOICEFREIGHTAMO_T;		

			EXECUTE IMMEDIATE 'DROP TABLE SUPPLIERINVOICEFREIGHTAMO_T';

			EXECUTE IMMEDIATE 'COMMIT';
    ]]>
	</Oracle>
</Script>

