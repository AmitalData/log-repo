<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
	<Sql Version="1">
		<![CDATA[
       IF NOT EXISTS(SELECT * FROM sys.indexes WHERE name = 'interfaceTypeCodeIndex' AND object_id = OBJECT_ID('QUEUEMESSAGES'))
    BEGIN
        CREATE INDEX interfaceTypeCodeIndex
        ON dbo.QUEUEMESSAGES (interfaceTypeCode)
    END

        ]]>

	</Sql>



	<Oracle Version="2">
		<![CDATA[
		DECLARE
        i INTEGER;
    BEGIN
        SELECT COUNT(*) INTO i FROM    all_indexes
    WHERE   table_name = 'QUEUEMESSAGES' and index_name='INTERFACETYPECODEINDEX';
        IF i = 0 THEN
            EXECUTE IMMEDIATE 'CREATE INDEX interfaceTypeCodeIndex
            ON QUEUEMESSAGES (interfaceTypeCode)';
        END IF;
    END;
        ]]>
	</Oracle>
</Script>