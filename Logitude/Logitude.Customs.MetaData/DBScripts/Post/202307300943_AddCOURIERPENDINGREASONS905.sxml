<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
  <Sql Version="6">

    <![CDATA[
    INSERT INTO Customs.COURIERPENDINGREASONS (CODE,LOCALNAME,SEARCHFIELDS,ENGLISHNAME,INACTIVE,ERRORPLACE,TENANT,UNIFREIGHTSTATUSCODE,ID) 
SELECT  '905', 'משלוח לא לישראל' ,'משלוח לא לישראל,Shipping not to Israel,905','Shipping not to Israel',0,null,1, NULL, '905'
WHERE NOT EXISTS (
  SELECT *
  FROM Customs.COURIERPENDINGREASONS
  WHERE CODE = '905'
);
commit;
     ]]>
  </Sql>

  <Oracle Version="6">
