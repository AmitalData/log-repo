<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
  <Sql Version="2">

    <![CDATA[
       INSERT INTO customs.COURIERPENDINGREASONS (CODE, LOCALNAME, SEARCHFIELDS, ENGLISHNAME, INACTIVE, ERRORPLACE, TENANT, UNIFREIGHTSTATUSCODE, ID,MAMANSUSPENDEDCODE,REQUIRESAPPROVAL,SWISSPORTSUSPENDEDCODE,REQUIRESPAYMENT) 
SELECT  '904', 'משקל' ,'משקל,Weight,904', 'Weight', 0, NULL, T.ID, NULL, '904'+convert(varchar,T.ID),null,1,null,0
FROM (
  SELECT ID
  FROM TENANTS
) AS T
WHERE NOT EXISTS (
  SELECT *
  FROM customs.COURIERPENDINGREASONS
  WHERE CODE = '904' AND TENANT = T.ID
);
     ]]>
  </Sql>

  <Oracle Version="6">
    <![CDATA[

 



INSERT INTO COURIERPENDINGREASONS (CODE, LOCALNAME, SEARCHFIELDS, ENGLISHNAME, INACTIVE, ERRORPLACE, TENANT, UNIFREIGHTSTATUSCODE, ID,MAMANSUSPENDEDCODE,REQUIRESAPPROVAL,SWISSPORTSUSPENDEDCODE,REQUIRESPAYMENT)
SELECT '904', 'משקל' ,'משקל,Weight,904', 'Weight', 0, NULL, T.ID, NULL, '904'||TO_CHAR(T.ID),null,1,null,0
FROM (
  SELECT ID
  FROM TENANTS
) T
WHERE NOT EXISTS (
  SELECT *
  FROM COURIERPENDINGREASONS
  WHERE CODE = '904' AND TENANT = T.ID
);

commit;


    ]]>
  </Oracle>
</Script>