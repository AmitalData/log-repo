<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
  <Sql Version="1">
		<![CDATA[
			UPDATE customs.DECLARATIONS
			SET ShortProcedure = 1
			WHERE ShortProcedure = 0
			AND EXISTS (
			SELECT 1
			FROM customs.GOVERNMENTPROCEDURETYPES
			WHERE customs.GOVERNMENTPROCEDURETYPES.ShortProcedure = 1
			AND customs.DECLARATIONS.ProcedureCurrentCode = customs.GOVERNMENTPROCEDURETYPES.CODE
			); 
		]]>

  </Sql>

  <Oracle Version="1">
    <![CDATA[
 ]]>
  </Oracle>
</Script>