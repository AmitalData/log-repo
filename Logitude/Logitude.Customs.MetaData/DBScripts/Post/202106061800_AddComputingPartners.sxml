<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" >
  <Sql Version="1">
  </Sql>

  <Oracle Version="1">
    <![CDATA[
             declare
 n int := 0;
begin
  select count(*) into n
  from ComputingPartners
 where code='ILOVS';
  if n = 0 then
  insert into ComputingPartners values ('G-1','Overseas',sysdate,sysdate,'1-9','1-9',null,'ilovs,overseas','ILOVS',1,null,0);
  insert into ComputingPartners values ('G-2','Swissport',sysdate,sysdate,'1-9','1-9',null,'ilsws,swissport','ILSWS',1,null,0);
  insert into ComputingPartners values ('G-3','Maman',sysdate,sysdate,'1-9','1-9',null,'maman','MAMAN',1,null,0);
  end if;
end;

    ]]>
  </Oracle>
</Script>