<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
  <Sql Version="1">
   
    <![CDATA[
       INSERT INTO customs.COURIERPENDINGREASONS (CODE, LOCALNAME, SEARCHFIELDS, ENGLISHNAME, INACTIVE, ERRORPLACE, TENANT, UNIFREIGHTSTATUSCODE, ID) 
SELECT  '901', 'אוטונומיה', 'Autonomy,אוטונומיה,901','Autonomy', 0, 1, T.ID, NULL, '901'+convert(varchar,T.ID)
FROM (
  SELECT ID
  FROM TENANTS
) AS T
WHERE NOT EXISTS (
  SELECT *
  FROM customs.COURIERPENDINGREASONS
  WHERE CODE = '901' AND TENANT = T.ID
);
     ]]>
  </Sql>

  <Oracle Version="1">
    <![CDATA[

INSERT INTO COURIERPENDINGREASONS (CODE, LOCALNAME, SEARCHFIELDS, ENGLISHNAME, INACTIVE, ERRORPLACE, TENANT, UNIFREIGHTSTATUSCODE, ID)
SELECT  '901', 'אוטונומיה', 'Autonomy,אוטונומיה,901','Autonomy', 0, 1, T.ID, NULL,   '901'||TO_CHAR(T.ID)
FROM (
  SELECT ID
  FROM TENANTS
) T
WHERE NOT EXISTS (
  SELECT *
  FROM COURIERPENDINGREASONS
  WHERE CODE = '901' AND TENANT = T.ID
);

commit;

    ]]>
  </Oracle>
</Script>