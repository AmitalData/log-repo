<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
	<Sql Version="1">
	</Sql>

  <Oracle Version="12">
    <![CDATA[
  update DECLARATIONS set PHYSICALCHECK_temp='N' where PHYSICALCHECK_temp is null;
  commit;
  EXECUTE IMMEDIATE 'update DECLARATIONS set PHYSICALCHECK = PHYSICALCHECK_temp';
  EXECUTE IMMEDIATE 'commit';
  EXECUTE IMMEDIATE 'alter table DECLARATIONS drop column PHYSICALCHECK_temp';
    ]]>
	</Oracle>
</Script>