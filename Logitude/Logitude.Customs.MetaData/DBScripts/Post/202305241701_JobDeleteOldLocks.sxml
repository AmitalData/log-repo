<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
  <Sql Version="3">
    <![CDATA[
  
]]>
  </Sql>

  <Oracle Version="2">
    <![CDATA[
DECLARE
  job_count NUMBER;
BEGIN

  SELECT COUNT(*)
  INTO job_count
  FROM all_scheduler_jobs 
  WHERE job_name = 'DELETE_OLD_LOCKS'
  and owner = USER;

  IF job_count = 0 THEN
    DBMS_SCHEDULER.CREATE_JOB (
            job_name => '"DELETE_OLD_LOCKS"',
            job_type => 'PLSQL_BLOCK',
            job_action => 'delete from generalLocks
where createdat < (sysdate -1); 
commit;',
            number_of_arguments => 0,
            start_date => NULL,
            repeat_interval => 'FREQ=DAILY;BYTIME=050000',
            end_date => NULL,
            enabled => FALSE,
            auto_drop => FALSE,
            comments => 'delete locks form generallocks table when is greater from day');

    DBMS_SCHEDULER.SET_ATTRIBUTE( 
             name => '"DELETE_OLD_LOCKS"', 
             attribute => 'logging_level', value => DBMS_SCHEDULER.LOGGING_OFF);
      
    
    DBMS_SCHEDULER.enable(
             name => '"DELETE_OLD_LOCKS"');
               
   END IF;
 END;


    ]]>
  </Oracle>
</Script>