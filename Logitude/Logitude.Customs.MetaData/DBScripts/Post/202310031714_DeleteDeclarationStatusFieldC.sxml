<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
  <Sql Version="1">
  </Sql>

  <Oracle Version="1">
    <![CDATA[
DECLARE
  v_count NUMBER;
BEGIN
  FOR i IN 1..50
  LOOP
    -- Check if the column exists
    SELECT COUNT(*)
    INTO v_count
    FROM ALL_TAB_COLUMNS
    WHERE TABLE_NAME = 'DECLARATIONSTATUSES'
    AND COLUMN_NAME = 'FIELDC' || i;

    IF v_count > 0 THEN
      -- Drop the column if it exists
      BEGIN
        EXECUTE IMMEDIATE 'ALTER TABLE DECLARATIONSTATUSES DROP COLUMN FIELDC' || i;
        DBMS_OUTPUT.PUT_LINE('Column FIELDC' || i || ' dropped successfully');
      EXCEPTION
        WHEN OTHERS THEN
          DBMS_OUTPUT.PUT_LINE('Error dropping FIELDC' || i || ': ' || SQLERRM);
      END;
    ELSE
      DBMS_OUTPUT.PUT_LINE('Column FIELDC' || i || ' does not exist');
    END IF;
  END LOOP;
END;

