<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main"  Module="Customs">>
	<Sql Version="1">
		<![CDATA[

	UPDATE TRANSPORTMODES SET LOCALNAME = 'יבשה' WHERE ID = 'I';
UPDATE TRANSPORTMODES SET LOCALNAME = 'אויר' WHERE ID = 'A';
UPDATE TRANSPORTMODES SET LOCALNAME = 'ים' WHERE ID = 'O';
UPDATE TRANSPORTMODES SET LOCALNAME = 'יבשה' WHERE ID = 'L';

		]]>

	</Sql>

	<Oracle Version="1">
    <![CDATA[

DECLARE
  n INT := 0;
BEGIN
  EXECUTE IMMEDIATE 'UPDATE TRANSPORTMODES SET LOCALNAME = ''יבשה'' WHERE ID = ''I''';
  EXECUTE IMMEDIATE 'UPDATE TRANSPORTMODES SET LOCALNAME = ''אויר'' WHERE ID = ''A''';
  EXECUTE IMMEDIATE 'UPDATE TRANSPORTMODES SET LOCALNAME = ''ים'' WHERE ID = ''O''';
  EXECUTE IMMEDIATE 'UPDATE TRANSPORTMODES SET LOCALNAME = ''יבשה'' WHERE ID = ''L''';
  EXECUTE IMMEDIATE 'COMMIT';
END;


]]>
 </Oracle>
</Script>