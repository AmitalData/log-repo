<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Global" Module="Customs">
	<Sql Version="7">
		<![CDATA[
		/* ---------- Cloud Tenant ---------- */
    IF NOT EXISTS (
        SELECT 1
        FROM   DefaultAndConfigurationKeys
        WHERE  Tenant = 0
          AND  SetKey = 'CloudTenant'
    )
    BEGIN
        INSERT INTO DefaultAndConfigurationKeys
              (Tenant, CreateDate, SetKey, ShortDescription,
               FullDesctiption, SetType1, SetType2)
        VALUES (0, GETDATE(), 'CloudTenant',
                'Cloud Tenant', 'Cloud Tenant',
                'System.String', 'System.String');
    END
    /* ---------- SII Customer Unique Code ---------- */
    IF NOT EXISTS (
        SELECT 1
        FROM   DefaultAndConfigurationKeys
        WHERE  Tenant = 0
          AND  SetKey = 'SIICustomerUniqueCode'
    )
    BEGIN
        INSERT INTO DefaultAndConfigurationKeys
              (Tenant, CreateDate, SetKey, ShortDescription,
               FullDesctiption, SetType1, SetType2)
        VALUES (0, GETDATE(), 'SIICustomerUniqueCode',
                'SII Customer Unique Code', 'SII Customer Unique Code',
                'System.String', 'System.String');
    END

    /* ---------- SII Application Name ---------- */
    IF NOT EXISTS (
        SELECT 1
        FROM   DefaultAndConfigurationKeys
        WHERE  Tenant = 0
          AND  SetKey = 'SIIApplicationName'
    )
    BEGIN
        INSERT INTO DefaultAndConfigurationKeys
              (Tenant, CreateDate, SetKey, ShortDescription,
               FullDesctiption, SetType1, SetType2)
        VALUES (0, GETDATE(), 'SIIApplicationName',
                'SII Application Name', 'SII Application Name',
                'System.String', 'System.String');
    END
	/* ---------- SII Application Name Not By Amital ---------- */
    IF NOT EXISTS (
        SELECT 1
        FROM   DefaultAndConfigurationKeys
        WHERE  Tenant = 0
          AND  SetKey = 'SIIApplicationNameNotByAmital'
    )
    BEGIN
        INSERT INTO DefaultAndConfigurationKeys
              (Tenant, CreateDate, SetKey, ShortDescription,
               FullDesctiption, SetType1, SetType2)
        VALUES (0, GETDATE(), 'SIIApplicationNameNotByAmital',
                'SII Application Name Not By Amital', 'SII Application Name Not By Amital',
                'System.String', 'System.String');
    END
	/* ---------- Download Document URL ---------- */
    IF NOT EXISTS (
        SELECT 1
        FROM   DefaultAndConfigurationKeys
        WHERE  Tenant = 0
          AND  SetKey = 'DownloadDocumentURL'
    )
    BEGIN
        INSERT INTO DefaultAndConfigurationKeys
              (Tenant, CreateDate, SetKey, ShortDescription,
               FullDesctiption, SetType1, SetType2)
        VALUES (0, GETDATE(), 'DownloadDocumentURL',
                'Download Document URL', 'Download Document URL',
                'System.String', 'System.String');
    END

	/* ---------- SII Status Queue Connection String ---------- */
    IF NOT EXISTS (
        SELECT 1
        FROM   DefaultAndConfigurationKeys
        WHERE  Tenant = 0
          AND  SetKey = 'SIIStatusQueueConn'
    )
    BEGIN
        INSERT INTO DefaultAndConfigurationKeys
              (Tenant, CreateDate, SetKey, ShortDescription,
               FullDesctiption, SetType1, SetType2)
        VALUES (0, GETDATE(), 'SIIStatusQueueConn',
                'SII Status Queue Connection String', 'SII Status Queue Connection String',
                'System.String', 'System.String');
    END

	/* ---------- SII Status Queue Prefix ---------- */
    IF NOT EXISTS (
        SELECT 1
        FROM   DefaultAndConfigurationKeys
        WHERE  Tenant = 0
          AND  SetKey = 'SIIStatusQueuePrefix'
    )
    BEGIN
        INSERT INTO DefaultAndConfigurationKeys
              (Tenant, CreateDate, SetKey, ShortDescription,
               FullDesctiption, SetType1, SetType2)
        VALUES (0, GETDATE(), 'SIIStatusQueuePrefix',
                'SII Status Queue Prefix', 'SII Status Queue Prefix',
                'System.String', 'System.String');
    END

    /* ---------- SII Applicant System Id ---------- */
    IF NOT EXISTS (
        SELECT 1
        FROM   DefaultAndConfigurationKeys
        WHERE  Tenant = 0
          AND  SetKey = 'SIIApplicantSystemId'
    )
    BEGIN
        INSERT INTO DefaultAndConfigurationKeys
              (Tenant, CreateDate, SetKey, ShortDescription,
               FullDesctiption, SetType1, SetType2)
        VALUES (0, GETDATE(), 'SIIApplicantSystemId',
                'SII Applicant System Id', 'SII Applicant System Id',
                'System.String', 'System.String');
    END
    ]]>
	</Sql>
	<Oracle Version="5">
		<![CDATA[
   MERGE INTO DefaultAndConfigurationKeys d
USING (SELECT 0               AS Tenant,
              'SIICustomerUniqueCode' AS SetKey,
              'SII Customer Unique Code' AS ShortDescription,
              'SII Customer Unique Code' AS FullDesctiption,
              'System.String'           AS SetType1,
              'System.String'           AS SetType2
       FROM dual) src
ON (d.Tenant = src.Tenant AND d.SetKey = src.SetKey)
WHEN NOT MATCHED THEN
  INSERT (Tenant, CreateDate, SetKey, ShortDescription,
          FullDesctiption, SetType1, SetType2)
  VALUES (src.Tenant, SYSDATE, src.SetKey,
          src.ShortDescription, src.FullDesctiption,
          src.SetType1, src.SetType2);

MERGE INTO DefaultAndConfigurationKeys d
USING (SELECT 0               AS Tenant,
              'SIIApplicationName' AS SetKey,
              'SII Application Name' AS ShortDescription,
              'SII Application Name' AS FullDesctiption,
              'System.String'        AS SetType1,
              'System.String'        AS SetType2
       FROM dual) src
ON (d.Tenant = src.Tenant AND d.SetKey = src.SetKey)
WHEN NOT MATCHED THEN
  INSERT (Tenant, CreateDate, SetKey, ShortDescription,
          FullDesctiption, SetType1, SetType2)
  VALUES (src.Tenant, SYSDATE, src.SetKey,
          src.ShortDescription, src.FullDesctiption,
          src.SetType1, src.SetType2);

      /* ---------- Cloud Tenant ---------- */
    MERGE INTO DefaultAndConfigurationKeys d
    USING (SELECT 0               AS Tenant,
                  'CloudTenant'           AS SetKey,
                  'Cloud Tenant'          AS ShortDescription,
                  'Cloud Tenant'          AS FullDesctiption,
                  'System.String'         AS SetType1,
                  'System.String'         AS SetType2
           FROM dual) src
    ON (d.Tenant = src.Tenant AND d.SetKey = src.SetKey)
    WHEN NOT MATCHED THEN
      INSERT (Tenant, CreateDate, SetKey, ShortDescription,
              FullDesctiption, SetType1, SetType2)
      VALUES (src.Tenant, SYSDATE, src.SetKey,
              src.ShortDescription, src.FullDesctiption,
              src.SetType1, src.SetType2);

			  /* ---------- Download Document URL ---------- */
    MERGE INTO DefaultAndConfigurationKeys d
    USING (SELECT 0               AS Tenant,
                  'DownloadDocumentURL'   AS SetKey,
                  'Download Document URL' AS ShortDescription,
                  'Download Document URL' AS FullDesctiption,
                  'System.String'         AS SetType1,
                  'System.String'         AS SetType2
           FROM dual) src
    ON (d.Tenant = src.Tenant AND d.SetKey = src.SetKey)
    WHEN NOT MATCHED THEN
      INSERT (Tenant, CreateDate, SetKey, ShortDescription,
              FullDesctiption, SetType1, SetType2)
      VALUES (src.Tenant, SYSDATE, src.SetKey,
              src.ShortDescription, src.FullDesctiption,
              src.SetType1, src.SetType2);

	  /* ---------- SII Status Queue Connection String ---------- */
    MERGE INTO DefaultAndConfigurationKeys d
    USING (SELECT 0                            AS Tenant,
                  'SIIStatusQueueConn'         AS SetKey,
                  'SII Status Queue Connection String' AS ShortDescription,
                  'SII Status Queue Connection String' AS FullDesctiption,
                  'System.String'              AS SetType1,
                  'System.String'              AS SetType2
           FROM dual) src
    ON (d.Tenant = src.Tenant AND d.SetKey = src.SetKey)
    WHEN NOT MATCHED THEN
      INSERT (Tenant, CreateDate, SetKey, ShortDescription,
              FullDesctiption, SetType1, SetType2)
      VALUES (src.Tenant, SYSDATE, src.SetKey,
              src.ShortDescription, src.FullDesctiption,
              src.SetType1, src.SetType2);

	  /* ---------- SII Status Queue Prefix ---------- */
    MERGE INTO DefaultAndConfigurationKeys d
    USING (SELECT 0                        AS Tenant,
                  'SIIStatusQueuePrefix'   AS SetKey,
                  'SII Status Queue Prefix' AS ShortDescription,
                  'SII Status Queue Prefix' AS FullDesctiption,
                  'System.String'          AS SetType1,
                  'System.String'          AS SetType2
           FROM dual) src
    ON (d.Tenant = src.Tenant AND d.SetKey = src.SetKey)
    WHEN NOT MATCHED THEN
      INSERT (Tenant, CreateDate, SetKey, ShortDescription,
              FullDesctiption, SetType1, SetType2)
      VALUES (src.Tenant, SYSDATE, src.SetKey,
              src.ShortDescription, src.FullDesctiption,
              src.SetType1, src.SetType2);

    /* ---------- SII Applicant System Id ---------- */
    MERGE INTO DefaultAndConfigurationKeys d
    USING (SELECT 0                        AS Tenant,
                  'SIIApplicantSystemId'   AS SetKey,
                  'SII Applicant System Id' AS ShortDescription,
                  'SII Applicant System Id' AS FullDesctiption,
                  'System.String'          AS SetType1,
                  'System.String'          AS SetType2
           FROM dual) src
    ON (d.Tenant = src.Tenant AND d.SetKey = src.SetKey)
    WHEN NOT MATCHED THEN
      INSERT (Tenant, CreateDate, SetKey, ShortDescription,
              FullDesctiption, SetType1, SetType2)
      VALUES (src.Tenant, SYSDATE, src.SetKey,
              src.ShortDescription, src.FullDesctiption,
              src.SetType1, src.SetType2);
			  /* ---------- SII Application Name Not By Amital ---------- */
MERGE INTO DefaultAndConfigurationKeys d
USING (SELECT 0                               AS Tenant,
              'SIIApplicationNameNotByAmital' AS SetKey,
              'SII Application Name Not By Amital' AS ShortDescription,
              'SII Application Name Not By Amital' AS FullDesctiption,
              'System.String'                 AS SetType1,
              'System.String'                 AS SetType2
       FROM dual) src
ON (d.Tenant = src.Tenant AND d.SetKey = src.SetKey)
WHEN NOT MATCHED THEN
  INSERT (Tenant, CreateDate, SetKey, ShortDescription,
          FullDesctiption, SetType1, SetType2)
  VALUES (src.Tenant, SYSDATE, src.SetKey,
          src.ShortDescription, src.FullDesctiption,
          src.SetType1, src.SetType2);

    ]]>
	</Oracle>

</Script>
