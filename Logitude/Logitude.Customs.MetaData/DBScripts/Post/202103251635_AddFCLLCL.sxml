<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
  <Sql Version="1">
  </Sql>

  <Oracle Version="1">
    <![CDATA[
             declare
 n int := 0;
begin
  select count(*) into n
  from FCLLCLCODES
 where code='F';
  if n = 0 then
  insert into FCLLCLCODES values ('F','FCL','f,fcl'); insert into FCLLCLCODES values('L','LCL','l,lcl');
            end if;
end;

    ]]>
  </Oracle>
</Script>