<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs"  Pre="true">
	<Sql Version="1">
	</Sql>

	<Oracle Version="1">
		<![CDATA[
		declare
 n int := 0;
begin
  select count(*) into n FROM  ALL_TAB_COLUMNS WHERE TABLE_NAME = 'DECLARATIONS' AND COLUMN_NAME = 'EXPORTCONTAINERIZATIONID' and  OWNER=(SELECT SYS_CONTEXT('USERENV','CURRENT_SCHEMA') FROM DUAL) ;
  if n = 1 then
EXECUTE IMMEDIATE 'alter table DECLARATIONS drop column EXPORTCONTAINERIZATIONID';
   end if;
end;
    ]]>
	</Oracle>
</Script>