<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
	<Sql Version="1">
		<![CDATA[
      	-- עדכון השדה החדש בהתאם לתנאים
        UPDATE customs.certificateoforigininvoices
        SET IsInvoiceConnected = 1 where IsInvoicesForPrint = 1;
        ]]>
	</Sql>
  
  <Oracle Version="1">    
  </Oracle>
</Script>