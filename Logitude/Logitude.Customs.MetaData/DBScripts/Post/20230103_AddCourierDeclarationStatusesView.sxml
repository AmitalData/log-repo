<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" >
  <Sql Version="1">
  </Sql>

  <Oracle Version="4">
    <![CDATA[

CREATE VIEW DeclarationCourierStatusesView
    AS
   select 
COURIERMASTERS.ID as CourierMasterId ,

COUNT ( case when DeclarationCourierStatuses.CourierManifestStatusCode ='M'  or DeclarationCourierStatuses.CourierManifestStatusCode = 'X' then 1 end   ) as QuantityNoDocuments,
COUNT ( case when DeclarationCourierStatuses.IsCourierMissingClassification ='1'   then 1 end   ) as QuantityNoClassification,
COUNT (case when DECLARATIONCOURIERSTATUSES.CourierManifestStatusCode ='M'  or DeclarationCourierStatuses.CourierManifestStatusCode = 'X' then 1 end   )   as QuantityNoManifest,
COUNT ( case when DECLARATIONCOURIERSTATUSES.CourierDeclarationStatusCode ='M'  or DeclarationCourierStatuses.CourierDeclarationStatusCode = 'X' then 1 end   ) as QuantityNoDeclaration,

CASE WHEN COUNT ( case when DECLARATIONCOURIERSTATUSES.DOCUMENTSTATUSCODE ='M'  or DeclarationCourierStatuses.CourierManifestStatusCode = 'X' then 1 end   )  > 1  THEN 'M'
          WHEN COUNT ( case when DECLARATIONCOURIERSTATUSES.DOCUMENTSTATUSCODE ='I'   then 1 end   )  > 1  THEN 'I'
          WHEN COUNT ( case when DECLARATIONCOURIERSTATUSES.DOCUMENTSTATUSCODE ='V'   then 1 end   )  = count(*)  THEN 'V'
         ELSE 'N'
END AS DocumentStatusCode,

CASE WHEN COUNT ( case when DECLARATIONCOURIERSTATUSES.CourierPaymentStatusCode ='I'   then 1 end   )  > 1   THEN 'I'
          WHEN COUNT ( case when DECLARATIONCOURIERSTATUSES.CourierPaymentStatusCode ='R'   then 1 end   )  > 1  THEN 'R'
          WHEN COUNT ( case when DECLARATIONCOURIERSTATUSES.CourierPaymentStatusCode ='O'   then 1 end   )  > 1  THEN 'O'
          WHEN COUNT ( case when DECLARATIONCOURIERSTATUSES.CourierPaymentStatusCode ='P'   then 1 end   )  > 1  THEN 'P'
         ELSE 'N'
END AS CourierPaymentStatusCode,

CASE WHEN COUNT ( case when DECLARATIONCOURIERSTATUSES.CourierDeclarationStatusCode ='M'  or DeclarationCourierStatuses.CourierDeclarationStatusCode = 'X' then 1 end   )  > 1   THEN 'X'
          WHEN COUNT ( case when DECLARATIONCOURIERSTATUSES.CourierDeclarationStatusCode ='R'   then 1 end   )  = count(*)  THEN 'R'
          WHEN COUNT (  case when DECLARATIONCOURIERSTATUSES.CourierDeclarationStatusCode ='I'     then 1 end   )  > 1  THEN 'I'
          WHEN COUNT ( case when DECLARATIONCOURIERSTATUSES.CourierDeclarationStatusCode ='V'   then 1 end   )  = count(*)  THEN 'V'
         ELSE 'N'
END AS CourierDeclarationStatusCode,

CASE WHEN COUNT ( case when DECLARATIONCOURIERSTATUSES.CourierManifestStatusCode ='M'  or DeclarationCourierStatuses.CourierManifestStatusCode = 'X' then 1 end   )  > 1   THEN 'X'
          WHEN COUNT ( case when DECLARATIONCOURIERSTATUSES.CourierManifestStatusCode ='R'   then 1 end   )  = count(*)  THEN 'R'
          WHEN COUNT (  case when DECLARATIONCOURIERSTATUSES.CourierManifestStatusCode ='I'     then 1 end   )  > 1  THEN 'I'
          WHEN COUNT ( case when DECLARATIONCOURIERSTATUSES.CourierManifestStatusCode ='V'   then 1 end   )  = count(*)  THEN 'V'
         ELSE 'N'
END AS CourierManifestStatusCode,


CASE WHEN COUNT ( case when DECLARATIONCOURIERSTATUSES.IsCourierMissingClassification ='1' then 1 end  )  > 1  THEN 'M'
          WHEN COUNT ( case when DECLARATIONCOURIERSTATUSES.IsCourierMissingClassification ='0' then 1 end   )  = count(*)  THEN 'F'
         ELSE 'N'
END AS IsCourierMissingClassification


FROM DeclarationCourierStatuses 
inner  JOIN CourierDeclarations  ON CourierDeclarations.DeclarationId = DeclarationCourierStatuses.DeclarationId
inner join COURIERMASTERS on CourierDeclarations.CourierMasterId =COURIERMASTERS.ID 
where  COURIERMASTERS.isopen =1
group by COURIERMASTERS.ID  

    ]]>
  </Oracle>
</Script>