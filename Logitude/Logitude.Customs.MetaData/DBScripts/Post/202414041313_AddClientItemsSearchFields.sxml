<Script DBType="Main" Module="Customs">
	<Sql Version="1">

		<![CDATA[
			UPDATE customs.ClientItems SET SearchFields = ISNULL(ItemCode,'') +','+ isnull(ItemDescription ,'') +','+ isnull(ClassificationCode,'')
        ]]>
	</Sql>
  
