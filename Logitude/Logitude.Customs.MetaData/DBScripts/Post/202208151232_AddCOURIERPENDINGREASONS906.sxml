<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
  <Sql Version="2">

	  <![CDATA[
     INSERT INTO Customs.COURIERPENDINGREASONS (CODE,LOCALNAME,SEARCHFIELDS,ENGLISHNAME,INACTIVE,ERRORPLACE,TENANT,UNIFREIGHTSTATUSCODE,ID)
SELECT '906', 'לקוח מסחרי' ,'לקוח מסחרי,Commercial Customer,906','Commercial Customer',0,null, T.ID, NULL,  '906'+convert(varchar,T.ID)
FROM (
  SELECT ID
  FROM TENANTS
) T
WHERE NOT EXISTS (
  SELECT *
  FROM Customs.COURIERPENDINGREASONS
  WHERE CODE = '906' AND TENANT = T.ID
);



        ]]>
  </Sql>

  <Oracle Version="2">
    <![CDATA[


INSERT INTO COURIERPENDINGREASONS (CODE,LOCALNAME,SEARCHFIELDS,ENGLISHNAME,INACTIVE,ERRORPLACE,TENANT,UNIFREIGHTSTATUSCODE,ID)
SELECT '906', 'לקוח מסחרי' ,'לקוח מסחרי,Commercial Customer,906','Commercial Customer',0,null, T.ID, NULL,  '906'||TO_CHAR(T.ID)
FROM (
  SELECT ID
  FROM TENANTS
) T
WHERE NOT EXISTS (
  SELECT *
  FROM COURIERPENDINGREASONS
  WHERE CODE = '906' AND TENANT = T.ID
);



commit;

    ]]>
  </Oracle>
</Script>