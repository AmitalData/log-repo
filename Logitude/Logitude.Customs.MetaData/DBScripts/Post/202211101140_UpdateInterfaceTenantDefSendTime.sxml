<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
  <Sql Version="2">
	  <![CDATA[
	  update customs.INTERFACETENANTDEFINITIONS set sendtime = (
	  select sendtime from customs.interfacemanagements where code = '2715' and sendtime is not null)
	  where code = '2715' and sendtime is  null
		]]>
  </Sql>

  <Oracle Version="1">
    <![CDATA[
update INTERFACETENANTDEFINITIONS set sendtime = (
select sendtime from interfacemanagements where code = '2715' and sendtime is not null)
where code = '2715' and sendtime is  null
    ]]>
  </Oracle>
</Script>