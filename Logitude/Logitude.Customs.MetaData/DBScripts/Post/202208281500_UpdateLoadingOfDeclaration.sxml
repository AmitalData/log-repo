<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
  <Sql Version="1">
  </Sql>

  <Oracle Version="1">
    <![CDATA[

  
  declare 
 v_count number;
begin
select count(*) into v_count from declarations where direction='E';

if v_count > 0 then
begin
    UPDATE Declarations a
    SET (ExportLoadingPortCode) = (
    SELECT ExportLoadingPortCode
    FROM Consignments  b
    WHERE  a.id = b.DeclarationId and a.tenant=b.tenant and a.direction='E'and b.ExportLoadingPortCode is not null and rownum = 1);
    commit;
    exception
    when DUP_VAL_ON_INDEX
    then ROLLBACK;
end;

end if;
end;
    ]]>
  </Oracle>
</Script>