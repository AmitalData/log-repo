  <Oracle Version="1">
    insert into DOCUMENTSMETADATATYPES (ID,TENANT,CODE,ENGLISHNAME,LOCALNAME,INACTIVE,FORMAT,CUSTOMSMETADATACODE)
    select  '-02',1,'INTGR_R','Integratore','Integratore',0,'string',null
    from dual
    where not exists
    (select * from DOCUMENTSMETADATATYPES WHERE CODE= 'INTGR_R' );

    insert into DOCUMENTSMETADATATYPES (ID,TENANT,CODE,ENGLISHNAME,LOCALNAME,INACTIVE,FORMAT,CUSTOMSMETADATACODE)
    select  '-03',1,'CARFI','hawb','hawb',0,'string',null
    from dual
    where not exists
    (select * from DOCUMENTSMETADATATYPES WHERE CODE= 'CARFI' );
    commit;
  </Oracle>
</Script>