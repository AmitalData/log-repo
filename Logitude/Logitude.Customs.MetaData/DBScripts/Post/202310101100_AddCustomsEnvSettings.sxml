<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
  <Sql Version="1">
  </Sql>

  <Oracle Version="1">
    <![CDATA[
DECLARE
    v_count NUMBER;
BEGIN
    SELECT COUNT(*)
    INTO v_count
    FROM CustomsSettings
    WHERE companytype = 'B';

    IF v_count > 0 THEN
        INSERT INTO AMINET_MAIN.CUSTOMSENVIRONMENTSETTINGS (
            ID,
            ENVIRONMENTCODE,
            USERABBITMQ,
            RABBITHOST,
            RABBITUSERNAME,
            RABBITPASSWORD,
            HSMSIGNPROCESS,
            HSMTOKEN,
            HSMACTIVECERTURL,
            HSMSIGNSERVICEURL
        )
        SELECT
            '1',
            '0',
            0,
            'unisrv01',
            'ecom',
            'Aa123',
            'Ecom',
            '9edYig7zg_b2mBV-72DaOKVMlqtJp-xovFY0k5uBNSRtAzFuY2xcGA==',
            'https://customs.amital.co.il/api/SignHSMGetActiveCertificates',
            'https://customs.amital.co.il/api/SignHSM'
        FROM dual
        WHERE '1' NOT IN (SELECT ID FROM AMINET_MAIN.CUSTOMSENVIRONMENTSETTINGS);
    ELSE
         INSERT INTO AMINET_MAIN.CUSTOMSENVIRONMENTSETTINGS (
            ID,
            ENVIRONMENTCODE,
            USERABBITMQ,
            RABBITHOST,
            RABBITUSERNAME,
            RABBITPASSWORD,
            HSMSIGNPROCESS,
            HSMTOKEN,
            HSMACTIVECERTURL,
            HSMSIGNSERVICEURL
        )
        SELECT
            '1',
            '0',
            0,
            null,
            null,
            null,
            'Customs',
            '9edYig7zg_b2mBV-72DaOKVMlqtJp-xovFY0k5uBNSRtAzFuY2xcGA==',
            'https://customs.amital.co.il/api/SignHSMGetActiveCertificates',
            'https://customs.amital.co.il/api/SignHSM'
        FROM dual
        WHERE '1' NOT IN (SELECT ID FROM AMINET_MAIN.CUSTOMSENVIRONMENTSETTINGS);     

    END IF;
END;
/


    ]]>
  </Oracle>
</Script>