<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
  <Sql Version="2">

    <![CDATA[
    INSERT INTO customs.COURIERPENDINGREASONS (CODE,LOCALNAME,SEARCHFIELDS,ENGLISHNAME,INACTIVE,ERRORPLACE,TENANT,UNIFREIGHTSTATUSCODE,ID) 
SELECT '905', 'משלוח לא לישראל' ,'משלוח לא לישראל,Shipping not to Israel,905','Shipping not to Israel',0,null, T.ID, NULL, '905'+convert(varchar,T.ID)
FROM (
  SELECT ID
  FROM TENANTS
) AS T
WHERE NOT EXISTS (
  SELECT *
  FROM customs.COURIERPENDINGREASONS
  WHERE CODE = '905' AND TENANT = T.ID
);
commit;

     ]]>
  </Sql>

  <Oracle Version="6">
    <![CDATA[
 



INSERT INTO COURIERPENDINGREASONS (CODE,LOCALNAME,SEARCHFIELDS,ENGLISHNAME,INACTIVE,ERRORPLACE,TENANT,UNIFREIGHTSTATUSCODE,ID) 
SELECT '905', 'משלוח לא לישראל' ,'משלוח לא לישראל,Shipping not to Israel,905','Shipping not to Israel',0,null, T.ID, NULL, '905'||TO_CHAR(T.ID)
FROM (
  SELECT ID
  FROM TENANTS
) T
WHERE NOT EXISTS (
  SELECT *
  FROM COURIERPENDINGREASONS
  WHERE CODE = '905' AND TENANT = T.ID
);



commit;


    ]]>
  </Oracle>
</Script>