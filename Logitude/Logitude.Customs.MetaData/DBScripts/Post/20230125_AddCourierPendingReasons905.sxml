  <Oracle Version="4">
    <![CDATA[
 declare
 n int := 0;
begin
  select count(*) into n
  from COURIERPENDINGREASONS
 where code='905';
 if n = 0 then
 
Insert into 
COURIERPENDINGREASONS (CODE,LOCALNAME,SEARCHFIELDS,ENGLISHNAME,INACTIVE,ERRORPLACE,TENANT,UNIFREIGHTSTATUSCODE,ID) 
values ('905', 'משלוח לא לישראל' ,'משלוח לא לישראל,Shipping not to Israel,905','Shipping not to Israel',0,null,1,null,'905');


commit;
  end if;
end;

    ]]>
  </Oracle>
</Script>