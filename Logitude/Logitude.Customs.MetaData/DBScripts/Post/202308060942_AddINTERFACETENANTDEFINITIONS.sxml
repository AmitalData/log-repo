<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
  <Sql Version="1">

	  <![CDATA[
   INSERT INTO Customs.INTERFACETENANTDEFINITIONS
   SELECT '1-999'+convert(varchar,ID),ID,'UCB2715SendNow',null,5,1,0,null,null,0,null,null FROM Tenants
  WHERE Id!=0 and ID not in(select TENANT from Customs.INTERFACETENANTDEFINITIONS where Code='UCB2715SendNow' );
        ]]>
  </Sql>

  <Oracle Version="1">
    <![CDATA[
    INSERT INTO INTERFACETENANTDEFINITIONS
    SELECT '1-999'||TO_CHAR(ID),ID,'UCB2715SendNow',null,5,1,0,null,null,0,null,null FROM Tenants
    WHERE Id!=0 and ID not in(select TENANT from INTERFACETENANTDEFINITIONS where Code='UCB2715SendNow' );
    commit;
 

    ]]>
  </Oracle>
</Script>