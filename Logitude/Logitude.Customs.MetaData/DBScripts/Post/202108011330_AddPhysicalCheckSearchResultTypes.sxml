<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" >
  <Sql Version="1">
  </Sql>

  <Oracle Version="1">
    <![CDATA[
             declare
 n int := 0;
begin
  select count(*) into n
  from PhysicalCheckSearchResultTypes
 where code='3';
  if n = 0 then
 insert into PhysicalCheckSearchResultTypes values ('3','בדיקה הסתיימה בתוצאות תקינות','בדיקה הסתיימה בתוצאות תקינות');
 insert into PhysicalCheckSearchResultTypes values ('4','הבדיקה הסתיימה בתוצאות לא תקינות','הבדיקה הסתיימה בתוצאות לא תקינות');

            end if;
end;

    ]]>
  </Oracle>
</Script>