<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
  <Sql Version="1">
  </Sql>

  <Oracle Version="1">
    <![CDATA[
update declarations set REQUESTEDCUSTOMSDOCID = 1 where id in (

select p.PARENTENTITYID from CUSTOMSDOCUMENTPOINTERS p inner join CUSTOMSDOCUMENTSTICKETS t 
on p.CUSTOMSDOCUMENTSTICKETID = t.ID
where t.REQUESTEDCUSTOMSDOCID is not null and t.VERIFICATIONSTATUSTYPECODE is null and p.PARENTENTITYCODE ='Declaration');commit;

    ]]>
  </Oracle>
</Script>