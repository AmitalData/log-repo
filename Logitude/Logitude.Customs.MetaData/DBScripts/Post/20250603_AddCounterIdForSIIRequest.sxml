<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
	<Sql Version="1">
		<![CDATA[
    IF NOT EXISTS (
        SELECT 1
        FROM   dbo.DBIdCounters
        WHERE  TableName = 'SIIRequest'
    )
    BEGIN
        INSERT INTO dbo.DBIdCounters
              (ROWID, TableName, CurrentValue, LastUpdated)
        VALUES (NEWID(), 'SIIRequest', 0, GETDATE());
    END
  ]]>
	</Sql>

	<Oracle Version="2">
		<![CDATA[
    MERGE INTO DBIdCounters t
    USING (SELECT 'SIIRequest' AS TableName FROM dual) s
      ON (t.TableName = s.TableName)
    WHEN NOT MATCHED THEN
      INSERT (ID,            
              TableName,
              LastIdNumber)  
      VALUES (DBIDCOUNTERS_SEQ.NEXTVAL, 
              s.TableName,
              0);                        

    COMMIT;
  ]]>
	</Oracle>
</Script>
