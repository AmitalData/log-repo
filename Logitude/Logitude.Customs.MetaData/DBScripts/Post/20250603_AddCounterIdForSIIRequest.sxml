<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
	<Sql Version="2">
		<![CDATA[
   
  ]]>
	</Sql>

	<Oracle Version="2">
		<![CDATA[
     -- 1) SIIRequest
      MERGE INTO DBIdCounters t
      USING (SELECT 'SIIRequest' AS TableName FROM dual) s
        ON (t.TableName = s.TableName)
      WHEN NOT MATCHED THEN
        INSERT (ID, TableName, LastIdNumber)
        VALUES (DBIDCOUNTERS_SEQ.NEXTVAL, s.TableName, 0);

      -- 2) ComputingPartner
      MERGE INTO DBIdCounters t
      USING (SELECT 'ComputingPartner' AS TableName FROM dual) s
        ON (t.TableName = s.TableName)
      WHEN NOT MATCHED THEN
        INSERT (ID, TableName, LastIdNumber)
        VALUES (DBIDCOUNTERS_SEQ.NEXTVAL, s.TableName, 0);

      -- 3) ComputingPartnerTranslation
      MERGE INTO DBIdCounters t
      USING (SELECT 'ComputingPartnerTranslation' AS TableName FROM dual) s
        ON (t.TableName = s.TableName)
      WHEN NOT MATCHED THEN
        INSERT (ID, TableName, LastIdNumber)
        VALUES (DBIDCOUNTERS_SEQ.NEXTVAL, s.TableName, 0);

      COMMIT;
  ]]>
	</Oracle>
</Script>
