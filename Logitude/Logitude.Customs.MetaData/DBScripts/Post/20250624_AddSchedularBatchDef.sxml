<?xml version="1.0" encoding="utf-8"?>
<Script DBType="global" Module="Customs" Pre="false">
	<Sql Version="1">

		<![CDATA[
        ]]>
	</Sql>
  
  <Oracle Version="2">
	  MERGE INTO batchservicesdefinitions  tgt
	  USING (SELECT 'CustomsSchedularWR' AS CODE,
	  'CustomsSchedularWR' AS CLASSNAME,
	  NULL                 AS PARAMETER1,
	  NULL                 AS PARAMETER2,
	  NULL                 AS QUEUEDEFINITIONCODE,
	  0                    AS USERABBITMQ
	  FROM   dual) src
	  ON (tgt.CODE = src.CODE)
	  WHEN NOT MATCHED THEN
	  INSERT (CODE, CLASSNAME, PARAMETER1, PARAMETER2,
	  QUEUEDEFINITIONCODE, USERABBITMQ)
	  VALUES (src.CODE, src.CLASSNAME, src.PARAMETER1, src.PARAMETER2,
	  src.QUEUEDEFINITIONCODE, src.USERABBITMQ);

	  MERGE INTO batchservicesdefinitionmods  tgt
	  USING (SELECT 'CustomsSchedularWR' AS CODE,
	  0                   AS INACTIVE,
	  1                   AS NUMBEROFTHREADS
	  FROM   dual) src
	  ON (tgt.CODE = src.CODE)
	  WHEN NOT MATCHED THEN
	  INSERT (CODE, INACTIVE, NUMBEROFTHREADS)
	  VALUES (src.CODE, src.INACTIVE, src.NUMBEROFTHREADS);

	  commit;
  </Oracle>
</Script>