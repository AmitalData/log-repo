<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
	<Sql Version="2">
		<![CDATA[
       IF NOT EXISTS(SELECT * FROM sys.indexes WHERE name = 'IX_COURIERDECLARATIONS_DECLARATIONID' AND object_id = OBJECT_ID('Customs.COURIERDECLARATIONS'))
    BEGIN
        CREATE UNIQUE INDEX IX_COURIERDECLARATIONS_DECLARATIONID
        ON Customs.COURIERDECLARATIONS (DECLARATIONID)
    END

       IF NOT EXISTS(SELECT * FROM sys.indexes WHERE name = 'PIX_DECLARATIONCOURIERSTATUSES_TENANT_ISCLOSEDFORFOLLOWUP_COURIERPENDINGREASONLIST' AND object_id = OBJECT_ID('Customs.DeclarationCourierStatuses'))
    BEGIN
        CREATE INDEX PIX_DECLARATIONCOURIERSTATUSES_TENANT_ISCLOSEDFORFOLLOWUP_COURIERPENDINGREASONLIST
        ON Customs.DeclarationCourierStatuses (Tenant, IsClosedForFollowUp, CourierPendingReasonList)
    END

       IF NOT EXISTS(SELECT * FROM sys.indexes WHERE name = 'PIX_DECLARATIONS_TENANT_ISCANCELLED_AMENDMENTDONTDISPLAYINLIST' AND object_id = OBJECT_ID('Customs.DECLARATIONS'))
    BEGIN
        CREATE COLUMNSTORE INDEX PIX_DECLARATIONS_TENANT_ISCANCELLED_AMENDMENTDONTDISPLAYINLIST
        ON Customs.DECLARATIONS (TENANT, AMENDMENTDONTDISPLAYINLIST, ISCANCELLED)
    END

      IF NOT EXISTS(SELECT * FROM sys.indexes WHERE name = 'PIX_DECLARATIONS_TENANT_ISCANCELLED_AMENDMENTDONTDISPLAYINLIST_COURIERCUSTOMSTATUSCODE' AND object_id = OBJECT_ID('Customs.DECLARATIONS'))
    BEGIN
 
    	CREATE NONCLUSTERED INDEX [PIX_DECLARATIONS_TENANT_ISCANCELLED_AMENDMENTDONTDISPLAYINLIST_COURIERCUSTOMSTATUSCODE] 
		ON Customs.DECLARATIONS (TENANT, COURIERCUSTOMSTATUSCODE, AMENDMENTDONTDISPLAYINLIST, ISCANCELLED)
    END

        ]]>
	</Sql>

	<Oracle Version="2">
		<![CDATA[
		DECLARE
        i INTEGER;
    BEGIN
        SELECT COUNT(*) INTO i FROM    all_indexes
    WHERE   table_name = 'COURIERDECLARATIONS' and (index_name='IX_COURIERDECLARATIONS_DECLARATIONID' or index_name = 'IX_DECLARATIONTENANT');
        IF i = 0 THEN
            EXECUTE IMMEDIATE 'CREATE UNIQUE INDEX IX_COURIERDECLARATIONS_DECLARATIONID
            ON COURIERDECLARATIONS (DECLARATIONID)';
        END IF;
    END;
	
		DECLARE
        i INTEGER;
    BEGIN
        SELECT COUNT(*) INTO i FROM    all_indexes
    WHERE   table_name = 'DECLARATIONCOURIERSTATUSES' and index_name='PIX_DECLARATIONCOURIERSTATUSES_TENANT_ISCLOSEDFORFOLLOWUP_COURIERPENDINGREASONLIST';
        IF i = 0 THEN
            EXECUTE IMMEDIATE 'CREATE INDEX PIX_DECLARATIONCOURIERSTATUSES_TENANT_ISCLOSEDFORFOLLOWUP_COURIERPENDINGREASONLIST
            ON DeclarationCourierStatuses (Tenant, IsClosedForFollowUp, CourierPendingReasonList)';
        END IF;
    END;
	
		DECLARE
        i INTEGER;
    BEGIN
        SELECT COUNT(*) INTO i FROM    all_indexes
    WHERE   table_name = 'DECLARATIONS' and index_name='PIX_DECLARATIONS_TENANT_ISCANCELLED_AMENDMENTDONTDISPLAYINLIST';
        IF i = 0 THEN
            EXECUTE IMMEDIATE 'CREATE INDEX PIX_DECLARATIONS_TENANT_ISCANCELLED_AMENDMENTDONTDISPLAYINLIST
            ON DECLARATIONS (TENANT, AMENDMENTDONTDISPLAYINLIST, ISCANCELLED)';
        END IF;
    END;
	
		DECLARE
        i INTEGER;
    BEGIN
        SELECT COUNT(*) INTO i FROM    all_indexes
    WHERE   table_name = 'DECLARATIONS' and index_name='PIX_DECLARATIONS_TENANT_ISCANCELLED_AMENDMENTDONTDISPLAYINLIST_COURIERCUSTOMSTATUSCODE';
        IF i = 0 THEN
            EXECUTE IMMEDIATE 'CREATE INDEX PIX_DECLARATIONS_TENANT_ISCANCELLED_AMENDMENTDONTDISPLAYINLIST_COURIERCUSTOMSTATUSCODE
            ON DECLARATIONS (TENANT, COURIERCUSTOMSTATUSCODE, AMENDMENTDONTDISPLAYINLIST, ISCANCELLED)';
        END IF;
    END;

        ]]>
	</Oracle>
</Script>