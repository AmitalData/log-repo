<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
	<Sql Version="1">
		<![CDATA[
    /* ---------- Insert ComputingPartner 'SII-1' if not exists ---------- */
    IF NOT EXISTS (
        SELECT 1
        FROM ComputingPartners
        WHERE ID = 'SII-1'
    )
    BEGIN
        INSERT INTO ComputingPartners (
            ID,
            NAME,
            CREATEDATE,
            UPDATEDATE,
            CREATEDBYUSERID,
            UPDATEDBYUSERID,
            REMARKS,
            SEARCHFIELDS,
            CODE,
            TENANT,
            DESCRIPTION,
            INACTIVE
        )
        VALUES (
            'SII-1',
            'SIIRequest',
            GETDATE(),
            GETDATE(),
            '1-9',
            '1-9',
            NULL,
            'SIIRequest',
            'SIIRequest',
            18,
            NULL,
            0
        );
    END

    /* ---------- Insert into ComputingPartnerTables for Customs.UnloadingSiteType ---------- */
    IF NOT EXISTS (
        SELECT 1
        FROM ComputingPartnerTables
        WHERE OBJECTTABLEID = (SELECT ID FROM ObjectTables WHERE NAME = 'Customs.UnloadingSiteType')
          AND COMPUTINGPARTNERID = 'SII-1'
    )
    BEGIN
        INSERT INTO ComputingPartnerTables (
            OBJECTTABLEID,
            COMPUTINGPARTNERID,
            TENANT,
            NAME,
            HASPARTNERLIST,
            MUSTUSEPARTNERLIST,
            TRANSALATIONREQUIRED,
            TENANTLEVELTRANSLATIONBLOCKED,
            CREATEDATE,
            UPDATEDATE,
            CREATEDBYUSERID,
            UPDATEDBYUSERID
        )
        SELECT
            ID,
            'SII-1',
            1,
            'SIIRequest',
            0, 0, 0, 0,
            GETDATE(),
            GETDATE(),
            '1-9',
            '1-9'
        FROM ObjectTables
        WHERE NAME = 'Customs.UnloadingSiteType';
    END

    /* ---------- Insert into ComputingPartnerTables for Customs.MeasurmentUnit ---------- */
    IF NOT EXISTS (
        SELECT 1
        FROM ComputingPartnerTables
        WHERE OBJECTTABLEID = (SELECT ID FROM ObjectTables WHERE NAME = 'Customs.MeasurmentUnit')
          AND COMPUTINGPARTNERID = 'SII-1'
    )
    BEGIN
        INSERT INTO ComputingPartnerTables (
            OBJECTTABLEID,
            COMPUTINGPARTNERID,
            TENANT,
            NAME,
            HASPARTNERLIST,
            MUSTUSEPARTNERLIST,
            TRANSALATIONREQUIRED,
            TENANTLEVELTRANSLATIONBLOCKED,
            CREATEDATE,
            UPDATEDATE,
            CREATEDBYUSERID,
            UPDATEDBYUSERID
        )
        SELECT
            ID,
            'SII-1',
            1,
            'SIIRequest',
            0, 0, 0, 0,
            GETDATE(),
            GETDATE(),
            '1-9',
            '1-9'
        FROM ObjectTables
        WHERE NAME = 'Customs.MeasurmentUnit';
    END
    ]]>
	</Sql>

	<Oracle Version="1">
		<![CDATA[
    MERGE INTO ComputingPartners d
    USING (
        SELECT 'SII-1' AS ID,
               'SIIRequest' AS NAME,
               SYSDATE AS CREATEDATE,
               SYSDATE AS UPDATEDATE,
               '1-9' AS CREATEDBYUSERID,
               '1-9' AS UPDATEDBYUSERID,
               NULL AS REMARKS,
               'SIIRequest' AS SEARCHFIELDS,
               'SIIRequest' AS CODE,
               1 AS TENANT,
               NULL AS DESCRIPTION,
               0 AS INACTIVE
        FROM dual
    ) src
    ON (d.ID = src.ID)
    WHEN NOT MATCHED THEN
      INSERT (ID, NAME, CREATEDATE, UPDATEDATE, CREATEDBYUSERID, UPDATEDBYUSERID, REMARKS, SEARCHFIELDS, CODE, TENANT, DESCRIPTION, INACTIVE)
      VALUES (src.ID, src.NAME, src.CREATEDATE, src.UPDATEDATE, src.CREATEDBYUSERID, src.UPDATEDBYUSERID, src.REMARKS, src.SEARCHFIELDS, src.CODE, src.TENANT, src.DESCRIPTION, src.INACTIVE);

    MERGE INTO ComputingPartnerTables d
    USING (
        SELECT (SELECT ID FROM ObjectTables WHERE NAME = 'Customs.UnloadingSiteType') AS OBJECTTABLEID,
               'SII-1' AS COMPUTINGPARTNERID,
               1 AS TENANT,
               'SIIRequest' AS NAME,
               0 AS HASPARTNERLIST,
               0 AS MUSTUSEPARTNERLIST,
               0 AS TRANSALATIONREQUIRED,
               0 AS TENANTLEVELTRANSLATIONBLOCKED,
               SYSDATE AS CREATEDATE,
               SYSDATE AS UPDATEDATE,
               '1-9' AS CREATEDBYUSERID,
               '1-9' AS UPDATEDBYUSERID
        FROM dual
    ) src
    ON (d.OBJECTTABLEID = src.OBJECTTABLEID AND d.COMPUTINGPARTNERID = src.COMPUTINGPARTNERID)
    WHEN NOT MATCHED THEN
      INSERT (OBJECTTABLEID, COMPUTINGPARTNERID, TENANT, NAME, HASPARTNERLIST, MUSTUSEPARTNERLIST, TRANSALATIONREQUIRED, TENANTLEVELTRANSLATIONBLOCKED, CREATEDATE, UPDATEDATE, CREATEDBYUSERID, UPDATEDBYUSERID)
      VALUES (src.OBJECTTABLEID, src.COMPUTINGPARTNERID, src.TENANT, src.NAME, src.HASPARTNERLIST, src.MUSTUSEPARTNERLIST, src.TRANSALATIONREQUIRED, src.TENANTLEVELTRANSLATIONBLOCKED, src.CREATEDATE, src.UPDATEDATE, src.CREATEDBYUSERID, src.UPDATEDBYUSERID);

    MERGE INTO ComputingPartnerTables d
    USING (
        SELECT (SELECT ID FROM ObjectTables WHERE NAME = 'Customs.MeasurmentUnit') AS OBJECTTABLEID,
               'SII-1' AS COMPUTINGPARTNERID,
               1 AS TENANT,
               'SIIRequest' AS NAME,
               0 AS HASPARTNERLIST,
               0 AS MUSTUSEPARTNERLIST,
               0 AS TRANSALATIONREQUIRED,
               0 AS TENANTLEVELTRANSLATIONBLOCKED,
               SYSDATE AS CREATEDATE,
               SYSDATE AS UPDATEDATE,
               '1-9' AS CREATEDBYUSERID,
               '1-9' AS UPDATEDBYUSERID
        FROM dual
    ) src
    ON (d.OBJECTTABLEID = src.OBJECTTABLEID AND d.COMPUTINGPARTNERID = src.COMPUTINGPARTNERID)
    WHEN NOT MATCHED THEN
      INSERT (OBJECTTABLEID, COMPUTINGPARTNERID, TENANT, NAME, HASPARTNERLIST, MUSTUSEPARTNERLIST, TRANSALATIONREQUIRED, TENANTLEVELTRANSLATIONBLOCKED, CREATEDATE, UPDATEDATE, CREATEDBYUSERID, UPDATEDBYUSERID)
      VALUES (src.OBJECTTABLEID, src.COMPUTINGPARTNERID, src.TENANT, src.NAME, src.HASPARTNERLIST, src.MUSTUSEPARTNERLIST, src.TRANSALATIONREQUIRED, src.TENANTLEVELTRANSLATIONBLOCKED, src.CREATEDATE, src.UPDATEDATE, src.CREATEDBYUSERID, src.UPDATEDBYUSERID);
    ]]>
	</Oracle>
</Script>
