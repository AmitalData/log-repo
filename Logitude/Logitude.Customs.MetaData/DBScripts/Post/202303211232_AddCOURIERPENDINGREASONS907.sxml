<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
  <Sql Version="2">

	  <![CDATA[
      INSERT INTO COURIERPENDINGREASONS (CODE,LOCALNAME,SEARCHFIELDS,ENGLISHNAME,INACTIVE,ERRORPLACE,TENANT,UNIFREIGHTSTATUSCODE,ID)
SELECT '907', 'כמות סחורה' ,'כמות סחורה,Quantity Of Goods,907','Quantity Of Goods',0,null, T.ID, NULL,'907'+convert(varchar,T.ID)
FROM (
  SELECT ID
  FROM TENANTS
) T
WHERE NOT EXISTS (
  SELECT *
  FROM COURIERPENDINGREASONS
  WHERE CODE = '907' AND TENANT = T.ID
);



commit;
        ]]>
  </Sql>

  <Oracle Version="2">
    <![CDATA[
 

INSERT INTO COURIERPENDINGREASONS (CODE,LOCALNAME,SEARCHFIELDS,ENGLISHNAME,INACTIVE,ERRORPLACE,TENANT,UNIFREIGHTSTATUSCODE,ID)
SELECT '907', 'כמות סחורה' ,'כמות סחורה,Quantity Of Goods,907','Quantity Of Goods',0,null, T.ID, NULL, '907'||TO_CHAR(T.ID)
FROM (
  SELECT ID
  FROM TENANTS
) T
WHERE NOT EXISTS (
  SELECT *
  FROM COURIERPENDINGREASONS
  WHERE CODE = '907' AND TENANT = T.ID
);



commit;



    ]]>
  </Oracle>
</Script>