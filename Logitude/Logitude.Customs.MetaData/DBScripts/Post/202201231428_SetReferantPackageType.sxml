<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
  <Sql Version="1">
  </Sql>

  <Oracle Version="1">
    <![CDATA[

UPDATE DECLARATIONREFERANTDATAS d
SET PACKAGETYPECODE = (SELECT PACKAGETYPECODE
               FROM CONSIGNMENTPACKAGES p              
               WHERE p.declarationid =d.declarationid and  p.PACKAGEMEASUREQUALIFIERCODE = '2'
               FETCH NEXT 1 ROWS ONLY)
WHERE d.PACKAGETYPECODE is null and  (D.ISCLOSEDFORFOLLOWUP is null or D.ISCLOSEDFORFOLLOWUP = 0 );


    ]]>
  </Oracle>
</Script>