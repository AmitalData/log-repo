<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
	<Sql Version="1">

		<![CDATA[
			IF NOT EXISTS (
          SELECT 1
          FROM customs.CustomsEnvironmentSettings
      )
      BEGIN
          INSERT INTO customs.CustomsEnvironmentSettings (
              ID,
              ENVIRONMENTCODE,
              USERABBITMQ,
              RABBITHOST,
              RABBITUSERNAME,
              RABBITPASSWORD,
              HSMSignProcess, 
              HSMToken, 
              HSMActiveCertUrl, 
              HSMSignServiceUrl
          ) 
          VALUES (
              '1', -- ID value
              'prod', -- ENVIRONMENTCODE value
              0, -- USERABBITMQ value
              'unimq', -- RABBITHOST value
              'v5101', -- RABBITUSERNAME value
              'Aa123', -- RABBITPASSWORD value
              'Ecom', 
              'CM3Xqwa7fCrIkFpayEXw1hBaCnI7w7EsBoaPjP0FhxADAzFuo0tLew==', 
              'http://signhsm-10.azurewebsites.net/api/SignHSMGetActiveCertificates', 
              'http://signhsm-10.azurewebsites.net/api/SIGNHSM'
          );
      END
      ELSE
      BEGIN
          UPDATE customs.CustomsEnvironmentSettings 
          SET 
              HSMSignProcess = 'Ecom', 
              HSMToken = 'CM3Xqwa7fCrIkFpayEXw1hBaCnI7w7EsBoaPjP0FhxADAzFuo0tLew==',
              HSMActiveCertUrl = 'http://signhsm-10.azurewebsites.net/api/SignHSMGetActiveCertificates',
              HSMSignServiceUrl = 'http://signhsm-10.azurewebsites.net/api/SIGNHSM'
          WHERE 
              HSMSignProcess IS NULL OR 
              HSMToken IS NULL OR 
              HSMActiveCertUrl IS NULL OR 
              HSMSignServiceUrl IS NULL;
      END
        ]]>
	</Sql>
  
  <Oracle Version="1">
    <![CDATA[
			
      DECLARE
          cnt NUMBER;
      BEGIN
          SELECT COUNT(1) INTO cnt FROM CustomsEnvironmentSettings;

          IF cnt = 0 THEN
              INSERT INTO CustomsEnvironmentSettings (
                  ID,
                  ENVIRONMENTCODE,
                  USERABBITMQ,
                  RABBITHOST,
                  RABBITUSERNAME,
                  RABBITPASSWORD,
                  HSMSignProcess, 
                  HSMToken, 
                  HSMActiveCertUrl, 
                  HSMSignServiceUrl
              ) 
              VALUES (
                  '1', -- ID value
                  'prod', -- ENVIRONMENTCODE value
                  0, -- USERABBITMQ value
                  'unimq', -- RABBITHOST value
                  'v5101', -- RABBITUSERNAME value
                  'Aa123', -- RABBITPASSWORD value
                  'Ecom', 
                  'CM3Xqwa7fCrIkFpayEXw1hBaCnI7w7EsBoaPjP0FhxADAzFuo0tLew==', 
                  'http://signhsm-10.azurewebsites.net/api/SignHSMGetActiveCertificates', 
                  'http://signhsm-10.azurewebsites.net/api/SIGNHSM'
              );
          ELSE
              UPDATE CustomsEnvironmentSettings 
              SET 
                  HSMSignProcess = 'Ecom', 
                  HSMToken = 'CM3Xqwa7fCrIkFpayEXw1hBaCnI7w7EsBoaPjP0FhxADAzFuo0tLew==',
                  HSMActiveCertUrl = 'http://signhsm-10.azurewebsites.net/api/SignHSMGetActiveCertificates',
                  HSMSignServiceUrl = 'http://signhsm-10.azurewebsites.net/api/SIGNHSM'
              WHERE 
                  HSMSignProcess IS NULL OR 
                  HSMToken IS NULL OR 
                  HSMActiveCertUrl IS NULL OR 
                  HSMSignServiceUrl IS NULL;
          END IF;
      END;
        ]]>
  </Oracle>
</Script>