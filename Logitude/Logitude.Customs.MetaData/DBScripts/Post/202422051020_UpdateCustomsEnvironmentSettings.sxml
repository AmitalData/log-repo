<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
	<Sql Version="4">

		<![CDATA[
			IF NOT EXISTS (
          SELECT 1
          FROM customs.CustomsEnvironmentSettings
      )
      BEGIN
          INSERT INTO customs.CustomsEnvironmentSettings (
              ID,
              ENVIRONMENTCODE,
              USERABBITMQ,
              RABBITHOST,
              RABBITUSERNAME,
              RABBITPASSWORD,
              HSMSignProcess, 
              HSMToken, 
              HSMActiveCertUrl, 
              HSMSignServiceUrl
          ) 
          VALUES (
              '1', -- ID value
              'prod', -- ENVIRONMENTCODE value
              0, -- USERABBITMQ value

              null, -- RABBITHOST value
              null, -- RABBITUSERNAME value
              null, -- RABBITPASSWORD value
              'Customs', 
              'CM3Xqwa7fCrIkFpayEXw1hBaCnI7w7EsBoaPjP0FhxADAzFuo0tLew==', 
              'https://customs.amital.co.il/api/SignHSMGetActiveCertificates', 
              'https://customs.amital.co.il/api/SignHSM'
          );
      END
      ELSE
      BEGIN
          UPDATE customs.CustomsEnvironmentSettings 
          SET 
              HSMSignProcess = 'Customs', 
              HSMToken = 'CM3Xqwa7fCrIkFpayEXw1hBaCnI7w7EsBoaPjP0FhxADAzFuo0tLew==',
              HSMActiveCertUrl = 'https://customs.amital.co.il/api/SignHSMGetActiveCertificates',
              HSMSignServiceUrl = 'https://customs.amital.co.il/api/SignHSM'
          WHERE 
              HSMSignProcess IS NULL OR 
              HSMToken IS NULL OR 
              HSMActiveCertUrl IS NULL OR 
              HSMSignServiceUrl IS NULL;
      END
        ]]>
	</Sql>
  
  <Oracle Version="3">
    <![CDATA[
			
      DECLARE
          cnt NUMBER;
      BEGIN
          SELECT COUNT(1) INTO cnt FROM CustomsEnvironmentSettings;

          IF cnt = 0 THEN
              INSERT INTO CustomsEnvironmentSettings (
                  ID,
                  ENVIRONMENTCODE,
                  USERABBITMQ,
                  RABBITHOST,
                  RABBITUSERNAME,
                  RABBITPASSWORD,
                  HSMSignProcess, 
                  HSMToken, 
                  HSMActiveCertUrl, 
                  HSMSignServiceUrl
              ) 
              VALUES (
                  '1', -- ID value
                  'prod', -- ENVIRONMENTCODE value
                  0, -- USERABBITMQ value
                  null, -- RABBITHOST value
                  null, -- RABBITUSERNAME value
                  null, -- RABBITPASSWORD value
                  'Customs', 
                  'CM3Xqwa7fCrIkFpayEXw1hBaCnI7w7EsBoaPjP0FhxADAzFuo0tLew==', 
                  'https://customs.amital.co.il/api/SignHSMGetActiveCertificates', 
                  'https://customs.amital.co.il/api/SignHSM'
              );
          ELSE
              UPDATE CustomsEnvironmentSettings 
              SET 
                  HSMSignProcess = 'Customs', 
                  HSMToken = 'CM3Xqwa7fCrIkFpayEXw1hBaCnI7w7EsBoaPjP0FhxADAzFuo0tLew==',
                  HSMActiveCertUrl = 'https://customs.amital.co.il/api/SignHSMGetActiveCertificates',
                  HSMSignServiceUrl = 'https://customs.amital.co.il/api/SignHSM'
              WHERE 
                  HSMSignProcess IS NULL OR 
                  HSMToken IS NULL OR 
                  HSMActiveCertUrl IS NULL OR 
                  HSMSignServiceUrl IS NULL;
          END IF;
      END;
        ]]>
  </Oracle>
</Script>