<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
  <!--post-->
  <Sql Version="1">
    UPDATE  customs.CUSTOMSSETTINGS  SET
    SUPPRESSIIGMESSAGEFROMDATE =convert(datetime, '2023-01-12 02:00:00', 120)   ,
    SUPPRESSIIGMESSAGETODATE   =convert(datetime, '2023-01-15 05:00:00', 120)
    WHERE CUSTOMSAGENTID IS NOT NULL;

  </Sql>
  <Oracle Version="1">
    <![CDATA[
  
UPDATE  CUSTOMSSETTINGS  SET   
SUPPRESSIIGMESSAGEFROMDATE =TO_TIMESTAMP  ('2023-01-12 02:00:00','yyyy/mm/dd hh24:mi:ss')   ,
SUPPRESSIIGMESSAGETODATE   =TO_TIMESTAMP  ('2023-01-15 05:00:00','yyyy/mm/dd hh24:mi:ss')     
WHERE CUSTOMSAGENTID IS NOT NULL;

    ]]>
  </Oracle>
</Script>