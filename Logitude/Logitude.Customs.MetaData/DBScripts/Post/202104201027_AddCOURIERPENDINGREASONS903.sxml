<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
  <Sql Version="2">

    <![CDATA[
    INSERT INTO COURIERPENDINGREASONS (CODE,LOCALNAME,SEARCHFIELDS,ENGLISHNAME,INACTIVE,ERRORPLACE,TENANT,UNIFREIGHTSTATUSCODE,ID) 
SELECT '903','מספר טלפון לא תקין','Invalid phone number,מספר טלפון לא תקין,903','Invalid phone number',0,'1', T.ID, NULL,'903'+convert(varchar,T.ID)
FROM (
  SELECT ID
  FROM TENANTS
) T
WHERE NOT EXISTS (
  SELECT *
  FROM COURIERPENDINGREASONS
  WHERE CODE = '903' AND TENANT = T.ID
);



commit;
     ]]>
  </Sql>

  <Oracle Version="5">
    <![CDATA[

INSERT INTO COURIERPENDINGREASONS (CODE,LOCALNAME,SEARCHFIELDS,ENGLISHNAME,INACTIVE,ERRORPLACE,TENANT,UNIFREIGHTSTATUSCODE,ID) 
SELECT '903','מספר טלפון לא תקין','Invalid phone number,מספר טלפון לא תקין,903','Invalid phone number',0,'1', T.ID, NULL,'903'||TO_CHAR(T.ID)
FROM (
  SELECT ID
  FROM TENANTS
) T
WHERE NOT EXISTS (
  SELECT *
  FROM COURIERPENDINGREASONS
  WHERE CODE = '903' AND TENANT = T.ID
);



commit;

    ]]>
  </Oracle>
</Script>