<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
	<Sql Version="1">
	</Sql>

	<Oracle Version="1">
		<![CDATA[
update declarationcourierstatuses set TerminalReleaseDate = ( select hatradate from declarations where declarationcourierstatuses.declarationid = declarations.id) 
where (select hatradate from declarations where declarationcourierstatuses.declarationid = declarations.id) is not null and TerminalReleaseDate is null;
  
    ]]>
	</Oracle>
</Script>