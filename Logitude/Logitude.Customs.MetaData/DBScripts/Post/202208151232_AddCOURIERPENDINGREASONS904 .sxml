<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
  <Sql Version="1">
  </Sql>

  <Oracle Version="5">
    <![CDATA[
 declare
 n int := 0;
begin
  select count(*) into n
  from COURIERPENDINGREASONS
 where code='904';
 if n = 0 then
 


INSERT INTO COURIERPENDINGREASONS (CODE, LOCALNAME, SEARCHFIELDS, ENGLISHNAME, INACTIVE, ERRORPLACE, TENANT, UNIFREIGHTSTATUSCODE, ID)
SELECT '904', 'Weight', 'Weight,904', 'Weight', 0, NULL, T.ID, NULL, '904'
FROM (SELECT ID FROM TENANTS) T
WHERE NOT EXISTS (
  SELECT *
  FROM COURIERPENDINGREASONS
  WHERE CODE = '904' AND TENANT = T.ID
);



commit;
  end if;
end;

    ]]>
  </Oracle>
</Script>