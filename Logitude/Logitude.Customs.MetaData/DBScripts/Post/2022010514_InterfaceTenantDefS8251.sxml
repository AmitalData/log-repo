<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
	<Sql Version="1">
	</Sql>

	<Oracle Version="4">
		<![CDATA[
		            declare
 n int := 0;
begin
  select count(*) into n
  from INTERFACETENANTDEFINITIONS
 where code='8251';
  if n = 0 then
  insert into INTERFACETENANTDEFINITIONS values ('1-999','1','8251','','2','0','1','',null,0,null,null); 
  else
  update INTERFACETENANTDEFINITIONS set active=
 case 
 when ((select companytype from CustomsSettingS where companytype='B')  in ('B')) then 0
 ELSE 1
 END
 where code ='8251';
 end if;
end;
  
    ]]>
	</Oracle>
</Script>