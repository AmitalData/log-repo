<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs">
	<Sql Version="1">
	</Sql>

	<Oracle Version="7">
		<![CDATA[
declare 
 v_count number;
begin
select count(*) into v_count from CustomsSettings where companytype='B';

if v_count > 0 then
begin
  insert into INTERFACETENANTDEFINITIONS (id,tenant,code,TenantSendOptionsCode,TenantPriority,active,DcaRenameFileEnable,DcaRenameFilePrefix)values ('1-999',1,'8251','','2','0','1',''); 
  commit;
exception
  when DUP_VAL_ON_INDEX
  then ROLLBACK;
end;

end if;
end;
    ]]>
	</Oracle>
</Script>



