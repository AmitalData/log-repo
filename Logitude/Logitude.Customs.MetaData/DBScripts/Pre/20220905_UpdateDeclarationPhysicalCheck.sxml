<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs"  Pre="true">
	<Sql Version="1">
	</Sql>

	<Oracle Version="3">
		<![CDATA[
		declare
 n int := 0;
begin
EXECUTE IMMEDIATE 'alter table DECLARATIONS add (PHYSICALCHECK_temp VARCHAR2(15 CHAR))';
EXECUTE IMMEDIATE 'update DECLARATIONS set PHYSICALCHECK_temp = TO_CHAR(PHYSICALCHECK)';
EXECUTE IMMEDIATE 'update DECLARATIONS set PHYSICALCHECK = NULL';
EXECUTE IMMEDIATE 'commit';
EXECUTE IMMEDIATE 'alter table DECLARATIONS drop column PHYSICALCHECK';
--EXECUTE IMMEDIATE 'alter table DECLARATIONS rename column PHYSICALCHECK_temp to PHYSICALCHECK';
end;
    ]]>
	</Oracle>
</Script>