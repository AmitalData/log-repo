<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
  <Sql Version="1">
  </Sql>

  
  <Oracle Version="2">
    <![CDATA[
     declare
 n int := 0;
begin
  select count(*) into n
  from PACKAGES 
 where code='COAU';
 if n = 0 then
Insert into PACKAGES (CODE,NAME,SEARCHFIELDS,INACTIVE,FEATUREPACKAGETYPECODE) values ('COAU','E-Commerce Automation','COAU,E-Commerce Automation',0,'BS');
Insert into PACKAGES (CODE,NAME,SEARCHFIELDS,INACTIVE,FEATUREPACKAGETYPECODE) values ('COAUA','E-Commerce Automatio Addon','COAUA,E-Commerce Automatio Addon',0,'AD');
Insert into PACKAGECONNECTEDPACKAGES (ID,PACKAGECODE,CONNECTEDPACKAGECODE) values ('G-26','COAUA','COAU');

 
commit;
  end if;
end;



]]>
  </Oracle>
</Script>