<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
  <Sql Version="1">
  </Sql>


  <Oracle Version="1">
    <![CDATA[
declare
 n int := 0;
begin
  select count(*) into n FROM   user_tables   where upper(table_name) = upper('CourierPendingReasons');
 if n = 1 then
 
      select count(*) into n  FROM   user_tab_columns   where upper(table_name) = upper('CourierPendingReasons') and column_name ='ID';
      if n = 0 then
       EXECUTE IMMEDIATE 'ALTER TABLE COURIERPENDINGREASONS ADD ID VARCHAR2(15 CHAR) NULL';
       EXECUTE IMMEDIATE 'UPDATE COURIERPENDINGREASONS SET ID =CODE WHERE ID  IS NULL';
      end if;

  end if;
end;




]]>
  </Oracle>
</Script>