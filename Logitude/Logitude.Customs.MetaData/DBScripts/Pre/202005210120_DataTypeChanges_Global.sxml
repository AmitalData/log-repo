-- Change Type From nvarchar To varchar For Column SHAREDKEY
DECLARE ColumnCount NUMBER;
BEGIN
SELECT COUNT(*) INTO ColumnCount FROM USER_TAB_COLUMNS WHERE TABLE_NAME = 'AGENTSHAREDLOGISTICSKEYS' AND COLUMN_NAME = 'SHAREDKEY';
IF (ColumnCount <> 0) THEN
EXECUTE IMMEDIATE 'ALTER TABLE "AGENTSHAREDLOGISTICSKEYS" ADD "TEMP_SHAREDKEY" VARCHAR2(128 CHAR) NULL';
EXECUTE IMMEDIATE 'UPDATE "AGENTSHAREDLOGISTICSKEYS" SET "TEMP_SHAREDKEY" = "SHAREDKEY"';
EXECUTE IMMEDIATE 'ALTER TABLE "AGENTSHAREDLOGISTICSKEYS" MODIFY "TEMP_SHAREDKEY" NOT NULL';
EXECUTE IMMEDIATE 'ALTER TABLE "AGENTSHAREDLOGISTICSKEYS" MODIFY "SHAREDKEY" NULL';
EXECUTE IMMEDIATE 'ALTER TABLE "AGENTSHAREDLOGISTICSKEYS" RENAME COLUMN "SHAREDKEY" TO "CDROP_SHAREDKEY"';
EXECUTE IMMEDIATE 'ALTER TABLE "AGENTSHAREDLOGISTICSKEYS" RENAME COLUMN "TEMP_SHAREDKEY" TO "SHAREDKEY"';
END IF;
END;

