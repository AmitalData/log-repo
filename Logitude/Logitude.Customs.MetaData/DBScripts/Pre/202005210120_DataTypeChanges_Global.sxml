EXECUTE IMMEDIATE 'ALTER TABLE "TENANTMANAGEMENTLICENSES" ADD "TEMP_PACKAGECODE" VARCHAR2(5 CHAR) NULL';
EXECUTE IMMEDIATE 'UPDATE "TENANTMANAGEMENTLICENSES" SET "TEMP_PACKAGECODE" = "PACKAGECODE"';
EXECUTE IMMEDIATE 'ALTER TABLE "TENANTMANAGEMENTLICENSES" RENAME COLUMN "PACKAGECODE" TO "CDROP_PACKAGECODE"';
EXECUTE IMMEDIATE 'ALTER TABLE "TENANTMANAGEMENTLICENSES" RENAME COLUMN "TEMP_PACKAGECODE" TO "PACKAGECODE"';
END IF;
END;
    ]]>
