<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
	<Sql Version="1">
		<![CDATA[

	 IF NOT EXISTS (SELECT * FROM TRANSPORTMODES WHERE ID = 'L')
        BEGIN
            INSERT INTO TRANSPORTMODES (ID, NAME) VALUES ('L', 'Inland');
        END
		]]>

	</Sql>

	<Oracle Version="1">
    <![CDATA[
	BEGIN
            EXECUTE IMMEDIATE 'INSERT INTO TRANSPORTMODES (ID, NAME)
            SELECT ''L'', ''Inland'' FROM dual
            WHERE NOT EXISTS (
                SELECT 1 FROM TRANSPORTMODES WHERE ID = ''L''
            )';
        END;

]]>
 </Oracle>
</Script>