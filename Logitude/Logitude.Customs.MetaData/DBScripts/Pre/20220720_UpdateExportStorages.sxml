	<Oracle Version="1">
		<![CDATA[
EXECUTE IMMEDIATE ' alter table EXPORTSTORAGES add tmpEXPORTDEALIDENTIFICATION NCLOB';
EXECUTE IMMEDIATE 'update EXPORTSTORAGES set tmpEXPORTDEALIDENTIFICATION=EXPORTDEALIDENTIFICATION';
EXECUTE IMMEDIATE 'commit';
EXECUTE IMMEDIATE 'alter table EXPORTSTORAGES drop column EXPORTDEALIDENTIFICATION';
EXECUTE IMMEDIATE 'alter table EXPORTSTORAGES rename column tmpEXPORTDEALIDENTIFICATION to EXPORTDEALIDENTIFICATION';


EXECUTE IMMEDIATE ' alter table EXPORTSTORAGES add STORAGENO1 NCLOB';
EXECUTE IMMEDIATE 'update EXPORTSTORAGES set STORAGENO1=STORAGENO';
EXECUTE IMMEDIATE 'commit';
EXECUTE IMMEDIATE 'alter table EXPORTSTORAGES drop column STORAGENO';
EXECUTE IMMEDIATE 'alter table EXPORTSTORAGES rename column STORAGENO1 to STORAGENO';
