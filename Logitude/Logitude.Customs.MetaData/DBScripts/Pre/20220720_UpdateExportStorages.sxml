<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs"  Pre="true">
	<Sql Version="1">
	</Sql>

	<Oracle Version="1">
		<![CDATA[
		declare
 n int := 0;
begin
  select count(*) into n FROM EXPORTSTORAGES;
  if n = 0 then
EXECUTE IMMEDIATE 'alter table EXPORTSTORAGES drop column EXPORTDEALIDENTIFICATION';
EXECUTE IMMEDIATE 'alter table EXPORTSTORAGES drop column STORAGENO';
   end if;
end;
    ]]>
	</Oracle>
</Script>