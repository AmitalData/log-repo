<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
	<Sql Version="1">
		<![CDATA[
        IF NOT EXISTS (SELECT 1 FROM FieldDataTypes WHERE CODE = 'DateTime2')
        BEGIN
            INSERT INTO FieldDataTypes (CODE, NAME, SEARCHFIELDS)
            VALUES ('DateTime2', 'DateTime2', 'datetime2,datetime2');
        END
        ]]>
	</Sql>

	<Oracle Version="1">
		<![CDATA[
        BEGIN
            EXECUTE IMMEDIATE '
                INSERT INTO FieldDataTypes (CODE, NAME, SEARCHFIELDS)
                SELECT ''DateTime2'', ''DateTime2'', ''datetime2,datetime2'' FROM dual
                WHERE NOT EXISTS (
                    SELECT 1 FROM FieldDataTypes WHERE CODE = ''DateTime2''
                )
            ';
        END;
        ]]>
	</Oracle>
</Script>