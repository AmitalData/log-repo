<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs"  Pre="true">
  <Sql Version="1">
  </Sql>

  <Oracle Version="1">
    <![CDATA[
Delete from querycolumns where rowid in ( select rid from ( select rowid rid , row_number() over ( partition by tenant , userid, objectfieldcode , queryid 
Order by rowid ) rn from querycolumns)
Where rn <> 1);
    ]]>
  </Oracle>
</Script>