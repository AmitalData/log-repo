<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs"  Pre="true">
	<Sql Version="1">
	</Sql>

	<Oracle Version="2">
		<![CDATA[
			declare
 n int := 0;
begin SELECT
                                COUNT(*)
                            INTO n
                            FROM
                                all_objects
                            WHERE
                                object_type IN ( 'TABLE' )
                                AND object_name = 'PHYSICALCHECKCODES';
  if n = 0 then
                begin  execute immediate 'CREATE TABLE PHYSICALCHECKCODES(
CODE     VARCHAR2(1 CHAR),
RFF    NVARCHAR2(50),
SEARCHFIELDS  NVARCHAR2(100)
)';
end;
   
    
   end if;
end;

 
    ]]>
	</Oracle>
</Script>