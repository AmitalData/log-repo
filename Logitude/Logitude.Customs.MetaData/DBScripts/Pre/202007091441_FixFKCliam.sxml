-- prepare ALTER TABLE "CLAIMSRELATEDENTSREASONSEXPS" ADD CONSTRAINT "FK_CLAIMSRELATEDENTSREAS_OEDHM" FOREIGN KEY("CLAIMID','COUNTERKEY','REASONLINENO") REFERENCES "CLAIMSRELATEDENTITIESREASONS" ("CLAIMID','COUNTERKEY','LINENO")

-- create backup for non UNIQUE("TENANT','CODE','PARTNERTYPEID") 
---EXECUTE IMMEDIATE 'create table zCLAIMSRELATEDENTSREASONSEXPS  as  select * from   CLAIMSRELATEDENTSREASONSEXPS where CLAIMID  || '',''  || COUNTERKEY  || '',''  || REASONLINENO not in ( select  CLAIMID || '',''  ||  COUNTERKEY  || '',''  ||  LINENO  from CLAIMSRELATEDENTITIESREASONS )';
EXECUTE IMMEDIATE 'create table zCLAIMSRELATEDENTSREASONSEXPS  AS select R.* from CLAIMSRELATEDENTSREASONSEXPS r LEFT JOIN CLAIMSRELATEDENTITIESREASONS L ON R.CLAIMID = l.CLAIMID AND R.COUNTERKEY=L.COUNTERKEY AND R.REASONLINENO=L.LINENO WHERE L.CLAIMID IS NULL';



-- delete extra
delete "CLAIMSRELATEDENTSREASONSEXPS"
where "CLAIMID"  || ','  || "COUNTERKEY"  || ','  || "REASONLINENO" not in 
(
select  "CLAIMID" || ','  ||  "COUNTERKEY"  || ','  ||  "LINENO"  from CLAIMSRELATEDENTITIESREASONS
) ;


----------------------------------------------------
-- prepare ALTER TABLE "CLAIMSRELATEDENTITIESREASONS" ADD CONSTRAINT "FK_CLAIMSRELATEDENTITIES_O7YU8" FOREIGN KEY("CLAIMID','COUNTERKEY") REFERENCES "CLAIMSRELATEDENTITIES"("CLAIMID','ENTITYCOUNTERKEY")

---EXECUTE IMMEDIATE 'create table zCLAIMSRELATEDENTITIESREASONS  as select  * from CLAIMSRELATEDENTITIESREASONS where CLAIMID || '',''  ||   COUNTERKEY   not in  (select  CLAIMID || '','' ||  ENTITYCOUNTERKEY  from CLAIMSRELATEDENTITIES )';
EXECUTE IMMEDIATE 'create table zCLAIMSRELATEDENTITIESREASONS AS select  R.* from CLAIMSRELATEDENTITIESREASONS r RIGHT join CLAIMSRELATEDENTITIES e on (r.CLAIMID= e.CLAIMID )and (r.COUNTERKEY =e.ENTITYCOUNTERKEY) WHERE R.CLAIMID IS NULL';

DELETE  from CLAIMSRELATEDENTITIESREASONS where "CLAIMID" || ','  ||   "COUNTERKEY"   not in  (select  "CLAIMID" || ',' ||  "ENTITYCOUNTERKEY"  from CLAIMSRELATEDENTITIES );




]]>
  </Oracle>
