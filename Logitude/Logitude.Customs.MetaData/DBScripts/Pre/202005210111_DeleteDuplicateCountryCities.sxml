<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
  <Sql Version="1">
  </Sql>

  <Oracle Version="1">
    <![CDATA[
delete from COUNTRYCITIES where rowid not in(
select min(rowid)
from COUNTRYCITIES
group by code, countryid, tenant);
    ]]>
  </Oracle>
</Script>