<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
	<Sql Version="1">

		
	</Sql>



	<Oracle Version="1">
		<![CDATA[
   DECLARE
  v_column_exists number := 0;  
BEGIN
  Select count(*) into v_column_exists
    from user_tab_cols
    where upper(column_name) = 'ShipCode'
      and upper(table_name) = 'EXPORTSTORAGES';

  if (v_column_exists = 1) then
      execute immediate 'ALTER TABLE EXPORTSTORAGES
        DROP COLUMN ShipCode';
  end if;
end;

    ]]>
	</Oracle>
</Script>