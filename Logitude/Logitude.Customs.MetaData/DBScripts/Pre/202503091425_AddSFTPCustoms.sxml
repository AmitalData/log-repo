<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
  <Sql Version="1">
  </Sql>

  <Oracle Version="1">
    <![CDATA[
    
      DECLARE  v_customs_agent_id VARCHAR2(100); 
      BEGIN
           SELECT CUSTOMSAGENTID  INTO v_customs_agent_id
           FROM CustomsSettings WHERE ID = 1;     
           
           INSERT INTO FTPDETAILS (ID, TENANT, CREATEDATE, UPDATEDATE, INACTIVE, CREATEDBYUSERID, UPDATEDBYUSERID, USERNAME, PASSWORD, HOST, FOLDER, USESFTP)
           VALUES ('1-999', 1,sysdate,  sysdate, 0, '1-9', '1-9', 'il511262073',   NULL, 'goa.israports.co.il','il'|| v_customs_agent_id || '/send', 1);
          
           INSERT INTO  CustomsPartnerFtps (ID, TENANT, TYPECODE, PARTNERCODE, INTERFACENAME, FTPDETAILSID, FILENAME, FILEEXT, COMMUNICATIONDETAILS)
            VALUES ('1-999', 1, 'OUT', 'Customs', 'Customs', '1-999', NULL, NULL, NULL);
      COMMIT;
      END;
      
  ]]>
  </Oracle>
</Script>