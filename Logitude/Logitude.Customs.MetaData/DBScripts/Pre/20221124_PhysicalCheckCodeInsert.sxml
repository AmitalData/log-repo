<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs"  Pre="true">
	<Sql Version="1">
	</Sql>

	<Oracle Version="1">
		<![CDATA[
			declare
 n int := 0;
begin SELECT
                                COUNT(*)
                            INTO n
                            FROM
                                physicalcheckcodes
                            WHERE
                                code = '1'
                                OR code = '2';
if n = 0 THEN
    INSERT INTO physicalcheckcodes (
        code,
        name,
        searchfields
    ) VALUES (
        '1',
        'בדיקה פיזית פתוחה',
        '1,בדיקה פיזית פתוחה'
    );

    INSERT INTO physicalcheckcodes (
        code,
        name,
        searchfields
    ) VALUES (
        '2',
        '2,בדיקה פיזית סגורה',
        '1,בדיקה פיזית סגורה'
    );

   end if;

end;

 
    ]]>
	</Oracle>
</Script>