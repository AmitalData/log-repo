-- Change Type From nvarchar To varchar For Column CODE
DECLARE ColumnCount NUMBER;
BEGIN
SELECT COUNT(*) INTO ColumnCount FROM USER_TAB_COLUMNS WHERE TABLE_NAME = 'APPROVEDPROFESSIONS' AND COLUMN_NAME = 'CODE';
IF (ColumnCount <> 0) THEN
EXECUTE IMMEDIATE 'ALTER TABLE "APPROVEDPROFESSIONS" ADD "TEMP_CODE" VARCHAR2(128 CHAR) NULL';
EXECUTE IMMEDIATE 'UPDATE "APPROVEDPROFESSIONS" SET "TEMP_CODE" = "CODE"';
EXECUTE IMMEDIATE 'ALTER TABLE "APPROVEDPROFESSIONS" MODIFY "TEMP_CODE" NOT NULL';
EXECUTE IMMEDIATE 'ALTER TABLE "APPROVEDPROFESSIONS" RENAME COLUMN "CODE" TO "CDROP_CODE"';
EXECUTE IMMEDIATE 'ALTER TABLE "APPROVEDPROFESSIONS" RENAME COLUMN "TEMP_CODE" TO "CODE"';
END IF;
END;

