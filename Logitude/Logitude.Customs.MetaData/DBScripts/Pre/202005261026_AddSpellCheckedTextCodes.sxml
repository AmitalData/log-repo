UPDATE TextCodes t1 SET (t1.LOCALDEFAULTTEXT) = (SELECT t2.LOCALDEFAULTTEXT FROM SpellCheckedTextCodes t2
WHERE t1.code = t2.code)
WHERE EXISTS (
SELECT 1
FROM SpellCheckedTextCodes t2
WHERE t1.code = t2.code );
     
update textcodes set isspellchecked =1 where code in (select code from SpellCheckedTextCodes);
