<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
  <Sql Version="1">
  </Sql>

  
  <Oracle Version="1">
    <![CDATA[
   declare
 n int := 0;
begin
  select count(*) into n
  from PACKAGES 
 where code='EENA';
 if n = 0 then
Insert into PACKAGES (CODE,NAME,SEARCHFIELDS,INACTIVE,FEATUREPACKAGETYPECODE) values ('EENB','Exit Entry','EENB,Exit Entry',0,'BS');
Insert into PACKAGES (CODE,NAME,SEARCHFIELDS,INACTIVE,FEATUREPACKAGETYPECODE) values ('EENA','Exit Entry ADDON','EENA,Exit Entry ADDON ',0,'AD');
Insert into PACKAGECONNECTEDPACKAGES (ID,PACKAGECODE,CONNECTEDPACKAGECODE) values ('G-60','EENA','EENB');

 
commit;
  end if;
end;





]]>
  </Oracle>
</Script>