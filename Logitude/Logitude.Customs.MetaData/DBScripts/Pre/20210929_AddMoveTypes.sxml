    <![CDATA[
             declare
 n int := 0;
begin
  select count(*) into n
  from MOVETYPES 
 where tenant=1;
  if n = 0 then
Insert into MOVETYPES (ID,TENANT,MOVETYPEENGLISHNAME,MOVETYPELOCALNAME,TRANSPORTMODEID,ADDEDMANUALLY,INACTIVE,CODE,SEARCHFIELDS,AUTOMATICLASTUPDATEDATE) values ('1-13',1,'Airport to Airport','Airport to Airport','A',0,0,'ATA','ATA,Airport to Airport,A',null);
