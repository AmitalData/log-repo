Insert into MOVETYPES (ID,TENANT,MOVETYPEENGLISHNAME,MOVETYPELOCALNAME,TRANSPORTMODEID,ADDEDMANUALLY,INACTIVE,CODE,SEARCHFIELDS,AUTOMATICLASTUPDATEDATE) values ('1-22',1,'Port to House (Door)','Port to House (Door)','O',0,0,'PTH','PTH,Port to House (Door),O',null);
