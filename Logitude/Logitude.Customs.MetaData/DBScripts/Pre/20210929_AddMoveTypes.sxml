Insert into MOVETYPES (ID,TENANT,MOVETYPEENGLISHNAME,MOVETYPELOCALNAME,TRANSPORTMODEID,ADDEDMANUALLY,INACTIVE,CODE,SEARCHFIELDS,AUTOMATICLASTUPDATEDATE) values ('1-18',1,'Door to Airport','Door to Airport','A',0,0,'DTA','DTA,Door to Airport,A',null);
Insert into MOVETYPES (ID,TENANT,MOVETYPEENGLISHNAME,MOVETYPELOCALNAME,TRANSPORTMODEID,ADDEDMANUALLY,INACTIVE,CODE,SEARCHFIELDS,AUTOMATICLASTUPDATEDATE) values ('1-19',1,'Door to Door','Door to Door','A',0,0,'DTD','DTD,Door to Door,A',null);
