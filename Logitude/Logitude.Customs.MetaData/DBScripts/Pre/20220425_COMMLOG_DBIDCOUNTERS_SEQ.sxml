<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
	<Sql Version="1">
	</Sql>
	<Oracle Version="2">
		<![CDATA[
		
declare
 n int := 0;
begin
  select count(*) into n    FROM user_sequences  WHERE sequence_name = 'COMMLOG_DBIDCOUNTERS_SEQ';
  if n = 0 then

      SELECT LASTIDNUMBER  into n    FROM dbidcounters WHERE  TableName  ='CommunicationLog' ;
      n:=n+100000;
       --EXECUTE IMMEDIATE 'CREATE SEQUENCE "COMMLOG_DBIDCOUNTERS_SEQ"  MINVALUE 1 MAXVALUE 999999999999999999999999999 INCREMENT BY 1 START WITH ' ||  n  || ' NOCACHE  NOORDER  CYCLE  NOKEEP  GLOBAL ';
       EXECUTE IMMEDIATE 'CREATE SEQUENCE "COMMLOG_DBIDCOUNTERS_SEQ" INCREMENT BY 1 MAXVALUE 999999999999999999999999999 MINVALUE 1 START WITH ' ||  n  || '  CACHE 20;          
	   
   end if;
end;
    ]]>
	</Oracle>
</Script>

