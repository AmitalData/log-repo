<?xml version="1.0" encoding="utf-8"?>
<Script DBType="Main" Module="Customs" Pre="true">
  <Sql Version="1">
  </Sql>

  <Oracle Version="2">
    <![CDATA[
      -- Drop constraints that involve FIELDNAME
      DECLARE
        v_sql VARCHAR2(1000);
      BEGIN
        FOR r IN (
          SELECT constraint_name
          FROM user_cons_columns
          WHERE table_name = 'OBJECTFIELDS'
            AND column_name = 'FIELDNAME'
        ) LOOP
          SELECT 'ALTER TABLE "OBJECTFIELDS" DROP CONSTRAINT "' || r.constraint_name || '"' INTO v_sql FROM dual;
          EXECUTE IMMEDIATE v_sql;
        END LOOP;
      END;
    
      EXECUTE IMMEDIATE 'ALTER TABLE "OBJECTFIELDS" ADD "FIELDNAME_TEMP" VARCHAR2(200 CHAR)';

      EXECUTE IMMEDIATE 'UPDATE "OBJECTFIELDS" SET "FIELDNAME_TEMP" = "FIELDNAME"';

      EXECUTE IMMEDIATE 'ALTER TABLE "OBJECTFIELDS" DROP COLUMN "FIELDNAME"';

      EXECUTE IMMEDIATE 'ALTER TABLE "OBJECTFIELDS" ADD "FIELDNAME" VARCHAR2(200 CHAR)';

      EXECUTE IMMEDIATE 'UPDATE "OBJECTFIELDS" SET "FIELDNAME" = "FIELDNAME_TEMP"';

      EXECUTE IMMEDIATE 'ALTER TABLE "OBJECTFIELDS" DROP COLUMN "FIELDNAME_TEMP"';
    ]]>
  </Oracle>
</Script>
