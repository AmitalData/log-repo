<Procedure DBType="Main" Name="usp_CustomsBookRulesDetails" Schema="dbo" Module="Customs">
  <SqlScript>
	  <![CDATA[
			CREATE OR ALTER PROCEDURE [dbo].[usp_CustomsBookRulesDetails]
					@CustomsItemID VARCHAR(20)
			AS
			BEGIN
					WITH LatestRuleDetails AS (
					SELECT 
							RDH.RuleID,
							RDH.Title AS RuleDetailTitle,  -- Assuming this is the title of the rule detail
							RDH.ChangeRequestTypePriority,
							RDH.UpdateDate,
							RDH.OrderinalPostion,
							RDH.Parent_RuleDetailsHistoryID,
							RDH.EntityStatusID,
					RDH.Rules ,
							ROW_NUMBER() OVER (
									PARTITION BY RDH.RuleID 
									ORDER BY RDH.UpdateDate DESC
							) AS RowNum
					FROM customs.CB_RuleDetailsHistorys AS RDH
					WHERE RDH.StartDate <= GETDATE()
						AND RDH.EndDate >= GETDATE()
						AND RDH.EntityStatusID = '2'
				),
				FilteredRules AS (
					SELECT 
						R.Title AS RuleTitle,
						R.CustomsItemID,
						R.ID AS RuleId,
						LR.ChangeRequestTypePriority,
						LR.UpdateDate,
						LR.OrderinalPostion,
						ROW_NUMBER() OVER (
							PARTITION BY R.ID
							ORDER BY LR.OrderinalPostion, LR.UpdateDate DESC  -- Sort by OrderinalPostion and then UpdateDate
						) AS RowNum
					FROM customs.CB_Rules AS R
					LEFT JOIN LatestRuleDetails AS LR ON R.ID = LR.RuleID
					WHERE R.CustomsItemID =  @CustomsItemID
						AND LR.RowNum = 1  -- Ensure we only take the latest update
				)
				SELECT 
					FR.RuleTitle,
					FR.CustomsItemID,
					FR.RuleId,
					FR.ChangeRequestTypePriority,
					FR.UpdateDate,
					FR.OrderinalPostion,
					Rules,
					Sub.Title AS SubsectionTitle  -- Replace with the actual title column of the subsection
				FROM FilteredRules AS FR
				LEFT JOIN customs.CB_RuleDetailsHistorys AS Sub ON FR.RuleId = Sub.Parent_RuleDetailsHistoryID
				WHERE Sub.Parent_RuleDetailsHistoryID IS NULL  -- Include only those with Parent_RuleDetailsHistoryID as NULL
				ORDER BY 
					FR.OrderinalPostion,  -- First sort by OrderinalPostion
					FR.UpdateDate DESC;  -- Then sort by UpdateDate in descending order
			END
    ]]>
  </SqlScript>

  <OracleScript>
    <![CDATA[
 	
	
    ]]>
  </OracleScript>
</Procedure>