<Procedure DBType="Main" Name="usp_NewCustomsBookMainViewSearchByText" Schema="dbo" Module="Customs">
  <SqlScript>
    <![CDATA[

	
CREATE OR ALTER PROCEDURE [dbo].[usp_NewCustomsBookMainViewSearchByText]
@SearchFields VARCHAR(40),
@CustomsBookType VARCHAR(2),
@CustomsItemHierarchic VARCHAR(20),
@Remarks BIT,
@Rules BIT,
@Tenant INT = 0
AS
BEGIN
IF @CustomsItemHierarchic is null AND @Remarks = 0 AND @Rules = 0 --ללא סינון
BEGIN
	WITH BaseCTE AS (
	    SELECT
	        m.CustomsItemId,
	        m.Parent_CustomsItemId,
	        m.ItemHierarchicLocationID,
	        m.Fullclassification,
	        m.BaseFullClassification,
	        m.ComputedCheckDigit,
	        m.IsLeaf,
	        m.GoodsDescription,
	        m.Rules,
	        m.Agreements,
	        m.CustomsRate,
	        m.PurchaseTax,
	        m.OptionalTaxAddition,
	        m.MeasurementUnitName,
	        m.MALAMID AS MeasurementUnitID,
	        'GoodsDescription' AS Result
	    FROM [dbo].[NewCustomsBookMainView] m
	    WHERE m.CI_CustomsBookTypeIDNum = @CustomsBookType
	        AND m.GoodsDescription LIKE '%' + @SearchFields + '%'
	        AND m.ItemHierarchicLocationID != '1'
	    UNION ALL--כללים
	    SELECT m.CustomsItemId,
	        m.Parent_CustomsItemId,
	        m.ItemHierarchicLocationID,
	        m.Fullclassification,
	        m.BaseFullClassification,
	        m.ComputedCheckDigit,
	        m.IsLeaf,
	        m.GoodsDescription,
	        m.Rules,
	        m.Agreements,
	        m.CustomsRate,
	        m.PurchaseTax,
	        m.OptionalTaxAddition,
	        m.MeasurementUnitName,
	        m.MALAMID AS MeasurementUnitID,
	        'Rules' AS Result
	    FROM [dbo].[NewCustomsBookMainView] m
	    JOIN customs.CB_RuleClassifications r ON m.CustomsItemId = r.CustomsItemID
	    WHERE m.CI_CustomsBookTypeIDNum = @CustomsBookType AND m.Rules = 1
	        AND r.Rules LIKE '%' + @SearchFields + '%'
	    UNION ALL --הערות
	    SELECT
	        m.CustomsItemId,
	        m.Parent_CustomsItemId,
	        m.ItemHierarchicLocationID,
	        m.Fullclassification,
	        m.BaseFullClassification,
	        m.ComputedCheckDigit,
	        m.IsLeaf,
	        m.GoodsDescription,
	        m.Rules,
	        m.Agreements,
	        m.CustomsRate,
	        m.PurchaseTax,
	        m.OptionalTaxAddition,
	        m.MeasurementUnitName,
	        m.MALAMID AS MeasurementUnitID,
	        'Remarks' AS Result
	    FROM [dbo].[NewCustomsBookMainView] m
	    JOIN customs.RemarksClassifications r ON m.CustomsItemId = r.CustomsItemsID
	    WHERE r.Tenant = @Tenant 
	        AND m.CI_CustomsBookTypeIDNum = @CustomsBookType 
	        AND r.RemarkDescription LIKE '%' + @SearchFields + '%'
	),
	RecursiveCTE AS (
	    SELECT
	        CustomsItemId,
	        Parent_CustomsItemId,
	        ItemHierarchicLocationID,
	        Fullclassification,
	        BaseFullClassification,
	        ComputedCheckDigit,
	        IsLeaf,
	        GoodsDescription,
	        Rules,
	        Agreements,
	        CustomsRate,
	        PurchaseTax,
	        OptionalTaxAddition,
	        MeasurementUnitName,
	        MeasurementUnitID,
	        Result 
	    FROM BaseCTE
	    UNION ALL
	    SELECT
	        p.CustomsItemId,
	        p.Parent_CustomsItemId,
	        p.ItemHierarchicLocationID,
	        p.Fullclassification,
	        p.BaseFullClassification,
	        p.ComputedCheckDigit,
	        p.IsLeaf,
	        p.GoodsDescription,
	        p.Rules,
	        p.Agreements,
	        p.CustomsRate,
	        p.PurchaseTax,
	        p.OptionalTaxAddition,
	        p.MeasurementUnitName,
	        p.MALAMID AS MeasurementUnitID,
	        null as result 
	    FROM [dbo].[NewCustomsBookMainView] p
	    JOIN RecursiveCTE r ON p.CustomsItemId = r.Parent_CustomsItemId
	)
	 
	SELECT 
	    CustomsItemId,
	    MAX(Parent_CustomsItemId) AS Parent_CustomsItemID,
	    MAX(ItemHierarchicLocationID) AS ItemHierarchicLocationID,
	    MAX(Fullclassification) AS FullClassification,
	    MAX(BaseFullClassification) AS BaseFullClassification,
	    MAX(ComputedCheckDigit) AS ComputedCheckDigit,
	    IsLeaf,
	    MAX(GoodsDescription) AS GoodsDescription,
	    Rules,
	    MAX(Agreements) AS Agreements,
	    MAX(CustomsRate) AS CustomsRate,
	    MAX(PurchaseTax) AS PurchaseTax,
	    MAX(OptionalTaxAddition) AS OptionalTaxAddition,
	    MAX(MeasurementUnitName) AS MeasurementUnitName,
	    MAX(MeasurementUnitID) AS MeasurementUnitID,
	    MAX(remark.Id) as Remarks ,
	    STRING_AGG(Result, ', ')  AS Result 
	FROM (
	    SELECT DISTINCT CustomsItemId, Parent_CustomsItemId, ItemHierarchicLocationID,
	           Fullclassification, BaseFullClassification, ComputedCheckDigit, 
	           IsLeaf, GoodsDescription, Rules, Agreements, CustomsRate, 
	           PurchaseTax, OptionalTaxAddition, MeasurementUnitName, 
	           MeasurementUnitID, Result
	    FROM RecursiveCTE
	) AS DistinctResults
	LEFT JOIN (
	    SELECT Id, CustomsItemsID
	    FROM customs.RemarksClassifications
	    WHERE Tenant = @Tenant
	) AS remark ON DistinctResults.CustomsItemId = remark.CustomsItemsID
	GROUP BY CustomsItemId,IsLeaf,Rules
	ORDER BY Fullclassification;

END--new
IF @CustomsItemHierarchic is not null AND @Remarks = 0 AND @Rules = 0 -- סינון של רמות שונות בעץ בלבד
BEGIN
	WITH BaseCTE AS (
	   
		SELECT
		CustomsItemId,
		Parent_CustomsItemId ,
		ItemHierarchicLocationID,
		Fullclassification,
		BaseFullClassification,
		ComputedCheckDigit,
		IsLeaf,
		GoodsDescription,
		Rules,
		Agreements,
		customsRate AS CustomsRate, 
		purchaseTax AS PurchaseTax, 
		OptionalTaxAddition, 
		MeasurementUnitName, 
		MALAMID as MeasurementUnitID, 
		r.Id AS Remarks,
		'GoodDescription' as Result
		FROM [dbo].[NewCustomsBookMainView] m
		LEFT JOIN
		(
		SELECT Id,CustomsItemsID
		FROM customs.RemarksClassifications
		WHERE Tenant = @Tenant
		)AS r ON m.CustomsItemId = r.CustomsItemsID
		WHERE CI_CustomsBookTypeIDNum =@CustomsBookType
		AND
		GoodsDescription LIKE '%' + @SearchFields + '%' AND CHARINDEX(',' + ItemHierarchicLocationID + ',', ',' + @CustomsItemHierarchic + ',') > 0
	
	),
	RecursiveCTE AS (
	    SELECT
	        CustomsItemId,
	        Parent_CustomsItemId,
	        ItemHierarchicLocationID,
	        Fullclassification,
	        BaseFullClassification,
	        ComputedCheckDigit,
	        IsLeaf,
	        GoodsDescription,
	        Rules,
	        Agreements,
	        CustomsRate,
	        PurchaseTax,
	        OptionalTaxAddition,
	        MeasurementUnitName,
	        MeasurementUnitID,
	        Result 
	    FROM BaseCTE
	    UNION ALL
	    SELECT
	        p.CustomsItemId,
	        p.Parent_CustomsItemId,
	        p.ItemHierarchicLocationID,
	        p.Fullclassification,
	        p.BaseFullClassification,
	        p.ComputedCheckDigit,
	        p.IsLeaf,
	        p.GoodsDescription,
	        p.Rules,
	        p.Agreements,
	        p.CustomsRate,
	        p.PurchaseTax,
	        p.OptionalTaxAddition,
	        p.MeasurementUnitName,
	        p.MALAMID AS MeasurementUnitID,
	        null as result 
	    FROM [dbo].[NewCustomsBookMainView] p
	    JOIN RecursiveCTE r ON p.CustomsItemId = r.Parent_CustomsItemId
	)
	 
	SELECT 
	    CustomsItemId,
	    MAX(Parent_CustomsItemId) AS Parent_CustomsItemID,
	    MAX(ItemHierarchicLocationID) AS ItemHierarchicLocationID,
	    MAX(Fullclassification) AS FullClassification,
	    MAX(BaseFullClassification) AS BaseFullClassification,
	    MAX(ComputedCheckDigit) AS ComputedCheckDigit,
	    IsLeaf,
	    MAX(GoodsDescription) AS GoodsDescription,
	    Rules,
	    MAX(Agreements) AS Agreements,
	    MAX(CustomsRate) AS CustomsRate,
	    MAX(PurchaseTax) AS PurchaseTax,
	    MAX(OptionalTaxAddition) AS OptionalTaxAddition,
	    MAX(MeasurementUnitName) AS MeasurementUnitName,
		MAX(MeasurementUnitID) AS MeasurementUnitID,
		MAX(remark.Id) AS Remarks,
		STRING_AGG(Result, ', ')  AS Result
	FROM (
	    SELECT DISTINCT CustomsItemId, Parent_CustomsItemId, ItemHierarchicLocationID,
	           Fullclassification, BaseFullClassification, ComputedCheckDigit, 
	           IsLeaf, GoodsDescription, Rules, Agreements, CustomsRate, 
	           PurchaseTax, OptionalTaxAddition, MeasurementUnitName, 
	           MeasurementUnitID, Result
	    FROM RecursiveCTE
	) AS DistinctResults
	LEFT JOIN (
	    SELECT Id, CustomsItemsID
	    FROM customs.RemarksClassifications
	    WHERE Tenant = @Tenant
	) AS remark ON DistinctResults.CustomsItemId = remark.CustomsItemsID
	GROUP BY CustomsItemId,IsLeaf,Rules
	ORDER BY Fullclassification;
END--new
IF @CustomsItemHierarchic is null AND @Remarks = 0 AND @Rules = 1 -- סינון של כללים בלבד
BEGIN
	WITH BaseCTE AS (
		SELECT distinct
		m.CustomsItemId,
		Parent_CustomsItemId ,
		ItemHierarchicLocationID,
		Fullclassification,
		BaseFullClassification,
		ComputedCheckDigit,
		IsLeaf,
		GoodsDescription,
		m.Rules,
		Agreements,
		customsRate AS CustomsRate,
		purchaseTax AS PurchaseTax,
		OptionalTaxAddition,
		MeasurementUnitName,
		MALAMID as MeasurementUnitID, 
		'Rules' as Result
		FROM [dbo].[NewCustomsBookMainView] m
		INNER JOIN
		customs.CB_RuleClassifications r
		ON m.CustomsItemId = r.CustomsItemID
		WHERE m.CI_CustomsBookTypeIDNum = @CustomsBookType
		AND r.Rules LIKE '%' + @SearchFields + '%'
	
	),
	RecursiveCTE AS (
	    SELECT
	        CustomsItemId,
	        Parent_CustomsItemId,
	        ItemHierarchicLocationID,
	        Fullclassification,
	        BaseFullClassification,
	        ComputedCheckDigit,
	        IsLeaf,
	        GoodsDescription,
	        Rules,
	        Agreements,
	        CustomsRate,
	        PurchaseTax,
	        OptionalTaxAddition,
	        MeasurementUnitName,
	        MeasurementUnitID,
	        Result 
	    FROM BaseCTE
	    UNION ALL
	    SELECT
	        p.CustomsItemId,
	        p.Parent_CustomsItemId,
	        p.ItemHierarchicLocationID,
	        p.Fullclassification,
	        p.BaseFullClassification,
	        p.ComputedCheckDigit,
	        p.IsLeaf,
	        p.GoodsDescription,
	        p.Rules,
	        p.Agreements,
	        p.CustomsRate,
	        p.PurchaseTax,
	        p.OptionalTaxAddition,
	        p.MeasurementUnitName,
	        p.MALAMID AS MeasurementUnitID,
	        null as result
	    FROM [dbo].[NewCustomsBookMainView] p
	    JOIN RecursiveCTE r ON p.CustomsItemId = r.Parent_CustomsItemId
	)
	 
	SELECT 
	    CustomsItemId,
	    MAX(Parent_CustomsItemId) AS Parent_CustomsItemID,
	    MAX(ItemHierarchicLocationID) AS ItemHierarchicLocationID,
	    MAX(Fullclassification) AS FullClassification,
	    MAX(BaseFullClassification) AS BaseFullClassification,
	    MAX(ComputedCheckDigit) AS ComputedCheckDigit,
	    IsLeaf,
	    MAX(GoodsDescription) AS GoodsDescription,
	    Rules,
	    MAX(Agreements) AS Agreements,
	    MAX(CustomsRate) AS CustomsRate,
	    MAX(PurchaseTax) AS PurchaseTax,
	    MAX(OptionalTaxAddition) AS OptionalTaxAddition,
	    MAX(MeasurementUnitName) AS MeasurementUnitName,
	    MAX(MeasurementUnitID) AS MeasurementUnitID,
	    MAX(remark.Id) AS Remarks,
	    STRING_AGG(Result, ', ')  AS Result 
	FROM (
	    SELECT DISTINCT CustomsItemId, Parent_CustomsItemId, ItemHierarchicLocationID,
	           Fullclassification, BaseFullClassification, ComputedCheckDigit, 
	           IsLeaf, GoodsDescription, Rules, Agreements, CustomsRate, 
	           PurchaseTax, OptionalTaxAddition, MeasurementUnitName, 
	           MeasurementUnitID, Result
	    FROM RecursiveCTE
	) AS DistinctResults
	LEFT JOIN (
	    SELECT Id, CustomsItemsID
	    FROM customs.RemarksClassifications
	    WHERE Tenant = @Tenant
	) AS remark ON DistinctResults.CustomsItemId = remark.CustomsItemsID
	GROUP BY CustomsItemId,IsLeaf,Rules
	ORDER BY ItemHierarchicLocationID;
END--new
IF @CustomsItemHierarchic is null AND @Remarks = 1 AND @Rules = 0 -- סינון של הערות בלבד
BEGIN
	WITH BaseCTE AS (
	SELECT
	m.CustomsItemId,
	Parent_CustomsItemId ,
	ItemHierarchicLocationID,
	Fullclassification,
	BaseFullClassification,
	ComputedCheckDigit,
	IsLeaf,
	GoodsDescription,
	Rules,
	Agreements,
	customsRate AS CustomsRate,
	purchaseTax AS PurchaseTax,
	OptionalTaxAddition,
	MeasurementUnitName,
	MALAMID as MeasurementUnitID, 
	r.Id AS Remarks,
	'Remarks' as Result
	FROM [dbo].[NewCustomsBookMainView] m
	INNER JOIN
	(
	SELECT  Id,CustomsItemsID, RemarkDescription
	FROM customs.RemarksClassifications
	WHERE Tenant = @Tenant
	)AS r ON m.CustomsItemId = r.CustomsItemsID
	WHERE m.CI_CustomsBookTypeIDNum = @CustomsBookType
		AND r.RemarkDescription LIKE '%' + @SearchFields + '%'
	
	),
	RecursiveCTE AS (
	    SELECT
	        CustomsItemId,
	        Parent_CustomsItemId,
	        ItemHierarchicLocationID,
	        Fullclassification,
	        BaseFullClassification,
	        ComputedCheckDigit,
	        IsLeaf,
	        GoodsDescription,
	        Rules,
	        Agreements,
	        CustomsRate,
	        PurchaseTax,
	        OptionalTaxAddition,
	        MeasurementUnitName,
	        MeasurementUnitID,
	        Result 
	    FROM BaseCTE
	    UNION ALL
	    SELECT
	        p.CustomsItemId,
	        p.Parent_CustomsItemId,
	        p.ItemHierarchicLocationID,
	        p.Fullclassification,
	        p.BaseFullClassification,
	        p.ComputedCheckDigit,
	        p.IsLeaf,
	        p.GoodsDescription,
	        p.Rules,
	        p.Agreements,
	        p.CustomsRate,
	        p.PurchaseTax,
	        p.OptionalTaxAddition,
	        p.MeasurementUnitName,
	        p.MALAMID AS MeasurementUnitID,
	        null as result
	    FROM [dbo].[NewCustomsBookMainView] p
	    JOIN RecursiveCTE r ON p.CustomsItemId = r.Parent_CustomsItemId
	)
	 
	SELECT 
	    CustomsItemId,
	    MAX(Parent_CustomsItemId) AS Parent_CustomsItemID,
	    MAX(ItemHierarchicLocationID) AS ItemHierarchicLocationID,
	    MAX(Fullclassification) AS FullClassification,
	    MAX(BaseFullClassification) AS BaseFullClassification,
	    MAX(ComputedCheckDigit) AS ComputedCheckDigit,
	    IsLeaf,
	    MAX(GoodsDescription) AS GoodsDescription,
	    Rules,
	    MAX(Agreements) AS Agreements,
	    MAX(CustomsRate) AS CustomsRate,
	    MAX(PurchaseTax) AS PurchaseTax,
	    MAX(OptionalTaxAddition) AS OptionalTaxAddition,
	    MAX(MeasurementUnitName) AS MeasurementUnitName,
	    MAX(MeasurementUnitID) AS MeasurementUnitID,
		MAX(remark.Id) AS Remarks,
	    STRING_AGG(Result, ', ')  AS Result
	FROM (
	    SELECT DISTINCT CustomsItemId, Parent_CustomsItemId, ItemHierarchicLocationID,
	           Fullclassification, BaseFullClassification, ComputedCheckDigit, 
	           IsLeaf, GoodsDescription, Rules, Agreements, CustomsRate, 
	           PurchaseTax, OptionalTaxAddition, MeasurementUnitName, 
	           MeasurementUnitID, Result
	    FROM RecursiveCTE
	) AS DistinctResults
	LEFT JOIN (
	    SELECT Id, CustomsItemsID
	    FROM customs.RemarksClassifications
	    WHERE Tenant = @Tenant
	) AS remark ON DistinctResults.CustomsItemId = remark.CustomsItemsID
	GROUP BY CustomsItemId,IsLeaf,Rules
	ORDER BY Fullclassification;
END--new
IF @CustomsItemHierarchic is not null AND @Remarks = 0 AND @Rules = 1 --סינון של רמות שונות בעץ + כללים
BEGIN
	WITH BaseCTE AS (
	    SELECT
	        m.CustomsItemId,
	        m.Parent_CustomsItemId,
	        m.ItemHierarchicLocationID,
	        m.Fullclassification,
	        m.BaseFullClassification,
	        m.ComputedCheckDigit,
	        m.IsLeaf,
	        m.GoodsDescription,
	        m.Rules,
	        m.Agreements,
	        m.CustomsRate,
	        m.PurchaseTax,
	        m.OptionalTaxAddition,
	        m.MeasurementUnitName,
	        m.MALAMID AS MeasurementUnitID,
	        'GoodsDescription' AS Result
	    FROM [dbo].[NewCustomsBookMainView] m
	    WHERE m.CI_CustomsBookTypeIDNum = @CustomsBookType
        AND m.GoodsDescription LIKE '%' + @SearchFields + '%'
        AND CHARINDEX(',' + m.ItemHierarchicLocationID + ',', ',' + @CustomsItemHierarchic + ',') > 0
	    
		UNION ALL--כללים
	    
		SELECT m.CustomsItemId,
	        m.Parent_CustomsItemId,
	        m.ItemHierarchicLocationID,
	        m.Fullclassification,
	        m.BaseFullClassification,
	        m.ComputedCheckDigit,
	        m.IsLeaf,
	        m.GoodsDescription,
	        m.Rules,
	        m.Agreements,
	        m.CustomsRate,
	        m.PurchaseTax,
	        m.OptionalTaxAddition,
	        m.MeasurementUnitName,
	        m.MALAMID AS MeasurementUnitID,
	        'Rules' AS Result
	    FROM [dbo].[NewCustomsBookMainView] m
	    JOIN customs.CB_RuleClassifications r ON m.CustomsItemId = r.CustomsItemID
	    WHERE m.CI_CustomsBookTypeIDNum = @CustomsBookType AND m.Rules = 1
	        AND r.Rules LIKE '%' + @SearchFields + '%'
	   
	),
	RecursiveCTE AS (
	    SELECT
	        CustomsItemId,
	        Parent_CustomsItemId,
	        ItemHierarchicLocationID,
	        Fullclassification,
	        BaseFullClassification,
	        ComputedCheckDigit,
	        IsLeaf,
	        GoodsDescription,
	        Rules,
	        Agreements,
	        CustomsRate,
	        PurchaseTax,
	        OptionalTaxAddition,
	        MeasurementUnitName,
	        MeasurementUnitID,
	        Result 
	    FROM BaseCTE
	    UNION ALL
	    SELECT
	        p.CustomsItemId,
	        p.Parent_CustomsItemId,
	        p.ItemHierarchicLocationID,
	        p.Fullclassification,
	        p.BaseFullClassification,
	        p.ComputedCheckDigit,
	        p.IsLeaf,
	        p.GoodsDescription,
	        p.Rules,
	        p.Agreements,
	        p.CustomsRate,
	        p.PurchaseTax,
	        p.OptionalTaxAddition,
	        p.MeasurementUnitName,
	        p.MALAMID AS MeasurementUnitID,
	        null as result 
	    FROM [dbo].[NewCustomsBookMainView] p
	    JOIN RecursiveCTE r ON p.CustomsItemId = r.Parent_CustomsItemId
	)
	 
	SELECT 
	    CustomsItemId,
	    MAX(Parent_CustomsItemId) AS Parent_CustomsItemID,
	    MAX(ItemHierarchicLocationID) AS ItemHierarchicLocationID,
	    MAX(Fullclassification) AS FullClassification,
	    MAX(BaseFullClassification) AS BaseFullClassification,
	    MAX(ComputedCheckDigit) AS ComputedCheckDigit,
	    IsLeaf,
	    MAX(GoodsDescription) AS GoodsDescription,
	    Rules,
	    MAX(Agreements) AS Agreements,
	    MAX(CustomsRate) AS CustomsRate,
	    MAX(PurchaseTax) AS PurchaseTax,
	    MAX(OptionalTaxAddition) AS OptionalTaxAddition,
	    MAX(MeasurementUnitName) AS MeasurementUnitName,
	    MAX(MeasurementUnitID) AS MeasurementUnitID,
	    MAX(remark.Id) as Remarks ,
	    STRING_AGG(Result, ', ')  AS Result 
	FROM (
	    SELECT DISTINCT CustomsItemId, Parent_CustomsItemId, ItemHierarchicLocationID,
	           Fullclassification, BaseFullClassification, ComputedCheckDigit, 
	           IsLeaf, GoodsDescription, Rules, Agreements, CustomsRate, 
	           PurchaseTax, OptionalTaxAddition, MeasurementUnitName, 
	           MeasurementUnitID, Result
	    FROM RecursiveCTE
	) AS DistinctResults
	LEFT JOIN (
	    SELECT Id, CustomsItemsID
	    FROM customs.RemarksClassifications
	    WHERE Tenant = @Tenant
	) AS remark ON DistinctResults.CustomsItemId = remark.CustomsItemsID
	GROUP BY CustomsItemId,IsLeaf,Rules
	ORDER BY Fullclassification;
END--new
IF @CustomsItemHierarchic is not null AND @Remarks = 1 AND @Rules = 0 --סינון של רמות שונות בעץ + הערות
BEGIN
WITH BaseCTE AS (
	    SELECT
	        m.CustomsItemId,
	        m.Parent_CustomsItemId,
	        m.ItemHierarchicLocationID,
	        m.Fullclassification,
	        m.BaseFullClassification,
	        m.ComputedCheckDigit,
	        m.IsLeaf,
	        m.GoodsDescription,
	        m.Rules,
	        m.Agreements,
	        m.CustomsRate,
	        m.PurchaseTax,
	        m.OptionalTaxAddition,
	        m.MeasurementUnitName,
	        m.MALAMID AS MeasurementUnitID,
	        'GoodsDescription' AS Result
	    FROM [dbo].[NewCustomsBookMainView] m
	    WHERE m.CI_CustomsBookTypeIDNum = @CustomsBookType
        AND m.GoodsDescription LIKE '%' + @SearchFields + '%'
        AND CHARINDEX(',' + m.ItemHierarchicLocationID + ',', ',' + @CustomsItemHierarchic + ',') > 0
	    
		UNION ALL -- הערות
		SELECT 
			m.CustomsItemId,
			m.Parent_CustomsItemId,
			m.ItemHierarchicLocationID,
			m.Fullclassification,
			m.BaseFullClassification,
			m.ComputedCheckDigit,
			m.IsLeaf,
			m.GoodsDescription,
			m.Rules,
			m.Agreements,
			m.CustomsRate, --'שיעור המכס',
			m.PurchaseTax, --'מס קניה',
			m.OptionalTaxAddition,  --'שיעור התוספת',
			m.MeasurementUnitName, -- יחידה סטטיסטית של פרט המכס
			m.MALAMID as MeasurementUnitID, -- יחידה סטטיסטית
			'Remarks' AS Result
			FROM [dbo].[NewCustomsBookMainView] m
			JOIN customs.RemarksClassifications r ON m.CustomsItemId = r.CustomsItemsID
			WHERE r.Tenant = @Tenant AND m.CI_CustomsBookTypeIDNum = @CustomsBookType AND
			r.RemarkDescription LIKE '%' + @SearchFields + '%'
	),
	RecursiveCTE AS (
	    SELECT
	        CustomsItemId,
	        Parent_CustomsItemId,
	        ItemHierarchicLocationID,
	        Fullclassification,
	        BaseFullClassification,
	        ComputedCheckDigit,
	        IsLeaf,
	        GoodsDescription,
	        Rules,
	        Agreements,
	        CustomsRate,
	        PurchaseTax,
	        OptionalTaxAddition,
	        MeasurementUnitName,
	        MeasurementUnitID,
	        Result 
	    FROM BaseCTE
	    UNION ALL
	    SELECT
	        p.CustomsItemId,
	        p.Parent_CustomsItemId,
	        p.ItemHierarchicLocationID,
	        p.Fullclassification,
	        p.BaseFullClassification,
	        p.ComputedCheckDigit,
	        p.IsLeaf,
	        p.GoodsDescription,
	        p.Rules,
	        p.Agreements,
	        p.CustomsRate,
	        p.PurchaseTax,
	        p.OptionalTaxAddition,
	        p.MeasurementUnitName,
	        p.MALAMID AS MeasurementUnitID,
	        null as result 
	    FROM [dbo].[NewCustomsBookMainView] p
	    JOIN RecursiveCTE r ON p.CustomsItemId = r.Parent_CustomsItemId
	)
	 
	SELECT 
	    CustomsItemId,
	    MAX(Parent_CustomsItemId) AS Parent_CustomsItemID,
	    MAX(ItemHierarchicLocationID) AS ItemHierarchicLocationID,
	    MAX(Fullclassification) AS FullClassification,
	    MAX(BaseFullClassification) AS BaseFullClassification,
	    MAX(ComputedCheckDigit) AS ComputedCheckDigit,
	    IsLeaf,
	    MAX(GoodsDescription) AS GoodsDescription,
	    Rules,
	    MAX(Agreements) AS Agreements,
	    MAX(CustomsRate) AS CustomsRate,
	    MAX(PurchaseTax) AS PurchaseTax,
	    MAX(OptionalTaxAddition) AS OptionalTaxAddition,
	    MAX(MeasurementUnitName) AS MeasurementUnitName,
	    MAX(MeasurementUnitID) AS MeasurementUnitID,
	    MAX(remark.Id) as Remarks ,
	    STRING_AGG(Result, ', ')  AS Result 
	FROM (
	    SELECT DISTINCT CustomsItemId, Parent_CustomsItemId, ItemHierarchicLocationID,
	           Fullclassification, BaseFullClassification, ComputedCheckDigit, 
	           IsLeaf, GoodsDescription, Rules, Agreements, CustomsRate, 
	           PurchaseTax, OptionalTaxAddition, MeasurementUnitName, 
	           MeasurementUnitID, Result
	    FROM RecursiveCTE
	) AS DistinctResults
	LEFT JOIN (
	    SELECT Id, CustomsItemsID
	    FROM customs.RemarksClassifications
	    WHERE Tenant = @Tenant
	) AS remark ON DistinctResults.CustomsItemId = remark.CustomsItemsID
	GROUP BY CustomsItemId,IsLeaf,Rules
	ORDER BY Fullclassification;
END-- new
IF @CustomsItemHierarchic is not null AND @Remarks = 1 AND @Rules = 1 --מסומן חלק בעץ + כללים + הערות
BEGIN
WITH BaseCTE AS (
	    SELECT
	        m.CustomsItemId,
	        m.Parent_CustomsItemId,
	        m.ItemHierarchicLocationID,
	        m.Fullclassification,
	        m.BaseFullClassification,
	        m.ComputedCheckDigit,
	        m.IsLeaf,
	        m.GoodsDescription,
	        m.Rules,
	        m.Agreements,
	        m.CustomsRate,
	        m.PurchaseTax,
	        m.OptionalTaxAddition,
	        m.MeasurementUnitName,
	        m.MALAMID AS MeasurementUnitID,
	        'GoodsDescription' AS Result
	    FROM [dbo].[NewCustomsBookMainView] m
	    WHERE m.CI_CustomsBookTypeIDNum = @CustomsBookType
		AND m.GoodsDescription LIKE '%' + @SearchFields + '%'
		AND CHARINDEX(',' + m.ItemHierarchicLocationID + ',', ',' + @CustomsItemHierarchic + ',') > 0
	    
		UNION ALL--כללים
	    
		SELECT m.CustomsItemId,
	        m.Parent_CustomsItemId,
	        m.ItemHierarchicLocationID,
	        m.Fullclassification,
	        m.BaseFullClassification,
	        m.ComputedCheckDigit,
	        m.IsLeaf,
	        m.GoodsDescription,
	        m.Rules,
	        m.Agreements,
	        m.CustomsRate,
	        m.PurchaseTax,
	        m.OptionalTaxAddition,
	        m.MeasurementUnitName,
	        m.MALAMID AS MeasurementUnitID,
	        'Rules' AS Result
	    FROM [dbo].[NewCustomsBookMainView] m
	    JOIN customs.CB_RuleClassifications r ON m.CustomsItemId = r.CustomsItemID
	    WHERE m.CI_CustomsBookTypeIDNum = @CustomsBookType AND m.Rules = 1
	        AND r.Rules LIKE '%' + @SearchFields + '%'
	    
		UNION ALL --הערות
	    
		SELECT
	        m.CustomsItemId,
	        m.Parent_CustomsItemId,
	        m.ItemHierarchicLocationID,
	        m.Fullclassification,
	        m.BaseFullClassification,
	        m.ComputedCheckDigit,
	        m.IsLeaf,
	        m.GoodsDescription,
	        m.Rules,
	        m.Agreements,
	        m.CustomsRate,
	        m.PurchaseTax,
	        m.OptionalTaxAddition,
	        m.MeasurementUnitName,
	        m.MALAMID AS MeasurementUnitID,
	        'Remarks' AS Result
	    FROM [dbo].[NewCustomsBookMainView] m
	    JOIN customs.RemarksClassifications r ON m.CustomsItemId = r.CustomsItemsID
	    WHERE r.Tenant = @Tenant
	        AND m.CI_CustomsBookTypeIDNum = @CustomsBookType 
	        AND r.RemarkDescription LIKE '%' + @SearchFields + '%'
	),
	RecursiveCTE AS (
	    SELECT
	        CustomsItemId,
	        Parent_CustomsItemId,
	        ItemHierarchicLocationID,
	        Fullclassification,
	        BaseFullClassification,
	        ComputedCheckDigit,
	        IsLeaf,
	        GoodsDescription,
	        Rules,
	        Agreements,
	        CustomsRate,
	        PurchaseTax,
	        OptionalTaxAddition,
	        MeasurementUnitName,
	        MeasurementUnitID,
	        Result 
	    FROM BaseCTE
	    UNION ALL
	    SELECT
	        p.CustomsItemId,
	        p.Parent_CustomsItemId,
	        p.ItemHierarchicLocationID,
	        p.Fullclassification,
	        p.BaseFullClassification,
	        p.ComputedCheckDigit,
	        p.IsLeaf,
	        p.GoodsDescription,
	        p.Rules,
	        p.Agreements,
	        p.CustomsRate,
	        p.PurchaseTax,
	        p.OptionalTaxAddition,
	        p.MeasurementUnitName,
	        p.MALAMID AS MeasurementUnitID,
	        null as result 
	    FROM [dbo].[NewCustomsBookMainView] p
	    JOIN RecursiveCTE r ON p.CustomsItemId = r.Parent_CustomsItemId
	)
	 
	SELECT 
	    CustomsItemId,
	    MAX(Parent_CustomsItemId) AS Parent_CustomsItemID,
	    MAX(ItemHierarchicLocationID) AS ItemHierarchicLocationID,
	    MAX(Fullclassification) AS FullClassification,
	    MAX(BaseFullClassification) AS BaseFullClassification,
	    MAX(ComputedCheckDigit) AS ComputedCheckDigit,
	    IsLeaf,
	    MAX(GoodsDescription) AS GoodsDescription,
	    Rules,
	    MAX(Agreements) AS Agreements,
	    MAX(CustomsRate) AS CustomsRate,
	    MAX(PurchaseTax) AS PurchaseTax,
	    MAX(OptionalTaxAddition) AS OptionalTaxAddition,
	    MAX(MeasurementUnitName) AS MeasurementUnitName,
	    MAX(MeasurementUnitID) AS MeasurementUnitID,
	    MAX(remark.Id) as Remarks ,
	    STRING_AGG(Result, ', ')  AS Result 
	FROM (
	    SELECT DISTINCT CustomsItemId, Parent_CustomsItemId, ItemHierarchicLocationID,
	           Fullclassification, BaseFullClassification, ComputedCheckDigit, 
	           IsLeaf, GoodsDescription, Rules, Agreements, CustomsRate, 
	           PurchaseTax, OptionalTaxAddition, MeasurementUnitName, 
	           MeasurementUnitID, Result
	    FROM RecursiveCTE
	) AS DistinctResults
	LEFT JOIN (
	    SELECT Id, CustomsItemsID
	    FROM customs.RemarksClassifications
	    WHERE Tenant = @Tenant
	) AS remark ON DistinctResults.CustomsItemId = remark.CustomsItemsID
	GROUP BY CustomsItemId,IsLeaf,Rules
	ORDER BY Fullclassification;
END--new
IF @CustomsItemHierarchic is null AND @Remarks = 1 AND @Rules = 1 -- סינון של כללים + הערות בלבד
BEGIN
WITH BaseCTE AS (
	    
		SELECT m.CustomsItemId,
	        m.Parent_CustomsItemId,
	        m.ItemHierarchicLocationID,
	        m.Fullclassification,
	        m.BaseFullClassification,
	        m.ComputedCheckDigit,
	        m.IsLeaf,
	        m.GoodsDescription,
	        m.Rules,
	        m.Agreements,
	        m.CustomsRate,
	        m.PurchaseTax,
	        m.OptionalTaxAddition,
	        m.MeasurementUnitName,
	        m.MALAMID AS MeasurementUnitID,
	        'Rules' AS Result
	    FROM [dbo].[NewCustomsBookMainView] m
	    JOIN customs.CB_RuleClassifications r ON m.CustomsItemId = r.CustomsItemID
	    WHERE m.CI_CustomsBookTypeIDNum = @CustomsBookType AND m.Rules = 1
	        AND r.Rules LIKE '%' + @SearchFields + '%'
	    
		UNION ALL --הערות
	    
		SELECT
	        m.CustomsItemId,
	        m.Parent_CustomsItemId,
	        m.ItemHierarchicLocationID,
	        m.Fullclassification,
	        m.BaseFullClassification,
	        m.ComputedCheckDigit,
	        m.IsLeaf,
	        m.GoodsDescription,
	        m.Rules,
	        m.Agreements,
	        m.CustomsRate,
	        m.PurchaseTax,
	        m.OptionalTaxAddition,
	        m.MeasurementUnitName,
	        m.MALAMID AS MeasurementUnitID,
	        'Remarks' AS Result
	    FROM [dbo].[NewCustomsBookMainView] m
	    JOIN customs.RemarksClassifications r ON m.CustomsItemId = r.CustomsItemsID
	    WHERE r.Tenant = @Tenant
	        AND m.CI_CustomsBookTypeIDNum = @CustomsBookType 
	        AND r.RemarkDescription LIKE '%' + @SearchFields + '%'
	),
	RecursiveCTE AS (
	    SELECT
	        CustomsItemId,
	        Parent_CustomsItemId,
	        ItemHierarchicLocationID,
	        Fullclassification,
	        BaseFullClassification,
	        ComputedCheckDigit,
	        IsLeaf,
	        GoodsDescription,
	        Rules,
	        Agreements,
	        CustomsRate,
	        PurchaseTax,
	        OptionalTaxAddition,
	        MeasurementUnitName,
	        MeasurementUnitID,
	        Result 
	    FROM BaseCTE
	    UNION ALL
	    SELECT
	        p.CustomsItemId,
	        p.Parent_CustomsItemId,
	        p.ItemHierarchicLocationID,
	        p.Fullclassification,
	        p.BaseFullClassification,
	        p.ComputedCheckDigit,
	        p.IsLeaf,
	        p.GoodsDescription,
	        p.Rules,
	        p.Agreements,
	        p.CustomsRate,
	        p.PurchaseTax,
	        p.OptionalTaxAddition,
	        p.MeasurementUnitName,
	        p.MALAMID AS MeasurementUnitID,
	        null as result 
	    FROM [dbo].[NewCustomsBookMainView] p
	    JOIN RecursiveCTE r ON p.CustomsItemId = r.Parent_CustomsItemId
	)
	 
	SELECT 
	    CustomsItemId,
	    MAX(Parent_CustomsItemId) AS Parent_CustomsItemID,
	    MAX(ItemHierarchicLocationID) AS ItemHierarchicLocationID,
	    MAX(Fullclassification) AS FullClassification,
	    MAX(BaseFullClassification) AS BaseFullClassification,
	    MAX(ComputedCheckDigit) AS ComputedCheckDigit,
	    IsLeaf,
	    MAX(GoodsDescription) AS GoodsDescription,
	    Rules,
	    MAX(Agreements) AS Agreements,
	    MAX(CustomsRate) AS CustomsRate,
	    MAX(PurchaseTax) AS PurchaseTax,
	    MAX(OptionalTaxAddition) AS OptionalTaxAddition,
	    MAX(MeasurementUnitName) AS MeasurementUnitName,
	    MAX(MeasurementUnitID) AS MeasurementUnitID,
	    MAX(remark.Id) as Remarks ,
	    STRING_AGG(Result, ', ')  AS Result 
	FROM (
	    SELECT DISTINCT CustomsItemId, Parent_CustomsItemId, ItemHierarchicLocationID,
	           Fullclassification, BaseFullClassification, ComputedCheckDigit, 
	           IsLeaf, GoodsDescription, Rules, Agreements, CustomsRate, 
	           PurchaseTax, OptionalTaxAddition, MeasurementUnitName, 
	           MeasurementUnitID, Result
	    FROM RecursiveCTE
	) AS DistinctResults
	LEFT JOIN (
	    SELECT Id, CustomsItemsID
	    FROM customs.RemarksClassifications
	    WHERE Tenant = @Tenant
	) AS remark ON DistinctResults.CustomsItemId = remark.CustomsItemsID
	GROUP BY CustomsItemId,IsLeaf,Rules
	ORDER BY Fullclassification;
END--new
END
   
    ]]>
  </SqlScript>

