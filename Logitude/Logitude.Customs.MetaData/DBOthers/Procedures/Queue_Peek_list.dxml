<Procedure DBType="Main" Name="QueueEnqueue_succeedRequestsheets" Schema="dbo" Module="Customs">

	<OracleScript>
		<![CDATA[

CREATE OR REPLACE TYPE QueueMessageType AS OBJECT (
    id NUMBER(18,0),
    RetryNumber NUMBER(10,0),
    CreateDateTime TIMESTAMP(7),
    MessageBody VARCHAR2(1000 CHAR)
);

CREATE OR REPLACE TYPE QueueMessageTableType AS TABLE OF QueueMessageType;

create or replace PROCEDURE Queue_Peek_list(
    cursor_ out SYS_REFCURSOR,
    v_QueueDefinitionCode IN VARCHAR2,
    v_NextRunDelayInSec IN NUMBER,
    v_WatingStatus IN NUMBER,
    v_SelectCount  IN NUMBER
)
AS
    v_frequency NUMBER(10,0);
    v_row QueueMessages%rowtype;

    v_QueueMessages QueueMessageTableType := QueueMessageTableType();    
    -- v_Count NUMBER := 0;     
BEGIN
 
    v_frequency := 60;

    select QueueMessageType(qt.id , qt.RetryNumber, qt.CREATEDATETIME, qt.messagebody)
    BULK COLLECT  INTO v_QueueMessages
    FROM QueueMessages qt
    WHERE qt.NextRunDateTime <= SYSDATE
       AND  qt.Status = v_WatingStatus
        AND QueueDefinitionCode = v_QueueDefinitionCode
        AND qt.UseRabbitMQ = 0
        and ROWNUM <= v_SelectCount
    ORDER BY qt.tenantpriority ASC, qt.NextRunDateTime ASC
    FOR UPDATE SKIP LOCKED;

FOR i IN 1 .. v_QueueMessages.COUNT LOOP
    UPDATE QueueMessages
    SET ProcessingDateTime = SYSDATE,
    NextRunDateTime      = (SYSDATE + v_NextRunDelayInSec/86400), 
    RetryNumber          = (RetryNumber + 1)
    WHERE Id = v_QueueMessages(i).Id;
    
    UPDATE queuemessagemoredetails
    SET ProcessingDateTime = SYSDATE,
    NextRunDateTime      = (SYSDATE + v_NextRunDelayInSec/86400),
    RetryNumber          = (RetryNumber + 1)
    WHERE Id = v_QueueMessages(i).Id;
    
    -- v_Count := v_Count + 1;
END LOOP;

-- COMMIT;

-- Open the output cursor on the collection
OPEN cursor_ FOR
SELECT * FROM TABLE(v_QueueMessages);

-- DBMS_OUTPUT.PUT_LINE('Rows updated: ' || v_Count);

EXCEPTION
    WHEN OTHERS THEN
        -- Ensure the cursor is closed in case of an error
        --IF cursor_%ISOPEN THEN
        --    CLOSE cursor_;
        --END IF;
        RAISE;

END;

	]]>

	</OracleScript>
</Procedure>