<Procedure DBType="Main" Name="usp_CB_RegularityRequirementData" Schema="dbo" Module="Customs">
  <SqlScript>
	  <![CDATA[		
				CREATE OR ALTER PROCEDURE [dbo].[usp_CB_RegularityRequirementData]
    @CustomsItemID NVARCHAR(50)
		AS
		BEGIN		
			WITH CTE AS (
				SELECT
					R.CustomsItemID,
					R.ID,
					RI.ID AS RegularityInceptionID,
					RC.RegularityInceptionID AS RCRegularityInceptionID,
					RI.RegularityRequirementID,
					RC.AuthorityID,
					RC.ConfirmationTypeID,
					R.CreateDate,
					RS.LocalName + ' / ' + RP.LocalName AS RequirementValidOrigin, -- המקור החוקי לדרישה 
					-- נובע מפרק/פרט - חסר עדיין
					RI.RequirementGoodsDescription, -- תיאור
					AU.LOCALNAME AS Authority, -- גורם מאשר
					CT.LOCALNAME AS ConfirmationType, -- סוג אישור
					RC.TextualCondition, -- תיאור תנאים 
					IR.LocalName AS InterConditionsRelationship, -- יחס תנאים
					RI.IsPersonalImportIncluded, -- חל ביבוא אישי
					RI.IsCarnetIncluded,
					RC.TrNumber,
          RC.IsVoluntaryOrImporterOfTrust,
					ROW_NUMBER() OVER (PARTITION BY RI.ID, RC.AuthorityID, RC.ConfirmationTypeID ORDER BY RC.TrNumber) AS rn
				FROM 
					customs.CB_RequirementComputedDatas R
				LEFT JOIN 
					customs.CB_RegularityInceptions RI ON R.RegularityRequirementID = RI.RegularityRequirementID 
				LEFT JOIN 
					customs.CB_RegularityRequiredCertificates RC ON RC.RegularityInceptionID = RI.ID 
				LEFT JOIN 
					Customs.RegularitySources RS ON RS.Code = R.RegularitySourceCodeID
				LEFT JOIN 
					Customs.RegularityPublications RP ON RP.Code = R.RegularityPublicationCodeID
				LEFT JOIN 
					Customs.Authorities AU ON AU.CODE = RC.AuthorityID
				LEFT JOIN 
					Customs.ConfirmationTypes CT ON CT.MALAMID = RC.ConfirmationTypeID
				LEFT JOIN 
					Customs.InterConditionsRelationships IR ON IR.Code = RI.InterConditionsRelationshipID
				WHERE 
					R.CustomsItemID = @CustomsItemID
					AND R.StartDate <= GETDATE() 
					AND R.EndDate > GETDATE()
					AND R.CountryID IS NULL
			)
			SELECT
      	CustomsItemID,
				ID,
				RequirementValidOrigin, --  המקור החוקי לדרישה 
				-- נובע מפרק/פרט - חסר עדיין
				RequirementGoodsDescription, -- תיאור
				Authority, -- גורם מאשר
				ConfirmationType + ISNULL(' / '+ STRING_AGG(TrNumber, ' / ') WITHIN GROUP (ORDER BY TrNumber),'') AS ConfirmationType, -- סוג אישור
				TextualCondition, -- תיאור תנאים
				InterConditionsRelationship, -- יחס תנאים
				IsPersonalImportIncluded, -- חל ביבוא אישי 
				IsCarnetIncluded, -- חל בקרנה 
        IsVoluntaryOrImporterOfTrust -- האם ולנטרי יבואן מפר אמון
				-- אזור אוטונומיה - חסר עדיין
			FROM 
				CTE
			GROUP BY
				CustomsItemID,
				ID,
				RegularityInceptionID,
				RegularityRequirementID,
				AuthorityID,
				ConfirmationTypeID,
				CreateDate,
				RequirementValidOrigin,
				RequirementGoodsDescription,
				Authority,
				ConfirmationType,
				TextualCondition,
				InterConditionsRelationship,
				IsPersonalImportIncluded,
				IsCarnetIncluded,
        IsVoluntaryOrImporterOfTrust
			ORDER BY
				RegularityRequirementID;

		END


    ]]>
  </SqlScript>

  <OracleScript>
    <![CDATA[
	
    ]]>
  </OracleScript>
</Procedure>