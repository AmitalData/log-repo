<Procedure DBType="Main" Name="q_Deletecommlogs" Schema="dbo" Module="Customs">
  <SqlScript>
  </SqlScript>

  <OracleScript>
    <![CDATA[
 create or replace PROCEDURE USP_deletecommlogs (
    p_days                   IN INTEGER,
    p_from                 IN STRING,
    p_to                   IN STRING,
    p_subject              IN STRING,
    p_commstatustypecodelist IN STRING
) AS
v_number number;
v_days INTEGER;
BEGIN
v_days :=p_days;
if (p_days<60) then
    v_days :=60;
end if;


    LOOP
        DELETE FROM
                communicationlogs
            WHERE
                to_ != 'Customs'
                AND createdate_ < sysdate - v_days 
                AND ( p_from IS NULL   OR from_ = p_from )
                AND ( p_subject IS NULL
                      OR subject_ = p_subject )
                AND ( p_commstatustypecodelist IS NULL
                      OR communicationstatustypecode IN (
                    SELECT
                        regexp_substr(
                            str, '[^,]+', 1, level
                        ) value
                    FROM
                        (
                            SELECT
                                p_commstatustypecodelist str
                            FROM
                                dual
                        )
                    CONNECT BY
                        level <= length(str) - length(
                            replace(
                                str, ','
                            )
                        ) + 1
                ) )
            and  ROWNUM < 1001;



       EXIT WHEN SQL%rowcount = 0;

        
        
          v_number:=SQL%rowcount ;
        insert into  ZDELETE_LOG  values   ( sysdate ,  v_number , 'abc');
        COMMIT;
    END LOOP;



   COMMIT;
END;
	
    ]]>
  </OracleScript>
</Procedure>