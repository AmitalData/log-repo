<Procedure DBType="Main" Name="Usp_DeleteCustomsRequestSheets" Schema="dbo" Module="Customs">
  <SqlScript>
  </SqlScript>

  <OracleScript>
    <![CDATA[
 CREATE OR REPLACE PROCEDURE usp_deletecustomsrequestsheets (
    p_days                   IN INTEGER,
    p_from                   IN STRING,
    p_to                     IN STRING,
    p_subject                IN STRING,
    p_commstatustypecodelist IN STRING
) AS
    v_number NUMBER;
    v_days   INTEGER;
BEGIN
    UPDATE notifications
    SET
        createdbyrequestid = NULL;

    COMMIT;
    v_days := p_days;
    IF ( p_days < 60 ) THEN
        v_days := 60;
    END IF;
    LOOP
        DELETE FROM customsrequestssheets
        WHERE
            requestcomminicationid IN (
                SELECT
                    id
                FROM
                    communicationlogs
                WHERE
                    createdate_ < sysdate - v_days
                    AND ( p_from IS NULL
                          OR from_ = p_from )
                    AND ( p_subject IS NULL
                          OR subject_ = p_subject )
                    AND ( p_commstatustypecodelist IS NULL
                          OR communicationstatustypecode IN (
                        SELECT
                            regexp_substr(
                                str, '[^,]+', 1, level
                            ) value
                        FROM
                            (
                                SELECT
                                    p_commstatustypecodelist str
                                FROM
                                    dual
                            )
                        CONNECT BY
                            level <= length(str) - length(
                                replace(
                                    str, ','
                                )
                            ) + 1
                    ) )
            )
            AND ROWNUM < 1001;

        EXIT WHEN SQL%rowcount = 0;
        v_number := SQL%rowcount;
        INSERT INTO zdelete_log VALUES (
            sysdate,
            v_number,
            'i'
        );

        COMMIT;
    END LOOP;

    COMMIT;
END;
	
    ]]>
  </OracleScript>
</Procedure>