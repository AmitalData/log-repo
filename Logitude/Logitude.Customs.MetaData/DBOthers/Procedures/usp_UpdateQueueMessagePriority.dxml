<Procedure DBType="Main" Name="usp_UpdateQueueMessagePriority" Schema="dbo" Module="Customs">
  <SqlScript>
	  <![CDATA[
	 IF  EXISTS (SELECT * FROM sys.objects WHERE type = 'P' AND name = 'usp_UpdateQueueMessagePriority')
   begin
     drop proc usp_UpdateQueueMessagePriority 
   end


   create procedure usp_UpdateQueueMessagePriority
   @Tenant int,
   @CourierMasterId varchar,
   @InterfaceTypeCode varchar,
   @TenantPriority int
   as 
   begin 
          update  dbo.QueueMessages
   		  set TenantPriority=@TenantPriority
   		  where Tenant = @Tenant and InterfaceTypeCode = @InterfaceTypeCode and NextRunDateTime <= dateadd(minute, 20, getdate()) and EntityId in (
   							select 	Id from Customs.CustomsRequestsSheets	where Tenant = @Tenant and InterfaceTypeCode = @InterfaceTypeCode	and	(RequestStatusCode = '5' or RequestStatusCode = '1' or
                                                         RequestStatusCode = '2' or RequestStatusCode = '21') and RequestCreateDate >= getdate() -7 and ((ObjectTableId1 = '1-343' and EntityId1 in (
   													  select DeclarationId from Customs.CourierDeclarations
   													   where Tenant = @Tenant and  CourierMasterId = @CourierMasterId
   													 ) ) or (ObjectTableId1 = '1-655' and  EntityId1 = @CourierMasterId) )
   
                                                        );
   													 
          update  Customs.CustomsRequestsSheets
   		  set TenantPriority=@TenantPriority
   		  where Tenant = @Tenant and InterfaceTypeCode = @InterfaceTypeCode  and	(RequestStatusCode = '5' or RequestStatusCode = '1' or
                                                         RequestStatusCode = '2' or RequestStatusCode = '21') and RequestCreateDate >= getdate()-7 and (( ObjectTableId1 = '1-343' and EntityId1 in (
   													  select DeclarationId from Customs.CourierDeclarations
   													   where Tenant = @Tenant and  CourierMasterId = @CourierMasterId) or (ObjectTableId1 = '1-655' and  EntityId1 = @CourierMasterId) )
   													 
   
                                                        );
   end

    ]]>
  </SqlScript>

  <OracleScript>
    <![CDATA[
 	create or replace PROCEDURE usp_UpdateQueueMessagePriority
		(
          v_Tenant IN NUMBER DEFAULT NULL ,
          v_CourierMasterId  IN VARCHAR2 DEFAULT NULL ,
          v_InterfaceTypeCode  IN VARCHAR2 DEFAULT NULL ,
		  v_TenantPriority IN NUMBER DEFAULT NULL
	    )
       AS
  BEGIN
     update  QueueMessages
		  set TenantPriority=v_TenantPriority
		  where Tenant = v_Tenant and InterfaceTypeCode = v_InterfaceTypeCode and NextRunDateTime <= SYSTIMESTAMP + INTERVAL '20' MINUTE and EntityId in (
							select 	Id from CustomsRequestsSheets	where Tenant = v_Tenant and InterfaceTypeCode = v_InterfaceTypeCode	and	(RequestStatusCode = '5' or RequestStatusCode = '1' or
                                                      RequestStatusCode = '2' or RequestStatusCode = '21') and RequestCreateDate >= sysdate-7 and ((ObjectTableId1 = '1-343' and EntityId1 in (
													  select DeclarationId from CourierDeclarations
													   where Tenant = v_Tenant and  CourierMasterId = v_CourierMasterId
													 ) ) or (ObjectTableId1 = '1-655' and  EntityId1 = v_CourierMasterId) )

                                                     );
													 
          update  CustomsRequestsSheets
		  set TenantPriority=v_TenantPriority
		  where Tenant = v_Tenant and InterfaceTypeCode = v_InterfaceTypeCode  and	(RequestStatusCode = '5' or RequestStatusCode = '1' or
                                                      RequestStatusCode = '2' or RequestStatusCode = '21') and RequestCreateDate >= sysdate-7 and (( ObjectTableId1 = '1-343' and EntityId1 in (
													  select DeclarationId from CourierDeclarations
													   where Tenant = v_Tenant and  CourierMasterId = v_CourierMasterId) or (ObjectTableId1 = '1-655' and  EntityId1 = v_CourierMasterId) )
													 

                                                     );
		COMMIT;											 

   END;
	
    ]]>
  </OracleScript>
</Procedure>