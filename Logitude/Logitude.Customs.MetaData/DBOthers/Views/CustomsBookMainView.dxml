<View DBType="Main" Name="CustomsBookMainView" Schema="dbo" Module="Customs">
  <SqlScript>
    <![CDATA[
   CREATE OR ALTER   VIEW [dbo].[CustomsBookMainView]
	AS
	SELECT
		item.ID,
		item.Parent_CustomsItemID,
		item.CustomsBookTypeID,
		item.CustomsItemHierarchicLocationID,
		itemHistory.GoodsDescription,
		rules.CustomsItemID AS Rules,
		'כללים' AS Remarks,-- הערות , עדיין לא אופיין
		tarrif.countries as Agreements,
		ComputationMethodData.customsRate AS 'שיעור המכס',
		ComputationMethodData.purchaseTax AS 'מס קניה',
		ComputationMethodData.additionRate AS 'שיעור התוספת',
		ComputationMethodData.MeasurementUnit AS 'יחידה סטטיסטית',
		'חוקיות' AS 'חוקיות' -- עדיין לא אופיין

	FROM
		customs.CB_CustomsItems item

	LEFT JOIN --תאור טובין
		(
			SELECT
				CustomsItemID,
				GoodsDescription,
				createdate,
				ROW_NUMBER() OVER (PARTITION BY CustomsItemID ORDER BY ChangeRequestTypePriority DESC, CreateDate DESC) AS rn
			FROM
				customs.CB_CustomsItemDetailsHistorys
				where  EntityStatusID = '2' and StartDate <= GETDATE() and EndDate >= GETDATE() 

		)AS itemHistory ON item.ID = itemHistory.CustomsItemID and itemHistory.rn = 1

	LEFT JOIN -- כללים
		(
			SELECT DISTINCT CustomsItemID
			FROM customs.CB_Rules
    
		)AS rules ON item.ID = rules.CustomsItemID

	LEFT JOIN -- הסכמים
		(

			select a.CustomsItemID,STRING_AGG(a.Title, ', ') as countries
			from
				(SELECT DISTINCT
					t.CustomsItemID,
					ta.Title
				FROM Customs.CB_Tariffs t
				INNER JOIN Customs.CB_TariffDetailsHistorys h ON t.ID = h.TariffID
				INNER JOIN customs.CB_TradeAgreements ta ON t.TradeAgreementID = ta.ID
				WHERE t.TradeAgreementID IS NOT NULL
					AND h.EntityStatusID = '2'
					AND h.StartDate <= GETDATE()
					AND h.EndDate >= GETDATE() )as a
						GROUP BY a.CustomsItemID


		)AS tarrif ON item.ID = tarrif.CustomsItemID

	LEFT JOIN -- שיעור המכס, מס קניה, שיעור התוספת, יחידה סטטיסטית 
		(
			SELECT
			sub.CustomsItemID,
			MAX(CASE WHEN title = 'מכס כללי' AND rn = 1 THEN (CASE WHEN sub.title = 'מכס כללי' THEN sub.CalculationReference ELSE NULL END) END) AS customsRate,
			MAX(CASE WHEN title = 'מס קניה' AND rn = 1 THEN (CASE WHEN sub.title = 'מס קניה' THEN sub.CalculationReference ELSE NULL END) END) AS purchaseTax,
			MAX(CASE WHEN title = 'מס קניה' AND rn = 1 THEN (CASE WHEN sub.title = 'מס קניה' THEN sub.OptionalTaxAddition ELSE NULL END) END) AS additionRate,
			MAX(CASE WHEN title = 'מס קניה' AND rn = 1 THEN (CASE WHEN sub.title = 'מס קניה' THEN sub.LOCALNAME ELSE NULL END) END) AS MeasurementUnit
			FROM (
				SELECT
					t.CustomsItemID,
					t.title,
					ROW_NUMBER() OVER (PARTITION BY t.CustomsItemID, t.title ORDER BY h.ChangeRequestTypePriority DESC, h.createDate DESC) AS rn,
					h.ChangeRequestTypePriority,
					h.createDate,
					c.CalculationReference,
					c.OptionalTaxAddition,
					m.LOCALNAME
				FROM Customs.CB_Tariffs t
				INNER JOIN Customs.CB_TariffDetailsHistorys h ON t.ID = h.TariffID
				INNER JOIN customs.CB_ComputationMethodDatas c ON h.WithoutQuota_ComputMethDataID = c.ID
				LEFT JOIN customs.MEASURMENTUNITS m on m.MALAMID = c.MeasurementUnitID

			WHERE
				t.TradeAgreementID IS NULL
				AND t.title IN ('מכס כללי','מס קניה')
				AND h.EntityStatusID = '2'
				AND h.StartDate <= GETDATE()
				AND h.EndDate >= GETDATE()
			) AS sub
			WHERE rn = 1
			GROUP BY sub.CustomsItemID
				
		)AS ComputationMethodData ON item.ID = ComputationMethodData.CustomsItemID 



	
    ]]>
  </SqlScript>
  <OracleScript> 
  </OracleScript>
</View>