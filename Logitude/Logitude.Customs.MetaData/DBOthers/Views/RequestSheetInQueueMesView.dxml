<View DBType="Main" Name="RequestSheetInQueueMesView" Schema="dbo" Module="Customs">
  <SqlScript>
    <![CDATA[
   
    ]]>
  </SqlScript>
  <OracleScript>
	  
	  <![CDATA[
CREATE OR REPLACE VIEW RequestSheetInQueueMesViews
    AS
select ObjectTableId1,Tenant,EntityId1,InterfaceTypeCode,interface.description as InterfaceTypeName  from CustomsRequestsSheets customsRequestsSheets
join interfacemanagements interface
on customsRequestsSheets.InterfaceTypeCode = interface.Code
and 
(RequestStatusCode = '5' or RequestStatusCode = '1' or RequestStatusCode = '2' or RequestStatusCode = '21') and 
RequestCreateDate >= sysdate-7 and
(
    ObjectTableId1 = (select id from objecttables where name='Customs.Declaration')
    or
    ObjectTableId1 = (select id from objecttables where name='Customs.CourierMaster')
)
and id in (
select EntityId from QueueMessages
where NextRunDateTime
NOT BETWEEN  SYSTIMESTAMP + INTERVAL '10' MINUTE    AND   SYSTIMESTAMP + INTERVAL '25' MINUTE
);
]]>
  </OracleScript>
</View>