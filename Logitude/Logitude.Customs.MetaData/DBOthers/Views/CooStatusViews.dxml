<View DBType="Main" Name="CooStatusViews" Schema="dbo" Module="Customs">
  <SqlScript>
    <![CDATA[
IF OBJECT_ID('CooStatusViews', 'V') IS NOT NULL
    DROP VIEW CooStatusViews;

EXECUTE('
CREATE VIEW CooStatusViews
AS

WITH CertificateStatus AS (
	SELECT 
		distinct c.declarationId,
		CASE
			-- If only one certificate exists for the declaration, select its status
			WHEN COUNT(*) OVER (PARTITION BY c.declarationId) = 1 THEN c.CooStatusCode

			-- If multiple certificates exist, join with SupplierInvoiceItems
			ELSE (
				SELECT TOP 1 co.CooStatusCode
				FROM customs.CertificateOfOrigins co
				INNER JOIN customs.SupplierInvoiceItems sii
					ON sii.PreferenceDocumentNumber = co.COONumber
				WHERE co.declarationId = c.declarationId
			)
		END AS StatusCode
	FROM 
		customs.CertificateOfOrigins c
)
SELECT 
    cs.declarationId as DeclarationId,
    cs.StatusCode as StatusCode
    coosce.LocalName as Status
FROM 
    CertificateStatus cs
LEFT JOIN 
    customs.CertificateOfOriginStatusCodeEnums coosce
    ON cs.StatusCode = coosce.Code;

');
    ]]>
  </SqlScript>
  <OracleScript>
	  
	  <![CDATA[
CREATE OR REPLACE VIEW CooStatusViews
    AS

SELECT 
  null  as DeclarationId,
  null  as StatusCode,
  null as Status
FROM DUAL;

 

]]>
  </OracleScript>
</View>