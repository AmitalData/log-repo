			"event": [
				{
					"listen": "test",
					"script": {
						"id": "4920ea14-b99c-407f-9682-a626c98d1e74",
						"exec": [
							"pm.test(\"AuthSuccessfullOnTenant1\", function () {",
							"    pm.response.to.have.status(200);",
							"    ",
							"   ",
							"    var idvalue1 = (pm.response.json().Token);",
							"    var idvalue2 = (pm.response.json().Tenant);",
							"    var idvalue3 = (pm.response.json().UserId);",
							"    var idvalue4 = (pm.response.json().DocumentDownloadToken);",
							"    var id1exist = idvalue1 !== null;",
							"    var id2exist = idvalue2 !== null;",
							"    var id3exist = idvalue3 !== null;",
							"    var id4exist = idvalue4 !== null;",
							"    pm.expect(id1exist);",
							"    pm.expect(id2exist);",
							"    pm.expect(id3exist);",
							"    pm.expect(id4exist);",
							"    pm.globals.set(\"Token\",idvalue1);",
							"    pm.globals.set(\"Tenant\",idvalue2);",
							"    pm.globals.set(\"LoggedUserId\",idvalue3);",
							"    pm.globals.set(\"DocumentDownloadToken\",idvalue4);",
							"    ",
							"    tests[\"BodyCointainsTokenKey : \" + id1exist] = responseBody.has(id1exist);",
							"});"
						],
						"type": "text/javascript"
					}
				},
