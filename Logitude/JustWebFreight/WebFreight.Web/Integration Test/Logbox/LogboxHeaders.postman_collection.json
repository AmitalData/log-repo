	"item": [
		{
			"name": "CheckLogboxHeaders",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "f11b7e7b-bde0-4fe0-8bd9-4389870fe03a",
						"exec": [
							"pm.test(\"AuthSuccessfullOnTenant106\", function () {",
							"    pm.response.to.have.status(200);",
							"    ",
							"     var idvalue1 = pm.response.to.have.header(\"Server\");",
							"     var idvalue2 = pm.response.to.have.header(\"Strict-Transport-Security\");",
							"     var idvalue3 = pm.response.to.have.header(\"Access-Control-Allow-Origin\");",
							"     var idvalue4 = pm.response.to.have.header(\"x-frame-options\");",
							"     var idvalue5 = pm.response.to.have.header(\"x-xss-protection\");",
							"     var idvalue6 = pm.response.to.not.have.header(\"X-AspNet-Version\");",
							"     var idvalue7 = pm.response.to.not.have.header(\"X-Powered-By\");",
							"    ",
							"     ",
							"     var id1exist = idvalue1 !== null;",
							"     var id2exist = idvalue2 !== null;",
							"     var id3exist = idvalue3 !== null;",
							"     var id4exist = idvalue4 !== null;",
							"     var id5exist = idvalue5 !== null;",
							"     var id6exist = idvalue6 === null;",
							"     var id7exist = idvalue7 === null;",
							"     ",
							"     pm.expect(pm.response.headers.get('Server')).to.eql('nginx');",
							"     pm.expect(pm.response.headers.get('Strict-Transport-Security')).to.eql('max-age=31536000 ; includeSubDomains');",
							"     pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('https://system.logbox.co.il');",
							"     pm.expect(pm.response.headers.get('x-frame-options')).to.eql('SAMEORIGIN');",
							"     pm.expect(pm.response.headers.get('x-xss-protection')).to.eql('1; mode=block');",
							"",
							"     ",
							"     ",
							"   tests[\"Headers as expected : \" + id1exist] = responseBody.has(id1exist);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
