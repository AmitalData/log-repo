							"pm.test(\"GetSystemDefaultsFromMyTenant\", function () {",
							"     pm.response.to.have.status(200);",
							"     ",
							"      var idvalue1 = pm.response.json().Id;",
							"      var idvalue2 = pm.globals.get(\"Tenant\");",
							"      var idvalue3 = pm.response.json().AddressId;",
							"      var idvalue4 = pm.response.json().LocalAddressId;",
							"      var idvalue5 = pm.response.json().PaymentTermId;",
							"      var idvalue6 = pm.response.json().AgentId;",
							"      var idvalue7 = pm.response.json().CurrencyId;",
							"      var idvalue8 = pm.response.json().ProfitCurrencyId;",
							"      var idvalue9 = pm.response.json().FreightCurrencyId;",
							"      var idvalue10 = pm.response.json().OtherChargesCurrencyId;",
							"      var idvalue11 = pm.response.json().QuoteSaleCurrencyId;",
							"      var idvalue12 = pm.response.json().DefaultSLAId;",
							"",
							"      pm.environment.set(\"TenantId\",idvalue1);",
							"      pm.environment.set(\"TenantAddressId\",idvalue3);",
							"      pm.environment.set(\"TenantLocalAddressId\",idvalue4);",
							"      pm.environment.set(\"TenantPaymentTermId\",idvalue5);",
