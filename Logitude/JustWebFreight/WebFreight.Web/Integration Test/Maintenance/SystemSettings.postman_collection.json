			"name": "AuthenticationOnMyTenant",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "4920ea14-b99c-407f-9682-a626c98d1e74",
						"exec": [
							"pm.test(\"AuthenticationOnMyTenant\", function () {",
							"    pm.response.to.have.status(200);",
							"     var idvalue1 = (pm.response.json().Token);",
							"     var idvalue2 = (pm.response.json().DocumentDownloadToken);",
							"     var id1exist = idvalue1 !== null;",
							"     var id2exist = idvalue2 !== null;",
							"     ",
							"    pm.globals.set(\"Token\", idvalue1);",
							"    pm.globals.set(\"DocumentDownloadToken\", idvalue2);",
							"    ",
							"    var expected = pm.globals.get(\"Email1\");",
							"    tests[\"Body cointains Email: \" + expected] = responseBody.has(expected);",
							"});"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"id": "80382ca3-511a-4d54-8c44-3148e0f553f8",
