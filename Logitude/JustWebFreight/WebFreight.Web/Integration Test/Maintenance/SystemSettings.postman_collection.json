					"script": {
						"exec": [
							"pm.test(\"AuthenticationOnMyTenant\", function () {",
							"    pm.response.to.have.status(200);",
							"     var idvalue1 = (pm.response.json().Token);",
							"     var idvalue2 = (pm.response.json().DocumentDownloadToken);",
							"     var idvalue3 = (pm.response.json().UserName);",
							"     ",
							"     var id1exist = idvalue1 !== null;",
							"     var id2exist = idvalue2 !== null;",
							"     var id3exist = idvalue3 !== null;",
							"     ",
							"    pm.globals.set(\"Token\", idvalue1);",
							"    pm.globals.set(\"DocumentDownloadToken\", idvalue2);",
							"    pm.globals.set(\"UserName1\", idvalue3);",
							"    ",
