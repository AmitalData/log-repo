		{
			"name": "GetCurrentMonth'sAccountingPeriods",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Get Accounting Periods\", function () {\r",
							"    \r",
							"    pm.response.to.have.status(200);\r",
							"    \r",
							"    var date = new Date();\r",
							"    var month = date.getMonth()+1;\r",
							"    pm.environment.set(\"CurrentMonth\",month);\r",
							"\r",
							"  var idvalue1;\r",
							"\r",
							"\r",
							"\r",
							" for (var i = 0; i< pm.response.json().Result.length ;i++){\r",
							"     if ( pm.response.json().Result[i].PeriodTypeCode == '1' )\r",
							"     {\r",
							"        pm.globals.set(\"AcocuntingPeriodsId\",pm.response.json().Result[i].Id);  \r",
							"        idvalue1=pm.response.json().Result[i].OpenMonth; \r",
							"\r",
							"     }\r",
							"    else if ( pm.response.json().Result[i].PeriodTypeCode == '2' )\r",
							"    {\r",
							"        pm.globals.set(\"AcocuntingPeriodsInvoiceId\",pm.response.json().Result[i].Id);  \r",
							"      \r",
							"    }\r",
							"\r",
							" }\r",
							"\r",
							"      if (idvalue1 < month)\r",
							"      {\r",
							"           tests[\"Current Month Opened  : \" + false ] = ( true );\r",
							"           \r",
							"            postman.setNextRequest(\"OpenCurrentmonth\");\r",
							"      }\r",
							"      \r",
							"     else\r",
							"      {\r",
							"  \r",
							"             tests[\"Current Month Opened  : \" + true ] = ( true );\r",
							"           postman.setNextRequest(null);  \r",
							"      }\r",
							"  \r",
							" \r",
							"});\r",
							"\r",
							"\r",
							""
						],
