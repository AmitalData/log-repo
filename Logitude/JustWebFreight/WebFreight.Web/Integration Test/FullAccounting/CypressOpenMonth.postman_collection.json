							"    var idvalue6 = (pm.response.json().Result[pm.response.json().Result.length-2].ClosedMonth);\r",
							"    \r",
							"    pm.environment.set(\"AcocuntingPeriodsId\",idvalue1);\r",
							"    pm.environment.set(\"AcocuntingPeriodsTenant\",idvalue2);\r",
							"    pm.environment.set(\"AcocuntingPeriodsYear\",idvalue3);\r",
							"    pm.environment.set(\"AcocuntingPeriodsPeriodTypeCode\",idvalue4);\r",
							"    pm.environment.set(\"AcocuntingPeriodsPeriodTypeName\",idvalue5);\r",
							"    pm.environment.set(\"AcocuntingPeriodsClosedMonth\",idvalue6);\r",
							"\r",
							" // get the invoice periods \r",
