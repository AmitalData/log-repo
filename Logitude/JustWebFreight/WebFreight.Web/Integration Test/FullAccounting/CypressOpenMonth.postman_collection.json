		{
			"name": "Authentication",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"\r",
							"\r",
							"\r",
							"    var expectedHttpStatus = 200;\r",
							"    var maxNumberOfTries = 10;\r",
							"    var numberOfRetries = 5;\r",
							"    var retries = \"{{RetriesNumber}}\";\r",
							"    var Retries = pm.globals.get(\"Retries\");\r",
							"    var sleepBetweenTries =  60000;\r",
							"\r",
							"\r",
							"\r",
							"    if ((responseCode.code !== expectedHttpStatus) & (pm.globals.get(\"Retries\") < maxNumberOfTries)) {\r",
							"         pm.globals.set(\"Retries\", ++Retries);\r",
							"         \r",
							"        setTimeout(function() {}, sleepBetweenTries);\r",
							"        \r",
							"        postman.setNextRequest(\"Authentication\"); \r",
							"    }\r",
							"       else {\r",
							"     pm.globals.set(\"Retries\",1); \r",
							"     \r",
							"\r",
							"pm.test(\"AuthSuccessfullOnTenantCypress\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"    \r",
							"    var date = new Date();\r",
							"    var CurrentYear = date.getFullYear();\r",
							"    var idvalue1 = (pm.response.json().Token);\r",
							"    var idvalue2 = (pm.response.json().CurrentTenant);\r",
							"    var idvalue3 = (pm.response.json().UserId);\r",
							"    var idvalue4 = (pm.response.json().DocumentDownloadToken);\r",
							"    var idvalue5 = (pm.response.json().InvalidDocumentToken);\r",
							"    var idvalue6= CurrentYear;\r",
							"    var id1exist = idvalue1 !== null;\r",
							"    var id2exist = idvalue2 !== null;\r",
							"    var id3exist = idvalue3 !== null;\r",
							"    var id4exist = idvalue4 !== null;\r",
							"    var id5exist = idvalue5 !== null;\r",
							"    pm.expect(id1exist);\r",
							"    pm.expect(id2exist);\r",
							"    pm.expect(id3exist);\r",
							"    pm.expect(id4exist);\r",
							"    pm.expect(id5exist);\r",
							"    pm.globals.set(\"Token\",idvalue1);\r",
							"    pm.globals.set(\"Tenant\",idvalue2);\r",
							"     //pm.environment.set(\"Tenant\",idvalue2);\r",
							"    pm.globals.set(\"LoggedUserId\",idvalue3);\r",
							"    pm.globals.set(\"DocumentDownloadToken\",idvalue4);\r",
							"    pm.globals.set(\"InvalidDocumentToken\",idvalue5);\r",
							"    pm.globals.set(\"CurrentYear\",idvalue6);\r",
							"    pm.environment.set(\"RandomNum\", _.random(1,50));\r",
							"      \r",
							"      \r",
							"    tests[\"BodyCointainsTokenKey : \" + id1exist] = responseBody.has(id1exist);\r",
							"    postman.setNextRequest(\"GetYearAccountingPeriods\");\r",
							"\r",
							"});\r",
							"}\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
