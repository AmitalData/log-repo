						"exec": [
							"pm.test(\"logged successfuly\", function () {",
							"    pm.response.to.have.status(200);",
							"    var idvalue1 = (pm.response.json().Token);",
							"    var idvalue2 = (pm.response.json().CurrentTenant);",
							"    var idvalue3 = (pm.response.json().UserId);",
							"    var id1exist = idvalue1 !== null;",
							"    var id2exist = idvalue2 !== null;",
							"    var id3exist = idvalue3 !== null;",
							"    ",
							"    var d = new Date();",
							"    var month = d.getMonth();",
							"    var day = d.getDate().toString();",
							"    var year = d.getFullYear();",
							"    var uy = year.toString().substr(-2);",
							"    month = (month + 1).toString();",
							"    var time= d.getTime();",
							"    var tot=month + day + uy +time;",
							"",
							"   ",
							"    pm.expect(id1exist);",
							"    pm.expect(id2exist);",
							"    pm.expect(id3exist);",
							"    pm.environment.set(\"Token\",idvalue1);",
							"    pm.environment.set(\"CurrentTenant\",idvalue2);",
							"    pm.environment.set(\"LoggedUserId\",idvalue3);",
							"    pm.environment.set(\"tot\",tot);",
							"   pm.environment.set(\"RandomNum\", _.random(1,50));",
							"    tests[\"BodyCointainsTokenKey : \" + id1exist] = responseBody.has(id1exist);",
							"",
							"    postman.setNextRequest(\"CreateApprovedJournal\");",
							"",
							"",
							"});"
						],
						"type": "text/javascript"
					}
				}
