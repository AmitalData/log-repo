        <xs:element minOccurs="0" maxOccurs="1" ref="TABLEDATA_ADDITIONALCODE2" />
        <xs:element minOccurs="0" maxOccurs="1" ref="TABLEDATA_REMARKS" />
        <xs:element minOccurs="0" maxOccurs="1" ref="TABLEDATA_UNF_TABLE" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="TABLEDATA_ID" type="xs:string" />
  <xs:element name="TABLEDATA_NAME_HEB" type="xs:string" />
  <xs:element name="TABLEDATA_NAME_ENG" type="xs:string" />
  <xs:element name="TABLEDATA_BLOCKED" type="xs:string" />
  <xs:element name="TABLEDATA_ADDITIONALCODE1" type="xs:string" />
  <xs:element name="TABLEDATA_ADDITIONALCODE2" type="xs:string" />
  <xs:element name="TABLEDATA_REMARKS" type="xs:string" />
  <xs:element name="TABLEDATA_UNF_TABLE" type="xs:string" />
</xs:schema>