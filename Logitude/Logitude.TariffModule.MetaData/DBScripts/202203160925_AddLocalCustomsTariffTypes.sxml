<Script DBType="Main" Module="Tariff" TargetTableName="TariffTypes">
  <Sql Version="1">
    <![CDATA[
    
        if not exists (select * from TariffTypes where Code = 'ICS')
		BEGIN
		 
			insert into TariffTypes(Code, Name,SearchFields, TransportModeCode, DirectionCode)
			values
			(
			'ICS',
			'Import Local Charges Sale',
			'ICS,Import Local Charges Sale',
			null,
			'I'
			)
		END

		if not exists (select * from TariffTypes where Code = 'ECS')
		BEGIN
		 
			insert into TariffTypes(Code, Name,SearchFields, TransportModeCode, DirectionCode)
			values
			(
			'ECS',
			'Emport Local Charges Sale',
			'ECS,Import Eocal Charges Sale',
			null,
			'E'
			)
		END
    ]]>
  </Sql>
</Script>




