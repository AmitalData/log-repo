<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="TariffTypes"
  Schema="dbo"
  DBType="Main"
  Module="TariffModule">
  <Column
    Name="Code"
    Type="varchar"
    Size="3">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Name"
    Type="nvarchar"
    Size="200">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="1000">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="TransportModeCode"
    Type="char"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DirectionCode"
    Type="char"
    Size="1">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="TransportModeCode"
    ReferencedTable="TransportModes"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="DirectionCode"
    ReferencedTable="Directions"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>