<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="TariffSettings"
  Schema="dbo"
  DBType="Main"
  Module="TariffModule">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="DefaultPriceSteps"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DefaultWarningPercentage"
    Type="float">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AirDefaultStepsId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LCLDefaultStepsId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ContainerDefaults"
    Type="varchar"
    Size="50">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="DefaultCurrencyId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="AirUnitOfMeasurementCode"
    OldNames="UnitOfMeasurementCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LCLUnitOfMeasurementCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="DefaultCurrencyId"
    ReferencedTable="Currencies"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="AirUnitOfMeasurementCode"
    ReferencedTable="WeightUnits"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="LCLUnitOfMeasurementCode"
    ReferencedTable="WeightUnits"
    ReferencedColumn="Code"
    ReferencedTableSchema="dbo" />
</Table>