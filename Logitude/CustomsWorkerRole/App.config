  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="DeclarationWebServiceSoap" />
        <binding name="CustomsExchangeRateWebServiceSoap" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://localhost:62611/CustomWebServices/DeclarationWebService.asmx" binding="basicHttpBinding" bindingConfiguration="DeclarationWebServiceSoap" contract="DeclarationWebServiceReference.DeclarationWebServiceSoap" name="DeclarationWebServiceSoap" />
      <endpoint address="http://localhost:62611/CustomWebServices/CustomsExchangeRateWebService.asmx" binding="basicHttpBinding" bindingConfiguration="CustomsExchangeRateWebServiceSoap" contract="CustomsExchangeRateWebServiceReference.CustomsExchangeRateWebServiceSoap" name="CustomsExchangeRateWebServiceSoap" />
    </client>
