  <appSettings>
    <add key="StorageServiceMode" value="fs" />
    <!-- "fs" for file system,"azure" for azure -->
    <add key="CustomsDeploymentStage" value="Pilot" />
    <!--Test for CustomsTest_queue,Dev for pcname_queue-->
    <add key="BlobServicePath" value="http://192.168.10.88/AmitalStorageService/BlobService.asmx" />
    <add key="BlobServicePath" value="http://localhost:34488/BlobService.asmx" />
  </appSettings>
