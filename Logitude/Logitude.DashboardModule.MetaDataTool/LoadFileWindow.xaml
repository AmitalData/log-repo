<Window x:Class="Logitude.DashboardModule.MetaDataTool.LoadFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Logitude.DashboardModule.MetaDataTool"
        mc:Ignorable="d"
        Title="LoadFileWindow"
        Height="130"
        Width="300">
    <Grid>
        <StackPanel VerticalAlignment="Center">
            <Button  Grid.Row="0"
                     Content="Load LJSON File"
                     Height="30"
                     Width="200"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     x:Name="btnLoadLxmlFile"
                     Click="btnLoadLxmlFile_Click"></Button>
        </StackPanel>

    </Grid>
</Window>
