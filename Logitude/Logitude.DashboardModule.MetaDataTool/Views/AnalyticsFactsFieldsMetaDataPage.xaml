<UserControl x:Class="Logitude.DashboardModule.MetaDataTool.Views.AnalyticsFactsFieldsMetaDataPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Logitude.DashboardModule.MetaDataTool.Views"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="800"
             x:Name="ThisWindow"
             Background="White">


    <UserControl.Resources>
        <LinearGradientBrush x:Key="TitleBackground" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Offset="0" Color="#FFEAEAEB" />
            <GradientStop Offset="0.610443115234375" Color="sc#1, 0.7953632, 0.795877039, 0.804215252" />
            <GradientStop Offset="0.7698894739151001" Color="sc#1, 0.735742569, 0.7373737, 0.746481657" />
            <GradientStop Offset="0.87665826082229614" Color="sc#1, 0.6566499, 0.6597632, 0.6698923" />
            <GradientStop Offset="0.95973926782608032" Color="sc#1, 0.5620594, 0.5669453, 0.5782956" />
            <GradientStop Offset="1" Color="sc#1, 0.5028865, 0.50888133, 0.520995557" />
            <GradientStop Offset="1" Color="#FFBCBDBF" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid x:Name="mainGrid">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                Margin="10"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0,0,8,8">

            </Border>
            <ScrollViewer Grid.Row="1"
                      Margin="10 0 0 0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                        Margin="0 0 0 5"
                        Background="#FFF7E3E3"
                        BorderBrush="#FFDA6F6F"
                        BorderThickness="1"
                        
                        Visibility="{Binding ErrorsVisibility}">
                        <TextBlock Margin="10"
                               FontSize="12"
                               Foreground="#FFB02020"
                               Text="{Binding ErrorMessages}" />
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Vertical">


                            <StackPanel Orientation="Horizontal" Margin="0 0 0 0">
                                <TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Code:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" Text="{Binding FieldCode, Mode=TwoWay}" />
                            </StackPanel>


                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220" Grid.Row="0"  VerticalAlignment="Center" FontWeight="Bold" Text="Display Name:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding DisplayName, Mode=TwoWay}" />
                            </StackPanel>


                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220" Grid.Row="0"  VerticalAlignment="Center" FontWeight="Bold" Text="Display Name Plural:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding DisplayNamePlural, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock  Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Data Type:" />
                                <ComboBox Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" Grid.Row="3" Grid.Column="1" ItemsSource="{Binding DataTypesList}"  SelectedValue="{Binding DataTypeCode}"/>
                            </StackPanel>


                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Can Measure:" />
                                <CheckBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" IsChecked="{Binding CanMeasure, Mode=TwoWay}" IsThreeState="False"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Can Group:" />
                                <CheckBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" IsChecked="{Binding CanGroup, Mode=TwoWay}" IsThreeState="False"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Can Secondary Group:" />
                                <CheckBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" IsChecked="{Binding CanSecondaryGroup, Mode=TwoWay}" IsThreeState="False"/>
                            </StackPanel>


                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Can Filter On Tenant Zero:" />
                                <CheckBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" IsChecked="{Binding AllowTenantZeroFilter, Mode=TwoWay}" IsThreeState="False"/>
                            </StackPanel>


                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220" Grid.Row="0"  VerticalAlignment="Center" FontWeight="Bold" Text="Joined Table Name:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding JoinedTableName, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220" Grid.Row="0"  VerticalAlignment="Center" FontWeight="Bold" Text="Joined Table DB Name:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding JoinedTableDBName, Mode=TwoWay}" />
                            </StackPanel>


                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220" Grid.Row="0"  VerticalAlignment="Center" FontWeight="Bold" Text="Joined Table Key:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding JoinedTableKey, Mode=TwoWay}" />
                            </StackPanel>


                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220" Grid.Row="0"  VerticalAlignment="Center" FontWeight="Bold" Text="Joined Table Display Field:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding JoinedTableDisplayField, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220"   VerticalAlignment="Center" FontWeight="Bold" Text="Has Unit:" />
                                <CheckBox  Margin="1 0 0 0" Width="220" Height="22" VerticalAlignment="Center" IsChecked="{Binding HasUnit, Mode=TwoWay}" IsThreeState="False"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220" Grid.Row="0"  VerticalAlignment="Center" FontWeight="Bold" Text="Unit:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding Unit, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                <TextBlock Width="220" Grid.Row="0"  VerticalAlignment="Center" FontWeight="Bold" Text="Common Filter Code:" />
                                <TextBox  Margin="1 0 0 0" Width="220" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding CommonFilterCode, Mode=TwoWay}" />
                            </StackPanel>


                        </StackPanel>



                    </Grid>
                </Grid>
            </ScrollViewer>

            <!--  Buttons  -->
            <Border Grid.Row="2"
                Margin="10"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0,0,8,8" Visibility="{Binding ButtonsVisibility}">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                    <Button x:Name="cancelBtn"
                        Width="57"
                        Height="22"
                        Margin="5,0,0,0"
                        Command="{Binding CancelBtnCommand}" CommandParameter="{Binding ElementName=ThisWindow}"
                        Content="Cancel" />
                    <Button x:Name="okBtn"
                        Width="57"
                        Height="22"
                        Margin="5,0,0,0"
                        Command="{Binding SaveBtnCommand}" CommandParameter="{Binding ElementName=ThisWindow}"
                        Content="Save" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
