<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ARInvoiceChargesConstraints"
  Schema="dbo"
  DBType="Main"
  Module="Invoice">
  <Column
    Name="Id"
    Type="varchar"
    Size="15"
    DefaultValue="''">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int"
    DefaultValue="0">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
     Name="InvoiceLineId"
     Type="varchar"
     Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
     Name="ReceivableId"
     Type="varchar"
     Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
   Name="CreateDate"
   Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="InvoiceLineId"
    ReferencedTable="ARInvoiceLines"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <Relation
    ForeignKeyColumn="ReceivableId"
    ReferencedTable="ShipmentReceivables"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
  <UniqueConstraint
    Columns="ReceivableId" />
</Table>