<Script DBType="Main" Module="Invoice" AOT="true" TargetTableName="APInvoices">
  <Sql Version="1">
    <![CDATA[  





declare @InvoiceId as varchar(15)
declare @Tenant as int
declare @IsMultipleEntities as bit
declare @MasterNumbers as varchar(1000)
declare @MasterShipmentNumbers as varchar(1000)
declare @HouseNumbers as varchar(1000)
declare @ShipmentId as varchar(15)
declare @ShipmentLevel as varchar(15)
declare @ShipmentNumber as varchar(50)
declare @MasterNumber as varchar(50)
declare @HouseNumber as varchar(50)

BEGIN 
		DECLARE InvoicesCursor CURSOR READ_ONLY
		FOR
		SELECT Id, Tenant, IsMultipleEntities, MasterNumber, HouseNumber, MainEntityId, MainEntityReference
		FROM APInvoices
		where  $LastCounterWhere$
		OPEN InvoicesCursor FETCH NEXT FROM InvoicesCursor INTO @InvoiceId, @Tenant, @IsMultipleEntities, @MasterNumber, @HouseNumber, @ShipmentId, @ShipmentNumber
		WHILE @@FETCH_STATUS = 0
			BEGIN

				set @MasterNumbers = ''
				set @MasterShipmentNumbers = ''
				set @HouseNumbers = ''

				if (@IsMultipleEntities = 1)
				begin
					
					declare @MultipleEntityShipmentNumber as varchar(50)
					declare @MultipleEntityMasterNumber as varchar(50)
					declare @MultipleEntityHouseNumber as varchar(50)
					declare @MultipleEntityShipmentId as varchar(15)
					declare @MultipleEntityShipmentLevel as varchar(15)
					declare @MultipleEntityMasterShipmentNumber as varchar(50)

					BEGIN 
							DECLARE APInvoiceEntitiesCursor CURSOR READ_ONLY
							FOR
							SELECT EntityId, EntityReference
							FROM APInvoiceEntities
							where Tenant = @Tenant and APInvoiceId = @InvoiceId
							OPEN APInvoiceEntitiesCursor FETCH NEXT FROM APInvoiceEntitiesCursor INTO @MultipleEntityShipmentId, @MultipleEntityShipmentNumber 
							WHILE @@FETCH_STATUS = 0
								BEGIN

									set @ShipmentLevel = (select ShipmentLevelCode from Shipments where Id = @MultipleEntityShipmentId and Tenant = @Tenant)
									set @MultipleEntityMasterNumber = (select Master from ShipmentMasterDatas where Id = @MultipleEntityShipmentId and Tenant = @Tenant)
									set @MultipleEntityHouseNumber = (select House from Shipments where Id = @MultipleEntityShipmentId and Tenant = @Tenant)
									set @MultipleEntityMasterShipmentNumber = ''
									
									if (@MasterNumbers = '') set @MasterNumbers = @MultipleEntityMasterNumber
									else 
										if CHARINDEX(@MultipleEntityMasterNumber,@MasterNumbers) <= 0										
											set @MasterNumbers = @MasterNumbers + ', ' + @MultipleEntityMasterNumber												

									----------------------------------------------------------------------------------------------

									if (@HouseNumbers = '') set @HouseNumbers = @MultipleEntityHouseNumber
									else 
										if CHARINDEX(@MultipleEntityHouseNumber,@HouseNumbers) <= 0										
											set @HouseNumbers = @HouseNumbers + ', ' + @MultipleEntityHouseNumber						

								    ----------------------------------------------------------------------------------------------
									
									if(@ShipmentLevel = 'H')
									begin
										set @MultipleEntityMasterShipmentNumber = (select ShipmentNumber from Shipments where Tenant = @Tenant and Id = (select MasterShipmentDataId from Shipments where Id = @MultipleEntityShipmentId and Tenant = @Tenant))

										if (@MasterShipmentNumbers = '') set @MasterShipmentNumbers = @MultipleEntityMasterShipmentNumber
										else
											if CHARINDEX(@MultipleEntityMasterShipmentNumber,@MasterShipmentNumbers) <= 0										
												set @MasterShipmentNumbers = @MasterShipmentNumbers + ', ' + @MultipleEntityMasterShipmentNumber
													
									 end

									else
									begin
										if (@MasterShipmentNumbers = '') set @MasterShipmentNumbers = @MultipleEntityShipmentNumber
									else 
										if CHARINDEX(@MultipleEntityShipmentNumber,@MasterShipmentNumbers) <= 0										
											set @MasterShipmentNumbers = @MasterShipmentNumbers + ', ' + @MultipleEntityShipmentNumber
									end
								FETCH NEXT FROM APInvoiceEntitiesCursor INTO @MultipleEntityShipmentId, @MultipleEntityShipmentNumber 
								END
							CLOSE APInvoiceEntitiesCursor
							DEALLOCATE APInvoiceEntitiesCursor
					END
				end

				else
				begin
					set @MasterNumbers = @MasterNumber
					set @HouseNumbers = @HouseNumber
					set @MasterShipmentNumbers = @ShipmentNumber

					set @ShipmentLevel = (select ShipmentLevelCode from Shipments where Id = @ShipmentId and Tenant = @Tenant)
					if(@ShipmentLevel = 'H')
					begin
						set @MasterShipmentNumbers = (select ShipmentNumber from Shipments where Tenant = @Tenant and Id = (select MasterShipmentDataId from Shipments where Id = @ShipmentId and Tenant = @Tenant))
					end
				end

				update APInvoices set MasterNumbers = @MasterNumbers, HouseNumbers = @HouseNumbers, MasterShipmentNumbers = @MasterShipmentNumbers 
				where Id = @InvoiceId and Tenant = @Tenant

			FETCH NEXT FROM InvoicesCursor INTO @InvoiceId, @Tenant, @IsMultipleEntities, @MasterNumber, @HouseNumber, @ShipmentId, @ShipmentNumber
			END
		CLOSE InvoicesCursor
		DEALLOCATE InvoicesCursor
END

        ]]>
  </Sql>
</Script>