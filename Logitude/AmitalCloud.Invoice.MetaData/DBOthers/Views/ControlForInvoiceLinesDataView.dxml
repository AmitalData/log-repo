<View DBType="Main" Name="ControlForInvoiceLinesDataView" Schema="dbo" Module="Invoice">
  <SqlScript>
    <![CDATA[
        CREATE VIEW [dbo].[ControlForInvoiceLinesDataView]
        AS
        select ar.Tenant,
	      ar.InvoiceDate, 
	      ar.InvoiceNumber,
	      arl.Description,
	      arl.LineActionCode,
	      arl.VatPercentage,
	      arl.LocalCurrencyAmount,
	      gl.AccountTypeCode,
	      gl.DisplayNumber,
	      gl.LocalName as LocalName1 ,
	      CH.LocalName as LocalName2,
	      CH.Code,CH.TypeCode,
	      CHT.LocalName as LocalName3,
	      tax.TaxReportMonth,
	      ar.CreateDate,	      
	      jad.TaxReportId,
	      ar.AmountInLocalCurrency ,
	      ar.IsExternalEntity,
	      ar.TotalExamptFortaxReport,
	      ar.TotalVAT,
	      ar.TotalAmountForTaxReport,
	      ar.MainEntityReference ,
        tax.StatusCode
        from ARInvoiceLines ARL inner join ARInvoices AR on AR.id=ARL.ARInvoiceId
        inner join GLAccounts GL on GL.id=ARL.GLAccountId and gl.tenant=arl.tenant
        inner join ChartOfAccounts CH on CH.id=GL.ChartOfAccountsId and ch.tenant=gl.tenant
        inner join ChartOfAccountsTypes CHT on CHT.Code=CH.TypeCode
        inner join Journals JR on JR.AccountingEntityId=AR.Id and jr.Tenant=ar.Tenant and JR.AccountingEntityCode='2'
        inner join JournalAdditionalDatas JAD on JAD.JournalId=JR.id and jad.Tenant=jr.Tenant
        left join TaxReports TAX on TAX.Id=JAD.TaxReportId  and tax.Tenant=jad.Tenant

]]>
  </SqlScript>
  <OracleScript>
  </OracleScript>
</View>