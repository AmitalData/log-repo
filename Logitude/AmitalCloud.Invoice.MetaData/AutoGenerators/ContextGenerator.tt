<#+ 
private void GenerateDecimalFields(string xmlFilePath)
{
	var entity = FromEntityFile(xmlFilePath);
   
	 string tableName = entity.ObjectTableName.Trim('"');
	string dBTableName = entity.DBTableName.Trim('"');
	if(tableName.Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
          
    }

	foreach(var field in entity["field"])  //get all classes
	 {
	
	 if( field.HasDataBaseField.GetType() == typeof(string))
        {
          if(field.HasDataBaseField == "false")
             {
                continue;
             }
         }
		string typecode = field.FieldsDataType.ToString().Trim('"') as string;
		if(typecode == "Decimal")
        {
			dynamic fieldName = field.FieldName.ToString().Trim('"');
			if(field.NumberOfDigits.GetType() == typeof(string))
            {
				dynamic digitsafterpoint = 0;
				if(field.DigitsAfterPoint.GetType() == typeof(string))
                {
					digitsafterpoint = field.DigitsAfterPoint;
                }
			#>
	
			modelBuilder.Entity<POCO.<#= tableName #>>().Property(x => x.<#= fieldName #>).HasPrecision(<#= field.NumberOfDigits #>, <#= digitsafterpoint #>);
			<#+
            }
	        //           modelBuilder.Entity<PaymentOrder>().Property(x => x.TotalSumToPay).HasPrecision(16, 2);
        }
	 }
}
 #>

