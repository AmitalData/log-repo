<Script DBType="Main" Pre="true" Module="TimeManagement">
  <Sql Version="1">
    <![CDATA[
    
    ;WITH CTE
    AS
    (
        SELECT ProjectNumber,  CreateDate, ROW_NUMBER() OVER (PARTITION BY ProjectNumber order by CreateDate) AS rn
        FROM TMProjects
    )
    update CTE set ProjectNumber =  (ProjectNumber+ '-'+ CONVERT(varchar(10), rn-1)) WHERE rn > 1
    
  ]]>
  </Sql>
</Script>



