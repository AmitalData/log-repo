<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="DigitalTextCodes"
  Schema="dbo"
  DBType="Main"
  Module="TextCodes">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UpdateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ObjectTableId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Labels"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ProfileId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="LanguageCode"
    OldNames="LangaugeCode"
    Type="varchar"
    Size="3">
    <Constraints
      Nullable="true" />
  </Column>
  <Relation
    ForeignKeyColumn="ObjectTableId"
    ReferencedTable="ObjectTables"
