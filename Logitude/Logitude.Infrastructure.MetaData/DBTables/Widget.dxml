<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="Widgets"
  Schema="dbo"
  DBType="Main"
  Module="Infrastructure">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="Title"
    Type="nvarchar"
    Size="300">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="GroupBy"
    Type="varchar"
    Size="300">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="DashboardId"
    Type="varchar"
    Size="15">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="StartPotistion"
    Type="nvarchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EndPosition"
    Type="varchar"
    Size="100">
    <Constraints
      Nullable="false" />
  </Column>
  <Relation
    ForeignKeyColumn="DashboardId"
    ReferencedTable="Dashboards"
    ReferencedColumn="Id"
    ReferencedTableSchema="dbo" />
</Table>