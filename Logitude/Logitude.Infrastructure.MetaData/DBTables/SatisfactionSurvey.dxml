<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="SatisfactionSurveys"
  Schema="dbo"
  DBType="Main"
  Module="SatisfactionSurvey">
  <Column
    Name="Id"
    Type="varchar"
    Size="40">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="CreateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="UpdateDate"
    Type="datetime">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="SearchFields"
    Type="nvarchar"
    Size="-1">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Rating"
    Type="nvarchar"
    Size="60">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Comments"
    Type="nvarchar"
    Size="250">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsSync"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="LockedBy"
    Type="nvarchar"
    Size="36">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="SyncDate"
    Type="datetime">
    <Constraints
      Nullable="true" />
  </Column>
</Table>