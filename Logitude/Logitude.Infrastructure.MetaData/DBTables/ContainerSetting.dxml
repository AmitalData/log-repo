<?xml version="1.0" encoding="utf-8"?>
<Table
  Name="ContainerSettings"
  Schema="dbo"
  DBType="Main"
  Module="Infrastructure">
  <Column
    Name="Id"
    Type="varchar"
    Size="15">
    <Constraints
      PrimaryKey="true"
      Nullable="false" />
  </Column>
  <Column
    Name="Tenant"
    Type="int">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="EmptyReturnClosingDays"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ShipmentATAClosingDays"
    Type="int">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="ShipmentATADateIndicator"
    Type="varchar"
    Size="20">
    <Constraints
      Nullable="true" />
  </Column>
  <Column
    Name="IsExport"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsDomestic"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsImport"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="IsDrop"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="AddedManually"
    Type="bit">
    <Constraints
      Nullable="false" />
  </Column>
  <Column
    Name="ActivationDate"
    Type="date">
    <Constraints
      Nullable="true" />
  </Column>
</Table>