<Script DBType="Main" Module="Infrastructure" Env="Logitude,local,test">
  <Sql Version="3">
    <![CDATA[
	   DECLARE @Tenant as int
	   DECLARE @ShipmentATAClosingDays as int
	   DECLARE @EmptyReturnClosingDays as int
	   DECLARE @ShipmentATADateIndicator as varchar(20)
	   DECLARE @NewId as varchar(15)
	   
	   BEGIN   
      	   DECLARE DataCursor CURSOR READ_ONLY
      	   FOR
      	   SELECT 
		   Id, 
		   ShipmentATAClosingDays, 
		   EmptyReturnClosingDays, 
		   ShipmentATADateIndicator
		   
      	   FROM Tenants where ShipmentATAClosingDays is not null or EmptyReturnClosingDays is not null or ShipmentATADateIndicator is not null
      	   OPEN DataCursor FETCH NEXT FROM DataCursor INTO
		   
		   @Tenant,
		   @ShipmentATAClosingDays,
		   @EmptyReturnClosingDays,
		   @ShipmentATADateIndicator
		   
      	   WHILE @@FETCH_STATUS = 0
      	   BEGIN       
					  if not exists (select * from ContainerSettings where Tenant = @Tenant)
             				  BEGIN
                    				 EXECUTE usp_GetNextTableIdValue @NewId OUTPUT,'ContainerSetting'
                    				 insert into ContainerSettings(Id, Tenant, ShipmentATAClosingDays, EmptyReturnClosingDays, ShipmentATADateIndicator, IsDomestic, IsDrop, IsExport, IsImport)
                    				 values
                    				 (
                    				 @NewId,
                    				 @Tenant,
                    				 @ShipmentATAClosingDays,
                    				 @EmptyReturnClosingDays,
                    				 @ShipmentATADateIndicator,
                    				 1,
                    				 1,
                    				 1,
                    				 1
                    				 )
             				  END
      		   FETCH NEXT FROM DataCursor INTO
			   @Tenant,
			   @ShipmentATAClosingDays,
		       @EmptyReturnClosingDays,
		       @ShipmentATADateIndicator
      	   END
      	   CLOSE DataCursor
      	   DEALLOCATE DataCursor
	   END
    ]]>       
  </Sql>
</Script>
