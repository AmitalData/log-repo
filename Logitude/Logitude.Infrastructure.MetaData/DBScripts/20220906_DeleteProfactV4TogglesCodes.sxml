      DELETE FROM FeatureToggles WHERE ToggleCode = 'PF4'
      DELETE FROM Toggles WHERE code = 'PF4'
      
      DELETE FROM FeatureToggles WHERE ToggleCode = 'RFF'
      DELETE FROM Toggles WHERE code = 'RFF'
    ]]>       
  </Sql>
</Script>