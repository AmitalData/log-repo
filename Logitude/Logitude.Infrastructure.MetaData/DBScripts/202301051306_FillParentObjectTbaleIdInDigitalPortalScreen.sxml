<Script DBType="Main" Module="Infrastructure">
  <Sql Version="8">
    <![CDATA[
    declare @shipmentObjectId as varchar(15)
    set @shipmentObjectId = (select Id from ObjectTables where [Name] = 'Shipment' and Tenant = 0 )
    declare @shipmentPackageObjectTableId as varchar(15)
    set @shipmentPackageObjectTableId = (select Id from ObjectTables where [Name] = 'ShipmentPackage' and Tenant = 0)
    declare @shipmentPickUpDeliveryObjectTableId as varchar(15)
    set @shipmentPickUpDeliveryObjectTableId = (select Id from ObjectTables where [Name] = 'ShipmentPickUpDelivery' and Tenant = 0)
    update  DigitalFieldSecurities
    set ParentObjectTableId = @shipmentObjectId
    where ObjectTableId in (@shipmentPackageObjectTableId, @shipmentPickUpDeliveryObjectTableId)
    ]]>
  </Sql>
</Script>