<Script DBType="Main" Module="Infrastructure">
  <Sql Version="14">
      <![CDATA[	  
	  delete from DigitalFieldSecurities where id != ''
	  delete from DigitalProfiles where id != ''

      declare @NewEntityId as varchar(15)
 	  EXECUTE usp_GetNextTableIdValue @NewEntityId OUTPUT, 'DigitalProfiles'
	  INSERT INTO DigitalProfiles (Id, Tenant, CreateDate, UpdateDate,  Name) 
	  values (@NewEntityId, 0, CURRENT_TIMESTAMP,  CURRENT_TIMESTAMP, 'Customer')
	  EXECUTE usp_GetNextTableIdValue @NewEntityId OUTPUT, 'DigitalProfiles'
	  INSERT INTO DigitalProfiles (Id, Tenant, CreateDate, UpdateDate,  Name) 
	  values (@NewEntityId, 0, CURRENT_TIMESTAMP,  CURRENT_TIMESTAMP, 'Agent')
	  declare @newDigitalFieldEntityId as varchar(15)
 	  EXECUTE usp_GetNextTableIdValue @newDigitalFieldEntityId OUTPUT,'DigitalFieldSecurity'

	  declare @generalObjectTableId as varchar(15)
	  set @generalObjectTableId = (select Id from ObjectTables where [Name] = 'General' and Tenant = 0 )

	  declare @customerProfileId as varchar(15)
	  set @customerProfileId = (select Id from DigitalProfiles where [Name] = 'Customer' and Tenant = 0 )

	  INSERT INTO DigitalFieldSecurities (Id, Tenant, ObjectTableId, CreateDate, UpdateDate, ProfileId, DefaultSettings) 
	  values (@newDigitalFieldEntityId, 0, @generalObjectTableId, CURRENT_TIMESTAMP,  CURRENT_TIMESTAMP, @customerProfileId, 
	  '[{
			"FieldCode": "Contact.Birthday"
		},
		{
