<Script DBType="Main" Module="Infrastructure">
	<Sql Version="8">
      <![CDATA[	  
	  
		delete from DigitalPreDefinedComponents where id != ''
		declare @shipmentObjectId as varchar(15)
		set @shipmentObjectId = (select Id from ObjectTables where [Name] = 'Shipment' and Tenant = 0 )
		
		declare @EntityId as varchar(15)
 		EXECUTE usp_GetNextTableIdValue @EntityId OUTPUT,'DigitalPreDefinedComponents'
	
		INSERT INTO DigitalPreDefinedComponents (Id, Tenant, ObjectTableId, CreateDate, UpdateDate, [Name], Content) 
	    values (@EntityId,
				0,
				@shipmentObjectId,
				CURRENT_TIMESTAMP,
				CURRENT_TIMESTAMP,
				'Shipment status component for tablet',
				'<ShipmentStatusInfoForTablet></ShipmentStatusInfoForTablet>')

 		EXECUTE usp_GetNextTableIdValue @EntityId OUTPUT,'DigitalPreDefinedComponents'
	
		INSERT INTO DigitalPreDefinedComponents (Id, Tenant, ObjectTableId, CreateDate, UpdateDate, Name, Content) 
	    values (@EntityId,
				0,
				@shipmentObjectId,
				CURRENT_TIMESTAMP,
				CURRENT_TIMESTAMP,
				'Shipment horizontal timeline component',
				'<HorizontalTimeline></HorizontalTimeline>');
				
	    EXECUTE usp_GetNextTableIdValue @EntityId OUTPUT,'DigitalPreDefinedComponents'
	
		INSERT INTO DigitalPreDefinedComponents (Id, Tenant, ObjectTableId, CreateDate, UpdateDate, Name, Content) 
	    values (@EntityId,
				0,
				@shipmentObjectId,
				CURRENT_TIMESTAMP,
				CURRENT_TIMESTAMP,
				'Shipment status info component',
				'<ShipmentStatusInfo></ShipmentStatusInfo>');
				
				EXECUTE usp_GetNextTableIdValue @EntityId OUTPUT,'DigitalPreDefinedComponents'
	
		INSERT INTO DigitalPreDefinedComponents (Id, Tenant, ObjectTableId, CreateDate, UpdateDate, Name, Content) 
	    values (@EntityId,
				0,
				@shipmentObjectId,
				CURRENT_TIMESTAMP,
				CURRENT_TIMESTAMP,
				'Field Template',
				'<!-- You can add more then one field by seprating them by comma -->
<FieldTemplate field-code=''''></FieldTemplate>');				
		]]>
</Sql>
</Script>