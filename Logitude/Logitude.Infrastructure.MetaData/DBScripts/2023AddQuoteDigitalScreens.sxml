                                <LogFieldContainer>
                                    <LogField class=''log-font-medium''
                                    field-code=''Quote.QuoteNumber''>
                                </LogFieldContainer>
                            </LogColumn>
                        </LogRow>
                        <LogRow class=''border-0 padding-0 margin-0''>
                            <LogColumn>
                                <LogFieldContainer>
                                    <LogLabel field-code=''Quote.OpenDate''></LogLabel>
                                    <LogField disable-copy=''true'' is-date=''true'' field-code=''Quote.OpenDate''></LogField>
                                </LogFieldContainer>
                            </LogColumn>
                        </LogRow>                   
                    </LogColumn>  

                    <LogColumn class="log-quote-list-item-column" width=''40%''>
                        <LogRow class=''border-0  padding-0 margin-0''>     
                            <LogColumn width=''auto''>        
                                <LogFieldContainer>
                                    <LogLabel text-code=''Quote.G.Destination''></LogLabel>
                                    <LogIcon code=''Quote.FromCountryCode''></LogIcon>
                                    <LogField disable-copy=''true'' field-code=''Quote.FromPortNameCode''></LogField>
                                    <LogIcon icon-class=''log-quote-destination-arrow'' code=''ArrowRight''></LogIcon>
                                    <LogIcon code=''Quote.ToCountryCode''></LogIcon>
                                    <LogField disable-copy=''true'' field-code=''Quote.ToPortNameCode''></LogField>
                                </LogFieldContainer>
                            </LogColumn>
                        </LogRow>
                        <LogRow class=''border-0  padding-0 margin-0''>     
                            <LogColumn>
                                <LogFieldContainer>
                                    <LogLabel field-code=''Quote.CustomerName''></LogLabel>
                                    <LogField tooltip=''true'' field-code=''Quote.CustomerName''></LogField>
                                </LogFieldContainer>
                            </LogColumn>
                        </LogRow>
                    </LogColumn>

                    <LogColumn class="log-quote-list-item-column" width=''20%''>
                        <LogRow class=''border-0 padding-0''>
                            <LogColumn>
                                <LogFieldContainer>
                                    <LogLabel field-code=''Quote.TransitTime''></LogLabel>
                                    <LogField tooltip=''true'' disable-copy=''true'' field-code=''Quote.TransitTime''></LogField>
                                </LogFieldContainer>
                            </LogColumn>
                        </LogRow>
                        <LogRow class=''border-0 padding-0 margin-0''>
                            <LogColumn>
                                <LogFieldContainer>
                                    <LogLabel field-code=''Quote.ExpirationDate''></LogLabel>
                                    <LogField log-if=''{Quote.IsExpired} === [true]'' class="log-color-date-overdue" tooltip=''true'' disable-copy=''true'' is-date=''true'' field-code=''Quote.ExpirationDate''></LogField>
                                    <LogField log-if=''{Quote.IsExpired} !== [true]'' disable-copy=''true'' tooltip=''true'' disable-copy=''true'' is-date=''true'' field-code=''Quote.ExpirationDate''></LogField>
                                </LogFieldContainer>
                            </LogColumn>
                        </LogRow>
                    </LogColumn>

                    <LogColumn class="log-quote-list-item-column" width=''20%''>
                        <LogRow class=''border-0 padding-0''>
                            <LogColumn margin=''0 0.5 0 0''>
                                <LogFieldContainer>
                                    <LogQuoteItemDownloadButton></LogQuoteItemDownloadButton>
                                </LogFieldContainer>
                            </LogColumn>
                            <LogColumn>
                                <LogFieldContainer>
                                    <LogField log-if=''{Quote.StageCode} != [QTAC] && {Quote.StageCode} != [QTDC] && {Quote.StageCode} != [QTCR]'' class="log-quote-status-accepted" disable-copy=''true'' field-code=''Quote.StageName''></LogField>
                                    <LogField log-if=''{Quote.StageCode} === [QTAC]'' class="log-quote-status-accepted" disable-copy=''true'' field-code=''Quote.StageName''></LogField>
                                    <LogField log-if=''{Quote.StageCode} === [QTDC]'' class="log-quote-status-declined" disable-copy=''true'' field-code=''Quote.StageName''></LogField>
                                    <LogField log-if=''{Quote.StageCode} === [QTCR]'' class="log-quote-status-created" disable-copy=''true'' field-code=''Quote.StageName''></LogField>
                                </LogFieldContainer>
                            </LogColumn>
                        </LogRow>
                        <LogRow class=''border-0 padding-0 margin-0''>
                            <LogColumn>
                                <LogFieldContainer>
                                    <LogLabel field-code=''Quote.LastStageDate''></LogLabel>
                                    <LogField disable-copy=''true'' is-date=''true'' field-code=''Quote.LastStageDate''></LogField>
                                </LogFieldContainer>
                            </LogColumn>
                        </LogRow>
                    </LogColumn>
                    
                </LogRow>                                  
