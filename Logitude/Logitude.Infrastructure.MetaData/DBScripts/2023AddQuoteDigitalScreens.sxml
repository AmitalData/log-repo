<Script  DBType="Main" Module="Infrastructure">
  <Sql Version="15">
    <![CDATA[
	  declare @objectTableId as varchar(15)
	  set @objectTableId = (select Id from ObjectTables where [Name] = 'Quote' and Tenant = 0)
	  
	  declare @newEntityId as varchar(15)
	  
	  declare @customerProfileId as varchar(15)
	  set @customerProfileId = (select Id from DigitalProfiles where [Name] = 'Customer' and Tenant = 0 )
	  
	  declare @agentProfileId as varchar(15)
	  set @agentProfileId = (select Id from DigitalProfiles where [Name] = 'Agent' and Tenant = 0 )
	  	  
	  delete from DigitalPortalScreens where Tenant = 0 and ObjectTableId = @objectTableId
	  
	  	 -------------------------------------------------------------------content-------------------------------------------------------------------------------
		 
	  declare @content nvarchar(MAX) = 
	  	  '
			<LogTable>
                <LogRow class=''border-0 padding-0 margin-0''>
                
                    <LogColumn class="log-quote-list-item-column" width=''20%''>
                        <LogRow class=''border-0  padding-0 margin-0''>             
                            <LogColumn width=''auto''>
                                <LogIcon log-if=''{Quote.TransportModeId}===[A]'' code=''Air''></LogIcon>
                                <LogIcon log-if=''{Quote.TransportModeId}===[O]'' code=''Ocean''></LogIcon>
                                <LogIcon log-if=''{Quote.TransportModeId}===[I]'' code=''Inland''></LogIcon>
                            </LogColumn>
                            <LogColumn width=''auto''>
                                <LogFieldContainer class=''log-shipment-type''>
                                    <LogField font-size=''12'' disable-copy=''true''
                                    field-code=''Quote.ShipmentType''>
                                </LogFieldContainer>
                            </LogColumn>         
