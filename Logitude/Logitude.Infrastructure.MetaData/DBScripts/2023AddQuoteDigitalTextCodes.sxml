<Script  DBType="Main" Module="Infrastructure">
  <Sql Version="40">
    <![CDATA[
	
	 BEGIN
	   IF NOT EXISTS (select * from DigitalPortalLanguages where [Code] = 'EN')
	    BEGIN
	  	 INSERT INTO DigitalPortalLanguages (Code, Name, SearchFields, DisplayText) values ('EN', 'English', 'EN,English,English', 'English')
	    END
	  END
	  BEGIN
	  	IF NOT EXISTS (select * from DigitalPortalLanguages where [Code] = 'ES')
	  	 BEGIN
	  	  INSERT INTO DigitalPortalLanguages (Code, Name, SearchFields, DisplayText)	values ('ES', 'Spanish', 'ES,Spanish,Espanol', 'Espanol')
	  	 END
	  END

	  declare @languageCode as varchar(3)
	  set @languageCode = (select Code from DigitalPortalLanguages where [Code] = 'EN')
	  Update DigitalTextCodes Set LanguageCode = @languageCode where Id != '' and LanguageCode = NULL;

	  declare @objectTableId as varchar(15)
	  set @objectTableId = (select Id from ObjectTables where [Name] = 'Quote' and Tenant = 0)
	  
	  declare @newEntityId as varchar(15)
	  EXECUTE usp_GetNextTableIdValue @NewEntityId OUTPUT,'DigitalTextCode'	  
	  declare @customerProfileId as varchar(15)
	  set @customerProfileId = (select Id from DigitalProfiles where [Name] = 'Customer' and Tenant = 0 )
	  
	  declare @agentProfileId as varchar(15)
	  set @agentProfileId = (select Id from DigitalProfiles where [Name] = 'Agent' and Tenant = 0 )
	  	  	  
	  delete from DigitalTextCodes where Tenant = 0 and ObjectTableId = @objectTableId
	  
