				"DefaultText": "Create date",
				"FieldCode": "",
				"DisplayText": ""
			},
			{
				"TextCode": "Quote.G.Created",
				"DefaultText": "Created",
				"FieldCode": "Quote.OpenDate",
				"DisplayText": ""
			},	
			{
				"TextCode": "Quote.G.ExpirationDate",
				"DefaultText": "Expiration date",
				"FieldCode": "Quote.ExpirationDate",
				"DisplayText": ""
			},
			{
				"TextCode": "Quote.G.TransitTime",
				"DefaultText": "Transit time",
				"FieldCode": "Quote.TransitTime",
				"DisplayText": ""
			},
			{
				"TextCode": "Quote.G.Price",
				"DefaultText": "Price",
				"FieldCode": "",
				"DisplayText": ""
			},		
			{
				"TextCode": "Quote.G.QuoteNumber",
				"DefaultText": "Quote number",
				"FieldCode": "",
				"DisplayText": ""
			},
			{
				"TextCode": "Quote.F.QuoteNumber",
				"DefaultText": "Quote No.",
				"FieldCode": "Quote.QuoteNumber",
				"DisplayText": ""
			},
			{
				"TextCode": "Quote.G.TransportMode",
				"DefaultText": "Transport mode",
				"FieldCode": "Quote.TransportModeId",
				"DisplayText": ""
			},
			{
				"TextCode": "Quote.G.TransportModeName",
				"DefaultText": "Transport mode name",
				"FieldCode": "Quote.TransportModeName",
				"DisplayText": ""
			},		
			{
				"TextCode": "Quote.G.Customer",
				"DefaultText": "Customer",
				"FieldCode": "Quote.CustomerName",
				"DisplayText": ""
		    },
			{
				"TextCode": "Quote.G.ShipmentNumber",
				"DefaultText": "Shipment number",
				"FieldCode": "Quote.ShipmentNumber",
				"DisplayText": ""
		    },		
			{
				"TextCode": "Quote.G.LastStageDate",
				"DefaultText": "Status updated",
