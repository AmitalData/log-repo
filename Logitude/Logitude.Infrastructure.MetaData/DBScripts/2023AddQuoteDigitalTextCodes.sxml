			},
			{
				"TextCode": "Quote.G.OriginCountry",
				"DefaultText": "Origin country",
				"FieldCode": "",
				"DisplayText": ""
			},
			{
				"TextCode": "Quote.G.DestinationCountry",
				"DefaultText": "Destination country",
				"FieldCode": "",
				"DisplayText": ""
			},
			{
				"TextCode": "Quote.G.ExpireDate",
				"DefaultText": "Expire date",
