<Script DBType="Main" Module="Infrastructure">
	<Sql Version="15">
      <![CDATA[
	  
	    delete from DigitalPortalScreens where Id != ''
		declare @customerProfileId as varchar(15)
		set @customerProfileId = (select Id from DigitalProfiles where [Name] = 'Customer' and Tenant = 0 )
		declare @agentProfileId as varchar(15)
		set @agentProfileId = (select Id from DigitalProfiles where [Name] = 'Agent' and Tenant = 0 )
		declare @shipmentObjectId as varchar(15)
		set @shipmentObjectId = (select Id from ObjectTables where [Name] = 'Shipment' and Tenant = 0 )
		declare @EntityId as varchar(15)
		EXECUTE usp_GetNextTableIdValue @EntityId OUTPUT,'DigitalPortalScreen'
		INSERT INTO DigitalPortalScreens (Id, Tenant, ObjectTableId, CreateDate, UpdateDate, [Name], ScreenCode, ProfileId, Content, DraftContent) 
		values (@EntityId, 0, @shipmentObjectId, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP, 'Shipment list card item - Desktop & Tablets', 'SLCI', @customerProfileId,
 		'<LogTable>
			<LogRow>
				<LogColumn width=''30%''>
					<LogRow class=''border-0 margin-0 padding-0''>
						<LogColumn class=''display-flex-center''>
							<LogIcon log-if=''{Shipment.DirectionId}===[I]'' code=''Import''>
							</LogIcon>
							<LogIcon log-if=''{Shipment.DirectionId}===[E]'' code=''Export''>
							</LogIcon>
							<LogIcon log-if=''{Shipment.DirectionId}===[D]'' code=''Domestic''>
							</LogIcon>
							<LogIcon log-if=''{Shipment.DirectionId}===[R]'' code=''Drop''>
							</LogIcon>
							<LogElement type=''separator''></LogElement>
							<LogIcon log-if=''{Shipment.TransportModeId}===[A]'' code=''Air''></LogIcon>
							<LogIcon log-if=''{Shipment.TransportModeId}===[O]'' code=''Ocean''></LogIcon>
							<LogIcon log-if=''{Shipment.TransportModeId}===[I]'' code=''Inland''></LogIcon>
							<LogElement type=''badge'' field-code=''Shipment.shipment-type''></LogElement>
							<LogElement type=''separator'' log-if=''{Shipment.RequestedDocumentsCount} > [0]''></LogElement>
							<LogIcon tooltip=''true'' field-code=''Shipment.RequestedDocumentsCount''
								log-if=''{Shipment.RequestedDocumentsCount} > [0]'' code=''RequiredDocument''>
							</LogIcon>
							<LogField width="70%" class=''log-font-medium'' field-code=''Shipment.ShipmentNumber''></LogField>
						</LogColumn>
					</LogRow>
					<LogRow class=''border-0 padding-0 margin-0 margin-top-8px''>
						<LogColumn>
							<LogFieldContainer>
								<LogLabel field-code=''Shipment.References''></LogLabel>
								<LogField tooltip=''true'' field-code=''Shipment.CustomerReference1,Shipment.CustomerReference2'' concat-separator='':''>
								</LogField>
							</LogFieldContainer>
						</LogColumn>
					</LogRow>
					<LogRow log-if=''{Shipment.TransportModeId}===[A]'' class=''border-0 padding-0 margin-0 margin-top-8px''>
						<LogColumn>
							<LogFieldContainer>
								<LogLabel field-code=''Shipment.MAWB''></LogLabel>
								<LogField field-code=''Shipment.LongMaster''>
								</LogField>
							</LogFieldContainer>
						</LogColumn>
					</LogRow>
					<LogRow log-if=''{Shipment.TransportModeId}===[O] || {Shipment.TransportModeId}===[I]''
						class=''border-0 padding-0 margin-0 margin-top-8px''>
						<LogColumn>
							<LogFieldContainer>
								<LogLabel log-if=''{Shipment.TransportModeId}===[O]'' field-code=''Shipment.OBL''></LogLabel>
								<LogLabel log-if=''{Shipment.TransportModeId}===[I]'' field-code=''Shipment.CMRRWB''></LogLabel>
								<LogField field-code=''Shipment.Master''>
								</LogField>
							</LogFieldContainer>
						</LogColumn>
					</LogRow>
					<LogRow class=''display-lg-none-xl-flex border-0 padding-0 margin-0 margin-top-8px''>
						<LogColumn>
							<LogFieldContainer>
								<LogLabel field-code=''Shipment.CustomerName''></LogLabel>
								<LogField field-code=''Shipment.CustomerName''></LogField>
							</LogFieldContainer>
						</LogColumn>
					</LogRow>
					<LogRow class=''display-lg-block-xl-none border-0 padding-0 margin-0 margin-top-8px''>
						<LogColumn>
							<LogFieldContainer>
								<LogLabel field-code=''Shipment.StatusDate''></LogLabel>
								<LogField disable-copy=''true'' is-date-time=''true'' field-code=''Shipment.StatusDate''></LogField>
							</LogFieldContainer>
						</LogColumn>
					</LogRow>
					<LogRow
						log-if=''{Shipment.NotesSharedWithCustomer}!== [undefined] && {Shipment.NotesSharedWithCustomer}!== [null] && {Shipment.NotesSharedWithCustomer}!== ""''
						class=''border-0 padding-0 margin-0 margin-top-8px''>
						<LogColumn>
							<LogFieldContainer>
								<LogLabel field-code=''Shipment.NotesSharedWithCustomer''></LogLabel>
								<LogField tooltip=''true'' field-code=''Shipment.NotesSharedWithCustomer''></LogField>
							</LogFieldContainer>
						</LogColumn>
					</LogRow>
				</LogColumn>
				<LogColumn width=''44%'' class=''timeline-container''>
					<ShipmentStatusInfoForTablet></ShipmentStatusInfoForTablet>
					<HorizontalTimeline></HorizontalTimeline>
				</LogColumn>
				<LogColumn width=''26%'' class=''align-self-start display-lg-none-xl-block''>
					<ShipmentStatusInfo></ShipmentStatusInfo>
					<LogFieldContainer class=''justify-content-end''>
						<LogLabel field-code=''Shipment.StatusDate''></LogLabel>
						<LogField disable-copy=''true'' is-date-time=''true'' field-code=''Shipment.StatusDate''></LogField>
					</LogFieldContainer>
				</LogColumn>
			</LogRow>
			<LogRow class=''border-0 padding-0 margin-0 display-lg-full-width''>
				<LogColumn width=''100%'' class=''display-lg-block-xl-none''>
					<LogFieldContainer>
						<LogLabel field-code=''Shipment.CustomerName''></LogLabel>
						<LogField field-code=''Shipment.CustomerName''></LogField>
					</LogFieldContainer>
				</LogColumn>
				<LogColumn width=''65%'' class=''padding-right-8px''>
					<LogFieldContainer>
						<LogLabel tooltip=''true'' field-code=''Shipment.DescriptionOfGoods''></LogLabel>
						<LogField tooltip=''true'' field-code=''Shipment.DescriptionOfGoods''></LogField>
					</LogFieldContainer>
				</LogColumn>
				<LogColumn width=''35%''>
					<LogFieldContainer log-if=''{Shipment.DirectionId}!==[I]''>
						<LogLabel field-code=''Shipment.ConsigneeName''></LogLabel>
						<LogIcon code=''Shipment.ConsigneeAddressCountryCode''></LogIcon>
						<LogField tooltip=''true'' field-code=''Shipment.ConsigneeName''></LogField>
					</LogFieldContainer>
					<LogFieldContainer log-if=''{Shipment.DirectionId}===[I]''>
						<LogLabel field-code=''Shipment.ShipperName''></LogLabel>
						<LogIcon code=''Shipment.ShipperAddressCountryCode''></LogIcon>
						<LogField tooltip=''true'' field-code=''Shipment.ShipperName''></LogField>
					</LogFieldContainer>
				</LogColumn>
			</LogRow>
		</LogTable>',
