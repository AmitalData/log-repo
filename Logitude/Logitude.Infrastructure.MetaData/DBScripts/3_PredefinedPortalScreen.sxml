			</LogFieldContainer>
			<LogFieldContainer class=''log-shipment-type''
				log-if=''{Shipment.ShipmentTypeName}!== [undefined] && {Shipment.ShipmentTypeName}!== [null] && {Shipment.ShipmentSubTypeName}!== [undefined] && {Shipment.ShipmentSubTypeName}!== [null] && {Shipment.ShipmentSubTypeName}=== {Shipment.ShipmentTypeName}''>
				<LogField font-size=''12'' disable-copy=''true'' field-code=''Shipment.ShipmentTypeName''>
				</LogField>
			</LogFieldContainer>
			<LogFieldContainer class=''log-shipment-type''
				log-if=''{Shipment.ShipmentTypeName}!== [undefined] && {Shipment.ShipmentTypeName}!== [null] && {Shipment.ShipmentSubTypeName}=== [undefined] || {Shipment.ShipmentSubTypeName} === [null]''>
				<LogField font-size=''12'' disable-copy=''true'' field-code=''Shipment.ShipmentTypeName''>
				</LogField>
			</LogFieldContainer>
		</LogColumn>
		<LogColumn width=''auto'' max-width=''55%''>
			<LogFieldContainer>
				<LogField class=''log-font-medium'' field-code=''Shipment.ShipmentNumber''>
			</LogFieldContainer>
			</LogField>
		</LogColumn>
	</LogRow>
	<LogRow class=''border-0 padding-0''>
		<LogColumn>
			<LogFieldContainer>
				<LogLabel field-code=''Shipment.CustomerReference1''></LogLabel>
				<LogField field-code=''Shipment.CustomerReference1''>
				</LogField>
			</LogFieldContainer>
		</LogColumn>
	</LogRow>
	<LogRow
		log-if=''{Shipment.CustomerReference2}!== [undefined] && {Shipment.CustomerReference2}!== [null] && {Shipment.CustomerReference2}!== ""''
		class=''border-0 padding-0''>
		<LogColumn>
			<LogFieldContainer>
				<LogLabel field-code=''Shipment.CustomerReference2''></LogLabel>
				<LogField field-code=''Shipment.CustomerReference2''>
				</LogField>
			</LogFieldContainer>
		</LogColumn>
	</LogRow>
	<LogRow log-if=''{Shipment.TransportModeId}===[A]'' class=''border-0 padding-0''>
		<LogColumn>
			<LogFieldContainer>
				<LogLabel field-code=''Shipment.MAWB''></LogLabel>
				<LogField field-code=''Shipment.LongMaster''></LogField>
			</LogFieldContainer>
		</LogColumn>
	</LogRow>
	<LogRow log-if=''{Shipment.TransportModeId}===[O] || {Shipment.TransportModeId}===[I]'' class=''border-0 padding-0''>
		<LogColumn>
			<LogFieldContainer>
				<LogLabel log-if=''{Shipment.TransportModeId}===[O]'' field-code=''Shipment.OBL''></LogLabel>
				<LogLabel log-if=''{Shipment.TransportModeId}===[I]'' field-code=''Shipment.CMRRWB''></LogLabel>
				<LogField field-code=''Shipment.Master''></LogField>
			</LogFieldContainer>
		</LogColumn>
	</LogRow>
	<LogRow class=''border-0 padding-0''>
		<LogColumn>
			<LogFieldContainer>
				<LogLabel field-code=''Shipment.CustomerName''></LogLabel>
				<LogField field-code=''Shipment.CustomerName''></LogField>
			</LogFieldContainer>
		</LogColumn>
	</LogRow>
	<LogRow>
		<LogColumn>
			<LogFieldContainer log-if=''{Shipment.DirectionId}!==[I]''>
				<LogLabel field-code=''Shipment.ConsigneeName''></LogLabel>
				<LogIcon code=''Shipment.ConsigneeAddressCountryCode''></LogIcon>
				<LogField tooltip=''true'' field-code=''Shipment.ConsigneeName''></LogField>
			</LogFieldContainer>
			<LogFieldContainer log-if=''{Shipment.DirectionId}===[I]''>
				<LogLabel field-code=''Shipment.ShipperName''></LogLabel>
				<LogIcon code=''Shipment.ShipperAddressCountryCode''></LogIcon>
				<LogField tooltip=''true'' field-code=''Shipment.ShipperName''></LogField>
			</LogFieldContainer>
		</LogColumn>
	</LogRow>
	<LogRow log-if=''{Shipment.RequestedDocumentsCount} > [0]''>
		<LogColumn>
			<LogFieldContainer class="align-items-start">
				<LogIcon field-code=''Shipment.RequestedDocumentsCount'' code=''RequiredDocument''></LogIcon>
				<LogFieldContainer class="log-white-space-normal log-display-block" color=''#202020'' font-size=''14''>
					You have
					<LogField color=''#202020'' field-code=''Shipment.RequestedDocumentsCount''></LogField>
					required dcouments to be uploaded
				</LogFieldContainer>
			</LogFieldContainer>
		</LogColumn>
	</LogRow>
	<LogRow class=''border-0 padding-0 margin-0''>
		<LogColumn width=''100%''>
			<LogHorizontalTimelineForMobile></LogHorizontalTimelineForMobile>
		</LogColumn>
	</LogRow>
</LogTable>

