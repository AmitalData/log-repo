<Script DBType="Main" Module="Infrastructure">
	<Sql Version="15">
      <![CDATA[	  
	  
		delete from DigitalPortalScreens where id != ''
		declare @shipmentObjectId as varchar(15)
		set @shipmentObjectId = (select Id from ObjectTables where [Name] = 'Shipment' and Tenant = 0 )
        declare @EntityId as varchar(15)
 		EXECUTE usp_GetNextTableIdValue @EntityId OUTPUT,'DigitalPortalScreens'
		INSERT INTO DigitalPortalScreens (Id, Tenant, ObjectTableId, CreateDate, UpdateDate, [Name], ScreenCode, Content, DraftContent) 
	    values (@EntityId, 0, @shipmentObjectId, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP, 'Shipment list card item', 'SLCI', 
 		   '<div class=''list-item-first-row''>
			<div class=''list-item-first-col''>
				<div class=''p-d-flex p-ai-center p-jc-start''>
					<div class=''transport-direction margin-top-3''>
						<LogIcon icon-class=''p-mr-1 branded-icon'' dp-if=''{Shipment.DirectionId}===[I]'' icon=''Import''>
						</LogIcon>
						<LogIcon icon-class=''p-mr-1 branded-icon'' dp-if=''{Shipment.DirectionId}===[E]'' icon=''Export''>
						</LogIcon>
						<LogIcon icon-class=''p-mr-1 branded-icon'' dp-if=''{Shipment.DirectionId}===[D]'' icon=''Domestic''>
						</LogIcon>
						<LogIcon icon-class=''p-mr-1 branded-icon'' dp-if=''{Shipment.DirectionId}===[R]'' icon=''Drop''>
						</LogIcon>
					</div>
					<LogElement type=''separator''></LogElement>
					<LogIcon dp-if=''{Shipment.TransportModeId}===[A]'' icon=''Air''></LogIcon>
					<LogIcon dp-if=''{Shipment.TransportModeId}===[O]'' icon=''Ocean''></LogIcon>
					<LogIcon icon-class=''p-ml-1'' dp-if=''{Shipment.TransportModeId}===[I]'' icon=''Inland''>
					</LogIcon>
					<div class=''shipment-number-container p-d-flex p-ai-center p-jc-start''>
						<div
							class=''shipment-type p-ml-1 dp-border-radius-4px dp-font-size-12 dp-color-black-3 dp-font-weight-400 p-p-1 dp-bg-color-gray-4 p-mr-1''>
							<LogElement type=''badge'' field-code=''Shipment.shipment-type''></LogElement>
						</div>
						<div class=''shipment-number p-ml-1 dp-font-size-16 dp-font-weight-600 dp-color-black-3''>
							<span class=''shipment-number-label dp-position-relative''><LogField field-code=''Shipment.ShipmentNumber''></LogField></span>
						</div>
					</div>
				</div>
				<div class=''p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-1 p-d-flex p-ai-start p-jc-start''>
					<FieldTemplate tooltip=''true'' field-code=''Shipment.CustomerReference1,Shipment.CustomerReference2''>
					</FieldTemplate>
				</div>
				<LogContainer dp-if=''{Shipment.TransportModeId}===[A]''
					class=''p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-1 p-d-flex p-ai-start p-jc-start''>
					<FieldTemplate dp-if=''{Shipment.TransportModeId}===[A]'' field-code=''Shipment.LongMaster''></FieldTemplate>
					<FieldTemplate dp-if=''{Shipment.TransportModeId}===[O]'' field-code=''Shipment.LongMaster''></FieldTemplate>
					<FieldTemplate dp-if=''{Shipment.TransportModeId}===[I]'' field-code=''Shipment.LongMaster''></FieldTemplate>
				</LogContainer>
				<LogContainer dp-if=''{Shipment.TransportModeId}!==[A]''
					class=''p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-1 p-d-flex p-ai-start p-jc-start''>
					<FieldTemplate dp-if=''{Shipment.TransportModeId}===[A]'' field-code=''Shipment.Master''></FieldTemplate>
					<FieldTemplate dp-if=''{Shipment.TransportModeId}===[O]'' field-code=''Shipment.Master''></FieldTemplate>
					<FieldTemplate dp-if=''{Shipment.TransportModeId}===[I]'' field-code=''Shipment.Master''></FieldTemplate>
				</LogContainer>
				<div class=''display-lg-flex-none p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-1 p-ai-start p-jc-start''>
					<FieldTemplate field-code=''Shipment.CustomerName''></FieldTemplate>
				</div>
				<div class=''display-lg-block padding-top-bottom-2 dp-font-weight-400 dp-font-size-14''>
					<FieldTemplate field-code=''Shipment.StatusDate'' disable-copy=''true'' is-date-time=''true''></FieldTemplate>
				</div>
				<div data-valid-only=''true'' field-code=''Shipment.NotesSharedWithCustomer''
					class=''p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-1 p-d-flex p-ai-start p-jc-start''>
					<FieldTemplate tooltip=''true'' field-code=''Shipment.NotesSharedWithCustomer''></FieldTemplate>
				</div>
			</div>
			<div class=''list-item-timeline-container''>
				<ShipmentStatusInfoForTablet></ShipmentStatusInfoForTablet>
				<HorizontalTimeline></HorizontalTimeline>
			</div>
			<div class=''list-item-third-col p-d-flex p-flex-column p-jc-end p-ai-end''>
				<ShipmentStatusInfo></ShipmentStatusInfo>
				<div class=''dp-font-weight-400 dp-font-size-14 p-mb-0 p-d-flex p-ai-start p-jc-end''>
					<FieldTemplate container-classes=''p-mr-0'' field-code=''Shipment.StatusDate'' disable-copy=''true''
						is-date-time=''true''></FieldTemplate>
				</div>
			</div>
		</div>
		<div
			class=''list-item-second-row p-d-flex p-ai-center p-jc-between p-flex-wrap p-mt-2 dp-font-weight-400 dp-font-size-14''>
			<div
				class=''white-space-nowrap w--100 display-lg-block dp-font-weight-400 dp-font-size-14 p-mb-2 display-flex p-ai-start p-jc-start''>
				<div class=''p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-0 p-d-flex p-ai-start p-jc-start''>
					<FieldTemplate field-code=''Shipment.CustomerName''></FieldTemplate>
				</div>
			</div>
			<div class=''description-of-goods p-d-inline-flex p-ai-center p-jc-start''>
				<LogContainer
					class=''dp-position-relative text-cut p-mt-1 dp-font-weight-400 dp-font-size-14 dp-color-gray-3 p-d-flex p-ai-start p-jc-start''>
					<LogLabel field-code=''Shipment.DescriptionOfGoods''></LogLabel>: <LogField
						tooltip=''true'' field-code=''Shipment.DescriptionOfGoods''
						label-classes=''p-ml-1''></LogField>
				</LogContainer>
			</div>
			<div class=''consignee-shipper-info p-d-inline-flex p-ai-center p-jc-start''>
				<div class=''text-cut p-mt-1 dp-font-weight-400 dp-font-size-14 p-d-flex p-ai-center p-jc-start''>
					<FieldTemplate dp-if=''{Shipment.DirectionId}!==[I]'' tooltip=''true'' field-code=''Shipment.ConsigneeName''
						flag-field=''ConsigneeCountryCode''></FieldTemplate>
					<FieldTemplate dp-if=''{Shipment.DirectionId}===[I]'' tooltip=''true'' field-code=''Shipment.ShipperName''
						flag-field=''ShipperCountryCode''></FieldTemplate>
				</div>
			</div>
		</div>'
			,'<div class=''list-item-first-row''>
			<div class=''list-item-first-col''>
				<div class=''p-d-flex p-ai-center p-jc-start''>
					<div class=''transport-direction margin-top-3''>
						<LogIcon icon-class=''p-mr-1 branded-icon'' dp-if=''{Shipment.DirectionId}===[I]'' icon=''Import''>
						</LogIcon>
						<LogIcon icon-class=''p-mr-1 branded-icon'' dp-if=''{Shipment.DirectionId}===[E]'' icon=''Export''>
