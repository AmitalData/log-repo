<Script DBType="Main" Module="Infrastructure">
	<Sql Version="23">
      <![CDATA[	  
	  
		delete from DigitalPortalScreens where id != ''
		declare @customerProfileId as varchar(15)
		set @customerProfileId = (select Id from DigitalProfiles where [Name] = 'Customer' and Tenant = 0 )
		declare @agentProfileId as varchar(15)
		set @agentProfileId = (select Id from DigitalProfiles where [Name] = 'Agent' and Tenant = 0 )
		declare @shipmentObjectId as varchar(15)
		set @shipmentObjectId = (select Id from ObjectTables where [Name] = 'Shipment' and Tenant = 0 )
		declare @EntityId as varchar(15)
 		
		EXECUTE usp_GetNextTableIdValue @EntityId OUTPUT,'DigitalPortalScreen'
		INSERT INTO DigitalPortalScreens (Id, Tenant, ObjectTableId, CreateDate, UpdateDate, [Name], ScreenCode, ProfileId, Content, DraftContent) 
		values (@EntityId, 0, @shipmentObjectId, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP, 'Shipment list card item - Desktop & Tablets', 'SLCI', @customerProfileId,
 		'<LogTable>
		<LogRow log-class=''list-item-first-row''>
			<LogColumn log-class=''p-d-flex list-item-first-col''>
				<LogTable>
					<LogRow log-class=''p-d-flex p-pb-0 p-mb-0''>
						<LogColumn log-class=''p-d-flex p-ai-center p-jc-start''>
							<div class=''transport-direction margin-top-3''>
								<LogIcon icon-class=''p-mr-1 branded-icon'' dp-if=''{Shipment.DirectionId}===[I]''
									code=''Import''>
								</LogIcon>
								<LogIcon icon-class=''p-mr-1 branded-icon'' dp-if=''{Shipment.DirectionId}===[E]''
									code=''Export''>
								</LogIcon>
								<LogIcon icon-class=''p-mr-1 branded-icon'' dp-if=''{Shipment.DirectionId}===[D]''
									code=''Domestic''>
								</LogIcon>
								<LogIcon icon-class=''p-mr-1 branded-icon'' dp-if=''{Shipment.DirectionId}===[R]'' code=''Drop''>
								</LogIcon>
							</div>
						</LogColumn>
						<LogColumn log-class=''p-d-flex p-ai-center p-jc-start''>
							<LogElement type=''separator''></LogElement>
							<LogIcon dp-if=''{Shipment.TransportModeId}===[A]'' code=''Air''></LogIcon>
							<LogIcon dp-if=''{Shipment.TransportModeId}===[O]'' code=''Ocean''></LogIcon>
							<LogIcon icon-class=''p-ml-1'' dp-if=''{Shipment.TransportModeId}===[I]'' code=''Inland''></LogIcon>
						</LogColumn>
						<LogColumn log-class=''shipment-number-container p-d-flex p-ai-center p-jc-start''>
							<div
								class=''shipment-type p-ml-1 dp-border-radius-4px dp-font-size-12 dp-color-black-3 dp-font-weight-400 p-p-1 dp-bg-color-gray-4 p-mr-1''>
								<LogElement type=''badge'' field-code=''Shipment.shipment-type''></LogElement>
							</div>

							<LogElement type=''separator'' dp-if=''{Shipment.RequestedDocumentsCount} > [0]''></LogElement>
							<LogIcon icon-class=''pi pi-exclamation-circle color-dp-primary p-ml-1'' tooltip=''true''
								field-code=''Shipment.RequestedDocumentsCount''
								dp-if=''{Shipment.RequestedDocumentsCount} > [0]'' code=''RequiredDocument''>
							</LogIcon>

							<div class=''shipment-number p-ml-1 dp-font-size-16 dp-font-weight-600 dp-color-black-3''>
								<span class=''shipment-number-label dp-position-relative''><LogField field-code=''Shipment.ShipmentNumber''></LogField></span>
							</div>
						</LogColumn>
					</LogRow>
					<LogRow
						log-class=''p-mt-2 p-pb-0 p-mb-0 dp-font-weight-400 dp-font-size-14 p-d-flex p-ai-start p-jc-start''>
						<LogColumn log-class=''white-space-nowrap''>
							<FieldTemplate tooltip=''true''
								field-code=''Shipment.CustomerReference1,Shipment.CustomerReference2''>
							</FieldTemplate>
						</LogColumn>

					</LogRow>
					<LogRow dp-if=''{Shipment.TransportModeId}===[A]''
						log-class=''p-mt-2 p-pb-0 p-mb-0 dp-font-weight-400 dp-font-size-14 p-d-flex p-ai-start p-jc-start''>
						<LogColumn log-class=''white-space-nowrap''>
							<FieldTemplate dp-if=''{Shipment.TransportModeId}===[A]'' field-code=''Shipment.LongMaster''>
							</FieldTemplate>
						</LogColumn>

					</LogRow>
					<LogRow dp-if=''{Shipment.TransportModeId}!==[A]''
						log-class=''p-mt-2 p-pb-0 p-mb-0 dp-font-weight-400 dp-font-size-14 p-d-flex p-ai-start p-jc-start''>
						<LogColumn log-class=''white-space-nowrap''>
							<FieldTemplate dp-if=''{Shipment.TransportModeId}===[O]'' field-code=''Shipment.Master''>
							</FieldTemplate>
							<FieldTemplate dp-if=''{Shipment.TransportModeId}===[I]'' field-code=''Shipment.Master''>
							</FieldTemplate>
						</LogColumn>
					</LogRow>
					<LogRow
						log-class=''display-lg-flex-none p-mt-2 p-pb-0 dp-font-weight-400 dp-font-size-14 p-ai-start p-jc-start''>
						<LogColumn log-class=''white-space-nowrap''>
							<FieldTemplate field-code=''Shipment.CustomerName''></FieldTemplate>
						</LogColumn>

					</LogRow>
					<LogRow log-class=''p-pb-0 p-mb-0 p-mt-2 display-lg-block dp-font-weight-400 dp-font-size-14''>
						<LogColumn log-class=''white-space-nowrap''>
							<FieldTemplate field-code=''Shipment.StatusDate'' disable-copy=''true'' is-date-time=''true''>
							</FieldTemplate>
						</LogColumn>
					</LogRow>
					<LogRow
						dp-if=''{Shipment.NotesSharedWithCustomer}!== undefined && {Shipment.NotesSharedWithCustomer}!== null''
						log-class=''p-mt-2 p-pb-1 p-mb-0 dp-font-weight-400 dp-font-size-14 p-d-flex p-ai-start p-jc-start''>
						<LogColumn log-class=''white-space-nowrap''>
							<FieldTemplate tooltip=''true'' field-code=''Shipment.NotesSharedWithCustomer''></FieldTemplate>
						</LogColumn>
					</LogRow>
				</LogTable>
			</LogColumn>
			<LogColumn log-class=''list-item-timeline-container''>
				<ShipmentStatusInfoForTablet></ShipmentStatusInfoForTablet>
				<HorizontalTimeline></HorizontalTimeline>
			</LogColumn>
			<LogColumn log-class=''list-item-third-col p-d-flex p-flex-column p-jc-end p-ai-end''>
				<ShipmentStatusInfo></ShipmentStatusInfo>
				<div class=''dp-font-weight-400 dp-font-size-14 p-mb-0 p-d-flex p-ai-start p-jc-end''>
					<FieldTemplate container-classes=''p-mr-0'' field-code=''Shipment.StatusDate'' disable-copy=''true''
						is-date-time=''true''></FieldTemplate>
				</div>
			</LogColumn>
		</LogRow>
		<LogRow
			log-class=''p-p-0 p-m-0 list-item-second-row p-d-flex p-ai-center p-jc-between p-flex-wrap p-mt-2 dp-font-weight-400 dp-font-size-14''>
			<LogColumn
				log-class=''white-space-nowrap w--100 display-lg-block dp-font-weight-400 dp-font-size-14 p-mb-2 display-flex p-ai-start p-jc-start''>
				<div class=''p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-0 p-d-flex p-ai-start p-jc-start''>
					<FieldTemplate field-code=''Shipment.CustomerName''></FieldTemplate>
				</div>
			</LogColumn>
			<LogColumn log-class=''description-of-goods p-d-inline-flex p-ai-center p-jc-start''>
				<LogContainer
					class=''dp-position-relative text-cut p-mt-1 dp-font-weight-400 dp-font-size-14 dp-color-gray-3 p-d-flex p-ai-start p-jc-start''>
					<LogLabel tooltip=''true'' field-code=''Shipment.DescriptionOfGoods''></LogLabel>: <LogField tooltip=''true''
						field-code=''Shipment.DescriptionOfGoods''></LogField>
				</LogContainer>
			</LogColumn>
			<LogColumn log-class=''consignee-shipper-info p-d-inline-flex p-ai-center p-jc-start''>
				<div class=''text-cut p-mt-1 dp-font-weight-400 dp-font-size-14 p-d-flex p-ai-center p-jc-start''>
					<FieldTemplate dp-if=''{Shipment.DirectionId}!==[I]'' tooltip=''true'' field-code=''Shipment.ConsigneeName''
						flag-field=''ConsigneeCountryCode''></FieldTemplate>
					<FieldTemplate dp-if=''{Shipment.DirectionId}===[I]'' tooltip=''true'' field-code=''Shipment.ShipperName''
						flag-field=''ShipperCountryCode''></FieldTemplate>
				</div>
			</LogColumn>
		</LogRow>
	</LogTable>
