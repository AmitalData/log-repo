					field-code=''Shipment.ConsigneeName'' flag-field=''ConsigneeAddressCountryCode''></FieldTemplate>
				<FieldTemplate disable-copy=''true'' dp-if=''{Shipment.DirectionId}===[I]'' tooltip=''true''
					field-code=''Shipment.ShipperName'' flag-field=''ShipperAddressCountryCode''></FieldTemplate>
				</LogColumn>
			</LogRow>
    			<LogRow log-class=''dp-border-bottom-1-gray-1 dp-display-flex dp-align-items-center dp-justify-content-start''>
				<LogColumn
					log-class=''dp-display-flex dp-align-items-center dp-justify-content-start salesman dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
						<FieldTemplate tooltip=''true'' disable-copy=''true'' field-code=''Shipment.SalesmanUserName''
					email-field=''SalesmanEmail'' email-related-field=''ShipmentNumber''></FieldTemplate>
				<LogEmail dp-if=''{Shipment.SalesmanEmail} !== null'' field-code=''Shipment.SalesmanUserName'' email-field=''SalesmanEmail''
					email-body-info-field=''ShipmentNumber''>
				</LogEmail>
				</LogColumn>
				<LogColumn
					log-class=''dp-display-flex dp-align-items-center dp-justify-content-start account-manager dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
					<FieldTemplate tooltip=''true'' disable-copy=''true'' field-code=''Shipment.AccountManagerUserName''
					email-field=''AccountManagerUserEmail'' email-related-field=''ShipmentNumber''></FieldTemplate>

				<LogEmail dp-if=''{Shipment.AccountManagerUserEmail} !== null'' field-code=''Shipment.AccountManagerUserName'' email-field=''AccountManagerUserEmail''
					email-body-info-field=''ShipmentNumber''>
				</LogEmail>
				</LogColumn>
			</LogRow>
			<LogRow log-class=''p-pb-0 p-mb-0''>
				<LogColumn
					log-class=''single-shipment-description-of-goods dp-display-flex dp-align-items-center dp-justify-content-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
					<FieldTemplate tooltip=''true'' disable-copy=''true'' field-code=''Shipment.DescriptionOfGoods''></FieldTemplate>
				</LogColumn>
			</LogRow>
			<LogRow dp-if=''{Shipment.NotesSharedWithCustomer}!== undefined && {Shipment.NotesSharedWithCustomer}!== null'' log-class=''dp-padding-bottom-0 dp-margin-bottom-0 p-mt-2 dp-border-top-1-gray-1 dp-display-flex dp-align-items-center dp-justify-content-between''>
				<LogColumn
					log-class=''p-mt-2 blue-box-single dp-display-flex bg-dp-secondary-color dp-display-flex dp-align-items-center dp-justify-content-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
					<FieldTemplate label-classes=''white-space-normal dp-margin-left-1'' disable-copy=''true''
						field-code=''Shipment.NotesSharedWithCustomer''>
					</FieldTemplate>
				</LogColumn>
			</LogRow>
			<LogRow dp-if=''{Shipment.RequestedDocumentsCount} > 0'' log-class=''dp-padding-bottom-0 dp-margin-bottom-0 dp-display-flex dp-align-items-center dp-justify-content-between''>
				<LogColumn log-class=''w--100''>
					<RequiredDocumentsMessage></RequiredDocumentsMessage>
				</LogColumn>
			</LogRow>
			</LogTable>
					',
					'<LogTable>
			<LogRow log-class=''dp-font-weight-600 dp-font-size-16 dp-color-black-3''>
