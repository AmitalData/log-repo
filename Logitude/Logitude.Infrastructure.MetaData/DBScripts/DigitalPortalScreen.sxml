 		EXECUTE usp_GetNextTableIdValue @EntityId OUTPUT,'DigitalPortalScreens'

		INSERT INTO DigitalPortalScreens (Id, Tenant, ObjectTableId, CreateDate, UpdateDate, [Name], ScreenCode, Content, DraftContent) 
	    values (@EntityId, 0, @shipmentObjectId, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP, 'Single Shipment card item', 'SSHGI', 
 		   '<div class=''p-mb-2 p-pb-1 dp-font-weight-600 dp-font-size-16 dp-color-black-3''>
			<LogLabel field-code=''Shipment.GeneralInformation''></LogLabel>
			</div>
			<div class=''first-row p-d-flex p-ai-center p-jc-between p-mb-2 p-pb-2''>
				<LogContainer
					class=''w--32 references p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
					<FieldTemplate tooltip=''true'' disable-copy=''true''
						field-code=''Shipment.CustomerReference1,Shipment.CustomerReference2''></FieldTemplate>
				</LogContainer>
				<div
					class=''w--32 shipment-level p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
					<FieldTemplate disable-copy=''true'' field-code=''Shipment.ShipmentLevelName''></FieldTemplate>
				</div>
				<div
					class=''w--26 master-number p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
					<FieldTemplate disable-copy=''true'' field-code=''Shipment.House''></FieldTemplate>
				</div>
				<div class=''dp-font-weight-400 dp-font-size-14 dp-color-gray-3 w--10 invoiced p-d-flex p-ai-center p-jc-start''>
					<LogLabel field-code=''Shipment.IsFullInvoiced''></LogLabel>: <LogIcon
						icon-class=''w-14-h-14-px p-ml-1'' dp-if=''{Shipment.IsFullInvoiced}===[true]'' icon=''Checked''>
					</LogIcon>
					<LogIcon icon-class=''w-11-h-11 p-mt-1 p-ml-1'' dp-if=''{Shipment.IsFullInvoiced}===[false]'' icon=''Union''></LogIcon>
				</div>
			</div>
			<div class=''second-row p-d-flex p-ai-center p-jc-start p-pb-2''>
				<div class=''incoterm p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
					<FieldTemplate is-field-with-code=''true'' disable-copy=''true''
						field-code=''Shipment.IncotermName,Shipment.IncotermCode''></FieldTemplate>
				</div>
				<div class=''p-d-flex p-ai-center p-jc-start shipment-customer dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
					<FieldTemplate disable-copy=''true'' tooltip=''true'' field-code=''Shipment.CustomerName''></FieldTemplate>
				</div>
				<div class=''consignee-shipper-name p-d-flex p-ai-center p-jc-start dp-font-size-14''>
					<FieldTemplate disable-copy=''true'' dp-if=''{Shipment.DirectionId}!==[I]'' tooltip=''true''
						field-code=''Shipment.ConsigneeName'' flag-field=''ConsigneeAddressCountryCode''></FieldTemplate>
					<FieldTemplate disable-copy=''true'' dp-if=''{Shipment.DirectionId}===[I]'' tooltip=''true''
						field-code=''Shipment.ShipperName'' flag-field=''ShipperAddressCountryCode''></FieldTemplate>
				</div>
			</div>
			<div class=''third-row p-d-flex p-ai-center p-jc-start p-mt-2''>
				<div class=''p-d-flex p-ai-center p-jc-start salesman dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
					<FieldTemplate tooltip=''true'' disable-copy=''true'' field-code=''Shipment.SalesmanUserName''
						email-field=''SalesmanEmail'' email-related-field=''ShipmentNumber''></FieldTemplate>
				</div>
				<div class=''p-d-flex p-ai-center p-jc-start account-manager dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
					<FieldTemplate tooltip=''true'' disable-copy=''true'' field-code=''Shipment.AccountManagerUserName''
						email-field=''AccountManagerUserEmail'' email-related-field=''ShipmentNumber''></FieldTemplate>
				</div>
			</div>
			<div class=''p-mt-2 p-pt-2 dp-border-top-1-gray-1''>
				<div
					class=''single-shipment-description-of-goods p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
