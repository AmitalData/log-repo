                  </div>
                  <div data-valid-only=''true'' data-fields=''NotesSharedWithCustomer''class=''p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-1 p-d-flex p-ai-start p-jc-start''>
                     <FieldTemplate tooltip=''true''data-label=''Notes''data-fields=''NotesSharedWithCustomer''></FieldTemplate>
