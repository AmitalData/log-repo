			<LogRow log-class=''dp-border-bottom-1-gray-1 dp-display-flex dp-align-items-center dp-justify-content-between''>
				<LogColumn log-class=''w--32 references dp-display-flex dp-align-items-center dp-justify-content-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
					<LogContainer>
						<FieldTemplate tooltip=''true'' field-code=''Shipment.CustomerReference1,Shipment.CustomerReference2''>
						</FieldTemplate>
					</LogContainer>
				</LogColumn>
				<LogColumn
					log-class=''w--32 shipment-level dp-display-flex dp-align-items-center dp-justify-content-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
					<FieldTemplate disable-copy=''true'' field-code=''Shipment.ShipmentLevelName''></FieldTemplate>
				</LogColumn>
				<LogColumn
					log-class=''w--26 master-number dp-display-flex dp-align-items-center dp-justify-content-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
					<FieldTemplate disable-copy=''true'' field-code=''Shipment.House''></FieldTemplate>
				</LogColumn>
				<LogColumn
					log-class=''dp-font-weight-400 dp-font-size-14 dp-color-gray-3 w--10 invoiced dp-display-flex dp-align-items-center dp-justify-content-start''>
					<LogLabel field-code=''Shipment.IsFullInvoiced''></LogLabel>: <LogIcon icon-class=''w-14-h-14-px dp-margin-left-1''
