						email-field=''SalesmanEmail'' email-related-field=''ShipmentNumber''></FieldTemplate>
				</div>
				<div class=''p-d-flex p-ai-center p-jc-start account-manager dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
					<FieldTemplate tooltip=''true'' disable-copy=''true'' field-code=''Shipment.AccountManagerUserName''
						email-field=''AccountManagerUserEmail'' email-related-field=''ShipmentNumber''></FieldTemplate>
				</div>
			</div>
			<div class=''p-mt-2 p-pt-2 dp-border-top-1-gray-1''>
				<div
					class=''single-shipment-description-of-goods p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
					<FieldTemplate tooltip=''true'' disable-copy=''true'' field-code=''Shipment.DescriptionOfGoods''></FieldTemplate>
				</div>
			</div>
			<div data-valid-only=''true'' field-code=''Shipment.NotesSharedWithCustomer''
				class=''p-mt-2 p-pt-2 dp-border-top-1-gray-1 p-d-flex p-ai-center p-jc-between''>
				<div
					class=''blue-box-single p-d-flex bg-dp-secondary-color p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
					<FieldTemplate label-classes=''white-space-normal p-ml-1'' disable-copy=''true''
						field-code=''Shipment.NotesSharedWithCustomer''></FieldTemplate>
				</div>
			</div>');

	  ]]>
  </Sql>
