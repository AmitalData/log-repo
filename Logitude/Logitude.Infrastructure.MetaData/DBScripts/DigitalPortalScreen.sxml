            <div class=''list-item-second-row p-d-flex p-ai-center p-jc-between p-flex-wrap p-mt-2 dp-font-weight-400 dp-font-size-14''>
               <div class=''white-space-nowrap w--100 display-lg-block dp-font-weight-400 dp-font-size-14 p-mb-2 display-flex p-ai-start p-jc-start''>
                  <div class=''p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-0 p-d-flex p-ai-start p-jc-start''>
                     <FieldTemplate data-label=''Customer''data-fields=''CustomerName''></FieldTemplate>
                  </div>
               </div>
               <div class=''description-of-goods p-d-inline-flex p-ai-center p-jc-start''>
                  <Log-Container class=''dp-position-relative text-cut p-mt-1 dp-font-weight-400 dp-font-size-14 dp-color-gray-3 p-d-flex p-ai-start p-jc-start''>
                     <LogElement type=''entity-field-label''data-label=''Description of goods''></LogElement>
                     :
                     <LogElement tooltip=''true''type=''entity-field-value''data-fields=''DescriptionOfGoods''label-classes=''p-ml-1''></LogElement>
