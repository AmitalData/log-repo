<Script DBType="Main" Module="Infrastructure">
	<Sql Version="9">
      <![CDATA[	  
		delete from DigitalPortalScreens where id != ''
		
		declare @shipmentObjectId as varchar(15)
		set @shipmentObjectId = (select Id from ObjectTables where [Name] = 'Shipment' and Tenant = 0 )

        declare @EntityId as varchar(15)
 		EXECUTE usp_GetNextTableIdValue @EntityId OUTPUT,'DigitalPortalScreens'

		INSERT INTO DigitalPortalScreens (Id, Tenant, ObjectTableId, CreateDate, UpdateDate, [Name], ScreenCode, Content, DraftContent) 
	    values (@EntityId, 0, @shipmentObjectId, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP, 'Shipment list card item', 'SLCI', 
 		   '<div class=''list-item-first-row''>
           <div class=''list-item-first-col''>
              <div class=''p-d-flex p-ai-center p-jc-start''>
                 <div class=''transport-direction margin-top-3''><LogElement icon-class=''p-mr-1''dp-if=''{Shipment.DirectionId}===[I]''type=''icon''icon=''Import''></LogElement><LogElement icon-class=''p-mr-1''dp-if=''{Shipment.DirectionId}===[E]''type=''icon''icon=''Export''></LogElement><LogElement icon-class=''p-mr-1''dp-if=''{Shipment.DirectionId}===[D]''type=''icon''icon=''Domestic''></LogElement><LogElement icon-class=''p-mr-1''dp-if=''{Shipment.DirectionId}===[R]''type=''icon''icon=''Drop''></LogElement></div>
                 <LogElement type=''separator''></LogElement>
                 <LogElement dp-if=''{Shipment.TransportModeId}===[A]''type=''icon''icon=''Air''></LogElement>
                 <LogElement dp-if=''{Shipment.TransportModeId}===[O]''type=''icon''icon=''Ocean''></LogElement>
                 <LogElement icon-class=''p-ml-1''dp-if=''{Shipment.TransportModeId}===[I]''type=''icon''icon=''Inland''></LogElement>
                 <div class=''shipment-number-container p-d-flex p-ai-center p-jc-start''>
                    <div class=''shipment-type p-ml-1 dp-border-radius-4px dp-font-size-12 dp-color-black-3 dp-font-weight-400 p-p-1 dp-bg-color-gray-4 p-mr-1''><LogElement type=''badge''field-code=''Shipment.shipment-type''></LogElement></div>
                    <div class=''shipment-number p-ml-1 dp-font-size-16 dp-font-weight-600 dp-color-black-3''><span class=''shipment-number-label dp-position-relative''><LogElement type=''entity-field-value''field-code=''Shipment.ShipmentNumber''></LogElement></span></div>
                 </div>
              </div>
              <div class=''p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-1 p-d-flex p-ai-start p-jc-start''><FieldTemplate tooltip=''true''field-code=''Shipment.CustomerReference1,Shipment.CustomerReference2''></FieldTemplate></div>
              <Log-Container dp-if=''{Shipment.TransportModeId}===[A]''class=''p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-1 p-d-flex p-ai-start p-jc-start''>
              <FieldTemplate dp-if=''{Shipment.TransportModeId}===[A]''field-code=''Shipment.LongMaster''></FieldTemplate>
              <FieldTemplate dp-if=''{Shipment.TransportModeId}===[O]''field-code=''Shipment.LongMaster''></FieldTemplate>
              <FieldTemplate dp-if=''{Shipment.TransportModeId}===[I]''field-code=''Shipment.LongMaster''></FieldTemplate>
              </Log-Container><Log-Container dp-if=''{Shipment.TransportModeId}!==[A]''class=''p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-1 p-d-flex p-ai-start p-jc-start''>
              <FieldTemplate dp-if=''{Shipment.TransportModeId}===[A]''field-code=''Shipment.Master''></FieldTemplate>
              <FieldTemplate dp-if=''{Shipment.TransportModeId}===[O]''field-code=''Shipment.Master''></FieldTemplate>
              <FieldTemplate dp-if=''{Shipment.TransportModeId}===[I]''field-code=''Shipment.Master''></FieldTemplate>
              </Log-Container>
              <div class=''display-lg-flex-none p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-1 p-ai-start p-jc-start''>
                 <FieldTemplate field-code=''Shipment.CustomerName''></FieldTemplate>
              </div>
              <div class=''display-lg-block padding-top-bottom-2 dp-font-weight-400 dp-font-size-14''><FieldTemplate field-code=''Shipment.StatusDate''disable-copy=''true''is-date-time=''true''></FieldTemplate></div>
              <div data-valid-only=''true''field-code=''Shipment.NotesSharedWithCustomer''class=''p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-1 p-d-flex p-ai-start p-jc-start''><FieldTemplate tooltip=''true''field-code=''Shipment.NotesSharedWithCustomer''></FieldTemplate>
           </div>
        </div>
        <div class=''list-item-timeline-container''>
           <ShipmentStatusInfoForTablet></ShipmentStatusInfoForTablet>
           <HorizontalTimeline></HorizontalTimeline>
        </div>
        <div class=''list-item-third-col p-d-flex p-flex-column p-jc-end p-ai-end''>
           <ShipmentStatusInfo></ShipmentStatusInfo>
           <div class=''dp-font-weight-400 dp-font-size-14 p-mb-0 p-d-flex p-ai-start p-jc-end''><FieldTemplate container-classes=''p-mr-0''field-code=''Shipment.StatusDate''disable-copy=''true''is-date-time=''true''></FieldTemplate></div>
        </div>
        </div>
        <div class=''list-item-second-row p-d-flex p-ai-center p-jc-between p-flex-wrap p-mt-2 dp-font-weight-400 dp-font-size-14''>
           <div class=''white-space-nowrap w--100 display-lg-block dp-font-weight-400 dp-font-size-14 p-mb-2 display-flex p-ai-start p-jc-start''>
              <div class=''p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-0 p-d-flex p-ai-start p-jc-start''>
                 <FieldTemplate field-code=''Shipment.CustomerName''></FieldTemplate>
              </div>
           </div>
           <div class=''description-of-goods p-d-inline-flex p-ai-center p-jc-start''>
              <Log-Container class=''dp-position-relative text-cut p-mt-1 dp-font-weight-400 dp-font-size-14 dp-color-gray-3 p-d-flex p-ai-start p-jc-start''><LogElement type=''entity-field-label''field-code=''Shipment.DescriptionOfGoods''></LogElement>: <LogElement tooltip=''true''type=''entity-field-value''field-code=''Shipment.DescriptionOfGoods''label-classes=''p-ml-1''></LogElement></Log-Container>
           </div>
           <div class=''consignee-shipper-info p-d-inline-flex p-ai-center p-jc-start''>
              <div class=''text-cut p-mt-1 dp-font-weight-400 dp-font-size-14 p-d-flex p-ai-center p-jc-start''>
                 <FieldTemplate dp-if=''{Shipment.DirectionId}!==[I]''tooltip=''true''field-code=''Shipment.ConsigneeName''flag-field=''ConsigneeCountryCode''></FieldTemplate>
                 <FieldTemplate dp-if=''{Shipment.DirectionId}===[I]''tooltip=''true''field-code=''Shipment.ShipperName''flag-field=''ShipperCountryCode''></FieldTemplate>
              </div>
           </div>
        </div>'
			,'<div class=''list-item-first-row''>
               <div class=''list-item-first-col''>
                  <div class=''p-d-flex p-ai-center p-jc-start''>
                     <div class=''transport-direction margin-top-3''><LogElement icon-class=''p-mr-1''dp-if=''{Shipment.DirectionId}===[I]''type=''icon''icon=''Import''></LogElement><LogElement icon-class=''p-mr-1''dp-if=''{Shipment.DirectionId}===[E]''type=''icon''icon=''Export''></LogElement><LogElement icon-class=''p-mr-1''dp-if=''{Shipment.DirectionId}===[D]''type=''icon''icon=''Domestic''></LogElement><LogElement icon-class=''p-mr-1''dp-if=''{Shipment.DirectionId}===[R]''type=''icon''icon=''Drop''></LogElement></div>
                     <LogElement type=''separator''></LogElement>
                     <LogElement dp-if=''{Shipment.TransportModeId}===[A]''type=''icon''icon=''Air''></LogElement>
                     <LogElement dp-if=''{Shipment.TransportModeId}===[O]''type=''icon''icon=''Ocean''></LogElement>
                     <LogElement icon-class=''p-ml-1''dp-if=''{Shipment.TransportModeId}===[I]''type=''icon''icon=''Inland''></LogElement>
                     <div class=''shipment-number-container p-d-flex p-ai-center p-jc-start''>
                        <div class=''shipment-type p-ml-1 dp-border-radius-4px dp-font-size-12 dp-color-black-3 dp-font-weight-400 p-p-1 dp-bg-color-gray-4 p-mr-1''><LogElement type=''badge''field-code=''Shipment.shipment-type''></LogElement></div>
                        <div class=''shipment-number p-ml-1 dp-font-size-16 dp-font-weight-600 dp-color-black-3''><span class=''shipment-number-label dp-position-relative''><LogElement type=''entity-field-value''field-code=''Shipment.ShipmentNumber''></LogElement></span></div>
                     </div>
                  </div>
                  <div class=''p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-1 p-d-flex p-ai-start p-jc-start''><FieldTemplate tooltip=''true''field-code=''Shipment.CustomerReference1,Shipment.CustomerReference2''></FieldTemplate></div>
                  <Log-Container dp-if=''{Shipment.TransportModeId}===[A]''class=''p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-1 p-d-flex p-ai-start p-jc-start''>
                  <FieldTemplate dp-if=''{Shipment.TransportModeId}===[A]''field-code=''Shipment.LongMaster''></FieldTemplate>
                  <FieldTemplate dp-if=''{Shipment.TransportModeId}===[O]''field-code=''Shipment.LongMaster''></FieldTemplate>
                  <FieldTemplate dp-if=''{Shipment.TransportModeId}===[I]''field-code=''Shipment.LongMaster''></FieldTemplate>
                  </Log-Container><Log-Container dp-if=''{Shipment.TransportModeId}!==[A]''class=''p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-1 p-d-flex p-ai-start p-jc-start''>
                  <FieldTemplate dp-if=''{Shipment.TransportModeId}===[A]''field-code=''Shipment.Master''></FieldTemplate>
                  <FieldTemplate dp-if=''{Shipment.TransportModeId}===[O]''field-code=''Shipment.Master''></FieldTemplate>
                  <FieldTemplate dp-if=''{Shipment.TransportModeId}===[I]''field-code=''Shipment.Master''></FieldTemplate>
                  </Log-Container>
                  <div class=''display-lg-flex-none p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-1 p-ai-start p-jc-start''>
                     <FieldTemplate field-code=''Shipment.CustomerName''></FieldTemplate>
                  </div>
                  <div class=''display-lg-block padding-top-bottom-2 dp-font-weight-400 dp-font-size-14''><FieldTemplate field-code=''Shipment.StatusDate''disable-copy=''true''is-date-time=''true''></FieldTemplate></div>
                  <div data-valid-only=''true''field-code=''Shipment.NotesSharedWithCustomer''class=''p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-1 p-d-flex p-ai-start p-jc-start''><FieldTemplate tooltip=''true''field-code=''Shipment.NotesSharedWithCustomer''></FieldTemplate>
               </div>
            </div>
            <div class=''list-item-timeline-container''>
               <ShipmentStatusInfoForTablet></ShipmentStatusInfoForTablet>
               <HorizontalTimeline></HorizontalTimeline>
            </div>
            <div class=''list-item-third-col p-d-flex p-flex-column p-jc-end p-ai-end''>
               <ShipmentStatusInfo></ShipmentStatusInfo>
               <div class=''dp-font-weight-400 dp-font-size-14 p-mb-0 p-d-flex p-ai-start p-jc-end''><FieldTemplate container-classes=''p-mr-0''field-code=''Shipment.StatusDate''disable-copy=''true''is-date-time=''true''></FieldTemplate></div>
            </div>
            </div>
            <div class=''list-item-second-row p-d-flex p-ai-center p-jc-between p-flex-wrap p-mt-2 dp-font-weight-400 dp-font-size-14''>
               <div class=''white-space-nowrap w--100 display-lg-block dp-font-weight-400 dp-font-size-14 p-mb-2 display-flex p-ai-start p-jc-start''>
                  <div class=''p-mt-2 dp-font-weight-400 dp-font-size-14 p-mb-0 p-d-flex p-ai-start p-jc-start''>
                     <FieldTemplate field-code=''Shipment.CustomerName''></FieldTemplate>
                  </div>
               </div>
               <div class=''description-of-goods p-d-inline-flex p-ai-center p-jc-start''>
                  <Log-Container class=''dp-position-relative text-cut p-mt-1 dp-font-weight-400 dp-font-size-14 dp-color-gray-3 p-d-flex p-ai-start p-jc-start''><LogElement type=''entity-field-label''field-code=''Shipment.DescriptionOfGoods''></LogElement>: <LogElement tooltip=''true''type=''entity-field-value''field-code=''Shipment.DescriptionOfGoods''label-classes=''p-ml-1''></LogElement></Log-Container>
               </div>
               <div class=''consignee-shipper-info p-d-inline-flex p-ai-center p-jc-start''>
                  <div class=''text-cut p-mt-1 dp-font-weight-400 dp-font-size-14 p-d-flex p-ai-center p-jc-start''>
                     <FieldTemplate dp-if=''{Shipment.DirectionId}!==[I]''tooltip=''true''field-code=''Shipment.ConsigneeName''flag-field=''ConsigneeCountryCode''></FieldTemplate>
                     <FieldTemplate dp-if=''{Shipment.DirectionId}===[I]''tooltip=''true''field-code=''Shipment.ShipperName''flag-field=''ShipperCountryCode''></FieldTemplate>
                  </div>
               </div>
            </div>');


 		EXECUTE usp_GetNextTableIdValue @EntityId OUTPUT,'DigitalPortalScreens'

		INSERT INTO DigitalPortalScreens (Id, Tenant, ObjectTableId, CreateDate, UpdateDate, [Name], ScreenCode, Content, DraftContent) 
	    values (@EntityId, 0, @shipmentObjectId, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP, 'Single Shipment card item', 'SSHGI', 
 		   '<div class=''p-mb-2 p-pb-1 dp-font-weight-600 dp-font-size-16 dp-color-black-3''><LogElement type=''entity-field-label''field-code=''Shipment.GeneralInformation''></LogElement></div>
                <div class=''first-row p-d-flex p-ai-center p-jc-between p-mb-2 p-pb-2''>
                   <Log-Container class=''w--32 references p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''><FieldTemplate tooltip=''true''disable-copy=''true''field-code=''Shipment.CustomerReference1,Shipment.CustomerReference2''></FieldTemplate></Log-Container>
                   <div class=''w--32 shipment-level p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''><FieldTemplate disable-copy=''true''field-code=''Shipment.ShipmentLevelName''></FieldTemplate></div>
                   <div class=''w--26 master-number p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''><FieldTemplate disable-copy=''true''field-code=''Shipment.House''></FieldTemplate></div>
                   <div class=''dp-font-weight-400 dp-font-size-14 dp-color-gray-3 w--10 invoiced p-d-flex p-ai-center p-jc-start''><LogElement type=''entity-field-label''field-code=''Shipment.IsFullInvoiced''></LogElement>: <LogElement icon-class=''w-14-h-14-px p-ml-1''dp-if=''{Shipment.IsFullInvoiced}===[true]''type=''icon''icon=''Checked''></LogElement><LogElement icon-class=''w-11-h-11 p-mt-1 p-ml-1''dp-if=''{Shipment.IsFullInvoiced}!==[true]''type=''icon''icon=''Union''></LogElement></div>
                </div>
                <div class=''second-row p-d-flex p-ai-center p-jc-start p-pb-2''>
                   <div class=''incoterm p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''><FieldTemplate is-field-with-code=''true''disable-copy=''true''field-code=''Shipment.IncotermName,Shipment.IncotermCode''></FieldTemplate></div>
                   <div class=''p-d-flex p-ai-center p-jc-start shipment-customer dp-font-weight-400 dp-font-size-14 dp-color-black-3''><FieldTemplate disable-copy=''true''tooltip=''true''field-code=''Shipment.CustomerName''></FieldTemplate></div>
                   <div class=''consignee-shipper-name p-d-flex p-ai-center p-jc-start dp-font-size-14''><FieldTemplate disable-copy=''true''dp-if=''{Shipment.DirectionId}!==[I]''tooltip=''true''field-code=''Shipment.ConsigneeName''flag-field=''ConsigneeAddressCountryCode''></FieldTemplate><FieldTemplate disable-copy=''true''dp-if=''{Shipment.DirectionId}===[I]''tooltip=''true''field-code=''Shipment.ShipperName''flag-field=''ShipperAddressCountryCode''></FieldTemplate></div>
                </div>
                <div class=''third-row p-d-flex p-ai-center p-jc-start p-mt-2''>
                   <div class=''p-d-flex p-ai-center p-jc-start salesman dp-font-weight-400 dp-font-size-14 dp-color-black-3''><FieldTemplate tooltip=''true''disable-copy=''true''field-code=''Shipment.SalesmanUserName''email-field=''SalesmanEmail''email-related-field=''ShipmentNumber''></FieldTemplate></div>
                   <div class=''p-d-flex p-ai-center p-jc-start account-manager dp-font-weight-400 dp-font-size-14 dp-color-black-3''><FieldTemplate tooltip=''true''disable-copy=''true''field-code=''Shipment.AccountManagerUserName''email-field=''AccountManagerUserEmail''email-related-field=''ShipmentNumber''></FieldTemplate></div>
                </div>
                <div class=''p-mt-2 p-pt-2 dp-border-top-1-gray-1''>
                   <div class=''single-shipment-description-of-goods p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''><FieldTemplate tooltip=''true''disable-copy=''true''field-code=''Shipment.DescriptionOfGoods''></FieldTemplate></div>
                </div>
                <div data-valid-only=''true''field-code=''Shipment.NotesSharedWithCustomer''class=''p-mt-2 p-pt-2 dp-border-top-1-gray-1 p-d-flex p-ai-center p-jc-between''>
                <div class=''blue-box-single p-d-flex bg-dp-secondary-color p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''><FieldTemplate label-classes=''white-space-normal p-ml-1''disable-copy=''true''field-code=''Shipment.NotesSharedWithCustomer''></FieldTemplate></div>
                </div>'
			,'<div class=''p-mb-2 p-pb-1 dp-font-weight-600 dp-font-size-16 dp-color-black-3''><LogElement type=''entity-field-label''field-code=''Shipment.GeneralInformation''></LogElement></div>
                <div class=''first-row p-d-flex p-ai-center p-jc-between p-mb-2 p-pb-2''>
                   <Log-Container class=''w--32 references p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''><FieldTemplate tooltip=''true''disable-copy=''true''field-code=''Shipment.CustomerReference1,Shipment.CustomerReference2''></FieldTemplate></Log-Container>
                   <div class=''w--32 shipment-level p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''><FieldTemplate disable-copy=''true''field-code=''Shipment.ShipmentLevelName''></FieldTemplate></div>
                   <div class=''w--26 master-number p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''><FieldTemplate disable-copy=''true''field-code=''Shipment.House''></FieldTemplate></div>
                   <div class=''dp-font-weight-400 dp-font-size-14 dp-color-gray-3 w--10 invoiced p-d-flex p-ai-center p-jc-start''><LogElement type=''entity-field-label''field-code=''Shipment.IsFullInvoiced''></LogElement>: <LogElement icon-class=''w-14-h-14-px p-ml-1''dp-if=''{Shipment.IsFullInvoiced}===[true]''type=''icon''icon=''Checked''></LogElement><LogElement icon-class=''w-11-h-11 p-mt-1 p-ml-1''dp-if=''{Shipment.IsFullInvoiced}!==[true]''type=''icon''icon=''Union''></LogElement></div>
                </div>
                <div class=''second-row p-d-flex p-ai-center p-jc-start p-pb-2''>
                   <div class=''incoterm p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''><FieldTemplate is-field-with-code=''true''disable-copy=''true''field-code=''Shipment.IncotermName,Shipment.IncotermCode''></FieldTemplate></div>
                   <div class=''p-d-flex p-ai-center p-jc-start shipment-customer dp-font-weight-400 dp-font-size-14 dp-color-black-3''><FieldTemplate disable-copy=''true''tooltip=''true''field-code=''Shipment.CustomerName''></FieldTemplate></div>
                   <div class=''consignee-shipper-name p-d-flex p-ai-center p-jc-start dp-font-size-14''><FieldTemplate disable-copy=''true''dp-if=''{Shipment.DirectionId}!==[I]''tooltip=''true''field-code=''Shipment.ConsigneeName''flag-field=''ConsigneeAddressCountryCode''></FieldTemplate><FieldTemplate disable-copy=''true''dp-if=''{Shipment.DirectionId}===[I]''tooltip=''true''field-code=''Shipment.ShipperName''flag-field=''ShipperAddressCountryCode''></FieldTemplate></div>
                </div>
                <div class=''third-row p-d-flex p-ai-center p-jc-start p-mt-2''>
                   <div class=''p-d-flex p-ai-center p-jc-start salesman dp-font-weight-400 dp-font-size-14 dp-color-black-3''><FieldTemplate tooltip=''true''disable-copy=''true''field-code=''Shipment.SalesmanUserName''email-field=''SalesmanEmail''email-related-field=''ShipmentNumber''></FieldTemplate></div>
                   <div class=''p-d-flex p-ai-center p-jc-start account-manager dp-font-weight-400 dp-font-size-14 dp-color-black-3''><FieldTemplate tooltip=''true''disable-copy=''true''field-code=''Shipment.AccountManagerUserName''email-field=''AccountManagerUserEmail''email-related-field=''ShipmentNumber''></FieldTemplate></div>
                </div>
                <div class=''p-mt-2 p-pt-2 dp-border-top-1-gray-1''>
                   <div class=''single-shipment-description-of-goods p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''><FieldTemplate tooltip=''true''disable-copy=''true''field-code=''Shipment.DescriptionOfGoods''></FieldTemplate></div>
                </div>
                <div data-valid-only=''true''field-code=''Shipment.NotesSharedWithCustomer''class=''p-mt-2 p-pt-2 dp-border-top-1-gray-1 p-d-flex p-ai-center p-jc-between''>
                <div class=''blue-box-single p-d-flex bg-dp-secondary-color p-d-flex p-ai-center p-jc-start dp-font-weight-400 dp-font-size-14 dp-color-black-3''><FieldTemplate label-classes=''white-space-normal p-ml-1''disable-copy=''true''field-code=''Shipment.NotesSharedWithCustomer''></FieldTemplate></div>
                </div>');

	  ]]>
  </Sql>
</Script>
