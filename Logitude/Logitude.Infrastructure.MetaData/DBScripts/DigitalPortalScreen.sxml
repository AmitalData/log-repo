				<LogColumn
					log-class=''dp-display-flex dp-align-items-center dp-justify-content-start shipment-customer dp-font-weight-400 dp-font-size-14 dp-color-black-3''>
					<FieldTemplate disable-copy=''true'' tooltip=''true'' field-code=''Shipment.CustomerName''></FieldTemplate>
				</LogColumn>
				<LogColumn
					log-class=''consignee-shipper-name dp-display-flex dp-align-items-center dp-justify-content-start dp-font-size-14''>
					<FieldTemplate disable-copy=''true'' dp-if=''{Shipment.DirectionId}!==[I]'' tooltip=''true''
