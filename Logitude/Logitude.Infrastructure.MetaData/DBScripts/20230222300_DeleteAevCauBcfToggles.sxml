<Script DBType="Main" Module="Infrastructure" Pre="true">
  <Sql Version="1">
    <![CDATA[
      DELETE FROM FeatureToggles WHERE ToggleCode = 'AEV'
      DELETE FROM Toggles WHERE code = 'AEV'

      DELETE FROM FeatureToggles WHERE ToggleCode = 'CAU'
      DELETE FROM Toggles WHERE code = 'CAU'

      DELETE FROM FeatureToggles WHERE ToggleCode = 'BCF'
      DELETE FROM Toggles WHERE code = 'BCF'

    ]]>       
  </Sql>
</Script>