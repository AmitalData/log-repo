<Script DBType="Main" Module="Infrastructure">
	<Sql Version="3">
      <![CDATA[
		delete from DigitalPreDefinedComponents where id != ''
		declare @shipmentObjectId as varchar(15)
		set @shipmentObjectId = (select Id from ObjectTables where [Name] = 'Shipment' and Tenant = 0 )
		declare @EntityId as varchar(15)

 		EXECUTE usp_GetNextTableIdValue @EntityId OUTPUT,'DigitalPreDefinedComponent'	
		INSERT INTO DigitalPreDefinedComponents (Id, Tenant, ObjectTableId, CreateDate, UpdateDate, [Name], Content) 
	    values (@EntityId,
				0,
				@shipmentObjectId,
				CURRENT_TIMESTAMP,
				CURRENT_TIMESTAMP,
				'Shipment status for tablet component',
				'<ShipmentStatusInfoForTablet></ShipmentStatusInfoForTablet>')

 		EXECUTE usp_GetNextTableIdValue @EntityId OUTPUT,'DigitalPreDefinedComponent'	
