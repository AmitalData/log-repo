<LogFieldContainer>
<LogLabel field-code='''' ></LogLabel>
:
<LogField field-code=''''></LogField> 
</LogFieldContainer>');		

    EXECUTE usp_GetNextTableIdValue @EntityId OUTPUT,'DigitalPreDefinedComponent'
