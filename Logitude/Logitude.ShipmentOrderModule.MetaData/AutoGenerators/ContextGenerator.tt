private void GenerateContext(string sourceFolder,string destinationFolder,string contextname)
{
	contextnamespacestring = GetContextNameSpace(destinationFolder);
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string sourceFilePath = Path.Combine(templateDirectory, sourceFolder);

string pocosspacestring = contextnamespacestring.ToString().Substring(0,contextnamespacestring.ToString().LastIndexOf('.')) + ".Data.EntityMapping;";
string dataprojectnamespace = contextnamespacestring.ToString().Substring(0,contextnamespacestring.ToString().LastIndexOf('.')) + ".Data;";
string mappingsspacestring = contextnamespacestring.ToString().Substring(0,contextnamespacestring.ToString().LastIndexOf('.')) + ".Data.EntityPOCOs;";

#>
using Simplog.Global.Data.GlobalModel.EntityPOCOs;
using Simplog.Global.Data.GlobalModel.Helpers;
using Simplog.Server.Infrastructure;
using System;
using System.Collections.Generic;
using System.Data;
using System.Data.Common;
using System.Data.Entity;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Transactions;
using System.Data.Entity.Validation;
using System.Data.Entity.ModelConfiguration.Conventions;
using Simplog.Data.CommonDataModel.Mapping;
using Simplog.Data.InvoiceModel.Mapping;
using Simplog.Data.InfrastructureModel.Mapping;
using Simplog.Data.ShipmentsModel.Mapping;
using Simplog.Data.QuoteModel.Mapping;
using <#= mappingsspacestring #>
using <#= dataprojectnamespace #> 
using <#= pocosspacestring #>

namespace <#= contextnamespacestring #>
{
   public class <#= contextname #>: DbContextBase, I<#= contextname #>
    {
        public <#= contextname #>()
        {
            Database.SetInitializer<<#= contextname #>>(null); 
			Database.CommandTimeout = ApplicationAppInfo.GetDataBaseTimeOut();
        }

        public <#= contextname #>(DbConnection conn)
            : base(conn,true)
        {
            this.Configuration.LazyLoadingEnabled = false;
            this.Configuration.AutoDetectChangesEnabled = false;
            Database.SetInitializer<<#= contextname #>>(null);
			Database.CommandTimeout = ApplicationAppInfo.GetDataBaseTimeOut();
        }

        public static I<#= contextname #> GetContext(int tenant)
        {           
            GlobalDB currentDb;
			currentDb = GlobalDbHelper.GetGlobalDB(tenant);
            string dbConnectionInfo = currentDb.DBConnection;
            DbConnection connection =DatabaseInitializer.GetConnection(dbConnectionInfo);
            <#= contextname #> context = new <#= contextname #>(connection);
            return context;
        }
		public override LogitudeDBSchema LogitudeDBSchema
        {
            get { return Simplog.Server.Infrastructure.LogitudeDBSchema.LOGITUDE_MAIN; }
        }
        protected override void OnModelCreating(DbModelBuilder modelBuilder)
        {

		    if (LogitudeSettings.DatabaseManagementSystem == "oracle")
            {
                var config = Devart.Data.Oracle.Entity.Configuration.OracleEntityProviderConfig.Instance;
                config.Workarounds.DisableQuoting = true;
                
            }

            Database.SetInitializer<<#= contextname #>>(null);
            modelBuilder.Conventions.Remove<OneToManyCascadeDeleteConvention>();
			<#+
				foreach (string file in Directory.EnumerateFiles(sourceFilePath, "*.lxml"))
				{

					var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
					GenerateEntityMapForContext(file);
				}

			#>
			
			<#+
				foreach (string file in Directory.EnumerateFiles(sourceFilePath, "*.lxml"))
				{

					var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
					GenerateDecimalFields(file);
				} 
		#><#+
			 #>
			 
            #region

			#endregion

            base.OnModelCreating(modelBuilder);
        }

        public void SetAsModified(object entity)
        {
            this.Entry(entity).State = EntityState.Modified;
        }

        public void DetectChanges()
        {
            this.ChangeTracker.DetectChanges();
        }

        public int SaveChanges()
        {
		    DetectChanges();
		    return base.SaveChanges();
       
	    }

      
		public DbConnection GetConnection()
		{
			return this.Database.Connection;
		}

		public DbContext GetActiveDbContext()
		{
			return this;
		}
 
<#+

foreach (string file in Directory.EnumerateFiles(sourceFilePath, "*.lxml"))
{

    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	GenerateIDbSetForContext(file);
}
