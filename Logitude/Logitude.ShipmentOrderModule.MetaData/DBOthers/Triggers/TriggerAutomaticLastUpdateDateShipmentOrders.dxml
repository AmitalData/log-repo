<?xml version="1.0" encoding="utf-8"?>
<Trigger
  DBType="Main"
  Name="TriggerAutomaticLastUpdateDateShipmentOrders"
  Schema="dbo"
  Module="ShipmentOrders">
  <SqlScript>
  <![CDATA[
CREATE TRIGGER TriggerAutomaticLastUpdateDateShipmentOrders ON [dbo].[ShipmentOrders] 

AFTER INSERT,UPDATE,DELETE

AS  BEGIN
SET NOCOUNT ON;
IF TRIGGER_NESTLEVEL() > 1 RETURN;
IF (SELECT program_name FROM sys.dm_exec_sessions WHERE session_id = (SELECT @@SPID)) <> 'ZeroDownTimeDBMigrationsTool'
BEGIN
UPDATE ShipmentOrders SET AutomaticLastUpdateDate = GETDATE() WHERE Id IN (SELECT DISTINCT Id FROM Inserted);
END;
END;
]]></SqlScript>
  <OracleScript>
</OracleScript>
</Trigger>